@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix epo: <http://data.europa.eu/a4g/ontology#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

epo:announcesAwardDecision rdfs:domain [ a owl:Class ;
            owl:unionOf ( epo:DirectAwardPrenotificationNotice epo:ResultNotice ) ] ;
    rdfs:range epo:AwardDecision .

epo:announcesContract rdfs:domain [ a owl:Class ;
            owl:unionOf ( epo:DirectAwardPrenotificationNotice epo:ResultNotice ) ] ;
    rdfs:range epo:Contract .

epo:announcesLotGroup rdfs:domain [ a owl:Class ;
            owl:unionOf ( epo:CompetitionNotice epo:DirectAwardPrenotificationNotice epo:PlanningNotice ) ] ;
    rdfs:range epo:LotGroup .

epo:announcesLotGroupAwardInformation rdfs:domain [ a owl:Class ;
            owl:unionOf ( epo:DirectAwardPrenotificationNotice epo:ResultNotice ) ] ;
    rdfs:range epo:LotGroupAwardInformation .

epo:announcesPlannedProcurementPart rdfs:domain epo:PlanningNotice ;
    rdfs:range epo:PlannedProcurementPart .

epo:announcesReviewRequest rdfs:domain epo:ResultNotice ;
    rdfs:range epo:ReviewRequest .

epo:concernsLotGroup rdfs:domain [ a owl:Class ;
            owl:unionOf ( epo:CompletionNotice epo:ContractModificationNotice epo:ResultNotice ) ] ;
    rdfs:range epo:LotGroup .

epo:not-restriction a owl:Ontology ;
    rdfs:label "eProcurement Ontology Notice - core restrictions"@en ;
    dcterms:created "2021-06-01"^^xsd:date ;
    dcterms:description "The eProcurement Ontology Notice core restrictions provides the restrictions and the inference-related specifications on the concepts and properties in the eProcurement Ontology Notice core."@en ;
    dcterms:issued "2025-05-15"^^xsd:date ;
    dcterms:license "© European Union, 2014. Unless otherwise noted, the reuse of the Ontology is authorised under the European Union Public Licence v1.2 (https://eupl.eu/)." ;
    dcterms:publisher "http://publications.europa.eu/resource/authority/corporate-body/PUBL" ;
    dcterms:title "eProcurement Ontology Notice - core restrictions"@en ;
    vann:preferredNamespacePrefix "epo" ;
    vann:preferredNamespaceUri "http://data.europa.eu/a4g/ontology#" ;
    rdfs:comment """This version is automatically generated from eNotice.xml on 
                2025-05-15""" ;
    rdfs:seeAlso <https://docs.ted.europa.eu/home/index.html>,
        <https://github.com/OP-TED/ePO/releases>,
        <https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology/about>,
        <https://op.europa.eu/en/web/eu-vocabularies/e-procurement> ;
    owl:imports epo:con,
        epo:core,
        epo:not,
        <http://data.europa.eu/eli/ontology#>,
        <http://data.europa.eu/m8g/>,
        dcterms:,
        skos:,
        <http://www.w3.org/2006/time>,
        <http://www.w3.org/ns/adms>,
        <http://www.w3.org/ns/locn>,
        org:,
        <http://www.w3.org/ns/person> ;
    owl:incompatibleWith "4.2.0" ;
    owl:priorVersion "http://data.europa.eu/a4g/ontology#not-restriction-4.2.0" ;
    owl:versionIRI epo:not-restriction-5.0.0 ;
    owl:versionInfo "5.0.0" .

epo:preparesForPotentialProcurementObject rdfs:domain epo:PreMarketConsultationNotice ;
    rdfs:range epo:ProcurementObject .

epo:refersToAwardDecision rdfs:domain [ a owl:Class ;
            owl:unionOf ( epo:CompletionNotice epo:ContractModificationNotice ) ] ;
    rdfs:range epo:AwardDecision .

epo:refersToLotGroupAwardInformation rdfs:domain [ a owl:Class ;
            owl:unionOf ( epo:CompletionNotice epo:ContractModificationNotice ) ] ;
    rdfs:range epo:LotGroupAwardInformation .

epo:refersToReviewRequest rdfs:domain epo:CompletionNotice ;
    rdfs:range epo:ReviewRequest .

epo:announcesCompletionOfContract a owl:FunctionalProperty ;
    rdfs:domain epo:CompletionNotice ;
    rdfs:range epo:Contract .

epo:announcesContractAmendment a owl:FunctionalProperty ;
    rdfs:domain epo:ContractModificationNotice ;
    rdfs:range epo:ContractAmendment .

epo:describesDirectAwardPrenotificationNotice rdfs:domain epo:NoticeAwardInformation ;
    rdfs:range epo:DirectAwardPrenotificationNotice .

epo:describesResultNotice rdfs:domain epo:NoticeAwardInformation ;
    rdfs:range epo:ResultNotice .

epo:refersToContractToBeModified a owl:FunctionalProperty ;
    rdfs:domain epo:ContractModificationNotice ;
    rdfs:range epo:Contract .

epo:refersToRole rdfs:domain [ a owl:Class ;
            owl:unionOf ( epo:CompletionNotice epo:ContractModificationNotice epo:PreMarketConsultationNotice epo:ResultNotice ) ] ;
    rdfs:range epo:AgentInRole .

epo:announcesLot rdfs:domain [ a owl:Class ;
            owl:unionOf ( epo:CompetitionNotice epo:DirectAwardPrenotificationNotice epo:PlanningNotice ) ] ;
    rdfs:range epo:Lot .

epo:announcesNoticeAwardInformation rdfs:domain [ a owl:Class ;
            owl:unionOf ( epo:DirectAwardPrenotificationNotice epo:ResultNotice ) ] ;
    rdfs:range epo:NoticeAwardInformation .

epo:refersToNoticeAwardInformation rdfs:domain [ a owl:Class ;
            owl:unionOf ( epo:CompletionNotice epo:ContractModificationNotice ) ] ;
    rdfs:range epo:NoticeAwardInformation .

epo:announcesProcedure a owl:FunctionalProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( epo:CompetitionNotice epo:DirectAwardPrenotificationNotice epo:PlanningNotice ) ] ;
    rdfs:range epo:Procedure .

epo:announcesRole rdfs:domain [ a owl:Class ;
            owl:unionOf ( epo:CompetitionNotice epo:CompletionNotice epo:DirectAwardPrenotificationNotice epo:PlanningNotice epo:ResultNotice ) ] ;
    rdfs:range epo:AgentInRole .

epo:concernsLot rdfs:domain [ a owl:Class ;
            owl:unionOf ( epo:CompletionNotice epo:ContractModificationNotice epo:ResultNotice ) ] ;
    rdfs:range epo:Lot .

epo:concernsProcedure a owl:FunctionalProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( epo:CompletionNotice epo:ContractModificationNotice epo:ResultNotice ) ] ;
    rdfs:range epo:Procedure .

epo:NoticeAwardInformation rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:describesResultNotice ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:describesDirectAwardPrenotificationNotice ] .

epo:CompetitionNotice rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty epo:announcesRole ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:announcesProcedure ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty epo:announcesLot ] .

epo:PlanningNotice rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty epo:announcesRole ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:announcesProcedure ] .

epo:ContractModificationNotice rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:announcesContractAmendment ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:concernsProcedure ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:refersToNoticeAwardInformation ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty epo:concernsLot ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:refersToContractToBeModified ] .

epo:DirectAwardPrenotificationNotice rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty epo:announcesRole ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:announcesNoticeAwardInformation ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty epo:announcesLot ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:announcesProcedure ] .

epo:CompletionNotice rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:refersToNoticeAwardInformation ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:announcesCompletionOfContract ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:concernsProcedure ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty epo:concernsLot ] .

epo:ResultNotice rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty epo:concernsLot ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty epo:refersToRole ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:announcesNoticeAwardInformation ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:concernsProcedure ] .

[] a owl:AllDisjointClasses ;
    owl:members ( epo:CompetitionNotice epo:CompletionNotice epo:ContractModificationNotice epo:DirectAwardPrenotificationNotice epo:PlanningNotice epo:PreMarketConsultationNotice epo:ResultNotice ) .

[] a owl:AllDisjointClasses ;
    owl:members ( epo:Notice36 epo:Notice37 epo:DesignContestResult-D25 epo:DesignContestResult-D24 ) .

[] a owl:AllDisjointClasses ;
    owl:members ( epo:Modification-D24 epo:Notice39 epo:NoticeE6 epo:Modification-D25 epo:Notice38 epo:Modification-D23 epo:Notice40 ) .

