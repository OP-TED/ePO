    owl:members ( epo:CANSocialNotice-D25 epo:VEAT-D25 epo:CNSocialNotice-D25 epo:PIN-CFCSocialNotice-D25 epo:PINOnly-D24 epo:SocialAndOtherSpecificServices-D23 epo:PINProfile-D24 epo:DesignContestResult-D24 epo:DesignContestResult-D25 epo:DesignContest-D25 epo:VEAT-D81 epo:PIN-RTL-D24 epo:PINOnly-D25 epo:CANStandard-D24 epo:PINProfile-D25 epo:CNDefence-D81 epo:PIN-RTL-D25 epo:SocialAndOtherSpecificServices-D24 epo:ConcessionNotice-D23 epo:Modification-D24 epo:CNStandard-D24 epo:DesignContest-D24 epo:QSNotice-D25 epo:CNSocial-D25 epo:Modification-D25 epo:CANSocial-D25 epo:PIN-CFCSocial-D25 epo:PINProfile-D81 epo:VEAT-D24 epo:QS-D25 epo:Subcontract-D81 epo:VEAT-D23 epo:ConcessionAwardNotice-D23 epo:PIN-CFCStandard-D24 epo:CANDefence-D81 epo:Modification-D23 ) .

[] a owl:AllDisjointClasses ;
    owl:members ( epo:DesignContest-D24 epo:DesignContest-D25 epo:Notice23 epo:Notice24 ) .

