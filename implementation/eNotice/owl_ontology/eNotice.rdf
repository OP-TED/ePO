    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#eFormsNotice"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#concernsLot">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">concerns Lot</skos:prefLabel>
    <skos:definition xml:lang="en">Relates to Lot.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#not"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#SubcontractNotice">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">Subcontract Notice</skos:prefLabel>
    <skos:definition xml:lang="en">Announcement of a call for competition by successful tenderers which are not contracting authorities/entities concerning contracts for social and other specific services.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#not"/>
    <skos:historyNote xml:lang="en">WG approval 09/10/2025</skos:historyNote>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#CompetitionNotice"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#PINTransportationNotice">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">PIN Transportation Notice</skos:prefLabel>
    <skos:definition xml:lang="en">Announcement of the intention to award a public service contract for public passenger transport services.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#not"/>
    <skos:historyNote xml:lang="en">WG approval 09/10/2025</skos:historyNote>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#PlanningNotice"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#Notice15">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">Notice15</skos:prefLabel>
    <skos:definition xml:lang="en">Notice on the existence of a qualification system - sectoral directive</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#not"/>
    <skos:historyNote xml:lang="en">WG approval 16/09/2025</skos:historyNote>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#QSNotice"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#eFormsNotice"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#Notice28">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">Notice28</skos:prefLabel>
    <skos:definition xml:lang="en">Voluntary ex-ante transparency notice - concession directive</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#not"/>
    <skos:historyNote xml:lang="en">WG approval 16/09/2025</skos:historyNote>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#VoluntaryEx-AnteTransparencyNotice"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#eFormsNotice"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#QSNotice">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">QS Notice</skos:prefLabel>
    <skos:definition xml:lang="en">Announcement of a system of qualification of economic operators on the basis of exclusion and selection criteria. Additional information: The announcement can be used as a call for competition. When a call for competition is made by means of a notice on the existence of a qualification system, specific contracts for the works, supplies or services covered by the qualification system shall be awarded by restricted procedures or negotiated procedures, in which all tenderers and participants are selected among the candidates already qualified in accordance with such a system.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#not"/>
    <skos:historyNote xml:lang="en">WG approval 09/10/2025</skos:historyNote>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#CompetitionNotice"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#eFormsNotice">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">e Forms Notice</skos:prefLabel>
    <skos:definition xml:lang="en">eForms Notice</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#not"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#announcesPlannedProcurement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">announces Planned Procurement</skos:prefLabel>
    <skos:definition xml:lang="en">Relation indicating the formal communication of a Planned Procurement.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#not"/>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#ResultNotice">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">Result Notice</skos:prefLabel>
    <skos:definition xml:lang="en">An announcement of the award or non-award of a Contract by a Buyer.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#not"/>
    <skos:historyNote xml:lang="en">WG Approval 27/03/2019</skos:historyNote>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Notice"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#Notice11">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">Notice11</skos:prefLabel>
    <skos:definition xml:lang="en">Periodic indicative notice used as a call for competition - sectoral directive, standard regime</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#not"/>
    <skos:historyNote xml:lang="en">WG approval 16/09/2025</skos:historyNote>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#PIN-CFCStandardNotice"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#eFormsNotice"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#PINTimeLimitNotice">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">PIN Time Limit Notice</skos:prefLabel>
    <skos:definition xml:lang="en">Announcement of intentions of planned procurements in view of shortening time limits for reception of tenders. Additional information: Where contracting authorities have published a prior information notice which was not itself used as a means of calling for competition, the minimum time limit for the receipt of tenders may be shortened.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#not"/>
    <skos:historyNote xml:lang="en">WG approval 09/10/2025</skos:historyNote>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#PlanningNotice"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#VoluntaryEx-AnteTransparencyNotice">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">Voluntary Ex- Ante Transparency Notice</skos:prefLabel>
    <skos:definition xml:lang="en">Announcement of the intention to award of a contract without prior publication of a contract notice.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#not"/>
    <skos:historyNote xml:lang="en">WG approval 09/10/2025</skos:historyNote>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#DirectAwardPrenotificationNotice"/>
