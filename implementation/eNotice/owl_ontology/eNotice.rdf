    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#not"/>
    <skos:historyNote xml:lang="en">WG approval 16/09/2025</skos:historyNote>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#QSNotice"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#StandardFormsNotice"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#StandardFormsNotice">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">Standard Forms Notice</skos:prefLabel>
    <skos:definition xml:lang="en">Standard Forms Notice</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#not"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#refersToAwardDecision">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">refers To Award Decision</skos:prefLabel>
    <skos:definition xml:lang="en">Reference to an Award Decision.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#not"/>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#PIN-CFCStandard-D24">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">PI N- CFC Standard- D24</skos:prefLabel>
    <skos:definition xml:lang="en">Prior information notice used as a Call For Competition using the standard regime under Directive 24. Additional information: The standard regime refers to the core rules for public procurement, which mandates that public authorities award contracts in compliance with EU principles of equal treatment and transparency.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#not"/>
    <skos:historyNote xml:lang="en">WG approval 16/09/2025</skos:historyNote>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#PIN-CFCStandardNotice"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#StandardFormsNotice"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#concernsProcedure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">concerns Procedure</skos:prefLabel>
    <skos:definition xml:lang="en">Relates to Procedure.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#not"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#Notice21">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">Notice21</skos:prefLabel>
    <skos:definition xml:lang="en">Contract notice - sectoral directive, light regime</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#not"/>
    <skos:historyNote xml:lang="en">WG approval 16/09/2025</skos:historyNote>
