    <rdfs:comment>This version is automatically generated from eNotice.xml on 2025-10-10</rdfs:comment>
    <rdfs:label xml:lang="en">eProcurement Ontology Notice - core</rdfs:label>
    <dcterms:description xml:lang="en">The eProcurement Ontology Notice core describes the concepts and properties representing the European Public Procurement Notice domain. The provision of these semantics offers the basis for a common understanding of the domain for all stakeholders ensuring the quality of data exchange and transparency. The ontology restrictions are published in a separate artefact.</dcterms:description>
    <dcterms:title xml:lang="en">eProcurement Ontology Notice - core</dcterms:title>
    <vann:preferredNamespaceUri>http://data.europa.eu/a4g/ontology#</vann:preferredNamespaceUri>
    <owl:versionIRI rdf:resource="http://data.europa.eu/a4g/ontology#not-5.2.0"/>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-10-10</dcterms:issued>
    <owl:priorVersion>http://data.europa.eu/a4g/ontology#not-5.1.0</owl:priorVersion>
    <owl:versionInfo>5.2.0</owl:versionInfo>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:incompatibleWith>4.2.0</owl:incompatibleWith>
    <vann:preferredNamespacePrefix>epo</vann:preferredNamespacePrefix>
    <dcterms:license>© European Union, 2014. Unless otherwise noted, the reuse of the Ontology is authorised under the European Union Public Licence v1.2 (https://eupl.eu/).</dcterms:license>
  </rdf:Description>
