    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#PINOnlyNotice"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#eFormsNotice"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#VEAT-D24">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">VEA T- D24</skos:prefLabel>
    <skos:definition xml:lang="en">Voluntary ex-ante transparency notice under Directive 24.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#not"/>
    <skos:historyNote xml:lang="en">WG approval 16/09/2025</skos:historyNote>
