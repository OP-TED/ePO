  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#NoticeE2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">Notice E2</skos:prefLabel>
    <skos:definition xml:lang="en">Voluntary Prior Information Notice for purchases below the Public Procurement Directive threshold.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#not"/>
    <skos:historyNote xml:lang="en">WG approval 09/10/2025</skos:historyNote>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#PINOnlyNotice"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#eFormsNotice"/>
