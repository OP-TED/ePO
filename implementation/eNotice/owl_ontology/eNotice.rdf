  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#PlanningNotice">
    <skos:definition xml:lang="en">Notice which sets out the Contracting Authority's purchasing intentions. It is used by Contracting Authorities to provide Suppliers with information about a Procurement Process.</skos:definition>
    <skos:prefLabel xml:lang="en">Planning Notice</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#not"/>
