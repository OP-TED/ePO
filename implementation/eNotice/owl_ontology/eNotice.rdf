  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#PreMarketConsultationNotice">
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Notice"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#not"/>
    <skos:definition xml:lang="en">Announcement of a pre-market consultation. Additional information: A pre-market consultation is not a call for competition and no procurement documents are available at the time of consultation. A consultation may or may not be followed by a future competition.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">Pre Market Consultation Notice</skos:prefLabel>
    <skos:historyNote xml:lang="en">WG Approval 02/05/2024</skos:historyNote>
  </rdf:Description>
