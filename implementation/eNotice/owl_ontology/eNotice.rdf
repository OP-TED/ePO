  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#CNStandardNotice">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">CN Standard Notice</skos:prefLabel>
    <skos:definition xml:lang="en">Announcement of a call for competition concerning contracts or concessions. Additional information: Contract notices shall be used as a means of calling for competition in respect of all procedures, without prejudice to the relevant articles of the Directive.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#not"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#CompetitionNotice"/>
