epo-shape:epo-not-PINTimeLimitNoticeShape a sh:NodeShape ;
    rdfs:label "PIN Time Limit Notice" ;
    rdfs:comment "Announcement of intentions of planned procurements in view of shortening time limits for reception of tenders. Additional information: Where contracting authorities have published a prior information notice which was not itself used as a means of calling for competition, the minimum time limit for the receipt of tenders may be shortened." ;
    rdfs:isDefinedBy epo-shape:not-shape ;
    sh:targetClass epo:PINTimeLimitNotice .

epo-shape:epo-not-PINTransportationNoticeShape a sh:NodeShape ;
