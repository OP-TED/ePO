        epo-shape:epo-not-DirectAwardPrenotificationNotice-epo-announcesNoticeAwardInformation,
        epo-shape:epo-not-DirectAwardPrenotificationNotice-epo-announcesProcedure,
        epo-shape:epo-not-DirectAwardPrenotificationNotice-epo-announcesRole ;
    sh:targetClass epo:DirectAwardPrenotificationNotice .

