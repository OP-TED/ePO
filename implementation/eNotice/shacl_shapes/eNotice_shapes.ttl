    sh:class :DirectAwardPrenotificationNotice ;
    sh:maxCount 1 ;
    sh:name "describes Direct Award Prenotification Notice" ;
    sh:path :describesDirectAwardPrenotificationNotice ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#describesDirectAwardPrenotificationNotice> ?that . ?that <http://data.europa.eu/a4g/ontology#describesDirectAwardPrenotificationNotice> ?this .}" ] .

