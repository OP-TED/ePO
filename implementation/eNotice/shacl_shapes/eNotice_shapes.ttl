@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

epo-shape:epo-NoticeAwardInformation sh:property epo-shape:epo-NoticeAwardInformation-epo-describesDirectAwardPrenotificationNotice,
        epo-shape:epo-NoticeAwardInformation-epo-describesResultNotice .

epo-shape:epo-not-CANDefence-D81Shape a sh:NodeShape ;
    rdfs:label "CAN Defence- D81" ;
    rdfs:comment "Contract Award Notice Defence under Directive 81." ;
    rdfs:isDefinedBy epo-shape:not-shape ;
    sh:targetClass epo:CANDefence-D81 .

epo-shape:epo-not-CANSocial-D25Shape a sh:NodeShape ;
    rdfs:label "CAN Social- D25" ;
    rdfs:comment "Contract Award Notice using the light regime under Directive 25." ;
    rdfs:isDefinedBy epo-shape:not-shape ;
    sh:targetClass epo:CANSocial-D25 .

epo-shape:epo-not-CANSocialNotice-D25Shape a sh:NodeShape ;
    rdfs:label "CAN Social Notice- D25" ;
    rdfs:comment "Additional information: Social and other specific services – utilities" ;
    rdfs:isDefinedBy epo-shape:not-shape ;
    sh:targetClass epo:CANSocialNotice-D25 .

epo-shape:epo-not-CANSocialNoticeShape a sh:NodeShape ;
    rdfs:label "CAN Social Notice" ;
    rdfs:comment "Announcement of the results of a call for competition concerning contracts or concessions for social and other specific services." ;
    rdfs:isDefinedBy epo-shape:not-shape ;
    sh:targetClass epo:CANSocialNotice .

epo-shape:epo-not-CANStandard-D24Shape a sh:NodeShape ;
    rdfs:label "CAN Standard- D24" ;
    rdfs:comment "Contract Award Notice using the standard regime under Directive 24." ;
    rdfs:isDefinedBy epo-shape:not-shape ;
    sh:targetClass epo:CANStandard-D24 .

epo-shape:epo-not-CANStandardNoticeShape a sh:NodeShape ;
    rdfs:label "CAN Standard Notice" ;
    rdfs:comment "Announcement of the results of a call for competition concerning contracts or concessions." ;
    rdfs:isDefinedBy epo-shape:not-shape ;
    sh:targetClass epo:CANStandardNotice .

epo-shape:epo-not-CANTransportationNoticeShape a sh:NodeShape ;
    rdfs:label "CAN Transportation Notice" ;
    rdfs:comment "Announcement that a public service contract for public passenger transport services has been directly awarded." ;
    rdfs:isDefinedBy epo-shape:not-shape ;
    sh:targetClass epo:CANTransportationNotice .

epo-shape:epo-not-CNDefence-D81Shape a sh:NodeShape ;
    rdfs:label "CN Defence- D81" ;
    rdfs:comment "Competition Notice Defence under Directive 81." ;
    rdfs:isDefinedBy epo-shape:not-shape ;
    sh:targetClass epo:CNDefence-D81 .

epo-shape:epo-not-CNSocial-D25Shape a sh:NodeShape ;
    rdfs:label "CN Social- D25" ;
    rdfs:comment "Competition Notice using the light regime under Directive 25." ;
    rdfs:isDefinedBy epo-shape:not-shape ;
    sh:targetClass epo:CNSocial-D25 .

epo-shape:epo-not-CNSocialNotice-D25Shape a sh:NodeShape ;
    rdfs:label "CN Social Notice- D25" ;
    rdfs:comment "Additional information: Social and other specific services – utilities" ;
    rdfs:isDefinedBy epo-shape:not-shape ;
    sh:targetClass epo:CNSocialNotice-D25 .

epo-shape:epo-not-CNSocialNoticeShape a sh:NodeShape ;
    rdfs:label "CN Social Notice" ;
    rdfs:comment "Announcement of a call for competition concerning contracts for social and other specific services." ;
    rdfs:isDefinedBy epo-shape:not-shape ;
    sh:targetClass epo:CNSocialNotice .

epo-shape:epo-not-CNStandard-D24Shape a sh:NodeShape ;
    rdfs:label "CN Standard- D24" ;
    rdfs:comment "Competition Notice using the standard regime under Directive 24." ;
    rdfs:isDefinedBy epo-shape:not-shape ;
    sh:targetClass epo:CNStandard-D24 .

epo-shape:epo-not-CNStandardNoticeShape a sh:NodeShape ;
    rdfs:label "CN Standard Notice" ;
    rdfs:comment "Announcement of a call for competition concerning contracts or concessions. Additional information: Contract notices shall be used as a means of calling for competition in respect of all procedures, without prejudice to the relevant articles of the Directive." ;
    rdfs:isDefinedBy epo-shape:not-shape ;
    sh:targetClass epo:CNStandardNotice .

epo-shape:epo-not-CallForExpressionOfInterestShape a sh:NodeShape ;
    rdfs:label "Call For Expression Of Interest" ;
    rdfs:comment "Invitation for economic operators to be included in a list of pre-selected candidates or vendors, ensuring transparency and competition." ;
    rdfs:isDefinedBy epo-shape:not-shape ;
    sh:targetClass epo:CallForExpressionOfInterest .

epo-shape:epo-not-CompetitionNoticeShape a sh:NodeShape ;
    rdfs:label "Competition Notice" ;
    rdfs:comment "An announcement of the launch of a Procurement Procedure by a Procuring Entity." ;
    rdfs:isDefinedBy epo-shape:not-shape ;
    sh:property epo-shape:epo-not-CompetitionNotice-epo-announcesLot,
        epo-shape:epo-not-CompetitionNotice-epo-announcesLotGroup,
        epo-shape:epo-not-CompetitionNotice-epo-announcesProcedure,
        epo-shape:epo-not-CompetitionNotice-epo-announcesRole ;
    sh:targetClass epo:CompetitionNotice .

epo-shape:epo-not-CompletionNoticeShape a sh:NodeShape ;
    rdfs:label "Completion Notice" ;
    rdfs:comment "An announcement of the end of a Procurement by a Buyer." ;
    rdfs:isDefinedBy epo-shape:not-shape ;
    sh:property epo-shape:epo-not-CompletionNotice-epo-announcesCompletionOfContract,
        epo-shape:epo-not-CompletionNotice-epo-announcesRole,
        epo-shape:epo-not-CompletionNotice-epo-concernsLot,
        epo-shape:epo-not-CompletionNotice-epo-concernsLotGroup,
        epo-shape:epo-not-CompletionNotice-epo-concernsProcedure,
        epo-shape:epo-not-CompletionNotice-epo-refersToAwardDecision,
        epo-shape:epo-not-CompletionNotice-epo-refersToLotGroupAwardInformation,
        epo-shape:epo-not-CompletionNotice-epo-refersToNoticeAwardInformation,
        epo-shape:epo-not-CompletionNotice-epo-refersToReviewRequest,
        epo-shape:epo-not-CompletionNotice-epo-refersToRole ;
    sh:targetClass epo:CompletionNotice .

epo-shape:epo-not-ConcessionAwardNotice-D23Shape a sh:NodeShape ;
    rdfs:label "Concession Award Notice- D23" ;
    rdfs:comment "Concession Award Notice under Directive 23." ;
    rdfs:isDefinedBy epo-shape:not-shape ;
    sh:targetClass epo:ConcessionAwardNotice-D23 .

epo-shape:epo-not-ConcessionNotice-D23Shape a sh:NodeShape ;
    rdfs:label "Concession Notice- D23" ;
    rdfs:comment "Concession Notice under Directive 23." ;
    rdfs:isDefinedBy epo-shape:not-shape ;
    sh:targetClass epo:ConcessionNotice-D23 .

epo-shape:epo-not-ContractModificationNoticeShape a sh:NodeShape ;
    rdfs:label "Contract Modification Notice" ;
    rdfs:comment "An announcement of the Modification of a Contract/Concession during its term by a Procuring Entity." ;
    rdfs:isDefinedBy epo-shape:not-shape ;
    sh:property epo-shape:epo-not-ContractModificationNotice-epo-announcesContractAmendment,
        epo-shape:epo-not-ContractModificationNotice-epo-concernsLot,
        epo-shape:epo-not-ContractModificationNotice-epo-concernsLotGroup,
        epo-shape:epo-not-ContractModificationNotice-epo-concernsProcedure,
        epo-shape:epo-not-ContractModificationNotice-epo-refersToAwardDecision,
        epo-shape:epo-not-ContractModificationNotice-epo-refersToContractToBeModified,
        epo-shape:epo-not-ContractModificationNotice-epo-refersToLotGroupAwardInformation,
        epo-shape:epo-not-ContractModificationNotice-epo-refersToNoticeAwardInformation,
        epo-shape:epo-not-ContractModificationNotice-epo-refersToRole ;
    sh:targetClass epo:ContractModificationNotice .

epo-shape:epo-not-DesignContest-D24Shape a sh:NodeShape ;
