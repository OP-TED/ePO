not-shape:epo-not-PIN-CFCSocial-D25Shape a sh:NodeShape ;
    rdfs:label "PI N- CFC Social- D25" ;
    rdfs:comment "Prior information notice used as a Call For Competition using the light regime under Directive 25. Additional information: The light regime is generally used for procurement of social and other specific services. The light regime may enable reserving Contracts for social enterprises and sheltered workshops." ;
    rdfs:isDefinedBy not-shape:not-shape ;
    sh:targetClass :PIN-CFCSocial-D25 .

not-shape:epo-not-PIN-CFCSocialNotice-D25Shape a sh:NodeShape ;
    rdfs:label "PI N- CFC Social Notice- D25" ;
    rdfs:comment "Additional information: Social and other specific services – utilities" ;
    rdfs:isDefinedBy not-shape:not-shape ;
    sh:targetClass :PIN-CFCSocialNotice-D25 .

not-shape:epo-not-PIN-CFCSocialNoticeShape a sh:NodeShape ;
    rdfs:label "PI N- CFC Social Notice" ;
    rdfs:comment "Announcement of intentions of planned procurements used as a call for competition concerning contracts for social and other specific services." ;
    rdfs:isDefinedBy not-shape:not-shape ;
    sh:targetClass :PIN-CFCSocialNotice .

not-shape:epo-not-PIN-CFCStandard-D24Shape a sh:NodeShape ;
    rdfs:label "PI N- CFC Standard- D24" ;
    rdfs:comment "Prior information notice used as a Call For Competition using the standard regime under Directive 24. Additional information: The standard regime refers to the core rules for public procurement, which mandates that public authorities award contracts in compliance with EU principles of equal treatment and transparency." ;
    rdfs:isDefinedBy not-shape:not-shape ;
    sh:targetClass :PIN-CFCStandard-D24 .

not-shape:epo-not-PIN-CFCStandardNoticeShape a sh:NodeShape ;
    rdfs:label "PI N- CFC Standard Notice" ;
    rdfs:comment "Announcement of intentions of planned procurements used as a call for competition. Additional information: For restricted procedures and competitive procedures with negotiation, sub-central contracting authorities may use a prior information notice as a call for competition pursuant to the relevant article of the Directive." ;
    rdfs:isDefinedBy not-shape:not-shape ;
    sh:targetClass :PIN-CFCStandardNotice .

not-shape:epo-not-PIN-RTL-D24Shape a sh:NodeShape ;
    rdfs:label "PI N- RT L- D24" ;
    rdfs:comment "Prior information notice - Reduced Time Limit under Directive 24." ;
    rdfs:isDefinedBy not-shape:not-shape ;
    sh:targetClass :PIN-RTL-D24 .

not-shape:epo-not-PIN-RTL-D25Shape a sh:NodeShape ;
    rdfs:label "PI N- RT L- D25" ;
    rdfs:comment "Prior information notice - Reduced Time Limit under Directive 25." ;
    rdfs:isDefinedBy not-shape:not-shape ;
    sh:targetClass :PIN-RTL-D25 .

not-shape:epo-not-PINDefence-D81Shape a sh:NodeShape ;
    rdfs:label "PIN Defence- D81" ;
    rdfs:comment "Prior Information Notice Defence under Directive 81." ;
    rdfs:isDefinedBy not-shape:not-shape ;
    sh:targetClass :PINDefence-D81 .

not-shape:epo-not-PINOnly-D24Shape a sh:NodeShape ;
    rdfs:label "PIN Only- D24" ;
    rdfs:comment "Prior Information Notice Only under Directive 24." ;
    rdfs:isDefinedBy not-shape:not-shape ;
    sh:targetClass :PINOnly-D24 .

not-shape:epo-not-PINOnly-D25Shape a sh:NodeShape ;
    rdfs:label "PIN Only- D25" ;
    rdfs:comment "Prior Information Notice Only under Directive 25." ;
    rdfs:isDefinedBy not-shape:not-shape ;
    sh:targetClass :PINOnly-D25 .

not-shape:epo-not-PINOnlyNoticeShape a sh:NodeShape ;
    rdfs:label "PIN Only Notice" ;
    rdfs:comment "Announcement of intentions of planned procurements for information purposes." ;
    rdfs:isDefinedBy not-shape:not-shape ;
    sh:targetClass :PINOnlyNotice .

not-shape:epo-not-PINProfile-D24Shape a sh:NodeShape ;
    rdfs:label "PIN Profile- D24" ;
    rdfs:comment "Prior Information Notice Profile under Directive 24." ;
    rdfs:isDefinedBy not-shape:not-shape ;
    sh:targetClass :PINProfile-D24 .

not-shape:epo-not-PINProfile-D25Shape a sh:NodeShape ;
    rdfs:label "PIN Profile- D25" ;
    rdfs:comment "Prior Information Notice Profile under Directive 25." ;
