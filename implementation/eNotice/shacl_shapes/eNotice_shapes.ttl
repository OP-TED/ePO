epo-shape:epo-not-PlanningNoticeShape a sh:NodeShape ;
    rdfs:label "Planning Notice" ;
    rdfs:comment "Notice which sets out the Contracting Authority's purchasing intentions. It is used by Contracting Authorities to provide Suppliers with information about a Procurement Process." ;
    rdfs:isDefinedBy epo-shape:not-shape ;
    sh:property epo-shape:epo-not-PlanningNotice-epo-announcesLot,
        epo-shape:epo-not-PlanningNotice-epo-announcesLotGroup,
        epo-shape:epo-not-PlanningNotice-epo-announcesPlannedProcurement,
        epo-shape:epo-not-PlanningNotice-epo-announcesPlannedProcurementPart,
