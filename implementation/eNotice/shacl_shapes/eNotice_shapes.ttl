not-shape:epo-NoticeAwardInformationShape sh:property not-shape:epo-NoticeAwardInformation-epo-describesDirectAwardPrenotificationNotice,
        not-shape:epo-NoticeAwardInformation-epo-describesResultNotice .

not-shape:epo-not-CANDefence-D81Shape a sh:NodeShape ;
    rdfs:label "CAN Defence- D81" ;
    rdfs:comment "Contract Award Notice Defence under Directive 81." ;
    rdfs:isDefinedBy not-shape:not-shape ;
    sh:targetClass :CANDefence-D81 .

not-shape:epo-not-CANSocial-D25Shape a sh:NodeShape ;
    rdfs:label "CAN Social- D25" ;
    rdfs:comment "Contract Award Notice using the light regime under Directive 25." ;
    rdfs:isDefinedBy not-shape:not-shape ;
    sh:targetClass :CANSocial-D25 .

not-shape:epo-not-CANSocialNotice-D25Shape a sh:NodeShape ;
