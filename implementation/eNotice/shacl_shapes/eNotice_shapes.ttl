    sh:targetClass :PINProfile-D25 .

not-shape:epo-not-PINProfile-D81Shape a sh:NodeShape ;
    rdfs:label "PIN Profile- D81" ;
    rdfs:comment "Prior Information Notice Profile under Directive 81." ;
    rdfs:isDefinedBy not-shape:not-shape ;
    sh:targetClass :PINProfile-D81 .

not-shape:epo-not-PINProfileNoticeShape a sh:NodeShape ;
    rdfs:label "PIN Profile Notice" ;
    rdfs:comment "Announcement of intentions of planned procurements." ;
    rdfs:isDefinedBy not-shape:not-shape ;
    sh:targetClass :PINProfileNotice .

not-shape:epo-not-PINTimeLimitNoticeShape a sh:NodeShape ;
    rdfs:label "PIN Time Limit Notice" ;
    rdfs:comment "Announcement of intentions of planned procurements in view of shortening time limits for reception of tenders. Additional information: Where contracting authorities have published a prior information notice which was not itself used as a means of calling for competition, the minimum time limit for the receipt of tenders may be shortened." ;
    rdfs:isDefinedBy not-shape:not-shape ;
    sh:targetClass :PINTimeLimitNotice .

not-shape:epo-not-PINTransportationNoticeShape a sh:NodeShape ;
    rdfs:label "PIN Transportation Notice" ;
    rdfs:comment "Announcement of the intention to award a public service contract for public passenger transport services." ;
    rdfs:isDefinedBy not-shape:not-shape ;
    sh:targetClass :PINTransportationNotice .

not-shape:epo-not-PlanningNoticeShape a sh:NodeShape ;
    rdfs:label "Planning Notice" ;
    rdfs:comment "Notice which sets out the Contracting Authority's purchasing intentions. It is used by Contracting Authorities to provide Suppliers with information about a Procurement Process." ;
    rdfs:isDefinedBy not-shape:not-shape ;
    sh:property not-shape:epo-not-PlanningNotice-epo-announcesLot,
        not-shape:epo-not-PlanningNotice-epo-announcesLotGroup,
        not-shape:epo-not-PlanningNotice-epo-announcesPlannedProcurement,
        not-shape:epo-not-PlanningNotice-epo-announcesPlannedProcurementPart,
        not-shape:epo-not-PlanningNotice-epo-announcesProcedure,
        not-shape:epo-not-PlanningNotice-epo-announcesRole ;
    sh:targetClass :PlanningNotice .

not-shape:epo-not-PreMarketConsultationNoticeShape a sh:NodeShape ;
    rdfs:label "Pre Market Consultation Notice" ;
    rdfs:comment "Announcement of a pre-market consultation. Additional information: A pre-market consultation is not a call for competition and no procurement documents are available at the time of consultation. A consultation may or may not be followed by a future competition." ;
    rdfs:isDefinedBy not-shape:not-shape ;
    sh:property not-shape:epo-not-PreMarketConsultationNotice-epo-preparesForPotentialProcurementObject,
        not-shape:epo-not-PreMarketConsultationNotice-epo-refersToRole ;
    sh:targetClass :PreMarketConsultationNotice .

not-shape:epo-not-QS-D25Shape a sh:NodeShape ;
    rdfs:label "Q S- D25" ;
    rdfs:comment "Qualification System under Directive 25." ;
    rdfs:isDefinedBy not-shape:not-shape ;
    sh:targetClass :QS-D25 .

not-shape:epo-not-QSNotice-D25Shape a sh:NodeShape ;
    rdfs:label "QS Notice- D25" ;
    rdfs:comment "Additional information: Social and other specific services – utilities" ;
    rdfs:isDefinedBy not-shape:not-shape ;
    sh:targetClass :QSNotice-D25 .

not-shape:epo-not-QSNoticeShape a sh:NodeShape ;
    rdfs:label "QS Notice" ;
    rdfs:comment "Announcement of a system of qualification of economic operators on the basis of exclusion and selection criteria. Additional information: The announcement can be used as a call for competition. When a call for competition is made by means of a notice on the existence of a qualification system, specific contracts for the works, supplies or services covered by the qualification system shall be awarded by restricted procedures or negotiated procedures, in which all tenderers and participants are selected among the candidates already qualified in accordance with such a system." ;
    rdfs:isDefinedBy not-shape:not-shape ;
    sh:targetClass :QSNotice .

not-shape:epo-not-ResultNoticeShape a sh:NodeShape ;
    rdfs:label "Result Notice" ;
    rdfs:comment "An announcement of the award or non-award of a Contract by a Buyer." ;
    rdfs:isDefinedBy not-shape:not-shape ;
    sh:property not-shape:epo-not-ResultNotice-epo-announcesAwardDecision,
        not-shape:epo-not-ResultNotice-epo-announcesContract,
        not-shape:epo-not-ResultNotice-epo-announcesLotGroupAwardInformation,
        not-shape:epo-not-ResultNotice-epo-announcesNoticeAwardInformation,
        not-shape:epo-not-ResultNotice-epo-announcesReviewDecision,
        not-shape:epo-not-ResultNotice-epo-announcesReviewRequest,
        not-shape:epo-not-ResultNotice-epo-announcesRole,
        not-shape:epo-not-ResultNotice-epo-concernsLot,
        not-shape:epo-not-ResultNotice-epo-concernsLotGroup,
        not-shape:epo-not-ResultNotice-epo-concernsProcedure,
        not-shape:epo-not-ResultNotice-epo-refersToRole ;
    sh:targetClass :ResultNotice .

not-shape:epo-not-SocialAndOtherSpecificServices-D23Shape a sh:NodeShape ;
    rdfs:label "Social And Other Specific Services- D23" ;
    rdfs:comment "Social And Other Specific Services under Directive 23." ;
    rdfs:isDefinedBy not-shape:not-shape ;
    sh:targetClass :SocialAndOtherSpecificServices-D23 .

