not-shape:epo-not-PlanningNoticeShape a sh:NodeShape ;
    rdfs:label "Planning notice" ;
    rdfs:comment "Notice which sets out the Contracting Authority's purchasing intentions. It is used by Contracting Authorities to provide Suppliers with information about a Procurement Process." ;
    rdfs:isDefinedBy not-shape:not-shape ;
    sh:property not-shape:epo-not-PlanningNotice-epo-announcesLot,
        not-shape:epo-not-PlanningNotice-epo-announcesLotGroup,
        not-shape:epo-not-PlanningNotice-epo-announcesPlannedProcurementPart,
        not-shape:epo-not-PlanningNotice-epo-announcesProcedure,
        not-shape:epo-not-PlanningNotice-epo-announcesRole ;
    sh:targetClass :PlanningNotice .

not-shape:epo-not-PreMarketConsultationNoticeShape a sh:NodeShape ;
    rdfs:label "Pre market consultation notice" ;
    rdfs:comment "Announcement of a pre-market consultation. Additional information: A pre-market consultation is not a call for competition and no procurement documents are available at the time of consultation. A consultation may or may not be followed by a future competition." ;
    rdfs:isDefinedBy not-shape:not-shape ;
    sh:property not-shape:epo-not-PreMarketConsultationNotice-epo-preparesForPotentialProcurementObject,
        not-shape:epo-not-PreMarketConsultationNotice-epo-refersToRole ;
    sh:targetClass :PreMarketConsultationNotice .

