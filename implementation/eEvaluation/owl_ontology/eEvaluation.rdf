    <owl:priorVersion>http://data.europa.eu/a4g/ontology#eva-5.0.0</owl:priorVersion>
    <dcterms:description xml:lang="en">The eProcurement Ontology Evaluation core describes the concepts and properties representing the European Public Procurement Evaluation domain. The provision of these semantics offers the basis for a common understanding of the domain for all stakeholders ensuring the quality of data exchange and transparency. The ontology restrictions are published in a separate artefact.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-06-04</dcterms:issued>
    <dcterms:publisher>http://publications.europa.eu/resource/authority/corporate-body/PUBL</dcterms:publisher>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-06-01</dcterms:created>
    <rdfs:label xml:lang="en">eProcurement Ontology Evaluation - core</rdfs:label>
    <rdfs:comment>This version is automatically generated from eEvaluation.xml on 2025-06-04</rdfs:comment>
    <vann:preferredNamespacePrefix>epo</vann:preferredNamespacePrefix>
    <dcterms:title xml:lang="en">eProcurement Ontology Evaluation - core</dcterms:title>
    <owl:versionIRI rdf:resource="http://data.europa.eu/a4g/ontology#eva-5.1.0"/>
    <owl:incompatibleWith>4.2.0</owl:incompatibleWith>
    <vann:preferredNamespaceUri>http://data.europa.eu/a4g/ontology#</vann:preferredNamespaceUri>
