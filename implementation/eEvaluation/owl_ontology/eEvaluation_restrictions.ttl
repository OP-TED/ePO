@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix epo: <http://data.europa.eu/a4g/ontology#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

epo:containsCandidate rdfs:domain epo:ExcludedCandidateList ;
    rdfs:range epo:Candidate .

epo:eva-restriction a owl:Ontology ;
    rdfs:label "eProcurement Ontology Evaluation - core restrictions"@en ;
    dcterms:created "2021-06-01"^^xsd:date ;
    dcterms:description "The eProcurement Ontology Evaluation core restrictions provides the restrictions and the inference-related specifications on the concepts and properties in the eProcurement Ontology Evaluation core."@en ;
    dcterms:issued "2025-10-10"^^xsd:date ;
    dcterms:license "© European Union, 2014. Unless otherwise noted, the reuse of the Ontology is authorised under the European Union Public Licence v1.2 (https://eupl.eu/)." ;
    dcterms:publisher "http://publications.europa.eu/resource/authority/corporate-body/PUBL" ;
    dcterms:title "eProcurement Ontology Evaluation - core restrictions"@en ;
    vann:preferredNamespacePrefix "epo" ;
    vann:preferredNamespaceUri "http://data.europa.eu/a4g/ontology#" ;
    rdfs:comment """This version is automatically generated from eEvaluation.xml on 
                2025-10-10""" ;
    rdfs:seeAlso <https://docs.ted.europa.eu/home/index.html>,
        <https://github.com/OP-TED/ePO/releases>,
        <https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology/about>,
        <https://op.europa.eu/en/web/eu-vocabularies/e-procurement> ;
    owl:imports epo:core,
        epo:eva,
        <http://data.europa.eu/eli/ontology#>,
        <http://data.europa.eu/m8g/>,
        dcterms:,
        skos:,
        <http://www.w3.org/2006/time>,
        <http://www.w3.org/ns/adms>,
        <http://www.w3.org/ns/locn>,
        org:,
        <http://www.w3.org/ns/person> ;
    owl:incompatibleWith "4.2.0" ;
    owl:priorVersion "http://data.europa.eu/a4g/ontology#eva-restriction-5.1.0" ;
    owl:versionIRI epo:eva-restriction-5.2.0 ;
    owl:versionInfo "5.2.0" .

epo:hasEvaluator rdfs:domain epo:EvaluationBoard ;
    rdfs:range epo:Evaluator .

epo:hasJuryMember rdfs:domain epo:EvaluationBoard ;
    rdfs:range epo:JuryMember .

epo:isAssignedForEvaluationOf rdfs:domain epo:EvaluationBoard ;
    rdfs:range epo:Lot .

epo:requestsClarification rdfs:domain epo:EvaluationBoard ;
    rdfs:range epo:TenderClarificationRequest .

epo:TenderClarification rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:refersToTenderClarificationRequest ] .

epo:concernsEvaluationReport rdfs:domain epo:TenderClarificationRequest ;
    rdfs:range epo:EvaluationReport .

epo:evaluatesProcurementCriterion a owl:FunctionalProperty ;
    rdfs:domain epo:EvaluationCriterion ;
    rdfs:range epo:ProcurementCriterion .

epo:fulfillsProcurementCriterion rdfs:domain epo:EvaluationCriterion ;
    rdfs:range xsd:boolean .

epo:hasAwardCriteriaEvaluationScore rdfs:domain epo:EvaluationReport ;
    rdfs:range rdf:PlainLiteral .

epo:hasEvaluationJustification rdfs:domain epo:EvaluationCriterion ;
    rdfs:range rdf:PlainLiteral .

epo:hasScorePoint rdfs:domain epo:EvaluationCriterion ;
    rdfs:range rdf:PlainLiteral .

epo:isAppointedBy a owl:FunctionalProperty ;
    rdfs:domain epo:EvaluationBoard ;
    rdfs:range epo:UniqueResponsibleOfTheProcurement .

epo:playedBy rdfs:domain epo:Evaluator ;
    rdfs:range <http://www.w3.org/ns/person#Person> .

epo:providesRankToTender a owl:FunctionalProperty ;
    rdfs:domain epo:EvaluationReport ;
    rdfs:range epo:TenderAwardOutcome .

epo:refersToTenderClarificationRequest a owl:FunctionalProperty ;
    rdfs:domain epo:TenderClarification ;
    rdfs:range epo:TenderClarificationRequest .

epo:reportsEvaluationCriterion rdfs:domain epo:EvaluationReport ;
    rdfs:range epo:EvaluationCriterion .

epo:specifiesEconomicOperator a owl:FunctionalProperty ;
    rdfs:domain epo:TenderClarificationRequest ;
    rdfs:range epo:OfferingParty .

epo:usesEvaluationFormula rdfs:domain epo:EvaluationReport ;
    rdfs:range epo:AwardEvaluationTerm .

epo:writesEvaluationReport rdfs:domain epo:EvaluationBoard ;
    rdfs:range epo:EvaluationReport .

epo:Evaluator rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:playedBy ] .

epo:EvaluationCriterion rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:hasEvaluationJustification ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:evaluatesProcurementCriterion ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:hasScorePoint ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:fulfillsProcurementCriterion ] .

epo:TenderClarificationRequest rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <http://data.europa.eu/m8g/hasRequirement> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:concernsEvaluationReport ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:specifiesEconomicOperator ] .

epo:EvaluationBoard rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty epo:writesEvaluationReport ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:isAppointedBy ] .

epo:EvaluationReport rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:usesEvaluationFormula ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:hasAwardCriteriaEvaluationScore ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty epo:reportsEvaluationCriterion ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:providesRankToTender ] .

[] a owl:AllDisjointClasses ;
    owl:members ( epo:EvaluationReport epo:TenderClarificationRequest ) .

