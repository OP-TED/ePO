@prefix : <http://data.europa.eu/a4g/ontology#> .
@prefix cccev: <http://data.europa.eu/m8g/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eli: <http://data.europa.eu/eli/ontology#> .
@prefix eva-shape: <http://data.europa.eu/a4g/data-shape#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix person: <http://www.w3.org/ns/person#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

eva-shape:epo-eva-EvaluationBoard a sh:NodeShape ;
    rdfs:label "Evaluation Board" ;
    rdfs:comment "Committee set up to evaluate the Tenders submitted. Additional Information: The committee may be a regular board or a jury." ;
    rdfs:isDefinedBy eva-shape:eva-shape ;
    sh:property eva-shape:epo-eva-EvaluationBoard-epo-eva-hasEvaluator,
        eva-shape:epo-eva-EvaluationBoard-epo-eva-hasJuryMember,
        eva-shape:epo-eva-EvaluationBoard-epo-eva-isAppointedBy,
        eva-shape:epo-eva-EvaluationBoard-epo-eva-requestsClarification,
        eva-shape:epo-eva-EvaluationBoard-epo-eva-writesEvaluationReport,
        eva-shape:epo-eva-EvaluationBoard-epo-isAssignedForEvaluationOf ;
    sh:targetClass :EvaluationBoard .

eva-shape:epo-eva-EvaluationCriterion a sh:NodeShape ;
    rdfs:label "Evaluation Criterion" ;
    rdfs:isDefinedBy eva-shape:eva-shape ;
    sh:property eva-shape:epo-eva-EvaluationCriterion-epo-eva-evaluatesProcurementCriterion,
        eva-shape:epo-eva-EvaluationCriterion-epo-eva-fulfillsProcurementCriterion,
        eva-shape:epo-eva-EvaluationCriterion-epo-eva-hasEvaluationJustification,
        eva-shape:epo-eva-EvaluationCriterion-epo-eva-hasScorePoint ;
    sh:targetClass :EvaluationCriterion .

eva-shape:epo-eva-EvaluationReport a sh:NodeShape ;
    rdfs:label "Evaluation Report" ;
    rdfs:isDefinedBy eva-shape:eva-shape ;
    sh:property eva-shape:epo-eva-EvaluationReport-epo-eva-hasAwardCriteriaEvaluationScore,
        eva-shape:epo-eva-EvaluationReport-epo-eva-providesRankToTender,
        eva-shape:epo-eva-EvaluationReport-epo-eva-reportsEvaluationCriterion,
        eva-shape:epo-eva-EvaluationReport-epo-eva-usesEvaluationFormula ;
    sh:targetClass :EvaluationReport .

eva-shape:epo-eva-Evaluator a sh:NodeShape ;
    rdfs:label "Evaluator" ;
    rdfs:isDefinedBy eva-shape:eva-shape ;
    sh:property eva-shape:epo-eva-Evaluator-epo-playedBy ;
    sh:targetClass :Evaluator .

eva-shape:epo-eva-ExcludedCandidateList a sh:NodeShape ;
    rdfs:label "Excluded Candidate List" ;
    rdfs:isDefinedBy eva-shape:eva-shape ;
    sh:property eva-shape:epo-eva-ExcludedCandidateList-epo-containsCandidate ;
    sh:targetClass :ExcludedCandidateList .

eva-shape:epo-eva-TenderClarification a sh:NodeShape ;
    rdfs:label "Tender Clarification" ;
    rdfs:isDefinedBy eva-shape:eva-shape ;
    sh:property eva-shape:epo-eva-TenderClarification-epo-eva-refersToTenderClarificationRequest ;
    sh:targetClass :TenderClarification .

eva-shape:epo-eva-TenderClarificationRequest a sh:NodeShape ;
    rdfs:label "Tender Clarification Request" ;
    rdfs:comment "A demand for elucidation of specific aspects of the Tender. Additional Information: This request and its answer may not alter the Tender." ;
    rdfs:isDefinedBy eva-shape:eva-shape ;
    sh:property eva-shape:epo-eva-TenderClarificationRequest-epo-eva-concernsEvaluationReport,
        eva-shape:epo-eva-TenderClarificationRequest-epo-specifiesEconomicOperator ;
    sh:targetClass :TenderClarificationRequest .

eva-shape:epo-eva-EvaluationBoard-epo-eva-hasEvaluator a sh:PropertyShape ;
    sh:class :Evaluator ;
    sh:name "has Evaluator" ;
    sh:path :hasEvaluator ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasEvaluator> ?that . ?that <http://data.europa.eu/a4g/ontology#hasEvaluator> ?this .}" ] .

eva-shape:epo-eva-EvaluationBoard-epo-eva-hasJuryMember a sh:PropertyShape ;
    sh:class :JuryMember ;
    sh:description "An agent involved in an evaluation board." ;
    sh:name "has Jury Member" ;
    sh:path :hasJuryMember ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasJuryMember> ?that . ?that <http://data.europa.eu/a4g/ontology#hasJuryMember> ?this .}" ] .

eva-shape:epo-eva-EvaluationBoard-epo-eva-isAppointedBy a sh:PropertyShape ;
    sh:class :UniqueResponsibleOfTheProcurement ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "is Appointed By" ;
    sh:path :isAppointedBy ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#isAppointedBy> ?that . ?that <http://data.europa.eu/a4g/ontology#isAppointedBy> ?this .}" ] .

eva-shape:epo-eva-EvaluationBoard-epo-eva-requestsClarification a sh:PropertyShape ;
    sh:class :TenderClarificationRequest ;
    sh:name "requests Clarification" ;
    sh:path :requestsClarification ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#requestsClarification> ?that . ?that <http://data.europa.eu/a4g/ontology#requestsClarification> ?this .}" ] .

eva-shape:epo-eva-EvaluationBoard-epo-eva-writesEvaluationReport a sh:PropertyShape ;
    sh:class :EvaluationReport ;
    sh:minCount 1 ;
    sh:name "writes Evaluation Report" ;
    sh:path :writesEvaluationReport ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#writesEvaluationReport> ?that . ?that <http://data.europa.eu/a4g/ontology#writesEvaluationReport> ?this .}" ] .

eva-shape:epo-eva-EvaluationBoard-epo-isAssignedForEvaluationOf a sh:PropertyShape ;
    sh:class :Lot ;
    sh:name "is Assigned For Evaluation Of" ;
    sh:path :isAssignedForEvaluationOf ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#isAssignedForEvaluationOf> ?that . ?that <http://data.europa.eu/a4g/ontology#isAssignedForEvaluationOf> ?this .}" ] .

eva-shape:epo-eva-EvaluationCriterion-epo-eva-evaluatesProcurementCriterion a sh:PropertyShape ;
    sh:class :ProcurementCriterion ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "evaluates Procurement Criterion" ;
    sh:path :evaluatesProcurementCriterion ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#evaluatesProcurementCriterion> ?that . ?that <http://data.europa.eu/a4g/ontology#evaluatesProcurementCriterion> ?this .}" ] .

eva-shape:epo-eva-EvaluationCriterion-epo-eva-fulfillsProcurementCriterion a sh:PropertyShape ;
    rdfs:isDefinedBy eva-shape:eva-shape ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 ;
    sh:name "fulfills Procurement Criterion" ;
    sh:path :fulfillsProcurementCriterion .

eva-shape:epo-eva-EvaluationCriterion-epo-eva-hasEvaluationJustification a sh:PropertyShape ;
    rdfs:isDefinedBy eva-shape:eva-shape ;
    sh:maxCount 1 ;
    sh:name "has Evaluation Justification" ;
    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
    sh:path :hasEvaluationJustification .

eva-shape:epo-eva-EvaluationCriterion-epo-eva-hasScorePoint a sh:PropertyShape ;
    rdfs:isDefinedBy eva-shape:eva-shape ;
    sh:maxCount 1 ;
    sh:name "has Score Point" ;
    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
    sh:path :hasScorePoint .

eva-shape:epo-eva-EvaluationReport-epo-eva-hasAwardCriteriaEvaluationScore a sh:PropertyShape ;
    rdfs:isDefinedBy eva-shape:eva-shape ;
    sh:maxCount 1 ;
    sh:name "has Award Criteria Evaluation Score" ;
    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
    sh:path :hasAwardCriteriaEvaluationScore .

eva-shape:epo-eva-EvaluationReport-epo-eva-providesRankToTender a sh:PropertyShape ;
    sh:class :TenderAwardOutcome ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "provides Rank To Tender" ;
    sh:path :providesRankToTender ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#providesRankToTender> ?that . ?that <http://data.europa.eu/a4g/ontology#providesRankToTender> ?this .}" ] .

eva-shape:epo-eva-EvaluationReport-epo-eva-reportsEvaluationCriterion a sh:PropertyShape ;
    sh:class :EvaluationCriterion ;
    sh:minCount 1 ;
    sh:name "reports Evaluation Criterion" ;
    sh:path :reportsEvaluationCriterion ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#reportsEvaluationCriterion> ?that . ?that <http://data.europa.eu/a4g/ontology#reportsEvaluationCriterion> ?this .}" ] .

eva-shape:epo-eva-EvaluationReport-epo-eva-usesEvaluationFormula a sh:PropertyShape ;
    sh:class :AwardEvaluationTerm ;
    sh:maxCount 1 ;
    sh:name "uses Evaluation Formula" ;
    sh:path :usesEvaluationFormula ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#usesEvaluationFormula> ?that . ?that <http://data.europa.eu/a4g/ontology#usesEvaluationFormula> ?this .}" ] .

eva-shape:epo-eva-Evaluator-epo-playedBy a sh:PropertyShape ;
    sh:class person:Person ;
    sh:maxCount 1 ;
    sh:name "played By" ;
    sh:path :playedBy ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#playedBy> ?that . ?that <http://data.europa.eu/a4g/ontology#playedBy> ?this .}" ] .

eva-shape:epo-eva-ExcludedCandidateList-epo-containsCandidate a sh:PropertyShape ;
    sh:class :Candidate ;
    sh:name "contains Candidate" ;
    sh:path :containsCandidate ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#containsCandidate> ?that . ?that <http://data.europa.eu/a4g/ontology#containsCandidate> ?this .}" ] .

eva-shape:epo-eva-TenderClarification-epo-eva-refersToTenderClarificationRequest a sh:PropertyShape ;
    sh:class :TenderClarificationRequest ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "refers To Tender Clarification Request" ;
    sh:path :refersToTenderClarificationRequest ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#refersToTenderClarificationRequest> ?that . ?that <http://data.europa.eu/a4g/ontology#refersToTenderClarificationRequest> ?this .}" ] .

eva-shape:epo-eva-TenderClarificationRequest-epo-eva-concernsEvaluationReport a sh:PropertyShape ;
    sh:class :EvaluationReport ;
    sh:maxCount 1 ;
    sh:name "concerns Evaluation Report" ;
    sh:path :concernsEvaluationReport ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#concernsEvaluationReport> ?that . ?that <http://data.europa.eu/a4g/ontology#concernsEvaluationReport> ?this .}" ] .

eva-shape:epo-eva-TenderClarificationRequest-epo-specifiesEconomicOperator a sh:PropertyShape ;
    sh:class :OfferingParty ;
    sh:maxCount 1 ;
