@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix epo: <http://data.europa.eu/a4g/ontology#> .
@prefix epo-shape: <http://data.europa.eu/a4g/data-shape#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

epo-shape:epo-eva-EvaluationBoardShape a sh:NodeShape ;
    rdfs:label "Evaluation Board" ;
    rdfs:comment "Committee set up to evaluate the Tenders submitted. Additional Information: The committee may be a regular board or a jury." ;
    rdfs:isDefinedBy epo-shape:eva-shape ;
    sh:property epo-shape:epo-eva-EvaluationBoard-epo-eva-hasEvaluator,
        epo-shape:epo-eva-EvaluationBoard-epo-eva-hasJuryMember,
        epo-shape:epo-eva-EvaluationBoard-epo-eva-isAppointedBy,
        epo-shape:epo-eva-EvaluationBoard-epo-eva-requestsClarification,
        epo-shape:epo-eva-EvaluationBoard-epo-eva-writesEvaluationReport,
        epo-shape:epo-eva-EvaluationBoard-epo-isAssignedForEvaluationOf ;
    sh:targetClass epo:EvaluationBoard .

epo-shape:epo-eva-EvaluationCriterionShape a sh:NodeShape ;
    rdfs:label "Evaluation Criterion" ;
    rdfs:comment "A Criterion used by the Buyer to assess and compare Tenders in order to determine which Offer best meets the objectives of the Procurement Procedure." ;
    rdfs:isDefinedBy epo-shape:eva-shape ;
    sh:property epo-shape:epo-eva-EvaluationCriterion-epo-eva-evaluatesProcurementCriterion,
        epo-shape:epo-eva-EvaluationCriterion-epo-eva-fulfillsProcurementCriterion,
        epo-shape:epo-eva-EvaluationCriterion-epo-eva-hasEvaluationJustification,
        epo-shape:epo-eva-EvaluationCriterion-epo-eva-hasScorePoint ;
    sh:targetClass epo:EvaluationCriterion .

epo-shape:epo-eva-EvaluationReportShape a sh:NodeShape ;
    rdfs:label "Evaluation Report" ;
    rdfs:comment "Summary of the Evaluation." ;
    rdfs:isDefinedBy epo-shape:eva-shape ;
    sh:property epo-shape:epo-eva-EvaluationReport-epo-eva-hasAwardCriteriaEvaluationScore,
        epo-shape:epo-eva-EvaluationReport-epo-eva-providesRankToTender,
        epo-shape:epo-eva-EvaluationReport-epo-eva-reportsEvaluationCriterion,
        epo-shape:epo-eva-EvaluationReport-epo-eva-usesEvaluationFormula ;
    sh:targetClass epo:EvaluationReport .

epo-shape:epo-eva-EvaluatorShape a sh:NodeShape ;
    rdfs:label "Evaluator" ;
    rdfs:comment "A Role of an Agent that asses the Tender submitted for a Lot." ;
    rdfs:isDefinedBy epo-shape:eva-shape ;
    sh:property epo-shape:epo-eva-Evaluator-epo-playedBy ;
    sh:targetClass epo:Evaluator .

epo-shape:epo-eva-ExcludedCandidateListShape a sh:NodeShape ;
    rdfs:label "Excluded Candidate List" ;
    rdfs:comment "Record of Candidates prevented from participating in a Procurement because one or more Exclusion Grounds apply." ;
    rdfs:isDefinedBy epo-shape:eva-shape ;
    sh:property epo-shape:epo-eva-ExcludedCandidateList-epo-containsCandidate ;
    sh:targetClass epo:ExcludedCandidateList .

epo-shape:epo-eva-TenderClarificationRequestShape a sh:NodeShape ;
    rdfs:label "Tender Clarification Request" ;
    rdfs:comment "A demand for elucidation of specific aspects of the Tender. Additional Information: This request and its answer may not alter the Tender." ;
    rdfs:isDefinedBy epo-shape:eva-shape ;
    sh:property epo-shape:epo-eva-TenderClarificationRequest-epo-eva-concernsEvaluationReport,
        epo-shape:epo-eva-TenderClarificationRequest-epo-specifiesEconomicOperator ;
    sh:targetClass epo:TenderClarificationRequest .

epo-shape:epo-eva-TenderClarificationShape a sh:NodeShape ;
    rdfs:label "Tender Clarification" ;
    rdfs:comment "A Document sent by the Tenderer to the Buyer in response to the Tender Clarification Request. Additional Information: The Tender Clarification may not alter the Tender." ;
    rdfs:isDefinedBy epo-shape:eva-shape ;
    sh:property epo-shape:epo-eva-TenderClarification-epo-eva-refersToTenderClarificationRequest ;
    sh:targetClass epo:TenderClarification .

epo-shape:epo-eva-EvaluationBoard-epo-eva-hasEvaluator a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:eva-shape ;
    sh:class epo:Evaluator ;
    sh:description "Relation indicating that the instance of the concept has an Evaluator." ;
    sh:name "Has evaluator" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasEvaluator ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasEvaluator> ?that . ?that <http://data.europa.eu/a4g/ontology#hasEvaluator> ?this .}" ] .

epo-shape:epo-eva-EvaluationBoard-epo-eva-hasJuryMember a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:eva-shape ;
    sh:class epo:JuryMember ;
    sh:description "An agent involved in an evaluation board." ;
    sh:name "Has jury member" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasJuryMember ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasJuryMember> ?that . ?that <http://data.europa.eu/a4g/ontology#hasJuryMember> ?this .}" ] .

epo-shape:epo-eva-EvaluationBoard-epo-eva-isAppointedBy a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:eva-shape ;
    sh:class epo:UniqueResponsibleOfTheProcurement ;
    sh:description "Relation indicating that by whom the instance of the concept is formally assigned." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Is appointed by" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:isAppointedBy ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#isAppointedBy> ?that . ?that <http://data.europa.eu/a4g/ontology#isAppointedBy> ?this .}" ] .

epo-shape:epo-eva-EvaluationBoard-epo-eva-requestsClarification a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:eva-shape ;
    sh:class epo:TenderClarificationRequest ;
    sh:description "Asks for more information." ;
    sh:name "Requests clarification" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:requestsClarification ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#requestsClarification> ?that . ?that <http://data.europa.eu/a4g/ontology#requestsClarification> ?this .}" ] .

epo-shape:epo-eva-EvaluationBoard-epo-eva-writesEvaluationReport a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:eva-shape ;
    sh:class epo:EvaluationReport ;
    sh:description "Authors an Evaluation Report." ;
    sh:minCount 1 ;
    sh:name "Writes evaluation report" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:writesEvaluationReport ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#writesEvaluationReport> ?that . ?that <http://data.europa.eu/a4g/ontology#writesEvaluationReport> ?this .}" ] .

epo-shape:epo-eva-EvaluationBoard-epo-isAssignedForEvaluationOf a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:eva-shape ;
    sh:class epo:Lot ;
    sh:description "Relation indicating that the instance of the concept is selected for Evaluation." ;
    sh:name "Is assigned for evaluation of" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:isAssignedForEvaluationOf ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#isAssignedForEvaluationOf> ?that . ?that <http://data.europa.eu/a4g/ontology#isAssignedForEvaluationOf> ?this .}" ] .

epo-shape:epo-eva-EvaluationCriterion-epo-eva-evaluatesProcurementCriterion a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:eva-shape ;
    sh:class epo:ProcurementCriterion ;
    sh:description "Assesses Procurement Criterion." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Evaluates procurement criterion" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:evaluatesProcurementCriterion ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#evaluatesProcurementCriterion> ?that . ?that <http://data.europa.eu/a4g/ontology#evaluatesProcurementCriterion> ?this .}" ] .

epo-shape:epo-eva-EvaluationCriterion-epo-eva-fulfillsProcurementCriterion a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:eva-shape ;
    sh:datatype xsd:boolean ;
    sh:description "Indicates whether the Procurement Criterion is satisfied." ;
    sh:maxCount 1 ;
    sh:name "Fulfills procurement criterion" ;
    sh:path epo:fulfillsProcurementCriterion .

epo-shape:epo-eva-EvaluationCriterion-epo-eva-hasEvaluationJustification a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:eva-shape ;
    sh:description "The motivation behind the Evaluation result." ;
    sh:maxCount 1 ;
    sh:name "Has evaluation justification" ;
    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
    sh:path epo:hasEvaluationJustification .

epo-shape:epo-eva-EvaluationCriterion-epo-eva-hasScorePoint a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:eva-shape ;
    sh:description "The grade value assigned to a Procurement Criterion." ;
    sh:maxCount 1 ;
    sh:name "Has score point" ;
    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
    sh:path epo:hasScorePoint .

epo-shape:epo-eva-EvaluationReport-epo-eva-hasAwardCriteriaEvaluationScore a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:eva-shape ;
    sh:description "The total number of points obtained while assessing the Award Criteria." ;
    sh:maxCount 1 ;
    sh:name "Has award criteria evaluation score" ;
    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
    sh:path epo:hasAwardCriteriaEvaluationScore .

epo-shape:epo-eva-EvaluationReport-epo-eva-providesRankToTender a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:eva-shape ;
    sh:class epo:TenderAwardOutcome ;
    sh:description "Makes available the assigned position for the Tender." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Provides rank to tender" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:providesRankToTender ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#providesRankToTender> ?that . ?that <http://data.europa.eu/a4g/ontology#providesRankToTender> ?this .}" ] .

epo-shape:epo-eva-EvaluationReport-epo-eva-reportsEvaluationCriterion a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:eva-shape ;
    sh:class epo:EvaluationCriterion ;
    sh:description "Provides an Evaluation Criterion." ;
    sh:minCount 1 ;
    sh:name "Reports evaluation criterion" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:reportsEvaluationCriterion ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#reportsEvaluationCriterion> ?that . ?that <http://data.europa.eu/a4g/ontology#reportsEvaluationCriterion> ?this .}" ] .

epo-shape:epo-eva-EvaluationReport-epo-eva-usesEvaluationFormula a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:eva-shape ;
    sh:class epo:AwardEvaluationTerm ;
    sh:description "Applies systematic method for assessment." ;
    sh:maxCount 1 ;
    sh:name "Uses evaluation formula" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:usesEvaluationFormula ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#usesEvaluationFormula> ?that . ?that <http://data.europa.eu/a4g/ontology#usesEvaluationFormula> ?this .}" ] .

epo-shape:epo-eva-Evaluator-epo-playedBy a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:eva-shape ;
    sh:class <http://www.w3.org/ns/person#Person> ;
    sh:description "Relation indicating the Agent that fulfills the function of the instance of the concept." ;
    sh:maxCount 1 ;
    sh:name "Played by" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:playedBy ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#playedBy> ?that . ?that <http://data.europa.eu/a4g/ontology#playedBy> ?this .}" ] .

epo-shape:epo-eva-ExcludedCandidateList-epo-containsCandidate a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:eva-shape ;
    sh:class epo:Candidate ;
    sh:name "Contains candidate" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:containsCandidate ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#containsCandidate> ?that . ?that <http://data.europa.eu/a4g/ontology#containsCandidate> ?this .}" ] .

epo-shape:epo-eva-TenderClarification-epo-eva-refersToTenderClarificationRequest a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:eva-shape ;
    sh:class epo:TenderClarificationRequest ;
    sh:description "Reference to a Tender Clarification Request." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Refers to tender clarification request" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:refersToTenderClarificationRequest ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#refersToTenderClarificationRequest> ?that . ?that <http://data.europa.eu/a4g/ontology#refersToTenderClarificationRequest> ?this .}" ] .

epo-shape:epo-eva-TenderClarificationRequest-epo-eva-concernsEvaluationReport a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:eva-shape ;
    sh:class epo:EvaluationReport ;
    sh:description "Relates to Evaluation Report." ;
    sh:maxCount 1 ;
    sh:name "Concerns evaluation report" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:concernsEvaluationReport ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#concernsEvaluationReport> ?that . ?that <http://data.europa.eu/a4g/ontology#concernsEvaluationReport> ?this .}" ] .

epo-shape:epo-eva-TenderClarificationRequest-epo-specifiesEconomicOperator a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:eva-shape ;
    sh:class epo:OfferingParty ;
    sh:description "Relation indicating that the instance of the concept involves the Economic Operator." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Specifies economic operator" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:specifiesEconomicOperator ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#specifiesEconomicOperator> ?that . ?that <http://data.europa.eu/a4g/ontology#specifiesEconomicOperator> ?this .}" ] .

epo-shape:eva-shape a owl:Ontology ;
    rdfs:label "eProcurement Ontology Evaluation - core shapes"@en ;
    dcterms:created "2021-06-01"^^xsd:date ;
    dcterms:description "The eProcurement Ontology Evaluation core shapes provides the generic datashape specifications for the eProcurement Ontology Evaluation core."@en ;
    dcterms:issued "2025-10-10"^^xsd:date ;
    dcterms:license "© European Union, 2014. Unless otherwise noted, the reuse of the Ontology is authorised under the European Union Public Licence v1.2 (https://eupl.eu/)." ;
    dcterms:publisher "http://publications.europa.eu/resource/authority/corporate-body/PUBL" ;
    dcterms:title "eProcurement Ontology Evaluation - core shapes"@en ;
    vann:preferredNamespacePrefix "epo" ;
    vann:preferredNamespaceUri "http://data.europa.eu/a4g/ontology#" ;
    rdfs:comment "This version is automatically generated from eEvaluation.xml on 2025-10-10" ;
    rdfs:seeAlso <https://docs.ted.europa.eu/home/index.html>,
        <https://github.com/OP-TED/ePO/releases>,
        <https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology/about>,
        <https://op.europa.eu/en/web/eu-vocabularies/e-procurement> ;
    owl:imports epo-shape:acc-shape,
        epo-shape:awa-shape,
        epo-shape:cat-shape,
        epo-shape:con-shape,
        epo-shape:core-shape,
        epo-shape:ful-shape,
        epo-shape:inv-shape,
        epo-shape:not-shape,
        epo-shape:ord-shape,
        epo-shape:pay-shape,
        epo-shape:qua-shape,
        epo-shape:req-shape,
        epo-shape:sub-shape ;
    owl:incompatibleWith "4.2.0" ;
    owl:priorVersion "http://data.europa.eu/a4g/data-shape#eva-shape-5.1.0" ;
    owl:versionIRI epo-shape:eva-shape-5.2.0 ;
    owl:versionInfo "5.2.0" .

