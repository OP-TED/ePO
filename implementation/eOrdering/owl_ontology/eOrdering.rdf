    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#Invoicee">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">Invoicee</skos:prefLabel>
    <skos:definition xml:lang="en">The Role of an Agent who receives and processes the Invoices.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <skos:historyNote xml:lang="en">WG Approval 03/04/2025</skos:historyNote>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AcquiringParty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#refersToProject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">refers To Project</skos:prefLabel>
    <skos:definition xml:lang="en">Reference to a Project.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasRequestedShippingPriority">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel xml:lang="en">has Requested Shipping Priority</skos:prefLabel>
    <skos:definition xml:lang="en">The level of importance or sequence assigned to the delivery. (epo-ord:DeliveryAgreement)</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <skos:historyNote xml:lang="en">WG approval 25/09/2026</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#concernsOriginatorRequest">
