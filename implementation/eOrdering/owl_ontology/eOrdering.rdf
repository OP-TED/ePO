<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
   xmlns:vann="http://purl.org/vocab/vann/"
>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#ContractInformation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#InformationHub"/>
    <skos:prefLabel xml:lang="en">Contract Information</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <skos:historyNote xml:lang="en">WG Approval 20/04/2023</skos:historyNote>
    <skos:definition xml:lang="en">Information about the Contract.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#Consignee">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AcquiringParty"/>
    <skos:prefLabel xml:lang="en">Consignee</skos:prefLabel>
    <skos:definition xml:lang="en">A Role of an Agent that receives the Shipment of the Procurement (service, goods or works) and who is taking possession. Additional information: The Role is carried out by the Customer or on behalf of the Customer. The possession of the goods does not necessary imply ownership. The Consignee may be the end-user or the beneficiary. (Consignee) Definition from PEPPOL Despatch: The Consignee is the person or Organisation to which the products will be shipped and who is taking possession. The Role is carried out by the Customer or on behalf of the Customer.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 21/02/2023</skos:historyNote>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasPriceDiscountInformation">
    <skos:prefLabel xml:lang="en">has Price Discount Information</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Relation indicating the Allowance Information applied on the Price.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasRequestedShippingPriority">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:definition xml:lang="en">The level of importance or sequence assigned to the delivery. (epo-ord:DeliveryAgreement)</skos:definition>
    <skos:prefLabel xml:lang="en">has Requested Shipping Priority</skos:prefLabel>
    <skos:historyNote xml:lang="en">WG approval 25/09/2026</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#OrderCancellationConfirmation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A Document providing information on the acknowledgment of the Order Cancellation.</skos:definition>
    <skos:prefLabel xml:lang="en">Order Cancellation Confirmation</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <skos:historyNote xml:lang="en">WG approval 16/09/2025</skos:historyNote>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#PostAwardDocument"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasTaxCategory">
    <skos:definition xml:lang="en">Relation indicating the Tax Category.</skos:definition>
    <skos:prefLabel xml:lang="en">has Tax Category</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasShippingMark">
    <skos:historyNote xml:lang="en">WG Approval 05/06/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Shipping Mark</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <skos:definition xml:lang="en">A text that the buyer requests to be printed on the packing labels. (epo-ord:DeliveryInformation)</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasVATExemptionReasonDescription">
    <skos:definition xml:lang="en">Explanatory text about the VAT Exemption Reason. (epo-ord:AllowanceChargeInformation)</skos:definition>
    <skos:prefLabel xml:lang="en">has VAT Exemption Reason Description</skos:prefLabel>
    <skos:historyNote xml:lang="en">WG approval 25/09/2026</skos:historyNote>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasPrepaidAmount">
    <skos:prefLabel xml:lang="en">has Prepaid Amount</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Relation indicating the Monetary Value that is paid in advance.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasAmountDueForPayment">
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">has Amount Due For Payment</skos:prefLabel>
    <skos:definition xml:lang="en">Relation indicating the Monetary Value that has to be paid.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasRequestedDeliveryPeriod">
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">has Requested Delivery Period</skos:prefLabel>
    <skos:definition xml:lang="en">Relation indicating the sought time range for the delivery.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasTrackingID">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <skos:definition xml:lang="en">Relation indicating that thedelivery has an identifier for traceability purposes.</skos:definition>
    <skos:prefLabel xml:lang="en">has Tracking ID</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Relation indicating the status.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <skos:prefLabel xml:lang="en">has Status</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#isPartialDeliveryAllowed">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:definition xml:lang="en">An indicator to state if partial delivery is allowed or not. (epo-ord:DeliveryAgreement)</skos:definition>
    <skos:prefLabel xml:lang="en">is Partial Delivery Allowed</skos:prefLabel>
    <skos:historyNote xml:lang="en">WG Approval 03/04/2025</skos:historyNote>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#isCalculatedOn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">The monetary amount to which the multiplier factor is applied in calculating the amount of this allowance, charge or tax.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <skos:prefLabel xml:lang="en">is Calculated On</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#specifiesDeliveryInformation">
    <skos:definition xml:lang="en">Relation indicating the Delivery Information.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">specifies Delivery Information</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#ord">
    <vann:preferredNamespaceUri>http://data.europa.eu/a4g/ontology#</vann:preferredNamespaceUri>
    <owl:imports rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <owl:imports rdf:resource="http://www.w3.org/ns/org#"/>
    <owl:imports rdf:resource="http://data.europa.eu/m8g/"/>
    <owl:imports rdf:resource="http://www.w3.org/ns/person"/>
    <owl:imports rdf:resource="http://www.w3.org/ns/locn"/>
    <owl:imports rdf:resource="http://data.europa.eu/a4g/ontology#cat"/>
    <owl:imports rdf:resource="http://data.europa.eu/eli/ontology#"/>
    <owl:imports rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <owl:imports rdf:resource="http://www.w3.org/2006/time"/>
    <owl:imports rdf:resource="http://purl.org/dc/terms/"/>
    <owl:imports rdf:resource="http://www.w3.org/2004/02/skos/core#"/>
    <owl:imports rdf:resource="http://www.w3.org/ns/adms"/>
    <owl:priorVersion>http://data.europa.eu/a4g/ontology#ord-5.1.0</owl:priorVersion>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-10-10</dcterms:issued>
    <dcterms:description xml:lang="en">The eProcurement Ontology Ordering core describes the concepts and properties representing the European Public Procurement Ordering domain. The provision of these semantics offers the basis for a common understanding of the domain for all stakeholders ensuring the quality of data exchange and transparency. The ontology restrictions are published in a separate artefact.</dcterms:description>
    <rdfs:seeAlso rdf:resource="https://docs.ted.europa.eu/home/index.html"/>
    <rdfs:seeAlso rdf:resource="https://op.europa.eu/en/web/eu-vocabularies/e-procurement"/>
    <rdfs:seeAlso rdf:resource="https://github.com/OP-TED/ePO/releases"/>
    <rdfs:seeAlso rdf:resource="https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology/about"/>
    <vann:preferredNamespacePrefix>epo</vann:preferredNamespacePrefix>
    <rdfs:label xml:lang="en">eProcurement Ontology Ordering - core</rdfs:label>
    <dcterms:license>© European Union, 2014. Unless otherwise noted, the reuse of the Ontology is authorised under the European Union Public Licence v1.2 (https://eupl.eu/).</dcterms:license>
    <owl:versionIRI rdf:resource="http://data.europa.eu/a4g/ontology#ord-5.2.0"/>
    <owl:versionInfo>5.2.0</owl:versionInfo>
    <dcterms:publisher>http://publications.europa.eu/resource/authority/corporate-body/PUBL</dcterms:publisher>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-06-01</dcterms:created>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:title xml:lang="en">eProcurement Ontology Ordering - core</dcterms:title>
    <owl:incompatibleWith>4.2.0</owl:incompatibleWith>
    <rdfs:comment>This version is automatically generated from eOrdering.xml on 2025-10-10</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#specifiesOriginator">
    <skos:definition xml:lang="en">Relation indicating that the instance of the concept involves the Originator.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <skos:prefLabel xml:lang="en">specifies Originator</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:historyNote xml:lang="en">WG Approval 25/06/2024</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#DeliveryInformation">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <skos:historyNote xml:lang="en">WG Approval 16/05/2023</skos:historyNote>
    <skos:prefLabel xml:lang="en">Delivery Information</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">Information about the timing, the delivery destination, the delivery agreement and the involved parties.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#InformationHub"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#specifiesDeliveryAgreementLocation">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:definition xml:lang="en">Relation indicating the Location from the Delivery Agreement.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">specifies Delivery Agreement Location</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#concernsConsignee">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Relates to Consignee.</skos:definition>
    <skos:prefLabel xml:lang="en">concerns Consignee</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasBackorderQuantity">
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">has Backorder Quantity</skos:prefLabel>
    <skos:definition xml:lang="en">Relation indicating the number of Items that cannot be fulfilled immediately.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#specifiesOrderResponseInformation">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:definition xml:lang="en">Relation indicating the Order Response Information.</skos:definition>
    <skos:prefLabel xml:lang="en">specifies Order Response Information</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasAmount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:historyNote xml:lang="en">WG Approval 26/07/2022</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Amount</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <skos:definition xml:lang="en">The predetermined monetary value charged in addition to the price.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#specifiesInvoicee">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <skos:prefLabel xml:lang="en">specifies Invoicee</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:definition xml:lang="en">Relation indicating that the instance of the concept involves the Invoicee.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasAllowanceChargeReasonDescription">
    <skos:prefLabel xml:lang="en">has Allowance Charge Reason Description</skos:prefLabel>
    <skos:historyNote xml:lang="en">WG approval 25/09/2026</skos:historyNote>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <skos:definition xml:lang="en">Explanatory text about the motive of the Allowance Charge. (epo-ord:AllowanceChargeInformation)</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#OrderCancellationRejection">
    <skos:definition xml:lang="en">A Document providing information on the non-acceptance of the Order Cancellation.</skos:definition>
    <skos:prefLabel xml:lang="en">Order Cancellation Rejection</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <skos:historyNote xml:lang="en">WG approval 16/09/2025</skos:historyNote>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#PostAwardDocument"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#specifiesOriginatorInformation">
    <skos:definition xml:lang="en">Relation indicating the Originator Information.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">specifies Originator Information</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#specifiesBuyer">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <skos:prefLabel xml:lang="en">specifies Buyer</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:definition xml:lang="en">Relation indicating that the instance of the concept involves the Buyer.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#comprisesOrderAgreementLine">
    <skos:prefLabel xml:lang="en">comprises Order Agreement Line</skos:prefLabel>
    <skos:definition xml:lang="en">Incorporates Order Agreement Line.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#OrderChange">
    <skos:prefLabel xml:lang="en">Order Change</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:historyNote xml:lang="en">WG approval 16/09/2025</skos:historyNote>
    <skos:definition xml:lang="en">A Document providing information on the formal request from the Buyer to the Seller specifying the requested change in goods, services or works to be delivered in respect to a previous Order.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Order"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasTotalTaxExclusiveAmount">
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Relation indicating the overall Monetary Value without Tax.</skos:definition>
    <skos:prefLabel xml:lang="en">has Total Tax Exclusive Amount</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasQuantity">
    <skos:definition xml:lang="en">Relation indicating that the instance of the concept has a Quantity.</skos:definition>
    <skos:prefLabel xml:lang="en">has Quantity</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasResponseDescription">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <skos:definition xml:lang="en">Explanation of the response. (epo-ord:OrderResponse)</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:historyNote xml:lang="en">WG Approval 25/03/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Response Description</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasAcceptanceStatus">
    <skos:prefLabel xml:lang="en">has Acceptance Status</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <skos:definition xml:lang="en">Relation indicating the acceptance status.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasAllowanceChargeReason">
    <skos:prefLabel xml:lang="en">has Allowance Charge Reason</skos:prefLabel>
    <skos:definition xml:lang="en">The justification for using the Allowance or the Charge.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasPrice">
    <skos:prefLabel xml:lang="en">has Price</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:definition xml:lang="en">Relation indicating that the instance of the concept has a Price.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#isSpecificToInvoiceLine">
    <skos:prefLabel xml:lang="en">is Specific To Invoice Line</skos:prefLabel>
    <skos:definition xml:lang="en">Information that is particular to an Invoice Line.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#concernsOriginator">
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:definition xml:lang="en">Relates to Originator.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">concerns Originator</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasAccountingCost">
    <skos:historyNote xml:lang="en">WG Approval 26/01/2023</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Accounting Cost</skos:prefLabel>
    <skos:definition xml:lang="en">The accounting reference used by the Buyer to specify the account to which the order and the corresponding invoice are booked. (epo-ord:Order) The accounting reference used by the Buyer to specify the account to which the order and the corresponding invoice are booked. (epo-ord:OrderLine)</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#OrderCancellation">
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#PostAwardDocument"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">Order Cancellation</skos:prefLabel>
    <skos:definition xml:lang="en">A Document providing information on the formal response from the Buyer to the Seller to cancel a previous Order or Order Change.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <skos:historyNote xml:lang="en">WG approval 16/09/2025</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#Originator">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <skos:historyNote xml:lang="en">WG Approval 20/10/2022</skos:historyNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A Role of an Agent that expresses the needs to trigger the Procurement. Additional Information: The Originator is often the end-user or the Beneficiary.</skos:definition>
    <skos:prefLabel xml:lang="en">Originator</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AcquiringParty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#specifiesChargeInformation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">specifies Charge Information</skos:prefLabel>
    <skos:definition xml:lang="en">Relation indicating the Charge Information.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasTaxInformation">
    <skos:definition xml:lang="en">Relation indicating the Tax Information.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Tax Information</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#OrderChangeLine">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <skos:historyNote xml:lang="en">WG approval 16/09/2025</skos:historyNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">Details concerning a given unit of goods, services or works requested in the Order Change.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#OrderLine"/>
    <skos:prefLabel xml:lang="en">Order Change Line</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#specifiesContractInformation">
    <skos:definition xml:lang="en">Relation indicating the Contract Information.</skos:definition>
    <skos:prefLabel xml:lang="en">specifies Contract Information</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#Seller">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <skos:historyNote xml:lang="en">WG Approval 08/09/2022</skos:historyNote>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#OfferingParty"/>
    <skos:definition xml:lang="en">A Role of an Agent who transfers the ownership of the Procurement results (goods, services or works) to the Buyer. Additional information: A Role of an Agent that sells a Procurement Result (goods, services or work) to a Buyer. The Seller is bound by a Contract i.e. it has legal responsibility. The Seller may or may not be the same as the Supplier. The Seller may or may not issue the Invoice. The Seller may or may not be the owner of the credit owed by the Buyer.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">Seller</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasGeneralDeliveryTerm">
    <skos:prefLabel xml:lang="en">has General Delivery Term</skos:prefLabel>
    <skos:historyNote xml:lang="en">WG approval 25/09/2026</skos:historyNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <skos:definition xml:lang="en">Terms and conditions related to the delivery of goods. (epo-ord:DeliveryAgreement)</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#DeliveryAgreement">
    <skos:definition xml:lang="en">Term applying to the delivery of goods, services and works. Additional Information: Delivery terms identifier can normally be Incoterms accompanied by the description of specific conditions related to the delivery.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <skos:historyNote xml:lang="en">WG Approval 16/05/2023</skos:historyNote>
    <skos:prefLabel xml:lang="en">Delivery Agreement</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#refersToOrder">
    <skos:definition xml:lang="en">Reference to an Order.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">refers To Order</skos:prefLabel>
    <skos:historyNote xml:lang="en">WG Approval 25/06/2024</skos:historyNote>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#refersToCatalogue">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <skos:prefLabel xml:lang="en">refers To Catalogue</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Additional information: If an order refers to multiple catalogues then all these catalogues ideally are subordinated to the same contract. Some countries however may allow multiple contracts per order (i.e Italy).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#isSubmittedForOrderLine">
    <skos:prefLabel xml:lang="en">is Submitted For Order Line</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:definition xml:lang="en">Relation indicating that the instance of the concept is sent for a specific Order Line.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#OrderChangeRejection">
    <skos:prefLabel xml:lang="en">Order Change Rejection</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <skos:historyNote xml:lang="en">WG approval 16/09/2025</skos:historyNote>
    <skos:definition xml:lang="en">A Document providing information on the non-acceptance of the Order Change.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#PostAwardDocument"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasRoundingAmount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Rounding Amount</skos:prefLabel>
    <skos:definition xml:lang="en">Relation indicating the adjustment Monetary Value applied to bring calculated total to a convenient value.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#OrderResponse">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <skos:historyNote xml:lang="en">WG Approval 20/04/2023</skos:historyNote>
    <skos:prefLabel xml:lang="en">Order Response</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A formal reply from the Seller to the Buyer stating the Seller's ability to fulfil the order. Additional Information: The Order Response is used to inform on the acceptance or rejection of an Order or to make a counter-offer.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Order"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#AllowanceChargeInformation">
    <skos:definition xml:lang="en">Information about discounts, taxes, duties and fees imposed.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#InformationHub"/>
    <skos:historyNote xml:lang="en">WG Approval 16/05/2023</skos:historyNote>
    <skos:prefLabel xml:lang="en">Allowance Charge Information</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#specifiesSeller">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Relation indicating that the instance of the concept involves the Seller.</skos:definition>
    <skos:prefLabel xml:lang="en">specifies Seller</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasDownloadURL">
    <skos:definition xml:lang="en">Location where the resource can be downloaded. (epo-ord:DeliveryInformation)</skos:definition>
    <skos:prefLabel xml:lang="en">has Download URL</skos:prefLabel>
    <skos:historyNote xml:lang="en">WG Approval 08/04/2025</skos:historyNote>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#OrderAgreementLine">
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#OrderLine"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">Order Agreement Line</skos:prefLabel>
    <skos:definition xml:lang="en">Details concerning a given unit of goods, services or works mentioned in the Order Agreement.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <skos:historyNote xml:lang="en">WG approval 16/09/2025</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasTotalAllowanceAmount">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <skos:prefLabel xml:lang="en">has Total Allowance Amount</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:definition xml:lang="en">Relation indicating the overall Monetary Value of the Allowance.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#specifiesAllowanceInformation">
    <skos:prefLabel xml:lang="en">specifies Allowance Information</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:definition xml:lang="en">Relation indicating the Allowance Information.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#refersToDeliveryInformation">
    <skos:prefLabel xml:lang="en">refers To Delivery Information</skos:prefLabel>
    <skos:definition xml:lang="en">Reference to a Delivery Information.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 25/06/2024</skos:historyNote>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasSellerOrderID">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">has Seller Order ID</skos:prefLabel>
    <skos:definition xml:lang="en">The identifier of the Order given by the Seller. Additional Information: This identifier is different than the identifier of the Order given by the Buyer and it is useful for internal purposes.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 12/10/2023</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#specifiesDespatcher">
    <skos:prefLabel xml:lang="en">specifies Despatcher</skos:prefLabel>
    <skos:historyNote xml:lang="en">WG Approval 25/06/2024</skos:historyNote>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Relation indicating that the instance of the concept involves the Despatcher.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#isSpecificToOrderResponseLine">
    <skos:prefLabel xml:lang="en">is Specific To Order Response Line</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:definition xml:lang="en">Information that is particular to an Order Response Line.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasTotalTaxInclusiveAmount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">has Total Tax Inclusive Amount</skos:prefLabel>
    <skos:definition xml:lang="en">Relation indicating the overall Monetary Value with Tax.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#respondsToOrderCancellation">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <skos:prefLabel xml:lang="en">responds To Order Cancellation</skos:prefLabel>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Takes action in reaction to an Order Cancellation.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#OrderAgreement">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:historyNote xml:lang="en">WG approval 16/09/2025</skos:historyNote>
    <skos:definition xml:lang="en">A Document sent from the Seller to Buyer specifying the goods, services or works to be delivered concerning a specific Order.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Order"/>
    <skos:prefLabel xml:lang="en">Order Agreement</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasActualDeliveryDate">
    <skos:historyNote xml:lang="en">WG approval 25/09/2026</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Actual Delivery Date</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <skos:definition xml:lang="en">The date when the Delivery occured. (epo-ord:DeliveryInformation)</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasPercentage">
    <skos:historyNote xml:lang="en">WG Approval 26/07/2022</skos:historyNote>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel xml:lang="en">has Percentage</skos:prefLabel>
    <skos:definition xml:lang="en">The factor relative to the price charged in addition. (epo-ord:AllowanceChargeInformation) The factor relative to the price charged in addition. (epo-ord:TaxInformation)</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#Order">
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#PostAwardDocument"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A formal request of the Buyer to the Seller specifying the goods, services or works to be delivered. Additional Information: A Buyer submits an Order for delivery of goods, services or works to a Seller.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 23/04/2023</skos:historyNote>
    <skos:prefLabel xml:lang="en">Order</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#specifiesConsignee">
    <skos:historyNote xml:lang="en">WG Approval 25/06/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">specifies Consignee</skos:prefLabel>
    <skos:definition xml:lang="en">Relation indicating that the instance of the concept involves the Consignee.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#concernsContract">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">concerns Contract</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Relates to Contractor.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#TaxInformation">
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#InformationHub"/>
