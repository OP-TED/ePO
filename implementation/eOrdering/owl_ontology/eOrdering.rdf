    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasDeliveryEmail">
    <skos:prefLabel xml:lang="en">has Delivery Email</skos:prefLabel>
    <skos:definition xml:lang="en">The electronic address to which the products or services are to be delivered. (epo-ord:DeliveryInformation)</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 03/04/2025</skos:historyNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#OriginatorInformation">
