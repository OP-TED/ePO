    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">Invoicee</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#comprisesOrderResponseLine">
    <skos:definition xml:lang="en">Incorporates Order Response Line.</skos:definition>
    <skos:prefLabel xml:lang="en">comprises Order Response Line</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#isSpecificToOrderLine">
