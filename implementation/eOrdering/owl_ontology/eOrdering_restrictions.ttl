@prefix : <http://data.europa.eu/a4g/ontology#> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix cccev: <http://data.europa.eu/m8g/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eli: <http://data.europa.eu/eli/ontology#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:comprisesOrderAgreementLine rdfs:domain :OrderAgreement ;
    rdfs:range :OrderAgreementLine .

:comprisesOrderChangeLine rdfs:domain :OrderChange ;
    rdfs:range :OrderChangeLine .

:comprisesOrderLine rdfs:domain :Order ;
    rdfs:range :OrderLine .

:comprisesOrderResponseLine rdfs:domain :OrderResponse ;
    rdfs:range :OrderResponseLine .

:hasAcceptanceStatus rdfs:domain [ a owl:Class ;
            owl:unionOf ( :ReceiptAdviceInformation :AbstractContainer ) ] ;
    rdfs:range skos:Concept .

:hasAccessURL rdfs:domain :DeliveryInformation ;
    rdfs:range xsd:anyURI .

:hasAllowanceChargeReason rdfs:domain :AllowanceChargeInformation ;
    rdfs:range skos:Concept .

:hasAllowanceChargeReasonDescription rdfs:domain :AllowanceChargeInformation ;
    rdfs:range rdf:PlainLiteral .

:hasDownloadURL rdfs:domain :DeliveryInformation ;
    rdfs:range xsd:anyURI .

:hasPrice rdfs:domain :OrderLine ;
    rdfs:range :Price .

:hasResponseStatus rdfs:domain :CatalogueResponseInformation ;
    rdfs:range skos:Concept .

:hasShippingMark rdfs:domain :DeliveryInformation ;
    rdfs:range rdf:PlainLiteral .

:hasStatus rdfs:domain [ a owl:Class ;
            owl:unionOf ( :OrderResponseInformation :OrderChangeLine ) ] ;
    rdfs:range skos:Concept .

:hasTaxCategory rdfs:domain :TaxInformation ;
    rdfs:range skos:Concept .

:hasTaxScheme rdfs:domain :TaxInformation ;
    rdfs:range skos:Concept .

:isSpecificToInvoiceLine rdfs:domain :AllowanceInformation ;
    rdfs:range :InvoiceLine .

:isSpecificToOrderLine rdfs:domain [ a owl:Class ;
            owl:unionOf ( :AllowanceInformation :ContractInformation :DeliveryInformation :ChargeInformation :OriginatorInformation ) ] ;
    rdfs:range :OrderLine .

:isSpecificToOrderResponseLine rdfs:domain :OrderResponseInformation ;
    rdfs:range :OrderResponseLine .

:isSpecificToRequestForOfferLine rdfs:domain :DeliveryInformation ;
    rdfs:range :RequestForOfferLine .

:ord-restriction a owl:Ontology ;
    rdfs:label "eProcurement Ontology Ordering - core restrictions"@en ;
    dcterms:created "2021-06-01"^^xsd:date ;
    dcterms:description "The eProcurement Ontology Ordering core restrictions provides the restrictions and the inference-related specifications on the concepts and properties in the eProcurement Ontology Ordering core."@en ;
    dcterms:issued "2025-06-04"^^xsd:date ;
    dcterms:license "© European Union, 2014. Unless otherwise noted, the reuse of the Ontology is authorised under the European Union Public Licence v1.2 (https://eupl.eu/)." ;
    dcterms:publisher "http://publications.europa.eu/resource/authority/corporate-body/PUBL" ;
    dcterms:title "eProcurement Ontology Ordering - core restrictions"@en ;
    vann:preferredNamespacePrefix "epo" ;
    vann:preferredNamespaceUri "http://data.europa.eu/a4g/ontology#" ;
    rdfs:comment """This version is automatically generated from eOrdering.xml on 
                2025-06-04""" ;
    rdfs:seeAlso <https://docs.ted.europa.eu/home/index.html>,
        <https://github.com/OP-TED/ePO/releases>,
        <https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology/about>,
        <https://op.europa.eu/en/web/eu-vocabularies/e-procurement> ;
    owl:imports :cat,
        :core,
        :ful,
        :ord,
        eli:,
        cccev:,
        dcterms:,
        skos:,
        <http://www.w3.org/2006/time>,
        <http://www.w3.org/ns/adms>,
        <http://www.w3.org/ns/locn>,
        org:,
        <http://www.w3.org/ns/person> ;
    owl:incompatibleWith "4.2.0" ;
    owl:priorVersion "http://data.europa.eu/a4g/ontology#ord-restriction-5.0.0" ;
    owl:versionIRI :ord-restriction-5.1.0 ;
    owl:versionInfo "5.1.0" .

:refersToCatalogue rdfs:domain :Order ;
    rdfs:range :PostAwardCatalogue .

:specifiesAllowanceInformation rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Invoice :Order ) ] ;
    rdfs:range :AllowanceInformation .

:specifiesChargeInformation rdfs:domain :Order ;
    rdfs:range :ChargeInformation .

:specifiesContractInformation rdfs:domain :Order ;
    rdfs:range :ContractInformation .

:specifiesOrderResponseInformation rdfs:domain :OrderResponse ;
    rdfs:range :OrderResponseInformation .

:DespatchLine rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :refersToOrderLine ] .

:RemittanceAdvice rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :specifiesSeller ] .

:ShipmentAgreement rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty :agreedBySeller ] .

:ShipmentInformation rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :refersToDeliveryInformation ] .

:TaxBreakdownInformation rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :hasTaxInformation ] .

:agreedBySeller rdfs:domain :ShipmentAgreement ;
    rdfs:range :Seller .

:concernsConsignee rdfs:domain :DeliveryInformation ;
    rdfs:range :Consignee .

:concernsContract a owl:FunctionalProperty ;
    rdfs:domain :ContractInformation ;
    rdfs:range :Contract .

:concernsOriginator a owl:FunctionalProperty ;
    rdfs:domain :OriginatorInformation ;
    rdfs:range :Originator .

:concernsOriginatorRequest rdfs:domain :OriginatorInformation ;
    rdfs:range :OriginatorRequest .

:hasActualDeliveryDate rdfs:domain :DeliveryInformation ;
    rdfs:range xsd:dateTime .

:hasAmountDueForPayment a owl:FunctionalProperty ;
    rdfs:domain :Order ;
    rdfs:range :MonetaryValue .

:hasBackorderQuantity rdfs:domain :OrderResponseLine ;
    rdfs:range :Quantity .

:hasDeliveryDeadline rdfs:domain :DeliveryInformation ;
    rdfs:range xsd:dateTime .

:hasDeliveryEmail rdfs:domain :DeliveryInformation ;
    rdfs:range rdf:PlainLiteral .

:hasDeliveryPeriod rdfs:domain :DeliveryInformation ;
    rdfs:range time:Interval .

:hasGeneralDeliveryTerm rdfs:domain :DeliveryAgreement ;
    rdfs:range rdf:PlainLiteral .

:hasPaymentTerm rdfs:domain :Order ;
    rdfs:range rdf:PlainLiteral .

:hasPrepaidAmount rdfs:domain :Order ;
    rdfs:range :MonetaryValue .

:hasPriceDiscountInformation rdfs:domain :Price ;
    rdfs:range :AllowanceInformation .

:hasQuantity a owl:FunctionalProperty ;
    rdfs:domain :OrderLine ;
    rdfs:range :Quantity .

:hasRequestedDeliveryPeriod rdfs:domain :DeliveryInformation ;
    rdfs:range time:Interval .

:hasRequestedShippingPriority rdfs:domain :DeliveryAgreement ;
    rdfs:range rdf:PlainLiteral .

:hasResponseDescription rdfs:domain :OrderResponse ;
    rdfs:range rdf:PlainLiteral .

:hasRoundingAmount rdfs:domain :Order ;
    rdfs:range :MonetaryValue .

:hasSellerOrderID rdfs:domain :Order ;
    rdfs:range adms:Identifier .

:hasTotalAllowanceAmount rdfs:domain :Order ;
    rdfs:range :MonetaryValue .

:hasTotalChargeAmount rdfs:domain :Order ;
    rdfs:range :MonetaryValue .

:hasTotalLineAmount a owl:FunctionalProperty ;
    rdfs:domain :Order ;
    rdfs:range :MonetaryValue .

:hasTotalTaxExclusiveAmount rdfs:domain :Order ;
    rdfs:range :MonetaryValue .

:hasTotalTaxInclusiveAmount rdfs:domain :Order ;
    rdfs:range :MonetaryValue .

:hasTrackingID rdfs:domain :DeliveryInformation ;
    rdfs:range adms:Identifier .

:hasVATExemptionReason rdfs:domain :AllowanceChargeInformation ;
    rdfs:range rdf:PlainLiteral .

:hasVATExemptionReasonDescription rdfs:domain :AllowanceChargeInformation ;
    rdfs:range rdf:PlainLiteral .

:hasValidityPeriod rdfs:domain :Order ;
    rdfs:range time:Interval .

:isPartialDeliveryAllowed rdfs:domain :DeliveryAgreement ;
    rdfs:range xsd:boolean .

:refersToCatalogueLine rdfs:domain :OrderLine ;
    rdfs:range :CatalogueLine .

:refersToDeliveryInformation a owl:FunctionalProperty ;
    rdfs:domain :ShipmentInformation ;
    rdfs:range :DeliveryInformation .

:refersToProject rdfs:domain :Order ;
    rdfs:range :Project .

:specifiesDeliveryAgreement rdfs:domain :DeliveryInformation ;
    rdfs:range :DeliveryAgreement .

:specifiesDeliveryAgreementLocation rdfs:domain :DeliveryAgreement ;
    rdfs:range dcterms:Location .

:specifiesDeliveryInformation rdfs:domain [ a owl:Class ;
            owl:unionOf ( :RequestForOffer :Invoice :Order ) ] ;
    rdfs:range :DeliveryInformation .

:specifiesDespatcher rdfs:domain :Order ;
    rdfs:range :Despatcher .

:specifiesInvoicee rdfs:domain :Order ;
    rdfs:range :Invoicee .

:specifiesOriginator rdfs:domain [ a owl:Class ;
            owl:unionOf ( :DespatchAdvice :RequestForOffer ) ] ;
    rdfs:range :Originator .

:specifiesOriginatorInformation rdfs:domain :Order ;
    rdfs:range :OriginatorInformation .

:specifiesPlaceOfDelivery rdfs:domain :DeliveryInformation ;
    rdfs:range dcterms:Location .

:Contract rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasTaxInformation ] .

:Price rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasPriceDiscountInformation ] .

:ReceiptAdvice rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty :specifiesConsignee ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :specifiesSeller ] .

:RequestForOffer rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :specifiesOriginator ] .

:hasAccountingCost rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Order :OrderLine ) ] ;
    rdfs:range rdf:PlainLiteral .

:hasAmount rdfs:domain [ a owl:Class ;
            owl:unionOf ( :AllowanceChargeInformation :TaxInformation ) ] ;
    rdfs:range :MonetaryValue .

:hasPercentage rdfs:domain [ a owl:Class ;
            owl:unionOf ( :AllowanceChargeInformation :TaxInformation ) ] ;
    rdfs:range xsd:decimal .

:isCalculatedOn rdfs:domain [ a owl:Class ;
            owl:unionOf ( :AllowanceChargeInformation :TaxInformation ) ] ;
    rdfs:range :MonetaryValue .

:isSubmittedForOrderLine a owl:FunctionalProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :OrderChangeLine :OrderResponseLine ) ] ;
    rdfs:range :OrderLine .

:refersToOrder rdfs:domain [ a owl:Class ;
            owl:unionOf ( :DespatchAdvice :Invoice ) ] ;
    rdfs:range :Order .

:refersToOrderLine a owl:FunctionalProperty ;
    rdfs:domain :DespatchLine,
        :InvoiceLine ;
    rdfs:range :OrderLine .

:respondsToOrderCancellation rdfs:domain [ a owl:Class ;
            owl:unionOf ( :OrderCancellationConfirmation :OrderCancellationRejection ) ] ;
    rdfs:range :OrderCancellation .

:respondsToOrderChange a owl:FunctionalProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :OrderChangeRejection :OrderChangeConfirmation ) ] ;
    rdfs:range :OrderChange .

:specifiesConsignee rdfs:domain [ a owl:Class ;
            owl:unionOf ( :DespatchAdvice :ReceiptAdvice ) ] ;
    rdfs:range :Consignee .

:DespatchAdvice rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :refersToOrder ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty :specifiesConsignee ] .

:InvoiceLine rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :refersToOrderLine ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :hasTaxInformation ] .

:isSubmittedForOrder a owl:FunctionalProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :OrderCancellation :OrderChange :OrderResponse ) ] ;
    rdfs:range :Order .

:ContractInformation rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :concernsContract ] .

:OrderCancellationConfirmation rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :specifiesSeller ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :specifiesBuyer ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :respondsToOrderCancellation ] .

:OrderCancellationRejection rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :specifiesBuyer ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :respondsToOrderCancellation ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :specifiesSeller ] .

:OrderChange rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :isSubmittedForOrder ] .

:OrderChangeConfirmation rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :respondsToOrderChange ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :specifiesSeller ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :specifiesBuyer ] .

:OrderChangeLine rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :isSubmittedForOrderLine ] .

:OrderChangeRejection rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :respondsToOrderChange ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :specifiesSeller ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :specifiesBuyer ] .

:DeliveryAgreement rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :isPartialDeliveryAllowed ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :specifiesDeliveryAgreementLocation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasRequestedShippingPriority ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasGeneralDeliveryTerm ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dcterms:description ] .

:Invoice rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :hasTaxInformation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :refersToOrder ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :specifiesDeliveryInformation ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :specifiesSeller ] .

:OrderCancellation rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :specifiesBuyer ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :isSubmittedForOrder ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :specifiesSeller ] .

:OrderResponse rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :isSubmittedForOrder ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasResponseDescription ] .

:OrderResponseLine rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasBackorderQuantity ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :isSubmittedForOrderLine ] .

:OriginatorInformation rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :concernsOriginatorRequest ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :concernsOriginator ] .

:hasTaxInformation a owl:FunctionalProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :AllowanceChargeInformation :AbstractItem :InvoiceLine :TaxBreakdownInformation :Invoice :Contract ) ] ;
    rdfs:range :TaxInformation .

:specifiesBuyer a owl:FunctionalProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Order :OrderChangeConfirmation :OrderChangeRejection :OrderCancellation :OrderCancellationConfirmation :OrderCancellationRejection ) ] ;
    rdfs:range :Buyer .

:TaxInformation a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasPercentage ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dcterms:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :isCalculatedOn ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasAmount ] .

:OrderLine a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :hasQuantity ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasAccountingCost ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :refersToCatalogueLine ] .

:AllowanceChargeInformation a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :isCalculatedOn ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasPercentage ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasVATExemptionReason ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasAmount ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasTaxInformation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasVATExemptionReasonDescription ] .

:specifiesSeller a owl:FunctionalProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Order :Catalogue :OrderCancellationConfirmation :OrderCancellationRejection :ReceiptAdvice :OrderCancellation :OrderChangeRejection :Invoice :OrderChangeConfirmation :RemittanceAdvice ) ] ;
    rdfs:range :Seller .

:DeliveryInformation rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasDeliveryDeadline ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasRequestedDeliveryPeriod ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasTrackingID ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasDeliveryEmail ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasActualDeliveryDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :specifiesDeliveryAgreement ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasDeliveryPeriod ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :specifiesPlaceOfDelivery ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :concernsConsignee ] .

:Order a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasTotalChargeAmount ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :hasTotalLineAmount ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :specifiesDespatcher ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :specifiesOriginatorInformation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasTotalTaxInclusiveAmount ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasPaymentTerm ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :specifiesInvoicee ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :specifiesBuyer ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :refersToProject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasTotalAllowanceAmount ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasAccountingCost ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasRoundingAmount ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasSellerOrderID ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :specifiesSeller ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasValidityPeriod ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :hasAmountDueForPayment ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasPrepaidAmount ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasTotalTaxExclusiveAmount ] .

[] a owl:AllDisjointClasses ;
    owl:members ( :Consignee :Invoicee :Originator ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :AllowanceChargeInformation :ContractInformation :DeliveryInformation :OriginatorInformation :TaxInformation :OrderResponseInformation ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :Order :OrderChangeConfirmation :OrderChangeRejection :OrderCancellation :OrderCancellationConfirmation :OrderCancellationRejection ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :OrderAgreementLine :OrderChangeLine :OrderResponseLine ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :OrderChange :OrderAgreement :OrderResponse ) .

