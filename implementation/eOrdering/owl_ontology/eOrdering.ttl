@prefix : <http://data.europa.eu/a4g/ontology#> .
@prefix cccev: <http://data.europa.eu/m8g/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eli: <http://data.europa.eu/eli/ontology#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:AllowanceInformation a owl:Class ;
    rdfs:isDefinedBy :ord ;
    rdfs:subClassOf :AllowanceChargeInformation ;
    skos:definition "Information about the discounts imposed."@en ;
    skos:historyNote "WG Approval 16/05/2023"@en ;
    skos:prefLabel "Allowance Information"@en .

:Consignee a owl:Class ;
    rdfs:isDefinedBy :ord ;
    rdfs:subClassOf :AcquiringParty ;
    skos:definition "A Role of an Agent that receives the Shipment of the Procurement (service, goods or works) and who is taking possession. Additional information: The Role is carried out by the Customer or on behalf of the Customer. The possession of the goods does not necessary imply ownership. The Consignee may be the end-user or the beneficiary. (Consignee) Definition from PEPPOL Despatch: The Consignee is the person or Organisation to which the products will be shipped and who is taking possession. The Role is carried out by the Customer or on behalf of the Customer."@en ;
    skos:historyNote "WG Approval 21/02/2023"@en ;
    skos:prefLabel "Consignee"@en .

:ContractInformation a owl:Class ;
    rdfs:isDefinedBy :ord ;
    rdfs:subClassOf :InformationHub ;
    skos:definition "Information about the Contract."@en ;
    skos:historyNote "WG Approval 20/04/2023"@en ;
    skos:prefLabel "Contract Information"@en .

:DeliveryAgreement a owl:Class ;
    rdfs:isDefinedBy :ord ;
    skos:definition "Term applying to the delivery of goods, services and works. Additional Information: Delivery terms identifier can normally be Incoterms accompanied by the description of specific conditions related to the delivery."@en ;
    skos:historyNote "WG Approval 16/05/2023"@en ;
    skos:prefLabel "Delivery Agreement"@en .

:DeliveryInformation a owl:Class ;
    rdfs:isDefinedBy :ord ;
    rdfs:subClassOf :InformationHub ;
    skos:definition "Information about the timing, the delivery destination, the delivery agreement and the involved parties."@en ;
    skos:historyNote "WG Approval 16/05/2023"@en ;
    skos:prefLabel "Delivery Information"@en .

:Invoicee a owl:Class ;
    rdfs:isDefinedBy :ord ;
    rdfs:subClassOf :AcquiringParty ;
    skos:definition "The Role of an Agent who receives and processes the Invoices."@en ;
    skos:historyNote "WG Approval 03/04/2025"@en ;
    skos:prefLabel "Invoicee"@en .

:OrderAgreement a owl:Class ;
    rdfs:isDefinedBy :ord ;
    rdfs:subClassOf :Order ;
    skos:prefLabel "Order Agreement"@en .

:OrderAgreementLine a owl:Class ;
    rdfs:isDefinedBy :ord ;
    rdfs:subClassOf :OrderLine ;
    skos:prefLabel "Order Agreement Line"@en .

:OrderCancellation a owl:Class ;
    rdfs:isDefinedBy :ord ;
    rdfs:subClassOf :PostAwardDocument ;
    skos:prefLabel "Order Cancellation"@en .

:OrderCancellationConfirmation a owl:Class ;
    rdfs:isDefinedBy :ord ;
    rdfs:subClassOf :PostAwardDocument ;
    skos:prefLabel "Order Cancellation Confirmation"@en .

:OrderCancellationRejection a owl:Class ;
    rdfs:isDefinedBy :ord ;
    rdfs:subClassOf :PostAwardDocument ;
    skos:prefLabel "Order Cancellation Rejection"@en .

:OrderChange a owl:Class ;
    rdfs:isDefinedBy :ord ;
    rdfs:subClassOf :Order ;
    skos:prefLabel "Order Change"@en .

:OrderChangeConfirmation a owl:Class ;
    rdfs:isDefinedBy :ord ;
    rdfs:subClassOf :PostAwardDocument ;
    skos:prefLabel "Order Change Confirmation"@en .

:OrderChangeLine a owl:Class ;
    rdfs:isDefinedBy :ord ;
    rdfs:subClassOf :OrderLine ;
    skos:prefLabel "Order Change Line"@en .

:OrderChangeRejection a owl:Class ;
    rdfs:isDefinedBy :ord ;
    rdfs:subClassOf :PostAwardDocument ;
    skos:prefLabel "Order Change Rejection"@en .

:OrderResponse a owl:Class ;
    rdfs:isDefinedBy :ord ;
    rdfs:subClassOf :Order ;
    skos:definition "A formal reply from the Seller to the Buyer stating the Seller's ability to fulfil the order. Additional Information: The Order Response is used to inform on the acceptance or rejection of an Order or to make a counter-offer."@en ;
    skos:historyNote "WG Approval 20/04/2023"@en ;
    skos:prefLabel "Order Response"@en .

:OrderResponseInformation a owl:Class ;
    rdfs:isDefinedBy :ord ;
    rdfs:subClassOf :InformationHub ;
    skos:prefLabel "Order Response Information"@en .

:OrderResponseLine a owl:Class ;
    rdfs:isDefinedBy :ord ;
    rdfs:subClassOf :OrderLine ;
    skos:definition "Details concerning the Seller's ability to fulfil a given Order Line. Additional Information: The Order Response Line is used to inform on the acceptance or rejection of an Order Line or to make a counter-offer."@en ;
    skos:historyNote "WG Approval 20/04/2023"@en ;
    skos:prefLabel "Order Response Line"@en .

:Originator a owl:Class ;
    rdfs:isDefinedBy :ord ;
    rdfs:subClassOf :AcquiringParty ;
    skos:definition "A Role of an Agent that expresses the needs to trigger the Procurement. Additional Information: The Originator is often the end-user or the Beneficiary."@en ;
    skos:historyNote "WG Approval 20/10/2022"@en ;
    skos:prefLabel "Originator"@en .

:OriginatorInformation a owl:Class ;
    rdfs:isDefinedBy :ord ;
    rdfs:subClassOf :InformationHub ;
    skos:definition "Information about the Originator of the Order."@en ;
    skos:historyNote "WG Approval 20/03/2023"@en ;
    skos:prefLabel "Originator Information"@en .

:Seller a owl:Class ;
    rdfs:isDefinedBy :ord ;
    rdfs:subClassOf :OfferingParty ;
    skos:definition "A Role of an Agent who transfers the ownership of the Procurement results (goods, services or works) to the Buyer. Additional information: A Role of an Agent that sells a Procurement Result (goods, services or work) to a Buyer. The Seller is bound by a Contract i.e. it has legal responsibility. The Seller may or may not be the same as the Supplier. The Seller may or may not issue the Invoice. The Seller may or may not be the owner of the credit owed by the Buyer."@en ;
    skos:historyNote "WG Approval 08/09/2022"@en ;
    skos:prefLabel "Seller"@en .

:TaxInformation a owl:Class ;
    rdfs:isDefinedBy :ord ;
    rdfs:subClassOf :InformationHub ;
    skos:definition "Information about the imposition of mandatory levies required by law."@en ;
    skos:historyNote "WG Approval 25/04/2023"@en ;
    skos:prefLabel "Tax Information"@en .

:agreedBySeller a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:definition "Accepted by Seller."@en ;
    skos:historyNote "WG Approval 10/06/2024"@en ;
    skos:prefLabel "agreed By Seller"@en .

:comprisesOrderAgreementLine a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "comprises Order Agreement Line"@en .

:comprisesOrderChangeLine a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "comprises Order Change Line"@en .

:comprisesOrderLine a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "comprises Order Line"@en .

:comprisesOrderResponseLine a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "comprises Order Response Line"@en .

:concernsConsignee a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "concerns Consignee"@en .

:concernsContract a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "concerns Contract"@en .

:concernsOriginator a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "concerns Originator"@en .

:concernsOriginatorRequest a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "concerns Originator Request"@en .

:hasAcceptanceStatus a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "has Acceptance Status"@en .

:hasAccessURL a owl:DatatypeProperty ;
    rdfs:isDefinedBy :ord ;
    skos:definition "Location where the resource can be accessed. (epo-ord:DeliveryInformation)"@en ;
    skos:historyNote "WG approval 07/04/2022"@en ;
    skos:prefLabel "has Access URL"@en .

:hasAccountingCost a owl:DatatypeProperty ;
    rdfs:isDefinedBy :ord ;
    skos:definition "The accounting reference used by the Buyer to specify the account to which the order and the corresponding invoice are booked. (epo-ord:Order) The accounting reference used by the Buyer to specify the account to which the order and the corresponding invoice are booked. (epo-ord:OrderLine)"@en ;
    skos:historyNote "WG Approval 26/01/2023"@en ;
    skos:prefLabel "has Accounting Cost"@en .

:hasActualDeliveryDate a owl:DatatypeProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "has Actual Delivery Date"@en .

:hasAllowanceChargeReason a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:definition "The justification for using the Allowance or the Charge."@en ;
    skos:prefLabel "has Allowance Charge Reason"@en .

:hasAllowanceChargeReasonDescription a owl:DatatypeProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "has Allowance Charge Reason Description"@en .

:hasAmount a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:definition "The predetermined monetary value charged in addition to the price."@en ;
    skos:historyNote "WG Approval 26/07/2022"@en ;
    skos:prefLabel "has Amount"@en .

:hasAmountDueForPayment a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "has Amount Due For Payment"@en .

:hasBackorderQuantity a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "has Backorder Quantity"@en .

:hasDeliveryDeadline a owl:DatatypeProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "has Delivery Deadline"@en .

:hasDeliveryEmail a owl:DatatypeProperty ;
    rdfs:isDefinedBy :ord ;
    skos:definition "The electronic address to which the products or services are to be delivered. (epo-ord:DeliveryInformation)"@en ;
    skos:historyNote "WG approval 03/04/2025"@en ;
    skos:prefLabel "has Delivery Email"@en .

:hasDeliveryPeriod a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "has Delivery Period"@en .

:hasDownloadURL a owl:DatatypeProperty ;
    rdfs:isDefinedBy :ord ;
    skos:definition "Location where the resource can be downloaded. (epo-ord:DeliveryInformation)"@en ;
    skos:historyNote "WG Approval 08/04/2025"@en ;
    skos:prefLabel "has Download URL"@en .

:hasGeneralDeliveryTerm a owl:DatatypeProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "has General Delivery Term"@en .

:hasPaymentTerm a owl:DatatypeProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "has Payment Term"@en .

:hasPercentage a owl:DatatypeProperty ;
    rdfs:isDefinedBy :ord ;
    skos:definition "The factor relative to the price charged in addition. (epo-ord:AllowanceChargeInformation) The factor relative to the price charged in addition. (epo-ord:TaxInformation)"@en ;
    skos:historyNote "WG Approval 26/07/2022"@en ;
    skos:prefLabel "has Percentage"@en .

:hasPrepaidAmount a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "has Prepaid Amount"@en .

:hasPrice a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "has Price"@en .

:hasPriceDiscountInformation a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "has Price Discount Information"@en .

:hasQuantity a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "has Quantity"@en .

:hasRequestedDeliveryPeriod a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "has Requested Delivery Period"@en .

:hasRequestedShippingPriority a owl:DatatypeProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "has Requested Shipping Priority"@en .

:hasResponseDescription a owl:DatatypeProperty ;
    rdfs:isDefinedBy :ord ;
    skos:definition "Explanation of the response. (epo-ord:OrderResponse)"@en ;
    skos:historyNote "WG Approval 25/03/2025"@en ;
    skos:prefLabel "has Response Description"@en .

:hasResponseStatus a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "has Response Status"@en .

:hasRoundingAmount a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "has Rounding Amount"@en .

:hasSellerOrderID a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:definition "The identifier of the Order given by the Seller. Additional Information: This identifier is different than the identifier of the Order given by the Buyer and it is useful for internal purposes."@en ;
    skos:historyNote "WG Approval 12/10/2023"@en ;
    skos:prefLabel "has Seller Order ID"@en .

:hasShippingMark a owl:DatatypeProperty ;
    rdfs:isDefinedBy :ord ;
    skos:definition "A text that the buyer requests to be printed on the packing labels. (epo-ord:DeliveryInformation)"@en ;
    skos:historyNote "WG Approval 05/06/2024"@en ;
    skos:prefLabel "has Shipping Mark"@en .

:hasStatus a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "has Status"@en .

:hasTaxCategory a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "has Tax Category"@en .

:hasTaxInformation a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "has Tax Information"@en .

:hasTaxScheme a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "has Tax Scheme"@en .

:hasTotalAllowanceAmount a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "has Total Allowance Amount"@en .

:hasTotalChargeAmount a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "has Total Charge Amount"@en .

:hasTotalLineAmount a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "has Total Line Amount"@en .

:hasTotalTaxExclusiveAmount a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "has Total Tax Exclusive Amount"@en .

:hasTotalTaxInclusiveAmount a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "has Total Tax Inclusive Amount"@en .

:hasTrackingID a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "has Tracking ID"@en .

:hasVATExemptionReason a owl:DatatypeProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "has VAT Exemption Reason"@en .

:hasVATExemptionReasonDescription a owl:DatatypeProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "has VAT Exemption Reason Description"@en .

:hasValidityPeriod a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "has Validity Period"@en .

:isCalculatedOn a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:definition "The monetary amount to which the multiplier factor is applied in calculating the amount of this allowance, charge or tax."@en ;
    skos:prefLabel "is Calculated On"@en .

:isPartialDeliveryAllowed a owl:DatatypeProperty ;
    rdfs:isDefinedBy :ord ;
    skos:definition "An indicator to state if partial delivery is allowed or not. (epo-ord:DeliveryAgreement)"@en ;
    skos:historyNote "WG Approval 03/04/2025"@en ;
    skos:prefLabel "is Partial Delivery Allowed"@en .

:isSpecificToInvoiceLine a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "is Specific To Invoice Line"@en .

:isSpecificToOrderLine a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:definition "Information that is particular to one or multiple Order Lines."@en ;
    skos:prefLabel "is Specific To Order Line"@en .

:isSpecificToOrderResponseLine a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "is Specific To Order Response Line"@en .

:isSpecificToRequestForOfferLine a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "is Specific To Request For Offer Line"@en .

:isSubmittedForOrder a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "is Submitted For Order"@en .

:isSubmittedForOrderLine a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "is Submitted For Order Line"@en .

:refersToCatalogue a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:definition "Additional information: If an order refers to multiple catalogues then all these catalogues ideally are subordinated to the same contract. Some countries however may allow multiple contracts per order (i.e Italy)."@en ;
    skos:prefLabel "refers To Catalogue"@en .

:refersToCatalogueLine a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:definition "Additional Information: The reference to the catalogue line is for information only, to trace the source of the information provided in the order line."@en ;
    skos:prefLabel "refers To Catalogue Line"@en .

:refersToDeliveryInformation a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:definition "Reference to a Delivery Information."@en ;
    skos:historyNote "WG Approval 25/06/2024"@en ;
    skos:prefLabel "refers To Delivery Information"@en .

:refersToOrder a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:definition "Reference to an Order."@en ;
    skos:historyNote "WG Approval 25/06/2024"@en ;
    skos:prefLabel "refers To Order"@en .

:refersToOrderLine a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:definition "Reference to an Order Line."@en ;
    skos:historyNote "WG Approval 25/06/2024"@en ;
    skos:prefLabel "refers To Order Line"@en .

:refersToProject a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "refers To Project"@en .

:respondsToOrderCancellation a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "responds To Order Cancellation"@en .

:respondsToOrderChange a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "responds To Order Change"@en .

:specifiesAllowanceInformation a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "specifies Allowance Information"@en .

:specifiesBuyer a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "specifies Buyer"@en .

:specifiesChargeInformation a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "specifies Charge Information"@en .

:specifiesConsignee a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:definition "Relation indicating that the instance of the concept involves the Consignee."@en ;
    skos:historyNote "WG Approval 25/06/2024"@en ;
    skos:prefLabel "specifies Consignee"@en .

:specifiesContractInformation a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "specifies Contract Information"@en .

:specifiesDeliveryAgreement a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "specifies Delivery Agreement"@en .

:specifiesDeliveryAgreementLocation a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "specifies Delivery Agreement Location"@en .

:specifiesDeliveryInformation a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "specifies Delivery Information"@en .

:specifiesDespatcher a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:definition "Relation indicating that the instance of the concept involves the Despatcher."@en ;
    skos:historyNote "WG Approval 25/06/2024"@en ;
    skos:prefLabel "specifies Despatcher"@en .

:specifiesInvoicee a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "specifies Invoicee"@en .

:specifiesOrderResponseInformation a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "specifies Order Response Information"@en .

:specifiesOriginator a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:definition "Relation indicating that the instance of the concept involves the Originator."@en ;
    skos:historyNote "WG Approval 25/06/2024"@en ;
    skos:prefLabel "specifies Originator"@en .

:specifiesOriginatorInformation a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "specifies Originator Information"@en .

:specifiesPlaceOfDelivery a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "specifies Place Of Delivery"@en .

:specifiesSeller a owl:ObjectProperty ;
    rdfs:isDefinedBy :ord ;
    skos:prefLabel "specifies Seller"@en .

:AllowanceChargeInformation a owl:Class ;
    rdfs:isDefinedBy :ord ;
    rdfs:subClassOf :InformationHub ;
    skos:definition "Information about discounts, taxes, duties and fees imposed."@en ;
    skos:historyNote "WG Approval 16/05/2023"@en ;
    skos:prefLabel "Allowance Charge Information"@en .

:Order a owl:Class ;
    rdfs:isDefinedBy :ord ;
    rdfs:subClassOf :PostAwardDocument ;
    skos:definition "A formal request of the Buyer to the Seller specifying the goods, services or works to be delivered. Additional Information: A Buyer submits an Order for delivery of goods, services or works to a Seller."@en ;
    skos:historyNote "WG Approval 23/04/2023"@en ;
    skos:prefLabel "Order"@en .

:OrderLine a owl:Class ;
    rdfs:isDefinedBy :ord ;
    rdfs:subClassOf :Line ;
    skos:definition "Details concerning a given unit of goods, services or works requested in the Order. Additional information: In general, an Order Line contains the Quantity and Price of the goods, services and goods requested in the Order. However, in certain cases, the Price may not be known, as the Price may fluctuate from one day to the other."@en ;
    skos:historyNote "WG Approval 20/04/2023"@en ;
    skos:prefLabel "Order Line"@en .

:ord a owl:Ontology ;
    rdfs:label "eProcurement Ontology Ordering - core"@en ;
    dcterms:created "2021-06-01"^^xsd:date ;
    dcterms:description "The eProcurement Ontology Ordering core describes the concepts and properties representing the European Public Procurement Ordering domain. The provision of these semantics offers the basis for a common understanding of the domain for all stakeholders ensuring the quality of data exchange and transparency. The ontology restrictions are published in a separate artefact."@en ;
    dcterms:issued "2025-06-04"^^xsd:date ;
    dcterms:license "© European Union, 2014. Unless otherwise noted, the reuse of the Ontology is authorised under the European Union Public Licence v1.2 (https://eupl.eu/)." ;
    dcterms:publisher "http://publications.europa.eu/resource/authority/corporate-body/PUBL" ;
    dcterms:title "eProcurement Ontology Ordering - core"@en ;
    vann:preferredNamespacePrefix "epo" ;
    vann:preferredNamespaceUri "http://data.europa.eu/a4g/ontology#" ;
    rdfs:comment "This version is automatically generated from eOrdering.xml on 2025-06-04" ;
    rdfs:seeAlso <https://docs.ted.europa.eu/home/index.html>,
        <https://github.com/OP-TED/ePO/releases>,
        <https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology/about>,
        <https://op.europa.eu/en/web/eu-vocabularies/e-procurement> ;
    owl:imports :cat,
        :core,
        :ful,
        eli:,
        cccev:,
        dcterms:,
        skos:,
        <http://www.w3.org/2006/time>,
        <http://www.w3.org/ns/adms>,
        <http://www.w3.org/ns/locn>,
        org:,
        <http://www.w3.org/ns/person> ;
    owl:incompatibleWith "4.2.0" ;
    owl:priorVersion "http://data.europa.eu/a4g/ontology#ord-5.0.0" ;
    owl:versionIRI :ord-5.1.0 ;
    owl:versionInfo "5.1.0" .

