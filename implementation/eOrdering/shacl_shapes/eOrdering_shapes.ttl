@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ord-shape:epo-Contract sh:property ord-shape:epo-Contract-epo-ord-hasTaxInformation .

ord-shape:epo-cat-AbstractItem sh:property ord-shape:epo-cat-AbstractItem-epo-ord-hasTaxInformation .

ord-shape:epo-cat-Catalogue sh:property ord-shape:epo-cat-Catalogue-epo-specifiesSeller .

ord-shape:epo-cat-CatalogueResponseInformation sh:property ord-shape:epo-cat-CatalogueResponseInformation-epo-ord-hasResponseStatus .

ord-shape:epo-cat-ChargeInformation sh:property ord-shape:epo-cat-ChargeInformation-epo-ord-isSpecificToOrderLine .

ord-shape:epo-cat-Price sh:property ord-shape:epo-cat-Price-epo-ord-hasPriceDiscountInformation .

ord-shape:epo-ful-AbstractContainer sh:property ord-shape:epo-ful-AbstractContainer-epo-ord-hasAcceptanceStatus .

ord-shape:epo-ful-DespatchAdvice sh:property ord-shape:epo-ful-DespatchAdvice-epo-ful-refersToOrder,
        ord-shape:epo-ful-DespatchAdvice-epo-ful-specifiesConsignee,
        ord-shape:epo-ful-DespatchAdvice-epo-ful-specifiesOriginator .

ord-shape:epo-ful-DespatchLine sh:property ord-shape:epo-ful-DespatchLine-epo-ful-refersToOrderLine .

ord-shape:epo-ful-ReceiptAdvice sh:property ord-shape:epo-ful-ReceiptAdvice-epo-ful-specifiesConsignee,
        ord-shape:epo-ful-ReceiptAdvice-epo-specifiesSeller .

ord-shape:epo-ful-ReceiptAdviceInformation sh:property ord-shape:epo-ful-ReceiptAdviceInformation-epo-ord-hasAcceptanceStatus .

ord-shape:epo-ful-ShipmentAgreement sh:property ord-shape:epo-ful-ShipmentAgreement-epo-ful-agreedBySeller .

ord-shape:epo-ful-ShipmentInformation sh:property ord-shape:epo-ful-ShipmentInformation-epo-ful-refersToDeliveryInformation .

ord-shape:epo-inv-Invoice sh:property ord-shape:epo-inv-Invoice-epo-ful-refersToOrder,
        ord-shape:epo-inv-Invoice-epo-ord-hasTaxInformation,
        ord-shape:epo-inv-Invoice-epo-ord-specifiesAllowanceInformation,
        ord-shape:epo-inv-Invoice-epo-ord-specifiesDeliveryInformation,
        ord-shape:epo-inv-Invoice-epo-specifiesSeller .

ord-shape:epo-inv-InvoiceLine sh:property ord-shape:epo-inv-InvoiceLine-epo-inv-refersToOrderLine,
        ord-shape:epo-inv-InvoiceLine-epo-ord-hasTaxInformation .

ord-shape:epo-inv-TaxBreakdownInformation sh:property ord-shape:epo-inv-TaxBreakdownInformation-epo-ord-hasTaxInformation .

ord-shape:epo-ord-AllowanceChargeInformation a sh:NodeShape ;
    rdfs:label "Allowance Charge Information" ;
    rdfs:comment "Information about discounts, taxes, duties and fees imposed." ;
    rdfs:isDefinedBy ord-shape:ord-shape ;
    sh:property ord-shape:epo-ord-AllowanceChargeInformation-epo-cat-hasAmount,
        ord-shape:epo-ord-AllowanceChargeInformation-epo-cat-hasPercentage,
        ord-shape:epo-ord-AllowanceChargeInformation-epo-ful-hasAllowanceChargeReason,
        ord-shape:epo-ord-AllowanceChargeInformation-epo-ful-hasAllowanceChargeReasonDescription,
        ord-shape:epo-ord-AllowanceChargeInformation-epo-isCalculatedOn,
        ord-shape:epo-ord-AllowanceChargeInformation-epo-ord-hasTaxInformation,
        ord-shape:epo-ord-AllowanceChargeInformation-epo-ord-hasVATExemptionReason,
        ord-shape:epo-ord-AllowanceChargeInformation-epo-ord-hasVATExemptionReasonDescription ;
    sh:targetClass :AllowanceChargeInformation .

ord-shape:epo-ord-AllowanceInformation a sh:NodeShape ;
    rdfs:label "Allowance Information" ;
    rdfs:comment "Information about the discounts imposed." ;
    rdfs:isDefinedBy ord-shape:ord-shape ;
    sh:property ord-shape:epo-ord-AllowanceInformation-epo-inv-isSpecificToInvoiceLine,
        ord-shape:epo-ord-AllowanceInformation-epo-ord-isSpecificToOrderLine ;
    sh:targetClass :AllowanceInformation .

ord-shape:epo-ord-Consignee a sh:NodeShape ;
    rdfs:label "Consignee" ;
    rdfs:comment "A Role of an Agent that receives the Shipment of the Procurement (service, goods or works) and who is taking possession. Additional information: The Role is carried out by the Customer or on behalf of the Customer. The possession of the goods does not necessary imply ownership. The Consignee may be the end-user or the beneficiary. (Consignee) Definition from PEPPOL Despatch: The Consignee is the person or Organisation to which the products will be shipped and who is taking possession. The Role is carried out by the Customer or on behalf of the Customer." ;
    rdfs:isDefinedBy ord-shape:ord-shape ;
    sh:targetClass :Consignee .

ord-shape:epo-ord-ContractInformation a sh:NodeShape ;
    rdfs:label "Contract Information" ;
    rdfs:comment "Information about the Contract." ;
    rdfs:isDefinedBy ord-shape:ord-shape ;
    sh:property ord-shape:epo-ord-ContractInformation-epo-ord-concernsContract,
        ord-shape:epo-ord-ContractInformation-epo-ord-isSpecificToOrderLine ;
    sh:targetClass :ContractInformation .

ord-shape:epo-ord-DeliveryAgreement a sh:NodeShape ;
    rdfs:label "Delivery Agreement" ;
    rdfs:comment "Term applying to the delivery of goods, services and works. Additional Information: Delivery terms identifier can normally be Incoterms accompanied by the description of specific conditions related to the delivery." ;
    rdfs:isDefinedBy ord-shape:ord-shape ;
    sh:property ord-shape:epo-ord-DeliveryAgreement-epo-ord-hasGeneralDeliveryTerm,
        ord-shape:epo-ord-DeliveryAgreement-epo-ord-hasRequestedShippingPriority,
        ord-shape:epo-ord-DeliveryAgreement-epo-ord-isPartialDeliveryAllowed,
        ord-shape:epo-ord-DeliveryAgreement-epo-ord-specifiesDeliveryAgreementLocation ;
    sh:targetClass :DeliveryAgreement .

ord-shape:epo-ord-DeliveryInformation a sh:NodeShape ;
    rdfs:label "Delivery Information" ;
    rdfs:comment "Information about the timing, the delivery destination, the delivery agreement and the involved parties." ;
    rdfs:isDefinedBy ord-shape:ord-shape ;
    sh:property ord-shape:epo-ord-DeliveryInformation-epo-ful-hasTrackingID,
        ord-shape:epo-ord-DeliveryInformation-epo-hasAccessURL,
        ord-shape:epo-ord-DeliveryInformation-epo-inv-hasActualDeliveryDate,
        ord-shape:epo-ord-DeliveryInformation-epo-ord-concernsConsignee,
        ord-shape:epo-ord-DeliveryInformation-epo-ord-hasDeliveryDeadline,
        ord-shape:epo-ord-DeliveryInformation-epo-ord-hasDeliveryEmail,
        ord-shape:epo-ord-DeliveryInformation-epo-ord-hasDeliveryPeriod,
        ord-shape:epo-ord-DeliveryInformation-epo-ord-hasDownloadURL,
        ord-shape:epo-ord-DeliveryInformation-epo-ord-hasRequestedDeliveryPeriod,
        ord-shape:epo-ord-DeliveryInformation-epo-ord-hasShippingMark,
        ord-shape:epo-ord-DeliveryInformation-epo-ord-isSpecificToOrderLine,
        ord-shape:epo-ord-DeliveryInformation-epo-ord-isSpecificToRequestForOfferLine,
        ord-shape:epo-ord-DeliveryInformation-epo-ord-specifiesDeliveryAgreement,
        ord-shape:epo-ord-DeliveryInformation-epo-ord-specifiesPlaceOfDelivery ;
    sh:targetClass :DeliveryInformation .

ord-shape:epo-ord-Invoicee a sh:NodeShape ;
    rdfs:label "Invoicee" ;
    rdfs:comment "The Role of an Agent who receives and processes the Invoices." ;
    rdfs:isDefinedBy ord-shape:ord-shape ;
    sh:targetClass :Invoicee .

ord-shape:epo-ord-Order a sh:NodeShape ;
    rdfs:label "Order" ;
    rdfs:comment "A formal request of the Buyer to the Seller specifying the goods, services or works to be delivered. Additional Information: A Buyer submits an Order for delivery of goods, services or works to a Seller." ;
    rdfs:isDefinedBy ord-shape:ord-shape ;
    sh:property ord-shape:epo-ord-Order-epo-cat-refersToCatalogue,
        ord-shape:epo-ord-Order-epo-cat-specifiesChargeInformation,
        ord-shape:epo-ord-Order-epo-ful-specifiesDespatcher,
        ord-shape:epo-ord-Order-epo-hasValidityPeriod,
        ord-shape:epo-ord-Order-epo-ord-comprisesOrderLine,
        ord-shape:epo-ord-Order-epo-ord-hasAccountingCost,
        ord-shape:epo-ord-Order-epo-ord-hasAmountDueForPayment,
        ord-shape:epo-ord-Order-epo-ord-hasPaymentTerm,
        ord-shape:epo-ord-Order-epo-ord-hasPrepaidAmount,
        ord-shape:epo-ord-Order-epo-ord-hasRoundingAmount,
        ord-shape:epo-ord-Order-epo-ord-hasSellerOrderID,
        ord-shape:epo-ord-Order-epo-ord-hasTotalAllowanceAmount,
        ord-shape:epo-ord-Order-epo-ord-hasTotalChargeAmount,
        ord-shape:epo-ord-Order-epo-ord-hasTotalLineAmount,
        ord-shape:epo-ord-Order-epo-ord-hasTotalTaxExclusiveAmount,
        ord-shape:epo-ord-Order-epo-ord-hasTotalTaxInclusiveAmount,
        ord-shape:epo-ord-Order-epo-ord-specifiesAllowanceInformation,
        ord-shape:epo-ord-Order-epo-ord-specifiesContractInformation,
        ord-shape:epo-ord-Order-epo-ord-specifiesDeliveryInformation,
        ord-shape:epo-ord-Order-epo-ord-specifiesOriginatorInformation,
        ord-shape:epo-ord-Order-epo-refersToProject,
        ord-shape:epo-ord-Order-epo-specifiesBuyer,
        ord-shape:epo-ord-Order-epo-specifiesInvoicee,
        ord-shape:epo-ord-Order-epo-specifiesSeller ;
    sh:targetClass :Order .

ord-shape:epo-ord-OrderAgreement a sh:NodeShape ;
    rdfs:label "Order Agreement" ;
    rdfs:isDefinedBy ord-shape:ord-shape ;
    sh:property ord-shape:epo-ord-OrderAgreement-epo-ord-comprisesOrderAgreementLine ;
    sh:targetClass :OrderAgreement .

ord-shape:epo-ord-OrderAgreementLine a sh:NodeShape ;
    rdfs:label "Order Agreement Line" ;
    rdfs:isDefinedBy ord-shape:ord-shape ;
    sh:targetClass :OrderAgreementLine .

ord-shape:epo-ord-OrderCancellation a sh:NodeShape ;
    rdfs:label "Order Cancellation" ;
    rdfs:isDefinedBy ord-shape:ord-shape ;
    sh:property ord-shape:epo-ord-OrderCancellation-epo-ord-isSubmittedForOrder,
        ord-shape:epo-ord-OrderCancellation-epo-specifiesBuyer,
        ord-shape:epo-ord-OrderCancellation-epo-specifiesSeller ;
    sh:targetClass :OrderCancellation .

ord-shape:epo-ord-OrderCancellationConfirmation a sh:NodeShape ;
    rdfs:label "Order Cancellation Confirmation" ;
    rdfs:isDefinedBy ord-shape:ord-shape ;
    sh:property ord-shape:epo-ord-OrderCancellationConfirmation-epo-ord-respondsToOrderCancellation,
        ord-shape:epo-ord-OrderCancellationConfirmation-epo-specifiesBuyer,
        ord-shape:epo-ord-OrderCancellationConfirmation-epo-specifiesSeller ;
    sh:targetClass :OrderCancellationConfirmation .

ord-shape:epo-ord-OrderCancellationRejection a sh:NodeShape ;
    rdfs:label "Order Cancellation Rejection" ;
    rdfs:isDefinedBy ord-shape:ord-shape ;
    sh:property ord-shape:epo-ord-OrderCancellationRejection-epo-ord-respondsToOrderCancellation,
        ord-shape:epo-ord-OrderCancellationRejection-epo-specifiesBuyer,
        ord-shape:epo-ord-OrderCancellationRejection-epo-specifiesSeller ;
    sh:targetClass :OrderCancellationRejection .

ord-shape:epo-ord-OrderChange a sh:NodeShape ;
    rdfs:label "Order Change" ;
    rdfs:isDefinedBy ord-shape:ord-shape ;
    sh:property ord-shape:epo-ord-OrderChange-epo-ord-comprisesOrderChangeLine,
        ord-shape:epo-ord-OrderChange-epo-ord-isSubmittedForOrder ;
    sh:targetClass :OrderChange .

ord-shape:epo-ord-OrderChangeConfirmation a sh:NodeShape ;
    rdfs:label "Order Change Confirmation" ;
    rdfs:isDefinedBy ord-shape:ord-shape ;
    sh:property ord-shape:epo-ord-OrderChangeConfirmation-epo-ord-respondsToOrderChange,
        ord-shape:epo-ord-OrderChangeConfirmation-epo-specifiesBuyer,
        ord-shape:epo-ord-OrderChangeConfirmation-epo-specifiesSeller ;
    sh:targetClass :OrderChangeConfirmation .

ord-shape:epo-ord-OrderChangeLine a sh:NodeShape ;
    rdfs:label "Order Change Line" ;
    rdfs:isDefinedBy ord-shape:ord-shape ;
    sh:property ord-shape:epo-ord-OrderChangeLine-epo-ord-hasStatus,
        ord-shape:epo-ord-OrderChangeLine-epo-ord-isSubmittedForOrderLine ;
    sh:targetClass :OrderChangeLine .

ord-shape:epo-ord-OrderChangeRejection a sh:NodeShape ;
    rdfs:label "Order Change Rejection" ;
    rdfs:isDefinedBy ord-shape:ord-shape ;
    sh:property ord-shape:epo-ord-OrderChangeRejection-epo-ord-respondsToOrderChange,
        ord-shape:epo-ord-OrderChangeRejection-epo-specifiesBuyer,
        ord-shape:epo-ord-OrderChangeRejection-epo-specifiesSeller ;
    sh:targetClass :OrderChangeRejection .

ord-shape:epo-ord-OrderLine a sh:NodeShape ;
    rdfs:label "Order Line" ;
    rdfs:comment "Details concerning a given unit of goods, services or works requested in the Order. Additional information: In general, an Order Line contains the Quantity and Price of the goods, services and goods requested in the Order. However, in certain cases, the Price may not be known, as the Price may fluctuate from one day to the other." ;
    rdfs:isDefinedBy ord-shape:ord-shape ;
    sh:property ord-shape:epo-ord-OrderLine-epo-cat-hasPrice,
        ord-shape:epo-ord-OrderLine-epo-cat-hasQuantity,
        ord-shape:epo-ord-OrderLine-epo-ord-hasAccountingCost,
        ord-shape:epo-ord-OrderLine-epo-ord-refersToCatalogueLine ;
    sh:targetClass :OrderLine .

ord-shape:epo-ord-OrderResponse a sh:NodeShape ;
    rdfs:label "Order Response" ;
    rdfs:comment "A formal reply from the Seller to the Buyer stating the Seller's ability to fulfil the order. Additional Information: The Order Response is used to inform on the acceptance or rejection of an Order or to make a counter-offer." ;
    rdfs:isDefinedBy ord-shape:ord-shape ;
    sh:property ord-shape:epo-ord-OrderResponse-epo-ord-comprisesOrderResponseLine,
        ord-shape:epo-ord-OrderResponse-epo-ord-hasResponseDescription,
        ord-shape:epo-ord-OrderResponse-epo-ord-isSubmittedForOrder,
        ord-shape:epo-ord-OrderResponse-epo-ord-specifiesOrderResponseInformation ;
    sh:targetClass :OrderResponse .

ord-shape:epo-ord-OrderResponseInformation a sh:NodeShape ;
    rdfs:label "Order Response Information" ;
    rdfs:isDefinedBy ord-shape:ord-shape ;
    sh:property ord-shape:epo-ord-OrderResponseInformation-epo-ord-hasStatus,
        ord-shape:epo-ord-OrderResponseInformation-epo-ord-isSpecificToOrderResponseLine ;
    sh:targetClass :OrderResponseInformation .

ord-shape:epo-ord-OrderResponseLine a sh:NodeShape ;
    rdfs:label "Order Response Line" ;
    rdfs:comment "Details concerning the Seller's ability to fulfil a given Order Line. Additional Information: The Order Response Line is used to inform on the acceptance or rejection of an Order Line or to make a counter-offer." ;
    rdfs:isDefinedBy ord-shape:ord-shape ;
    sh:property ord-shape:epo-ord-OrderResponseLine-epo-ord-hasBackorderQuantity,
        ord-shape:epo-ord-OrderResponseLine-epo-ord-isSubmittedForOrderLine ;
    sh:targetClass :OrderResponseLine .

ord-shape:epo-ord-Originator a sh:NodeShape ;
    rdfs:label "Originator" ;
    rdfs:comment "A Role of an Agent that expresses the needs to trigger the Procurement. Additional Information: The Originator is often the end-user or the Beneficiary." ;
    rdfs:isDefinedBy ord-shape:ord-shape ;
    sh:targetClass :Originator .

ord-shape:epo-ord-OriginatorInformation a sh:NodeShape ;
    rdfs:label "Originator Information" ;
    rdfs:comment "Information about the Originator of the Order." ;
    rdfs:isDefinedBy ord-shape:ord-shape ;
    sh:property ord-shape:epo-ord-OriginatorInformation-epo-ord-concernsOriginator,
        ord-shape:epo-ord-OriginatorInformation-epo-ord-concernsOriginatorRequest,
        ord-shape:epo-ord-OriginatorInformation-epo-ord-isSpecificToOrderLine ;
    sh:targetClass :OriginatorInformation .

ord-shape:epo-ord-Seller a sh:NodeShape ;
    rdfs:label "Seller" ;
    rdfs:comment "A Role of an Agent who transfers the ownership of the Procurement results (goods, services or works) to the Buyer. Additional information: A Role of an Agent that sells a Procurement Result (goods, services or work) to a Buyer. The Seller is bound by a Contract i.e. it has legal responsibility. The Seller may or may not be the same as the Supplier. The Seller may or may not issue the Invoice. The Seller may or may not be the owner of the credit owed by the Buyer." ;
    rdfs:isDefinedBy ord-shape:ord-shape ;
    sh:targetClass :Seller .

ord-shape:epo-ord-TaxInformation a sh:NodeShape ;
    rdfs:label "Tax Information" ;
    rdfs:comment "Information about the imposition of mandatory levies required by law." ;
    rdfs:isDefinedBy ord-shape:ord-shape ;
    sh:property ord-shape:epo-ord-TaxInformation-epo-cat-hasAmount,
        ord-shape:epo-ord-TaxInformation-epo-cat-hasPercentage,
        ord-shape:epo-ord-TaxInformation-epo-cat-hasTaxCategory,
        ord-shape:epo-ord-TaxInformation-epo-cat-hasTaxScheme,
        ord-shape:epo-ord-TaxInformation-epo-isCalculatedOn ;
    sh:targetClass :TaxInformation .

ord-shape:epo-pay-RemittanceAdvice sh:property ord-shape:epo-pay-RemittanceAdvice-epo-specifiesSeller .

ord-shape:epo-req-RequestForOffer sh:property ord-shape:epo-req-RequestForOffer-epo-ful-specifiesOriginator,
        ord-shape:epo-req-RequestForOffer-epo-ord-specifiesDeliveryInformation .

ord-shape:epo-Contract-epo-ord-hasTaxInformation a sh:PropertyShape ;
    sh:class :TaxInformation ;
    sh:maxCount 1 ;
    sh:name "has Tax Information" ;
    sh:path :hasTaxInformation ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasTaxInformation> ?that . ?that <http://data.europa.eu/a4g/ontology#hasTaxInformation> ?this .}" ] .

ord-shape:epo-cat-AbstractItem-epo-ord-hasTaxInformation a sh:PropertyShape ;
    sh:class :TaxInformation ;
    sh:name "has Tax Information" ;
    sh:path :hasTaxInformation ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasTaxInformation> ?that . ?that <http://data.europa.eu/a4g/ontology#hasTaxInformation> ?this .}" ] .

ord-shape:epo-cat-Catalogue-epo-specifiesSeller a sh:PropertyShape ;
    sh:class :Seller ;
    sh:name "specifies Seller" ;
    sh:path :specifiesSeller ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#specifiesSeller> ?that . ?that <http://data.europa.eu/a4g/ontology#specifiesSeller> ?this .}" ] .

ord-shape:epo-cat-CatalogueResponseInformation-epo-ord-hasResponseStatus a sh:PropertyShape ;
    sh:class skos:Concept ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "has Response Status" ;
    sh:path :hasResponseStatus .

ord-shape:epo-cat-ChargeInformation-epo-ord-isSpecificToOrderLine a sh:PropertyShape ;
    sh:class :OrderLine ;
    sh:description "Information that is particular to one or multiple Order Lines." ;
    sh:name "is Specific To Order Line" ;
    sh:path :isSpecificToOrderLine ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#isSpecificToOrderLine> ?that . ?that <http://data.europa.eu/a4g/ontology#isSpecificToOrderLine> ?this .}" ] .

ord-shape:epo-cat-Price-epo-ord-hasPriceDiscountInformation a sh:PropertyShape ;
    sh:class :AllowanceInformation ;
    sh:maxCount 1 ;
    sh:name "has Price Discount Information" ;
    sh:path :hasPriceDiscountInformation ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasPriceDiscountInformation> ?that . ?that <http://data.europa.eu/a4g/ontology#hasPriceDiscountInformation> ?this .}" ] .

ord-shape:epo-ful-AbstractContainer-epo-ord-hasAcceptanceStatus a sh:PropertyShape ;
    sh:class skos:Concept ;
    sh:maxCount 1 ;
    sh:name "has Acceptance Status" ;
    sh:path :hasAcceptanceStatus .

ord-shape:epo-ful-DespatchAdvice-epo-ful-refersToOrder a sh:PropertyShape ;
    sh:class :Order ;
    sh:description "Reference to an Order." ;
    sh:maxCount 1 ;
    sh:name "refers To Order" ;
    sh:path :refersToOrder ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#refersToOrder> ?that . ?that <http://data.europa.eu/a4g/ontology#refersToOrder> ?this .}" ] .

ord-shape:epo-ful-DespatchAdvice-epo-ful-specifiesConsignee a sh:PropertyShape ;
    sh:class :Consignee ;
    sh:description "Relation indicating that the instance of the concept involves the Consignee." ;
    sh:minCount 1 ;
    sh:name "specifies Consignee" ;
    sh:path :specifiesConsignee ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#specifiesConsignee> ?that . ?that <http://data.europa.eu/a4g/ontology#specifiesConsignee> ?this .}" ] .

ord-shape:epo-ful-DespatchAdvice-epo-ful-specifiesOriginator a sh:PropertyShape ;
    sh:class :Originator ;
    sh:description "Relation indicating that the instance of the concept involves the Originator." ;
    sh:name "specifies Originator" ;
    sh:path :specifiesOriginator ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#specifiesOriginator> ?that . ?that <http://data.europa.eu/a4g/ontology#specifiesOriginator> ?this .}" ] .

ord-shape:epo-ful-DespatchLine-epo-ful-refersToOrderLine a sh:PropertyShape ;
    sh:class :OrderLine ;
    sh:description "Reference to an Order Line." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "refers To Order Line" ;
    sh:path :refersToOrderLine ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#refersToOrderLine> ?that . ?that <http://data.europa.eu/a4g/ontology#refersToOrderLine> ?this .}" ] .

ord-shape:epo-ful-ReceiptAdvice-epo-ful-specifiesConsignee a sh:PropertyShape ;
    sh:class :Consignee ;
    sh:minCount 1 ;
    sh:name "specifies Consignee" ;
    sh:path :specifiesConsignee ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#specifiesConsignee> ?that . ?that <http://data.europa.eu/a4g/ontology#specifiesConsignee> ?this .}" ] .

ord-shape:epo-ful-ReceiptAdvice-epo-specifiesSeller a sh:PropertyShape ;
    sh:class :Seller ;
    sh:maxCount 1 ;
    sh:name "specifies Seller" ;
    sh:path :specifiesSeller ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#specifiesSeller> ?that . ?that <http://data.europa.eu/a4g/ontology#specifiesSeller> ?this .}" ] .

ord-shape:epo-ful-ReceiptAdviceInformation-epo-ord-hasAcceptanceStatus a sh:PropertyShape ;
    sh:class skos:Concept ;
    sh:maxCount 1 ;
    sh:name "has Acceptance Status" ;
