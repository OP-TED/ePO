@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix epo: <http://data.europa.eu/a4g/ontology#> .
@prefix epo-shape: <http://data.europa.eu/a4g/data-shape#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

epo-shape:epo-Contract sh:property epo-shape:epo-Contract-epo-ord-hasTaxInformation .

epo-shape:epo-cat-AbstractItem sh:property epo-shape:epo-cat-AbstractItem-epo-ord-hasTaxInformation .

epo-shape:epo-cat-Catalogue sh:property epo-shape:epo-cat-Catalogue-epo-specifiesSeller .

epo-shape:epo-cat-CatalogueResponseInformation sh:property epo-shape:epo-cat-CatalogueResponseInformation-epo-ord-hasResponseStatus .

epo-shape:epo-cat-ChargeInformation sh:property epo-shape:epo-cat-ChargeInformation-epo-ord-isSpecificToOrderLine .

epo-shape:epo-cat-Price sh:property epo-shape:epo-cat-Price-epo-ord-hasPriceDiscountInformation .

epo-shape:epo-ful-AbstractContainer sh:property epo-shape:epo-ful-AbstractContainer-epo-ord-hasAcceptanceStatus .

epo-shape:epo-ful-DespatchAdvice sh:property epo-shape:epo-ful-DespatchAdvice-epo-ful-refersToOrder,
        epo-shape:epo-ful-DespatchAdvice-epo-ful-specifiesConsignee,
        epo-shape:epo-ful-DespatchAdvice-epo-ful-specifiesOriginator .

epo-shape:epo-ful-DespatchLine sh:property epo-shape:epo-ful-DespatchLine-epo-ful-refersToOrderLine .

epo-shape:epo-ful-ReceiptAdvice sh:property epo-shape:epo-ful-ReceiptAdvice-epo-ful-specifiesConsignee,
        epo-shape:epo-ful-ReceiptAdvice-epo-specifiesSeller .

epo-shape:epo-ful-ReceiptAdviceInformation sh:property epo-shape:epo-ful-ReceiptAdviceInformation-epo-ord-hasAcceptanceStatus .

epo-shape:epo-ful-ShipmentAgreement sh:property epo-shape:epo-ful-ShipmentAgreement-epo-ful-agreedBySeller .

epo-shape:epo-ful-ShipmentInformation sh:property epo-shape:epo-ful-ShipmentInformation-epo-ful-refersToDeliveryInformation .

epo-shape:epo-inv-Invoice sh:property epo-shape:epo-inv-Invoice-epo-ful-refersToOrder,
        epo-shape:epo-inv-Invoice-epo-ord-hasTaxInformation,
        epo-shape:epo-inv-Invoice-epo-ord-specifiesAllowanceInformation,
        epo-shape:epo-inv-Invoice-epo-ord-specifiesDeliveryInformation,
        epo-shape:epo-inv-Invoice-epo-specifiesSeller .

epo-shape:epo-inv-InvoiceLine sh:property epo-shape:epo-inv-InvoiceLine-epo-inv-refersToOrderLine,
        epo-shape:epo-inv-InvoiceLine-epo-ord-hasTaxInformation .

epo-shape:epo-inv-TaxBreakdownInformation sh:property epo-shape:epo-inv-TaxBreakdownInformation-epo-ord-hasTaxInformation .

epo-shape:epo-ord-AllowanceChargeInformationShape a sh:NodeShape ;
    rdfs:label "Allowance Charge Information" ;
    rdfs:comment "Information about discounts, taxes, duties and fees imposed." ;
    rdfs:isDefinedBy epo-shape:ord-shape ;
    sh:property epo-shape:epo-ord-AllowanceChargeInformation-epo-cat-hasAmount,
        epo-shape:epo-ord-AllowanceChargeInformation-epo-cat-hasPercentage,
        epo-shape:epo-ord-AllowanceChargeInformation-epo-ful-hasAllowanceChargeReason,
        epo-shape:epo-ord-AllowanceChargeInformation-epo-ful-hasAllowanceChargeReasonDescription,
        epo-shape:epo-ord-AllowanceChargeInformation-epo-isCalculatedOn,
        epo-shape:epo-ord-AllowanceChargeInformation-epo-ord-hasTaxInformation,
        epo-shape:epo-ord-AllowanceChargeInformation-epo-ord-hasVATExemptionReason,
        epo-shape:epo-ord-AllowanceChargeInformation-epo-ord-hasVATExemptionReasonDescription ;
    sh:targetClass epo:AllowanceChargeInformation .

epo-shape:epo-ord-AllowanceInformationShape a sh:NodeShape ;
    rdfs:label "Allowance Information" ;
    rdfs:comment "Information about the discounts imposed." ;
    rdfs:isDefinedBy epo-shape:ord-shape ;
    sh:property epo-shape:epo-ord-AllowanceInformation-epo-inv-isSpecificToInvoiceLine,
        epo-shape:epo-ord-AllowanceInformation-epo-ord-isSpecificToOrderLine ;
    sh:targetClass epo:AllowanceInformation .

epo-shape:epo-ord-ConsigneeShape a sh:NodeShape ;
    rdfs:label "Consignee" ;
    rdfs:comment "A Role of an Agent that receives the Shipment of the Procurement (service, goods or works) and who is taking possession. Additional information: The Role is carried out by the Customer or on behalf of the Customer. The possession of the goods does not necessary imply ownership. The Consignee may be the end-user or the beneficiary. (Consignee) Definition from PEPPOL Despatch: The Consignee is the person or Organisation to which the products will be shipped and who is taking possession. The Role is carried out by the Customer or on behalf of the Customer." ;
    rdfs:isDefinedBy epo-shape:ord-shape ;
    sh:targetClass epo:Consignee .

epo-shape:epo-ord-ContractInformationShape a sh:NodeShape ;
    rdfs:label "Contract Information" ;
    rdfs:comment "Information about the Contract." ;
    rdfs:isDefinedBy epo-shape:ord-shape ;
    sh:property epo-shape:epo-ord-ContractInformation-epo-ord-concernsContract,
        epo-shape:epo-ord-ContractInformation-epo-ord-isSpecificToOrderLine ;
    sh:targetClass epo:ContractInformation .

epo-shape:epo-ord-DeliveryAgreementShape a sh:NodeShape ;
    rdfs:label "Delivery Agreement" ;
    rdfs:comment "Term applying to the delivery of goods, services and works. Additional Information: Delivery terms identifier can normally be Incoterms accompanied by the description of specific conditions related to the delivery." ;
    rdfs:isDefinedBy epo-shape:ord-shape ;
    sh:property epo-shape:epo-ord-DeliveryAgreement-epo-ord-hasGeneralDeliveryTerm,
        epo-shape:epo-ord-DeliveryAgreement-epo-ord-hasRequestedShippingPriority,
        epo-shape:epo-ord-DeliveryAgreement-epo-ord-isPartialDeliveryAllowed,
        epo-shape:epo-ord-DeliveryAgreement-epo-ord-specifiesDeliveryAgreementLocation ;
    sh:targetClass epo:DeliveryAgreement .

epo-shape:epo-ord-DeliveryInformationShape a sh:NodeShape ;
    rdfs:label "Delivery Information" ;
    rdfs:comment "Information about the timing, the delivery destination, the delivery agreement and the involved parties." ;
    rdfs:isDefinedBy epo-shape:ord-shape ;
    sh:property epo-shape:epo-ord-DeliveryInformation-epo-ful-hasTrackingID,
        epo-shape:epo-ord-DeliveryInformation-epo-hasAccessURL,
        epo-shape:epo-ord-DeliveryInformation-epo-inv-hasActualDeliveryDate,
        epo-shape:epo-ord-DeliveryInformation-epo-ord-concernsConsignee,
        epo-shape:epo-ord-DeliveryInformation-epo-ord-hasDeliveryDeadline,
        epo-shape:epo-ord-DeliveryInformation-epo-ord-hasDeliveryEmail,
        epo-shape:epo-ord-DeliveryInformation-epo-ord-hasDeliveryPeriod,
        epo-shape:epo-ord-DeliveryInformation-epo-ord-hasDownloadURL,
        epo-shape:epo-ord-DeliveryInformation-epo-ord-hasRequestedDeliveryPeriod,
        epo-shape:epo-ord-DeliveryInformation-epo-ord-hasShippingMark,
        epo-shape:epo-ord-DeliveryInformation-epo-ord-isSpecificToOrderLine,
        epo-shape:epo-ord-DeliveryInformation-epo-ord-isSpecificToRequestForOfferLine,
        epo-shape:epo-ord-DeliveryInformation-epo-ord-specifiesDeliveryAgreement,
        epo-shape:epo-ord-DeliveryInformation-epo-ord-specifiesPlaceOfDelivery ;
    sh:targetClass epo:DeliveryInformation .

epo-shape:epo-ord-InvoiceeShape a sh:NodeShape ;
    rdfs:label "Invoicee" ;
    rdfs:comment "The Role of an Agent who receives and processes the Invoices." ;
    rdfs:isDefinedBy epo-shape:ord-shape ;
    sh:targetClass epo:Invoicee .

epo-shape:epo-ord-OrderAgreementLineShape a sh:NodeShape ;
    rdfs:label "Order Agreement Line" ;
    rdfs:isDefinedBy epo-shape:ord-shape ;
    sh:targetClass epo:OrderAgreementLine .

epo-shape:epo-ord-OrderAgreementShape a sh:NodeShape ;
    rdfs:label "Order Agreement" ;
    rdfs:isDefinedBy epo-shape:ord-shape ;
    sh:property epo-shape:epo-ord-OrderAgreement-epo-ord-comprisesOrderAgreementLine ;
    sh:targetClass epo:OrderAgreement .

epo-shape:epo-ord-OrderCancellationConfirmationShape a sh:NodeShape ;
    rdfs:label "Order Cancellation Confirmation" ;
    rdfs:isDefinedBy epo-shape:ord-shape ;
    sh:property epo-shape:epo-ord-OrderCancellationConfirmation-epo-ord-respondsToOrderCancellation,
        epo-shape:epo-ord-OrderCancellationConfirmation-epo-specifiesBuyer,
        epo-shape:epo-ord-OrderCancellationConfirmation-epo-specifiesSeller ;
    sh:targetClass epo:OrderCancellationConfirmation .

epo-shape:epo-ord-OrderCancellationRejectionShape a sh:NodeShape ;
    rdfs:label "Order Cancellation Rejection" ;
    rdfs:isDefinedBy epo-shape:ord-shape ;
    sh:property epo-shape:epo-ord-OrderCancellationRejection-epo-ord-respondsToOrderCancellation,
        epo-shape:epo-ord-OrderCancellationRejection-epo-specifiesBuyer,
        epo-shape:epo-ord-OrderCancellationRejection-epo-specifiesSeller ;
    sh:targetClass epo:OrderCancellationRejection .

epo-shape:epo-ord-OrderCancellationShape a sh:NodeShape ;
    rdfs:label "Order Cancellation" ;
    rdfs:isDefinedBy epo-shape:ord-shape ;
    sh:property epo-shape:epo-ord-OrderCancellation-epo-ord-isSubmittedForOrder,
        epo-shape:epo-ord-OrderCancellation-epo-specifiesBuyer,
        epo-shape:epo-ord-OrderCancellation-epo-specifiesSeller ;
    sh:targetClass epo:OrderCancellation .

epo-shape:epo-ord-OrderChangeConfirmationShape a sh:NodeShape ;
    rdfs:label "Order Change Confirmation" ;
    rdfs:isDefinedBy epo-shape:ord-shape ;
    sh:property epo-shape:epo-ord-OrderChangeConfirmation-epo-ord-respondsToOrderChange,
        epo-shape:epo-ord-OrderChangeConfirmation-epo-specifiesBuyer,
        epo-shape:epo-ord-OrderChangeConfirmation-epo-specifiesSeller ;
    sh:targetClass epo:OrderChangeConfirmation .

epo-shape:epo-ord-OrderChangeLineShape a sh:NodeShape ;
    rdfs:label "Order Change Line" ;
    rdfs:isDefinedBy epo-shape:ord-shape ;
    sh:property epo-shape:epo-ord-OrderChangeLine-epo-ord-hasStatus,
        epo-shape:epo-ord-OrderChangeLine-epo-ord-isSubmittedForOrderLine ;
    sh:targetClass epo:OrderChangeLine .

epo-shape:epo-ord-OrderChangeRejectionShape a sh:NodeShape ;
    rdfs:label "Order Change Rejection" ;
    rdfs:isDefinedBy epo-shape:ord-shape ;
    sh:property epo-shape:epo-ord-OrderChangeRejection-epo-ord-respondsToOrderChange,
        epo-shape:epo-ord-OrderChangeRejection-epo-specifiesBuyer,
        epo-shape:epo-ord-OrderChangeRejection-epo-specifiesSeller ;
    sh:targetClass epo:OrderChangeRejection .

epo-shape:epo-ord-OrderChangeShape a sh:NodeShape ;
    rdfs:label "Order Change" ;
    rdfs:isDefinedBy epo-shape:ord-shape ;
    sh:property epo-shape:epo-ord-OrderChange-epo-ord-comprisesOrderChangeLine,
        epo-shape:epo-ord-OrderChange-epo-ord-isSubmittedForOrder ;
    sh:targetClass epo:OrderChange .

epo-shape:epo-ord-OrderLineShape a sh:NodeShape ;
    rdfs:label "Order Line" ;
    rdfs:comment "Details concerning a given unit of goods, services or works requested in the Order. Additional information: In general, an Order Line contains the Quantity and Price of the goods, services and goods requested in the Order. However, in certain cases, the Price may not be known, as the Price may fluctuate from one day to the other." ;
    rdfs:isDefinedBy epo-shape:ord-shape ;
    sh:property epo-shape:epo-ord-OrderLine-epo-cat-hasPrice,
        epo-shape:epo-ord-OrderLine-epo-cat-hasQuantity,
        epo-shape:epo-ord-OrderLine-epo-ord-hasAccountingCost,
        epo-shape:epo-ord-OrderLine-epo-ord-refersToCatalogueLine ;
    sh:targetClass epo:OrderLine .

epo-shape:epo-ord-OrderResponseInformationShape a sh:NodeShape ;
    rdfs:label "Order Response Information" ;
    rdfs:isDefinedBy epo-shape:ord-shape ;
    sh:property epo-shape:epo-ord-OrderResponseInformation-epo-ord-hasStatus,
        epo-shape:epo-ord-OrderResponseInformation-epo-ord-isSpecificToOrderResponseLine ;
    sh:targetClass epo:OrderResponseInformation .

epo-shape:epo-ord-OrderResponseLineShape a sh:NodeShape ;
    rdfs:label "Order Response Line" ;
    rdfs:comment "Details concerning the Seller's ability to fulfil a given Order Line. Additional Information: The Order Response Line is used to inform on the acceptance or rejection of an Order Line or to make a counter-offer." ;
    rdfs:isDefinedBy epo-shape:ord-shape ;
    sh:property epo-shape:epo-ord-OrderResponseLine-epo-ord-hasBackorderQuantity,
        epo-shape:epo-ord-OrderResponseLine-epo-ord-isSubmittedForOrderLine ;
    sh:targetClass epo:OrderResponseLine .

epo-shape:epo-ord-OrderResponseShape a sh:NodeShape ;
    rdfs:label "Order Response" ;
    rdfs:comment "A formal reply from the Seller to the Buyer stating the Seller's ability to fulfil the order. Additional Information: The Order Response is used to inform on the acceptance or rejection of an Order or to make a counter-offer." ;
    rdfs:isDefinedBy epo-shape:ord-shape ;
    sh:property epo-shape:epo-ord-OrderResponse-epo-ord-comprisesOrderResponseLine,
        epo-shape:epo-ord-OrderResponse-epo-ord-hasResponseDescription,
        epo-shape:epo-ord-OrderResponse-epo-ord-isSubmittedForOrder,
        epo-shape:epo-ord-OrderResponse-epo-ord-specifiesOrderResponseInformation ;
    sh:targetClass epo:OrderResponse .

epo-shape:epo-ord-OrderShape a sh:NodeShape ;
    rdfs:label "Order" ;
    rdfs:comment "A formal request of the Buyer to the Seller specifying the goods, services or works to be delivered. Additional Information: A Buyer submits an Order for delivery of goods, services or works to a Seller." ;
    rdfs:isDefinedBy epo-shape:ord-shape ;
    sh:property epo-shape:epo-ord-Order-epo-cat-refersToCatalogue,
        epo-shape:epo-ord-Order-epo-cat-specifiesChargeInformation,
        epo-shape:epo-ord-Order-epo-ful-specifiesDespatcher,
        epo-shape:epo-ord-Order-epo-hasValidityPeriod,
        epo-shape:epo-ord-Order-epo-ord-comprisesOrderLine,
        epo-shape:epo-ord-Order-epo-ord-hasAccountingCost,
        epo-shape:epo-ord-Order-epo-ord-hasAmountDueForPayment,
        epo-shape:epo-ord-Order-epo-ord-hasPaymentTerm,
        epo-shape:epo-ord-Order-epo-ord-hasPrepaidAmount,
        epo-shape:epo-ord-Order-epo-ord-hasRoundingAmount,
        epo-shape:epo-ord-Order-epo-ord-hasSellerOrderID,
        epo-shape:epo-ord-Order-epo-ord-hasTotalAllowanceAmount,
        epo-shape:epo-ord-Order-epo-ord-hasTotalChargeAmount,
        epo-shape:epo-ord-Order-epo-ord-hasTotalLineAmount,
        epo-shape:epo-ord-Order-epo-ord-hasTotalTaxExclusiveAmount,
        epo-shape:epo-ord-Order-epo-ord-hasTotalTaxInclusiveAmount,
        epo-shape:epo-ord-Order-epo-ord-specifiesAllowanceInformation,
        epo-shape:epo-ord-Order-epo-ord-specifiesContractInformation,
        epo-shape:epo-ord-Order-epo-ord-specifiesDeliveryInformation,
        epo-shape:epo-ord-Order-epo-ord-specifiesOriginatorInformation,
        epo-shape:epo-ord-Order-epo-refersToProject,
        epo-shape:epo-ord-Order-epo-specifiesBuyer,
        epo-shape:epo-ord-Order-epo-specifiesInvoicee,
        epo-shape:epo-ord-Order-epo-specifiesSeller ;
    sh:targetClass epo:Order .

epo-shape:epo-ord-OriginatorInformationShape a sh:NodeShape ;
    rdfs:label "Originator Information" ;
    rdfs:comment "Information about the Originator of the Order." ;
    rdfs:isDefinedBy epo-shape:ord-shape ;
    sh:property epo-shape:epo-ord-OriginatorInformation-epo-ord-concernsOriginator,
        epo-shape:epo-ord-OriginatorInformation-epo-ord-concernsOriginatorRequest,
        epo-shape:epo-ord-OriginatorInformation-epo-ord-isSpecificToOrderLine ;
    sh:targetClass epo:OriginatorInformation .

epo-shape:epo-ord-OriginatorShape a sh:NodeShape ;
    rdfs:label "Originator" ;
    rdfs:comment "A Role of an Agent that expresses the needs to trigger the Procurement. Additional Information: The Originator is often the end-user or the Beneficiary." ;
    rdfs:isDefinedBy epo-shape:ord-shape ;
    sh:targetClass epo:Originator .

epo-shape:epo-ord-SellerShape a sh:NodeShape ;
    rdfs:label "Seller" ;
    rdfs:comment "A Role of an Agent who transfers the ownership of the Procurement results (goods, services or works) to the Buyer. Additional information: A Role of an Agent that sells a Procurement Result (goods, services or work) to a Buyer. The Seller is bound by a Contract i.e. it has legal responsibility. The Seller may or may not be the same as the Supplier. The Seller may or may not issue the Invoice. The Seller may or may not be the owner of the credit owed by the Buyer." ;
    rdfs:isDefinedBy epo-shape:ord-shape ;
    sh:targetClass epo:Seller .

epo-shape:epo-ord-TaxInformationShape a sh:NodeShape ;
    rdfs:label "Tax Information" ;
    rdfs:comment "Information about the imposition of mandatory levies required by law." ;
    rdfs:isDefinedBy epo-shape:ord-shape ;
    sh:property epo-shape:epo-ord-TaxInformation-epo-cat-hasAmount,
        epo-shape:epo-ord-TaxInformation-epo-cat-hasPercentage,
        epo-shape:epo-ord-TaxInformation-epo-cat-hasTaxCategory,
        epo-shape:epo-ord-TaxInformation-epo-cat-hasTaxScheme,
        epo-shape:epo-ord-TaxInformation-epo-isCalculatedOn ;
    sh:targetClass epo:TaxInformation .

epo-shape:epo-pay-RemittanceAdvice sh:property epo-shape:epo-pay-RemittanceAdvice-epo-specifiesSeller .

epo-shape:epo-req-RequestForOffer sh:property epo-shape:epo-req-RequestForOffer-epo-ful-specifiesOriginator,
        epo-shape:epo-req-RequestForOffer-epo-ord-specifiesDeliveryInformation .

epo-shape:epo-Contract-epo-ord-hasTaxInformation a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:ord-shape ;
    sh:class epo:TaxInformation ;
    sh:maxCount 1 ;
    sh:name "Has tax information" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasTaxInformation ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasTaxInformation> ?that . ?that <http://data.europa.eu/a4g/ontology#hasTaxInformation> ?this .}" ] .

epo-shape:epo-cat-AbstractItem-epo-ord-hasTaxInformation a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:ord-shape ;
    sh:class epo:TaxInformation ;
    sh:name "Has tax information" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasTaxInformation ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasTaxInformation> ?that . ?that <http://data.europa.eu/a4g/ontology#hasTaxInformation> ?this .}" ] .

epo-shape:epo-cat-Catalogue-epo-specifiesSeller a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:ord-shape ;
    sh:class epo:Seller ;
    sh:name "Specifies seller" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:specifiesSeller ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#specifiesSeller> ?that . ?that <http://data.europa.eu/a4g/ontology#specifiesSeller> ?this .}" ] .

epo-shape:epo-cat-CatalogueResponseInformation-epo-ord-hasResponseStatus a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:ord-shape ;
    sh:class skos:Concept ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Has response status" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasResponseStatus .

epo-shape:epo-cat-ChargeInformation-epo-ord-isSpecificToOrderLine a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:ord-shape ;
    sh:class epo:OrderLine ;
    sh:description "Information that is particular to one or multiple Order Lines." ;
    sh:name "Is specific to order line" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:isSpecificToOrderLine ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#isSpecificToOrderLine> ?that . ?that <http://data.europa.eu/a4g/ontology#isSpecificToOrderLine> ?this .}" ] .

epo-shape:epo-cat-Price-epo-ord-hasPriceDiscountInformation a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:ord-shape ;
    sh:class epo:AllowanceInformation ;
    sh:maxCount 1 ;
    sh:name "Has price discount information" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasPriceDiscountInformation ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasPriceDiscountInformation> ?that . ?that <http://data.europa.eu/a4g/ontology#hasPriceDiscountInformation> ?this .}" ] .

epo-shape:epo-ful-AbstractContainer-epo-ord-hasAcceptanceStatus a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:ord-shape ;
    sh:class skos:Concept ;
    sh:maxCount 1 ;
    sh:name "Has acceptance status" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasAcceptanceStatus .

epo-shape:epo-ful-DespatchAdvice-epo-ful-refersToOrder a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:ord-shape ;
    sh:class epo:Order ;
    sh:description "Reference to an Order." ;
    sh:maxCount 1 ;
    sh:name "Refers to order" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:refersToOrder ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#refersToOrder> ?that . ?that <http://data.europa.eu/a4g/ontology#refersToOrder> ?this .}" ] .

epo-shape:epo-ful-DespatchAdvice-epo-ful-specifiesConsignee a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:ord-shape ;
    sh:class epo:Consignee ;
    sh:description "Relation indicating that the instance of the concept involves the Consignee." ;
    sh:minCount 1 ;
    sh:name "Specifies consignee" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:specifiesConsignee ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#specifiesConsignee> ?that . ?that <http://data.europa.eu/a4g/ontology#specifiesConsignee> ?this .}" ] .

epo-shape:epo-ful-DespatchAdvice-epo-ful-specifiesOriginator a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:ord-shape ;
    sh:class epo:Originator ;
    sh:description "Relation indicating that the instance of the concept involves the Originator." ;
    sh:name "Specifies originator" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:specifiesOriginator ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#specifiesOriginator> ?that . ?that <http://data.europa.eu/a4g/ontology#specifiesOriginator> ?this .}" ] .

