@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix epo: <http://data.europa.eu/a4g/ontology#> .
@prefix epo-shape: <http://data.europa.eu/a4g/data-shape#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

epo-shape:epo-pay-PaymentInformationShape a sh:NodeShape ;
    rdfs:label "Payment Information" ;
    rdfs:comment "Information about a remittance." ;
    rdfs:isDefinedBy epo-shape:pay-shape ;
    sh:property epo-shape:epo-pay-PaymentInformation-epo-pay-hasPaymentDate,
        epo-shape:epo-pay-PaymentInformation-epo-pay-hasPaymentIdentifier,
        epo-shape:epo-pay-PaymentInformation-epo-pay-hasPaymentMeansInformation ;
    sh:targetClass epo:PaymentInformation .

epo-shape:epo-pay-RemittanceAdviceLineShape a sh:NodeShape ;
    rdfs:label "Remittance Advice Line" ;
    rdfs:comment "Details concerning a given Invoice from the Remittance Advice." ;
    rdfs:isDefinedBy epo-shape:pay-shape ;
    sh:property epo-shape:epo-pay-RemittanceAdviceLine-epo-inv-refersToInvoice,
        epo-shape:epo-pay-RemittanceAdviceLine-epo-pay-hasBalanceAmount,
        epo-shape:epo-pay-RemittanceAdviceLine-epo-pay-hasCreditAmount,
        epo-shape:epo-pay-RemittanceAdviceLine-epo-pay-hasDebitAmount ;
    sh:targetClass epo:RemittanceAdviceLine .

epo-shape:epo-pay-RemittanceAdviceShape a sh:NodeShape ;
    rdfs:label "Remittance Advice" ;
    rdfs:comment "Document sent by the Buyer to the Seller, informing about the payment made." ;
    rdfs:isDefinedBy epo-shape:pay-shape ;
    sh:property epo-shape:epo-pay-RemittanceAdvice-epo-inv-specifiesPayee,
        epo-shape:epo-pay-RemittanceAdvice-epo-pay-comprisesRemittanceAdviceLine,
        epo-shape:epo-pay-RemittanceAdvice-epo-pay-hasPayerReference,
        epo-shape:epo-pay-RemittanceAdvice-epo-pay-hasPaymentInformation,
        epo-shape:epo-pay-RemittanceAdvice-epo-pay-hasPaymentOrderReference,
        epo-shape:epo-pay-RemittanceAdvice-epo-pay-hasTotalCreditAmount,
        epo-shape:epo-pay-RemittanceAdvice-epo-pay-hasTotalDebitAmount,
        epo-shape:epo-pay-RemittanceAdvice-epo-pay-hasTotalPaymentAmount,
        epo-shape:epo-pay-RemittanceAdvice-epo-specifiesBuyer,
        epo-shape:epo-pay-RemittanceAdvice-epo-specifiesSeller ;
    sh:targetClass epo:RemittanceAdvice .

epo-shape:epo-pay-PaymentInformation-epo-pay-hasPaymentDate a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:pay-shape ;
    sh:description "The date of the Payment." ;
    sh:maxCount 1 ;
    sh:name "Has payment date" ;
    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
    sh:path epo:hasPaymentDate .

epo-shape:epo-pay-PaymentInformation-epo-pay-hasPaymentIdentifier a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:pay-shape ;
    sh:class adms:Identifier ;
    sh:description "Relation indicating the Identifier of the Payment." ;
    sh:maxCount 1 ;
    sh:name "Has payment identifier" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasPaymentIdentifier ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasPaymentIdentifier> ?that . ?that <http://data.europa.eu/a4g/ontology#hasPaymentIdentifier> ?this .}" ] .

epo-shape:epo-pay-PaymentInformation-epo-pay-hasPaymentMeansInformation a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:pay-shape ;
    sh:class epo:PaymentInstructionsInformation ;
    sh:description "Relation indicating the Payment Instruction Information." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Has payment means information" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasPaymentMeansInformation ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasPaymentMeansInformation> ?that . ?that <http://data.europa.eu/a4g/ontology#hasPaymentMeansInformation> ?this .}" ] .

epo-shape:epo-pay-RemittanceAdvice-epo-inv-specifiesPayee a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:pay-shape ;
    sh:class epo:Payee ;
    sh:description "Relation indicating that the instance of the concept involves the Payee." ;
    sh:maxCount 1 ;
    sh:name "Specifies payee" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:specifiesPayee ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#specifiesPayee> ?that . ?that <http://data.europa.eu/a4g/ontology#specifiesPayee> ?this .}" ] .

epo-shape:epo-pay-RemittanceAdvice-epo-pay-comprisesRemittanceAdviceLine a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:pay-shape ;
    sh:class epo:RemittanceAdviceLine ;
    sh:description "Incorporates Remittance Advice Line." ;
    sh:minCount 1 ;
    sh:name "Comprises remittance advice line" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:comprisesRemittanceAdviceLine ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#comprisesRemittanceAdviceLine> ?that . ?that <http://data.europa.eu/a4g/ontology#comprisesRemittanceAdviceLine> ?this .}" ] .

epo-shape:epo-pay-RemittanceAdvice-epo-pay-hasPayerReference a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:pay-shape ;
    sh:description "Reference to the Payer." ;
    sh:maxCount 1 ;
    sh:name "Has payer reference" ;
    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
    sh:path epo:hasPayerReference .

epo-shape:epo-pay-RemittanceAdvice-epo-pay-hasPaymentInformation a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:pay-shape ;
    sh:class epo:PaymentInformation ;
    sh:description "Relation indicating the Payment Information." ;
    sh:maxCount 1 ;
    sh:name "Has payment information" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasPaymentInformation ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasPaymentInformation> ?that . ?that <http://data.europa.eu/a4g/ontology#hasPaymentInformation> ?this .}" ] .

epo-shape:epo-pay-RemittanceAdvice-epo-pay-hasPaymentOrderReference a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:pay-shape ;
    sh:description "Reference to the Payment Order." ;
    sh:maxCount 1 ;
    sh:name "Has payment order reference" ;
    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
    sh:path epo:hasPaymentOrderReference .

epo-shape:epo-pay-RemittanceAdvice-epo-pay-hasTotalCreditAmount a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:pay-shape ;
    sh:class epo:MonetaryValue ;
    sh:description "Relation indicating the overall Monetary Value that reduces the amount owed." ;
    sh:maxCount 1 ;
    sh:name "Has total credit amount" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasTotalCreditAmount ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasTotalCreditAmount> ?that . ?that <http://data.europa.eu/a4g/ontology#hasTotalCreditAmount> ?this .}" ] .

epo-shape:epo-pay-RemittanceAdvice-epo-pay-hasTotalDebitAmount a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:pay-shape ;
    sh:class epo:MonetaryValue ;
    sh:description "Relation indicating the overall Monetary Value that increases the amount owed." ;
    sh:maxCount 1 ;
    sh:name "Has total debit amount" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasTotalDebitAmount ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasTotalDebitAmount> ?that . ?that <http://data.europa.eu/a4g/ontology#hasTotalDebitAmount> ?this .}" ] .

epo-shape:epo-pay-RemittanceAdvice-epo-pay-hasTotalPaymentAmount a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:pay-shape ;
    sh:class epo:MonetaryValue ;
    sh:description "Relation indicating the overall paid Monetary Value." ;
    sh:maxCount 1 ;
    sh:name "Has total payment amount" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasTotalPaymentAmount ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasTotalPaymentAmount> ?that . ?that <http://data.europa.eu/a4g/ontology#hasTotalPaymentAmount> ?this .}" ] .

epo-shape:epo-pay-RemittanceAdvice-epo-specifiesBuyer a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:pay-shape ;
    sh:class epo:Buyer ;
    sh:description "Relation indicating that the instance of the concept involves the Buyer." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Specifies buyer" ;
