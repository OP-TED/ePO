pay-shape:epo-pay-PaymentInformationShape a sh:NodeShape ;
    rdfs:label "Payment Information" ;
    rdfs:comment "Information about a remittance." ;
    rdfs:isDefinedBy pay-shape:pay-shape ;
    sh:property pay-shape:epo-pay-PaymentInformation-epo-pay-hasPaymentDate,
        pay-shape:epo-pay-PaymentInformation-epo-pay-hasPaymentIdentifier,
        pay-shape:epo-pay-PaymentInformation-epo-pay-hasPaymentMeansInformation ;
    sh:targetClass :PaymentInformation .

pay-shape:epo-pay-RemittanceAdviceLineShape a sh:NodeShape ;
    rdfs:label "Remittance Advice Line" ;
    rdfs:comment "Details concerning a given Invoice from the Remittance Advice." ;
    rdfs:isDefinedBy pay-shape:pay-shape ;
    sh:property pay-shape:epo-pay-RemittanceAdviceLine-epo-inv-refersToInvoice,
        pay-shape:epo-pay-RemittanceAdviceLine-epo-pay-hasBalanceAmount,
        pay-shape:epo-pay-RemittanceAdviceLine-epo-pay-hasCreditAmount,
        pay-shape:epo-pay-RemittanceAdviceLine-epo-pay-hasDebitAmount ;
    sh:targetClass :RemittanceAdviceLine .

pay-shape:epo-pay-RemittanceAdviceShape a sh:NodeShape ;
    rdfs:label "Remittance Advice" ;
    rdfs:comment "Document sent by the Buyer to the Seller, informing about the payment made." ;
    rdfs:isDefinedBy pay-shape:pay-shape ;
    sh:property pay-shape:epo-pay-RemittanceAdvice-epo-inv-specifiesPayee,
        pay-shape:epo-pay-RemittanceAdvice-epo-pay-comprisesRemittanceAdviceLine,
        pay-shape:epo-pay-RemittanceAdvice-epo-pay-hasPayerReference,
        pay-shape:epo-pay-RemittanceAdvice-epo-pay-hasPaymentInformation,
        pay-shape:epo-pay-RemittanceAdvice-epo-pay-hasPaymentOrderReference,
        pay-shape:epo-pay-RemittanceAdvice-epo-pay-hasTotalCreditAmount,
        pay-shape:epo-pay-RemittanceAdvice-epo-pay-hasTotalDebitAmount,
        pay-shape:epo-pay-RemittanceAdvice-epo-pay-hasTotalPaymentAmount,
        pay-shape:epo-pay-RemittanceAdvice-epo-specifiesBuyer,
        pay-shape:epo-pay-RemittanceAdvice-epo-specifiesSeller ;
    sh:targetClass :RemittanceAdvice .

pay-shape:epo-pay-PaymentInformation-epo-pay-hasPaymentDate a sh:PropertyShape ;
    rdfs:isDefinedBy pay-shape:pay-shape ;
    sh:description "The date of the Payment." ;
    sh:maxCount 1 ;
    sh:name "Has payment date" ;
    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
    sh:path :hasPaymentDate .

pay-shape:epo-pay-PaymentInformation-epo-pay-hasPaymentIdentifier a sh:PropertyShape ;
    rdfs:isDefinedBy pay-shape:pay-shape ;
    sh:class adms:Identifier ;
    sh:description "Relation indicating the Identifier of the Payment." ;
    sh:maxCount 1 ;
    sh:name "Has payment identifier" ;
    sh:path :hasPaymentIdentifier ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasPaymentIdentifier> ?that . ?that <http://data.europa.eu/a4g/ontology#hasPaymentIdentifier> ?this .}" ] .

pay-shape:epo-pay-PaymentInformation-epo-pay-hasPaymentMeansInformation a sh:PropertyShape ;
    rdfs:isDefinedBy pay-shape:pay-shape ;
    sh:class :PaymentInstructionsInformation ;
    sh:description "Relation indicating the Payment Instruction Information." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Has payment means information" ;
    sh:path :hasPaymentMeansInformation ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasPaymentMeansInformation> ?that . ?that <http://data.europa.eu/a4g/ontology#hasPaymentMeansInformation> ?this .}" ] .

pay-shape:epo-pay-RemittanceAdvice-epo-inv-specifiesPayee a sh:PropertyShape ;
    rdfs:isDefinedBy pay-shape:pay-shape ;
    sh:class :Payee ;
    sh:description "Relation indicating that the instance of the concept involves the Payee." ;
    sh:maxCount 1 ;
    sh:name "Specifies payee" ;
    sh:path :specifiesPayee ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#specifiesPayee> ?that . ?that <http://data.europa.eu/a4g/ontology#specifiesPayee> ?this .}" ] .

pay-shape:epo-pay-RemittanceAdvice-epo-pay-comprisesRemittanceAdviceLine a sh:PropertyShape ;
    rdfs:isDefinedBy pay-shape:pay-shape ;
    sh:class :RemittanceAdviceLine ;
    sh:description "Incorporates Remittance Advice Line." ;
    sh:minCount 1 ;
    sh:name "Comprises remittance advice line" ;
    sh:path :comprisesRemittanceAdviceLine ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#comprisesRemittanceAdviceLine> ?that . ?that <http://data.europa.eu/a4g/ontology#comprisesRemittanceAdviceLine> ?this .}" ] .

pay-shape:epo-pay-RemittanceAdvice-epo-pay-hasPayerReference a sh:PropertyShape ;
    rdfs:isDefinedBy pay-shape:pay-shape ;
    sh:description "Reference to the Payer." ;
    sh:maxCount 1 ;
    sh:name "Has payer reference" ;
    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
    sh:path :hasPayerReference .

pay-shape:epo-pay-RemittanceAdvice-epo-pay-hasPaymentInformation a sh:PropertyShape ;
    rdfs:isDefinedBy pay-shape:pay-shape ;
    sh:class :PaymentInformation ;
    sh:description "Relation indicating the Payment Information." ;
    sh:maxCount 1 ;
    sh:name "Has payment information" ;
    sh:path :hasPaymentInformation ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasPaymentInformation> ?that . ?that <http://data.europa.eu/a4g/ontology#hasPaymentInformation> ?this .}" ] .

