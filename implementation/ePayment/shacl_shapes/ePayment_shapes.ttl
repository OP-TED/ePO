epo-shape:pay-shape a owl:Ontology ;
    rdfs:label "eProcurement Ontology Payment - core shapes"@en ;
    dcterms:created "2021-06-01"^^xsd:date ;
    dcterms:description "The eProcurement Ontology Payment core shapes provides the generic datashape specifications for the eProcurement Ontology Payment core."@en ;
    dcterms:issued "2025-10-10"^^xsd:date ;
    dcterms:license "© European Union, 2014. Unless otherwise noted, the reuse of the Ontology is authorised under the European Union Public Licence v1.2 (https://eupl.eu/)." ;
    dcterms:publisher "http://publications.europa.eu/resource/authority/corporate-body/PUBL" ;
    dcterms:title "eProcurement Ontology Payment - core shapes"@en ;
    vann:preferredNamespacePrefix "epo" ;
    vann:preferredNamespaceUri "http://data.europa.eu/a4g/ontology#" ;
    rdfs:comment "This version is automatically generated from ePayment.xml on 2025-10-10" ;
    rdfs:seeAlso <https://docs.ted.europa.eu/home/index.html>,
        <https://github.com/OP-TED/ePO/releases>,
        <https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology/about>,
        <https://op.europa.eu/en/web/eu-vocabularies/e-procurement> ;
    owl:imports epo-shape:acc-shape,
        epo-shape:awa-shape,
        epo-shape:cat-shape,
        epo-shape:con-shape,
        epo-shape:core-shape,
        epo-shape:eva-shape,
        epo-shape:ful-shape,
        epo-shape:inv-shape,
        epo-shape:not-shape,
        epo-shape:ord-shape,
        epo-shape:qua-shape,
        epo-shape:req-shape,
        epo-shape:sub-shape ;
    owl:incompatibleWith "4.2.0" ;
    owl:priorVersion "http://data.europa.eu/a4g/data-shape#pay-shape-5.1.0" ;
    owl:versionIRI epo-shape:pay-shape-5.2.0 ;
    owl:versionInfo "5.2.0" .

