@prefix : <http://data.europa.eu/a4g/ontology#> .
@prefix cccev: <http://data.europa.eu/m8g/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eli: <http://data.europa.eu/eli/ontology#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:PaymentInformation a owl:Class ;
    rdfs:isDefinedBy :pay ;
    rdfs:subClassOf :InformationHub ;
    skos:definition "Information about a remittance."@en ;
    skos:prefLabel "Payment Information"@en .

:RemittanceAdvice a owl:Class ;
    rdfs:isDefinedBy :pay ;
    rdfs:subClassOf :PostAwardDocument ;
    skos:definition "Document sent by the Buyer to the Seller, informing about the payment made."@en ;
    skos:prefLabel "Remittance Advice"@en .

:RemittanceAdviceLine a owl:Class ;
    rdfs:isDefinedBy :pay ;
    rdfs:subClassOf :Line ;
    skos:definition "Details concerning a given Invoice from the Remittance Advice."@en ;
    skos:prefLabel "Remittance Advice Line"@en .

:comprisesRemittanceAdviceLine a owl:ObjectProperty ;
    rdfs:isDefinedBy :pay ;
    skos:definition "Incorporates Remittance Advice Line."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "comprises Remittance Advice Line"@en .

:hasBalanceAmount a owl:ObjectProperty ;
    rdfs:isDefinedBy :pay ;
    skos:definition "Relation indicating the outstanding amount that remains unpaid or unsettled."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "has Balance Amount"@en .

:hasCreditAmount a owl:ObjectProperty ;
    rdfs:isDefinedBy :pay ;
    skos:definition "Relation indicating the Monetary Value that reduces the amount owed."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "has Credit Amount"@en .

:hasDebitAmount a owl:ObjectProperty ;
    rdfs:isDefinedBy :pay ;
    skos:definition "Relation indicating the Monetary Value that increases the amount owed."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "has Debit Amount"@en .

:hasPayerReference a owl:DatatypeProperty ;
    rdfs:isDefinedBy :pay ;
    skos:definition "Reference to the Payer. (epo-pay:RemittanceAdvice)"@en ;
    skos:historyNote "WG approval 25/09/2026"@en ;
    skos:prefLabel "has Payer Reference"@en .

:hasPaymentDate a owl:DatatypeProperty ;
    rdfs:isDefinedBy :pay ;
    skos:definition "The date of the Payment. (epo-pay:PaymentInformation)"@en ;
    skos:historyNote "WG approval 25/09/2026"@en ;
    skos:prefLabel "has Payment Date"@en .

:hasPaymentIdentifier a owl:ObjectProperty ;
    rdfs:isDefinedBy :pay ;
    skos:definition "Relation indicating the Identifier of the Payment."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "has Payment Identifier"@en .

:hasPaymentInformation a owl:ObjectProperty ;
    rdfs:isDefinedBy :pay ;
    skos:definition "Relation indicating the Payment Information."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "has Payment Information"@en .

:hasPaymentMeansInformation a owl:ObjectProperty ;
    rdfs:isDefinedBy :pay ;
    skos:definition "Relation indicating the Payment Instruction Information."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "has Payment Means Information"@en .

:hasPaymentOrderReference a owl:DatatypeProperty ;
    rdfs:isDefinedBy :pay ;
    skos:definition "Reference to the Payment Order. (epo-pay:RemittanceAdvice)"@en ;
    skos:historyNote "WG approval 25/09/2026"@en ;
    skos:prefLabel "has Payment Order Reference"@en .

:hasTotalCreditAmount a owl:ObjectProperty ;
    rdfs:isDefinedBy :pay ;
    skos:definition "Relation indicating the overall Monetary Value that reduces the amount owed."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "has Total Credit Amount"@en .

:hasTotalDebitAmount a owl:ObjectProperty ;
    rdfs:isDefinedBy :pay ;
    skos:definition "Relation indicating the overall Monetary Value that increases the amount owed."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "has Total Debit Amount"@en .

:hasTotalPaymentAmount a owl:ObjectProperty ;
    rdfs:isDefinedBy :pay ;
    skos:definition "Relation indicating the overall paid Monetary Value."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "has Total Payment Amount"@en .

:refersToInvoice a owl:ObjectProperty ;
    rdfs:isDefinedBy :pay ;
    skos:definition "Reference to an Invoice."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "refers To Invoice"@en .

:specifiesBuyer a owl:ObjectProperty ;
    rdfs:isDefinedBy :pay ;
    skos:definition "Relation indicating that the instance of the concept involves the Buyer."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "specifies Buyer"@en .

:specifiesPayee a owl:ObjectProperty ;
    rdfs:isDefinedBy :pay ;
    skos:definition "Relation indicating that the instance of the concept involves the Payee."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "specifies Payee"@en .

:specifiesSeller a owl:ObjectProperty ;
    rdfs:isDefinedBy :pay ;
    skos:definition "Relation indicating that the instance of the concept involves the Seller."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "specifies Seller"@en .

:pay a owl:Ontology ;
    rdfs:label "eProcurement Ontology Payment - core"@en ;
    dcterms:created "2021-06-01"^^xsd:date ;
    dcterms:description "The eProcurement Ontology Payment core describes the concepts and properties representing the European Public Procurement Payment domain. The provision of these semantics offers the basis for a common understanding of the domain for all stakeholders ensuring the quality of data exchange and transparency. The ontology restrictions are published in a separate artefact."@en ;
    dcterms:issued "2025-10-10"^^xsd:date ;
    dcterms:license "© European Union, 2014. Unless otherwise noted, the reuse of the Ontology is authorised under the European Union Public Licence v1.2 (https://eupl.eu/)." ;
    dcterms:publisher "http://publications.europa.eu/resource/authority/corporate-body/PUBL" ;
    dcterms:title "eProcurement Ontology Payment - core"@en ;
    vann:preferredNamespacePrefix "epo" ;
    vann:preferredNamespaceUri "http://data.europa.eu/a4g/ontology#" ;
    rdfs:comment "This version is automatically generated from ePayment.xml on 2025-10-10" ;
    rdfs:seeAlso <https://docs.ted.europa.eu/home/index.html>,
        <https://github.com/OP-TED/ePO/releases>,
        <https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology/about>,
        <https://op.europa.eu/en/web/eu-vocabularies/e-procurement> ;
    owl:imports :cat,
        :core,
        :inv,
        :ord,
        eli:,
        cccev:,
        dcterms:,
        skos:,
        <http://www.w3.org/2006/time>,
        <http://www.w3.org/ns/adms>,
        <http://www.w3.org/ns/locn>,
        org:,
        <http://www.w3.org/ns/person> ;
    owl:incompatibleWith "4.2.0" ;
    owl:priorVersion "http://data.europa.eu/a4g/ontology#pay-5.1.0" ;
    owl:versionIRI :pay-5.2.0 ;
    owl:versionInfo "5.2.0" .

