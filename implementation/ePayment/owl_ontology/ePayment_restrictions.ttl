@prefix : <http://data.europa.eu/a4g/ontology#> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix cccev: <http://data.europa.eu/m8g/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eli: <http://data.europa.eu/eli/ontology#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:pay-restriction a owl:Ontology ;
    rdfs:label "eProcurement Ontology Payment - core restrictions"@en ;
    dcterms:created "2021-06-01"^^xsd:date ;
    dcterms:description "The eProcurement Ontology Payment core restrictions provides the restrictions and the inference-related specifications on the concepts and properties in the eProcurement Ontology Payment core."@en ;
    dcterms:issued "2025-10-10"^^xsd:date ;
    dcterms:license "© European Union, 2014. Unless otherwise noted, the reuse of the Ontology is authorised under the European Union Public Licence v1.2 (https://eupl.eu/)." ;
    dcterms:publisher "http://publications.europa.eu/resource/authority/corporate-body/PUBL" ;
    dcterms:title "eProcurement Ontology Payment - core restrictions"@en ;
    vann:preferredNamespacePrefix "epo" ;
    vann:preferredNamespaceUri "http://data.europa.eu/a4g/ontology#" ;
    rdfs:comment """This version is automatically generated from ePayment.xml on 
                2025-10-10""" ;
    rdfs:seeAlso <https://docs.ted.europa.eu/home/index.html>,
        <https://github.com/OP-TED/ePO/releases>,
        <https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology/about>,
        <https://op.europa.eu/en/web/eu-vocabularies/e-procurement> ;
    owl:imports :cat,
        :core,
        :inv,
        :ord,
        :pay,
        eli:,
        cccev:,
        dcterms:,
        skos:,
        <http://www.w3.org/2006/time>,
        <http://www.w3.org/ns/adms>,
        <http://www.w3.org/ns/locn>,
        org:,
        <http://www.w3.org/ns/person> ;
    owl:incompatibleWith "4.2.0" ;
    owl:priorVersion "http://data.europa.eu/a4g/ontology#pay-restriction-5.1.0" ;
    owl:versionIRI :pay-restriction-5.2.0 ;
    owl:versionInfo "5.2.0" .

:comprisesRemittanceAdviceLine rdfs:domain :RemittanceAdvice ;
    rdfs:range :RemittanceAdviceLine .

:hasBalanceAmount rdfs:domain :RemittanceAdviceLine ;
    rdfs:range :MonetaryValue .

:hasCreditAmount rdfs:domain :RemittanceAdviceLine ;
    rdfs:range :MonetaryValue .

:hasDebitAmount rdfs:domain :RemittanceAdviceLine ;
    rdfs:range :MonetaryValue .

:hasPayerReference rdfs:domain :RemittanceAdvice ;
    rdfs:range rdf:PlainLiteral .

:hasPaymentDate rdfs:domain :PaymentInformation ;
    rdfs:range rdf:PlainLiteral .

:hasPaymentIdentifier rdfs:domain :PaymentInformation ;
    rdfs:range adms:Identifier .

:hasPaymentInformation rdfs:domain :RemittanceAdvice ;
    rdfs:range :PaymentInformation .

:hasPaymentMeansInformation a owl:FunctionalProperty ;
    rdfs:domain :PaymentInformation ;
    rdfs:range :PaymentInstructionsInformation .

:hasPaymentOrderReference rdfs:domain :RemittanceAdvice ;
    rdfs:range rdf:PlainLiteral .

:hasTotalCreditAmount rdfs:domain :RemittanceAdvice ;
    rdfs:range :MonetaryValue .

:hasTotalDebitAmount rdfs:domain :RemittanceAdvice ;
    rdfs:range :MonetaryValue .

:hasTotalPaymentAmount rdfs:domain :RemittanceAdvice ;
    rdfs:range :MonetaryValue .

:refersToInvoice rdfs:domain :RemittanceAdviceLine ;
    rdfs:range :Invoice .

:specifiesBuyer a owl:FunctionalProperty ;
    rdfs:domain :RemittanceAdvice ;
    rdfs:range :Buyer .

:specifiesPayee rdfs:domain :RemittanceAdvice ;
    rdfs:range :Payee .

:specifiesSeller a owl:FunctionalProperty ;
    rdfs:domain :RemittanceAdvice ;
    rdfs:range :Seller .

:PaymentInformation rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :hasPaymentMeansInformation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasPaymentIdentifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasPaymentDate ] .

:RemittanceAdviceLine rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasDebitAmount ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasCreditAmount ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :refersToInvoice ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasBalanceAmount ] .

:RemittanceAdvice rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :specifiesBuyer ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :specifiesPayee ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasTotalCreditAmount ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasPayerReference ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasTotalPaymentAmount ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasPaymentOrderReference ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty :comprisesRemittanceAdviceLine ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasPaymentInformation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasTotalDebitAmount ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :specifiesSeller ] .

