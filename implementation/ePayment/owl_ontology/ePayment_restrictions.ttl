@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix epo: <http://data.europa.eu/a4g/ontology#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

epo:pay-restriction a owl:Ontology ;
    rdfs:label "eProcurement Ontology Payment - core restrictions"@en ;
    dcterms:created "2021-06-01"^^xsd:date ;
    dcterms:description "The eProcurement Ontology Payment core restrictions provides the restrictions and the inference-related specifications on the concepts and properties in the eProcurement Ontology Payment core."@en ;
    dcterms:issued "2025-06-04"^^xsd:date ;
    dcterms:license "© European Union, 2014. Unless otherwise noted, the reuse of the Ontology is authorised under the European Union Public Licence v1.2 (https://eupl.eu/)." ;
    dcterms:publisher "http://publications.europa.eu/resource/authority/corporate-body/PUBL" ;
    dcterms:title "eProcurement Ontology Payment - core restrictions"@en ;
    vann:preferredNamespacePrefix "epo" ;
    vann:preferredNamespaceUri "http://data.europa.eu/a4g/ontology#" ;
    rdfs:comment """This version is automatically generated from ePayment.xml on 
                2025-06-04""" ;
    rdfs:seeAlso <https://docs.ted.europa.eu/home/index.html>,
        <https://github.com/OP-TED/ePO/releases>,
        <https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology/about>,
        <https://op.europa.eu/en/web/eu-vocabularies/e-procurement> ;
    owl:imports epo:cat,
        epo:core,
        epo:inv,
        epo:ord,
        epo:pay,
        <http://data.europa.eu/eli/ontology#>,
        <http://data.europa.eu/m8g/>,
        dcterms:,
        skos:,
        <http://www.w3.org/2006/time>,
        <http://www.w3.org/ns/adms>,
        <http://www.w3.org/ns/locn>,
        org:,
        <http://www.w3.org/ns/person> ;
    owl:incompatibleWith "4.2.0" ;
    owl:priorVersion "http://data.europa.eu/a4g/ontology#pay-restriction-5.0.0" ;
    owl:versionIRI epo:pay-restriction-5.1.0 ;
    owl:versionInfo "5.1.0" .

epo:comprisesRemittanceAdviceLine rdfs:domain epo:RemittanceAdvice ;
    rdfs:range epo:RemittanceAdviceLine .

epo:hasBalanceAmount rdfs:domain epo:RemittanceAdviceLine ;
    rdfs:range epo:MonetaryValue .

epo:hasCreditAmount rdfs:domain epo:RemittanceAdviceLine ;
    rdfs:range epo:MonetaryValue .

epo:hasDebitAmount rdfs:domain epo:RemittanceAdviceLine ;
    rdfs:range epo:MonetaryValue .

epo:hasPayerReference rdfs:domain epo:RemittanceAdvice ;
    rdfs:range rdf:PlainLiteral .

epo:hasPaymentDate rdfs:domain epo:PaymentInformation ;
    rdfs:range rdf:PlainLiteral .

epo:hasPaymentIdentifier rdfs:domain epo:PaymentInformation ;
    rdfs:range adms:Identifier .

epo:hasPaymentInformation rdfs:domain epo:RemittanceAdvice ;
    rdfs:range epo:PaymentInformation .

epo:hasPaymentMeansInformation a owl:FunctionalProperty ;
    rdfs:domain epo:PaymentInformation ;
    rdfs:range epo:PaymentInstructionsInformation .

epo:hasPaymentOrderReference rdfs:domain epo:RemittanceAdvice ;
    rdfs:range rdf:PlainLiteral .

epo:hasTotalCreditAmount rdfs:domain epo:RemittanceAdvice ;
    rdfs:range epo:MonetaryValue .

epo:hasTotalDebitAmount rdfs:domain epo:RemittanceAdvice ;
    rdfs:range epo:MonetaryValue .

epo:hasTotalPaymentAmount rdfs:domain epo:RemittanceAdvice ;
    rdfs:range epo:MonetaryValue .

epo:refersToInvoice rdfs:domain epo:RemittanceAdviceLine ;
    rdfs:range epo:Invoice .

epo:specifiesBuyer a owl:FunctionalProperty ;
    rdfs:domain epo:RemittanceAdvice ;
    rdfs:range epo:Buyer .

epo:specifiesPayee rdfs:domain epo:RemittanceAdvice ;
    rdfs:range epo:Payee .

epo:specifiesSeller a owl:FunctionalProperty ;
    rdfs:domain epo:RemittanceAdvice ;
    rdfs:range epo:Seller .

epo:PaymentInformation rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:hasPaymentDate ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:hasPaymentMeansInformation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:hasPaymentIdentifier ] .

epo:RemittanceAdviceLine rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:hasBalanceAmount ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:refersToInvoice ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:hasCreditAmount ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:hasDebitAmount ] .

epo:RemittanceAdvice rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:specifiesBuyer ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:hasTotalPaymentAmount ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:specifiesSeller ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:hasPaymentInformation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:specifiesPayee ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:hasPaymentOrderReference ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:hasPayerReference ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:hasTotalDebitAmount ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty epo:comprisesRemittanceAdviceLine ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:hasTotalCreditAmount ] .

