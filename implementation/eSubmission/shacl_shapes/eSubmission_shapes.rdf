  <rdf:Description rdf:about="http://data.europa.eu/a4g/data-shape#epo-sub-ESPDShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <sh:targetClass rdf:resource="http://data.europa.eu/a4g/ontology#ESPD"/>
    <rdfs:label>ESPD</rdfs:label>
    <rdfs:comment>A self-declaration of an economic operator, stating that it does not fall under the Exclusion Grounds and that it meets the Selection Criteria for a specific procurement.</rdfs:comment>
