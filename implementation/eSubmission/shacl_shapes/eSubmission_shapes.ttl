@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix epo: <http://data.europa.eu/a4g/ontology#> .
@prefix epo-shape: <http://data.europa.eu/a4g/data-shape#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

epo-shape:epo-sub-DocumentaryEvidenceShape a sh:NodeShape ;
    rdfs:label "Documentary Evidence" ;
    rdfs:comment "An Evidence submitted by an Economic Operator to prove compliance with legal, technical or financial requirements, or inapplicability of exclusion grounds in a Procurement Procedure." ;
    rdfs:isDefinedBy epo-shape:sub-shape ;
    sh:targetClass epo:DocumentaryEvidence .

epo-shape:epo-sub-ESPDShape a sh:NodeShape ;
    rdfs:label "ESPD" ;
    rdfs:comment "A self-declaration of an economic operator, stating that it does not fall under the Exclusion Grounds and that it meets the Selection Criteria for a specific procurement." ;
    rdfs:isDefinedBy epo-shape:sub-shape ;
    sh:property epo-shape:epo-sub-ESPD-epo-sub-isContainedInTender,
        epo-shape:epo-sub-ESPD-epo-sub-providesInformationOn,
        epo-shape:epo-sub-ESPD-epo-sub-relatesToESPDRequest,
        epo-shape:epo-sub-ESPD-epo-sub-specifiesResponse ;
    sh:targetClass epo:ESPD .

epo-shape:epo-sub-EvidenceInformationShape a sh:NodeShape ;
    rdfs:label "Evidence Information" ;
    rdfs:comment "Information about a Certificate." ;
    rdfs:isDefinedBy epo-shape:sub-shape ;
    sh:property epo-shape:epo-sub-EvidenceInformation-epo-sub-coversAllSelectionCriteria,
        epo-shape:epo-sub-EvidenceInformation-epo-sub-summarisesInformationAboutEvidence ;
    sh:targetClass epo:EvidenceInformation .

epo-shape:epo-sub-LegalRepresentativeShape a sh:NodeShape ;
    rdfs:label "Legal Representative" ;
    rdfs:comment "The Role of an Agent that can represent an Organization." ;
    rdfs:isDefinedBy epo-shape:sub-shape ;
    sh:property epo-shape:epo-sub-LegalRepresentative-epo-actsOnBehalfOf,
        epo-shape:epo-sub-LegalRepresentative-epo-sub-hasMandate,
        epo-shape:epo-sub-LegalRepresentative-epo-sub-hasPowerOfAttorney ;
    sh:targetClass epo:LegalRepresentative .

epo-shape:epo-sub-MandateShape a sh:NodeShape ;
    rdfs:label "Mandate" ;
    rdfs:comment "An authorization to act as a representative of an Organization." ;
    rdfs:isDefinedBy epo-shape:sub-shape ;
    sh:targetClass epo:Mandate .

epo-shape:epo-sub-OrganisationInformationSummaryShape a sh:NodeShape ;
    rdfs:label "Organisation Information Summary" ;
    rdfs:comment "Information about the specific features or characteristics that qualify an economic operator to take part in a tendering process." ;
    rdfs:isDefinedBy epo-shape:sub-shape ;
    sh:property epo-shape:epo-sub-OrganisationInformationSummary-epo-sub-concernsOrganisation,
        epo-shape:epo-sub-OrganisationInformationSummary-epo-sub-hasBusinessClassificationDescription,
        epo-shape:epo-sub-OrganisationInformationSummary-epo-sub-providesOrganisationCompletedTaskDescription,
        epo-shape:epo-sub-OrganisationInformationSummary-epo-sub-providesOrganisationEmployeeQuantity,
        epo-shape:epo-sub-OrganisationInformationSummary-epo-sub-providesOrganisationFinancialCapability ;
    sh:targetClass epo:OrganisationInformationSummary .

epo-shape:epo-sub-PowerOfAttorneyShape a sh:NodeShape ;
    rdfs:label "Power Of Attorney" ;
    rdfs:comment "A legal document that grants someone the authority to make decisions on behalf of an Organization." ;
    rdfs:isDefinedBy epo-shape:sub-shape ;
    sh:targetClass epo:PowerOfAttorney .

epo-shape:epo-sub-ResponseShape a sh:NodeShape ;
    rdfs:label "Response" ;
    rdfs:comment "An answer given to a question that is part of an ESPD Request." ;
    rdfs:isDefinedBy epo-shape:sub-shape ;
    sh:property epo-shape:epo-sub-Response-epo-sub-answersQuestion,
        epo-shape:epo-sub-Response-epo-sub-isReinforcedBy,
        epo-shape:epo-sub-Response-epo-sub-refersToApplicablePeriod ;
    sh:targetClass epo:Response .

epo-shape:epo-sub-ESPD-epo-sub-isContainedInTender a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:sub-shape ;
    sh:class epo:Tender ;
    sh:description "Relation indicating that the instance of the concept is part of a Tender." ;
    sh:name "Is contained in tender" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:isContainedInTender ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#isContainedInTender> ?that . ?that <http://data.europa.eu/a4g/ontology#isContainedInTender> ?this .}" ] .

epo-shape:epo-sub-ESPD-epo-sub-providesInformationOn a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:sub-shape ;
    sh:class org:Organization ;
    sh:description "Offers information about an instance of a concept." ;
    sh:name "Provides information on" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:providesInformationOn ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#providesInformationOn> ?that . ?that <http://data.europa.eu/a4g/ontology#providesInformationOn> ?this .}" ] .

epo-shape:epo-sub-ESPD-epo-sub-relatesToESPDRequest a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:sub-shape ;
    sh:class epo:ESPDRequest ;
    sh:description "Is about an European Single Procurement Document (ESPD) Request." ;
    sh:maxCount 1 ;
    sh:name "Relates to ESPD request" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:relatesToESPDRequest ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#relatesToESPDRequest> ?that . ?that <http://data.europa.eu/a4g/ontology#relatesToESPDRequest> ?this .}" ] .

epo-shape:epo-sub-ESPD-epo-sub-specifiesResponse a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:sub-shape ;
    sh:class epo:Response ;
    sh:description "Relation indicating that an ESPD Response contains a Response." ;
    sh:minCount 1 ;
    sh:name "Specifies response" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:specifiesResponse ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#specifiesResponse> ?that . ?that <http://data.europa.eu/a4g/ontology#specifiesResponse> ?this .}" ] .

epo-shape:epo-sub-EvidenceInformation-epo-sub-coversAllSelectionCriteria a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:sub-shape ;
    sh:datatype xsd:boolean ;
    sh:description "Indicator that the Certificate proves whether the Organization fulfils all Selection Criteria." ;
    sh:maxCount 1 ;
    sh:name "Covers all selection criteria" ;
    sh:path epo:coversAllSelectionCriteria .

epo-shape:epo-sub-EvidenceInformation-epo-sub-summarisesInformationAboutEvidence a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:sub-shape ;
    sh:class <http://data.europa.eu/m8g/Evidence> ;
    sh:description "Relation indicating the Certificate that the information refers to." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Summarises information about evidence" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:summarisesInformationAboutEvidence ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#summarisesInformationAboutEvidence> ?that . ?that <http://data.europa.eu/a4g/ontology#summarisesInformationAboutEvidence> ?this .}" ] .

epo-shape:epo-sub-LegalRepresentative-epo-actsOnBehalfOf a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:sub-shape ;
    sh:class epo:OfferingParty ;
    sh:maxCount 1 ;
    sh:name "Acts on behalf of" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:actsOnBehalfOf ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#actsOnBehalfOf> ?that . ?that <http://data.europa.eu/a4g/ontology#actsOnBehalfOf> ?this .}" ] .

epo-shape:epo-sub-LegalRepresentative-epo-sub-hasMandate a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:sub-shape ;
    sh:class epo:Mandate ;
    sh:description "Relation indicating that a Legal Representative has a Mandate." ;
    sh:name "Has mandate" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasMandate ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasMandate> ?that . ?that <http://data.europa.eu/a4g/ontology#hasMandate> ?this .}" ] .

epo-shape:epo-sub-LegalRepresentative-epo-sub-hasPowerOfAttorney a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:sub-shape ;
    sh:class epo:PowerOfAttorney ;
    sh:description "Relation indicating that a Legal Representative has a Power of Attorney." ;
    sh:maxCount 1 ;
    sh:name "Has power of attorney" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasPowerOfAttorney ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasPowerOfAttorney> ?that . ?that <http://data.europa.eu/a4g/ontology#hasPowerOfAttorney> ?this .}" ] .

epo-shape:epo-sub-OrganisationInformationSummary-epo-sub-concernsOrganisation a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:sub-shape ;
    sh:class org:Organization ;
    sh:description "Relates to Organization." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Concerns organisation" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:concernsOrganisation ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#concernsOrganisation> ?that . ?that <http://data.europa.eu/a4g/ontology#concernsOrganisation> ?this .}" ] .

epo-shape:epo-sub-OrganisationInformationSummary-epo-sub-hasBusinessClassificationDescription a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:sub-shape ;
    sh:description "Explanatory text about the size of the Business. Additional information: The values of this property may come from the recommended codelist: http://publications.europa.eu/resource/authority/economic-operator-size" ;
    sh:name "Has business classification description" ;
    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
    sh:path epo:hasBusinessClassificationDescription .

epo-shape:epo-sub-OrganisationInformationSummary-epo-sub-providesOrganisationCompletedTaskDescription a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:sub-shape ;
    sh:description "Text describing the works, supplies or services executed, delivered or performed in a procurement project that can be used as an evidence for the classification of the Organization." ;
    sh:maxCount 1 ;
    sh:name "Provides organisation completed task description" ;
    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
    sh:path epo:providesOrganisationCompletedTaskDescription .

epo-shape:epo-sub-OrganisationInformationSummary-epo-sub-providesOrganisationEmployeeQuantity a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:sub-shape ;
    sh:class epo:Quantity ;
    sh:description "The number of people hired by the Organization." ;
    sh:maxCount 1 ;
    sh:name "Provides organisation employee quantity" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:providesOrganisationEmployeeQuantity ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#providesOrganisationEmployeeQuantity> ?that . ?that <http://data.europa.eu/a4g/ontology#providesOrganisationEmployeeQuantity> ?this .}" ] .

epo-shape:epo-sub-OrganisationInformationSummary-epo-sub-providesOrganisationFinancialCapability a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:sub-shape ;
    sh:class epo:MonetaryValue ;
    sh:description "A monetary amount representing the financial capability of the Organization. Additional information: Used to represent the general Turnover of the Organization (for statistical purposes)." ;
    sh:maxCount 1 ;
    sh:name "Provides organisation financial capability" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:providesOrganisationFinancialCapability ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#providesOrganisationFinancialCapability> ?that . ?that <http://data.europa.eu/a4g/ontology#providesOrganisationFinancialCapability> ?this .}" ] .

epo-shape:epo-sub-Response-epo-sub-answersQuestion a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:sub-shape ;
    sh:class <http://data.europa.eu/m8g/InformationRequirement> ;
    sh:description "Relation indicating that the Response replies to a question." ;
    sh:name "Answers question" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:answersQuestion ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#answersQuestion> ?that . ?that <http://data.europa.eu/a4g/ontology#answersQuestion> ?this .}" ] .

epo-shape:epo-sub-Response-epo-sub-isReinforcedBy a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:sub-shape ;
    sh:class <http://data.europa.eu/m8g/Evidence> ;
    sh:description "Relation indicating an Evidence that supports the Response." ;
    sh:name "Is reinforced by" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:isReinforcedBy ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#isReinforcedBy> ?that . ?that <http://data.europa.eu/a4g/ontology#isReinforcedBy> ?this .}" ] .

epo-shape:epo-sub-Response-epo-sub-refersToApplicablePeriod a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:sub-shape ;
    sh:class time:Interval ;
    sh:description "Relation indicating the period to which the Response shall apply." ;
    sh:maxCount 1 ;
    sh:name "Refers to applicable period" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:refersToApplicablePeriod ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#refersToApplicablePeriod> ?that . ?that <http://data.europa.eu/a4g/ontology#refersToApplicablePeriod> ?this .}" ] .

epo-shape:sub-shape a owl:Ontology ;
    rdfs:label "eProcurement Ontology Submission - core shapes"@en ;
    dcterms:created "2021-06-01"^^xsd:date ;
    dcterms:description "The eProcurement Ontology Submission core shapes provides the generic datashape specifications for the eProcurement Ontology Submission core."@en ;
    dcterms:issued "2025-10-10"^^xsd:date ;
    dcterms:license "© European Union, 2014. Unless otherwise noted, the reuse of the Ontology is authorised under the European Union Public Licence v1.2 (https://eupl.eu/)." ;
    dcterms:publisher "http://publications.europa.eu/resource/authority/corporate-body/PUBL" ;
    dcterms:title "eProcurement Ontology Submission - core shapes"@en ;
    vann:preferredNamespacePrefix "epo" ;
    vann:preferredNamespaceUri "http://data.europa.eu/a4g/ontology#" ;
    rdfs:comment "This version is automatically generated from eSubmission.xml on 2025-10-10" ;
    rdfs:seeAlso <https://docs.ted.europa.eu/home/index.html>,
        <https://github.com/OP-TED/ePO/releases>,
        <https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology/about>,
        <https://op.europa.eu/en/web/eu-vocabularies/e-procurement> ;
    owl:imports epo-shape:acc-shape,
        epo-shape:awa-shape,
        epo-shape:cat-shape,
        epo-shape:con-shape,
        epo-shape:core-shape,
        epo-shape:eva-shape,
        epo-shape:ful-shape,
        epo-shape:inv-shape,
        epo-shape:not-shape,
        epo-shape:ord-shape,
        epo-shape:pay-shape,
        epo-shape:qua-shape,
        epo-shape:req-shape ;
    owl:incompatibleWith "4.2.0" ;
    owl:priorVersion "http://data.europa.eu/a4g/data-shape#sub-shape-5.1.0" ;
    owl:versionIRI epo-shape:sub-shape-5.2.0 ;
    owl:versionInfo "5.2.0" .

