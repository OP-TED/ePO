@prefix : <http://data.europa.eu/a4g/ontology#> .
@prefix cccev: <http://data.europa.eu/m8g/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eli: <http://data.europa.eu/eli/ontology#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sub-shape: <http://data.europa.eu/a4g/data-shape#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub-shape:epo-sub-DocumentaryEvidence a sh:NodeShape ;
    rdfs:label "Documentary Evidence" ;
    rdfs:comment "An Evidence submitted by an Economic Operator to prove compliance with legal, technical or financial requirements, or inapplicability of exclusion grounds in a Procurement Procedure." ;
    rdfs:isDefinedBy sub-shape:sub-shape ;
    sh:targetClass :DocumentaryEvidence .

sub-shape:epo-sub-ESPD a sh:NodeShape ;
    rdfs:label "ESPD" ;
    rdfs:comment "A self-declaration of an economic operator, stating that it does not fall under the Exclusion Grounds and that it meets the Selection Criteria for a specific procurement." ;
    rdfs:isDefinedBy sub-shape:sub-shape ;
    sh:property sub-shape:epo-sub-ESPD-epo-sub-isContainedInTender,
        sub-shape:epo-sub-ESPD-epo-sub-providesInformationOn,
        sub-shape:epo-sub-ESPD-epo-sub-relatesToESPDRequest,
        sub-shape:epo-sub-ESPD-epo-sub-specifiesResponse ;
    sh:targetClass :ESPD .

sub-shape:epo-sub-EvidenceInformation a sh:NodeShape ;
    rdfs:label "Evidence Information" ;
    rdfs:comment "Information about a Certificate." ;
    rdfs:isDefinedBy sub-shape:sub-shape ;
    sh:property sub-shape:epo-sub-EvidenceInformation-epo-sub-coversAllSelectionCriteria,
        sub-shape:epo-sub-EvidenceInformation-epo-sub-summarisesInformationAboutEvidence ;
    sh:targetClass :EvidenceInformation .

sub-shape:epo-sub-LegalRepresentative a sh:NodeShape ;
    rdfs:label "Legal Representative" ;
    rdfs:comment "The Role of an Agent that can represent an Organization." ;
    rdfs:isDefinedBy sub-shape:sub-shape ;
    sh:property sub-shape:epo-sub-LegalRepresentative-epo-actsOnBehalfOf,
        sub-shape:epo-sub-LegalRepresentative-epo-sub-hasMandate,
        sub-shape:epo-sub-LegalRepresentative-epo-sub-hasPowerOfAttorney ;
    sh:targetClass :LegalRepresentative .

sub-shape:epo-sub-Mandate a sh:NodeShape ;
    rdfs:label "Mandate" ;
    rdfs:comment "An authorization to act as a representative of an Organization." ;
    rdfs:isDefinedBy sub-shape:sub-shape ;
    sh:targetClass :Mandate .

sub-shape:epo-sub-OrganisationInformationSummary a sh:NodeShape ;
    rdfs:label "Organisation Information Summary" ;
    rdfs:comment "Information about the specific features or characteristics that qualify an economic operator to take part in a tendering process." ;
    rdfs:isDefinedBy sub-shape:sub-shape ;
    sh:property sub-shape:epo-sub-OrganisationInformationSummary-epo-sub-concernsOrganisation,
        sub-shape:epo-sub-OrganisationInformationSummary-epo-sub-hasBusinessClassificationDescription,
        sub-shape:epo-sub-OrganisationInformationSummary-epo-sub-providesOrganisationCompletedTaskDescription,
        sub-shape:epo-sub-OrganisationInformationSummary-epo-sub-providesOrganisationEmployeeQuantity,
        sub-shape:epo-sub-OrganisationInformationSummary-epo-sub-providesOrganisationFinancialCapability ;
    sh:targetClass :OrganisationInformationSummary .

sub-shape:epo-sub-PowerOfAttorney a sh:NodeShape ;
    rdfs:label "Power Of Attorney" ;
    rdfs:comment "A legal document that grants someone the authority to make decisions on behalf of an Organization." ;
    rdfs:isDefinedBy sub-shape:sub-shape ;
    sh:targetClass :PowerOfAttorney .

sub-shape:epo-sub-Response a sh:NodeShape ;
    rdfs:label "Response" ;
    rdfs:comment "An answer given to a question that is part of an ESPD Request." ;
    rdfs:isDefinedBy sub-shape:sub-shape ;
    sh:property sub-shape:epo-sub-Response-epo-sub-answersQuestion,
        sub-shape:epo-sub-Response-epo-sub-isReinforcedBy,
        sub-shape:epo-sub-Response-epo-sub-refersToApplicablePeriod ;
    sh:targetClass :Response .

sub-shape:epo-sub-ESPD-epo-sub-isContainedInTender a sh:PropertyShape ;
    sh:class :Tender ;
    sh:description "Relation indicating that the instance of the concept is part of a Tender." ;
    sh:name "is Contained In Tender" ;
    sh:path :isContainedInTender ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#isContainedInTender> ?that . ?that <http://data.europa.eu/a4g/ontology#isContainedInTender> ?this .}" ] .

sub-shape:epo-sub-ESPD-epo-sub-providesInformationOn a sh:PropertyShape ;
    sh:class org:Organization ;
    sh:description "Offers information about an instance of a concept." ;
    sh:name "provides Information On" ;
    sh:path :providesInformationOn ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#providesInformationOn> ?that . ?that <http://data.europa.eu/a4g/ontology#providesInformationOn> ?this .}" ] .

sub-shape:epo-sub-ESPD-epo-sub-relatesToESPDRequest a sh:PropertyShape ;
    sh:class :ESPDRequest ;
    sh:description "Is about an European Single Procurement Document (ESPD) Request." ;
    sh:maxCount 1 ;
    sh:name "relates To ESPD Request" ;
    sh:path :relatesToESPDRequest ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#relatesToESPDRequest> ?that . ?that <http://data.europa.eu/a4g/ontology#relatesToESPDRequest> ?this .}" ] .

sub-shape:epo-sub-ESPD-epo-sub-specifiesResponse a sh:PropertyShape ;
    sh:class :Response ;
    sh:description "Relation indicating that an ESPD Response contains a Response." ;
    sh:minCount 1 ;
    sh:name "specifies Response" ;
    sh:path :specifiesResponse ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#specifiesResponse> ?that . ?that <http://data.europa.eu/a4g/ontology#specifiesResponse> ?this .}" ] .

sub-shape:epo-sub-EvidenceInformation-epo-sub-coversAllSelectionCriteria a sh:PropertyShape ;
    rdfs:isDefinedBy sub-shape:sub-shape ;
    sh:datatype xsd:boolean ;
    sh:description "Indicator that the Certificate proves whether the Organization fulfils all Selection Criteria." ;
    sh:maxCount 1 ;
    sh:name "covers All Selection Criteria" ;
    sh:path :coversAllSelectionCriteria .

sub-shape:epo-sub-EvidenceInformation-epo-sub-summarisesInformationAboutEvidence a sh:PropertyShape ;
    sh:class cccev:Evidence ;
    sh:description "Relation indicating the Certificate that the information refers to." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "summarises Information About Evidence" ;
    sh:path :summarisesInformationAboutEvidence ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#summarisesInformationAboutEvidence> ?that . ?that <http://data.europa.eu/a4g/ontology#summarisesInformationAboutEvidence> ?this .}" ] .

sub-shape:epo-sub-LegalRepresentative-epo-actsOnBehalfOf a sh:PropertyShape ;
    sh:class :OfferingParty ;
    sh:maxCount 1 ;
    sh:name "acts On Behalf Of" ;
    sh:path :actsOnBehalfOf ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#actsOnBehalfOf> ?that . ?that <http://data.europa.eu/a4g/ontology#actsOnBehalfOf> ?this .}" ] .

sub-shape:epo-sub-LegalRepresentative-epo-sub-hasMandate a sh:PropertyShape ;
    sh:class :Mandate ;
    sh:description "Relation indicating that a Legal Representative has a Mandate." ;
    sh:name "has Mandate" ;
    sh:path :hasMandate ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasMandate> ?that . ?that <http://data.europa.eu/a4g/ontology#hasMandate> ?this .}" ] .

sub-shape:epo-sub-LegalRepresentative-epo-sub-hasPowerOfAttorney a sh:PropertyShape ;
    sh:class :PowerOfAttorney ;
    sh:description "Relation indicating that a Legal Representative has a Power of Attorney." ;
    sh:maxCount 1 ;
    sh:name "has Power Of Attorney" ;
    sh:path :hasPowerOfAttorney ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasPowerOfAttorney> ?that . ?that <http://data.europa.eu/a4g/ontology#hasPowerOfAttorney> ?this .}" ] .

sub-shape:epo-sub-OrganisationInformationSummary-epo-sub-concernsOrganisation a sh:PropertyShape ;
    sh:class org:Organization ;
    sh:description "Relates to Organization." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "concerns Organisation" ;
    sh:path :concernsOrganisation ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#concernsOrganisation> ?that . ?that <http://data.europa.eu/a4g/ontology#concernsOrganisation> ?this .}" ] .

sub-shape:epo-sub-OrganisationInformationSummary-epo-sub-hasBusinessClassificationDescription a sh:PropertyShape ;
    rdfs:isDefinedBy sub-shape:sub-shape ;
    sh:description "Explanatory text about the size of the Business. Additional information: The values of this property may come from the recommended codelist: http://publications.europa.eu/resource/authority/economic-operator-size" ;
    sh:name "has Business Classification Description" ;
    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
    sh:path :hasBusinessClassificationDescription .

sub-shape:epo-sub-OrganisationInformationSummary-epo-sub-providesOrganisationCompletedTaskDescription a sh:PropertyShape ;
    rdfs:isDefinedBy sub-shape:sub-shape ;
    sh:description "Text describing the works, supplies or services executed, delivered or performed in a procurement project that can be used as an evidence for the classification of the Organization." ;
    sh:maxCount 1 ;
    sh:name "provides Organisation Completed Task Description" ;
    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
    sh:path :providesOrganisationCompletedTaskDescription .

sub-shape:epo-sub-OrganisationInformationSummary-epo-sub-providesOrganisationEmployeeQuantity a sh:PropertyShape ;
    sh:class :Quantity ;
    sh:description "The number of people hired by the Organization." ;
    sh:maxCount 1 ;
    sh:name "provides Organisation Employee Quantity" ;
    sh:path :providesOrganisationEmployeeQuantity ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#providesOrganisationEmployeeQuantity> ?that . ?that <http://data.europa.eu/a4g/ontology#providesOrganisationEmployeeQuantity> ?this .}" ] .

sub-shape:epo-sub-OrganisationInformationSummary-epo-sub-providesOrganisationFinancialCapability a sh:PropertyShape ;
    sh:class :MonetaryValue ;
    sh:description "A monetary amount representing the financial capability of the Organization. Additional information: Used to represent the general Turnover of the Organization (for statistical purposes)." ;
    sh:maxCount 1 ;
    sh:name "provides Organisation Financial Capability" ;
    sh:path :providesOrganisationFinancialCapability ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#providesOrganisationFinancialCapability> ?that . ?that <http://data.europa.eu/a4g/ontology#providesOrganisationFinancialCapability> ?this .}" ] .

sub-shape:epo-sub-Response-epo-sub-answersQuestion a sh:PropertyShape ;
    sh:class cccev:InformationRequirement ;
    sh:description "Relation indicating that the Response replies to a question." ;
    sh:name "answers Question" ;
    sh:path :answersQuestion ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#answersQuestion> ?that . ?that <http://data.europa.eu/a4g/ontology#answersQuestion> ?this .}" ] .

sub-shape:epo-sub-Response-epo-sub-isReinforcedBy a sh:PropertyShape ;
    sh:class cccev:Evidence ;
    sh:description "Relation indicating an Evidence that supports the Response." ;
    sh:name "is Reinforced By" ;
    sh:path :isReinforcedBy ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#isReinforcedBy> ?that . ?that <http://data.europa.eu/a4g/ontology#isReinforcedBy> ?this .}" ] .

sub-shape:epo-sub-Response-epo-sub-refersToApplicablePeriod a sh:PropertyShape ;
    sh:class time:Interval ;
    sh:description "Relation indicating the period to which the Response shall apply." ;
    sh:maxCount 1 ;
    sh:name "refers To Applicable Period" ;
    sh:path :refersToApplicablePeriod ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#refersToApplicablePeriod> ?that . ?that <http://data.europa.eu/a4g/ontology#refersToApplicablePeriod> ?this .}" ] .

sub-shape:sub-shape a owl:Ontology ;
    rdfs:label "eProcurement Ontology Submission - core shapes"@en ;
    dcterms:created "2021-06-01"^^xsd:date ;
    dcterms:description "The eProcurement Ontology Submission core shapes provides the generic datashape specifications for the eProcurement Ontology Submission core."@en ;
    dcterms:issued "2025-10-10"^^xsd:date ;
