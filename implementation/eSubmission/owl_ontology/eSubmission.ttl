@prefix : <http://data.europa.eu/a4g/ontology#> .
@prefix cccev: <http://data.europa.eu/m8g/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eli: <http://data.europa.eu/eli/ontology#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:DocumentaryEvidence a owl:Class ;
    rdfs:isDefinedBy :sub ;
    rdfs:subClassOf cccev:Evidence ;
    skos:prefLabel "Documentary Evidence"@en .

:ESPD a owl:Class ;
    rdfs:isDefinedBy :sub ;
    rdfs:subClassOf :Document ;
    skos:definition "A self-declaration of an economic operator, stating that it does not fall under the Exclusion Grounds and that it meets the Selection Criteria for a specific procurement."@en ;
    skos:historyNote "WG Approval 05/03/2024"@en ;
    skos:prefLabel "ESPD"@en .

:EvidenceInformation a owl:Class ;
    rdfs:isDefinedBy :sub ;
    rdfs:subClassOf :ContextDescription ;
    skos:definition "Information about a Certificate."@en ;
    skos:historyNote "WG Approval 12/03/2024"@en ;
    skos:prefLabel "Evidence Information"@en .

:LegalRepresentative a owl:Class ;
    rdfs:isDefinedBy :sub ;
    rdfs:subClassOf :AuxiliaryParty ;
    skos:definition "The Role of an Agent that can represent an Organization."@en ;
    skos:historyNote "WG Approval 05/03/2024"@en ;
    skos:prefLabel "Legal Representative"@en .

:Mandate a owl:Class ;
    rdfs:isDefinedBy :sub ;
    rdfs:subClassOf :Document ;
    skos:definition "An authorization to act as a representative of an Organization."@en ;
    skos:historyNote "WG Approval 05/03/2024"@en ;
    skos:prefLabel "Mandate"@en .

:OrganisationInformationSummary a owl:Class ;
    rdfs:isDefinedBy :sub ;
    rdfs:subClassOf :ContextDescription ;
    skos:definition "Information about the specific features or characteristics that qualify an economic operator to take part in a tendering process."@en ;
    skos:historyNote "WG Approval 03/03/2025"@en ;
    skos:prefLabel "Organisation Information Summary"@en .

:PowerOfAttorney a owl:Class ;
    rdfs:isDefinedBy :sub ;
    rdfs:subClassOf :Document ;
    skos:definition "A legal document that grants someone the authority to make decisions on behalf of an Organization."@en ;
    skos:historyNote "WG Approval 05/03/2024"@en ;
    skos:prefLabel "Power Of Attorney"@en .

:Response a owl:Class ;
    rdfs:isDefinedBy :sub ;
    skos:definition "An answer given to a question that is part of an ESPD Request."@en ;
    skos:historyNote "WG Approval 12/03/2024"@en ;
    skos:prefLabel "Response"@en .

:actsOnBehalfOf a owl:ObjectProperty ;
    rdfs:isDefinedBy :sub ;
    skos:prefLabel "acts On Behalf Of"@en .

:answersQuestion a owl:ObjectProperty ;
    rdfs:isDefinedBy :sub ;
    skos:definition "Relation indicating that the Response replies to a question."@en ;
    skos:historyNote "WG Approval 12/03/2024"@en ;
    skos:prefLabel "answers Question"@en .

:concernsOrganisation a owl:ObjectProperty ;
    rdfs:isDefinedBy :sub ;
    skos:definition "Relates to Organization."@en ;
    skos:historyNote "WG Approval 05/03/2024"@en ;
    skos:prefLabel "concerns Organisation"@en .

:coversAllSelectionCriteria a owl:DatatypeProperty ;
    rdfs:isDefinedBy :sub ;
    skos:definition "Indicator that the Certificate proves whether the Organization fulfils all Selection Criteria. (epo-sub:EvidenceInformation)"@en ;
    skos:historyNote "WG Approval 12/03/2024"@en ;
    skos:prefLabel "covers All Selection Criteria"@en .

:hasBusinessClassificationDescription a owl:DatatypeProperty ;
    rdfs:isDefinedBy :sub ;
    skos:prefLabel "has Business Classification Description"@en .

:hasMandate a owl:ObjectProperty ;
    rdfs:isDefinedBy :sub ;
    skos:definition "Relation indicating that a Legal Representative has a Mandate."@en ;
    skos:historyNote "WG Approval 12/03/2024"@en ;
    skos:prefLabel "has Mandate"@en .

:hasPowerOfAttorney a owl:ObjectProperty ;
    rdfs:isDefinedBy :sub ;
    skos:definition "Relation indicating that a Legal Representative has a Power of Attorney."@en ;
    skos:historyNote "WG Approval 12/03/2024"@en ;
    skos:prefLabel "has Power Of Attorney"@en .

:isContainedInTender a owl:ObjectProperty ;
    rdfs:isDefinedBy :sub ;
    skos:prefLabel "is Contained In Tender"@en .

:isReinforcedBy a owl:ObjectProperty ;
    rdfs:isDefinedBy :sub ;
    skos:definition "Relation indicating an Evidence that supports the Response."@en ;
    skos:historyNote "WG Approval 12/03/2024"@en ;
    skos:prefLabel "is Reinforced By"@en .

:providesInformationOn a owl:ObjectProperty ;
    rdfs:isDefinedBy :sub ;
    skos:definition "Offers information about an instance of a concept."@en ;
    skos:historyNote "WG Approval 05/03/2024"@en ;
    skos:prefLabel "provides Information On"@en .

:providesOrganisationCompletedTaskDescription a owl:DatatypeProperty ;
    rdfs:isDefinedBy :sub ;
    skos:definition "Text describing the works, supplies or services executed, delivered or performed in a procurement project that can be used as an evidence for the classification of the Organization. (epo-sub:OrganisationInformationSummary)"@en ;
    skos:historyNote "WG Approval 05/03/2024"@en ;
    skos:prefLabel "provides Organisation Completed Task Description"@en .

:providesOrganisationEmployeeQuantity a owl:ObjectProperty ;
    rdfs:isDefinedBy :sub ;
    skos:definition "The number of people hired by the Organization."@en ;
    skos:historyNote "WG Approval 05/03/2024"@en ;
    skos:prefLabel "provides Organisation Employee Quantity"@en .

:providesOrganisationFinancialCapability a owl:ObjectProperty ;
    rdfs:isDefinedBy :sub ;
    skos:definition "A monetary amount representing the financial capability of the Organization. Additional information: Used to represent the general Turnover of the Organization (for statistical purposes)."@en ;
    skos:historyNote "WG Approval 05/03/2024"@en ;
    skos:prefLabel "provides Organisation Financial Capability"@en .

:refersToApplicablePeriod a owl:ObjectProperty ;
    rdfs:isDefinedBy :sub ;
    skos:definition "Relation indicating the period to which the Response shall apply."@en ;
    skos:historyNote "WG Approval 12/03/2024"@en ;
    skos:prefLabel "refers To Applicable Period"@en .

:relatesToESPDRequest a owl:ObjectProperty ;
    rdfs:isDefinedBy :sub ;
    skos:definition "Is about an European Single Procurement Document (ESPD) Request."@en ;
    skos:historyNote "WG Approval 05/03/2024"@en ;
    skos:prefLabel "relates To ESPD Request"@en .

:specifiesResponse a owl:ObjectProperty ;
    rdfs:isDefinedBy :sub ;
    skos:definition "Relation indicating that an ESPD Response contains a Response."@en ;
    skos:historyNote "WG Approval 12/03/2024"@en ;
    skos:prefLabel "specifies Response"@en .

:summarisesInformationAboutEvidence a owl:ObjectProperty ;
    rdfs:isDefinedBy :sub ;
    skos:definition "Relation indicating the Certificate that the information refers to."@en ;
    skos:historyNote "WG Approval 12/03/2024"@en ;
    skos:prefLabel "summarises Information About Evidence"@en .

:sub a owl:Ontology ;
    rdfs:label "eProcurement Ontology Submission - core"@en ;
    dcterms:created "2021-06-01"^^xsd:date ;
    dcterms:description "The eProcurement Ontology Submission core describes the concepts and properties representing the European Public Procurement Submission domain. The provision of these semantics offers the basis for a common understanding of the domain for all stakeholders ensuring the quality of data exchange and transparency. The ontology restrictions are published in a separate artefact."@en ;
    dcterms:issued "2025-06-04"^^xsd:date ;
    dcterms:license "© European Union, 2014. Unless otherwise noted, the reuse of the Ontology is authorised under the European Union Public Licence v1.2 (https://eupl.eu/)." ;
    dcterms:publisher "http://publications.europa.eu/resource/authority/corporate-body/PUBL" ;
    dcterms:title "eProcurement Ontology Submission - core"@en ;
    vann:preferredNamespacePrefix "epo" ;
    vann:preferredNamespaceUri "http://data.europa.eu/a4g/ontology#" ;
    rdfs:comment "This version is automatically generated from eSubmission.xml on 2025-06-04" ;
    rdfs:seeAlso <https://docs.ted.europa.eu/home/index.html>,
        <https://github.com/OP-TED/ePO/releases>,
        <https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology/about>,
        <https://op.europa.eu/en/web/eu-vocabularies/e-procurement> ;
    owl:imports :acc,
        :core,
        eli:,
        cccev:,
        dcterms:,
        skos:,
        <http://www.w3.org/2006/time>,
        <http://www.w3.org/ns/adms>,
        <http://www.w3.org/ns/locn>,
        org:,
        <http://www.w3.org/ns/person> ;
    owl:incompatibleWith "4.2.0" ;
    owl:priorVersion "http://data.europa.eu/a4g/ontology#sub-5.0.0" ;
    owl:versionIRI :sub-5.1.0 ;
    owl:versionInfo "5.1.0" .

