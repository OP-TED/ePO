    <owl:imports rdf:resource="http://data.europa.eu/eli/ontology#"/>
    <dcterms:title xml:lang="en">eProcurement Ontology Submission - core</dcterms:title>
    <rdfs:label xml:lang="en">eProcurement Ontology Submission - core</rdfs:label>
    <dcterms:description xml:lang="en">The eProcurement Ontology Submission core describes the concepts and properties representing the European Public Procurement Submission domain. The provision of these semantics offers the basis for a common understanding of the domain for all stakeholders ensuring the quality of data exchange and transparency. The ontology restrictions are published in a separate artefact.</dcterms:description>
    <dcterms:publisher>http://publications.europa.eu/resource/authority/corporate-body/PUBL</dcterms:publisher>
    <rdfs:comment>This version is automatically generated from eSubmission.xml on 2025-06-04</rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://github.com/OP-TED/ePO/releases"/>
    <rdfs:seeAlso rdf:resource="https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology/about"/>
    <rdfs:seeAlso rdf:resource="https://op.europa.eu/en/web/eu-vocabularies/e-procurement"/>
    <rdfs:seeAlso rdf:resource="https://docs.ted.europa.eu/home/index.html"/>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-06-04</dcterms:issued>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-06-01</dcterms:created>
    <owl:versionInfo>5.1.0</owl:versionInfo>
    <owl:incompatibleWith>4.2.0</owl:incompatibleWith>
    <owl:versionIRI rdf:resource="http://data.europa.eu/a4g/ontology#sub-5.1.0"/>
    <owl:priorVersion>http://data.europa.eu/a4g/ontology#sub-5.0.0</owl:priorVersion>
    <vann:preferredNamespaceUri>http://data.europa.eu/a4g/ontology#</vann:preferredNamespaceUri>
    <vann:preferredNamespacePrefix>epo</vann:preferredNamespacePrefix>
    <dcterms:license>© European Union, 2014. Unless otherwise noted, the reuse of the Ontology is authorised under the European Union Public Licence v1.2 (https://eupl.eu/).</dcterms:license>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#LegalRepresentative">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">Legal Representative</skos:prefLabel>
    <skos:definition xml:lang="en">The Role of an Agent that can represent an Organization.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#sub"/>
    <skos:historyNote xml:lang="en">WG Approval 05/03/2024</skos:historyNote>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AuxiliaryParty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#summarisesInformationAboutEvidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">summarises Information About Evidence</skos:prefLabel>
    <skos:definition xml:lang="en">Relation indicating the Certificate that the information refers to.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#sub"/>
    <skos:historyNote xml:lang="en">WG Approval 12/03/2024</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasBusinessClassificationDescription">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel xml:lang="en">has Business Classification Description</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#sub"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#refersToApplicablePeriod">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">refers To Applicable Period</skos:prefLabel>
    <skos:definition xml:lang="en">Relation indicating the period to which the Response shall apply.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#sub"/>
    <skos:historyNote xml:lang="en">WG Approval 12/03/2024</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#Response">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">Response</skos:prefLabel>
    <skos:definition xml:lang="en">An answer given to a question that is part of an ESPD Request.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#sub"/>
    <skos:historyNote xml:lang="en">WG Approval 12/03/2024</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#providesOrganisationEmployeeQuantity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">provides Organisation Employee Quantity</skos:prefLabel>
    <skos:definition xml:lang="en">The number of people hired by the Organization.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#sub"/>
    <skos:historyNote xml:lang="en">WG Approval 05/03/2024</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#answersQuestion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">answers Question</skos:prefLabel>
    <skos:definition xml:lang="en">Relation indicating that the Response replies to a question.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#sub"/>
    <skos:historyNote xml:lang="en">WG Approval 12/03/2024</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#Mandate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">Mandate</skos:prefLabel>
    <skos:definition xml:lang="en">An authorization to act as a representative of an Organization.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#sub"/>
    <skos:historyNote xml:lang="en">WG Approval 05/03/2024</skos:historyNote>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Document"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#OrganisationInformationSummary">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">Organisation Information Summary</skos:prefLabel>
    <skos:definition xml:lang="en">Information about the specific features or characteristics that qualify an economic operator to take part in a tendering process.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#sub"/>
    <skos:historyNote xml:lang="en">WG Approval 03/03/2025</skos:historyNote>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ContextDescription"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasMandate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">has Mandate</skos:prefLabel>
    <skos:definition xml:lang="en">Relation indicating that a Legal Representative has a Mandate.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#sub"/>
    <skos:historyNote xml:lang="en">WG Approval 12/03/2024</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#PowerOfAttorney">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">Power Of Attorney</skos:prefLabel>
    <skos:definition xml:lang="en">A legal document that grants someone the authority to make decisions on behalf of an Organization.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#sub"/>
    <skos:historyNote xml:lang="en">WG Approval 05/03/2024</skos:historyNote>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Document"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#specifiesResponse">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">specifies Response</skos:prefLabel>
    <skos:definition xml:lang="en">Relation indicating that an ESPD Response contains a Response.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#sub"/>
    <skos:historyNote xml:lang="en">WG Approval 12/03/2024</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#EvidenceInformation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">Evidence Information</skos:prefLabel>
    <skos:definition xml:lang="en">Information about a Certificate.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#sub"/>
    <skos:historyNote xml:lang="en">WG Approval 12/03/2024</skos:historyNote>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ContextDescription"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#relatesToESPDRequest">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">relates To ESPD Request</skos:prefLabel>
    <skos:definition xml:lang="en">Is about an European Single Procurement Document (ESPD) Request.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#sub"/>
    <skos:historyNote xml:lang="en">WG Approval 05/03/2024</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#ESPD">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">ESPD</skos:prefLabel>
    <skos:definition xml:lang="en">A self-declaration of an economic operator, stating that it does not fall under the Exclusion Grounds and that it meets the Selection Criteria for a specific procurement.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#sub"/>
    <skos:historyNote xml:lang="en">WG Approval 05/03/2024</skos:historyNote>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Document"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#providesOrganisationFinancialCapability">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">provides Organisation Financial Capability</skos:prefLabel>
    <skos:definition xml:lang="en">A monetary amount representing the financial capability of the Organization. Additional information: Used to represent the general Turnover of the Organization (for statistical purposes).</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#sub"/>
    <skos:historyNote xml:lang="en">WG Approval 05/03/2024</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#isContainedInTender">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">is Contained In Tender</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#sub"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#actsOnBehalfOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">acts On Behalf Of</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#sub"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#DocumentaryEvidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">Documentary Evidence</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#sub"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/m8g/Evidence"/>
  </rdf:Description>
</rdf:RDF>
