  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#providesInformationOn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">provides Information On</skos:prefLabel>
    <skos:definition xml:lang="en">Offers information about an instance of a concept.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#sub"/>
    <skos:historyNote xml:lang="en">WG Approval 05/03/2024</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#concernsOrganisation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">concerns Organisation</skos:prefLabel>
    <skos:definition xml:lang="en">Relates to Organization.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#sub"/>
    <skos:historyNote xml:lang="en">WG Approval 05/03/2024</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#providesOrganisationCompletedTaskDescription">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel xml:lang="en">provides Organisation Completed Task Description</skos:prefLabel>
    <skos:definition xml:lang="en">Text describing the works, supplies or services executed, delivered or performed in a procurement project that can be used as an evidence for the classification of the Organization. (epo-sub:OrganisationInformationSummary)</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#sub"/>
    <skos:historyNote xml:lang="en">WG Approval 05/03/2024</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#isReinforcedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">is Reinforced By</skos:prefLabel>
    <skos:definition xml:lang="en">Relation indicating an Evidence that supports the Response.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#sub"/>
    <skos:historyNote xml:lang="en">WG Approval 12/03/2024</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasPowerOfAttorney">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">has Power Of Attorney</skos:prefLabel>
    <skos:definition xml:lang="en">Relation indicating that a Legal Representative has a Power of Attorney.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#sub"/>
    <skos:historyNote xml:lang="en">WG Approval 12/03/2024</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#coversAllSelectionCriteria">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel xml:lang="en">covers All Selection Criteria</skos:prefLabel>
    <skos:definition xml:lang="en">Indicator that the Certificate proves whether the Organization fulfils all Selection Criteria. (epo-sub:EvidenceInformation)</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#sub"/>
    <skos:historyNote xml:lang="en">WG Approval 12/03/2024</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#sub">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:imports rdf:resource="http://purl.org/dc/terms/"/>
    <owl:imports rdf:resource="http://www.w3.org/ns/org#"/>
