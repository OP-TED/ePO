@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix epo: <http://data.europa.eu/a4g/ontology#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

epo:answersQuestion rdfs:domain epo:Response ;
    rdfs:range <http://data.europa.eu/m8g/InformationRequirement> .

epo:hasBusinessClassificationDescription rdfs:domain epo:OrganisationInformationSummary ;
    rdfs:range rdf:PlainLiteral .

epo:hasMandate rdfs:domain epo:LegalRepresentative ;
    rdfs:range epo:Mandate .

epo:isContainedInTender rdfs:domain epo:ESPD ;
    rdfs:range epo:Tender .

epo:isReinforcedBy rdfs:domain epo:Response ;
    rdfs:range <http://data.europa.eu/m8g/Evidence> .

epo:providesInformationOn rdfs:domain epo:ESPD ;
    rdfs:range org:Organization .

epo:sub-restriction a owl:Ontology ;
    rdfs:label "eProcurement Ontology Submission - core restrictions"@en ;
    dcterms:created "2021-06-01"^^xsd:date ;
    dcterms:description "The eProcurement Ontology Submission core restrictions provides the restrictions and the inference-related specifications on the concepts and properties in the eProcurement Ontology Submission core."@en ;
    dcterms:issued "2025-10-10"^^xsd:date ;
    dcterms:license "© European Union, 2014. Unless otherwise noted, the reuse of the Ontology is authorised under the European Union Public Licence v1.2 (https://eupl.eu/)." ;
    dcterms:publisher "http://publications.europa.eu/resource/authority/corporate-body/PUBL" ;
    dcterms:title "eProcurement Ontology Submission - core restrictions"@en ;
    vann:preferredNamespacePrefix "epo" ;
    vann:preferredNamespaceUri "http://data.europa.eu/a4g/ontology#" ;
    rdfs:comment """This version is automatically generated from eSubmission.xml on 
                2025-10-10""" ;
    rdfs:seeAlso <https://docs.ted.europa.eu/home/index.html>,
        <https://github.com/OP-TED/ePO/releases>,
        <https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology/about>,
        <https://op.europa.eu/en/web/eu-vocabularies/e-procurement> ;
    owl:imports epo:acc,
        epo:core,
        epo:sub,
        <http://data.europa.eu/eli/ontology#>,
        <http://data.europa.eu/m8g/>,
        dcterms:,
        skos:,
        <http://www.w3.org/2006/time>,
        <http://www.w3.org/ns/adms>,
        <http://www.w3.org/ns/locn>,
        org:,
        <http://www.w3.org/ns/person> ;
    owl:incompatibleWith "4.2.0" ;
    owl:priorVersion "http://data.europa.eu/a4g/ontology#sub-restriction-5.1.0" ;
    owl:versionIRI epo:sub-restriction-5.2.0 ;
    owl:versionInfo "5.2.0" .

epo:actsOnBehalfOf rdfs:domain epo:LegalRepresentative ;
    rdfs:range epo:OfferingParty .

epo:concernsOrganisation a owl:FunctionalProperty ;
    rdfs:domain epo:OrganisationInformationSummary ;
    rdfs:range org:Organization .

epo:coversAllSelectionCriteria rdfs:domain epo:EvidenceInformation ;
    rdfs:range xsd:boolean .

epo:hasPowerOfAttorney rdfs:domain epo:LegalRepresentative ;
    rdfs:range epo:PowerOfAttorney .

epo:providesOrganisationCompletedTaskDescription rdfs:domain epo:OrganisationInformationSummary ;
    rdfs:range rdf:PlainLiteral .

epo:providesOrganisationEmployeeQuantity rdfs:domain epo:OrganisationInformationSummary ;
    rdfs:range epo:Quantity .

epo:providesOrganisationFinancialCapability rdfs:domain epo:OrganisationInformationSummary ;
    rdfs:range epo:MonetaryValue .

epo:refersToApplicablePeriod rdfs:domain epo:Response ;
    rdfs:range time:Interval .

epo:relatesToESPDRequest rdfs:domain epo:ESPD ;
    rdfs:range epo:ESPDRequest .

epo:specifiesResponse rdfs:domain epo:ESPD ;
    rdfs:range epo:Response .

epo:summarisesInformationAboutEvidence a owl:FunctionalProperty ;
    rdfs:domain epo:EvidenceInformation ;
    rdfs:range <http://data.europa.eu/m8g/Evidence> .

epo:EvidenceInformation rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dcterms:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:coversAllSelectionCriteria ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:summarisesInformationAboutEvidence ] .

epo:LegalRepresentative rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:actsOnBehalfOf ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:hasPowerOfAttorney ] .

epo:Response rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:refersToApplicablePeriod ] .

epo:ESPD rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty epo:specifiesResponse ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:relatesToESPDRequest ] .

epo:OrganisationInformationSummary rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:providesOrganisationFinancialCapability ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:providesOrganisationCompletedTaskDescription ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:concernsOrganisation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:providesOrganisationEmployeeQuantity ] .

[] a owl:AllDisjointClasses ;
    owl:members ( epo:ESPD epo:Mandate epo:PowerOfAttorney ) .

[] a owl:AllDisjointClasses ;
    owl:members ( epo:EvidenceInformation epo:OrganisationInformationSummary ) .

