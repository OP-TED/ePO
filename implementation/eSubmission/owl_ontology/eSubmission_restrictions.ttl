@prefix : <http://data.europa.eu/a4g/ontology#> .
@prefix cccev: <http://data.europa.eu/m8g/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eli: <http://data.europa.eu/eli/ontology#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:answersQuestion rdfs:domain :Response ;
    rdfs:range cccev:InformationRequirement .

:hasBusinessClassificationDescription rdfs:domain :OrganisationInformationSummary ;
    rdfs:range rdf:PlainLiteral .

:hasMandate rdfs:domain :LegalRepresentative ;
    rdfs:range :Mandate .

:isContainedInTender rdfs:domain :ESPD ;
    rdfs:range :Tender .

:isReinforcedBy rdfs:domain :Response ;
    rdfs:range cccev:Evidence .

:providesInformationOn rdfs:domain :ESPD ;
    rdfs:range org:Organization .

:sub-restriction a owl:Ontology ;
    rdfs:label "eProcurement Ontology Submission - core restrictions"@en ;
    dcterms:created "2021-06-01"^^xsd:date ;
    dcterms:description "The eProcurement Ontology Submission core restrictions provides the restrictions and the inference-related specifications on the concepts and properties in the eProcurement Ontology Submission core."@en ;
    dcterms:issued "2026-10-26"^^xsd:date ;
    dcterms:license "© European Union, 2014. Unless otherwise noted, the reuse of the Ontology is authorised under the European Union Public Licence v1.2 (https://eupl.eu/)." ;
    dcterms:publisher "http://publications.europa.eu/resource/authority/corporate-body/PUBL" ;
    dcterms:title "eProcurement Ontology Submission - core restrictions"@en ;
    vann:preferredNamespacePrefix "epo" ;
    vann:preferredNamespaceUri "http://data.europa.eu/a4g/ontology#" ;
    rdfs:comment """This version is automatically generated from eSubmission.xml on 
                2026-10-26""" ;
    rdfs:seeAlso <https://docs.ted.europa.eu/home/index.html>,
        <https://github.com/OP-TED/ePO/releases>,
        <https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology/about>,
        <https://op.europa.eu/en/web/eu-vocabularies/e-procurement> ;
    owl:imports :acc,
        :core,
        :sub,
        eli:,
        cccev:,
        dcterms:,
        skos:,
        <http://www.w3.org/2006/time>,
        <http://www.w3.org/ns/adms>,
        <http://www.w3.org/ns/locn>,
        org:,
        <http://www.w3.org/ns/person> ;
    owl:incompatibleWith "4.2.0" ;
    owl:priorVersion "http://data.europa.eu/a4g/ontology#sub-restriction-5.2.0" ;
    owl:versionIRI :sub-restriction-5.3.0 ;
    owl:versionInfo "5.3.0" .

:TenderWithdrawalReceipt rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :Tender ;
            owl:onProperty :refersToTender ;
            owl:qualifiedCardinality 1 ] .

:TenderWithdrawalRequest rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :TenderReceipt ;
            owl:onProperty :refersToTenderReceipt ;
            owl:qualifiedCardinality 1 ] .

:actsOnBehalfOf rdfs:domain :LegalRepresentative ;
    rdfs:range :OfferingParty .

:concernsOrganisation a owl:FunctionalProperty ;
    rdfs:domain :OrganisationInformationSummary ;
    rdfs:range org:Organization .

:coversAllSelectionCriteria rdfs:domain :EvidenceInformation ;
    rdfs:range xsd:boolean .

:hasPowerOfAttorney rdfs:domain :LegalRepresentative ;
    rdfs:range :PowerOfAttorney .

:providesOrganisationCompletedTaskDescription rdfs:domain :OrganisationInformationSummary ;
    rdfs:range rdf:PlainLiteral .

:providesOrganisationEmployeeQuantity rdfs:domain :OrganisationInformationSummary ;
    rdfs:range :Quantity .

:providesOrganisationFinancialCapability rdfs:domain :OrganisationInformationSummary ;
    rdfs:range :MonetaryValue .

:refersToApplicablePeriod rdfs:domain :Response ;
    rdfs:range time:Interval .

:refersToTender a owl:FunctionalProperty ;
    rdfs:domain :TenderWithdrawalReceipt ;
    rdfs:range :Tender .

:refersToTenderReceipt a owl:FunctionalProperty ;
    rdfs:domain :TenderWithdrawalRequest ;
    rdfs:range :TenderReceipt .

:relatesToESPDRequest rdfs:domain :ESPD ;
    rdfs:range :ESPDRequest .

:specifiesResponse rdfs:domain :ESPD ;
    rdfs:range :Response .

:summarisesInformationAboutEvidence a owl:FunctionalProperty ;
    rdfs:domain :EvidenceInformation ;
    rdfs:range cccev:Evidence .

:EvidenceInformation rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty :coversAllSelectionCriteria ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty dcterms:description ],
        [ a owl:Restriction ;
            owl:onClass cccev:Evidence ;
            owl:onProperty :summarisesInformationAboutEvidence ;
            owl:qualifiedCardinality 1 ] .

:LegalRepresentative rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass :PowerOfAttorney ;
            owl:onProperty :hasPowerOfAttorney ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass :OfferingParty ;
            owl:onProperty :actsOnBehalfOf ] .

:ESPD rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass :ESPDRequest ;
            owl:onProperty :relatesToESPDRequest ],
        [ a owl:Restriction ;
            owl:onProperty :specifiesResponse ;
            owl:someValuesFrom :Response ] .

:OrganisationInformationSummary rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty :providesOrganisationCompletedTaskDescription ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :providesOrganisationFinancialCapability ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass :Quantity ;
            owl:onProperty :providesOrganisationEmployeeQuantity ],
        [ a owl:Restriction ;
            owl:onClass org:Organization ;
            owl:onProperty :concernsOrganisation ;
            owl:qualifiedCardinality 1 ] .

:Response rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass time:Interval ;
            owl:onProperty :refersToApplicablePeriod ] .

