@prefix : <http://data.europa.eu/a4g/ontology#> .
@prefix cccev: <http://data.europa.eu/m8g/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eli: <http://data.europa.eu/eli/ontology#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:Batch a owl:Class ;
    rdfs:isDefinedBy :cat ;
    skos:definition "A production lot in which the Item instances were produced."@en ;
    skos:historyNote "WG Approval 10/03/2022"@en ;
    skos:prefLabel "Batch"@en .

:Brand a owl:Class ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Name given by an organisation to its product or service, or range of products or services. Additional information: Brand name allows economic operators to distinctively describe an item in their eCatalogue. This may be different from the \"item name\"."@en ;
    skos:historyNote "WG Approval 10/03/2022"@en ;
    skos:prefLabel "Brand"@en .

:CatalogueLine a owl:Class ;
    rdfs:isDefinedBy :cat ;
    rdfs:subClassOf :Line ;
    skos:definition "Aggregated information about the Terms and specifications for procuring an Item. Details about an Item, like Prices, packaging, discounts, special promotions, etc. TC 440: Detailed information of an Item, Price and its composition in a Catalogue. Composition: e.g. information referring to its description, how to order it, what it is made of, properties, delivery conditions, etc."@en ;
    skos:prefLabel "Catalogue Line"@en .

:CatalogueResponse a owl:Class ;
    rdfs:isDefinedBy :cat ;
    skos:definition "A formal reply from the Catalogue Receiver to the Catalogue Provider stating the Catalogue Receiver's ability to apply the catalogue for placing orders. Additional Information: The Catalogue Response is used to inform on the acceptance or rejection of a Catalogue."@en ;
    skos:prefLabel "Catalogue Response"@en .

:CatalogueResponseInformation a owl:Class ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Information about a Catalogue Response."@en ;
    skos:historyNote "WG approval 11/09/2025"@en ;
    skos:prefLabel "Catalogue Response Information"@en .

:CatalogueResponseLine a owl:Class ;
    rdfs:isDefinedBy :cat ;
    rdfs:subClassOf :Line ;
    skos:definition "Details concerning the Catalogue Receiver’s ability to apply a given Catalogue Line for placing orders. Additional information: The Catalogue Response Line is used to inform on the acceptance or rejection of a Catalogue Line."@en ;
    skos:prefLabel "Catalogue Response Line"@en .

:ChargeInformation a owl:Class ;
    rdfs:isDefinedBy :cat ;
    rdfs:subClassOf :AllowanceChargeInformation ;
    skos:definition "Information about fee or duty imposed. Additional Information: Charge category indicates the nature of the duty/fee, for example CAR, etc. Charge category modifier may be used in case different levels, exemptions or other modifications apply. The charge can be fixed or relative to the price."@en ;
    skos:historyNote "WG Approval 16/05/2023"@en ;
    skos:prefLabel "Charge Information"@en .

:DimensionInformation a owl:Class ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Information about the physical or measurable attributes of the instance of the concept described."@en ;
    skos:historyNote "WG approval 11/09/2025"@en ;
    skos:prefLabel "Dimension Information"@en .

:EnvironmentalEmissionInformation a owl:Class ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Information about the emissions related to a product, work or service that are released into the environment."@en ;
    skos:historyNote "WG approval 11/09/2025"@en ;
    skos:prefLabel "Environmental Emission Information"@en .

:InformationHub a owl:Class ;
    rdfs:isDefinedBy :cat ;
    rdfs:subClassOf :ContextDescription ;
    skos:definition "Grouping of data that may be associated to various concepts. Additional Information: For example, AllowanceChargeInformation may be associated to the Order or the Catalogue (either at the Line level or at the Document level), amongst others."@en ;
    skos:historyNote "WG Approval 16/05/2023"@en ;
    skos:prefLabel "Information Hub"@en .

:Item a owl:Class ;
    rdfs:isDefinedBy :cat ;
    rdfs:subClassOf :AbstractItem ;
    skos:definition "A product, work, service or any combination of them. Additional Information: An Item can be an atomic Thing or a composition of things that together are seen as a unit, e.g. a tetrabrik of milk or an indivisible package of six tetrabriks. No distinction is provided between services, goods and works to leave room for innovation. An Item is used to fulfill a need which is described in an Item Request."@en ;
    skos:historyNote "WG approval 09/10/2025"@en ;
    skos:prefLabel "Item"@en .

:ItemAccessoryRelation a owl:Class ;
    rdfs:isDefinedBy :cat ;
    rdfs:subClassOf :ItemRelation ;
    skos:definition "Combination of two Items where the former enhances the latter."@en ;
    skos:historyNote "WG Approval 30/06/2022"@en ;
    skos:prefLabel "Item Accessory Relation"@en .

:ItemComplementaryRelation a owl:Class ;
    rdfs:isDefinedBy :cat ;
    rdfs:subClassOf :ItemRelation ;
    skos:definition "Combination of two Items which mutually enhance one another."@en ;
    skos:historyNote "WG Approval 30/06/2022"@en ;
    skos:prefLabel "Item Complementary Relation"@en .

:ItemComposition a owl:Class ;
    rdfs:isDefinedBy :cat ;
    rdfs:subClassOf :ItemRelation ;
    skos:definition "Inclusion of an Item into in the described Item. Additional Information: The Item is provided with its components, however, the component Items may also be provided separately. For example, a bicycle has wheels as components, but they may be provided as spare parts as well. This relation is useful to describe different package levels of an item or hierarchies of Items."@en ;
    skos:historyNote "WG Approval 19/05/2022"@en ;
    skos:prefLabel "Item Composition"@en .

:ItemModel a owl:Class ;
    rdfs:isDefinedBy :cat ;
    skos:definition "A specific design or version of a product or service. Additional information: This class is meant as a reusable reference to the model name rather than as a set of specifications of an Item of this particular model."@en ;
    skos:historyNote "WG Approval 10/03/2022"@en ;
    skos:prefLabel "Item Model"@en .

:ItemProperty a owl:Class ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Construct meant to represent the association between an attribute defined in an external classification scheme and the value ascribed to it."@en ;
    skos:historyNote "WG Approval 26/07/2022"@en ;
    skos:prefLabel "Item Property"@en .

:ItemReplacement a owl:Class ;
    rdfs:isDefinedBy :cat ;
    rdfs:subClassOf :ItemRelation ;
    skos:definition "Supplantment, displacement or suspension of an Item by the described Item."@en ;
    skos:historyNote "WG Approval 30/06/2022"@en ;
    skos:prefLabel "Item Replacement"@en .

:ItemRequirement a owl:Class ;
    rdfs:isDefinedBy :cat ;
    rdfs:subClassOf :ItemRelation ;
    skos:definition "Necessity of an Item by the described item. Additional Information: The described item is provided without other items that are required for proper functionality. For example, a printer cannot be used without ink cartridge; or a Server cannot be used without its installation."@en ;
    skos:historyNote "WG Approval 19/05/2022"@en ;
    skos:prefLabel "Item Requirement"@en .

:Manufacturer a owl:Class ;
    rdfs:isDefinedBy :cat ;
    rdfs:subClassOf :OfferingParty ;
    skos:definition "The Producer of goods or provider of services. Additional Information: Also, known as Supplier and Manufacturer. We do not care who provides these service or products we care with whom Business is done. PEPPOL - Invoice: The Supplier is the Legal Person or Organisation who provides a product and/or service. PEPPOL - Order: The supplier is the legal person or organisation who provides a product or service. Examples of supplier roles: seller, despatch party, creditor, economic operator."@en ;
    skos:prefLabel "Manufacturer"@en .

:PostAwardCatalogue a owl:Class ;
    rdfs:isDefinedBy :cat ;
    rdfs:subClassOf :Catalogue ;
    skos:definition "A Document describing a set of Items offered for purchase that can be processed in an electronic way, after a Contract is signed."@en ;
    skos:prefLabel "Post Award Catalogue"@en .

:PostAwardDocument a owl:Class ;
    rdfs:isDefinedBy :cat ;
    rdfs:subClassOf :Document ;
    skos:definition "Document created after the award of a Contract during a Procurement Procedure."@en ;
    skos:historyNote "WG approval 11/09/2025"@en ;
    skos:prefLabel "Post Award Document"@en .

:Price a owl:Class ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Amount of money required or given in exchange for Items. Additional information: The Price excludes any charges (such as taxes, duties and fees) and discounts."@en ;
    skos:historyNote "WG approval 26/07/2022"@en ;
    skos:prefLabel "Price"@en .

:ProductSpecification a owl:Class ;
    rdfs:isDefinedBy :cat ;
    rdfs:subClassOf :Document ;
    skos:definition "Document providing information about an Item."@en ;
    skos:historyNote "WG Approval 07/04/2022"@en ;
    skos:prefLabel "Product Specification"@en .

:comprisesCatalogueLine a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Incorporates Catalogue Line."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "comprises Catalogue Line"@en .

:comprisesCatalogueResponseLine a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Incorporates Catalogue Response Line."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "comprises Catalogue Response Line"@en .

:concernsGoodsItem a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Relates to Goods Item."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "concerns Goods Item"@en .

:concernsItem a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Relates to Item."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "concerns Item"@en .

:concernsPackage a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Relates to Package."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "concerns Package"@en .

:concernsTransportEquipment a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Relates to Transport Equipment."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "concerns Transport Equipment"@en .

:concernsTransportMeans a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Relates to Transport Means."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "concerns Transport Means"@en .

:describesItem a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Characterises Item."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "describes Item"@en .

:foreseesPackage a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Relation indicating that an instance of the concept plans to have a Package."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "foresees Package"@en .

:hasAccessoryItem a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "An additional item that can enhance the original item."@en ;
    skos:historyNote "WG Approval 30/06/2022"@en ;
    skos:prefLabel "has Accessory Item"@en .

:hasActivityCode a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Relation indicating the Activity Code."@en ;
    skos:prefLabel "has Activity Code"@en .

:hasAdditionalInformation a owl:DatatypeProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Supplementary data about the instance of the concept. (epo-cat:Line)"@en ;
    skos:historyNote "WG Approval 15/10/2019"@en ;
    skos:prefLabel "has Additional Information"@en .

:hasAssociatedDocument a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Is related to a Document."@en ;
    skos:historyNote "WG Approval 06/10/2024"@en ;
    skos:prefLabel "has Associated Document"@en .

:hasAttributeType a owl:DatatypeProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "The property defined in a classification scheme. Additional Information: For example, the following two properties are defined in the ECLASS classification of goods and services: (0173-1#02-AAA026#007) drilling diameter: drilling diameter, (0173-1#02-AAA030#007) flange diameter: flange diameter . (epo-cat:ItemProperty)"@en ;
    skos:historyNote "WG Approval 28/07/2022"@en ;
    skos:prefLabel "has Attribute Type"@en .

:hasBaseQuantity a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "The quantity at which the net monetary value applies."@en ;
    skos:prefLabel "has Base Quantity"@en .

:hasBatchID a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "The identifier assigned to a specific batch of the produced Item."@en ;
    skos:historyNote "WG Approval 16/05/2023"@en ;
    skos:prefLabel "has Batch ID"@en .

:hasBestBeforeDate a owl:DatatypeProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "The day until which the quality of the item will remain optimal. (epo-cat:Batch)"@en ;
    skos:historyNote "WG Approval 10/03/2021"@en ;
    skos:prefLabel "has Best Before Date"@en .

:hasBrand a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Relation indicating that the instance of the concept has a Brand."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "has Brand"@en .

:hasBuyerItemID a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "The general identifier assigned to the concept as defined by the Buyer.​"@en ;
    skos:historyNote "WG Approval 16/05/2023"@en ;
    skos:prefLabel "has Buyer Item ID"@en .

:hasCalculationMethod a owl:DatatypeProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Formula for obtaining values. Additional Information: The possible values are monetary values, ranking scores, criterion weighting. (epo-cat:EnvironmentalEmissionInformation)"@en ;
    skos:historyNote "WG Approval 25/05/2018"@en ;
    skos:prefLabel "has Calculation Method"@en .

:hasCatalogueLineValidity a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "The relation indicating until when a Catalogue Line instance is applicable."@en ;
    skos:historyNote "WG Approval 21/09/2023"@en ;
    skos:prefLabel "has Catalogue Line Validity"@en .

:hasCertification a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Relation to the proof of conformance."@en ;
    skos:historyNote "WG Approval 30/05/2023"@en ;
    skos:prefLabel "has Certification"@en .

:hasChargeInformation a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Relation indicating that the instance of the concept has Charge Information."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "has Charge Information"@en .

:hasClassificationCode a owl:DatatypeProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "The categorization of the instance of the concept expressed as a code. (epo-cat:ItemProperty)"@en ;
    skos:historyNote "WG approval 25/09/2026"@en ;
    skos:prefLabel "has Classification Code"@en .

:hasClassificationScheme a owl:DatatypeProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "The classification scheme where a property is defined. Additional Information: For example, the following two properties are defined in the ECLASS classification of goods and services: (0173-1#02-AAA026#007) drilling diameter: drilling diameter, (0173-1#02-AAA030#007) flange diameter: flange diameter . (epo-cat:ItemProperty)"@en ;
    skos:historyNote "WG Approval 28/07/2022"@en ;
    skos:prefLabel "has Classification Scheme"@en .

:hasComplementaryItem a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "An item that if used with another item provides mutual enhancements to both of them. Additional information: For example, gin and tonic; or smart-phone and smart-watch."@en ;
    skos:historyNote "WG Approval 19/05/2022"@en ;
    skos:prefLabel "has Complementary Item"@en .

:hasCountryOfOrigin a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "The source country of the product or service. Additional Information: The country of origin can be provided by the buyer as a requirement or by the tenderer information of the item to be provided."@en ;
    skos:prefLabel "has Country Of Origin"@en .

:hasCustomerReference a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "An identifier assigned by the Buyer used for internal routing purposes."@en ;
    skos:historyNote "WG Approval 04/03/2025"@en ;
    skos:prefLabel "has Customer Reference"@en .

:hasDeliveryClassification a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Relation indicating the Delivery Item Type."@en ;
    skos:prefLabel "has Delivery Classification"@en .

:hasDeliveryLocation a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Location delivery area where the Item can be ordered to the given price."@en ;
    skos:prefLabel "has Delivery Location"@en .

:hasDimensionDescription a owl:DatatypeProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Textual description of the item's dimensions. (epo-cat:DimensionInformation)"@en ;
    skos:prefLabel "has Dimension Description"@en .

:hasDocumentStatus a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "https://test-docs.peppol.eu/logistics/transport-execution/codelist/DocumentStatusCode/"@en ;
    skos:prefLabel "has Document Status"@en .

:hasDocumentType a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Relation indicating the Document Type."@en ;
    skos:prefLabel "has Document Type"@en .

:hasEnvironmentalEmissionCode a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Relation indicating the Environmental Emission Code."@en ;
    skos:prefLabel "has Environmental Emission Code"@en .

:hasExpectedDeliveryTime a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "The expected amount of time between the order and delivery of an item."@en ;
    skos:historyNote "WG Approval 26/07/2022"@en ;
    skos:prefLabel "has Expected Delivery Time"@en .

:hasExpiryDate a owl:DatatypeProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "The last day until which the item can be used. (epo-cat:Batch)"@en ;
    skos:historyNote "WG Approval 10/03/2021"@en ;
    skos:prefLabel "has Expiry Date"@en .

:hasFactor a owl:DatatypeProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "The number or the fraction of a related item. (epo-cat:ItemRelation)"@en ;
    skos:prefLabel "has Factor"@en .

:hasFreightCharge a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "The total cost for moving the goods."@en ;
    skos:historyNote "WG Approval 18/06/2024"@en ;
    skos:prefLabel "has Freight Charge"@en .

:hasGrossMonetaryValue a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "The Monetary Value before any deductions."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "has Gross Monetary Value"@en .

:hasHazardousClassID a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Specification of the hazardous nature of an item according to a classification schema. Provides detail of the classification and nature of a hazardous item."@en ;
    skos:prefLabel "has Hazardous Class ID"@en .

:hasHazardousItemUNDGCode a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Specification of the hazardous nature of an item according to the UNDG classification schema. Provides detail of the classification and nature of a hazardous item."@en ;
    skos:prefLabel "has Hazardous Item UNDG Code"@en .

:hasImportanceCode a owl:DatatypeProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "The significance of the instance of the concept expressed as a code. (epo-cat:ItemProperty)"@en ;
    skos:historyNote "WG approval 25/09/2026"@en ;
    skos:prefLabel "has Importance Code"@en .

:hasItemClassification a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "A classification of this item according to a specific system for classifying products or services. Additional information: Examples of classification schemes are: CPV, UNSPC, eCl@ss, GPC, ..."@en ;
    skos:prefLabel "has Item Classification"@en .

:hasItemClassificationIdentifier a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "The Identifier of the Item categorisation."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "has Item Classification Identifier"@en .

:hasItemStandardID a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "The general identifier assigned to the concept based on a standard scheme.​ Additional information: For example the GTIN scheme (Global Trade Item Number)."@en ;
    skos:historyNote "WG Approval 16/05/2023"@en ;
    skos:prefLabel "has Item Standard ID"@en .

:hasKeyword a owl:DatatypeProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "List of words (e.g, synonyms) to make the item searchable. (epo-cat:AbstractItem)"@en ;
    skos:historyNote "WG Approval 07/04/2022"@en ;
    skos:prefLabel "has Keyword"@en .

:hasLiteralValue a owl:DatatypeProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Simple value of the property, which is defined in a classification scheme. Additional Information: For example, the (0173-1#02-AAV139#001) coating 1 of an optical material has value of \"silver\". This simple literal value is for the cases when the property value does not have units, in which case the qualifiedValue shall be used. (epo-cat:ItemProperty)"@en ;
    skos:historyNote "WG Approval 28/07/2022"@en ;
    skos:prefLabel "has Literal Value"@en .

:hasManufactureDate a owl:DatatypeProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "The day of production. (epo-cat:Batch)"@en ;
    skos:prefLabel "has Manufacture Date"@en .

:hasManufacturer a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:prefLabel "has Manufacturer"@en .

:hasManufacturerID a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "The manufacturer's identifier for the item."@en ;
    skos:prefLabel "has Manufacturer ID"@en .

:hasManufacturerItemID a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "The general identifier assigned to the concept as defined by the Manufacturer. ​"@en ;
    skos:historyNote "WG Approval 16/05/2023"@en ;
    skos:prefLabel "has Manufacturer Item ID"@en .

:hasMaximumMeasure a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Relation indicating the upper limit of the measure."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "has Maximum Measure"@en .

:hasMaximumOrderQuantity a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "The maximum number of orderable units that can be ordered according to details provided in the catalogue line, such as price."@en ;
    skos:prefLabel "has Maximum Order Quantity"@en .

:hasMaximumValue a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Relation indicating the upper limit of the numerical quantity."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "has Maximum Value"@en .

:hasMeasure a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Relation indicating the unit used for stating the size."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "has Measure"@en .

:hasMeasuredAttributeCode a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Relation indicating the Measured Attribute Code."@en ;
    skos:prefLabel "has Measured Attribute Code"@en .

:hasMinimumMeasure a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Relation indicating the lower limit of the measure."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "has Minimum Measure"@en .

:hasMinimumQuantityGuaranteedForDelivery a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "The minimum quantity of an item that is guaranteed by the seller to be delivered."@en ;
    skos:prefLabel "has Minimum Quantity Guaranteed For Delivery"@en .

:hasMinimumValue a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Relation indicating the lower limit of the numerical quantity."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "has Minimum Value"@en .

:hasModel a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Relation indicating that the instance of the concept has an Item Model."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "has Model"@en .

:hasNetMonetaryValue a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "The price amount of an Item exclusive of taxes and after subtracting price discounts."@en ;
    skos:prefLabel "has Net Monetary Value"@en .

:hasNetQuantity a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "The net quantity of the item that is contained in each consumable unit, excluding any packaging materials."@en ;
    skos:prefLabel "has Net Quantity"@en .

:hasOrderabableUnitFactorRate a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:prefLabel "has Orderabable Unit Factor Rate"@en .

:hasOrderableQuantityIncrement a owl:DatatypeProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Orderable quantity increment: The increment of Orderable units that can be ordered. (epo-cat:CatalogueLine)"@en ;
    skos:prefLabel "has Orderable Quantity Increment"@en .

:hasOrderableUnit a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "The unit in which the item described in this catalogue line can be ordered."@en ;
    skos:prefLabel "has Orderable Unit"@en .

:hasOrderableUnitFactorRate a owl:DatatypeProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "The factor by which the Item net price of an unit of an item can be converted to the orderable unit. (epo-cat:CatalogueLine)"@en ;
    skos:prefLabel "has Orderable Unit Factor Rate"@en .

:hasPrice a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Relation indicating that the instance of the concept has a Price."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "has Price"@en .

:hasPriceDiscountInformation a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Relation indicating the Allowance Information applied on the Price."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "has Price Discount Information"@en .

:hasPriceSurchargeInformation a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Relation indicating the Charge Information applied on the Price."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "has Price Surcharge Information"@en .

:hasPriceType a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Relation indicating the Price Type."@en ;
    skos:prefLabel "has Price Type"@en .

:hasPriceValidity a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:prefLabel "has Price Validity"@en .

:hasQualifiedItemRelation a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Relation indicating that the instance of the concept has an Item Relation."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "has Qualified Item Relation"@en .

:hasQualifiedValue a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Qualified value of the property, which is defined in a classification scheme. Additional Information: For example, the (0173-1#02-AAA026#007) drilling diameter of an item has value of 12 inches."@en ;
    skos:historyNote "WG Approval 28/07/2022"@en ;
    skos:prefLabel "has Qualified Value"@en .

:hasQuantityThreshold a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:prefLabel "has Quantity Threshold"@en .

:hasResponseDescription a owl:DatatypeProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Explanation of the response. (epo-cat:CatalogueResponse) Explanation of the response. (epo-cat:CatalogueResponseLine)"@en ;
    skos:historyNote "WG Approval 25/03/2025"@en ;
    skos:prefLabel "has Response Description"@en .

:hasResponseStatus a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Relation indicating the response status."@en ;
    skos:prefLabel "has Response Status"@en .

:hasSellerItemID a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "The general identifier assigned to the concept as defined by the Seller.​"@en ;
    skos:historyNote "WG Approval 16/05/2023"@en ;
    skos:prefLabel "has Seller Item ID"@en .

:hasSerialID a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "The identifier assigned to the specific instance of the produced concept."@en ;
    skos:historyNote "WG Approval 16/05/2023"@en ;
    skos:prefLabel "has Serial ID"@en .

:hasSpecificPaymentArrangement a owl:DatatypeProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Information about payment conditions applied to all items in the catalogue. Additional information: This property may need to be used together with the payment arrangements provided in the ContractTerms, where such terms exists. (epo-cat:Catalogue)"@en ;
    skos:historyNote "WG Approval 30/06/2022"@en ;
    skos:prefLabel "has Specific Payment Arrangement"@en .

:hasSpecification a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Relation indicating that the instance of the concept has a Product Specification."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "has Specification"@en .

:hasStandardisedUnitPrice a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "The item price based on a standardised unit. Additional Information: The unit must be indicated in the Quantity, with a quantity value of 1."@en ;
    skos:prefLabel "has Standardised Unit Price"@en .

:hasTaxCategory a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Relation indicating the Tax Category."@en ;
    skos:prefLabel "has Tax Category"@en .

:hasTaxInformation a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Relation indicating the Tax Information."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "has Tax Information"@en .

:hasTaxScheme a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Relation indicating the Tax Scheme."@en ;
    skos:prefLabel "has Tax Scheme"@en .

:hasTransactionConditions a owl:DatatypeProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Textual description of the specific transaction conditions (purchasing, sales, payment, delivery) for an item. (epo-cat:CatalogueLine)"@en ;
    skos:prefLabel "has Transaction Conditions"@en .

:hasTransactionConditionsCode a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Coded description of the specific transaction conditions (purchasing, sales, payment, delivery) for an item."@en ;
    skos:prefLabel "has Transaction Conditions Code"@en .

:hasUUID a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "A universally unique identifier for an instance of this document."@en ;
    skos:historyNote "WG Approval 12/05/2020"@en ;
    skos:prefLabel "has UUID"@en .

:hasValidityPeriod a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "The relation indicating until when a given instance of a concept is applicable."@en ;
    skos:historyNote "WG Approval 30/05/2023"@en ;
    skos:prefLabel "has Validity Period"@en .

:hasWarrantyInformation a owl:DatatypeProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Warranty information that applies to the catalogue line item. (epo-cat:CatalogueLine)"@en ;
    skos:prefLabel "has Warranty Information"@en .

:isContractedItem a owl:DatatypeProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Indicator if the item is offered in accordance to an existing contract. (epo-cat:CatalogueLine)"@en ;
    skos:prefLabel "is Contracted Item"@en .

:isInStock a owl:DatatypeProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Indicator whether an item is in the supplier's stock. If not in stock the supplier has to order the item. (epo-cat:AbstractItem)"@en ;
    skos:prefLabel "is In Stock"@en .

:isOrderable a owl:DatatypeProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Indicator, if the item is orderable or not, e.g. because it is temporarily out of stock. (epo-cat:CatalogueLine)"@en ;
    skos:prefLabel "is Orderable"@en .

:isProductionOf a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Relation indicating the Item that is manufactured."@en ;
    skos:prefLabel "is Production Of"@en .

:isRelatedToItem a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Relation indicating the association with an Item."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "is Related To Item"@en .

:isSpecificToCatalogueResponseLine a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Information that is particular to a Catalogue Response Line."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "is Specific To Catalogue Response Line"@en .

:isSpecificToInvoiceLine a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Information that is particular to an Invoice Line."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "is Specific To Invoice Line"@en .

:isSpecificToLine a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Information that is particular to a Line."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "is Specific To Line"@en .

:isSpecificToOrderLine a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Information that is particular to one or multiple Order Lines."@en ;
    skos:prefLabel "is Specific To Order Line"@en .

:isSubordinatedToContract a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Relation indicating that the instance of the concept is governed by a specific Contract."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "is Subordinated To Contract"@en .

:refersToCatalogue a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Additional information: If an order refers to multiple catalogues then all these catalogues ideally are subordinated to the same contract. Some countries however may allow multiple contracts per order (i.e Italy)."@en ;
    skos:prefLabel "refers To Catalogue"@en .

:refersToCatalogueLine a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Additional Information: The reference to the catalogue line is for information only, to trace the source of the information provided in the order line."@en,
        "Reference to a Catalogue Line."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "refers To Catalogue Line"@en .

:specifiesBuyer a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Relation indicating that the instance of the concept involves the Buyer."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "specifies Buyer"@en .

:specifiesCatalogueProvider a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Relation indicating that the instance of the concept involves the Catalogue Provider."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "specifies Catalogue Provider"@en .

:specifiesCatalogueReceiver a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Relation indicating that the instance of the concept involves the Catalogue Receiver."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "specifies Catalogue Receiver"@en .

:specifiesCatalogueResponseInformation a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Relation indicating the Catalogue Response Information."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "specifies Catalogue Response Information"@en .

:specifiesChargeInformation a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Relation indicating the Charge Information."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "specifies Charge Information"@en .

:specifiesItem a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Relation indicating the Item."@en ;
    skos:prefLabel "specifies Item"@en .

:specifiesSeller a owl:ObjectProperty ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Relation indicating that the instance of the concept involves the Seller."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "specifies Seller"@en .

:AbstractItem a owl:Class ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Gathering class for the Items, Item Requests and Deliverables. Additional information: The subclasses have in common that they are related to a procurement need."@en ;
    skos:historyNote "WG approval 09/10/2025"@en ;
    skos:prefLabel "Abstract Item"@en .

:Catalogue a owl:Class ;
    rdfs:isDefinedBy :cat ;
    rdfs:subClassOf :Document ;
    skos:definition "A phase-agnostic Document describing a set of Items offered for purchase that can be processed in an electronic way."@en ;
    skos:prefLabel "Catalogue"@en .

:Line a owl:Class ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Component of a document providing specific information."@en ;
    skos:historyNote "WG approval 11/09/2025"@en ;
    skos:prefLabel "Line"@en .

:ItemRelation a owl:Class ;
    rdfs:isDefinedBy :cat ;
    skos:definition "Connection between two Items."@en ;
    skos:historyNote "WG Approval 30/06/2022"@en ;
    skos:prefLabel "Item Relation"@en .

:cat a owl:Ontology ;
    rdfs:label "eProcurement Ontology Catalogue - core"@en ;
    dcterms:created "2021-06-01"^^xsd:date ;
    dcterms:description "The eProcurement Ontology Catalogue core describes the concepts and properties representing the European Public Procurement Catalogue domain. The provision of these semantics offers the basis for a common understanding of the domain for all stakeholders ensuring the quality of data exchange and transparency. The ontology restrictions are published in a separate artefact."@en ;
    dcterms:issued "2025-10-10"^^xsd:date ;
    dcterms:license "© European Union, 2014. Unless otherwise noted, the reuse of the Ontology is authorised under the European Union Public Licence v1.2 (https://eupl.eu/)." ;
    dcterms:publisher "http://publications.europa.eu/resource/authority/corporate-body/PUBL" ;
    dcterms:title "eProcurement Ontology Catalogue - core"@en ;
    vann:preferredNamespacePrefix "epo" ;
    vann:preferredNamespaceUri "http://data.europa.eu/a4g/ontology#" ;
    rdfs:comment "This version is automatically generated from eCatalogue.xml on 2025-10-10" ;
    rdfs:seeAlso <https://docs.ted.europa.eu/home/index.html>,
        <https://github.com/OP-TED/ePO/releases>,
        <https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology/about>,
        <https://op.europa.eu/en/web/eu-vocabularies/e-procurement> ;
    owl:imports :core,
        :ful,
        :ord,
        eli:,
        cccev:,
        dcterms:,
        skos:,
        <http://www.w3.org/2006/time>,
        <http://www.w3.org/ns/adms>,
        <http://www.w3.org/ns/locn>,
        org:,
        <http://www.w3.org/ns/person> ;
    owl:incompatibleWith "4.2.0" ;
    owl:priorVersion "http://data.europa.eu/a4g/ontology#cat-5.1.0" ;
    owl:versionIRI :cat-5.2.0 ;
    owl:versionInfo "5.2.0" .

