@prefix : <http://data.europa.eu/a4g/ontology#> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:cat-restriction a owl:Ontology ;
    rdfs:label """This artefact provides the restrictions and inference-related specifications for the eProcurement Ontology Core.
        This artefact excludes the definitions of concepts.
        The eProcurement Ontology describes objects and concepts, with definitions, attributes and relationships which are present within the European public procurement domain.
        The provision of these concepts provides the basis for a common understanding of the domain for all stakeholders ensuring the quality of data exchange and transparency."""@en ;
    dcterms:created "2025-09-04"^^xsd:date ;
    dcterms:description """This artefact provides the restrictions and inference-related specifications for the eProcurement Ontology Core.
        This artefact excludes the definitions of concepts.
        The eProcurement Ontology describes objects and concepts, with definitions, attributes and relationships which are present within the European public procurement domain.
        The provision of these concepts provides the basis for a common understanding of the domain for all stakeholders ensuring the quality of data exchange and transparency."""@en ;
    dcterms:issued "2025-09-04"^^xsd:date ;
    dcterms:license "CC BY 4.0" ;
    dcterms:publisher "http://publications.europa.eu/resource/authority/corporate-body/PUBL" ;
    dcterms:title "ePO Core restrictions"@en ;
    vann:preferredNamespacePrefix "epo" ;
    vann:preferredNamespaceUri "http://data.europa.eu/a4g/ontology#" ;
    rdfs:comment """This version is automatically generated from eCatalogue.xml on 
                2025-09-25""" ;
    rdfs:seeAlso <https://docs.ted.europa.eu/EPO/latest/index.html>,
        <https://github.com/eprocurementontology/eprocurementontology>,
        <https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology/about>,
        <https://op.europa.eu/en/web/eu-vocabularies/e-procurement> ;
    owl:imports :cat,
        dcterms:,
        skos:,
        <http://www.w3.org/ns/adms>,
        <https://data.europa.eu/m8g> ;
    owl:incompatibleWith "2.1.0" ;
    owl:priorVersion "http://data.europa.eu/a4g/ontology#cat-restriction-3.0.1" ;
    owl:versionIRI :cat-restriction-3.1.0 ;
    owl:versionInfo "3.1.0" .

:comprisesCatalogueResponseLine rdfs:domain :CatalogueResponse ;
    rdfs:range :CatalogueResponseLine .

:hasAccessoryItem a owl:AsymmetricProperty ;
    rdfs:domain :AbstractItem ;
    rdfs:range :AbstractItem .

:hasActivityCode rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Catalogue :CatalogueLine ) ] ;
    rdfs:range skos:Concept .

:hasCertification rdfs:domain :AbstractItem ;
    rdfs:range :Certificate .

:hasChargeInformation rdfs:domain :CatalogueLine ;
    rdfs:range :ChargeInformation .

:hasComplementaryItem a owl:AsymmetricProperty ;
    rdfs:domain :AbstractItem ;
    rdfs:range :AbstractItem .

:hasCountryOfOrigin rdfs:domain :AbstractItem ;
    rdfs:range skos:Concept .

:hasDeliveryClassification rdfs:domain :AbstractItem ;
    rdfs:range skos:Concept .

:hasDeliveryLocation rdfs:domain :Price ;
    rdfs:range dcterms:Location .

:hasDocumentStatus rdfs:domain :PostAwardDocument ;
    rdfs:range skos:Concept .

:hasDocumentType rdfs:domain :Document ;
    rdfs:range skos:Concept .

:hasEnvironmentalEmissionCode a owl:FunctionalProperty ;
    rdfs:domain :EnvironmentalEmissionInformation ;
    rdfs:range skos:Concept .

:hasFreightCharge rdfs:domain :Consignment ;
    rdfs:range :ChargeInformation .

:hasHazardousClassID rdfs:domain :AbstractItem ;
    rdfs:range adms:Identifier .

:hasHazardousItemUNDGCode rdfs:domain :AbstractItem ;
    rdfs:range skos:Concept .

:hasItemClassification rdfs:domain :AbstractItem ;
    rdfs:range skos:Concept .

:hasItemClassificationIdentifier rdfs:domain :AbstractItem ;
    rdfs:range adms:Identifier .

:hasItemStandardID rdfs:domain :AbstractItem ;
    rdfs:range adms:Identifier .

:hasKeyword rdfs:domain :AbstractItem ;
    rdfs:range rdf:PlainLiteral .

:hasLiteralValue rdfs:domain :ItemProperty ;
    rdfs:range rdf:PlainLiteral .

:hasMeasuredAttributeCode a owl:FunctionalProperty ;
    rdfs:domain :DimensionInformation ;
    rdfs:range skos:Concept .

:hasOrderableUnit rdfs:domain :CatalogueLine ;
    rdfs:range skos:Concept .

:hasPriceType rdfs:domain :Price ;
    rdfs:range skos:Concept .

:hasQualifiedItemRelation rdfs:domain :AbstractItem ;
    rdfs:range :ItemRelation .

:hasResponseStatus a owl:FunctionalProperty ;
    rdfs:domain :CatalogueResponseInformation ;
    rdfs:range skos:Concept .

:hasSpecification rdfs:domain :AbstractItem ;
    rdfs:range :ProductSpecification .

:hasStandardisedUnitPrice rdfs:domain :CatalogueLine ;
    rdfs:range :Price .

:hasTaxCategory rdfs:domain :TaxInformation ;
    rdfs:range skos:Concept .

:hasTaxInformation rdfs:domain :AbstractItem ;
    rdfs:range :TaxInformation .

:hasTaxScheme a owl:FunctionalProperty ;
    rdfs:domain :TaxInformation ;
    rdfs:range skos:Concept .

:hasTransactionConditionsCode rdfs:domain :CatalogueLine ;
    rdfs:range skos:Concept .

:isSpecificToInvoiceLine rdfs:domain :ChargeInformation ;
    rdfs:range :InvoiceLine .

:isSpecificToLine rdfs:domain :InformationHub ;
    rdfs:range :Line .

:isSpecificToOrderLine rdfs:domain :ChargeInformation ;
    rdfs:range :OrderLine .

:specifiesBuyer rdfs:domain :Catalogue ;
    rdfs:range :Buyer .

:specifiesChargeInformation rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Invoice :Order ) ] ;
    rdfs:range :ChargeInformation .

:specifiesSeller rdfs:domain :Catalogue ;
    rdfs:range :Seller .

:RequestForOffer rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass :Catalogue ;
            owl:onProperty :refersToCatalogue ] .

:comprisesCatalogueLine rdfs:domain :Catalogue ;
    rdfs:range :CatalogueLine .

:concernsGoodsItem rdfs:domain :DimensionInformation ;
    rdfs:range :GoodsItem .

:concernsPackage rdfs:domain :DimensionInformation ;
    rdfs:range :Package .

:concernsTransportEquipment rdfs:domain :DimensionInformation ;
    rdfs:range :TransportEquipment .

:describesItem a owl:FunctionalProperty ;
    rdfs:domain :ItemProperty ;
    rdfs:range :AbstractItem .

:foreseesPackage rdfs:domain :CatalogueLine ;
    rdfs:range :Package .

:hasAdditionalInformation rdfs:domain :Line ;
    rdfs:range rdf:PlainLiteral .

:hasAssociatedDocument rdfs:domain :Line ;
    rdfs:range :Document .

:hasAttributeType rdfs:domain :ItemProperty ;
    rdfs:range rdf:PlainLiteral .

:hasBaseQuantity rdfs:domain :Price ;
    rdfs:range :Quantity .

:hasBatchID rdfs:domain :Batch ;
    rdfs:range adms:Identifier .

:hasBestBeforeDate rdfs:domain :Batch ;
    rdfs:range xsd:date .

:hasBrand rdfs:domain :AbstractItem ;
    rdfs:range :Brand .

:hasBuyerItemID rdfs:domain :AbstractItem ;
    rdfs:range adms:Identifier .

:hasCalculationMethod rdfs:domain :EnvironmentalEmissionInformation ;
    rdfs:range rdf:PlainLiteral .

:hasCatalogueLineValidity rdfs:domain :CatalogueLine ;
    rdfs:range time:Interval .

:hasClassificationCode rdfs:domain :ItemProperty ;
    rdfs:range rdf:PlainLiteral .

:hasClassificationScheme rdfs:domain :ItemProperty ;
    rdfs:range rdf:PlainLiteral .

:hasCustomerReference rdfs:domain :PostAwardDocument ;
    rdfs:range adms:Identifier .

:hasDimensionDescription rdfs:domain :DimensionInformation ;
    rdfs:range rdf:PlainLiteral .

:hasExpectedDeliveryTime rdfs:domain :Price ;
    rdfs:range time:Duration .

:hasExpiryDate rdfs:domain :Batch ;
    rdfs:range xsd:date .

:hasFactor rdfs:domain :ItemRelation ;
    rdfs:range xsd:decimal .

:hasGrossMonetaryValue rdfs:domain :Price ;
    rdfs:range :MonetaryValue .

:hasImportanceCode rdfs:domain :ItemProperty ;
    rdfs:range xsd:integer .

:hasManufactureDate rdfs:domain :Batch ;
    rdfs:range xsd:dateTime .

:hasManufacturer rdfs:domain :AbstractItem ;
    rdfs:range :Manufacturer .

:hasManufacturerID rdfs:domain :Manufacturer ;
    rdfs:range adms:Identifier .

:hasManufacturerItemID rdfs:domain :AbstractItem ;
    rdfs:range adms:Identifier .

:hasMaximumMeasure rdfs:domain :DimensionInformation ;
    rdfs:range :Quantity .

:hasMaximumOrderQuantity rdfs:domain :CatalogueLine ;
    rdfs:range :Quantity .

:hasMaximumValue rdfs:domain :ItemProperty ;
    rdfs:range :Quantity .

:hasMinimumMeasure rdfs:domain :DimensionInformation ;
    rdfs:range :Quantity .

:hasMinimumQuantityGuaranteedForDelivery rdfs:domain :CatalogueLine ;
    rdfs:range :Quantity .

:hasMinimumValue rdfs:domain :ItemProperty ;
    rdfs:range :Quantity .

:hasModel rdfs:domain :AbstractItem ;
    rdfs:range :ItemModel .

:hasNetMonetaryValue a owl:FunctionalProperty ;
    rdfs:domain :Price ;
    rdfs:range :MonetaryValue .

:hasNetQuantity rdfs:domain :AbstractItem ;
    rdfs:range :Quantity .

:hasOrderabableUnitFactorRate rdfs:domain :Price ;
    rdfs:range :Quantity .

:hasOrderableQuantityIncrement rdfs:domain :CatalogueLine ;
    rdfs:range xsd:integer .

:hasOrderableUnitFactorRate rdfs:domain :CatalogueLine ;
    rdfs:range xsd:decimal .

:hasPrice rdfs:domain [ a owl:Class ;
            owl:unionOf ( :InvoiceLine :OrderLine :CatalogueLine ) ] ;
    rdfs:range :Price .

:hasPriceDiscountInformation rdfs:domain :Price ;
    rdfs:range :AllowanceInformation .

:hasPriceSurchargeInformation rdfs:domain :Price ;
    rdfs:range :ChargeInformation .

:hasPriceValidity a owl:FunctionalProperty ;
    rdfs:domain :Price ;
    rdfs:range time:Interval .

:hasQualifiedValue rdfs:domain :ItemProperty ;
    rdfs:range :Quantity .

:hasQuantityThreshold rdfs:domain :Price ;
    rdfs:range :Quantity .

:hasSellerItemID rdfs:domain :AbstractItem ;
    rdfs:range adms:Identifier .

:hasSerialID rdfs:domain :AbstractItem ;
    rdfs:range adms:Identifier .

:hasSpecificPaymentArrangement rdfs:domain :Catalogue ;
    rdfs:range rdf:PlainLiteral .

:hasTransactionConditions rdfs:domain :CatalogueLine ;
    rdfs:range rdf:PlainLiteral .

:hasUUID a owl:FunctionalProperty ;
    rdfs:domain :CatalogueResponseLine ;
    rdfs:range adms:Identifier .

:hasValidityPeriod rdfs:domain :Catalogue ;
    rdfs:range time:Interval .

:hasWarrantyInformation rdfs:domain :CatalogueLine ;
    rdfs:range rdf:PlainLiteral .

:isContractedItem rdfs:domain :CatalogueLine ;
    rdfs:range xsd:boolean .

:isInStock rdfs:domain :AbstractItem ;
    rdfs:range xsd:boolean .

:isOrderable rdfs:domain :CatalogueLine ;
    rdfs:range xsd:boolean .

:isProductionOf a owl:FunctionalProperty ;
    rdfs:domain :Batch ;
    rdfs:range :AbstractItem .

:isRelatedToItem a owl:FunctionalProperty ;
    rdfs:domain :ItemRelation ;
    rdfs:range :AbstractItem .

:isSpecificToCatalogueResponseLine rdfs:domain :CatalogueResponseInformation ;
    rdfs:range :CatalogueResponseLine .

:isSubordinatedToContract rdfs:domain :PostAwardCatalogue ;
    rdfs:range :Contract .

:specifiesCatalogueResponseInformation a owl:FunctionalProperty ;
    rdfs:domain :CatalogueResponse ;
    rdfs:range :CatalogueResponseInformation .

:specifiesItem a owl:FunctionalProperty ;
    rdfs:domain :Line ;
    rdfs:range :AbstractItem .

:Brand rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty dcterms:title ;
            owl:qualifiedCardinality 1 ] .

:InvoiceLine rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasPrice ;
            owl:someValuesFrom :Price ] .

:ItemModel rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty dcterms:title ;
            owl:qualifiedCardinality 1 ] .

:concernsItem rdfs:domain [ a owl:Class ;
            owl:unionOf ( :DimensionInformation :EnvironmentalEmissionInformation ) ] ;
    rdfs:range :AbstractItem .

:concernsTransportMeans rdfs:domain [ a owl:Class ;
            owl:unionOf ( :DimensionInformation :EnvironmentalEmissionInformation ) ] ;
    rdfs:range :TransportMeans .

:hasMeasure a owl:FunctionalProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :DimensionInformation :EnvironmentalEmissionInformation ) ] ;
    rdfs:range :Quantity .

:hasResponseDescription rdfs:domain [ a owl:Class ;
            owl:unionOf ( :CatalogueResponse :CatalogueResponseLine ) ] ;
    rdfs:range rdf:PlainLiteral .

:refersToCatalogue a owl:FunctionalProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :RequestForOffer :CatalogueResponse :Order ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( :Catalogue :PostAwardCatalogue ) ] .

:refersToCatalogueLine a owl:FunctionalProperty ;
    rdfs:domain :CatalogueResponseLine,
        :OrderLine ;
    rdfs:range :CatalogueLine .

:specifiesCatalogueProvider a owl:FunctionalProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Catalogue :CatalogueResponse ) ] ;
    rdfs:range :CatalogueProvider .

:specifiesCatalogueReceiver a owl:FunctionalProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Catalogue :CatalogueResponse ) ] ;
    rdfs:range :CatalogueReceiver .

:ItemRelation rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :AbstractItem ;
            owl:onProperty :isRelatedToItem ;
            owl:qualifiedCardinality 1 ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty :hasFactor ] .

:Manufacturer rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass adms:Identifier ;
            owl:onProperty :hasManufacturerID ] .

:OrderLine rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass :CatalogueLine ;
            owl:onProperty :refersToCatalogueLine ] .

:PostAwardCatalogue rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass :Contract ;
            owl:onProperty :isSubordinatedToContract ] .

:PostAwardDocument rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass adms:Identifier ;
            owl:onProperty :hasCustomerReference ] .

:CatalogueResponseInformation rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass :CatalogueResponseLine ;
            owl:onProperty :isSpecificToCatalogueResponseLine ] .

:Line rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass :Document ;
            owl:onProperty :hasAssociatedDocument ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass adms:Identifier ;
            owl:onProperty adms:identifier ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty dcterms:description ],
        [ a owl:Restriction ;
            owl:onClass :AbstractItem ;
            owl:onProperty :specifiesItem ;
            owl:qualifiedCardinality 1 ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty :hasAdditionalInformation ] .

:Batch rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onDataRange xsd:dateTime ;
            owl:onProperty :hasManufactureDate ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass adms:Identifier ;
            owl:onProperty :hasBatchID ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onDataRange xsd:date ;
            owl:onProperty :hasExpiryDate ],
        [ a owl:Restriction ;
            owl:onClass :AbstractItem ;
            owl:onProperty :isProductionOf ;
            owl:qualifiedCardinality 1 ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onDataRange xsd:date ;
            owl:onProperty :hasBestBeforeDate ] .

:EnvironmentalEmissionInformation rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty :hasCalculationMethod ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass :TransportMeans ;
            owl:onProperty :concernsTransportMeans ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass :AbstractItem ;
            owl:onProperty :concernsItem ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty dcterms:title ],
        [ a owl:Restriction ;
            owl:onClass :Quantity ;
            owl:onProperty :hasMeasure ;
            owl:qualifiedCardinality 1 ] .

:CatalogueResponse rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :CatalogueReceiver ;
            owl:onProperty :specifiesCatalogueReceiver ;
            owl:qualifiedCardinality 1 ],
        [ a owl:Restriction ;
            owl:onClass :PostAwardCatalogue ;
            owl:onProperty :refersToCatalogue ;
            owl:qualifiedCardinality 1 ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty :hasResponseDescription ],
        [ a owl:Restriction ;
            owl:onClass :CatalogueResponseInformation ;
            owl:onProperty :specifiesCatalogueResponseInformation ;
            owl:qualifiedCardinality 1 ],
        [ a owl:Restriction ;
            owl:onClass :CatalogueProvider ;
            owl:onProperty :specifiesCatalogueProvider ;
            owl:qualifiedCardinality 1 ] .

:CatalogueResponseLine rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :CatalogueLine ;
            owl:onProperty :refersToCatalogueLine ;
            owl:qualifiedCardinality 1 ],
        [ a owl:Restriction ;
            owl:onClass adms:Identifier ;
            owl:onProperty :hasUUID ;
            owl:qualifiedCardinality 1 ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty :hasResponseDescription ] .

:ItemProperty rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty :hasAttributeType ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty :hasClassificationScheme ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty :hasClassificationCode ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass :Quantity ;
            owl:onProperty :hasMaximumValue ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass adms:Identifier ;
            owl:onProperty adms:identifier ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass :Quantity ;
            owl:onProperty :hasMinimumValue ],
        [ a owl:Restriction ;
            owl:onClass :AbstractItem ;
            owl:onProperty :describesItem ;
            owl:qualifiedCardinality 1 ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty dcterms:title ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass :Quantity ;
            owl:onProperty :hasQualifiedValue ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onDataRange xsd:integer ;
            owl:onProperty :hasImportanceCode ] .

:DimensionInformation rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass :Quantity ;
            owl:onProperty :hasMinimumMeasure ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass :Quantity ;
            owl:onProperty :hasMaximumMeasure ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass :Quantity ;
            owl:onProperty :hasMeasure ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass :AbstractItem ;
            owl:onProperty :concernsItem ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass :Package ;
            owl:onProperty :concernsPackage ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass :TransportMeans ;
            owl:onProperty :concernsTransportMeans ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass :GoodsItem ;
            owl:onProperty :concernsGoodsItem ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty :hasDimensionDescription ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass :TransportEquipment ;
            owl:onProperty :concernsTransportEquipment ] .

:Catalogue rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass :CatalogueReceiver ;
            owl:onProperty :specifiesCatalogueReceiver ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass :CatalogueProvider ;
            owl:onProperty :specifiesCatalogueProvider ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty :hasSpecificPaymentArrangement ],
        [ a owl:Restriction ;
            owl:onProperty :comprisesCatalogueLine ;
            owl:someValuesFrom :CatalogueLine ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass time:Interval ;
            owl:onProperty :hasValidityPeriod ] .

:Price rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass time:Duration ;
            owl:onProperty :hasExpectedDeliveryTime ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :hasGrossMonetaryValue ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass :Quantity ;
            owl:onProperty :hasOrderabableUnitFactorRate ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass :Quantity ;
            owl:onProperty :hasQuantityThreshold ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass :AllowanceInformation ;
            owl:onProperty :hasPriceDiscountInformation ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass :Quantity ;
            owl:onProperty :hasBaseQuantity ],
        [ a owl:Restriction ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :hasNetMonetaryValue ;
            owl:qualifiedCardinality 1 ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass :ChargeInformation ;
            owl:onProperty :hasPriceSurchargeInformation ],
        [ a owl:Restriction ;
            owl:onClass time:Interval ;
            owl:onProperty :hasPriceValidity ;
            owl:qualifiedCardinality 1 ] .

:CatalogueLine rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty :isOrderable ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass :Package ;
            owl:onProperty :foreseesPackage ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass :Quantity ;
            owl:onProperty :hasMaximumOrderQuantity ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onDataRange xsd:integer ;
            owl:onProperty :hasOrderableQuantityIncrement ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass :Quantity ;
            owl:onProperty :hasMinimumQuantityGuaranteedForDelivery ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty :isContractedItem ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty :hasOrderableUnitFactorRate ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty :hasWarrantyInformation ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass time:Interval ;
            owl:onProperty :hasCatalogueLineValidity ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty :hasTransactionConditions ] .

:AbstractItem rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass adms:Identifier ;
            owl:onProperty :hasBuyerItemID ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty :isInStock ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass adms:Identifier ;
            owl:onProperty :hasSerialID ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass :Brand ;
            owl:onProperty :hasBrand ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass :ItemModel ;
            owl:onProperty :hasModel ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass adms:Identifier ;
            owl:onProperty :hasSellerItemID ],
        [ a owl:Restriction ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty dcterms:title ;
            owl:qualifiedCardinality 1 ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass :Manufacturer ;
            owl:onProperty :hasManufacturer ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass adms:Identifier ;
            owl:onProperty :hasManufacturerItemID ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass :Quantity ;
            owl:onProperty :hasNetQuantity ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty dcterms:description ] .

[] a owl:AllDisjointClasses ;
    owl:members ( :Catalogue :ProductSpecification :PostAwardDocument ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :CatalogueLine :CatalogueResponseLine ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :ItemAccessoryRelation :ItemComplementaryRelation :ItemComposition :ItemReplacement :ItemRequirement ) .

