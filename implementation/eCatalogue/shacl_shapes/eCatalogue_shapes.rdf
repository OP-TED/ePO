  <rdf:Description rdf:about="http://data.europa.eu/a4g/data-shape#epo-cat-Price-epo-cat-hasOrderabableUnitFactorRate">
    <sh:class rdf:resource="http://data.europa.eu/a4g/ontology#Quantity"/>
    <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
    <sh:sparql rdf:nodeID="Ne30c9693a4e14d1c941637e2a4a84be6"/>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
    <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#hasOrderabableUnitFactorRate"/>
    <sh:name>has Orderabable Unit Factor Rate</sh:name>
    <sh:description>The factor by which the base unit of the price can be converted to orderable unit. Additional information: This is needed when the base price is provided different than the orderable unit. For example, when selling paper, the price may be set per page, but the orderable unit is a package of 500 pieces. Therefore the price needs to be converted to the orderable unit.</sh:description>
  </rdf:Description>
