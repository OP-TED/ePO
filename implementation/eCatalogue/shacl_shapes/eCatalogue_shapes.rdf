  <rdf:Description rdf:about="http://data.europa.eu/a4g/data-shape#epo-cat-AbstractItem-epo-cat-hasComplementaryItem">
    <sh:class rdf:resource="http://data.europa.eu/a4g/ontology#AbstractItem"/>
