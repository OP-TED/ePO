    <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-cat-AbstractItem-epo-cat-hasBrand"/>
    <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-cat-AbstractItem-epo-cat-hasModel"/>
    <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-cat-AbstractItem-epo-cat-hasDeliveryClassification"/>
