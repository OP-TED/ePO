    <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-cat-AbstractItem-epo-cat-hasHazardousClassID"/>
    <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-cat-AbstractItem-epo-cat-hasNetQuantity"/>
    <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-cat-AbstractItem-epo-ord-hasTaxInformation"/>
