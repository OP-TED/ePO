    <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-cat-AbstractItem-epo-cat-hasSpecification"/>
    <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-cat-AbstractItem-epo-cat-hasManufacturer"/>
