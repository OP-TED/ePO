@prefix : <http://data.europa.eu/a4g/ontology#> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix cat-shape: <http://data.europa.eu/a4g/data-shape#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cat-shape:epo-DocumentShape sh:property cat-shape:epo-Document-epo-hasDocumentType .

cat-shape:epo-cat-AbstractItemShape a sh:NodeShape ;
    rdfs:label "Abstract item" ;
    rdfs:comment "A product, work, service or any combination of them. Additional Information: An Item can be an atomic Thing or a composition of things that together are seen as a unit, e.g. a tetrabrik of milk or an indivisible package of six tetrabriks. No distinction is provided between services, goods and works to leave room for innovation." ;
    rdfs:isDefinedBy cat-shape:cat-shape ;
    sh:property cat-shape:epo-cat-AbstractItem-epo-cat-hasAccessoryItem,
        cat-shape:epo-cat-AbstractItem-epo-cat-hasBrand,
        cat-shape:epo-cat-AbstractItem-epo-cat-hasComplementaryItem,
        cat-shape:epo-cat-AbstractItem-epo-cat-hasCountryOfOrigin,
        cat-shape:epo-cat-AbstractItem-epo-cat-hasDeliveryClassification,
        cat-shape:epo-cat-AbstractItem-epo-cat-hasHazardousClassID,
        cat-shape:epo-cat-AbstractItem-epo-cat-hasHazardousItemUNDGCode,
        cat-shape:epo-cat-AbstractItem-epo-cat-hasItemClassification,
        cat-shape:epo-cat-AbstractItem-epo-cat-hasKeyword,
        cat-shape:epo-cat-AbstractItem-epo-cat-hasManufacturer,
        cat-shape:epo-cat-AbstractItem-epo-cat-hasModel,
        cat-shape:epo-cat-AbstractItem-epo-cat-hasNetQuantity,
        cat-shape:epo-cat-AbstractItem-epo-cat-hasQualifiedItemRelation,
        cat-shape:epo-cat-AbstractItem-epo-cat-hasSpecification,
        cat-shape:epo-cat-AbstractItem-epo-cat-isInStock,
        cat-shape:epo-cat-AbstractItem-epo-hasBuyerItemID,
        cat-shape:epo-cat-AbstractItem-epo-hasCertification,
        cat-shape:epo-cat-AbstractItem-epo-hasItemStandardID,
        cat-shape:epo-cat-AbstractItem-epo-hasManufacturerItemID,
        cat-shape:epo-cat-AbstractItem-epo-hasSellerItemID,
        cat-shape:epo-cat-AbstractItem-epo-hasSerialID,
        cat-shape:epo-cat-AbstractItem-epo-inv-hasItemClassificationIdentifier,
        cat-shape:epo-cat-AbstractItem-epo-ord-hasTaxInformation ;
    sh:targetClass :AbstractItem .

cat-shape:epo-cat-BatchShape a sh:NodeShape ;
    rdfs:label "Batch" ;
    rdfs:comment "A production Lot in which the Item instances were produced." ;
    rdfs:isDefinedBy cat-shape:cat-shape ;
    sh:property cat-shape:epo-cat-Batch-epo-cat-hasBestBeforeDate,
        cat-shape:epo-cat-Batch-epo-cat-hasExpiryDate,
        cat-shape:epo-cat-Batch-epo-cat-hasManufactureDate,
        cat-shape:epo-cat-Batch-epo-cat-isProductionOf,
        cat-shape:epo-cat-Batch-epo-hasBatchID ;
    sh:targetClass :Batch .

cat-shape:epo-cat-BrandShape a sh:NodeShape ;
    rdfs:label "Brand" ;
    rdfs:comment "Name given by an organisation to its product or service, or range of products or services. Additional information: Brand name allows economic operators to distinctively describe an item in their eCatalogue. This may be different from the \"item name\"." ;
    rdfs:isDefinedBy cat-shape:cat-shape ;
    sh:targetClass :Brand .

cat-shape:epo-cat-CatalogueLineShape a sh:NodeShape ;
    rdfs:label "Catalogue line" ;
    rdfs:comment "Aggregated information about the Terms and specifications for procuring an Item. Details about an Item, like Prices, packaging, discounts, special promotions, etc. TC 440: Detailed information of an Item, Price and its composition in a Catalogue. Composition: e.g. information referring to its description, how to order it, what it is made of, properties, delivery conditions, etc." ;
    rdfs:isDefinedBy cat-shape:cat-shape ;
    sh:property cat-shape:epo-cat-CatalogueLine-epo-cat-foreseesPackage,
        cat-shape:epo-cat-CatalogueLine-epo-cat-hasActivityCode,
        cat-shape:epo-cat-CatalogueLine-epo-cat-hasCatalogueLineValidity,
        cat-shape:epo-cat-CatalogueLine-epo-cat-hasChargeInformation,
        cat-shape:epo-cat-CatalogueLine-epo-cat-hasMaximumOrderQuantity,
        cat-shape:epo-cat-CatalogueLine-epo-cat-hasMinimumQuantityGuaranteedForDelivery,
        cat-shape:epo-cat-CatalogueLine-epo-cat-hasOrderableQuantityIncrement,
        cat-shape:epo-cat-CatalogueLine-epo-cat-hasOrderableUnit,
        cat-shape:epo-cat-CatalogueLine-epo-cat-hasOrderableUnitFactorRate,
        cat-shape:epo-cat-CatalogueLine-epo-cat-hasPrice,
        cat-shape:epo-cat-CatalogueLine-epo-cat-hasStandardisedUnitPrice,
        cat-shape:epo-cat-CatalogueLine-epo-cat-hasTransactionConditions,
        cat-shape:epo-cat-CatalogueLine-epo-cat-hasTransactionConditionsCode,
        cat-shape:epo-cat-CatalogueLine-epo-cat-hasWarrantyInformation,
        cat-shape:epo-cat-CatalogueLine-epo-cat-isContractedItem,
        cat-shape:epo-cat-CatalogueLine-epo-cat-isOrderable ;
    sh:targetClass :CatalogueLine .

cat-shape:epo-cat-CatalogueResponseInformationShape a sh:NodeShape ;
    rdfs:label "Catalogue response information" ;
    rdfs:isDefinedBy cat-shape:cat-shape ;
    sh:property cat-shape:epo-cat-CatalogueResponseInformation-epo-cat-isSpecificToCatalogueResponseLine,
        cat-shape:epo-cat-CatalogueResponseInformation-epo-ord-hasResponseStatus ;
    sh:targetClass :CatalogueResponseInformation .

cat-shape:epo-cat-CatalogueResponseLineShape a sh:NodeShape ;
    rdfs:label "Catalogue response line" ;
    rdfs:comment "Details concerning the Catalogue Receiver’s ability to apply a given Catalogue Line for placing orders. Additional information: The Catalogue Response Line is used to inform on the acceptance or rejection of a Catalogue Line." ;
    rdfs:isDefinedBy cat-shape:cat-shape ;
    sh:property cat-shape:epo-cat-CatalogueResponseLine-epo-cat-refersToCatalogueLine,
        cat-shape:epo-cat-CatalogueResponseLine-epo-hasUUID,
        cat-shape:epo-cat-CatalogueResponseLine-epo-ord-hasResponseDescription ;
    sh:targetClass :CatalogueResponseLine .

cat-shape:epo-cat-CatalogueResponseShape a sh:NodeShape ;
    rdfs:label "Catalogue response" ;
    rdfs:comment "A formal reply from the Catalogue Receiver to the Catalogue Provider stating the Catalogue Receiver's ability to apply the catalogue for placing orders. Additional Information: The Catalogue Response is used to inform on the acceptance or rejection of a Catalogue." ;
    rdfs:isDefinedBy cat-shape:cat-shape ;
    sh:property cat-shape:epo-cat-CatalogueResponse-epo-cat-comprisesCatalogueResponseLine,
        cat-shape:epo-cat-CatalogueResponse-epo-cat-refersToCatalogue,
        cat-shape:epo-cat-CatalogueResponse-epo-cat-specifiesCatalogueResponseInformation,
        cat-shape:epo-cat-CatalogueResponse-epo-ord-hasResponseDescription,
        cat-shape:epo-cat-CatalogueResponse-epo-specifiesCatalogueProvider,
        cat-shape:epo-cat-CatalogueResponse-epo-specifiesCatalogueReceiver ;
    sh:targetClass :CatalogueResponse .

cat-shape:epo-cat-CatalogueShape a sh:NodeShape ;
    rdfs:label "Catalogue" ;
    rdfs:comment "A phase-agnostic Document describing a set of Items offered for purchase that can be processed in an electronic way." ;
    rdfs:isDefinedBy cat-shape:cat-shape ;
    sh:property cat-shape:epo-cat-Catalogue-epo-cat-comprisesCatalogueLine,
        cat-shape:epo-cat-Catalogue-epo-cat-hasActivityCode,
        cat-shape:epo-cat-Catalogue-epo-cat-hasSpecificPaymentArrangement,
        cat-shape:epo-cat-Catalogue-epo-hasValidityPeriod,
        cat-shape:epo-cat-Catalogue-epo-specifiesBuyer,
        cat-shape:epo-cat-Catalogue-epo-specifiesCatalogueProvider,
        cat-shape:epo-cat-Catalogue-epo-specifiesCatalogueReceiver,
        cat-shape:epo-cat-Catalogue-epo-specifiesSeller ;
    sh:targetClass :Catalogue .

cat-shape:epo-cat-ChargeInformationShape a sh:NodeShape ;
    rdfs:label "Charge information" ;
    rdfs:comment "Information about fee or duty imposed. Additional Information: Charge category indicates the nature of the duty/fee, for example CAR, etc. Charge category modifier may be used in case different levels, exemptions or other modifications apply. The charge can be fixed or relative to the price." ;
    rdfs:isDefinedBy cat-shape:cat-shape ;
    sh:property cat-shape:epo-cat-ChargeInformation-epo-inv-isSpecificToInvoiceLine,
        cat-shape:epo-cat-ChargeInformation-epo-ord-isSpecificToOrderLine ;
    sh:targetClass :ChargeInformation .

cat-shape:epo-cat-DimensionInformationShape a sh:NodeShape ;
    rdfs:label "Dimension information" ;
    rdfs:isDefinedBy cat-shape:cat-shape ;
    sh:property cat-shape:epo-cat-DimensionInformation-epo-cat-concernsItem,
        cat-shape:epo-cat-DimensionInformation-epo-cat-hasDimensionDescription,
        cat-shape:epo-cat-DimensionInformation-epo-cat-hasMaximumMeasure,
        cat-shape:epo-cat-DimensionInformation-epo-cat-hasMeasure,
        cat-shape:epo-cat-DimensionInformation-epo-cat-hasMeasuredAttributeCode,
        cat-shape:epo-cat-DimensionInformation-epo-cat-hasMinimumMeasure,
        cat-shape:epo-cat-DimensionInformation-epo-ful-concernsGoodsItem,
        cat-shape:epo-cat-DimensionInformation-epo-ful-concernsPackage,
        cat-shape:epo-cat-DimensionInformation-epo-ful-concernsTransportEquipment,
        cat-shape:epo-cat-DimensionInformation-epo-ful-concernsTransportMeans ;
    sh:targetClass :DimensionInformation .

cat-shape:epo-cat-EnvironmentalEmissionInformationShape a sh:NodeShape ;
    rdfs:label "Environmental emission information" ;
    rdfs:isDefinedBy cat-shape:cat-shape ;
    sh:property cat-shape:epo-cat-EnvironmentalEmissionInformation-epo-cat-concernsItem,
        cat-shape:epo-cat-EnvironmentalEmissionInformation-epo-cat-hasEnvironmentalEmissionCode,
        cat-shape:epo-cat-EnvironmentalEmissionInformation-epo-cat-hasMeasure,
        cat-shape:epo-cat-EnvironmentalEmissionInformation-epo-ful-concernsTransportMeans,
        cat-shape:epo-cat-EnvironmentalEmissionInformation-epo-hasCalculationMethod ;
    sh:targetClass :EnvironmentalEmissionInformation .

cat-shape:epo-cat-InformationHubShape a sh:NodeShape ;
    rdfs:label "Information hub" ;
    rdfs:comment "Grouping of data that may be associated to various concepts. Additional Information: For example, AllowanceChargeInformation may be associated to the Order or the Catalogue (either at the Line level or at the Document level), amongst others." ;
    rdfs:isDefinedBy cat-shape:cat-shape ;
    sh:property cat-shape:epo-cat-InformationHub-epo-cat-isSpecificToLine ;
    sh:targetClass :InformationHub .

cat-shape:epo-cat-ItemAccessoryRelationShape a sh:NodeShape ;
    rdfs:label "Item accessory relation" ;
    rdfs:comment "Combination of two Items where the former enhances the latter." ;
    rdfs:isDefinedBy cat-shape:cat-shape ;
    sh:targetClass :ItemAccessoryRelation .

cat-shape:epo-cat-ItemComplementaryRelationShape a sh:NodeShape ;
    rdfs:label "Item complementary relation" ;
    rdfs:comment "Combination of two Items which mutually enhance one another." ;
    rdfs:isDefinedBy cat-shape:cat-shape ;
    sh:targetClass :ItemComplementaryRelation .

cat-shape:epo-cat-ItemCompositionShape a sh:NodeShape ;
    rdfs:label "Item composition" ;
    rdfs:comment "Inclusion of an Item into in the described Item. Additional Information: The Item is provided with its components, however, the component Items may also be provided separately. For example, a bicycle has wheels as components, but they may be provided as spare parts as well. This relation is useful to describe different package levels of an item or hierarchies of Items." ;
    rdfs:isDefinedBy cat-shape:cat-shape ;
    sh:targetClass :ItemComposition .

cat-shape:epo-cat-ItemModelShape a sh:NodeShape ;
    rdfs:label "Item model" ;
    rdfs:comment "A specific design or version of a product or service. Additional information: This class is meant as a reusable reference to the model name rather than as a set of specifications of an Item of this particular model." ;
    rdfs:isDefinedBy cat-shape:cat-shape ;
    sh:targetClass :ItemModel .

cat-shape:epo-cat-ItemPropertyShape a sh:NodeShape ;
    rdfs:label "Item property" ;
    rdfs:comment "Construct meant to represent the association between an attribute defined in an external classification scheme and the value ascribed to it." ;
    rdfs:isDefinedBy cat-shape:cat-shape ;
    sh:property cat-shape:epo-cat-ItemProperty-epo-cat-describesItem,
        cat-shape:epo-cat-ItemProperty-epo-cat-hasAttributeType,
        cat-shape:epo-cat-ItemProperty-epo-cat-hasClassificationCode,
        cat-shape:epo-cat-ItemProperty-epo-cat-hasClassificationScheme,
        cat-shape:epo-cat-ItemProperty-epo-cat-hasImportanceCode,
        cat-shape:epo-cat-ItemProperty-epo-cat-hasLiteralValue,
        cat-shape:epo-cat-ItemProperty-epo-cat-hasMaximumValue,
        cat-shape:epo-cat-ItemProperty-epo-cat-hasMinimumValue,
        cat-shape:epo-cat-ItemProperty-epo-cat-hasQualifiedValue ;
    sh:targetClass :ItemProperty .

cat-shape:epo-cat-ItemRelationShape a sh:NodeShape ;
    rdfs:label "Item relation" ;
    rdfs:comment "Connection between two Items." ;
    rdfs:isDefinedBy cat-shape:cat-shape ;
    sh:property cat-shape:epo-cat-ItemRelation-epo-cat-hasFactor,
        cat-shape:epo-cat-ItemRelation-epo-cat-isRelatedToItem ;
    sh:targetClass :ItemRelation .

cat-shape:epo-cat-ItemReplacementShape a sh:NodeShape ;
    rdfs:label "Item replacement" ;
    rdfs:comment "Supplantment, displacement or suspension of an Item by the described Item." ;
    rdfs:isDefinedBy cat-shape:cat-shape ;
    sh:targetClass :ItemReplacement .

cat-shape:epo-cat-ItemRequirementShape a sh:NodeShape ;
    rdfs:label "Item requirement" ;
    rdfs:comment "Necessity of an Item by the described item. Additional Information: The described item is provided without other items that are required for proper functionality. For example, a printer cannot be used without ink cartridge; or a Server cannot be used without its installation." ;
    rdfs:isDefinedBy cat-shape:cat-shape ;
    sh:targetClass :ItemRequirement .

cat-shape:epo-cat-ItemShape a sh:NodeShape ;
    rdfs:label "Item" ;
    rdfs:isDefinedBy cat-shape:cat-shape ;
    sh:targetClass :Item .

cat-shape:epo-cat-LineShape a sh:NodeShape ;
    rdfs:label "Line" ;
    rdfs:isDefinedBy cat-shape:cat-shape ;
    sh:property cat-shape:epo-cat-Line-epo-cat-specifiesItem,
        cat-shape:epo-cat-Line-epo-ful-hasAssociatedDocument,
        cat-shape:epo-cat-Line-epo-hasAdditionalInformation ;
    sh:targetClass :Line .

cat-shape:epo-cat-ManufacturerShape a sh:NodeShape ;
    rdfs:label "Manufacturer" ;
    rdfs:comment "The Producer of goods or provider of services. Additional Information: Also, known as Supplier and Manufacturer. We do not care who provides these service or products we care with whom Business is done. PEPPOL - Invoice: The Supplier is the Legal Person or Organisation who provides a product and/or service. PEPPOL - Order: The supplier is the legal person or organisation who provides a product or service. Examples of supplier roles: seller, despatch party, creditor, economic operator." ;
    rdfs:isDefinedBy cat-shape:cat-shape ;
    sh:property cat-shape:epo-cat-Manufacturer-epo-hasManufacturerID ;
    sh:targetClass :Manufacturer .

cat-shape:epo-cat-PostAwardCatalogueShape a sh:NodeShape ;
    rdfs:label "Post award catalogue" ;
    rdfs:comment "A Document describing a set of Items offered for purchase that can be processed in an electronic way, after a Contract is signed." ;
    rdfs:isDefinedBy cat-shape:cat-shape ;
    sh:property cat-shape:epo-cat-PostAwardCatalogue-epo-cat-isSubordinatedToContract ;
    sh:targetClass :PostAwardCatalogue .

cat-shape:epo-cat-PostAwardDocumentShape a sh:NodeShape ;
    rdfs:label "Post award document" ;
    rdfs:isDefinedBy cat-shape:cat-shape ;
    sh:property cat-shape:epo-cat-PostAwardDocument-epo-hasDocumentStatus,
        cat-shape:epo-cat-PostAwardDocument-epo-ord-hasCustomerReference ;
    sh:targetClass :PostAwardDocument .

cat-shape:epo-cat-PriceShape a sh:NodeShape ;
    rdfs:label "Price" ;
    rdfs:comment "Amount of money required or given in exchange for Items. Additional information: The Price excludes any charges (such as taxes, duties and fees) and discounts." ;
    rdfs:isDefinedBy cat-shape:cat-shape ;
    sh:property cat-shape:epo-cat-Price-epo-cat-hasBaseQuantity,
        cat-shape:epo-cat-Price-epo-cat-hasDeliveryLocation,
        cat-shape:epo-cat-Price-epo-cat-hasExpectedDeliveryTime,
        cat-shape:epo-cat-Price-epo-cat-hasNetMonetaryValue,
        cat-shape:epo-cat-Price-epo-cat-hasOrderabableUnitFactorRate,
        cat-shape:epo-cat-Price-epo-cat-hasPriceType,
        cat-shape:epo-cat-Price-epo-cat-hasPriceValidity,
        cat-shape:epo-cat-Price-epo-cat-hasQuantityThreshold,
        cat-shape:epo-cat-Price-epo-hasPriceSurchargeInformation,
        cat-shape:epo-cat-Price-epo-ord-hasGrossMonetaryValue,
        cat-shape:epo-cat-Price-epo-ord-hasPriceDiscountInformation ;
    sh:targetClass :Price .

cat-shape:epo-cat-ProductSpecificationShape a sh:NodeShape ;
    rdfs:label "Product specification" ;
    rdfs:comment "Document providing information about an Item." ;
    rdfs:isDefinedBy cat-shape:cat-shape ;
    sh:targetClass :ProductSpecification .

cat-shape:epo-ful-ConsignmentShape sh:property cat-shape:epo-ful-Consignment-epo-ful-hasFreightCharge .

cat-shape:epo-inv-InvoiceLineShape sh:property cat-shape:epo-inv-InvoiceLine-epo-cat-hasPrice .

cat-shape:epo-inv-InvoiceShape sh:property cat-shape:epo-inv-Invoice-epo-cat-specifiesChargeInformation .

cat-shape:epo-ord-OrderLineShape sh:property cat-shape:epo-ord-OrderLine-epo-cat-hasPrice,
        cat-shape:epo-ord-OrderLine-epo-ord-refersToCatalogueLine .

cat-shape:epo-ord-OrderShape sh:property cat-shape:epo-ord-Order-epo-cat-refersToCatalogue,
        cat-shape:epo-ord-Order-epo-cat-specifiesChargeInformation .

cat-shape:epo-ord-TaxInformationShape sh:property cat-shape:epo-ord-TaxInformation-epo-cat-hasTaxCategory,
        cat-shape:epo-ord-TaxInformation-epo-cat-hasTaxScheme .

cat-shape:epo-req-RequestForOfferShape sh:property cat-shape:epo-req-RequestForOffer-epo-cat-refersToCatalogue .

cat-shape:epo-Document-epo-hasDocumentType a sh:PropertyShape ;
    rdfs:isDefinedBy cat-shape:cat-shape ;
    sh:class skos:Concept ;
    sh:maxCount 1 ;
    sh:name "Has document type" ;
    sh:path :hasDocumentType .

cat-shape:epo-cat-AbstractItem-epo-cat-hasAccessoryItem a sh:PropertyShape ;
    rdfs:isDefinedBy cat-shape:cat-shape ;
    sh:class :AbstractItem ;
    sh:description "An additional item that can enhance the original item." ;
    sh:name "Has accessory item" ;
    sh:path :hasAccessoryItem ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasAccessoryItem> ?that . ?that <http://data.europa.eu/a4g/ontology#hasAccessoryItem> ?this .}" ] .

cat-shape:epo-cat-AbstractItem-epo-cat-hasBrand a sh:PropertyShape ;
    rdfs:isDefinedBy cat-shape:cat-shape ;
    sh:class :Brand ;
    sh:maxCount 1 ;
    sh:name "Has brand" ;
    sh:path :hasBrand ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasBrand> ?that . ?that <http://data.europa.eu/a4g/ontology#hasBrand> ?this .}" ] .

cat-shape:epo-cat-AbstractItem-epo-cat-hasComplementaryItem a sh:PropertyShape ;
    rdfs:isDefinedBy cat-shape:cat-shape ;
    sh:class :AbstractItem ;
    sh:description "An item that if used with another item provides mutual enhancements to both of them. Additional information: For example, gin and tonic; or smart-phone and smart-watch." ;
    sh:name "Has complementary item" ;
    sh:path :hasComplementaryItem ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasComplementaryItem> ?that . ?that <http://data.europa.eu/a4g/ontology#hasComplementaryItem> ?this .}" ] .

cat-shape:epo-cat-AbstractItem-epo-cat-hasCountryOfOrigin a sh:PropertyShape ;
    rdfs:isDefinedBy cat-shape:cat-shape ;
    sh:description "" ;
    sh:maxCount 1 ;
    sh:name "Has country of origin" ;
    sh:path :hasCountryOfOrigin .

cat-shape:epo-cat-AbstractItem-epo-cat-hasDeliveryClassification a sh:PropertyShape ;
    rdfs:isDefinedBy cat-shape:cat-shape ;
    sh:class skos:Concept ;
    sh:maxCount 1 ;
    sh:name "Has delivery classification" ;
    sh:path :hasDeliveryClassification .

cat-shape:epo-cat-AbstractItem-epo-cat-hasHazardousClassID a sh:PropertyShape ;
    rdfs:isDefinedBy cat-shape:cat-shape ;
    sh:class adms:Identifier ;
    sh:description "Specification of the hazardous nature of an item according to a classification schema. Provides detail of the classification and nature of a hazardous item." ;
    sh:name "Has hazardous class ID" ;
    sh:path :hasHazardousClassID ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasHazardousClassID> ?that . ?that <http://data.europa.eu/a4g/ontology#hasHazardousClassID> ?this .}" ] .

cat-shape:epo-cat-AbstractItem-epo-cat-hasHazardousItemUNDGCode a sh:PropertyShape ;
    rdfs:isDefinedBy cat-shape:cat-shape ;
    sh:class skos:Concept ;
    sh:description "Specification of the hazardous nature of an item according to the UNDG classification schema. Provides detail of the classification and nature of a hazardous item." ;
    sh:name "Has hazardous item UNDG code" ;
    sh:path :hasHazardousItemUNDGCode .

cat-shape:epo-cat-AbstractItem-epo-cat-hasItemClassification a sh:PropertyShape ;
    rdfs:isDefinedBy cat-shape:cat-shape ;
    sh:class skos:Concept ;
    sh:description "A classification of this item according to a specific system for classifying products or services. Additional information: Examples of classification schemes are: CPV, UNSPC, eCl@ss, GPC, ..." ;
    sh:name "Has item classification" ;
    sh:path :hasItemClassification .

cat-shape:epo-cat-AbstractItem-epo-cat-hasKeyword a sh:PropertyShape ;
    rdfs:isDefinedBy cat-shape:cat-shape ;
    sh:description "List of words (e.g, synonyms) to make the item searchable." ;
    sh:name "Has keyword" ;
    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
    sh:path :hasKeyword .

cat-shape:epo-cat-AbstractItem-epo-cat-hasManufacturer a sh:PropertyShape ;
    rdfs:isDefinedBy cat-shape:cat-shape ;
    sh:class :Manufacturer ;
    sh:description "The product maker or service provider." ;
    sh:maxCount 1 ;
    sh:name "Has manufacturer" ;
    sh:path :hasManufacturer ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasManufacturer> ?that . ?that <http://data.europa.eu/a4g/ontology#hasManufacturer> ?this .}" ] .

cat-shape:epo-cat-AbstractItem-epo-cat-hasModel a sh:PropertyShape ;
    rdfs:isDefinedBy cat-shape:cat-shape ;
    sh:class :ItemModel ;
    sh:maxCount 1 ;
    sh:name "Has model" ;
    sh:path :hasModel ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasModel> ?that . ?that <http://data.europa.eu/a4g/ontology#hasModel> ?this .}" ] .

cat-shape:epo-cat-AbstractItem-epo-cat-hasNetQuantity a sh:PropertyShape ;
    rdfs:isDefinedBy cat-shape:cat-shape ;
    sh:class :Quantity ;
    sh:description "The net quantity of the item that is contained in each consumable unit, excluding any packaging materials." ;
    sh:maxCount 1 ;
    sh:name "Has net quantity" ;
    sh:path :hasNetQuantity ;
