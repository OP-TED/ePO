@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix epo: <http://data.europa.eu/a4g/ontology#> .
@prefix epo-shape: <http://data.europa.eu/a4g/data-shape#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

epo-shape:epo-Document sh:property epo-shape:epo-Document-epo-hasDocumentType .

epo-shape:epo-cat-AbstractItemShape a sh:NodeShape ;
    rdfs:label "Abstract Item" ;
    rdfs:comment "Gathering class for the Items, Item Requests and Deliverables. Additional information: The subclasses have in common that they are related to a procurement need." ;
    rdfs:isDefinedBy epo-shape:cat-shape ;
    sh:property epo-shape:epo-cat-AbstractItem-epo-cat-hasAccessoryItem,
        epo-shape:epo-cat-AbstractItem-epo-cat-hasBrand,
        epo-shape:epo-cat-AbstractItem-epo-cat-hasComplementaryItem,
        epo-shape:epo-cat-AbstractItem-epo-cat-hasCountryOfOrigin,
        epo-shape:epo-cat-AbstractItem-epo-cat-hasDeliveryClassification,
        epo-shape:epo-cat-AbstractItem-epo-cat-hasHazardousClassID,
        epo-shape:epo-cat-AbstractItem-epo-cat-hasHazardousItemUNDGCode,
        epo-shape:epo-cat-AbstractItem-epo-cat-hasItemClassification,
        epo-shape:epo-cat-AbstractItem-epo-cat-hasKeyword,
        epo-shape:epo-cat-AbstractItem-epo-cat-hasManufacturer,
        epo-shape:epo-cat-AbstractItem-epo-cat-hasModel,
        epo-shape:epo-cat-AbstractItem-epo-cat-hasNetQuantity,
        epo-shape:epo-cat-AbstractItem-epo-cat-hasQualifiedItemRelation,
        epo-shape:epo-cat-AbstractItem-epo-cat-hasSpecification,
        epo-shape:epo-cat-AbstractItem-epo-cat-isInStock,
        epo-shape:epo-cat-AbstractItem-epo-hasBuyerItemID,
        epo-shape:epo-cat-AbstractItem-epo-hasCertification,
        epo-shape:epo-cat-AbstractItem-epo-hasItemStandardID,
        epo-shape:epo-cat-AbstractItem-epo-hasManufacturerItemID,
        epo-shape:epo-cat-AbstractItem-epo-hasSellerItemID,
        epo-shape:epo-cat-AbstractItem-epo-hasSerialID,
        epo-shape:epo-cat-AbstractItem-epo-inv-hasItemClassificationIdentifier,
        epo-shape:epo-cat-AbstractItem-epo-ord-hasTaxInformation ;
    sh:targetClass epo:AbstractItem .

epo-shape:epo-cat-BatchShape a sh:NodeShape ;
    rdfs:label "Batch" ;
    rdfs:comment "A production lot in which the Item instances were produced." ;
    rdfs:isDefinedBy epo-shape:cat-shape ;
    sh:property epo-shape:epo-cat-Batch-epo-cat-hasBestBeforeDate,
        epo-shape:epo-cat-Batch-epo-cat-hasExpiryDate,
        epo-shape:epo-cat-Batch-epo-cat-hasManufactureDate,
        epo-shape:epo-cat-Batch-epo-cat-isProductionOf,
        epo-shape:epo-cat-Batch-epo-hasBatchID ;
    sh:targetClass epo:Batch .

epo-shape:epo-cat-BrandShape a sh:NodeShape ;
    rdfs:label "Brand" ;
    rdfs:comment "Name given by an organisation to its product or service, or range of products or services. Additional information: Brand name allows economic operators to distinctively describe an item in their eCatalogue. This may be different from the \"item name\"." ;
    rdfs:isDefinedBy epo-shape:cat-shape ;
    sh:targetClass epo:Brand .

epo-shape:epo-cat-CatalogueLineShape a sh:NodeShape ;
    rdfs:label "Catalogue Line" ;
    rdfs:comment "Aggregated information about the Terms and specifications for procuring an Item. Details about an Item, like Prices, packaging, discounts, special promotions, etc. TC 440: Detailed information of an Item, Price and its composition in a Catalogue. Composition: e.g. information referring to its description, how to order it, what it is made of, properties, delivery conditions, etc." ;
    rdfs:isDefinedBy epo-shape:cat-shape ;
    sh:property epo-shape:epo-cat-CatalogueLine-epo-cat-foreseesPackage,
        epo-shape:epo-cat-CatalogueLine-epo-cat-hasActivityCode,
        epo-shape:epo-cat-CatalogueLine-epo-cat-hasCatalogueLineValidity,
        epo-shape:epo-cat-CatalogueLine-epo-cat-hasChargeInformation,
        epo-shape:epo-cat-CatalogueLine-epo-cat-hasMaximumOrderQuantity,
        epo-shape:epo-cat-CatalogueLine-epo-cat-hasMinimumQuantityGuaranteedForDelivery,
        epo-shape:epo-cat-CatalogueLine-epo-cat-hasOrderableQuantityIncrement,
        epo-shape:epo-cat-CatalogueLine-epo-cat-hasOrderableUnit,
        epo-shape:epo-cat-CatalogueLine-epo-cat-hasOrderableUnitFactorRate,
        epo-shape:epo-cat-CatalogueLine-epo-cat-hasPrice,
        epo-shape:epo-cat-CatalogueLine-epo-cat-hasStandardisedUnitPrice,
        epo-shape:epo-cat-CatalogueLine-epo-cat-hasTransactionConditions,
        epo-shape:epo-cat-CatalogueLine-epo-cat-hasTransactionConditionsCode,
        epo-shape:epo-cat-CatalogueLine-epo-cat-hasWarrantyInformation,
        epo-shape:epo-cat-CatalogueLine-epo-cat-isContractedItem,
        epo-shape:epo-cat-CatalogueLine-epo-cat-isOrderable ;
    sh:targetClass epo:CatalogueLine .

epo-shape:epo-cat-CatalogueResponseInformationShape a sh:NodeShape ;
    rdfs:label "Catalogue Response Information" ;
    rdfs:comment "Information about a Catalogue Response." ;
    rdfs:isDefinedBy epo-shape:cat-shape ;
    sh:property epo-shape:epo-cat-CatalogueResponseInformation-epo-cat-isSpecificToCatalogueResponseLine,
        epo-shape:epo-cat-CatalogueResponseInformation-epo-ord-hasResponseStatus ;
    sh:targetClass epo:CatalogueResponseInformation .

epo-shape:epo-cat-CatalogueResponseLineShape a sh:NodeShape ;
    rdfs:label "Catalogue Response Line" ;
    rdfs:comment "Details concerning the Catalogue Receiver’s ability to apply a given Catalogue Line for placing orders. Additional information: The Catalogue Response Line is used to inform on the acceptance or rejection of a Catalogue Line." ;
    rdfs:isDefinedBy epo-shape:cat-shape ;
    sh:property epo-shape:epo-cat-CatalogueResponseLine-epo-cat-refersToCatalogueLine,
        epo-shape:epo-cat-CatalogueResponseLine-epo-hasUUID,
        epo-shape:epo-cat-CatalogueResponseLine-epo-ord-hasResponseDescription ;
    sh:targetClass epo:CatalogueResponseLine .

epo-shape:epo-cat-CatalogueResponseShape a sh:NodeShape ;
    rdfs:label "Catalogue Response" ;
    rdfs:comment "A formal reply from the Catalogue Receiver to the Catalogue Provider stating the Catalogue Receiver's ability to apply the catalogue for placing orders. Additional Information: The Catalogue Response is used to inform on the acceptance or rejection of a Catalogue." ;
    rdfs:isDefinedBy epo-shape:cat-shape ;
    sh:property epo-shape:epo-cat-CatalogueResponse-epo-cat-comprisesCatalogueResponseLine,
        epo-shape:epo-cat-CatalogueResponse-epo-cat-refersToCatalogue,
        epo-shape:epo-cat-CatalogueResponse-epo-cat-specifiesCatalogueResponseInformation,
        epo-shape:epo-cat-CatalogueResponse-epo-ord-hasResponseDescription,
        epo-shape:epo-cat-CatalogueResponse-epo-specifiesCatalogueProvider,
        epo-shape:epo-cat-CatalogueResponse-epo-specifiesCatalogueReceiver ;
    sh:targetClass epo:CatalogueResponse .

epo-shape:epo-cat-CatalogueShape a sh:NodeShape ;
    rdfs:label "Catalogue" ;
    rdfs:comment "A phase-agnostic Document describing a set of Items offered for purchase that can be processed in an electronic way." ;
    rdfs:isDefinedBy epo-shape:cat-shape ;
    sh:property epo-shape:epo-cat-Catalogue-epo-cat-comprisesCatalogueLine,
        epo-shape:epo-cat-Catalogue-epo-cat-hasActivityCode,
        epo-shape:epo-cat-Catalogue-epo-cat-hasSpecificPaymentArrangement,
        epo-shape:epo-cat-Catalogue-epo-hasValidityPeriod,
        epo-shape:epo-cat-Catalogue-epo-specifiesBuyer,
        epo-shape:epo-cat-Catalogue-epo-specifiesCatalogueProvider,
        epo-shape:epo-cat-Catalogue-epo-specifiesCatalogueReceiver,
        epo-shape:epo-cat-Catalogue-epo-specifiesSeller ;
    sh:targetClass epo:Catalogue .

epo-shape:epo-cat-ChargeInformationShape a sh:NodeShape ;
    rdfs:label "Charge Information" ;
    rdfs:comment "Information about fee or duty imposed. Additional Information: Charge category indicates the nature of the duty/fee, for example CAR, etc. Charge category modifier may be used in case different levels, exemptions or other modifications apply. The charge can be fixed or relative to the price." ;
    rdfs:isDefinedBy epo-shape:cat-shape ;
    sh:property epo-shape:epo-cat-ChargeInformation-epo-inv-isSpecificToInvoiceLine,
        epo-shape:epo-cat-ChargeInformation-epo-ord-isSpecificToOrderLine ;
    sh:targetClass epo:ChargeInformation .

epo-shape:epo-cat-DimensionInformationShape a sh:NodeShape ;
    rdfs:label "Dimension Information" ;
    rdfs:comment "Information about the physical or measurable attributes of the instance of the concept described." ;
    rdfs:isDefinedBy epo-shape:cat-shape ;
    sh:property epo-shape:epo-cat-DimensionInformation-epo-cat-concernsItem,
        epo-shape:epo-cat-DimensionInformation-epo-cat-hasDimensionDescription,
        epo-shape:epo-cat-DimensionInformation-epo-cat-hasMaximumMeasure,
        epo-shape:epo-cat-DimensionInformation-epo-cat-hasMeasure,
        epo-shape:epo-cat-DimensionInformation-epo-cat-hasMeasuredAttributeCode,
        epo-shape:epo-cat-DimensionInformation-epo-cat-hasMinimumMeasure,
        epo-shape:epo-cat-DimensionInformation-epo-ful-concernsGoodsItem,
        epo-shape:epo-cat-DimensionInformation-epo-ful-concernsPackage,
        epo-shape:epo-cat-DimensionInformation-epo-ful-concernsTransportEquipment,
        epo-shape:epo-cat-DimensionInformation-epo-ful-concernsTransportMeans ;
    sh:targetClass epo:DimensionInformation .

epo-shape:epo-cat-EnvironmentalEmissionInformationShape a sh:NodeShape ;
    rdfs:label "Environmental Emission Information" ;
    rdfs:comment "Information about the emissions related to a product, work or service that are released into the environment." ;
    rdfs:isDefinedBy epo-shape:cat-shape ;
    sh:property epo-shape:epo-cat-EnvironmentalEmissionInformation-epo-cat-concernsItem,
        epo-shape:epo-cat-EnvironmentalEmissionInformation-epo-cat-hasEnvironmentalEmissionCode,
        epo-shape:epo-cat-EnvironmentalEmissionInformation-epo-cat-hasMeasure,
        epo-shape:epo-cat-EnvironmentalEmissionInformation-epo-ful-concernsTransportMeans,
        epo-shape:epo-cat-EnvironmentalEmissionInformation-epo-hasCalculationMethod ;
    sh:targetClass epo:EnvironmentalEmissionInformation .

epo-shape:epo-cat-InformationHubShape a sh:NodeShape ;
    rdfs:label "Information Hub" ;
    rdfs:comment "Grouping of data that may be associated to various concepts. Additional Information: For example, AllowanceChargeInformation may be associated to the Order or the Catalogue (either at the Line level or at the Document level), amongst others." ;
    rdfs:isDefinedBy epo-shape:cat-shape ;
    sh:property epo-shape:epo-cat-InformationHub-epo-cat-isSpecificToLine ;
    sh:targetClass epo:InformationHub .

epo-shape:epo-cat-ItemAccessoryRelationShape a sh:NodeShape ;
    rdfs:label "Item Accessory Relation" ;
    rdfs:comment "Combination of two Items where the former enhances the latter." ;
    rdfs:isDefinedBy epo-shape:cat-shape ;
    sh:targetClass epo:ItemAccessoryRelation .

epo-shape:epo-cat-ItemComplementaryRelationShape a sh:NodeShape ;
    rdfs:label "Item Complementary Relation" ;
    rdfs:comment "Combination of two Items which mutually enhance one another." ;
    rdfs:isDefinedBy epo-shape:cat-shape ;
    sh:targetClass epo:ItemComplementaryRelation .

epo-shape:epo-cat-ItemCompositionShape a sh:NodeShape ;
    rdfs:label "Item Composition" ;
    rdfs:comment "Inclusion of an Item into in the described Item. Additional Information: The Item is provided with its components, however, the component Items may also be provided separately. For example, a bicycle has wheels as components, but they may be provided as spare parts as well. This relation is useful to describe different package levels of an item or hierarchies of Items." ;
    rdfs:isDefinedBy epo-shape:cat-shape ;
    sh:targetClass epo:ItemComposition .

epo-shape:epo-cat-ItemModelShape a sh:NodeShape ;
    rdfs:label "Item Model" ;
    rdfs:comment "A specific design or version of a product or service. Additional information: This class is meant as a reusable reference to the model name rather than as a set of specifications of an Item of this particular model." ;
    rdfs:isDefinedBy epo-shape:cat-shape ;
    sh:targetClass epo:ItemModel .

epo-shape:epo-cat-ItemPropertyShape a sh:NodeShape ;
    rdfs:label "Item Property" ;
    rdfs:comment "Construct meant to represent the association between an attribute defined in an external classification scheme and the value ascribed to it." ;
    rdfs:isDefinedBy epo-shape:cat-shape ;
    sh:property epo-shape:epo-cat-ItemProperty-epo-cat-describesItem,
        epo-shape:epo-cat-ItemProperty-epo-cat-hasAttributeType,
        epo-shape:epo-cat-ItemProperty-epo-cat-hasClassificationCode,
        epo-shape:epo-cat-ItemProperty-epo-cat-hasClassificationScheme,
        epo-shape:epo-cat-ItemProperty-epo-cat-hasImportanceCode,
        epo-shape:epo-cat-ItemProperty-epo-cat-hasLiteralValue,
        epo-shape:epo-cat-ItemProperty-epo-cat-hasMaximumValue,
        epo-shape:epo-cat-ItemProperty-epo-cat-hasMinimumValue,
        epo-shape:epo-cat-ItemProperty-epo-cat-hasQualifiedValue ;
    sh:targetClass epo:ItemProperty .

epo-shape:epo-cat-ItemRelationShape a sh:NodeShape ;
    rdfs:label "Item Relation" ;
    rdfs:comment "Connection between two Items." ;
    rdfs:isDefinedBy epo-shape:cat-shape ;
    sh:property epo-shape:epo-cat-ItemRelation-epo-cat-hasFactor,
        epo-shape:epo-cat-ItemRelation-epo-cat-isRelatedToItem ;
    sh:targetClass epo:ItemRelation .

epo-shape:epo-cat-ItemReplacementShape a sh:NodeShape ;
    rdfs:label "Item Replacement" ;
    rdfs:comment "Supplantment, displacement or suspension of an Item by the described Item." ;
    rdfs:isDefinedBy epo-shape:cat-shape ;
    sh:targetClass epo:ItemReplacement .

epo-shape:epo-cat-ItemRequirementShape a sh:NodeShape ;
    rdfs:label "Item Requirement" ;
    rdfs:comment "Necessity of an Item by the described item. Additional Information: The described item is provided without other items that are required for proper functionality. For example, a printer cannot be used without ink cartridge; or a Server cannot be used without its installation." ;
    rdfs:isDefinedBy epo-shape:cat-shape ;
    sh:targetClass epo:ItemRequirement .

epo-shape:epo-cat-ItemShape a sh:NodeShape ;
    rdfs:label "Item" ;
    rdfs:comment "A product, work, service or any combination of them. Additional Information: An Item can be an atomic Thing or a composition of things that together are seen as a unit, e.g. a tetrabrik of milk or an indivisible package of six tetrabriks. No distinction is provided between services, goods and works to leave room for innovation. An Item is used to fulfill a need which is described in an Item Request." ;
    rdfs:isDefinedBy epo-shape:cat-shape ;
    sh:targetClass epo:Item .

epo-shape:epo-cat-LineShape a sh:NodeShape ;
    rdfs:label "Line" ;
    rdfs:comment "Component of a document providing specific information." ;
    rdfs:isDefinedBy epo-shape:cat-shape ;
    sh:property epo-shape:epo-cat-Line-epo-cat-specifiesItem,
        epo-shape:epo-cat-Line-epo-ful-hasAssociatedDocument,
        epo-shape:epo-cat-Line-epo-hasAdditionalInformation ;
    sh:targetClass epo:Line .

epo-shape:epo-cat-ManufacturerShape a sh:NodeShape ;
    rdfs:label "Manufacturer" ;
    rdfs:comment "The Producer of goods or provider of services. Additional Information: Also, known as Supplier and Manufacturer. We do not care who provides these service or products we care with whom Business is done. PEPPOL - Invoice: The Supplier is the Legal Person or Organisation who provides a product and/or service. PEPPOL - Order: The supplier is the legal person or organisation who provides a product or service. Examples of supplier roles: seller, despatch party, creditor, economic operator." ;
    rdfs:isDefinedBy epo-shape:cat-shape ;
    sh:property epo-shape:epo-cat-Manufacturer-epo-hasManufacturerID ;
    sh:targetClass epo:Manufacturer .

epo-shape:epo-cat-PostAwardCatalogueShape a sh:NodeShape ;
    rdfs:label "Post Award Catalogue" ;
    rdfs:comment "A Document describing a set of Items offered for purchase that can be processed in an electronic way, after a Contract is signed." ;
    rdfs:isDefinedBy epo-shape:cat-shape ;
    sh:property epo-shape:epo-cat-PostAwardCatalogue-epo-cat-isSubordinatedToContract ;
    sh:targetClass epo:PostAwardCatalogue .

epo-shape:epo-cat-PostAwardDocumentShape a sh:NodeShape ;
    rdfs:label "Post Award Document" ;
    rdfs:comment "Document created after the award of a Contract during a Procurement Procedure." ;
    rdfs:isDefinedBy epo-shape:cat-shape ;
    sh:property epo-shape:epo-cat-PostAwardDocument-epo-hasDocumentStatus,
        epo-shape:epo-cat-PostAwardDocument-epo-ord-hasCustomerReference ;
    sh:targetClass epo:PostAwardDocument .

epo-shape:epo-cat-PriceShape a sh:NodeShape ;
    rdfs:label "Price" ;
    rdfs:comment "Amount of money required or given in exchange for Items. Additional information: The Price excludes any charges (such as taxes, duties and fees) and discounts." ;
    rdfs:isDefinedBy epo-shape:cat-shape ;
    sh:property epo-shape:epo-cat-Price-epo-cat-hasBaseQuantity,
        epo-shape:epo-cat-Price-epo-cat-hasDeliveryLocation,
        epo-shape:epo-cat-Price-epo-cat-hasExpectedDeliveryTime,
        epo-shape:epo-cat-Price-epo-cat-hasNetMonetaryValue,
        epo-shape:epo-cat-Price-epo-cat-hasOrderabableUnitFactorRate,
        epo-shape:epo-cat-Price-epo-cat-hasPriceType,
        epo-shape:epo-cat-Price-epo-cat-hasPriceValidity,
        epo-shape:epo-cat-Price-epo-cat-hasQuantityThreshold,
        epo-shape:epo-cat-Price-epo-hasPriceSurchargeInformation,
        epo-shape:epo-cat-Price-epo-ord-hasGrossMonetaryValue,
        epo-shape:epo-cat-Price-epo-ord-hasPriceDiscountInformation ;
    sh:targetClass epo:Price .

epo-shape:epo-cat-ProductSpecificationShape a sh:NodeShape ;
    rdfs:label "Product Specification" ;
    rdfs:comment "Document providing information about an Item." ;
    rdfs:isDefinedBy epo-shape:cat-shape ;
    sh:targetClass epo:ProductSpecification .

epo-shape:epo-ful-Consignment sh:property epo-shape:epo-ful-Consignment-epo-ful-hasFreightCharge .

epo-shape:epo-inv-Invoice sh:property epo-shape:epo-inv-Invoice-epo-cat-specifiesChargeInformation .

epo-shape:epo-inv-InvoiceLine sh:property epo-shape:epo-inv-InvoiceLine-epo-cat-hasPrice .

epo-shape:epo-ord-Order sh:property epo-shape:epo-ord-Order-epo-cat-refersToCatalogue,
        epo-shape:epo-ord-Order-epo-cat-specifiesChargeInformation .

epo-shape:epo-ord-OrderLine sh:property epo-shape:epo-ord-OrderLine-epo-cat-hasPrice,
        epo-shape:epo-ord-OrderLine-epo-ord-refersToCatalogueLine .

epo-shape:epo-ord-TaxInformation sh:property epo-shape:epo-ord-TaxInformation-epo-cat-hasTaxCategory,
        epo-shape:epo-ord-TaxInformation-epo-cat-hasTaxScheme .

epo-shape:epo-req-RequestForOffer sh:property epo-shape:epo-req-RequestForOffer-epo-cat-refersToCatalogue .

epo-shape:epo-Document-epo-hasDocumentType a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:cat-shape ;
    sh:class skos:Concept ;
    sh:description "Relation indicating the Document Type." ;
    sh:maxCount 1 ;
    sh:name "Has document type" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasDocumentType .

epo-shape:epo-cat-AbstractItem-epo-cat-hasAccessoryItem a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:cat-shape ;
    sh:class epo:AbstractItem ;
    sh:description "An additional item that can enhance the original item." ;
    sh:name "Has accessory item" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasAccessoryItem ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasAccessoryItem> ?that . ?that <http://data.europa.eu/a4g/ontology#hasAccessoryItem> ?this .}" ] .

epo-shape:epo-cat-AbstractItem-epo-cat-hasBrand a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:cat-shape ;
    sh:class epo:Brand ;
    sh:description "Relation indicating that the instance of the concept has a Brand." ;
    sh:maxCount 1 ;
    sh:name "Has brand" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasBrand ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasBrand> ?that . ?that <http://data.europa.eu/a4g/ontology#hasBrand> ?this .}" ] .

epo-shape:epo-cat-AbstractItem-epo-cat-hasComplementaryItem a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:cat-shape ;
    sh:class epo:AbstractItem ;
    sh:description "An item that if used with another item provides mutual enhancements to both of them. Additional information: For example, gin and tonic; or smart-phone and smart-watch." ;
    sh:name "Has complementary item" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasComplementaryItem ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasComplementaryItem> ?that . ?that <http://data.europa.eu/a4g/ontology#hasComplementaryItem> ?this .}" ] .

epo-shape:epo-cat-AbstractItem-epo-cat-hasCountryOfOrigin a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:cat-shape ;
    sh:description "" ;
    sh:maxCount 1 ;
    sh:name "Has country of origin" ;
    sh:path epo:hasCountryOfOrigin .

epo-shape:epo-cat-AbstractItem-epo-cat-hasDeliveryClassification a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:cat-shape ;
    sh:class skos:Concept ;
    sh:description "Relation indicating the Delivery Item Type." ;
    sh:maxCount 1 ;
    sh:name "Has delivery classification" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasDeliveryClassification .

epo-shape:epo-cat-AbstractItem-epo-cat-hasHazardousClassID a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:cat-shape ;
    sh:class adms:Identifier ;
    sh:description "Specification of the hazardous nature of an item according to a classification schema. Provides detail of the classification and nature of a hazardous item." ;
    sh:name "Has hazardous class ID" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasHazardousClassID ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasHazardousClassID> ?that . ?that <http://data.europa.eu/a4g/ontology#hasHazardousClassID> ?this .}" ] .

epo-shape:epo-cat-AbstractItem-epo-cat-hasHazardousItemUNDGCode a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:cat-shape ;
    sh:class skos:Concept ;
    sh:description "Specification of the hazardous nature of an item according to the UNDG classification schema. Provides detail of the classification and nature of a hazardous item." ;
    sh:name "Has hazardous item UNDG code" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasHazardousItemUNDGCode .

epo-shape:epo-cat-AbstractItem-epo-cat-hasItemClassification a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:cat-shape ;
    sh:class skos:Concept ;
    sh:description "A classification of this item according to a specific system for classifying products or services. Additional information: Examples of classification schemes are: CPV, UNSPC, eCl@ss, GPC, ..." ;
    sh:name "Has item classification" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasItemClassification .

epo-shape:epo-cat-AbstractItem-epo-cat-hasKeyword a sh:PropertyShape ;
