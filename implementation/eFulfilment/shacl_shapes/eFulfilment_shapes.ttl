@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix epo: <http://data.europa.eu/a4g/ontology#> .
@prefix epo-shape: <http://data.europa.eu/a4g/data-shape#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

epo-shape:epo-cat-CatalogueLine sh:property epo-shape:epo-cat-CatalogueLine-epo-cat-foreseesPackage .

epo-shape:epo-cat-DimensionInformation sh:property epo-shape:epo-cat-DimensionInformation-epo-ful-concernsGoodsItem,
        epo-shape:epo-cat-DimensionInformation-epo-ful-concernsPackage,
        epo-shape:epo-cat-DimensionInformation-epo-ful-concernsTransportEquipment,
        epo-shape:epo-cat-DimensionInformation-epo-ful-concernsTransportMeans .

epo-shape:epo-cat-EnvironmentalEmissionInformation sh:property epo-shape:epo-cat-EnvironmentalEmissionInformation-epo-ful-concernsTransportMeans .

epo-shape:epo-cat-PostAwardDocument sh:property epo-shape:epo-cat-PostAwardDocument-epo-hasDocumentStatus .

epo-shape:epo-ful-AbstractContainerShape a sh:NodeShape ;
    rdfs:label "Abstract Container" ;
    rdfs:comment "Gathering class for Packages and Transport Handling Units." ;
    rdfs:isDefinedBy epo-shape:ful-shape ;
    sh:property epo-shape:epo-ful-AbstractContainer-epo-ful-hasGrossVolume,
        epo-shape:epo-ful-AbstractContainer-epo-ful-hasGrossWeight,
        epo-shape:epo-ful-AbstractContainer-epo-ful-hasHeight,
        epo-shape:epo-ful-AbstractContainer-epo-ful-hasLength,
        epo-shape:epo-ful-AbstractContainer-epo-ful-hasNetVolume,
        epo-shape:epo-ful-AbstractContainer-epo-ful-hasNetWeight,
        epo-shape:epo-ful-AbstractContainer-epo-ful-hasPackingMaterialDescription,
        epo-shape:epo-ful-AbstractContainer-epo-ful-hasTemperatureSpecification,
        epo-shape:epo-ful-AbstractContainer-epo-ful-hasTotalGoodsItemQuantity,
        epo-shape:epo-ful-AbstractContainer-epo-ful-hasWidth,
        epo-shape:epo-ful-AbstractContainer-epo-ful-isHazardousRisk,
        epo-shape:epo-ful-AbstractContainer-epo-ful-isReturnableMaterial,
        epo-shape:epo-ful-AbstractContainer-epo-ord-hasAcceptanceStatus ;
    sh:targetClass epo:AbstractContainer .

epo-shape:epo-ful-CarrierShape a sh:NodeShape ;
    rdfs:label "Carrier" ;
    rdfs:comment "The Role of an Agent who handles the physical Delivery/Transportation of the (Despatched) Shipment. Additional Information: This Role is often referred to as the deliverer." ;
    rdfs:isDefinedBy epo-shape:ful-shape ;
    sh:targetClass epo:Carrier .

epo-shape:epo-ful-ConsignmentShape a sh:NodeShape ;
    rdfs:label "Consignment" ;
    rdfs:comment "A batch of goods destined for or delivered to someone. Additional information: Consignment is a Transport Agreement between the Despatcher and the Consignee as to who and how the goods are despatched and received." ;
    rdfs:isDefinedBy epo-shape:ful-shape ;
    sh:property epo-shape:epo-ful-Consignment-epo-ful-containsTransportHandlingUnit,
        epo-shape:epo-ful-Consignment-epo-ful-hasCarriageShipmentStage,
        epo-shape:epo-ful-Consignment-epo-ful-hasConsigneeConsignmentID,
        epo-shape:epo-ful-Consignment-epo-ful-hasDeclaredStatisticalValue,
        epo-shape:epo-ful-Consignment-epo-ful-hasDespatcherConsignmentID,
        epo-shape:epo-ful-Consignment-epo-ful-hasFreightCharge,
        epo-shape:epo-ful-Consignment-epo-ful-hasGrossVolume,
        epo-shape:epo-ful-Consignment-epo-ful-hasGrossWeight,
        epo-shape:epo-ful-Consignment-epo-ful-hasHandlingInstruction,
        epo-shape:epo-ful-Consignment-epo-ful-hasHandlingInstructionCode,
        epo-shape:epo-ful-Consignment-epo-ful-hasLoadingMeter,
        epo-shape:epo-ful-Consignment-epo-ful-hasNetWeight,
        epo-shape:epo-ful-Consignment-epo-ful-hasRequestedPickUpInformation,
        epo-shape:epo-ful-Consignment-epo-ful-hasSpecialServiceInstruction,
        epo-shape:epo-ful-Consignment-epo-ful-hasTotalGoodsItemQuantity,
        epo-shape:epo-ful-Consignment-epo-ful-hasTransportHandlingUnitQuantity,
        epo-shape:epo-ful-Consignment-epo-ful-isHazardousRisk,
        epo-shape:epo-ful-Consignment-epo-specifiesFreightForwarder,
        epo-shape:epo-ful-Consignment-epo-specifiesNotificationReceiver ;
    sh:targetClass epo:Consignment .

epo-shape:epo-ful-DespatchAdviceShape a sh:NodeShape ;
    rdfs:label "Despatch Advice" ;
    rdfs:comment "A document notifying the sending of goods or the execution of works or services." ;
    rdfs:isDefinedBy epo-shape:ful-shape ;
    sh:property epo-shape:epo-ful-DespatchAdvice-epo-ful-comprisesDespatchLine,
        epo-shape:epo-ful-DespatchAdvice-epo-ful-hasDespatchAdviceType,
        epo-shape:epo-ful-DespatchAdvice-epo-ful-refersToConsignment,
        epo-shape:epo-ful-DespatchAdvice-epo-ful-refersToOrder,
        epo-shape:epo-ful-DespatchAdvice-epo-ful-refersToShipmentAgreement,
        epo-shape:epo-ful-DespatchAdvice-epo-ful-specifiesConsignee,
        epo-shape:epo-ful-DespatchAdvice-epo-ful-specifiesDespatcher,
        epo-shape:epo-ful-DespatchAdvice-epo-ful-specifiesOriginator ;
    sh:targetClass epo:DespatchAdvice .

epo-shape:epo-ful-DespatchLineShape a sh:NodeShape ;
    rdfs:label "Despatch Line" ;
    rdfs:comment "Details concerning the fulfilment of an Order Line." ;
    rdfs:isDefinedBy epo-shape:ful-shape ;
    sh:property epo-shape:epo-ful-DespatchLine-epo-ful-hasDespatchedQuantity,
        epo-shape:epo-ful-DespatchLine-epo-ful-hasOutstandingQuantity,
        epo-shape:epo-ful-DespatchLine-epo-ful-hasOutstandingQuantityReason,
        epo-shape:epo-ful-DespatchLine-epo-ful-refersToOrderLine ;
    sh:targetClass epo:DespatchLine .

epo-shape:epo-ful-DespatcherShape a sh:NodeShape ;
    rdfs:label "Despatcher" ;
    rdfs:comment "The Role of an Agent who sends the goods or notifies of the service or works execution. Additional Information: The Role is carried out by the Supplier or on behalf of the Supplier. This Role is often referred to as the Despatch Party, Consignor or Deliverer." ;
    rdfs:isDefinedBy epo-shape:ful-shape ;
    sh:targetClass epo:Despatcher .

epo-shape:epo-ful-FreightForwarderShape a sh:NodeShape ;
    rdfs:label "Freight Forwarder" ;
    rdfs:comment "The Role of an Agent who organise the logistic operations need for a fulfilment." ;
    rdfs:isDefinedBy epo-shape:ful-shape ;
    sh:targetClass epo:FreightForwarder .

epo-shape:epo-ful-GoodsItemShape a sh:NodeShape ;
    rdfs:label "Goods Item" ;
    rdfs:comment "An Item including its initial packaging during transportation. Additional information: For example, the Item being bought is the computer. The weight of the computer is X. The weight of the Goods Item is the weight of the computer plus the weight of the initial packaging. During transportation you have for example trace ID which is applied to the GoodsItem, rather than on the Item itself. The declared statistical value can only apply once you have a GoodsItem." ;
    rdfs:isDefinedBy epo-shape:ful-shape ;
    sh:property epo-shape:epo-ful-GoodsItem-epo-ful-hasDeclaredStatisticalValue,
        epo-shape:epo-ful-GoodsItem-epo-ful-hasTraceID,
        epo-shape:epo-ful-GoodsItem-epo-ful-refersToDespatchLine ;
    sh:targetClass epo:GoodsItem .

epo-shape:epo-ful-NotificationReceiverShape a sh:NodeShape ;
    rdfs:label "Notification Receiver" ;
    rdfs:comment "The Role of an Agent that is informed about the arrival of a Shipment at a destination. Additional information: This could be for example customs and excise." ;
    rdfs:isDefinedBy epo-shape:ful-shape ;
    sh:targetClass epo:NotificationReceiver .

epo-shape:epo-ful-PackageShape a sh:NodeShape ;
    rdfs:label "Package" ;
    rdfs:comment "Container used for transportation." ;
    rdfs:isDefinedBy epo-shape:ful-shape ;
    sh:property epo-shape:epo-ful-Package-epo-ful-containsGoodsItem,
        epo-shape:epo-ful-Package-epo-ful-containsPackage,
        epo-shape:epo-ful-Package-epo-ful-hasPackagingStatus,
        epo-shape:epo-ful-Package-epo-ful-hasPackagingStatusDescription,
        epo-shape:epo-ful-Package-epo-ful-hasPackagingType,
        epo-shape:epo-ful-Package-epo-ful-hasPackagingTypeDescription ;
    sh:targetClass epo:Package .

epo-shape:epo-ful-ReceiptAdviceInformationShape a sh:NodeShape ;
    rdfs:label "Receipt Advice Information" ;
    rdfs:isDefinedBy epo-shape:ful-shape ;
    sh:property epo-shape:epo-ful-ReceiptAdviceInformation-epo-ful-hasRejectAction,
        epo-shape:epo-ful-ReceiptAdviceInformation-epo-ful-hasRejectReason,
        epo-shape:epo-ful-ReceiptAdviceInformation-epo-ful-hasRejectReasonDescription,
        epo-shape:epo-ful-ReceiptAdviceInformation-epo-ful-hasShortageAction,
        epo-shape:epo-ful-ReceiptAdviceInformation-epo-ful-isSpecificToReceiptAdviceLine,
        epo-shape:epo-ful-ReceiptAdviceInformation-epo-ord-hasAcceptanceStatus ;
    sh:targetClass epo:ReceiptAdviceInformation .

epo-shape:epo-ful-ReceiptAdviceLineShape a sh:NodeShape ;
    rdfs:label "Receipt Advice Line" ;
    rdfs:isDefinedBy epo-shape:ful-shape ;
    sh:property epo-shape:epo-ful-ReceiptAdviceLine-epo-ful-hasOversupplyQuantity,
        epo-shape:epo-ful-ReceiptAdviceLine-epo-ful-hasReceivedQuantity,
        epo-shape:epo-ful-ReceiptAdviceLine-epo-ful-hasRejectedQuantity,
        epo-shape:epo-ful-ReceiptAdviceLine-epo-ful-hasShortQuantity,
        epo-shape:epo-ful-ReceiptAdviceLine-epo-ful-isSubmittedForDespatchLine ;
    sh:targetClass epo:ReceiptAdviceLine .

epo-shape:epo-ful-ReceiptAdviceShape a sh:NodeShape ;
    rdfs:label "Receipt Advice" ;
    rdfs:isDefinedBy epo-shape:ful-shape ;
    sh:property epo-shape:epo-ful-ReceiptAdvice-epo-ful-comprisesReceiptAdviceLine,
        epo-shape:epo-ful-ReceiptAdvice-epo-ful-isSubmittedForDespatchAdvice,
        epo-shape:epo-ful-ReceiptAdvice-epo-ful-isSubmittedForShipment,
        epo-shape:epo-ful-ReceiptAdvice-epo-ful-specifiesConsignee,
        epo-shape:epo-ful-ReceiptAdvice-epo-ful-specifiesDespatcher,
        epo-shape:epo-ful-ReceiptAdvice-epo-ful-specifiesReceiptAdviceInformation,
        epo-shape:epo-ful-ReceiptAdvice-epo-specifiesBuyer,
        epo-shape:epo-ful-ReceiptAdvice-epo-specifiesSeller ;
    sh:targetClass epo:ReceiptAdvice .

epo-shape:epo-ful-ShipmentAgreementShape a sh:NodeShape ;
    rdfs:label "Shipment Agreement" ;
    rdfs:comment "The commercial agreement between the Buyer and the Seller. Additional Information: The Shipment Agreement describes the items being shipped." ;
    rdfs:isDefinedBy epo-shape:ful-shape ;
    sh:property epo-shape:epo-ful-ShipmentAgreement-epo-ful-agreedByBuyer,
        epo-shape:epo-ful-ShipmentAgreement-epo-ful-agreedBySeller ;
    sh:targetClass epo:ShipmentAgreement .

epo-shape:epo-ful-ShipmentInformationShape a sh:NodeShape ;
    rdfs:label "Shipment Information" ;
    rdfs:comment "Information about the transportation of an identifiable collection of Goods Items from the Despatcher to the Consignee." ;
    rdfs:isDefinedBy epo-shape:ful-shape ;
    sh:property epo-shape:epo-ful-ShipmentInformation-epo-ful-hasDespatchDate,
        epo-shape:epo-ful-ShipmentInformation-epo-ful-hasDespatchPeriod,
        epo-shape:epo-ful-ShipmentInformation-epo-ful-hasEstimatedDeliveryPeriod,
        epo-shape:epo-ful-ShipmentInformation-epo-ful-isSpecificToDespatchLine,
        epo-shape:epo-ful-ShipmentInformation-epo-ful-refersToDeliveryInformation,
        epo-shape:epo-ful-ShipmentInformation-epo-ful-specifiesPlaceOfDespatch ;
    sh:targetClass epo:ShipmentInformation .

epo-shape:epo-ful-ShipmentStageShape a sh:NodeShape ;
    rdfs:label "Shipment Stage" ;
    rdfs:comment "Part of the itinerary of a shipment. Additional information: In the context of fulfilment only the last part of the itinerary is taken into consideration." ;
    rdfs:isDefinedBy epo-shape:ful-shape ;
    sh:property epo-shape:epo-ful-ShipmentStage-epo-ful-hasDepartureShipmentInformation,
        epo-shape:epo-ful-ShipmentStage-epo-ful-usesTransportMeans,
        epo-shape:epo-ful-ShipmentStage-epo-hasArrivalShipmentInformation,
        epo-shape:epo-ful-ShipmentStage-epo-specifiesCarrier ;
    sh:targetClass epo:ShipmentStage .

epo-shape:epo-ful-TemperatureSpecificationShape a sh:NodeShape ;
    rdfs:label "Temperature Specification" ;
    rdfs:comment "Description of the temperature requirements during shipment." ;
    rdfs:isDefinedBy epo-shape:ful-shape ;
    sh:property epo-shape:epo-ful-TemperatureSpecification-epo-ful-hasMaximumTemperature,
        epo-shape:epo-ful-TemperatureSpecification-epo-ful-hasMinimumTemperature ;
    sh:targetClass epo:TemperatureSpecification .

epo-shape:epo-ful-TransportEquipmentSealShape a sh:NodeShape ;
    rdfs:label "Transport Equipment Seal" ;
    rdfs:comment "Means used to ensure that the Transport Equipment is not tampered during transportation." ;
    rdfs:isDefinedBy epo-shape:ful-shape ;
    sh:targetClass epo:TransportEquipmentSeal .

epo-shape:epo-ful-TransportEquipmentShape a sh:NodeShape ;
    rdfs:label "Transport Equipment" ;
    rdfs:comment "Description of the apparatus used during transportation. Additional information: The equipment may be a container, a trailer, means of assistance to load or unload the Goods Items." ;
    rdfs:isDefinedBy epo-shape:ful-shape ;
    sh:property epo-shape:epo-ful-TransportEquipment-epo-ful-hasSizeType,
        epo-shape:epo-ful-TransportEquipment-epo-ful-hasTransportEquipmentSeal,
        epo-shape:epo-ful-TransportEquipment-epo-ful-hasTransportEquipmentType,
        epo-shape:epo-ful-TransportEquipment-epo-ful-isPowerIndicated,
        epo-shape:epo-ful-TransportEquipment-epo-ful-isRefrigerated ;
    sh:targetClass epo:TransportEquipment .

epo-shape:epo-ful-TransportHandlingUnitShape a sh:NodeShape ;
    rdfs:label "Transport Handling Unit" ;
    rdfs:comment "The outermost Package that the Carrier is handling." ;
    rdfs:isDefinedBy epo-shape:ful-shape ;
    sh:property epo-shape:epo-ful-TransportHandlingUnit-epo-ful-hasHandlingInstruction,
        epo-shape:epo-ful-TransportHandlingUnit-epo-ful-hasHandlingInstructionCode,
        epo-shape:epo-ful-TransportHandlingUnit-epo-ful-usesTransportEquipment,
        epo-shape:epo-ful-TransportHandlingUnit-epo-ord-hasShippingMark ;
    sh:targetClass epo:TransportHandlingUnit .

epo-shape:epo-ful-TransportMeansOperatorShape a sh:NodeShape ;
    rdfs:label "Transport Means Operator" ;
    rdfs:comment "The Role of an Agent who is responsible for controlling the Transport Means." ;
    rdfs:isDefinedBy epo-shape:ful-shape ;
    sh:property epo-shape:epo-ful-TransportMeansOperator-epo-playedBy ;
    sh:targetClass epo:TransportMeansOperator .

epo-shape:epo-ful-TransportMeansShape a sh:NodeShape ;
    rdfs:label "Transport Means" ;
    rdfs:comment "Description of a particular vehicle or vessel used for the conveyance of goods or persons." ;
    rdfs:isDefinedBy epo-shape:ful-shape ;
    sh:property epo-shape:epo-ful-TransportMeans-epo-ful-hasTransportMeansType,
        epo-shape:epo-ful-TransportMeans-epo-ful-hasTransportMode,
        epo-shape:epo-ful-TransportMeans-epo-ful-hasVehicleID,
        epo-shape:epo-ful-TransportMeans-epo-ful-hasVehicleSegmentID,
        epo-shape:epo-ful-TransportMeans-epo-hasDriverPerson ;
    sh:targetClass epo:TransportMeans .

epo-shape:epo-inv-Invoice sh:property epo-shape:epo-inv-Invoice-epo-inv-refersToDespatchAdvice,
        epo-shape:epo-inv-Invoice-epo-inv-refersToReceiptAdvice .

epo-shape:epo-ord-AllowanceChargeInformation sh:property epo-shape:epo-ord-AllowanceChargeInformation-epo-ful-hasAllowanceChargeReason .

epo-shape:epo-ord-Order sh:property epo-shape:epo-ord-Order-epo-ful-specifiesDespatcher .

epo-shape:epo-cat-CatalogueLine-epo-cat-foreseesPackage a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:ful-shape ;
    sh:class epo:Package ;
    sh:maxCount 1 ;
    sh:name "Foresees package" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:foreseesPackage ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#foreseesPackage> ?that . ?that <http://data.europa.eu/a4g/ontology#foreseesPackage> ?this .}" ] .

epo-shape:epo-cat-DimensionInformation-epo-ful-concernsGoodsItem a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:ful-shape ;
    sh:class epo:GoodsItem ;
    sh:maxCount 1 ;
    sh:name "Concerns goods item" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:concernsGoodsItem ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#concernsGoodsItem> ?that . ?that <http://data.europa.eu/a4g/ontology#concernsGoodsItem> ?this .}" ] .

epo-shape:epo-cat-DimensionInformation-epo-ful-concernsPackage a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:ful-shape ;
    sh:class epo:Package ;
    sh:maxCount 1 ;
    sh:name "Concerns package" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:concernsPackage ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#concernsPackage> ?that . ?that <http://data.europa.eu/a4g/ontology#concernsPackage> ?this .}" ] .

epo-shape:epo-cat-DimensionInformation-epo-ful-concernsTransportEquipment a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:ful-shape ;
    sh:class epo:TransportEquipment ;
    sh:maxCount 1 ;
    sh:name "Concerns transport equipment" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:concernsTransportEquipment ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#concernsTransportEquipment> ?that . ?that <http://data.europa.eu/a4g/ontology#concernsTransportEquipment> ?this .}" ] .

epo-shape:epo-cat-DimensionInformation-epo-ful-concernsTransportMeans a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:ful-shape ;
    sh:class epo:TransportMeans ;
    sh:maxCount 1 ;
    sh:name "Concerns transport means" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:concernsTransportMeans ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#concernsTransportMeans> ?that . ?that <http://data.europa.eu/a4g/ontology#concernsTransportMeans> ?this .}" ] .

epo-shape:epo-cat-EnvironmentalEmissionInformation-epo-ful-concernsTransportMeans a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:ful-shape ;
    sh:class epo:TransportMeans ;
    sh:maxCount 1 ;
    sh:name "Concerns transport means" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:concernsTransportMeans ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#concernsTransportMeans> ?that . ?that <http://data.europa.eu/a4g/ontology#concernsTransportMeans> ?this .}" ] .

epo-shape:epo-cat-PostAwardDocument-epo-hasDocumentStatus a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:ful-shape ;
    sh:class skos:Concept ;
    sh:description "https://test-docs.peppol.eu/logistics/transport-execution/codelist/DocumentStatusCode/" ;
    sh:maxCount 1 ;
    sh:name "Has document status" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasDocumentStatus .

epo-shape:epo-ful-AbstractContainer-epo-ful-hasGrossVolume a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:ful-shape ;
    sh:class epo:Quantity ;
    sh:description "The amount of space that is required including the packaging." ;
    sh:maxCount 1 ;
    sh:name "Has gross volume" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasGrossVolume ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasGrossVolume> ?that . ?that <http://data.europa.eu/a4g/ontology#hasGrossVolume> ?this .}" ] .

epo-shape:epo-ful-AbstractContainer-epo-ful-hasGrossWeight a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:ful-shape ;
    sh:class epo:Quantity ;
    sh:description "The total mass of goods including the packaging." ;
    sh:maxCount 1 ;
    sh:name "Has gross weight" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasGrossWeight ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasGrossWeight> ?that . ?that <http://data.europa.eu/a4g/ontology#hasGrossWeight> ?this .}" ] .

epo-shape:epo-ful-AbstractContainer-epo-ful-hasHeight a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:ful-shape ;
    sh:class epo:Quantity ;
    sh:description "The vertical measurement." ;
    sh:maxCount 1 ;
    sh:name "Has height" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasHeight ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasHeight> ?that . ?that <http://data.europa.eu/a4g/ontology#hasHeight> ?this .}" ] .

epo-shape:epo-ful-AbstractContainer-epo-ful-hasLength a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:ful-shape ;
    sh:class epo:Quantity ;
    sh:description "The horizontal measurement. Additional Information: The length is the longer side between the length and the width." ;
    sh:maxCount 1 ;
    sh:name "Has length" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasLength ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasLength> ?that . ?that <http://data.europa.eu/a4g/ontology#hasLength> ?this .}" ] .

epo-shape:epo-ful-AbstractContainer-epo-ful-hasNetVolume a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:ful-shape ;
    sh:class epo:Quantity ;
    sh:description "The amount of space that is required without the packaging." ;
    sh:maxCount 1 ;
    sh:name "Has net volume" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasNetVolume ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasNetVolume> ?that . ?that <http://data.europa.eu/a4g/ontology#hasNetVolume> ?this .}" ] .

epo-shape:epo-ful-AbstractContainer-epo-ful-hasNetWeight a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:ful-shape ;
    sh:class epo:Quantity ;
    sh:description "The total mass of goods without the packaging." ;
