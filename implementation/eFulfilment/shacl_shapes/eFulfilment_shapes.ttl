@prefix : <http://data.europa.eu/a4g/ontology#> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ful-shape: <http://data.europa.eu/a4g/data-shape#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ful-shape:epo-cat-CatalogueLineShape sh:property ful-shape:epo-cat-CatalogueLine-epo-cat-foreseesPackage .

ful-shape:epo-cat-DimensionInformationShape sh:property ful-shape:epo-cat-DimensionInformation-epo-ful-concernsGoodsItem,
        ful-shape:epo-cat-DimensionInformation-epo-ful-concernsPackage,
        ful-shape:epo-cat-DimensionInformation-epo-ful-concernsTransportEquipment,
        ful-shape:epo-cat-DimensionInformation-epo-ful-concernsTransportMeans .

ful-shape:epo-cat-EnvironmentalEmissionInformationShape sh:property ful-shape:epo-cat-EnvironmentalEmissionInformation-epo-ful-concernsTransportMeans .

ful-shape:epo-cat-PostAwardDocumentShape sh:property ful-shape:epo-cat-PostAwardDocument-epo-hasDocumentStatus .

ful-shape:epo-ful-AbstractContainerShape a sh:NodeShape ;
    rdfs:label "Abstract container" ;
    rdfs:comment "Gathering class for Packages and Transport Handling Units." ;
    rdfs:isDefinedBy ful-shape:ful-shape ;
    sh:property ful-shape:epo-ful-AbstractContainer-epo-ful-hasGrossVolume,
        ful-shape:epo-ful-AbstractContainer-epo-ful-hasGrossWeight,
        ful-shape:epo-ful-AbstractContainer-epo-ful-hasHeight,
        ful-shape:epo-ful-AbstractContainer-epo-ful-hasLength,
        ful-shape:epo-ful-AbstractContainer-epo-ful-hasNetVolume,
        ful-shape:epo-ful-AbstractContainer-epo-ful-hasNetWeight,
        ful-shape:epo-ful-AbstractContainer-epo-ful-hasPackingMaterialDescription,
        ful-shape:epo-ful-AbstractContainer-epo-ful-hasTemperatureSpecification,
        ful-shape:epo-ful-AbstractContainer-epo-ful-hasTotalGoodsItemQuantity,
        ful-shape:epo-ful-AbstractContainer-epo-ful-hasWidth,
        ful-shape:epo-ful-AbstractContainer-epo-ful-isHazardousRisk,
        ful-shape:epo-ful-AbstractContainer-epo-ful-isReturnableMaterial,
        ful-shape:epo-ful-AbstractContainer-epo-ord-hasAcceptanceStatus ;
    sh:targetClass :AbstractContainer .

ful-shape:epo-ful-CarrierShape a sh:NodeShape ;
    rdfs:label "Carrier" ;
    rdfs:comment "The Role of an Agent who handles the physical Delivery/Transportation of the (Despatched) Shipment. Additional Information: This Role is often referred to as the deliverer." ;
    rdfs:isDefinedBy ful-shape:ful-shape ;
    sh:targetClass :Carrier .

ful-shape:epo-ful-ConsignmentShape a sh:NodeShape ;
    rdfs:label "Consignment" ;
    rdfs:comment "A batch of goods destined for or delivered to someone. Additional information: Consignment is a Transport Agreement between the Despatcher and the Consignee as to who and how the goods are despatched and received." ;
    rdfs:isDefinedBy ful-shape:ful-shape ;
    sh:property ful-shape:epo-ful-Consignment-epo-ful-containsTransportHandlingUnit,
        ful-shape:epo-ful-Consignment-epo-ful-hasCarriageShipmentStage,
        ful-shape:epo-ful-Consignment-epo-ful-hasConsigneeConsignmentID,
        ful-shape:epo-ful-Consignment-epo-ful-hasDeclaredStatisticalValue,
        ful-shape:epo-ful-Consignment-epo-ful-hasDespatcherConsignmentID,
        ful-shape:epo-ful-Consignment-epo-ful-hasFreightCharge,
        ful-shape:epo-ful-Consignment-epo-ful-hasGrossVolume,
        ful-shape:epo-ful-Consignment-epo-ful-hasGrossWeight,
        ful-shape:epo-ful-Consignment-epo-ful-hasHandlingInstruction,
        ful-shape:epo-ful-Consignment-epo-ful-hasHandlingInstructionCode,
        ful-shape:epo-ful-Consignment-epo-ful-hasLoadingMeter,
        ful-shape:epo-ful-Consignment-epo-ful-hasNetWeight,
        ful-shape:epo-ful-Consignment-epo-ful-hasRequestedPickUpInformation,
        ful-shape:epo-ful-Consignment-epo-ful-hasSpecialServiceInstruction,
        ful-shape:epo-ful-Consignment-epo-ful-hasTotalGoodsItemQuantity,
        ful-shape:epo-ful-Consignment-epo-ful-hasTransportHandlingUnitQuantity,
        ful-shape:epo-ful-Consignment-epo-ful-isHazardousRisk,
        ful-shape:epo-ful-Consignment-epo-specifiesFreightForwarder,
        ful-shape:epo-ful-Consignment-epo-specifiesNotificationReceiver ;
    sh:targetClass :Consignment .

ful-shape:epo-ful-DespatchAdviceShape a sh:NodeShape ;
    rdfs:label "Despatch advice" ;
    rdfs:comment "A document notifying the sending of goods or the execution of works or services." ;
    rdfs:isDefinedBy ful-shape:ful-shape ;
    sh:property ful-shape:epo-ful-DespatchAdvice-epo-ful-comprisesDespatchLine,
        ful-shape:epo-ful-DespatchAdvice-epo-ful-hasDespatchAdviceType,
        ful-shape:epo-ful-DespatchAdvice-epo-ful-refersToConsignment,
        ful-shape:epo-ful-DespatchAdvice-epo-ful-refersToOrder,
        ful-shape:epo-ful-DespatchAdvice-epo-ful-refersToShipmentAgreement,
        ful-shape:epo-ful-DespatchAdvice-epo-ful-specifiesConsignee,
        ful-shape:epo-ful-DespatchAdvice-epo-ful-specifiesDespatcher,
        ful-shape:epo-ful-DespatchAdvice-epo-ful-specifiesOriginator ;
    sh:targetClass :DespatchAdvice .

ful-shape:epo-ful-DespatchLineShape a sh:NodeShape ;
    rdfs:label "Despatch line" ;
    rdfs:comment "Details concerning the fulfilment of an Order Line." ;
    rdfs:isDefinedBy ful-shape:ful-shape ;
    sh:property ful-shape:epo-ful-DespatchLine-epo-ful-hasDespatchedQuantity,
        ful-shape:epo-ful-DespatchLine-epo-ful-hasOutstandingQuantity,
        ful-shape:epo-ful-DespatchLine-epo-ful-hasOutstandingQuantityReason,
        ful-shape:epo-ful-DespatchLine-epo-ful-refersToOrderLine ;
    sh:targetClass :DespatchLine .

ful-shape:epo-ful-DespatcherShape a sh:NodeShape ;
    rdfs:label "Despatcher" ;
    rdfs:comment "The Role of an Agent who sends the goods or notifies of the service or works execution. Additional Information: The Role is carried out by the Supplier or on behalf of the Supplier. This Role is often referred to as the Despatch Party, Consignor or Deliverer." ;
    rdfs:isDefinedBy ful-shape:ful-shape ;
    sh:targetClass :Despatcher .

ful-shape:epo-ful-FreightForwarderShape a sh:NodeShape ;
    rdfs:label "Freight forwarder" ;
    rdfs:comment "The Role of an Agent who organise the logistic operations need for a fulfilment." ;
    rdfs:isDefinedBy ful-shape:ful-shape ;
    sh:targetClass :FreightForwarder .

ful-shape:epo-ful-GoodsItemShape a sh:NodeShape ;
    rdfs:label "Goods item" ;
    rdfs:comment "An Item including its initial packaging during transportation. Additional information: For example, the Item being bought is the computer. The weight of the computer is X. The weight of the Goods Item is the weight of the computer plus the weight of the initial packaging. During transportation you have for example trace ID which is applied to the GoodsItem, rather than on the Item itself. The declared statistical value can only apply once you have a GoodsItem." ;
    rdfs:isDefinedBy ful-shape:ful-shape ;
    sh:property ful-shape:epo-ful-GoodsItem-epo-ful-hasDeclaredStatisticalValue,
        ful-shape:epo-ful-GoodsItem-epo-ful-hasTraceID,
        ful-shape:epo-ful-GoodsItem-epo-ful-refersToDespatchLine ;
    sh:targetClass :GoodsItem .

ful-shape:epo-ful-NotificationReceiverShape a sh:NodeShape ;
    rdfs:label "Notification receiver" ;
    rdfs:comment "The Role of an Agent that is informed about the arrival of a Shipment at a destination. Additional information: This could be for example customs and excise." ;
    rdfs:isDefinedBy ful-shape:ful-shape ;
    sh:targetClass :NotificationReceiver .

ful-shape:epo-ful-PackageShape a sh:NodeShape ;
    rdfs:label "Package" ;
    rdfs:comment "Container used for transportation." ;
    rdfs:isDefinedBy ful-shape:ful-shape ;
    sh:property ful-shape:epo-ful-Package-epo-ful-containsGoodsItem,
        ful-shape:epo-ful-Package-epo-ful-containsPackage,
        ful-shape:epo-ful-Package-epo-ful-hasPackagingStatus,
        ful-shape:epo-ful-Package-epo-ful-hasPackagingStatusDescription,
        ful-shape:epo-ful-Package-epo-ful-hasPackagingType,
        ful-shape:epo-ful-Package-epo-ful-hasPackagingTypeDescription ;
    sh:targetClass :Package .

ful-shape:epo-ful-ReceiptAdviceInformationShape a sh:NodeShape ;
    rdfs:label "Receipt advice information" ;
    rdfs:isDefinedBy ful-shape:ful-shape ;
    sh:property ful-shape:epo-ful-ReceiptAdviceInformation-epo-ful-hasRejectAction,
        ful-shape:epo-ful-ReceiptAdviceInformation-epo-ful-hasRejectReason,
        ful-shape:epo-ful-ReceiptAdviceInformation-epo-ful-hasRejectReasonDescription,
        ful-shape:epo-ful-ReceiptAdviceInformation-epo-ful-hasShortageAction,
        ful-shape:epo-ful-ReceiptAdviceInformation-epo-ful-isSpecificToReceiptAdviceLine,
        ful-shape:epo-ful-ReceiptAdviceInformation-epo-ord-hasAcceptanceStatus ;
    sh:targetClass :ReceiptAdviceInformation .

ful-shape:epo-ful-ReceiptAdviceLineShape a sh:NodeShape ;
    rdfs:label "Receipt advice line" ;
    rdfs:isDefinedBy ful-shape:ful-shape ;
    sh:property ful-shape:epo-ful-ReceiptAdviceLine-epo-ful-hasOversupplyQuantity,
        ful-shape:epo-ful-ReceiptAdviceLine-epo-ful-hasReceivedQuantity,
        ful-shape:epo-ful-ReceiptAdviceLine-epo-ful-hasRejectedQuantity,
        ful-shape:epo-ful-ReceiptAdviceLine-epo-ful-hasShortQuantity,
        ful-shape:epo-ful-ReceiptAdviceLine-epo-ful-isSubmittedForDespatchLine ;
    sh:targetClass :ReceiptAdviceLine .

ful-shape:epo-ful-ReceiptAdviceShape a sh:NodeShape ;
    rdfs:label "Receipt advice" ;
    rdfs:isDefinedBy ful-shape:ful-shape ;
    sh:property ful-shape:epo-ful-ReceiptAdvice-epo-ful-comprisesReceiptAdviceLine,
        ful-shape:epo-ful-ReceiptAdvice-epo-ful-isSubmittedForDespatchAdvice,
        ful-shape:epo-ful-ReceiptAdvice-epo-ful-isSubmittedForShipment,
        ful-shape:epo-ful-ReceiptAdvice-epo-ful-specifiesBuyer,
        ful-shape:epo-ful-ReceiptAdvice-epo-ful-specifiesConsignee,
        ful-shape:epo-ful-ReceiptAdvice-epo-ful-specifiesDespatcher,
        ful-shape:epo-ful-ReceiptAdvice-epo-ful-specifiesReceiptAdviceInformation,
        ful-shape:epo-ful-ReceiptAdvice-epo-ful-specifiesSeller ;
    sh:targetClass :ReceiptAdvice .

ful-shape:epo-ful-ShipmentAgreementShape a sh:NodeShape ;
    rdfs:label "Shipment agreement" ;
    rdfs:comment "The commercial agreement between the Buyer and the Seller. Additional Information: The Shipment Agreement describes the items being shipped." ;
    rdfs:isDefinedBy ful-shape:ful-shape ;
    sh:property ful-shape:epo-ful-ShipmentAgreement-epo-ful-agreedByBuyer,
        ful-shape:epo-ful-ShipmentAgreement-epo-ful-agreedBySeller ;
    sh:targetClass :ShipmentAgreement .

ful-shape:epo-ful-ShipmentInformationShape a sh:NodeShape ;
    rdfs:label "Shipment information" ;
    rdfs:comment "Information about the transportation of an identifiable collection of Goods Items from the Despatcher to the Consignee." ;
    rdfs:isDefinedBy ful-shape:ful-shape ;
    sh:property ful-shape:epo-ful-ShipmentInformation-epo-ful-hasDespatchDate,
        ful-shape:epo-ful-ShipmentInformation-epo-ful-hasDespatchPeriod,
        ful-shape:epo-ful-ShipmentInformation-epo-ful-hasEstimatedDeliveryPeriod,
        ful-shape:epo-ful-ShipmentInformation-epo-ful-isSpecificToDespatchLine,
        ful-shape:epo-ful-ShipmentInformation-epo-ful-refersToDeliveryInformation,
        ful-shape:epo-ful-ShipmentInformation-epo-ful-specifiesPlaceOfDespatch ;
    sh:targetClass :ShipmentInformation .

ful-shape:epo-ful-ShipmentStageShape a sh:NodeShape ;
    rdfs:label "Shipment stage" ;
    rdfs:comment "Part of the itinerary of a shipment. Additional information: In the context of fulfilment only the last part of the itinerary is taken into consideration." ;
    rdfs:isDefinedBy ful-shape:ful-shape ;
    sh:property ful-shape:epo-ful-ShipmentStage-epo-ful-hasDepartureShipmentInformation,
        ful-shape:epo-ful-ShipmentStage-epo-ful-usesTransportMeans,
        ful-shape:epo-ful-ShipmentStage-epo-hasArrivalShipmentInformation,
        ful-shape:epo-ful-ShipmentStage-epo-specifiesCarrier ;
    sh:targetClass :ShipmentStage .

ful-shape:epo-ful-TemperatureSpecificationShape a sh:NodeShape ;
    rdfs:label "Temperature specification" ;
    rdfs:comment "Description of the temperature requirements during shipment." ;
    rdfs:isDefinedBy ful-shape:ful-shape ;
    sh:property ful-shape:epo-ful-TemperatureSpecification-epo-ful-hasMaximumTemperature,
        ful-shape:epo-ful-TemperatureSpecification-epo-ful-hasMinimumTemperature ;
    sh:targetClass :TemperatureSpecification .

ful-shape:epo-ful-TransportEquipmentSealShape a sh:NodeShape ;
    rdfs:label "Transport equipment seal" ;
    rdfs:comment "Means used to ensure that the Transport Equipment is not tampered during transportation." ;
    rdfs:isDefinedBy ful-shape:ful-shape ;
    sh:targetClass :TransportEquipmentSeal .

ful-shape:epo-ful-TransportEquipmentShape a sh:NodeShape ;
    rdfs:label "Transport equipment" ;
    rdfs:comment "Description of the apparatus used during transportation. Additional information: The equipment may be a container, a trailer, means of assistance to load or unload the Goods Items." ;
    rdfs:isDefinedBy ful-shape:ful-shape ;
    sh:property ful-shape:epo-ful-TransportEquipment-epo-ful-hasSizeType,
        ful-shape:epo-ful-TransportEquipment-epo-ful-hasTransportEquipmentSeal,
        ful-shape:epo-ful-TransportEquipment-epo-ful-hasTransportEquipmentType,
        ful-shape:epo-ful-TransportEquipment-epo-ful-isPowerIndicated,
        ful-shape:epo-ful-TransportEquipment-epo-ful-isRefrigerated ;
    sh:targetClass :TransportEquipment .

ful-shape:epo-ful-TransportHandlingUnitShape a sh:NodeShape ;
    rdfs:label "Transport handling unit" ;
    rdfs:comment "The outermost Package that the Carrier is handling." ;
    rdfs:isDefinedBy ful-shape:ful-shape ;
    sh:property ful-shape:epo-ful-TransportHandlingUnit-epo-ful-hasHandlingInstruction,
        ful-shape:epo-ful-TransportHandlingUnit-epo-ful-hasHandlingInstructionCode,
        ful-shape:epo-ful-TransportHandlingUnit-epo-ful-usesTransportEquipment,
        ful-shape:epo-ful-TransportHandlingUnit-epo-ord-hasShippingMark ;
    sh:targetClass :TransportHandlingUnit .

ful-shape:epo-ful-TransportMeansOperatorShape a sh:NodeShape ;
    rdfs:label "Transport means operator" ;
    rdfs:comment "The Role of an Agent who is responsible for controlling the Transport Means." ;
    rdfs:isDefinedBy ful-shape:ful-shape ;
    sh:property ful-shape:epo-ful-TransportMeansOperator-epo-playedBy ;
    sh:targetClass :TransportMeansOperator .

ful-shape:epo-ful-TransportMeansShape a sh:NodeShape ;
    rdfs:label "Transport means" ;
    rdfs:comment "Description of a particular vehicle or vessel used for the conveyance of goods or persons." ;
    rdfs:isDefinedBy ful-shape:ful-shape ;
    sh:property ful-shape:epo-ful-TransportMeans-epo-ful-hasTransportMeansType,
        ful-shape:epo-ful-TransportMeans-epo-ful-hasTransportMode,
        ful-shape:epo-ful-TransportMeans-epo-ful-hasVehicleID,
        ful-shape:epo-ful-TransportMeans-epo-ful-hasVehicleSegmentID,
        ful-shape:epo-ful-TransportMeans-epo-hasDriverPerson ;
    sh:targetClass :TransportMeans .

ful-shape:epo-inv-InvoiceShape sh:property ful-shape:epo-inv-Invoice-epo-inv-refersToDespatchAdvice,
        ful-shape:epo-inv-Invoice-epo-inv-refersToReceiptAdvice .

ful-shape:epo-ord-AllowanceChargeInformationShape sh:property ful-shape:epo-ord-AllowanceChargeInformation-epo-ful-hasAllowanceChargeReason .

ful-shape:epo-ord-OrderShape sh:property ful-shape:epo-ord-Order-epo-ful-specifiesDespatcher .

ful-shape:epo-cat-CatalogueLine-epo-cat-foreseesPackage a sh:PropertyShape ;
    rdfs:isDefinedBy ful-shape:ful-shape ;
    sh:class :Package ;
    sh:maxCount 1 ;
    sh:name "Foresees package" ;
    sh:path :foreseesPackage ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#foreseesPackage> ?that . ?that <http://data.europa.eu/a4g/ontology#foreseesPackage> ?this .}" ] .

ful-shape:epo-cat-DimensionInformation-epo-ful-concernsGoodsItem a sh:PropertyShape ;
    rdfs:isDefinedBy ful-shape:ful-shape ;
    sh:class :GoodsItem ;
    sh:maxCount 1 ;
    sh:name "Concerns goods item" ;
    sh:path :concernsGoodsItem ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#concernsGoodsItem> ?that . ?that <http://data.europa.eu/a4g/ontology#concernsGoodsItem> ?this .}" ] .

ful-shape:epo-cat-DimensionInformation-epo-ful-concernsPackage a sh:PropertyShape ;
    rdfs:isDefinedBy ful-shape:ful-shape ;
    sh:class :Package ;
    sh:maxCount 1 ;
    sh:name "Concerns package" ;
    sh:path :concernsPackage ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#concernsPackage> ?that . ?that <http://data.europa.eu/a4g/ontology#concernsPackage> ?this .}" ] .

ful-shape:epo-cat-DimensionInformation-epo-ful-concernsTransportEquipment a sh:PropertyShape ;
    rdfs:isDefinedBy ful-shape:ful-shape ;
    sh:class :TransportEquipment ;
    sh:maxCount 1 ;
    sh:name "Concerns transport equipment" ;
    sh:path :concernsTransportEquipment ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#concernsTransportEquipment> ?that . ?that <http://data.europa.eu/a4g/ontology#concernsTransportEquipment> ?this .}" ] .

ful-shape:epo-cat-DimensionInformation-epo-ful-concernsTransportMeans a sh:PropertyShape ;
    rdfs:isDefinedBy ful-shape:ful-shape ;
    sh:class :TransportMeans ;
    sh:maxCount 1 ;
    sh:name "Concerns transport means" ;
    sh:path :concernsTransportMeans ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#concernsTransportMeans> ?that . ?that <http://data.europa.eu/a4g/ontology#concernsTransportMeans> ?this .}" ] .

ful-shape:epo-cat-EnvironmentalEmissionInformation-epo-ful-concernsTransportMeans a sh:PropertyShape ;
    rdfs:isDefinedBy ful-shape:ful-shape ;
    sh:class :TransportMeans ;
    sh:maxCount 1 ;
    sh:name "Concerns transport means" ;
    sh:path :concernsTransportMeans ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#concernsTransportMeans> ?that . ?that <http://data.europa.eu/a4g/ontology#concernsTransportMeans> ?this .}" ] .

ful-shape:epo-cat-PostAwardDocument-epo-hasDocumentStatus a sh:PropertyShape ;
    rdfs:isDefinedBy ful-shape:ful-shape ;
    sh:class skos:Concept ;
    sh:description "https://test-docs.peppol.eu/logistics/transport-execution/codelist/DocumentStatusCode/" ;
    sh:maxCount 1 ;
    sh:name "Has document status" ;
    sh:path :hasDocumentStatus .

ful-shape:epo-ful-AbstractContainer-epo-ful-hasGrossVolume a sh:PropertyShape ;
    rdfs:isDefinedBy ful-shape:ful-shape ;
    sh:class :Quantity ;
    sh:description "The amount of space that is required including the packaging." ;
    sh:maxCount 1 ;
    sh:name "Has gross volume" ;
    sh:path :hasGrossVolume ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasGrossVolume> ?that . ?that <http://data.europa.eu/a4g/ontology#hasGrossVolume> ?this .}" ] .

ful-shape:epo-ful-AbstractContainer-epo-ful-hasGrossWeight a sh:PropertyShape ;
    rdfs:isDefinedBy ful-shape:ful-shape ;
    sh:class :Quantity ;
    sh:description "The total mass of goods including the packaging." ;
    sh:maxCount 1 ;
    sh:name "Has gross weight" ;
    sh:path :hasGrossWeight ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasGrossWeight> ?that . ?that <http://data.europa.eu/a4g/ontology#hasGrossWeight> ?this .}" ] .

ful-shape:epo-ful-AbstractContainer-epo-ful-hasHeight a sh:PropertyShape ;
    rdfs:isDefinedBy ful-shape:ful-shape ;
    sh:class :Quantity ;
    sh:description "The vertical measurement." ;
    sh:maxCount 1 ;
    sh:name "Has height" ;
    sh:path :hasHeight ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasHeight> ?that . ?that <http://data.europa.eu/a4g/ontology#hasHeight> ?this .}" ] .

ful-shape:epo-ful-AbstractContainer-epo-ful-hasLength a sh:PropertyShape ;
    rdfs:isDefinedBy ful-shape:ful-shape ;
    sh:class :Quantity ;
    sh:description "The horizontal measurement. Additional Information: The length is the longer side between the length and the width." ;
    sh:maxCount 1 ;
    sh:name "Has length" ;
    sh:path :hasLength ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasLength> ?that . ?that <http://data.europa.eu/a4g/ontology#hasLength> ?this .}" ] .

ful-shape:epo-ful-AbstractContainer-epo-ful-hasNetVolume a sh:PropertyShape ;
    rdfs:isDefinedBy ful-shape:ful-shape ;
    sh:class :Quantity ;
    sh:description "The amount of space that is required without the packaging." ;
    sh:maxCount 1 ;
    sh:name "Has net volume" ;
    sh:path :hasNetVolume ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasNetVolume> ?that . ?that <http://data.europa.eu/a4g/ontology#hasNetVolume> ?this .}" ] .

ful-shape:epo-ful-AbstractContainer-epo-ful-hasNetWeight a sh:PropertyShape ;
    rdfs:isDefinedBy ful-shape:ful-shape ;
    sh:class :Quantity ;
    sh:description "The total mass of goods without the packaging." ;
    sh:maxCount 1 ;
    sh:name "Has net weight" ;
    sh:path :hasNetWeight ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasNetWeight> ?that . ?that <http://data.europa.eu/a4g/ontology#hasNetWeight> ?this .}" ] .

ful-shape:epo-ful-AbstractContainer-epo-ful-hasPackingMaterialDescription a sh:PropertyShape ;
    rdfs:isDefinedBy ful-shape:ful-shape ;
    sh:maxCount 1 ;
    sh:name "Has packing material description" ;
    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
    sh:path :hasPackingMaterialDescription .

ful-shape:epo-ful-AbstractContainer-epo-ful-hasTemperatureSpecification a sh:PropertyShape ;
    rdfs:isDefinedBy ful-shape:ful-shape ;
    sh:class :TemperatureSpecification ;
    sh:description "Relation indicating the Temperature Specification for the instance of the concept." ;
    sh:maxCount 1 ;
    sh:name "Has temperature specification" ;
