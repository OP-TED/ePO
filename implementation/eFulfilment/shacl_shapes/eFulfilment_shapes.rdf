  <rdf:Description rdf:about="http://data.europa.eu/a4g/data-shape#epo-ful-GoodsItemShape">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#ful-shape"/>
    <rdfs:label>Goods Item</rdfs:label>
    <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-ful-GoodsItem-epo-ful-hasTraceID"/>
    <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-ful-GoodsItem-epo-ful-refersToDespatchLine"/>
    <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-ful-GoodsItem-epo-ful-hasDeclaredStatisticalValue"/>
    <sh:targetClass rdf:resource="http://data.europa.eu/a4g/ontology#GoodsItem"/>
    <rdfs:comment>An Item including its initial packaging during transportation. Additional information: For example, the Item being bought is the computer. The weight of the computer is X. The weight of the Goods Item is the weight of the computer plus the weight of the initial packaging. During transportation you have for example trace ID which is applied to the GoodsItem, rather than on the Item itself. The declared statistical value can only apply once you have a GoodsItem.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
  </rdf:Description>
