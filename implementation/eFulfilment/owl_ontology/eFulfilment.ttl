@prefix : <http://data.europa.eu/a4g/ontology#> .
@prefix cccev: <http://data.europa.eu/m8g/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eli: <http://data.europa.eu/eli/ontology#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:Carrier a owl:Class ;
    rdfs:isDefinedBy :ful ;
    rdfs:subClassOf :AuxiliaryParty ;
    skos:definition "The Role of an Agent who handles the physical Delivery/Transportation of the (Despatched) Shipment. Additional Information: This Role is often referred to as the deliverer."@en ;
    skos:historyNote "WG Approval 14/05/2024"@en ;
    skos:prefLabel "Carrier"@en .

:Consignment a owl:Class ;
    rdfs:isDefinedBy :ful ;
    skos:definition "A batch of goods destined for or delivered to someone. Additional information: Consignment is a Transport Agreement between the Despatcher and the Consignee as to who and how the goods are despatched and received."@en ;
    skos:historyNote "WG Approval 14/05/2024"@en ;
    skos:prefLabel "Consignment"@en .

:DespatchAdvice a owl:Class ;
    rdfs:isDefinedBy :ful ;
    rdfs:subClassOf :PostAwardDocument ;
    skos:definition "A document notifying the sending of goods or the execution of works or services."@en ;
    skos:historyNote "WG Approval 14/05/2024"@en ;
    skos:prefLabel "Despatch Advice"@en .

:DespatchLine a owl:Class ;
    rdfs:isDefinedBy :ful ;
    rdfs:subClassOf :Line ;
    skos:definition "Details concerning the fulfilment of an Order Line."@en ;
    skos:historyNote "WG Approval 21/05/2024"@en ;
    skos:prefLabel "Despatch Line"@en .

:Despatcher a owl:Class ;
    rdfs:isDefinedBy :ful ;
    rdfs:subClassOf :OfferingParty ;
    skos:definition "The Role of an Agent who sends the goods or notifies of the service or works execution. Additional Information: The Role is carried out by the Supplier or on behalf of the Supplier. This Role is often referred to as the Despatch Party, Consignor or Deliverer."@en ;
    skos:historyNote "WG Approval 02/07/2024"@en ;
    skos:prefLabel "Despatcher"@en .

:FreightForwarder a owl:Class ;
    rdfs:isDefinedBy :ful ;
    rdfs:subClassOf :AuxiliaryParty ;
    skos:definition "The Role of an Agent who organise the logistic operations need for a fulfilment."@en ;
    skos:historyNote "WG Approval 21/05/2024"@en ;
    skos:prefLabel "Freight Forwarder"@en .

:GoodsItem a owl:Class ;
    rdfs:isDefinedBy :ful ;
    skos:definition "An Item including its initial packaging during transportation. Additional information: For example, the Item being bought is the computer. The weight of the computer is X. The weight of the Goods Item is the weight of the computer plus the weight of the initial packaging. During transportation you have for example trace ID which is applied to the GoodsItem, rather than on the Item itself. The declared statistical value can only apply once you have a GoodsItem."@en ;
    skos:historyNote "WG Approval 30/03/2023"@en ;
    skos:prefLabel "Goods Item"@en .

:NotificationReceiver a owl:Class ;
    rdfs:isDefinedBy :ful ;
    rdfs:subClassOf :AuxiliaryParty ;
    skos:definition "The Role of an Agent that is informed about the arrival of a Shipment at a destination. Additional information: This could be for example customs and excise."@en ;
    skos:historyNote "WG Approval 21/05/2024"@en ;
    skos:prefLabel "Notification Receiver"@en .

:ReceiptAdvice a owl:Class ;
    rdfs:isDefinedBy :ful ;
    rdfs:subClassOf :PostAwardDocument ;
    skos:prefLabel "Receipt Advice"@en .

:ReceiptAdviceInformation a owl:Class ;
    rdfs:isDefinedBy :ful ;
    rdfs:subClassOf :InformationHub ;
    skos:prefLabel "Receipt Advice Information"@en .

:ReceiptAdviceLine a owl:Class ;
    rdfs:isDefinedBy :ful ;
    rdfs:subClassOf :Line ;
    skos:prefLabel "Receipt Advice Line"@en .

:ShipmentAgreement a owl:Class ;
    rdfs:isDefinedBy :ful ;
    skos:definition "The commercial agreement between the Buyer and the Seller. Additional Information: The Shipment Agreement describes the items being shipped."@en ;
    skos:historyNote "WG Approval 21/05/2024"@en ;
    skos:prefLabel "Shipment Agreement"@en .

:ShipmentInformation a owl:Class ;
    rdfs:isDefinedBy :ful ;
    rdfs:subClassOf :InformationHub ;
    skos:definition "Information about the transportation of an identifiable collection of Goods Items from the Despatcher to the Consignee."@en ;
    skos:historyNote "WG Approval 21/05/2024"@en ;
    skos:prefLabel "Shipment Information"@en .

:ShipmentStage a owl:Class ;
    rdfs:isDefinedBy :ful ;
    skos:definition "Part of the itinerary of a shipment. Additional information: In the context of fulfilment only the last part of the itinerary is taken into consideration."@en ;
    skos:historyNote "WG Approval 21/05/2024"@en ;
    skos:prefLabel "Shipment Stage"@en .

:TemperatureSpecification a owl:Class ;
    rdfs:isDefinedBy :ful ;
    skos:definition "Description of the temperature requirements during shipment."@en ;
    skos:historyNote "WG Approval 21/05/2024"@en ;
    skos:prefLabel "Temperature Specification"@en .

:TransportEquipment a owl:Class ;
    rdfs:isDefinedBy :ful ;
    skos:definition "Description of the apparatus used during transportation. Additional information: The equipment may be a container, a trailer, means of assistance to load or unload the Goods Items."@en ;
    skos:historyNote "WG Approval 21/05/2024"@en ;
    skos:prefLabel "Transport Equipment"@en .

:TransportEquipmentSeal a owl:Class ;
    rdfs:isDefinedBy :ful ;
    skos:definition "Means used to ensure that the Transport Equipment is not tampered during transportation."@en ;
    skos:historyNote "WG Approval 21/05/2023"@en ;
    skos:prefLabel "Transport Equipment Seal"@en .

:TransportHandlingUnit a owl:Class ;
    rdfs:isDefinedBy :ful ;
    rdfs:subClassOf :Package ;
    skos:definition "The outermost Package that the Carrier is handling."@en ;
    skos:historyNote "WG Approval 14/05/2024"@en ;
    skos:prefLabel "Transport Handling Unit"@en .

:TransportMeans a owl:Class ;
    rdfs:isDefinedBy :ful ;
    skos:definition "Description of a particular vehicle or vessel used for the conveyance of goods or persons."@en ;
    skos:historyNote "WG Approval 21/05/2024"@en ;
    skos:prefLabel "Transport Means"@en .

:TransportMeansOperator a owl:Class ;
    rdfs:isDefinedBy :ful ;
    rdfs:subClassOf :AuxiliaryParty ;
    skos:definition "The Role of an Agent who is responsible for controlling the Transport Means."@en ;
    skos:historyNote "WG Approval 21/05/2024"@en ;
    skos:prefLabel "Transport Means Operator"@en .

:agreedByBuyer a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "Accepted by Buyer."@en ;
    skos:historyNote "WG Approval 10/06/2024"@en ;
    skos:prefLabel "agreed By Buyer"@en .

:agreedBySeller a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "Accepted by Seller."@en ;
    skos:historyNote "WG Approval 10/06/2024"@en ;
    skos:prefLabel "agreed By Seller"@en .

:comprisesDespatchLine a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "Incorporates Despatch Line."@en ;
    skos:historyNote "WG Approval 10/06/2024"@en ;
    skos:prefLabel "comprises Despatch Line"@en .

:comprisesReceiptAdviceLine a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:prefLabel "comprises Receipt Advice Line"@en .

:concernsGoodsItem a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:prefLabel "concerns Goods Item"@en .

:concernsPackage a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:prefLabel "concerns Package"@en .

:concernsTransportEquipment a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:prefLabel "concerns Transport Equipment"@en .

:concernsTransportMeans a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:prefLabel "concerns Transport Means"@en .

:containsGoodsItem a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "Includes Goods Item."@en ;
    skos:historyNote "WG Approval 10/06/2024"@en ;
    skos:prefLabel "contains Goods Item"@en .

:containsPackage a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "Includes Package."@en ;
    skos:historyNote "WG Approval 10/06/2024"@en ;
    skos:prefLabel "contains Package"@en .

:containsTransportHandlingUnit a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "Includes Transport Handling Unit."@en ;
    skos:historyNote "WG Approval 10/06/2024"@en ;
    skos:prefLabel "contains Transport Handling Unit"@en .

:foreseesPackage a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:prefLabel "foresees Package"@en .

:hasAcceptanceStatus a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:prefLabel "has Acceptance Status"@en .

:hasAllowanceChargeReason a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "The justification for using the Allowance or the Charge."@en ;
    skos:prefLabel "has Allowance Charge Reason"@en .

:hasArrivalShipmentInformation a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "Shipment Information about the destination of the Consignment for a given Shipment Stage."@en ;
    skos:historyNote "WG Approval 18/06/2024"@en ;
    skos:prefLabel "has Arrival Shipment Information"@en .

:hasCarriageShipmentStage a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "The Shipment Stage for the last mile covered in a transport chain."@en ;
    skos:historyNote "WG Approval 20/03/2025"@en ;
    skos:prefLabel "has Carriage Shipment Stage"@en .

:hasConsigneeConsignmentID a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "The identifier of the the Consignment given by the Consignee."@en ;
    skos:historyNote "WG Approval 10/06/2024"@en ;
    skos:prefLabel "has Consignee Consignment ID"@en .

:hasDeclaredStatisticalValue a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "The Monetary Value declared for statistical purposes."@en ;
    skos:historyNote "WG Approval 10/06/2024"@en ;
    skos:prefLabel "has Declared Statistical Value"@en .

:hasDepartureShipmentInformation a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "Shipment Information about the place the Consignment is leaving from in a given Shipment Stage."@en ;
    skos:historyNote "WG Approval 18/06/2024"@en ;
    skos:prefLabel "has Departure Shipment Information"@en .

:hasDespatchAdviceType a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "Classification of a Despatch Advice."@en ;
    skos:prefLabel "has Despatch Advice Type"@en .

:hasDespatchDate a owl:DatatypeProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "The date of sending of goods or the execution of works or services. (epo-ful:ShipmentInformation)"@en ;
    skos:historyNote "WG Approval 05/06/2024"@en ;
    skos:prefLabel "has Despatch Date"@en .

:hasDespatchPeriod a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "The time period when the Despatcher picks-up the Goods Items to be delivered."@en ;
    skos:historyNote "WG Approval 16/07/2024"@en ;
    skos:prefLabel "has Despatch Period"@en .

:hasDespatchedQuantity a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "The Quantity that has been sent."@en ;
    skos:historyNote "WG Approval 18/06/2024"@en ;
    skos:prefLabel "has Despatched Quantity"@en .

:hasDespatcherConsignmentID a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "The identifier of the the Consignment given by the Despatcher."@en ;
    skos:historyNote "WG Approval 10/06/2024"@en ;
    skos:prefLabel "has Despatcher Consignment ID"@en .

:hasDocumentStatus a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "https://test-docs.peppol.eu/logistics/transport-execution/codelist/DocumentStatusCode/"@en ;
    skos:prefLabel "has Document Status"@en .

:hasDriverPerson a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "Relation indicating the operator of the Transport Means."@en ;
    skos:historyNote "WG Approval 02/07/2024"@en ;
    skos:prefLabel "has Driver Person"@en .

:hasEstimatedDeliveryPeriod a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "The forecasted time period given by the Despatcher to provide the goods and services."@en ;
    skos:historyNote "WG Approval 18/06/2024"@en ;
    skos:prefLabel "has Estimated Delivery Period"@en .

:hasFreightCharge a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "The total cost for moving the goods."@en ;
    skos:historyNote "WG Approval 18/06/2024"@en ;
    skos:prefLabel "has Freight Charge"@en .

:hasGrossVolume a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "The amount of space that is required including the packaging."@en ;
    skos:historyNote "WG Approval 18/06/2024"@en ;
    skos:prefLabel "has Gross Volume"@en .

:hasGrossWeight a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "The total mass of goods including the packaging."@en ;
    skos:historyNote "WG Approval 18/06/2024"@en ;
    skos:prefLabel "has Gross Weight"@en .

:hasHandlingInstruction a owl:DatatypeProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "Instruction on how to handle the Goods Items during transportation. (epo-ful:Consignment) Instruction on how to handle the Goods Items during transportation. (epo-ful:TransportHandlingUnit)"@en ;
    skos:historyNote "WG Approval 05/06/2024"@en ;
    skos:prefLabel "has Handling Instruction"@en .

:hasHandlingInstructionCode a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "Instruction on how to handle the Goods Items during transportation, expressed as a code."@en ;
    skos:prefLabel "has Handling Instruction Code"@en .

:hasHeight a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "The vertical measurement."@en ;
    skos:historyNote "WG Approval 18/06/2024"@en ;
    skos:prefLabel "has Height"@en .

:hasLength a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "The horizontal measurement. Additional Information: The length is the longer side between the length and the width."@en ;
    skos:historyNote "WG Approval 18/06/2024"@en ;
    skos:prefLabel "has Length"@en .

:hasLoadingMeter a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "The area of the Consignment in meters divided by the width of the truck, which is considered to be 2.4 meters."@en ;
    skos:historyNote "WG Approval 18/06/2024"@en ;
    skos:prefLabel "has Loading Meter"@en .

:hasMaximumTemperature a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "The highest tolerated temperature."@en ;
    skos:historyNote "WG Approval 18/06/2024"@en ;
    skos:prefLabel "has Maximum Temperature"@en .

:hasMinimumTemperature a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "The lowest tolerated temperature."@en ;
    skos:historyNote "WG Approval 18/06/2024"@en ;
    skos:prefLabel "has Minimum Temperature"@en .

:hasNetVolume a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "The amount of space that is required without the packaging."@en ;
    skos:historyNote "WG Approval 18/06/2024"@en ;
    skos:prefLabel "has Net Volume"@en .

:hasNetWeight a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "The total mass of goods without the packaging."@en ;
    skos:historyNote "WG Approval 18/06/2024"@en ;
    skos:prefLabel "has Net Weight"@en .

:hasOutstandingQuantity a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "The Quantity of non-despatched Goods Items."@en ;
    skos:historyNote "WG Approval 05/06/2024"@en ;
    skos:prefLabel "has Outstanding Quantity"@en .

:hasOutstandingQuantityReason a owl:DatatypeProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "Explanation of the outstanding quantity still to be despatched. (epo-ful:DespatchLine)"@en ;
    skos:historyNote "WG Approval 05/06/2024"@en ;
    skos:prefLabel "has Outstanding Quantity Reason"@en .

:hasOversupplyQuantity a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:prefLabel "has Oversupply Quantity"@en .

:hasPackagingStatus a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:prefLabel "has Packaging Status"@en .

:hasPackagingStatusDescription a owl:DatatypeProperty ;
    rdfs:isDefinedBy :ful ;
    skos:prefLabel "has Packaging Status Description"@en .

:hasPackagingType a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "The kind of Package."@en ;
    skos:prefLabel "has Packaging Type"@en .

:hasPackagingTypeDescription a owl:DatatypeProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "Explanatory text about how the Goods Item is packed. (epo-ful:Package)"@en ;
    skos:historyNote "WG Approval 05/06/2024"@en ;
    skos:prefLabel "has Packaging Type Description"@en .

:hasPackingMaterialDescription a owl:DatatypeProperty ;
    rdfs:isDefinedBy :ful ;
    skos:prefLabel "has Packing Material Description"@en .

:hasReceivedQuantity a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:prefLabel "has Received Quantity"@en .

:hasRejectAction a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:prefLabel "has Reject Action"@en .

:hasRejectReason a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:prefLabel "has Reject Reason"@en .

:hasRejectReasonDescription a owl:DatatypeProperty ;
    rdfs:isDefinedBy :ful ;
    skos:prefLabel "has Reject Reason Description"@en .

:hasRejectedQuantity a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:prefLabel "has Rejected Quantity"@en .

:hasRequestedPickUpInformation a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "Information about the requested despatch of the Goods Items."@en ;
    skos:historyNote "WG Approval 25/06/2024"@en ;
    skos:prefLabel "has Requested Pick Up Information"@en .

:hasShippingMark a owl:DatatypeProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "A text that the buyer requests to be printed on the packing labels. (epo-ful:TransportHandlingUnit)"@en ;
    skos:historyNote "WG Approval 05/06/2024"@en ;
    skos:prefLabel "has Shipping Mark"@en .

:hasShortQuantity a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:prefLabel "has Short Quantity"@en .

:hasShortageAction a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:prefLabel "has Shortage Action"@en .

:hasSizeType a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "An extension classification specifying the measurement of the Transport Equipment. Additional Information: This codelist should be used only in the case of a container."@en ;
    skos:prefLabel "has Size Type"@en .

:hasSpecialServiceInstruction a owl:DatatypeProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "Description about special services needed for loading or unloading the Goods Items. (epo-ful:Consignment)"@en ;
    skos:historyNote "WG Approval 21/05/2024"@en ;
    skos:prefLabel "has Special Service Instruction"@en .

:hasTemperatureSpecification a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "Relation indicating the Temperature Specification for the instance of the concept."@en ;
    skos:historyNote "WG Approval 25/06/2024"@en ;
    skos:prefLabel "has Temperature Specification"@en .

:hasTotalGoodsItemQuantity a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "Relation indicating the number of the Goods Items."@en ;
    skos:historyNote "WG Approval 25/06/2024"@en ;
    skos:prefLabel "has Total Goods Item Quantity"@en .

:hasTraceID a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "The identifier used for tracking the Goods Item. Additional information: An example is the EPC number used in RFID."@en ;
    skos:historyNote "WG Approval 21/09/2023"@en ;
    skos:prefLabel "has Trace ID"@en .

:hasTransportEquipmentSeal a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "Relation indicating that the instance of the concept has a Transport Equipment Seal."@en ;
    skos:historyNote "WG Approval 25/06/2024"@en ;
    skos:prefLabel "has Transport Equipment Seal"@en .

:hasTransportEquipmentType a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "The kind of Transport Equipment."@en ;
    skos:prefLabel "has Transport Equipment Type"@en .

:hasTransportHandlingUnitQuantity a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "Relation indicating the number of the Transport Handling Unit."@en ;
    skos:historyNote "WG Approval 25/06/2024"@en ;
    skos:prefLabel "has Transport Handling Unit Quantity"@en .

:hasTransportMeansType a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "The kind of Transport Means."@en ;
    skos:prefLabel "has Transport Means Type"@en .

:hasTransportMode a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "The type of the transport used."@en ;
    skos:prefLabel "has Transport Mode"@en .

:hasVehicleID a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "The identifier of the Transport Means."@en ;
    skos:historyNote "WG Approval 25/06/2024"@en ;
    skos:prefLabel "has Vehicle ID"@en .

:hasVehicleSegmentID a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "The identifier of a part of the Transport Means."@en ;
    skos:historyNote "WG Approval 25/06/2024"@en ;
    skos:prefLabel "has Vehicle Segment ID"@en .

:hasWidth a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "The measurement of the depth. Additional Information: The width is the shorter side between the length and the width."@en ;
    skos:historyNote "WG Approval 18/06/2024"@en ;
    skos:prefLabel "has Width"@en .

:isHazardousRisk a owl:DatatypeProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "Indicates whether some of the contained Goods Items are hazardous. (epo-ful:AbstractContainer) Indicates whether some of the contained Goods Items are hazardous. (epo-ful:Consignment)"@en ;
    skos:historyNote "WG Approval 21/05/2024"@en ;
    skos:prefLabel "is Hazardous Risk"@en .

:isPowerIndicated a owl:DatatypeProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "Indicates whether the instance of the concept can supply electrical energy. Additional Information: The instance of the concept can be, for example, Transport Equipment. (epo-ful:TransportEquipment)"@en ;
    skos:historyNote "WG Approval 05/06/2024"@en ;
    skos:prefLabel "is Power Indicated"@en .

:isRefrigerated a owl:DatatypeProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "Indicates whether the instance of the concept includes refrigeration. Additional Information: The instance of the concept can be, for example, Transport Equipment. (epo-ful:TransportEquipment)"@en ;
    skos:historyNote "WG Approval 05/06/2024"@en ;
    skos:prefLabel "is Refrigerated"@en .

:isReturnableMaterial a owl:DatatypeProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "Indicates whether the container or part of the container is to be sent back. (epo-ful:AbstractContainer)"@en ;
    skos:historyNote "WG Approval 21/05/2024"@en ;
    skos:prefLabel "is Returnable Material"@en .

:isSpecificToDespatchLine a owl:ObjectProperty ;
    rdfs:isDefinedBy :ful ;
    skos:definition "Information that is particular to a Despatch Line."@en ;
