@prefix : <http://data.europa.eu/a4g/ontology#> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix cccev: <http://data.europa.eu/m8g/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eli: <http://data.europa.eu/eli/ontology#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:comprisesReceiptAdviceLine rdfs:domain :ReceiptAdvice ;
    rdfs:range :ReceiptAdviceLine .

:containsGoodsItem rdfs:domain :Package ;
    rdfs:range :GoodsItem .

:containsPackage a owl:AsymmetricProperty ;
    rdfs:domain :Package ;
    rdfs:range :Package .

:ful-restriction a owl:Ontology ;
    rdfs:label "eProcurement Ontology Fulfilment - core restrictions"@en ;
    dcterms:created "2021-06-01"^^xsd:date ;
    dcterms:description "The eProcurement Ontology Fulfilment core restrictions provides the restrictions and the inference-related specifications on the concepts and properties in the eProcurement Ontology Fulfilment core."@en ;
    dcterms:issued "2025-06-04"^^xsd:date ;
    dcterms:license "© European Union, 2014. Unless otherwise noted, the reuse of the Ontology is authorised under the European Union Public Licence v1.2 (https://eupl.eu/)." ;
    dcterms:publisher "http://publications.europa.eu/resource/authority/corporate-body/PUBL" ;
    dcterms:title "eProcurement Ontology Fulfilment - core restrictions"@en ;
    vann:preferredNamespacePrefix "epo" ;
    vann:preferredNamespaceUri "http://data.europa.eu/a4g/ontology#" ;
    rdfs:comment """This version is automatically generated from eFulfilment.xml on 
                2025-06-04""" ;
    rdfs:seeAlso <https://docs.ted.europa.eu/home/index.html>,
        <https://github.com/OP-TED/ePO/releases>,
        <https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology/about>,
        <https://op.europa.eu/en/web/eu-vocabularies/e-procurement> ;
    owl:imports :cat,
        :core,
        :ful,
        :ord,
        eli:,
        cccev:,
        dcterms:,
        skos:,
        <http://www.w3.org/2006/time>,
        <http://www.w3.org/ns/adms>,
        <http://www.w3.org/ns/locn>,
        org:,
        <http://www.w3.org/ns/person> ;
    owl:incompatibleWith "4.2.0" ;
    owl:priorVersion "http://data.europa.eu/a4g/ontology#ful-restriction-5.0.0" ;
    owl:versionIRI :ful-restriction-5.1.0 ;
    owl:versionInfo "5.1.0" .

:hasAcceptanceStatus rdfs:domain [ a owl:Class ;
            owl:unionOf ( :AbstractContainer :ReceiptAdviceInformation ) ] ;
    rdfs:range skos:Concept .

:hasAllowanceChargeReason rdfs:domain :AllowanceChargeInformation ;
    rdfs:range skos:Concept .

:hasArrivalShipmentInformation rdfs:domain :ShipmentStage ;
    rdfs:range :ShipmentInformation .

:hasDepartureShipmentInformation rdfs:domain :ShipmentStage ;
    rdfs:range :ShipmentInformation .

:hasDespatchAdviceType rdfs:domain :DespatchAdvice ;
    rdfs:range skos:Concept .

:hasDocumentStatus rdfs:domain :PostAwardDocument ;
    rdfs:range skos:Concept .

:hasFreightCharge rdfs:domain :Consignment ;
    rdfs:range :ChargeInformation .

:hasHandlingInstruction rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Consignment :TransportHandlingUnit ) ] ;
    rdfs:range rdf:PlainLiteral .

:hasHandlingInstructionCode rdfs:domain [ a owl:Class ;
            owl:unionOf ( :TransportHandlingUnit :Consignment ) ] ;
    rdfs:range skos:Concept .

:hasPackagingStatus rdfs:domain :Package ;
    rdfs:range skos:Concept .

:hasPackagingType rdfs:domain :Package ;
    rdfs:range skos:Concept .

:hasRejectAction rdfs:domain :ReceiptAdviceInformation ;
    rdfs:range skos:Concept .

:hasRejectReason rdfs:domain :ReceiptAdviceInformation ;
    rdfs:range skos:Concept .

:hasShippingMark rdfs:domain :TransportHandlingUnit ;
    rdfs:range rdf:PlainLiteral .

:hasShortageAction rdfs:domain :ReceiptAdviceInformation ;
    rdfs:range skos:Concept .

:hasSizeType rdfs:domain :TransportEquipment ;
    rdfs:range skos:Concept .

:hasSpecialServiceInstruction rdfs:domain :Consignment ;
    rdfs:range rdf:PlainLiteral .

:hasTransportEquipmentSeal rdfs:domain :TransportEquipment ;
    rdfs:range :TransportEquipmentSeal .

:hasTransportEquipmentType rdfs:domain :TransportEquipment ;
    rdfs:range skos:Concept .

:hasTransportMeansType rdfs:domain :TransportMeans ;
    rdfs:range skos:Concept .

:hasTransportMode rdfs:domain :TransportMeans ;
    rdfs:range skos:Concept .

:isSpecificToReceiptAdviceLine rdfs:domain :ReceiptAdviceInformation ;
    rdfs:range :ReceiptAdviceLine .

:specifiesFreightForwarder rdfs:domain :Consignment ;
    rdfs:range :FreightForwarder .

:specifiesNotificationReceiver rdfs:domain :Consignment ;
    rdfs:range :NotificationReceiver .

:specifiesOriginator rdfs:domain :DespatchAdvice ;
    rdfs:range :Originator .

:specifiesReceiptAdviceInformation rdfs:domain :ReceiptAdvice ;
    rdfs:range :ReceiptAdviceInformation .

:usesTransportEquipment rdfs:domain :TransportHandlingUnit ;
    rdfs:range :TransportEquipment .

:CatalogueLine rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :foreseesPackage ] .

:EnvironmentalEmissionInformation rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :concernsTransportMeans ] .

:TransportEquipmentSeal rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty adms:identifier ] .

:agreedByBuyer rdfs:domain :ShipmentAgreement ;
    rdfs:range :Buyer .

:agreedBySeller rdfs:domain :ShipmentAgreement ;
    rdfs:range :Seller .

:comprisesDespatchLine rdfs:domain :DespatchAdvice ;
    rdfs:range :DespatchLine .

:concernsGoodsItem rdfs:domain :DimensionInformation ;
    rdfs:range :GoodsItem .

:concernsPackage rdfs:domain :DimensionInformation ;
    rdfs:range :Package .

:concernsTransportEquipment rdfs:domain :DimensionInformation ;
    rdfs:range :TransportEquipment .

:containsTransportHandlingUnit rdfs:domain :Consignment ;
    rdfs:range :TransportHandlingUnit .

:foreseesPackage rdfs:domain :CatalogueLine ;
    rdfs:range :Package .

:hasCarriageShipmentStage rdfs:domain :Consignment ;
    rdfs:range :ShipmentStage .

:hasConsigneeConsignmentID rdfs:domain :Consignment ;
    rdfs:range adms:Identifier .

:hasDeclaredStatisticalValue rdfs:domain [ a owl:Class ;
            owl:unionOf ( :GoodsItem :Consignment ) ] ;
    rdfs:range :MonetaryValue .

:hasDespatchDate rdfs:domain :ShipmentInformation ;
    rdfs:range xsd:dateTime .

:hasDespatchPeriod rdfs:domain :ShipmentInformation ;
    rdfs:range time:Interval .

:hasDespatchedQuantity a owl:FunctionalProperty ;
    rdfs:domain :DespatchLine ;
    rdfs:range :Quantity .

:hasDespatcherConsignmentID rdfs:domain :Consignment ;
    rdfs:range adms:Identifier .

:hasDriverPerson rdfs:domain :TransportMeans ;
    rdfs:range :TransportMeansOperator .

:hasEstimatedDeliveryPeriod rdfs:domain :ShipmentInformation ;
    rdfs:range time:Interval .

:hasHeight rdfs:domain :AbstractContainer ;
    rdfs:range :Quantity .

:hasLength rdfs:domain :AbstractContainer ;
    rdfs:range :Quantity .

:hasLoadingMeter rdfs:domain :Consignment ;
    rdfs:range :Quantity .

:hasMaximumTemperature rdfs:domain :TemperatureSpecification ;
    rdfs:range :Quantity .

:hasMinimumTemperature rdfs:domain :TemperatureSpecification ;
    rdfs:range :Quantity .

:hasNetVolume rdfs:domain :AbstractContainer ;
    rdfs:range :Quantity .

:hasOutstandingQuantity rdfs:domain :DespatchLine ;
    rdfs:range :Quantity .

:hasOutstandingQuantityReason rdfs:domain :DespatchLine ;
    rdfs:range rdf:PlainLiteral .

:hasOversupplyQuantity rdfs:domain :ReceiptAdviceLine ;
    rdfs:range :Quantity .

:hasPackagingStatusDescription rdfs:domain :Package ;
    rdfs:range rdf:PlainLiteral .

:hasPackagingTypeDescription rdfs:domain :Package ;
    rdfs:range rdf:PlainLiteral .

:hasPackingMaterialDescription rdfs:domain :AbstractContainer ;
    rdfs:range rdf:PlainLiteral .

:hasReceivedQuantity rdfs:domain :ReceiptAdviceLine ;
    rdfs:range :Quantity .

:hasRejectReasonDescription rdfs:domain :ReceiptAdviceInformation ;
    rdfs:range rdf:PlainLiteral .

:hasRejectedQuantity rdfs:domain :ReceiptAdviceLine ;
    rdfs:range :Quantity .

:hasRequestedPickUpInformation a owl:FunctionalProperty ;
    rdfs:domain :Consignment ;
    rdfs:range :ShipmentInformation .

:hasShortQuantity rdfs:domain :ReceiptAdviceLine ;
    rdfs:range :Quantity .

:hasTemperatureSpecification rdfs:domain :AbstractContainer ;
    rdfs:range :TemperatureSpecification .

:hasTraceID rdfs:domain :GoodsItem ;
    rdfs:range adms:Identifier .

:hasTransportHandlingUnitQuantity rdfs:domain :Consignment ;
    rdfs:range :Quantity .

:hasVehicleID a owl:FunctionalProperty ;
    rdfs:domain :TransportMeans ;
    rdfs:range adms:Identifier .

:hasVehicleSegmentID rdfs:domain :TransportMeans ;
    rdfs:range adms:Identifier .

:hasWidth rdfs:domain :AbstractContainer ;
    rdfs:range :Quantity .

:isPowerIndicated rdfs:domain :TransportEquipment ;
    rdfs:range xsd:boolean .

:isRefrigerated rdfs:domain :TransportEquipment ;
    rdfs:range xsd:boolean .

:isReturnableMaterial rdfs:domain :AbstractContainer ;
    rdfs:range xsd:boolean .

:isSpecificToDespatchLine rdfs:domain :ShipmentInformation ;
    rdfs:range :DespatchLine .

:isSubmittedForDespatchAdvice rdfs:domain :ReceiptAdvice ;
    rdfs:range :DespatchAdvice .

:isSubmittedForDespatchLine a owl:FunctionalProperty ;
    rdfs:domain :ReceiptAdviceLine ;
    rdfs:range :DespatchLine .

:isSubmittedForShipment rdfs:domain :ReceiptAdvice ;
    rdfs:range :ShipmentInformation .

:playedBy rdfs:domain :TransportMeansOperator ;
    rdfs:range foaf:Person .

:refersToConsignment a owl:FunctionalProperty ;
    rdfs:domain :DespatchAdvice ;
    rdfs:range :Consignment .

:refersToDeliveryInformation a owl:FunctionalProperty ;
    rdfs:domain :ShipmentInformation ;
    rdfs:range :DeliveryInformation .

:refersToDespatchAdvice rdfs:domain :Invoice ;
    rdfs:range :DespatchAdvice .

:refersToDespatchLine a owl:FunctionalProperty ;
    rdfs:domain :GoodsItem ;
    rdfs:range :DespatchLine .

:refersToOrder rdfs:domain :DespatchAdvice ;
    rdfs:range :Order .

:refersToOrderLine a owl:FunctionalProperty ;
    rdfs:domain :DespatchLine ;
    rdfs:range :OrderLine .

:refersToReceiptAdvice rdfs:domain :Invoice ;
    rdfs:range :ReceiptAdvice .

:refersToShipmentAgreement rdfs:domain :DespatchAdvice ;
    rdfs:range :ShipmentAgreement .

:specifiesBuyer rdfs:domain :ReceiptAdvice ;
    rdfs:range :Buyer .

:specifiesCarrier rdfs:domain :ShipmentStage ;
    rdfs:range :Carrier .

:specifiesPlaceOfDespatch rdfs:domain :ShipmentInformation ;
    rdfs:range dcterms:Location .

:specifiesSeller rdfs:domain :ReceiptAdvice ;
    rdfs:range :Seller .

:usesTransportMeans rdfs:domain :ShipmentStage ;
    rdfs:range :TransportMeans .

:Invoice rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :refersToReceiptAdvice ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :refersToDespatchAdvice ] .

:Order rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :specifiesDespatcher ] .

:concernsTransportMeans rdfs:domain [ a owl:Class ;
            owl:unionOf ( :EnvironmentalEmissionInformation :DimensionInformation ) ] ;
    rdfs:range :TransportMeans .

:hasGrossVolume rdfs:domain [ a owl:Class ;
            owl:unionOf ( :AbstractContainer :Consignment ) ] ;
    rdfs:range :Quantity .

:hasGrossWeight rdfs:domain [ a owl:Class ;
            owl:unionOf ( :AbstractContainer :Consignment ) ] ;
    rdfs:range :Quantity .

:hasNetWeight rdfs:domain [ a owl:Class ;
            owl:unionOf ( :AbstractContainer :Consignment ) ] ;
    rdfs:range :Quantity .

:hasTotalGoodsItemQuantity rdfs:domain [ a owl:Class ;
            owl:unionOf ( :AbstractContainer :Consignment ) ] ;
    rdfs:range :Quantity .

:isHazardousRisk rdfs:domain [ a owl:Class ;
            owl:unionOf ( :AbstractContainer :Consignment ) ] ;
    rdfs:range xsd:boolean .

:specifiesConsignee rdfs:domain [ a owl:Class ;
            owl:unionOf ( :DespatchAdvice :ReceiptAdvice ) ] ;
    rdfs:range :Consignee .

:ShipmentAgreement rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty :agreedBySeller ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty :agreedByBuyer ] .

:TemperatureSpecification rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dcterms:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasMinimumTemperature ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasMaximumTemperature ] .

:TransportMeansOperator rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :playedBy ] .

:specifiesDespatcher a owl:FunctionalProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :ReceiptAdvice :Order :DespatchAdvice ) ] ;
    rdfs:range :Despatcher .

:DimensionInformation rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :concernsGoodsItem ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :concernsTransportMeans ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :concernsPackage ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :concernsTransportEquipment ] .

:GoodsItem rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :refersToDespatchLine ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasTraceID ] .

:ShipmentStage rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty :usesTransportMeans ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty adms:identifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :specifiesCarrier ] .

:TransportHandlingUnit a owl:Class .

:TransportEquipment rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :isRefrigerated ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty adms:identifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :isPowerIndicated ] .

:TransportMeans rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasVehicleSegmentID ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty :hasDriverPerson ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :hasVehicleID ] .

:ReceiptAdviceInformation rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasRejectReasonDescription ] .

:ReceiptAdviceLine rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasOversupplyQuantity ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasReceivedQuantity ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasRejectedQuantity ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasShortQuantity ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :isSubmittedForDespatchLine ] .

:DespatchLine rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasOutstandingQuantity ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :hasDespatchedQuantity ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :refersToOrderLine ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasOutstandingQuantityReason ] .

:Package rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasPackagingTypeDescription ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasPackagingStatusDescription ] .

:ReceiptAdvice rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty :specifiesConsignee ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :isSubmittedForDespatchAdvice ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :specifiesSeller ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :specifiesDespatcher ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :isSubmittedForShipment ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :specifiesBuyer ] .

:DespatchAdvice rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty :specifiesConsignee ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty :specifiesDespatcher ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty :comprisesDespatchLine ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :refersToShipmentAgreement ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :refersToOrder ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :refersToConsignment ] .

:ShipmentInformation rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :specifiesPlaceOfDespatch ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasDespatchPeriod ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :isSpecificToDespatchLine ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasEstimatedDeliveryPeriod ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty adms:identifier ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :refersToDeliveryInformation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasDespatchDate ] .

:AbstractContainer a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasGrossVolume ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasWidth ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasTemperatureSpecification ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasNetVolume ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :isReturnableMaterial ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :isHazardousRisk ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasTotalGoodsItemQuantity ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasPackingMaterialDescription ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasGrossWeight ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasNetWeight ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasLength ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty adms:identifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasHeight ] .

:Consignment a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasLoadingMeter ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasTotalGoodsItemQuantity ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasDeclaredStatisticalValue ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasGrossVolume ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasConsigneeConsignmentID ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasNetWeight ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasDespatcherConsignmentID ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasGrossWeight ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty :containsTransportHandlingUnit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasTransportHandlingUnitQuantity ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty adms:identifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :isHazardousRisk ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :hasRequestedPickUpInformation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasCarriageShipmentStage ] .

[] a owl:AllDisjointClasses ;
    owl:members ( :ShipmentInformation :ReceiptAdviceInformation ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :DespatchAdvice :ReceiptAdvice ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :DespatchLine :ReceiptAdviceLine ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :TransportMeansOperator :FreightForwarder :NotificationReceiver :Carrier ) .

