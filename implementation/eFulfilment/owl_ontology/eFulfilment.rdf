    <rdfs:label xml:lang="en">eProcurement Ontology Fulfilment - core</rdfs:label>
    <vann:preferredNamespaceUri>http://data.europa.eu/a4g/ontology#</vann:preferredNamespaceUri>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-10-10</dcterms:issued>
    <dcterms:description xml:lang="en">The eProcurement Ontology Fulfilment core describes the concepts and properties representing the European Public Procurement Fulfilment domain. The provision of these semantics offers the basis for a common understanding of the domain for all stakeholders ensuring the quality of data exchange and transparency. The ontology restrictions are published in a separate artefact.</dcterms:description>
    <dcterms:title xml:lang="en">eProcurement Ontology Fulfilment - core</dcterms:title>
    <owl:versionIRI rdf:resource="http://data.europa.eu/a4g/ontology#ful-5.2.0"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#TransportMeansOperator">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <skos:definition xml:lang="en">The Role of an Agent who is responsible for controlling the Transport Means.</skos:definition>
    <skos:prefLabel xml:lang="en">Transport Means Operator</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AuxiliaryParty"/>
    <skos:historyNote xml:lang="en">WG Approval 21/05/2024</skos:historyNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasDespatchedQuantity">
    <skos:prefLabel xml:lang="en">has Despatched Quantity</skos:prefLabel>
    <skos:definition xml:lang="en">The Quantity that has been sent.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:historyNote xml:lang="en">WG Approval 18/06/2024</skos:historyNote>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasShippingMark">
    <skos:historyNote xml:lang="en">WG Approval 05/06/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Shipping Mark</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <skos:definition xml:lang="en">A text that the buyer requests to be printed on the packing labels. (epo-ful:TransportHandlingUnit)</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#DespatchAdvice">
    <skos:historyNote xml:lang="en">WG Approval 14/05/2024</skos:historyNote>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#PostAwardDocument"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <skos:prefLabel xml:lang="en">Despatch Advice</skos:prefLabel>
    <skos:definition xml:lang="en">A document notifying the sending of goods or the execution of works or services.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#TransportMeans">
    <skos:historyNote xml:lang="en">WG Approval 21/05/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">Transport Means</skos:prefLabel>
    <skos:definition xml:lang="en">Description of a particular vehicle or vessel used for the conveyance of goods or persons.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasTransportHandlingUnitQuantity">
    <skos:historyNote xml:lang="en">WG Approval 25/06/2024</skos:historyNote>
