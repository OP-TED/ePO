  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#refersToDespatchLine">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:historyNote xml:lang="en">WG Approval 25/06/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">refers To Despatch Line</skos:prefLabel>
    <skos:definition xml:lang="en">Reference to a Despatch Line.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasGrossVolume">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">The amount of space that is required including the packaging.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 18/06/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Gross Volume</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasRequestedPickUpInformation">
    <skos:historyNote xml:lang="en">WG Approval 25/06/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Requested Pick Up Information</skos:prefLabel>
    <skos:definition xml:lang="en">Information about the requested despatch of the Goods Items.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasReceivedQuantity">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Received Quantity</skos:prefLabel>
    <skos:definition xml:lang="en">Relation indicating the delivered Quantity.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasGrossWeight">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">has Gross Weight</skos:prefLabel>
    <skos:historyNote xml:lang="en">WG Approval 18/06/2024</skos:historyNote>
    <skos:definition xml:lang="en">The total mass of goods including the packaging.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasHandlingInstruction">
    <skos:prefLabel xml:lang="en">has Handling Instruction</skos:prefLabel>
    <skos:historyNote xml:lang="en">WG Approval 05/06/2024</skos:historyNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:definition xml:lang="en">Instruction on how to handle the Goods Items during transportation. (epo-ful:Consignment) Instruction on how to handle the Goods Items during transportation. (epo-ful:TransportHandlingUnit)</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasArrivalShipmentInformation">
    <skos:historyNote xml:lang="en">WG Approval 18/06/2024</skos:historyNote>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Shipment Information about the destination of the Consignment for a given Shipment Stage.</skos:definition>
    <skos:prefLabel xml:lang="en">has Arrival Shipment Information</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasTotalGoodsItemQuantity">
    <skos:prefLabel xml:lang="en">has Total Goods Item Quantity</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:historyNote xml:lang="en">WG Approval 25/06/2024</skos:historyNote>
    <skos:definition xml:lang="en">Relation indicating the number of the Goods Items.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#ReceiptAdviceInformation">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <skos:historyNote xml:lang="en">WG approval 16/09/2025</skos:historyNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#InformationHub"/>
    <skos:prefLabel xml:lang="en">Receipt Advice Information</skos:prefLabel>
    <skos:definition xml:lang="en">Information about the Receipt Advice.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#isHazardousRisk">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <skos:prefLabel xml:lang="en">is Hazardous Risk</skos:prefLabel>
    <skos:definition xml:lang="en">Indicates whether some of the contained Goods Items are hazardous. (epo-ful:AbstractContainer) Indicates whether some of the contained Goods Items are hazardous. (epo-ful:Consignment)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 21/05/2024</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasDepartureShipmentInformation">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">has Departure Shipment Information</skos:prefLabel>
    <skos:historyNote xml:lang="en">WG Approval 18/06/2024</skos:historyNote>
    <skos:definition xml:lang="en">Shipment Information about the place the Consignment is leaving from in a given Shipment Stage.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasSizeType">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">An extension classification specifying the measurement of the Transport Equipment. Additional Information: This codelist should be used only in the case of a container.</skos:definition>
    <skos:prefLabel xml:lang="en">has Size Type</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasTemperatureSpecification">
    <skos:definition xml:lang="en">Relation indicating the Temperature Specification for the instance of the concept.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 25/06/2024</skos:historyNote>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <skos:prefLabel xml:lang="en">has Temperature Specification</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasTransportMode">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">The type of the transport used.</skos:definition>
    <skos:prefLabel xml:lang="en">has Transport Mode</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasNetVolume">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">has Net Volume</skos:prefLabel>
    <skos:historyNote xml:lang="en">WG Approval 18/06/2024</skos:historyNote>
    <skos:definition xml:lang="en">The amount of space that is required without the packaging.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasTraceID">
    <skos:definition xml:lang="en">The identifier used for tracking the Goods Item. Additional information: An example is the EPC number used in RFID.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">has Trace ID</skos:prefLabel>
    <skos:historyNote xml:lang="en">WG Approval 21/09/2023</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#ShipmentAgreement">
    <skos:definition xml:lang="en">The commercial agreement between the Buyer and the Seller. Additional Information: The Shipment Agreement describes the items being shipped.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 21/05/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">Shipment Agreement</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasEstimatedDeliveryPeriod">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">has Estimated Delivery Period</skos:prefLabel>
    <skos:definition xml:lang="en">The forecasted time period given by the Despatcher to provide the goods and services.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 18/06/2024</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#TemperatureSpecification">
    <skos:historyNote xml:lang="en">WG Approval 21/05/2024</skos:historyNote>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <skos:definition xml:lang="en">Description of the temperature requirements during shipment.</skos:definition>
    <skos:prefLabel xml:lang="en">Temperature Specification</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#comprisesDespatchLine">
    <skos:prefLabel xml:lang="en">comprises Despatch Line</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:historyNote xml:lang="en">WG Approval 10/06/2024</skos:historyNote>
    <skos:definition xml:lang="en">Incorporates Despatch Line.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#specifiesBuyer">
    <skos:prefLabel xml:lang="en">specifies Buyer</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:definition xml:lang="en">Relation indicating that the instance of the concept involves the Buyer.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasDocumentStatus">
    <skos:definition xml:lang="en">https://test-docs.peppol.eu/logistics/transport-execution/codelist/DocumentStatusCode/</skos:definition>
    <skos:prefLabel xml:lang="en">has Document Status</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#usesTransportEquipment">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:historyNote xml:lang="en">WG Approval 02/07/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">uses Transport Equipment</skos:prefLabel>
    <skos:definition xml:lang="en">Relation indicating that a Transport Handling Unit utilises a Transport Equipment.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#Carrier">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <skos:definition xml:lang="en">The Role of an Agent who handles the physical Delivery/Transportation of the (Despatched) Shipment. Additional Information: This Role is often referred to as the deliverer.</skos:definition>
    <skos:prefLabel xml:lang="en">Carrier</skos:prefLabel>
    <skos:historyNote xml:lang="en">WG Approval 14/05/2024</skos:historyNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AuxiliaryParty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasAcceptanceStatus">
    <skos:prefLabel xml:lang="en">has Acceptance Status</skos:prefLabel>
    <skos:definition xml:lang="en">Relation indicating the acceptance status.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasAllowanceChargeReason">
    <skos:prefLabel xml:lang="en">has Allowance Charge Reason</skos:prefLabel>
    <skos:definition xml:lang="en">The justification for using the Allowance or the Charge.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasRejectReason">
    <skos:prefLabel xml:lang="en">has Reject Reason</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Relation indicating the reason for non-acceptance.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#isRefrigerated">
    <skos:historyNote xml:lang="en">WG Approval 05/06/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">is Refrigerated</skos:prefLabel>
    <skos:definition xml:lang="en">Indicates whether the instance of the concept includes refrigeration. Additional Information: The instance of the concept can be, for example, Transport Equipment. (epo-ful:TransportEquipment)</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#ShipmentInformation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <skos:prefLabel xml:lang="en">Shipment Information</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#InformationHub"/>
    <skos:definition xml:lang="en">Information about the transportation of an identifiable collection of Goods Items from the Despatcher to the Consignee.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 21/05/2024</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#containsTransportHandlingUnit">
    <skos:historyNote xml:lang="en">WG Approval 10/06/2024</skos:historyNote>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <skos:prefLabel xml:lang="en">contains Transport Handling Unit</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Includes Transport Handling Unit.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasHeight">
    <skos:historyNote xml:lang="en">WG Approval 18/06/2024</skos:historyNote>
    <skos:definition xml:lang="en">The vertical measurement.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <skos:prefLabel xml:lang="en">has Height</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasTransportEquipmentType">
    <skos:definition xml:lang="en">The kind of Transport Equipment.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">has Transport Equipment Type</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasShortQuantity">
    <skos:definition xml:lang="en">Relation indicating the Quantity deficit.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">has Short Quantity</skos:prefLabel>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#specifiesFreightForwarder">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:historyNote xml:lang="en">WG Approval 25/06/2024</skos:historyNote>
    <skos:definition xml:lang="en">Relation indicating that the instance of the concept involves the Freight Forwarder.</skos:definition>
    <skos:prefLabel xml:lang="en">specifies Freight Forwarder</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasWidth">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <skos:prefLabel xml:lang="en">has Width</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">The measurement of the depth. Additional Information: The width is the shorter side between the length and the width.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 18/06/2024</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#NotificationReceiver">
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AuxiliaryParty"/>
    <skos:prefLabel xml:lang="en">Notification Receiver</skos:prefLabel>
    <skos:historyNote xml:lang="en">WG Approval 21/05/2024</skos:historyNote>
    <skos:definition xml:lang="en">The Role of an Agent that is informed about the arrival of a Shipment at a destination. Additional information: This could be for example customs and excise.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#agreedByBuyer">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:historyNote xml:lang="en">WG Approval 10/06/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">agreed By Buyer</skos:prefLabel>
    <skos:definition xml:lang="en">Accepted by Buyer.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasFreightCharge">
    <skos:definition xml:lang="en">The total cost for moving the goods.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:historyNote xml:lang="en">WG Approval 18/06/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Freight Charge</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#GoodsItem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <skos:prefLabel xml:lang="en">Goods Item</skos:prefLabel>
    <skos:historyNote xml:lang="en">WG Approval 30/03/2023</skos:historyNote>
    <skos:definition xml:lang="en">An Item including its initial packaging during transportation. Additional information: For example, the Item being bought is the computer. The weight of the computer is X. The weight of the Goods Item is the weight of the computer plus the weight of the initial packaging. During transportation you have for example trace ID which is applied to the GoodsItem, rather than on the Item itself. The declared statistical value can only apply once you have a GoodsItem.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#foreseesPackage">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:definition xml:lang="en">Relation indicating that an instance of the concept plans to have a Package.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">foresees Package</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#specifiesNotificationReceiver">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">specifies Notification Receiver</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Relation indicating that the instance of the concept involves the Notification Receiver.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#isSubmittedForDespatchLine">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:definition xml:lang="en">Relation indicating that the instance of the concept is sent for a specific Despatch Line.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">is Submitted For Despatch Line</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#isSpecificToDespatchLine">
    <skos:definition xml:lang="en">Information that is particular to a Despatch Line.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:historyNote xml:lang="en">WG Approval 25/06/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">is Specific To Despatch Line</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#isReturnableMaterial">
    <skos:prefLabel xml:lang="en">is Returnable Material</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <skos:definition xml:lang="en">Indicates whether the container or part of the container is to be sent back. (epo-ful:AbstractContainer)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 21/05/2024</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#refersToOrder">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <skos:definition xml:lang="en">Reference to an Order.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">refers To Order</skos:prefLabel>
    <skos:historyNote xml:lang="en">WG Approval 25/06/2024</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#AbstractContainer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <skos:historyNote xml:lang="en">WG Approval 14/05/2024</skos:historyNote>
    <skos:definition xml:lang="en">Gathering class for Packages and Transport Handling Units.</skos:definition>
    <skos:prefLabel xml:lang="en">Abstract Container</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasMaximumTemperature">
    <skos:prefLabel xml:lang="en">has Maximum Temperature</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:historyNote xml:lang="en">WG Approval 18/06/2024</skos:historyNote>
    <skos:definition xml:lang="en">The highest tolerated temperature.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#isPowerIndicated">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <skos:historyNote xml:lang="en">WG Approval 05/06/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">is Power Indicated</skos:prefLabel>
    <skos:definition xml:lang="en">Indicates whether the instance of the concept can supply electrical energy. Additional Information: The instance of the concept can be, for example, Transport Equipment. (epo-ful:TransportEquipment)</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#specifiesCarrier">
    <skos:prefLabel xml:lang="en">specifies Carrier</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Relation indicating that the instance of the concept involves the Carrier.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 25/06/2024</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#specifiesSeller">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Relation indicating that the instance of the concept involves the Seller.</skos:definition>
    <skos:prefLabel xml:lang="en">specifies Seller</skos:prefLabel>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasPackagingTypeDescription">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <skos:prefLabel xml:lang="en">has Packaging Type Description</skos:prefLabel>
    <skos:historyNote xml:lang="en">WG Approval 05/06/2024</skos:historyNote>
    <skos:definition xml:lang="en">Explanatory text about how the Goods Item is packed. (epo-ful:Package)</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasHandlingInstructionCode">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <skos:prefLabel xml:lang="en">has Handling Instruction Code</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Instruction on how to handle the Goods Items during transportation, expressed as a code.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#playedBy">
    <skos:definition xml:lang="en">Relation indicating the Agent that fulfills the function of the instance of the concept.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:historyNote xml:lang="en">WG approval 09/10/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">played By</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#comprisesReceiptAdviceLine">
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:definition xml:lang="en">Incorporates Receipt Advice Line.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">comprises Receipt Advice Line</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasCarriageShipmentStage">
    <skos:definition xml:lang="en">The Shipment Stage for the last mile covered in a transport chain.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 20/03/2025</skos:historyNote>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">has Carriage Shipment Stage</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#TransportEquipmentSeal">
    <skos:prefLabel xml:lang="en">Transport Equipment Seal</skos:prefLabel>
    <skos:definition xml:lang="en">Means used to ensure that the Transport Equipment is not tampered during transportation.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <skos:historyNote xml:lang="en">WG Approval 21/05/2023</skos:historyNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#refersToConsignment">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <skos:prefLabel xml:lang="en">refers To Consignment</skos:prefLabel>
    <skos:historyNote xml:lang="en">WG Approval 25/06/2024</skos:historyNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Reference to a Consignment.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#refersToDeliveryInformation">
    <skos:prefLabel xml:lang="en">refers To Delivery Information</skos:prefLabel>
    <skos:definition xml:lang="en">Reference to a Delivery Information.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 25/06/2024</skos:historyNote>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasDespatchPeriod">
    <skos:prefLabel xml:lang="en">has Despatch Period</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">The time period when the Despatcher picks-up the Goods Items to be delivered.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 16/07/2024</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasRejectAction">
    <skos:definition xml:lang="en">Relation indicating the Action Code for non-acceptance.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">has Reject Action</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#specifiesDespatcher">
    <skos:prefLabel xml:lang="en">specifies Despatcher</skos:prefLabel>
    <skos:historyNote xml:lang="en">WG Approval 25/06/2024</skos:historyNote>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Relation indicating that the instance of the concept involves the Despatcher.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#specifiesPlaceOfDespatch">
    <skos:historyNote xml:lang="en">WG Approval 25/06/2024</skos:historyNote>
    <skos:definition xml:lang="en">Relation indicating the Location of the Despatch of the Goods Items to be delivered.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">specifies Place Of Despatch</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#TransportHandlingUnit">
    <skos:definition xml:lang="en">The outermost Package that the Carrier is handling.</skos:definition>
    <skos:prefLabel xml:lang="en">Transport Handling Unit</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Package"/>
    <skos:historyNote xml:lang="en">WG Approval 14/05/2024</skos:historyNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#specifiesConsignee">
    <skos:historyNote xml:lang="en">WG Approval 25/06/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">specifies Consignee</skos:prefLabel>
    <skos:definition xml:lang="en">Relation indicating that the instance of the concept involves the Consignee.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#containsGoodsItem">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:historyNote xml:lang="en">WG Approval 10/06/2024</skos:historyNote>
    <skos:definition xml:lang="en">Includes Goods Item.</skos:definition>
    <skos:prefLabel xml:lang="en">contains Goods Item</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#concernsGoodsItem">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Relates to Goods Item.</skos:definition>
    <skos:prefLabel xml:lang="en">concerns Goods Item</skos:prefLabel>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasPackagingType">
    <skos:prefLabel xml:lang="en">has Packaging Type</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">The kind of Package.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#refersToOrderLine">
    <skos:historyNote xml:lang="en">WG Approval 25/06/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">refers To Order Line</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <skos:definition xml:lang="en">Reference to an Order Line.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasShortageAction">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Relation indicating the Action code for Quantity deficiency.</skos:definition>
    <skos:prefLabel xml:lang="en">has Shortage Action</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasPackagingStatusDescription">
    <skos:prefLabel xml:lang="en">has Packaging Status Description</skos:prefLabel>
    <skos:historyNote xml:lang="en">WG approval 25/09/2026</skos:historyNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:definition xml:lang="en">Explanatory text about the condition of a Package. (epo-ful:Package)</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasTransportEquipmentSeal">
    <skos:definition xml:lang="en">Relation indicating that the instance of the concept has a Transport Equipment Seal.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:historyNote xml:lang="en">WG Approval 25/06/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Transport Equipment Seal</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#Consignment">
    <skos:historyNote xml:lang="en">WG Approval 14/05/2024</skos:historyNote>
    <skos:definition xml:lang="en">A batch of goods destined for or delivered to someone. Additional information: Consignment is a Transport Agreement between the Despatcher and the Consignee as to who and how the goods are despatched and received.</skos:definition>
    <skos:prefLabel xml:lang="en">Consignment</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#ReceiptAdviceLine">
    <skos:prefLabel xml:lang="en">Receipt Advice Line</skos:prefLabel>
    <skos:definition xml:lang="en">Details concerning the Fulfilment of a Despatch Line.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Line"/>
    <skos:historyNote xml:lang="en">WG approval 16/09/2025</skos:historyNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasOutstandingQuantityReason">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel xml:lang="en">has Outstanding Quantity Reason</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <skos:historyNote xml:lang="en">WG Approval 05/06/2024</skos:historyNote>
    <skos:definition xml:lang="en">Explanation of the outstanding quantity still to be despatched. (epo-ful:DespatchLine)</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#refersToReceiptAdvice">
    <skos:prefLabel xml:lang="en">refers To Receipt Advice</skos:prefLabel>
    <skos:definition xml:lang="en">Reference to a Receipt Advice.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasTransportMeansType">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <skos:definition xml:lang="en">The kind of Transport Means.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">has Transport Means Type</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasDeclaredStatisticalValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <skos:definition xml:lang="en">The Monetary Value declared for statistical purposes.</skos:definition>
    <skos:prefLabel xml:lang="en">has Declared Statistical Value</skos:prefLabel>
    <skos:historyNote xml:lang="en">WG Approval 10/06/2024</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasNetWeight">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <skos:definition xml:lang="en">The total mass of goods without the packaging.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:historyNote xml:lang="en">WG Approval 18/06/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Net Weight</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasVehicleID">
    <skos:definition xml:lang="en">The identifier of the Transport Means.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:historyNote xml:lang="en">WG Approval 25/06/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Vehicle ID</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#refersToDespatchAdvice">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Reference to a Despatch Advice.</skos:definition>
    <skos:prefLabel xml:lang="en">refers To Despatch Advice</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasVehicleSegmentID">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">The identifier of a part of the Transport Means.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 25/06/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Vehicle Segment ID</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasLength">
    <skos:prefLabel xml:lang="en">has Length</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">The horizontal measurement. Additional Information: The length is the longer side between the length and the width.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 18/06/2024</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#TransportEquipment">
    <skos:prefLabel xml:lang="en">Transport Equipment</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <skos:definition xml:lang="en">Description of the apparatus used during transportation. Additional information: The equipment may be a container, a trailer, means of assistance to load or unload the Goods Items.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 21/05/2024</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasDespatchDate">
    <skos:historyNote xml:lang="en">WG Approval 05/06/2024</skos:historyNote>
    <skos:definition xml:lang="en">The date of sending of goods or the execution of works or services. (epo-ful:ShipmentInformation)</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel xml:lang="en">has Despatch Date</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasLoadingMeter">
    <skos:definition xml:lang="en">The area of the Consignment in meters divided by the width of the truck, which is considered to be 2.4 meters.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 18/06/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Loading Meter</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#Despatcher">
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#OfferingParty"/>
    <skos:prefLabel xml:lang="en">Despatcher</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <skos:definition xml:lang="en">The Role of an Agent who sends the goods or notifies of the service or works execution. Additional Information: The Role is carried out by the Supplier or on behalf of the Supplier. This Role is often referred to as the Despatch Party, Consignor or Deliverer.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 02/07/2024</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#ShipmentStage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">Part of the itinerary of a shipment. Additional information: In the context of fulfilment only the last part of the itinerary is taken into consideration.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <skos:historyNote xml:lang="en">WG Approval 21/05/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">Shipment Stage</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasRejectedQuantity">
    <skos:definition xml:lang="en">Relation indicating the non-accepted Quantity.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Rejected Quantity</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasOutstandingQuantity">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <skos:prefLabel xml:lang="en">has Outstanding Quantity</skos:prefLabel>
    <skos:definition xml:lang="en">The Quantity of non-despatched Goods Items.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:historyNote xml:lang="en">WG Approval 05/06/2024</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#containsPackage">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <skos:definition xml:lang="en">Includes Package.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:historyNote xml:lang="en">WG Approval 10/06/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">contains Package</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasPackagingStatus">
    <skos:prefLabel xml:lang="en">has Packaging Status</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Relation indicating the Packaging Status.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasPackingMaterialDescription">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:historNote xml:lang="en">WG approval 25/09/2026</skos:historNote>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <skos:prefLabel xml:lang="en">has Packing Material Description</skos:prefLabel>
    <skos:definition xml:lang="en">Explanatory text about the physical substance that a Package is made of. (epo-ful:AbstractContainer)</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#DespatchLine">
    <skos:prefLabel xml:lang="en">Despatch Line</skos:prefLabel>
    <skos:definition xml:lang="en">Details concerning the fulfilment of an Order Line.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Line"/>
    <skos:historyNote xml:lang="en">WG Approval 21/05/2024</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasSpecialServiceInstruction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <skos:definition xml:lang="en">Description about special services needed for loading or unloading the Goods Items. (epo-ful:Consignment)</skos:definition>
    <skos:prefLabel xml:lang="en">has Special Service Instruction</skos:prefLabel>
    <skos:historyNote xml:lang="en">WG Approval 21/05/2024</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#Package">
    <skos:historyNote xml:lang="en">WG Approval 14/05/2024</skos:historyNote>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AbstractContainer"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <skos:prefLabel xml:lang="en">Package</skos:prefLabel>
    <skos:definition xml:lang="en">Container used for transportation.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasDriverPerson">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <skos:prefLabel xml:lang="en">has Driver Person</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:historyNote xml:lang="en">WG Approval 02/07/2024</skos:historyNote>
    <skos:definition xml:lang="en">Relation indicating the operator of the Transport Means.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#isSubmittedForDespatchAdvice">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">is Submitted For Despatch Advice</skos:prefLabel>
    <skos:definition xml:lang="en">Relation indicating that the instance of the concept is sent for a specific Despatch Advice.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasMinimumTemperature">
    <skos:historyNote xml:lang="en">WG Approval 18/06/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Minimum Temperature</skos:prefLabel>
    <skos:definition xml:lang="en">The lowest tolerated temperature.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#isSpecificToReceiptAdviceLine">
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:definition xml:lang="en">Information that is particular to a Receipt Advice Line.</skos:definition>
    <skos:prefLabel xml:lang="en">is Specific To Receipt Advice Line</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#FreightForwarder">
    <skos:prefLabel xml:lang="en">Freight Forwarder</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <skos:definition xml:lang="en">The Role of an Agent who organise the logistic operations need for a fulfilment.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AuxiliaryParty"/>
    <skos:historyNote xml:lang="en">WG Approval 21/05/2024</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#agreedBySeller">
    <skos:definition xml:lang="en">Accepted by Seller.</skos:definition>
    <skos:prefLabel xml:lang="en">agreed By Seller</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:historyNote xml:lang="en">WG Approval 10/06/2024</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasOversupplyQuantity">
    <skos:prefLabel xml:lang="en">has Oversupply Quantity</skos:prefLabel>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:definition xml:lang="en">Relation indicating the Quantity surplus.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#usesTransportMeans">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Relation indicating that a Shipment Stage utilises a Transport Means.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 02/07/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">uses Transport Means</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#ReceiptAdvice">
    <skos:definition xml:lang="en">A formal reply from the Buyer to the Seller acknowledging the physical or electronic receipt of goods or services delivered under a Procurement Contract.</skos:definition>
    <skos:prefLabel xml:lang="en">Receipt Advice</skos:prefLabel>
    <skos:historyNote xml:lang="en">WG approval 16/09/2025</skos:historyNote>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#PostAwardDocument"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#isSubmittedForShipment">
    <skos:definition xml:lang="en">Relation indicating that the instance of the concept is sent for a specific Shipment.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">is Submitted For Shipment</skos:prefLabel>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasDespatchAdviceType">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">has Despatch Advice Type</skos:prefLabel>
    <skos:definition xml:lang="en">Classification of a Despatch Advice.</skos:definition>
  </rdf:Description>
</rdf:RDF>
