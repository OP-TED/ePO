    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">Procurement Documents Provision</skos:prefLabel>
    <skos:definition xml:lang="en">The provision by the Buyer to the Economic Operator of the Procurement Documents.</skos:definition>
