  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#ESPDRequest">
    <skos:historyNote xml:lang="en">WG Approval 05/03/2024</skos:historyNote>
    <skos:definition xml:lang="en">A document issued by a buyer defining how the Exclusion Grounds and the Selection Criteria should be addressed in a European Single Procurement Document for a specific procurement.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ProcurementDocument"/>
    <skos:prefLabel xml:lang="en">ESPD Request</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#acc"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#concernsProcedure">
    <skos:definition xml:lang="en">Relates to Procedure.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 05/03/2024</skos:historyNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">concerns Procedure</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#acc"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#relatesToESPDRequest">
    <skos:definition xml:lang="en">Is about an European Single Procurement Document (ESPD) Request.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#acc"/>
    <skos:prefLabel xml:lang="en">relates To ESPD Request</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:historyNote xml:lang="en">WG Approval 05/03/2024</skos:historyNote>
  </rdf:Description>
