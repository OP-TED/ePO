  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#ESPDRequest">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">ESPD Request</skos:prefLabel>
    <skos:definition xml:lang="en">A document issued by a buyer defining how the Exclusion Grounds and the Selection Criteria should be addressed in a European Single Procurement Document for a specific procurement.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#acc"/>
    <skos:historyNote xml:lang="en">WG Approval 05/03/2024</skos:historyNote>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ProcurementDocument"/>
  </rdf:Description>
