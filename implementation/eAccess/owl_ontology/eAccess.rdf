  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#UnsubscribeFromProcedure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">Unsubscribe From Procedure</skos:prefLabel>
    <skos:definition xml:lang="en">A formal request to stop receiving information on a Procedure.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#acc"/>
    <skos:historyNote xml:lang="en">WG approval 18/08/2026</skos:historyNote>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Document"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#answersQuestion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">answers Question</skos:prefLabel>
    <skos:definition xml:lang="en">Relation indicating that the Response replies to a question.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#acc"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#ProcurementDocumentsRequest">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">Procurement Documents Request</skos:prefLabel>
    <skos:definition xml:lang="en">The request by the Economic Operator to the Buyer to receive the latest version of all the Procurement Documents.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#acc"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Document"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#acc">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:imports rdf:resource="http://purl.org/dc/terms/"/>
    <owl:imports rdf:resource="http://www.w3.org/ns/org#"/>
    <owl:imports rdf:resource="http://www.w3.org/2004/02/skos/core#"/>
    <owl:imports rdf:resource="http://www.w3.org/2006/time"/>
