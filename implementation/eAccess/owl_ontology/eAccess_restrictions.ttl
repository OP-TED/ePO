@prefix : <http://data.europa.eu/a4g/ontology#> .
@prefix cccev: <http://data.europa.eu/m8g/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eli: <http://data.europa.eu/eli/ontology#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:acc-restriction a owl:Ontology ;
    rdfs:label "eProcurement Ontology Access - core restrictions"@en ;
    dcterms:created "2021-06-01"^^xsd:date ;
    dcterms:description "The eProcurement Ontology Access core restrictions provides the restrictions and the inference-related specifications on the concepts and properties in the eProcurement Ontology Access core."@en ;
    dcterms:issued "2026-10-26"^^xsd:date ;
    dcterms:license "© European Union, 2014. Unless otherwise noted, the reuse of the Ontology is authorised under the European Union Public Licence v1.2 (https://eupl.eu/)." ;
    dcterms:publisher "http://publications.europa.eu/resource/authority/corporate-body/PUBL" ;
    dcterms:title "eProcurement Ontology Access - core restrictions"@en ;
    vann:preferredNamespacePrefix "epo" ;
    vann:preferredNamespaceUri "http://data.europa.eu/a4g/ontology#" ;
    rdfs:comment """This version is automatically generated from eAccess.xml on 
                2026-10-26""" ;
    rdfs:seeAlso <https://docs.ted.europa.eu/home/index.html>,
        <https://github.com/OP-TED/ePO/releases>,
        <https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology/about>,
        <https://op.europa.eu/en/web/eu-vocabularies/e-procurement> ;
    owl:imports :acc,
        :core,
        :sub,
        eli:,
        cccev:,
        dcterms:,
        skos:,
        <http://www.w3.org/2006/time>,
        <http://www.w3.org/ns/adms>,
        <http://www.w3.org/ns/locn>,
        org:,
        <http://www.w3.org/ns/person> ;
    owl:incompatibleWith "4.2.0" ;
    owl:priorVersion "http://data.europa.eu/a4g/ontology#acc-restriction-5.2.0" ;
    owl:versionIRI :acc-restriction-5.3.0 ;
    owl:versionInfo "5.3.0" .

:concernsLot rdfs:domain :InformationRequest ;
    rdfs:range :Lot .

:concernsLotGroup rdfs:domain :InformationRequest ;
    rdfs:range :LotGroup .

:containsProvidedProcurementDocument rdfs:domain [ a owl:Class ;
            owl:unionOf ( :InvitationToTender :ProcurementDocumentsProvision ) ] ;
    rdfs:range :ProcurementDocument .

:hasResourceType rdfs:domain eli:LegalResource ;
    rdfs:range skos:Concept .

:hasSubdivision rdfs:domain eli:LegalResourceSubdivision ;
    rdfs:range skos:Concept .

:refersToNotice rdfs:domain :ESPDRequest ;
    rdfs:range :Notice .

:ESPD rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass :ESPDRequest ;
            owl:onProperty :relatesToESPDRequest ] .

:ProcurementQuestionReply rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :containsInformationResponse ;
            owl:someValuesFrom :InformationResponse ] .

:UnsubscribeFromProcedureResponse rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :UnsubscribeFromProcedure ;
            owl:onProperty :refersToUnsubscribeFromProcedure ;
            owl:qualifiedCardinality 1 ] .

:answersQuestion a owl:FunctionalProperty ;
    rdfs:domain :InformationResponse ;
    rdfs:range :InformationRequest .

:containsInformationRequest rdfs:domain :ProcurementQuestion ;
    rdfs:range :InformationRequest .

:containsInformationResponse rdfs:domain :ProcurementQuestionReply ;
    rdfs:range :InformationResponse .

:refersToProcurementDocumentsRequest rdfs:domain :ProcurementDocumentsProvision ;
    rdfs:range :ProcurementDocumentsRequest .

:refersToUnsubscribeFromProcedure a owl:FunctionalProperty ;
    rdfs:domain :UnsubscribeFromProcedureResponse ;
    rdfs:range :UnsubscribeFromProcedure .

:relatesToESPDRequest rdfs:domain :ESPD ;
    rdfs:range :ESPDRequest .

:specifiesProcurementCriterion rdfs:domain :ESPDRequest ;
    rdfs:range :ProcurementCriterion .

:ProcurementQuestion rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :containsInformationRequest ;
            owl:someValuesFrom :InformationRequest ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass :OfferingParty ;
            owl:onProperty :specifiesEconomicOperator ] .

:InformationResponse rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :InformationRequest ;
            owl:onProperty :answersQuestion ;
            owl:qualifiedCardinality 1 ] .

:InvitationToTender rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :Procedure ;
            owl:onProperty :concernsProcedure ;
            owl:qualifiedCardinality 1 ],
        [ a owl:Restriction ;
            owl:onClass :OfferingParty ;
            owl:onProperty :specifiesEconomicOperator ;
            owl:qualifiedCardinality 1 ] .

:ProcurementDocumentsProvision rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass :ProcurementDocumentsRequest ;
            owl:onProperty :refersToProcurementDocumentsRequest ],
        [ a owl:Restriction ;
            owl:onClass :OfferingParty ;
            owl:onProperty :specifiesEconomicOperator ;
            owl:qualifiedCardinality 1 ],
        [ a owl:Restriction ;
            owl:onClass :Procedure ;
            owl:onProperty :concernsProcedure ;
            owl:qualifiedCardinality 1 ] .

:ProcurementDocumentsRequest rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :OfferingParty ;
            owl:onProperty :specifiesEconomicOperator ;
            owl:qualifiedCardinality 1 ],
        [ a owl:Restriction ;
            owl:onClass :Procedure ;
            owl:onProperty :concernsProcedure ;
            owl:qualifiedCardinality 1 ] .

:UnsubscribeFromProcedure rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :Procedure ;
            owl:onProperty :concernsProcedure ;
            owl:qualifiedCardinality 1 ],
        [ a owl:Restriction ;
            owl:onClass :OfferingParty ;
            owl:onProperty :specifiesEconomicOperator ;
            owl:qualifiedCardinality 1 ] .

:ESPDRequest rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :specifiesProcurementCriterion ;
            owl:someValuesFrom :ProcurementCriterion ],
        [ a owl:Restriction ;
            owl:onClass :Procedure ;
            owl:onProperty :concernsProcedure ;
            owl:qualifiedCardinality 1 ] .

:concernsProcedure a owl:FunctionalProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :ESPDRequest :InformationRequest :InvitationToTender :ProcurementDocumentsProvision :ProcurementDocumentsRequest :UnsubscribeFromProcedure ) ] ;
    rdfs:range :Procedure .

:specifiesEconomicOperator a owl:FunctionalProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :InvitationToTender :ProcurementDocumentsProvision :ProcurementDocumentsRequest :ProcurementQuestion :UnsubscribeFromProcedure ) ] ;
    rdfs:range :OfferingParty .

