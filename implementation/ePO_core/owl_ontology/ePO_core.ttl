    skos:definition "The reasons why the procedure is accelerated. Additional Information: A procedure is accelerated to cover needs of extraordinary circumstances ie earthquake relief. (epo:Procedure)"@en ;
    skos:historyNote "WG Approval 09/06/2020"@en ;
    skos:prefLabel "has Accelerated Procedure Justification"@en .

epo:hasAccessURL a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Location where the resource can be accessed. (epo:Document)"@en ;
    skos:historyNote "WG approval 07/04/2022"@en ;
    skos:prefLabel "has Access URL"@en .

epo:hasAccessibilityDate a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The date at which unpublished data shall be published. (epo:NonPublishedInformation)"@en ;
    skos:historyNote "WG Approval 11/06/2020"@en ;
    skos:prefLabel "has Accessibility Date"@en .

epo:hasActivityDescription a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "In the ePO ontology a taxonomy with all activities, based on different classifications (COFOG, UTILITIES, NACE), will be provided. In ePO this field is to be used exclusively to complement the definition attached to the MainActivityCode. However, in eForms there is the code \"other\" to cover undefined activities. For mapping to this eForms feature one could also use this property. (epo:Buyer)"@en ;
    skos:prefLabel "has Activity Description"@en .

epo:hasAdditionalClassification a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Additional Classification"@en .

epo:hasAdditionalContractNature a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Additional type of acquisition taken into consideration in the contract."@en ;
    skos:prefLabel "has Additional Contract Nature"@en .

epo:hasAdditionalInformation a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Supplementary data about the instance of the concept. (epo:ProcurementElement) Supplementary data about the instance of the concept. (epo:ProcurementCriterion) Supplementary data about the instance of the concept. (epo:Document) Supplementary data about the instance of the concept. (epo:ChangeInformation)"@en ;
    skos:editorialNote "Used by eforms BT-300"@en ;
    skos:historyNote "WG Approval 15/10/2019"@en ;
    skos:prefLabel "has Additional Information"@en .

epo:hasAdditionalInformationDeadline a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The time limit for requesting further information. Additional information: This is generally used to indicate the deadline for Economic Operators to request further information of the procedure before the submission deadline. (epo:AccessTerm)"@en ;
    skos:editorialNote "Used by eForms BT-13"@en ;
    skos:historyNote "WG Approval 09/06/2020"@en ;
    skos:prefLabel "has Additional Information Deadline"@en .

epo:hasAddressURL a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The resource identifier for a Channel. (cv:Channel)"@en ;
    skos:historyNote "WG Approval 26/03/2024"@en ;
    skos:prefLabel "has Address URL"@en .

epo:hasAlias a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Acronym or alternative name of the Agent. (foaf:Agent)"@en ;
    skos:historyNote "WG Approval 25/03/2021"@en ;
    skos:prefLabel "has Alias"@en .

epo:hasAllegedIrregularityType a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Alleged Irregularity Type"@en .

epo:hasAmount a owl:ObjectProperty ;
