    skos:historyNote "WG Approval 06/10/2024"@en ;
    skos:prefLabel "has Associated Document"@en .

epo:hasAwardCriteriaEvaluationFormula a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The mathematical equation or any other description used for complicated weighing of criteria (e.g. non-linear weighing, the analytic hierarchy process) when a weighing cannot be expressed per criterion. (epo:AwardEvaluationTerm)"@en ;
    skos:editorialNote "Used by eForms BT-543"@en ;
    skos:prefLabel "has Award Criteria Evaluation Formula"@en .

epo:hasAwardCriteriaOrderJustification a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The justification for only indicating the award criteria's order of importance, not their weighing. (epo:AwardEvaluationTerm)"@en ;
    skos:editorialNote "Used by eForms BT-733"@en ;
    skos:prefLabel "has Award Criteria Order Justification"@en .

epo:hasAwardCriteriaStatedInProcurementDocuments a owl:DatatypeProperty ;
