epo:involvesBuyer a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "involves Buyer"@en .

epo:involvesProcurementDocument a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "involves Procurement Document"@en .

epo:isAccelerated a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Statement about the fact that the procedure will be reduced due to a state of urgency. Additional Information This modifies the time limit for the receipt of requests to participate or the receipt of tenders. (epo:Procedure)"@en ;
    skos:historyNote "WG Approval 20/08/2019"@en ;
    skos:prefLabel "is Accelerated"@en .

epo:isAdvancedElectronicSignatureRequired a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Advanced or qualified electronic signature or seal (as defined in Regulation (EU) No 910/2014) is required. The submitted information is required to be signed electronically. Additional Information: Signature can be defined as \"data in electronic form which is attached to or logically associated with other data in electronic form and which is used by the signatory to sign. For more details on the meaning and uses of electronic signature you may consult different authoritative sources, a relevant one being for instance the Regulation (EU) 910/2014 on electronic identification and trust services for electronic transactions in the internal market. (epo:SubmissionTerm)"@en ;
    skos:historyNote "WG Approval 21/07/2020"@en ;
    skos:prefLabel "is Advanced Electronic Signature Required"@en .

epo:isAppointedBy a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "is Appointed By"@en .

epo:isAssignedForEvaluationOf a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "is Assigned For Evaluation Of"@en .

epo:isAwardedByCPB a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Procedure is awarded by a Central Purchasing Body. (epo:ProcedureTerm)"@en ;
    skos:prefLabel "is Awarded By CPB"@en .

epo:isBasedOnImplementingRegulation a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Indicates under which regulation a notice is created."@en ;
    skos:prefLabel "is Based On Implementing Regulation"@en .

epo:isBeneficialOwnerOf a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "A role of any natural person(s) who ultimately owns or controls the organisation or on whose behalf a transaction or activity is being conducted. Additional Information: This role is defined in the directive EU 2015/849 and it's beyond the scope for public eProcurement domain."@en ;
    skos:historyNote "WG Approval 14/09/2021"@en ;
    skos:prefLabel "is Beneficial Owner Of"@en .

epo:isCalculatedOn a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The monetary amount to which the multiplier factor is applied in calculating the amount of this allowance, charge or tax."@en ;
    skos:prefLabel "is Calculated On"@en .

epo:isCompetitionTerminated a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "No further contracts will be awarded in this procedure. Additional Information: This can be instantiated in the post award phase. PIN for Competition needs to be signaled. This field can be used even if no contracts are awarded in the contract award notice. (epo:ProcurementProcessInformation)"@en ;
    skos:editorialNote "Used by eForms BT-756"@en ;
    skos:prefLabel "is Competition Terminated"@en .

epo:isContainedInTender a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "is Contained In Tender"@en .

epo:isContractingEntity a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Role of entities, which: (a) are contracting authorities or public undertakings and which pursue one of the activities referred to in Articles 8 to 14 of the Directive 2014/25/EU. (b) when they are not contracting authorities or public undertakings, have as one of their activities any of the activities referred to in Articles 8 to 14, or any combination thereof and operate on the basis of special or exclusive rights granted by a competent authority of a Member State. Additional Information: The indicator is needed in order to discriminate between those contracts where the Contracting Entity acts as a Contracting Authority undergoing the limits and the rules of Directive 24 and those where it acts as a Contracting Entity, with certain relaxed constraints. For example, the Contracting Entities have different thresholds for the application of Directive 24 if compared with Contracting Authorities. (epo:Buyer)"@en ;
    skos:historyNote "WG Approval 28/04/2020"@en ;
    skos:prefLabel "is Contracting Entity"@en .

epo:isCoveredByGPA a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Specifies whether the Agreement on Government Procurement (GPA) applies. Additional information: The GPA aims to establish a multilateral framework of balanced rights and obligations relating to public contracts with a view to achieving the liberalization and expansion of world trade. (epo:ProcurementElement)"@en ;
    skos:editorialNote "Used by eForms BT-115"@en ;
    skos:historyNote "WG Approval 15/10/2019"@en ;
    skos:prefLabel "is Covered By GPA"@en .

epo:isDPSTerminated a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "End of the Dynamic Purchase System (DPS). Additional Information: This property can be used in the contract award notice even if no contracts are awarded. (epo:ProcurementProcessInformation)"@en ;
    skos:historyNote "WG Approval 22/11/2019"@en ;
    skos:prefLabel "is DPS Terminated"@en .

epo:isDesignContest a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "A competition which enables the buyer to acquire a plan or design via a jury. Additional information: Design contests have traditionally mostly been used in the fields of town and country planning, architecture and engineering or data processing, other purposes, such as to obtain plans for financial engineering The contest may include or not the award of prizes; (epo:Procedure)"@en ;
    skos:historyNote "WG Approval 04/02/2021"@en ;
    skos:prefLabel "is Design Contest"@en .

epo:isExecutedByProcurementServiceProvider a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "is Executed By Procurement Service Provider"@en .

epo:isFundedBy a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Funding is provided either completely or partially by a Fund. Additional information: Funds may change between the lot and the contract, for example in the case of an emergency crisis, a contract may be financed by a budget that was not foreseen in the call."@en ;
    skos:editorialNote "Used by eForms BG - 61, eForms BG - 611"@en ;
    skos:prefLabel "is Funded By"@en .

epo:isGuaranteeRequired a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The submitted information must include a financial commitment to be used in case of default. Additional Information: See the additional information provided in the definition of the 'Guarantee Description' element. (epo:SubmissionTerm)"@en ;
    skos:historyNote "WG Approval 21/07/2020"@en ;
    skos:prefLabel "is Guarantee Required"@en .

epo:isJointProcurement a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Multiple buyers procure together within the same procedure. Addition Information: In case the joint procurement involves buyers from different countries, the national law is specified by the epo:hasCrossBorderLaw in the ProcedureTerm . (epo:Procedure)"@en ;
    skos:prefLabel "is Joint Procurement"@en .

epo:isJuryDecisionBinding a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Indicates whether the procuring entity is bound to apply the decision of the jury. (epo:DesignContestRegimeTerm)"@en ;
    skos:prefLabel "is Jury Decision Binding"@en .

epo:isListedCompany a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Public companies listed on a stock exchange and subject to disclosure requirements (either by stock exchange rules or through law or enforceable means), which impose requirements to ensure adequate transparency of beneficial ownership. <u>Additional Information:</u> In eForms this indicator is used when the nationality of beneficial owner is not provided because the Economic Operator is registered in a regulated market that is subject to disclosure requirements consistent with Union law or subject to equivalent international standards which ensure adequate transparency of ownership information. (epo:Business)"@en ;
    skos:historyNote "WG Approval 21/11/2019"@en ;
    skos:prefLabel "is Listed Company"@en .

epo:isMultipleTenderSubmissionAllowed a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Tenderers may submit more than one competing tenders. (epo:SubmissionTerm)"@en ;
    skos:historyNote "WG Approval 10/10/2019"@en ;
    skos:prefLabel "is Multiple Tender Submission Allowed"@en .

epo:isNonDisclosureAgreementRequired a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "A non-disclosure agreement is needed. Additional information: A non-disclosure agreement is a Contract between different parties which ensures information is not shared with other parties. (epo:NonDisclosureAgreementTerm)"@en ;
    skos:historyNote "WG Approval 26/03/2024"@en ;
    skos:prefLabel "is Non Disclosure Agreement Required"@en .

epo:isOneLotOnlyAllowed a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Indicates whether tenders may be submitted for only one Lot. Additional information: This field is used to complement the SubmissionTerms (which are at the Lot level) for the Procedure level which is covered by the regulation (EU)-2015-1986 (modeled in the TED Standard Forms). (epo:ProcedureTerm)"@en ;
    skos:historyNote "WG Approval 23/08/2022"@en ;
    skos:prefLabel "is One Lot Only Allowed"@en .

epo:isOwnedByAgent a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "is Owned By Agent"@en .

epo:isProcurementDocumentChanged a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "One or more procurement documents have been changed. (epo:ChangeInformation)"@en ;
    skos:editorialNote "Used by eForms BT-718"@en ;
    skos:historyNote "WG Approval 05/11/2019"@en ;
    skos:prefLabel "is Procurement Document Changed"@en .

epo:isProcurementDocumentRestricted a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The access to certain procurement documents is restricted. (epo:AccessTerm)"@en ;
    skos:editorialNote "Used by eForms BT-14"@en ;
    skos:historyNote "WG Approval 10/10/2019"@en ;
    skos:prefLabel "is Procurement Document Restricted"@en .

epo:isRecurrent a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The Procurement being notified is likely to be included in another procedure in the foreseeable future. Additional Information: For example, a regularly re-tendered municipal service. This does not include awarding multiple contracts within a single qualification system, framework agreement, or a dynamic purchasing system. (epo:ProcurementObject)"@en ;
    skos:editorialNote "Used by eForms BT-94"@en ;
    skos:historyNote "WG Approval 12/05/2020"@en ;
    skos:prefLabel "is Recurrent"@en .

epo:isReinforcedBy a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Relation indicating an Evidence that supports the Response."@en ;
    skos:historyNote "WG Approval 12/03/2024"@en ;
    skos:prefLabel "is Reinforced By"@en .

epo:isRenewalIndicator a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Indicates whether the contract is subject to a renewal clause. (epo:ContractTerm)"@en ;
    skos:historyNote "WG Approval 09/11/2021"@en ;
    skos:prefLabel "is Renewal Indicator"@en .

epo:isResponsibilityOfBuyer a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The buyer in charge of the procedure."@en ;
    skos:prefLabel "is Responsibility Of Buyer"@en .

epo:isSMESuitable a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The procurement is suitable for small and medium enterprises (SMEs). (epo:LotGroup) The procurement is suitable for small and medium enterprises (SMEs). (epo:ProcurementElement)"@en ;
    skos:historyNote "WG Approval 15/10/2024"@en ;
    skos:prefLabel "is SME Suitable"@en .

epo:isSecurityClearanceRequired a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Security Clearance is needed. (epo:SecurityClearanceTerm)"@en ;
    skos:historyNote "WG Approval 02/05/2024"@en ;
    skos:prefLabel "is Security Clearance Required"@en .

epo:isSubcontractingPercentageKnown a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "is Subcontracting Percentage Known"@en .

epo:isSubcontractingValueKnown a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "is Subcontracting Value Known"@en .

epo:isSubjectToGrouping a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "is Subject To Grouping"@en .

epo:isSubjectToTerm a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "is Subject To Term"@en .

epo:isSubmissionForAllLotsRequired a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Indicates whether tenders must be submitted for all Lots. (epo:ProcedureTerm)"@en ;
    skos:prefLabel "is Submission For All Lots Required"@en .

epo:isSubmittedBy a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Relation indicating the submission of a tender by an economic operator."@en ;
    skos:historyNote "WG Approval 18/05/2021"@en ;
    skos:prefLabel "is Submitted By"@en .

epo:isSubmittedForLot a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "is Submitted For Lot"@en .

epo:isSubmittedForLotGroup a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "is Submitted For Lot Group"@en .

epo:isSubordinatedToContract a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "is Subordinated To Contract"@en .

epo:isSupportedBy a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "is Supported By"@en .

epo:isToBeRelaunched a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Indicator of whether the procurement object is to be relaunched. Additional information: This can be instantiated in the post award phase. (epo:ProcurementProcessInformation)"@en ;
    skos:editorialNote "Used by eForms BT-634"@en ;
    skos:historyNote "WG Approval 18/01/2022"@en ;
    skos:prefLabel "is To Be Relaunched"@en .

epo:isUsedForCandidateRestriction a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The criterion will be used to select the candidates to be invited for the second stage of a multistage procedure. Additional Information: This property is only used if a maximum number of candidates was foreseen in the procedure. (epo:SelectionCriterion)"@en ;
    skos:editorialNote "Used by eForms BT-40"@en ;
    skos:prefLabel "is Used For Candidate Restriction"@en .

epo:isUsedInProfile a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "is Used In Profile"@en .

epo:isUsingEUFunds a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The procurement foresees funding by the Union. Additional Information: The funding may cover the whole procurement or part of the procurement. For example the European Structural and Investment Funds or grants awarded by the European Union. (epo:ProcurementObject)"@en ;
    skos:prefLabel "is Using EU Funds"@en .

epo:isVariant a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Alternative solution to fulfil the buyer's needs as opposed to solutions indicated in the procurement documents. Additional Information: The permission to offer variants is only allowed if specified in a Contract Notice or a Prior Information Notice that used as a means for calling for a competition. The buyer lays out minimum requirements in the procurement documents that must be respected by tenderers submitting variants. (epo:Tender)"@en ;
    skos:historyNote "WG Approval 29/05/2019"@en ;
    skos:prefLabel "is Variant"@en .

epo:isWithdrawn a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The review request was withdrawn. (epo:ReviewDecision)"@en ;
    skos:editorialNote "Used by eForms BT-796"@en ;
    skos:prefLabel "is Withdrawn"@en .

epo:issuedByCertifier a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Relation indicating the Certifier responsible for providing the ItemCertificate. Additional Information: Certifier is a role played by an organisation."@en ;
    skos:historyNote "WG Approval 26/07/2022"@en ;
    skos:prefLabel "issued By Certifier"@en .

epo:leadBy a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The epo:OrganisationGroup epo:leadBy org:Organization was implemented to be used in case of an Economic Operator Group."@en ;
    skos:prefLabel "lead By"@en .

epo:needsToBeATenderer a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The Winner must be a Tenderer."@en ;
    skos:prefLabel "needs To Be A Tenderer"@en .

epo:needsToBeAWinner a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The Contractor must be a Winner."@en ;
    skos:prefLabel "needs To Be A Winner"@en .

epo:ownsSystem a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "owns System"@en .

epo:playedBy a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "played By"@en .

epo:preparesForPotentialProcurementObject a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "prepares For Potential Procurement Object"@en .

epo:providesContractTotalPaymentValue a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:editorialNote "Used by eForms BT-779"@en ;
    skos:prefLabel "provides Contract Total Payment Value"@en .

epo:providesContractTotalPenaltyValue a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:editorialNote "Used by eForms BT-782"@en ;
    skos:prefLabel "provides Contract Total Penalty Value"@en .

epo:providesDecisionFor a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "provides Decision For"@en .

epo:providesDocumentation a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "provides Documentation"@en .

epo:providesEvidence a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "provides Evidence"@en .

epo:providesInformationOn a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Offers information about an instance of a concept."@en ;
    skos:historyNote "WG Approval 05/03/2024"@en ;
    skos:prefLabel "provides Information On"@en .

epo:providesOrganisationEmployeeQuantity a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The number of people hired by the Organization."@en ;
    skos:historyNote "WG Approval 05/03/2024"@en ;
    skos:prefLabel "provides Organisation Employee Quantity"@en .

epo:providesOrganisationFinancialCapability a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "A monetary amount representing the financial capability of the Organization. Additional information: Used to represent the general Turnover of the Organization (for statistical purposes)."@en ;
    skos:historyNote "WG Approval 05/03/2024"@en ;
    skos:prefLabel "provides Organisation Financial Capability"@en .

epo:providesProcurementDocumentsInOfficialLanguage a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "provides Procurement Documents In Official Language"@en .

epo:providesProcurementDocumentsInUnofficialLanguage a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "provides Procurement Documents In Unofficial Language"@en .

epo:providesRankToTender a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "provides Rank To Tender"@en .

epo:providesRulingOnRemedy a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "States the measures to be taken after a review procedure."@en ;
    skos:prefLabel "provides Ruling On Remedy"@en .

epo:refersToApplicablePeriod a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Relation indicating the period to which the Response shall apply."@en ;
    skos:historyNote "WG Approval 12/03/2024"@en ;
    skos:prefLabel "refers To Applicable Period"@en .

epo:refersToAwardDecision a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "refers To Award Decision"@en .

epo:refersToContract a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "refers To Contract"@en .

epo:refersToContractToBeModified a owl:ObjectProperty ;
