    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "specifies Buyer"@en .

epo:specifiesCatalogueProvider a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "specifies Catalogue Provider"@en .

epo:specifiesCatalogueReceiver a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "specifies Catalogue Receiver"@en .

epo:specifiesCleanVehicleDirectiveContractType a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "specifies Clean Vehicle Directive Contract Type"@en .

epo:specifiesCleanVehicleDirectiveVehicleCategory a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "specifies Clean Vehicle Directive Vehicle Category"@en .

epo:specifiesContractor a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "specifies Contractor"@en .

epo:specifiesDeliverable a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "specifies Deliverable"@en .

epo:specifiesDeliveryAgreementLocation a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "specifies Delivery Agreement Location"@en .

epo:specifiesEconomicOperator a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "specifies Economic Operator"@en .

epo:specifiesEvidence a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "specifies Evidence"@en .

epo:specifiesForeignSubsidiesMeasureConclusion a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "specifies Foreign Subsidies Measure Conclusion"@en .

epo:specifiesOfferCurrency a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "specifies Offer Currency"@en .

epo:specifiesOfferValidityPeriod a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "specifies Offer Validity Period"@en .

epo:specifiesPlaceOfDelivery a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "specifies Place Of Delivery"@en .

epo:specifiesPlaceOfDespatch a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Relation indicating the Location of the Despatch of the Goods Items to be delivered."@en ;
    skos:historyNote "WG Approval 25/06/2024"@en ;
    skos:prefLabel "specifies Place Of Despatch"@en .

epo:specifiesProcurementCriteriaSummary a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "specifies Procurement Criteria Summary"@en .

epo:specifiesProcurementCriterion a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "specifies Procurement Criterion"@en .

epo:specifiesReviewRequester a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "specifies Review Requester"@en .

epo:specifiesReviewer a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "specifies Reviewer"@en .

epo:specifiesTenderer a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "specifies Tenderer"@en .

epo:substantiatesExclusionGround a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "substantiates Exclusion Ground"@en .

epo:summarisesInformationAboutEvidence a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Relation indicating the Certificate that the information refers to."@en ;
    skos:historyNote "WG Approval 12/03/2024"@en ;
    skos:prefLabel "summarises Information About Evidence"@en .

epo:summarisesInformationForAwardOutcome a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Relates to submission for the given competition, either at Lot level or Mini-Competition level."@en ;
    skos:historyNote "WG Approval 30/05/2023"@en ;
    skos:prefLabel "summarises Information For Award Outcome"@en .

epo:updatesContractValue a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "updates Contract Value"@en .

epo:usesChannel a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "uses Channel"@en .

epo:usesCleanVehicleDirective a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The procurement falls within the scope of the European Parliament and Council 2009/33/EC (Clean Vehicles Directive – CVD). (epo:GreenProcurement)"@en ;
    skos:prefLabel "uses Clean Vehicle Directive"@en .

epo:usesEvaluationFormula a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "uses Evaluation Formula"@en .

epo:usesTechnique a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "uses Technique"@en .

epo:AwardOutcome a owl:Class ;
    rdfs:isDefinedBy epo:core ;
    rdfs:subClassOf epo:ContextualProjection ;
    skos:definition "Result concerning the competition that was attributed by the Awarder."@en ;
    skos:historyNote "WG approval 19/03/2024"@en ;
    skos:prefLabel "Award Outcome"@en .

epo:Buyer a owl:Class ;
    rdfs:isDefinedBy epo:core ;
    rdfs:subClassOf epo:AcquiringParty ;
    skos:definition "A Role of an Agent that awards a Contract and/or purchases items. Additional information: In Public Procurement the Role of Buyer is carried out by the following types of Organisation: Contracting Authority, Contracting Entity, a defense Contractor, an international Organisation, or an organisation awarding a Contract subsidized by a Contracting Authority. In Pre-Award, the Buyer generally awards the Contract, however future purchasers may be foreseen. In Post-Award the buyer generally refers to the purchaser of items."@en ;
    skos:prefLabel "Buyer"@en .

epo:CentralPurchasingBody a owl:Class ;
    rdfs:isDefinedBy epo:core ;
    rdfs:subClassOf epo:Buyer ;
    skos:definition "Role of an Agent that provides centralised purchasing activities and, possibly, ancillary purchasing activities for other Buyers. Additional Information: In Public Procurement the Role of Central Purchasing Body is carried out by a Contracting Authority for other Contracting Authorities. Contracting Authority procuring activities conducted on a permanent basis, in one of the following forms:[...](b) the award of Public Contracts or the conclusion of Framework Agreements for works, supplies or services intended for Contracting Authorities;"@en ;
    skos:historyNote "WG approval 05/08/2021"@en ;
    skos:prefLabel "Central Purchasing Body"@en .

epo:ContextualProjection a owl:Class ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Projection of an Entity and all of its properties that hold in a given Situation Context. Additional Information: The contextual projection does not have its own identity (-I), is dependent (+D) on the described Entity, and is anti-rigid (~R) We say that ContextualProjection *describes* an Entity. Adaptation of ContextSlices pattern encoding a 4D view. http://ontologydesignpatterns.org/wiki/Submissions:Context_Slices"@en ;
    skos:prefLabel "Contextual Projection"@en .

epo:Estimate a owl:Class ;
    rdfs:isDefinedBy epo:core ;
    rdfs:subClassOf epo:ContextDescription ;
    skos:definition "An approximate calculation or a judgement of the value, number, Quantity or extent of something."@en ;
    skos:prefLabel "Estimate"@en .

epo:EvaluationTerm a owl:Class ;
    rdfs:isDefinedBy epo:core ;
    rdfs:subClassOf epo:Term ;
    skos:definition "Conditions and stipulations defining particularities of the Tender evaluation."@en ;
    skos:historyNote "WG approval 23/11/2018"@en ;
    skos:prefLabel "Evaluation Term"@en .

epo:ProcurementObject a owl:Class ;
    rdfs:isDefinedBy epo:core ;
    rdfs:subClassOf epo:MaskableObject,
        epo:ProcurementElement ;
    skos:definition "The whole or a division of goods, services or works to be procured. Additional Information: Anything that can specify the procurement content (i.e. goods, services, work) is a Procurement Object. In a sense, such an \"object\" can constitute the \"object of a Contract\". To test whether something is a Procedure Object check if it can have a Purpose and/or CPV classification (<i>The CPV establishes a single classification system for public procurement aimed at standardising the references used by Contracting Authorities and entities to describe the subject of Procurement Contracts.</i>). Note: Procedure, seems to be an exception from this rule. Because it is a conflated term: it carries process properties and \"purpose\" properties."@en ;
    skos:prefLabel "Procurement Object"@en .

epo:QualificationCriteriaSummary a owl:Class ;
    rdfs:isDefinedBy epo:core ;
    rdfs:subClassOf epo:ProcurementCriteriaSummary ;
    skos:definition "Overview of the Qualification Criteria."@en ;
    skos:historyNote "WG Approval 19/03/2024"@en ;
    skos:prefLabel "Qualification Criteria Summary"@en .

epo:QualificationCriterion a owl:Class ;
    rdfs:isDefinedBy epo:core ;
    rdfs:subClassOf epo:ProcurementCriterion ;
    skos:definition "Criterion used in the first stage of procurement."@en ;
    skos:historyNote "WG approval 30/05/2023"@en ;
    skos:prefLabel "Qualification Criterion"@en .

epo:AgentInRole a owl:Class ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Relative concept that ties an Agent to a part they play in a given Situational Context. Additional information: The classification of roles is based is based on the degree of involvement into the Procurement Process: - Primary (Procurement) Pole is directly involved in the Procurement Process; - Secondary (Procurement sub-) Role is secondary to the Procurement Process - Tertiary (Related) Role is not involved in the Procurement Process."@en ;
    skos:prefLabel "Agent In Role"@en .

epo:Documentation a owl:Class ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "Documentation"@en .

epo:ProcurementCriteriaSummary a owl:Class ;
    rdfs:isDefinedBy epo:core ;
    rdfs:subClassOf <http://data.europa.eu/m8g/Requirement> ;
    skos:definition "Overview of the Procurement Criteria."@en ;
    skos:historyNote "WG approval 19/03/2024"@en ;
    skos:prefLabel "Procurement Criteria Summary"@en .

epo:ProcurementCriterion a owl:Class ;
    rdfs:isDefinedBy epo:core ;
    rdfs:subClassOf <http://data.europa.eu/m8g/Criterion> ;
    skos:definition "A criterion specific to Procurement. Additional Information: This Procurement Criterion can be only Exclusion Ground, Selection Criterion or Award Criterion. Each of these Criteria can contain subcriteria (Criterion class)."@en ;
    skos:historyNote "WG Approval 23/04/2020"@en ;
    skos:prefLabel "Procurement Criterion"@en .

epo:ProcurementElement a owl:Class ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Gathering class for critical/central elements in the Procurement Process. TODO: add definition Additional information: Alias: ProcurementComponent"@en ;
    skos:prefLabel "Procurement Element"@en .

epo:SelectionCriteriaSummary a owl:Class ;
    rdfs:isDefinedBy epo:core ;
    rdfs:subClassOf epo:QualificationCriteriaSummary ;
    skos:definition "Overview of the Selection Criteria."@en ;
    skos:historyNote "WG approval 19/03/2024"@en ;
    skos:prefLabel "Selection Criteria Summary"@en .

epo:StatisticalInformation a owl:Class ;
    rdfs:isDefinedBy epo:core ;
    rdfs:subClassOf epo:ContextDescription ;
    skos:definition "Statistical data on the Procedure and the Lot. Additional Information At the present time Procurement Procedures are not fully electronic. At a later date, information on the Tenders received could be inferred by the data in the eProcurement System. Therefore this class is temporal and should cease to exist in fully electronic Procurement. The need for its presence responds also to the alignment with the Regulation (EU) 2019/1780 (eForms). Attention will have to be paid in the future to possible inconsistencies derived from data placed in other classes and data held in the Statistical Information class; e.g. the TenderEvaluation class (see eEvaluation diagram) has the attribute admissibileTender indicator, which in case of being false, may enter in contradiction with the highest or lowest Tender value for that very same inadmissible Tender."@en ;
    skos:historyNote "WG Approval 12/12/2019"@en ;
    skos:prefLabel "Statistical Information"@en .

epo:StrategicProcurement a owl:Class ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Public Procurement that contributes to achieving pressing policy goals. Additional Information: Specific strategic goals could be, for example, Environmental Protection, innovation, job creation and the development of small and medium enterprises. The subclasses are given by the choices in BT-06 Strategic Procurement. Based on https://legalinstruments.oecd.org/en/instruments/OECD-LEGAL-0411 (see paragraph on \"background information\"."@en ;
    skos:editorialNote "Used by eForms BG-713"@en ;
    skos:historyNote "WG Approval 10/03/2020"@en ;
    skos:prefLabel "Strategic Procurement"@en .

epo:Technique a owl:Class ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Method used for conducting Procurement Procedures. Several Techniques can be combined in one single Procurement Procedure (e.g. eAuction can be carried out in a Framework Agreement or DPS)."@en ;
    skos:editorialNote "Used by eForms BG-706"@en ;
    skos:historyNote "WG Approval 19/09/2019"@en ;
    skos:prefLabel "Technique"@en .

epo:Contract a owl:Class ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "A voluntary, deliberate, and legally binding agreement between two or more competent parties."@en ;
    skos:historyNote "WG approval 19/03/2024"@en ;
    skos:prefLabel "Contract"@en .

epo:OfferingParty a owl:Class ;
    rdfs:isDefinedBy epo:core ;
    rdfs:subClassOf epo:AgentInRole ;
    skos:definition "The Role of an Agent that acts on the Economic Operator side during a Procurement Process. Additional information: As per the European Procurement Directives the notion of ‘Economic Operators’ should be interpreted in a broad manner so as to include any Persons and/or Entities which offer the execution of works, the supply of products or the provision of services on the market, irrespective of the legal form under which they have chosen to operate. Thus, firms, branches, subsidiaries, partnerships, cooperative societies, limited companies, universities, public or private, and other forms of entities than natural Persons should all fall within the notion of Economic Operator, whether or not they are ‘Legal Persons’ in all circumstances."@en ;
    skos:prefLabel "Offering Party"@en .

epo:ContextDescription a owl:Class ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "A description concerning a Procurement Object or a Notice in a specific Situation Context. Additional Information: The description has its own identity (+I) but is dependent (+D) on the concerned Entity. We say that ContextDescription *concerns* an Entity."@en ;
    skos:prefLabel "Context Description"@en .

epo:MaskableObject a owl:Class ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "Maskable Object"@en .

epo:Term a owl:Class ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "A governing condition or stipulation."@en ;
    skos:prefLabel "Term"@en .

epo:AcquiringParty a owl:Class ;
    rdfs:isDefinedBy epo:core ;
    rdfs:subClassOf epo:AgentInRole ;
    skos:definition "The Role of an Agent that acts on the buying side of a Procurement Process."@en ;
    skos:prefLabel "Acquiring Party"@en .

epo:core a owl:Ontology ;
    rdfs:label "eProcurement Ontology - core"@en ;
    dcterms:created "2021-06-01"^^xsd:date ;
    dcterms:description "The eProcurement Ontology core describes the concepts and properties representing the European Public Procurement domain. The provision of these semantics offers the basis for a common understanding of the domain for all stakeholders ensuring the quality of data exchange and transparency. The ontology restrictions are published in a separate artefact."@en ;
    dcterms:issued "2025-06-04"^^xsd:date ;
    dcterms:license "© European Union, 2014. Unless otherwise noted, the reuse of the Ontology is authorised under the European Union Public Licence v1.2 (https://eupl.eu/)." ;
    dcterms:publisher "http://publications.europa.eu/resource/authority/corporate-body/PUBL" ;
    dcterms:title "eProcurement Ontology - core"@en ;
    vann:preferredNamespacePrefix "epo" ;
    vann:preferredNamespaceUri "http://data.europa.eu/a4g/ontology#" ;
    rdfs:comment "This version is automatically generated from ePO_core.xml on 2025-06-04" ;
    rdfs:seeAlso <https://docs.ted.europa.eu/home/index.html>,
        <https://github.com/OP-TED/ePO/releases>,
        <https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology/about>,
        <https://op.europa.eu/en/web/eu-vocabularies/e-procurement> ;
    owl:imports <http://data.europa.eu/eli/ontology#>,
        <http://data.europa.eu/m8g/>,
        dcterms:,
        skos:,
        <http://www.w3.org/2006/time>,
        <http://www.w3.org/ns/adms>,
        <http://www.w3.org/ns/locn>,
        org:,
        <http://www.w3.org/ns/person> ;
    owl:incompatibleWith "4.2.0" ;
    owl:priorVersion "http://data.europa.eu/a4g/ontology#core-5.0.0" ;
    owl:versionIRI epo:core-5.1.0 ;
    owl:versionInfo "5.1.0" .

