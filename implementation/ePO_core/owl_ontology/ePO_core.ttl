    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "refers To Lot"@en .

epo:refersToLotGroupAwardInformation a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "refers To Lot Group Award Information"@en .

epo:refersToNotice a owl:ObjectProperty ;
