    skos:historyNote "WG Approval 25/06/2024"@en ;
    skos:prefLabel "has Transport Handling Unit Quantity"@en .

epo:hasURL a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The identifier of a resource. Additional Information For example: 1. The URL of the system from where to access the procurement documents; 2. The URL of the system for the submission of tender documents; 3. The URL of the system from where to download a tool to communicate with the Buyer; 4. The URL of the system used by a Technique to allow Economic Operators to exchange information with the Buyer (e.g. eAuction and DPS Systems) 5. The URL of the system used to exchange information between Buyer and EO for questions and clarifications; (cccev:Evidence) The identifier of a resource. Additional Information For example: 1. The URL of the system from where to access the procurement documents; 2. The URL of the system for the submission of tender documents; 3. The URL of the system from where to download a tool to communicate with the Buyer; 4. The URL of the system used by a Technique to allow Economic Operators to exchange information with the Buyer (e.g. eAuction and DPS Systems) 5. The URL of the system used to exchange information between Buyer and EO for questions and clarifications; (epo:Fund)"@en ;
    skos:historyNote "WG Approval 30/09/2019"@en ;
    skos:prefLabel "has URL"@en .

epo:hasUUID a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "A universally unique identifier for an instance of this document."@en ;
    skos:historyNote "WG Approval 12/05/2020"@en ;
    skos:prefLabel "has UUID"@en .

epo:hasUnitCode a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Unit Code"@en .

epo:hasUnitDescription a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "A narrative explanation defining the units of items being counted Additional information: This could be for example individual items or pack or two. (epo:Quantity)"@en ;
    skos:historyNote "WG Approval 09/11/2021"@en ;
    skos:prefLabel "has Unit Description"@en .

epo:hasUnknownUsageOfSelectionCriterionType a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Unknown Usage Of Selection Criterion Type"@en .

epo:hasUnofficialLanguage a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The language translation(s) in which the instances of the given concepts are available. These linguistic versions are not an official translation, they are provided only for information."@en ;
    skos:prefLabel "has Unofficial Language"@en .

epo:hasUnverifiedTenders a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Offers received for which it has not been verified if they are admissible or inadmissible (e.g. because award criteria have been evaluated for all tenders and admissibility is checked only for the winning tender). (epo:SubmissionStatisticalInformation)"@en ;
    skos:historyNote "WG Approval 28/07/2020"@en ;
    skos:prefLabel "has Unverified Tenders"@en .

epo:hasValidityPeriod a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
