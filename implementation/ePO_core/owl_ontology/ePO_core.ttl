    skos:prefLabel "has Award Status"@en .

epo:hasAwardedValue a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The value of the procurement provided by the Award Decision. Additional Information: Different cases of awarded values may refer to a lot, the global value of the procedure, or of a combinatorial value of a group of lots. In the case of framework agreements and dynamic purchasing systems this refers to the maximum awarded value."@en ;
    skos:historyNote "WG Approval 10/12/2019"@en ;
    skos:prefLabel "has Awarded Value"@en .

epo:hasBackorderQuantity a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Backorder Quantity"@en .

epo:hasBalanceAmount a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Balance Amount"@en .

epo:hasBankingIdentifier a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "An unique banking reference identifier of the Payee or Seller, assigned by the Payee or Seller bank."@en ;
    skos:historyNote "WG Approval 11/07/2024"@en ;
    skos:prefLabel "has Banking Identifier"@en .

epo:hasBargainPrice a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The value of procured supplies that have used a particularly advantageous opportunity available for a very short time at a value considerably lower than normal market prices."@en ;
    skos:historyNote "WG Approval 23/05/2023"@en ;
    skos:prefLabel "has Bargain Price"@en .

epo:hasBaseQuantity a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The quantity at which the net monetary value applies."@en ;
    skos:prefLabel "has Base Quantity"@en .

epo:hasBatchID a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The identifier assigned to a specific batch of the produced Item."@en ;
    skos:historyNote "WG Approval 16/05/2023"@en ;
    skos:prefLabel "has Batch ID"@en .

epo:hasBeneficialOwner a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "A role of any natural person(s) who ultimately owns or controls the organisation or on whose behalf a transaction or activity is being conducted. Additional Information: This role is defined in the directive EU 2015/849 and it's beyond the scope for public eProcurement domain."@en ;
    skos:historyNote "WG Approval 14/09/2021"@en ;
    skos:prefLabel "has Beneficial Owner"@en .

epo:hasBroadPlaceOfPerformance a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Geopolitical zone where the contract can be executed. Additional Information Used for setting restrictions that cannot be established with one country code or a geographical zone identifier (like NUTS), because they have a broader scope (geographical, economic, political, other)."@en ;
    skos:prefLabel "has Broad Place Of Performance"@en .

epo:hasBusinessSize a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The category of the business depending on number of employees and turnover. Additional information: See Commission Recommendation of 6 May 2003 concerning the definition of micro, small and medium-sized enterprises."@en ;
    skos:prefLabel "has Business Size"@en .

epo:hasBuyerCategoryDescription a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "A classification of buyers participating in a framework agreement. Additional Information: Buyers that can use the Framework Agreement not mentioned by name. For example, the classification \"all hospitals in the Tuscany region\" is used instead of naming each individual buyer. (epo:FrameworkAgreementTerm)"@en ;
    skos:editorialNote "Used by eForms BT-111"@en ;
    skos:historyNote "WG Approval 06/05/2019"@en ;
    skos:prefLabel "has Buyer Category Description"@en .

epo:hasBuyerItemID a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The general identifier assigned to the concept as defined by the Buyer.​"@en ;
    skos:historyNote "WG Approval 16/05/2023"@en ;
    skos:prefLabel "has Buyer Item ID"@en .

epo:hasBuyerLegalType a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "A category that indicates the right of an Organisation to play the role of a buyer. Additional Information: The category also effects the rules that the buyer has to abide to within the public procurement procedure."@en ;
    skos:prefLabel "has Buyer Legal Type"@en .

epo:hasBuyerLegalTypeDescription a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Self-explanatory text about the Buyer Legal Type. Additional information: This field is used when the Buyer Legal Type is not available in the controlled list at-voc:buyer-legal-type . This is necessary in to cover data provided in the TED Standard Forms. It shall be deprecated in the future. (org:Organization)"@en ;
    skos:historyNote "WG Approval 06/09/2022"@en ;
    skos:prefLabel "has Buyer Legal Type Description"@en .

epo:hasBuyerProfile a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Website address where the buyer publishes information on its procurement procedures and general information. (epo:Buyer)"@en ;
    skos:editorialNote "Used by eForms BT-508"@en ;
    skos:historyNote "WG approval 04/05/2018"@en ;
    skos:prefLabel "has Buyer Profile"@en .

epo:hasCalculationBasedOn a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Calculation Based On"@en .

epo:hasCalculationMethod a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Formula for obtaining values. Additional Information: The possible values are monetary values, ranking scores, criterion weighting. (epo:ConcessionEstimate)"@en ;
    skos:historyNote "WG Approval 25/05/2018"@en ;
    skos:prefLabel "has Calculation Method"@en .

epo:hasCatalogueLineValidity a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The relation indicating until when a Catalogue Line instance is applicable."@en ;
    skos:historyNote "WG Approval 21/09/2023"@en ;
    skos:prefLabel "has Catalogue Line Validity"@en .

epo:hasCertification a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Relation to the proof of conformance."@en ;
    skos:historyNote "WG Approval 30/05/2023"@en ;
    skos:prefLabel "has Certification"@en .

epo:hasCertificationNumber a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The unique identifier of the certificate. (epo:Certificate)"@en ;
    skos:historyNote "WG Approval 26/07/2022"@en ;
    skos:prefLabel "has Certification Number"@en .

epo:hasChangeDescription a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Explanatory text about the instance of the concept. (epo:ChangeInformation)"@en ;
    skos:historyNote "WG Approval 30/09/2019"@en ;
    skos:prefLabel "has Change Description"@en .

epo:hasChangeJustification a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Code explaining the change."@en ;
    skos:prefLabel "has Change Justification"@en .

epo:hasChangeReasonDescription a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Explanatory text about why the element is altered. (epo:ChangeInformation)"@en ;
    skos:editorialNote "Used by eForms BT-762"@en ;
    skos:prefLabel "has Change Reason Description"@en .

epo:hasCleanVehicles a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The number of all clean vehicles that have either been purchased, leased, rented, hired-purchased or their use has been contractually committed to for the provision of a purchased service. Additional Information: In the European Union, the legal requirements and scope for the provision of these vehicles or services are covered by Directive 2009/33/EC. (epo:CleanVehicleDirectiveInformation)"@en ;
    skos:historyNote "WG Approval 28/07/2020"@en ;
    skos:prefLabel "has Clean Vehicles"@en .

epo:hasConcessionEstimatedValue a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Concession Estimated Value"@en .

epo:hasConditionVerificationMethod a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Means used to validate the qualification requirements. (epo:QualificationCriteriaSummary)"@en ;
    skos:historyNote "WG Approval 02/05/2024"@en ;
    skos:prefLabel "has Condition Verification Method"@en .

epo:hasConfidentialityJustification a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "A narrative explanation of why data is not published. Additional Information: This element is generally used when the non-publication-justification code chosen is \"other\". (epo:NonPublishedInformation)"@en ;
    skos:historyNote "WG Approval 09/11/2021"@en ;
    skos:prefLabel "has Confidentiality Justification"@en .

epo:hasConfirmedIrregularityType a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Confirmed Irregularity Type"@en .

epo:hasConsigneeConsignmentID a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The identifier of the the Consignment given by the Consignee."@en ;
    skos:historyNote "WG Approval 10/06/2024"@en ;
    skos:prefLabel "has Consignee Consignment ID"@en .

epo:hasConstraint a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Constraint"@en .

epo:hasContactName a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "A short text by which a contact is known or referred to. (cpov:ContactPoint)"@en ;
    skos:historyNote "WG Approval: 27/01/2022"@en ;
    skos:prefLabel "has Contact Name"@en .

epo:hasContactPointInRole a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Contact Point In Role"@en .

epo:hasContractConclusionDate a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The date the contract was signed by the last signatory party. <u>Additional Information:</u> In exceptional cases contracts may be concluded without signature and therefore another date may be used. The date of contract conclusion is always later than the end of any standstill period. This concept is not to be confused with the date of completion/end of the contract. (epo:Contract)"@en ;
    skos:editorialNote "Used by eForms BT-145"@en ;
    skos:historyNote "WG Approval 09/01/2020"@en ;
    skos:prefLabel "has Contract Conclusion Date"@en .

epo:hasContractNatureType a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Subject of the acquisition."@en ;
    skos:prefLabel "has Contract Nature Type"@en .

epo:hasContractValue a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Contract Value"@en .

epo:hasCountryCode a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Country Code"@en .

epo:hasCountryOfBirth a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The country in which the Person was born."@en ;
    skos:prefLabel "has Country Of Birth"@en .

epo:hasCountryOfOrigin a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The source country of the product or service. Additional Information: The country of origin can be provided by the buyer as a requirement or by the tenderer information of the item to be provided."@en ;
    skos:prefLabel "has Country Of Origin"@en .

epo:hasCreditAmount a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Credit Amount"@en .

epo:hasCrossBorderLaw a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The applicable law when buyers from different countries procure together within one procurement procedure. (epo:ProcedureTerm)"@en ;
    skos:editorialNote "Used by eForms BT-09"@en ;
    skos:prefLabel "has Cross Border Law"@en .

epo:hasCurrency a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The identifier of the currency as in the standard code list used."@en ;
    skos:prefLabel "has Currency"@en .

epo:hasCurrencyCodeListAgencyID a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Identifier of the agency that maintains the currency code list used. (epo:MonetaryValue)"@en ;
    skos:historyNote "WG Approval 13/04/2021"@en ;
    skos:prefLabel "has Currency Code List Agency ID"@en .

epo:hasCurrencyCodeListAgencyName a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Name of the agency that maintains the currency code list used. (epo:MonetaryValue)"@en ;
    skos:historyNote "WG Approval 13/04/2021"@en ;
    skos:prefLabel "has Currency Code List Agency Name"@en .

epo:hasCurrencyCodeListID a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Concept scheme URI used for the currency code list. (epo:MonetaryValue)"@en ;
    skos:historyNote "WG Approval 13/04/2021"@en ;
    skos:prefLabel "has Currency Code List ID"@en .

epo:hasCustomerReference a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "An identifier assigned by the Buyer used for internal routing purposes."@en ;
    skos:historyNote "WG Approval 04/03/2025"@en ;
    skos:prefLabel "has Customer Reference"@en .

epo:hasDPSScope a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Explanation as to whether a dps is used and by whom. The codelist to be used is at-voc:dps-usage which is available at http://publications.europa.eu/resource/dataset/dps-usage"@en ;
    skos:prefLabel "has DPS Scope"@en .

epo:hasDeadline a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The time limit by which the security clearance must be submitted to the buyer. (epo:SecurityClearanceTerm)"@en ;
    skos:historyNote "WG Approval 02/05/2024"@en ;
    skos:prefLabel "has Deadline"@en .

epo:hasDebitAmount a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Debit Amount"@en .

epo:hasDebitedAccountIdentifier a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "An identifier for the account to be debited by the direct debit."@en ;
    skos:historyNote "WG Approval 11/07/2024"@en ;
    skos:prefLabel "has Debited Account Identifier"@en .

epo:hasDeclaredStatisticalValue a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The Monetary Value declared for statistical purposes."@en ;
    skos:historyNote "WG Approval 10/06/2024"@en ;
    skos:prefLabel "has Declared Statistical Value"@en .

epo:hasDeliveryLocation a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Location delivery area where the Item can be ordered to the given price."@en ;
    skos:prefLabel "has Delivery Location"@en .

epo:hasDeliveryPeriod a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Delivery Period"@en .

epo:hasDescriptionOfPrizes a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Explanatory text about Prizes. (epo:DesignContestRegimeTerm)"@en ;
    skos:historyNote "WG Approval 26/03/2024"@en ;
    skos:prefLabel "has Description Of Prizes"@en .

epo:hasDespatchPeriod a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The time period when the Despatcher picks-up the Goods Items to be delivered."@en ;
    skos:historyNote "WG Approval 16/07/2024"@en ;
    skos:prefLabel "has Despatch Period"@en .

epo:hasDespatchedQuantity a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The Quantity that has been sent."@en ;
    skos:historyNote "WG Approval 18/06/2024"@en ;
    skos:prefLabel "has Despatched Quantity"@en .

epo:hasDespatcherConsignmentID a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The identifier of the the Consignment given by the Despatcher."@en ;
    skos:historyNote "WG Approval 10/06/2024"@en ;
    skos:prefLabel "has Despatcher Consignment ID"@en .

epo:hasDestinationCountryCode a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Destination Country Code"@en .

epo:hasDirectAwardJustification a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "List of reasons for using a procedure which allows awarding contracts directly without publishing a notice."@en ;
    skos:prefLabel "has Direct Award Justification"@en .

epo:hasDispatchDate a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Date and time of transmission of a record to an Organization. (epo:Document)"@en ;
    skos:historyNote "WG Approval 31/08/2023"@en ;
    skos:prefLabel "has Dispatch Date"@en .

epo:hasDocumentRestrictionJustification a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "An explanation about the reasons why some procurement documents are restricted."@en ;
    skos:prefLabel "has Document Restriction Justification"@en .

epo:hasDocumentType a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Document Type"@en .

epo:hasDurationExtensionJustification a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The explanation of the reason why the framework agreement has an extended duration. Additional Information: The justification for exceptional cases when the duration of the framework agreement exceeds the legal limits. Four years in the case of the general procurement Directive, seven years in the case of the defence Directive, and eight years in the case of the sectoral Directive. (epo:FrameworkAgreementTerm)"@en ;
    skos:editorialNote "Used by eForms BT-109"@en ;
    skos:historyNote "WG Approval 26/09/2019"@en ;
    skos:prefLabel "has Duration Extension Justification"@en .

epo:hasEAuctionURL a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The internet address of the electronic auction. (epo:SubmissionTerm)"@en ;
    skos:editorialNote "Used by eForms BT-123"@en ;
    skos:prefLabel "has E Auction URL"@en .

epo:hasECataloguePermission a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The extent to which electronic catalogues may be used in tenders."@en ;
    skos:prefLabel "has E Catalogue Permission"@en .

epo:hasEEAReceivedTenders a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The amount of tenders received from economic operators in other EEA countries other than the country of the buyer. (epo:SubmissionStatisticalInformation)"@en ;
    skos:historyNote "WG Approval 12/12/2019"@en ;
    skos:prefLabel "has EEA Received Tenders"@en .

epo:hasEInvoicing a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Electronic means will be used for invoicing in the post-award process. Additional Information: This attribute is used for standard form mappings. (epo:ContractTerm)"@en ;
    skos:historyNote "WG Approval 12/09/2019"@en ;
    skos:prefLabel "has E Invoicing"@en .

epo:hasEInvoicingPermission a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has E Invoicing Permission"@en .

epo:hasEOrdering a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Electronic means will be used for requesting and purchasing in the post-award process. (epo:ContractTerm)"@en ;
    skos:historyNote "WG Approval 12/09/2019"@en ;
    skos:prefLabel "has E Ordering"@en .

epo:hasEPayment a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Electronic means must be used for paying. (epo:ContractTerm)"@en ;
    skos:historyNote "WG Approval 09/11/2021"@en ;
    skos:prefLabel "has E Payment"@en .

epo:hasESenderDispatchDate a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The date and time the notice was transmitted electronically by the eSender to the Publications Office of the European Union. Additional Information: Typically, eSenders include national Official Journals, Buyers sending a large number of electronic Notices, public or private bodies acting on behalf of Buyers and eProcurement software developers. (epo:Notice)"@en ;
    skos:historyNote "WG approval 20/06/2023"@en ;
    skos:prefLabel "has E Sender Dispatch Date"@en .

epo:hasESubmissionPermission a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The requirements as to what extent electronic submission is allowed."@en ;
    skos:prefLabel "has E Submission Permission"@en .

epo:hasEUReceivedTenders a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The amount of tenders received from economic operators in other EU countries other than the country of the buyer. (epo:SubmissionStatisticalInformation)"@en ;
    skos:prefLabel "has EU Received Tenders"@en .

epo:hasElectronicDigest a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Electronic Digest"@en .

epo:hasElectronicSignature a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Electronic Signature"@en .

epo:hasElectronicSubmission a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Transmission of tenders is possible by electronic means of communication. (epo:Tender)"@en ;
    skos:prefLabel "has Electronic Submission"@en .

epo:hasElectronicTenders a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Electronic Tender Lots received. (epo:SubmissionStatisticalInformation)"@en ;
    skos:historyNote "WG Approval 28/07/2020"@en ;
    skos:prefLabel "has Electronic Tenders"@en .

epo:hasElementReference a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Reference to the class instance in the current notice. (epo:ReviewInformation)"@en ;
    skos:editorialNote "Used by eForms BT-13716, eForms BT-786, eForms BT-1501"@en ;
    skos:prefLabel "has Element Reference"@en .

epo:hasEndpointIdentifier a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Endpoint Identifier"@en .

epo:hasEnergyEfficiencyLabel a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Energy Efficiency Label"@en .

epo:hasEntryIntoForceDate a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The date on which the contract enters into force. Additional information: This is generally the date on which the fulfillment of the contract begins. (epo:Contract)"@en ;
    skos:historyNote "WG Approval 05/11/2019"@en ;
    skos:prefLabel "has Entry Into Force Date"@en .

epo:hasEstimatedBuyerConcessionRevenue a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The expected payments made by the buyer to the economic operator awarded the concession that are not directly related to the use of the concession. <u>Additional Information:</u> For example the public buyer pays a yearly fee to provide a ticketing solution to the public. The fee the public pays for every ticket sold through the solution is not included in this estimation but in the estimation of the user concession revenue."@en ;
    skos:editorialNote "Used by eForms BT-160"@en ;
    skos:historyNote "WG Approval 07/01/2020"@en ;
    skos:prefLabel "has Estimated Buyer Concession Revenue"@en .

epo:hasEstimatedContractNoticePublicationDate a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Foreseen date for publication of Contract Notice. (epo:ProcessPlanningTerm)"@en ;
    skos:editorialNote "Used by eForms BT-127"@en ;
    skos:prefLabel "has Estimated Contract Notice Publication Date"@en .

epo:hasEstimatedDeliveryPeriod a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The forecasted time period given by the Despatcher to provide the goods and services."@en ;
    skos:historyNote "WG Approval 18/06/2024"@en ;
    skos:prefLabel "has Estimated Delivery Period"@en .

epo:hasEstimatedDuration a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Relation indicating a Dynamic Purchase System has an estimated Duration."@en ;
    skos:historyNote "WG Approval 28/11/2024"@en ;
    skos:prefLabel "has Estimated Duration"@en .

epo:hasEstimatedInvitationToExpressInterestDate a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The estimated date of dispatch of the invitations to confirm interest. (epo:MultipleStageProcedureTerm)"@en ;
    skos:editorialNote "Used by eForms BT-631"@en ;
    skos:prefLabel "has Estimated Invitation To Express Interest Date"@en .

epo:hasEstimatedInvitationToTenderDate a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The estimated date of dispatch of the invitations to submit tenders in two (or more) stage procedures. (epo:MultipleStageProcedureTerm)"@en ;
    skos:editorialNote "Used by eForms BT-130"@en ;
    skos:historyNote "WG Approval 01/10/2019"@en ;
    skos:prefLabel "has Estimated Invitation To Tender Date"@en .

epo:hasEstimatedPercentage a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The estimated proportion foreseen to be subcontracted. (epo:SubcontractingEstimate)"@en ;
    skos:historyNote "WG Approval 07/01/2020"@en ;
    skos:prefLabel "has Estimated Percentage"@en .

epo:hasEstimatedTenderInvitationDate a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The planned date for the dispatch of the invitations to submit tenders. (epo:ProcessPlanningTerm)"@en ;
    skos:historyNote "WG Approval 09/11/2021"@en ;
    skos:prefLabel "has Estimated Tender Invitation Date"@en .

epo:hasEstimatedTotalSubcontracts a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The estimated amount of work to be subcontracted in the contract resulting from the lot. (epo:SubmissionStatisticalInformation)"@en ;
    skos:historyNote "WG Approval 09/11/2021"@en ;
    skos:prefLabel "has Estimated Total Subcontracts"@en .

epo:hasEstimatedUserConcessionRevenue a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The estimated revenue coming from the use of the concession. Additional Information: Revenues are for example fees and fines. For example, the fees and fines coming from the cars using a motorway."@en ;
    skos:editorialNote "Used by eForms BT-162"@en ;
    skos:prefLabel "has Estimated User Concession Revenue"@en .

epo:hasEstimatedValidityPeriod a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Estimated Validity Period"@en .

epo:hasEstimatedValue a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "A forecast of the value of the procurement before competition. Additional Information: Different cases of estimated values may refer to a lot, the global value of the procedure, or of a combinatorial value of a group of lots. The forecast is calculated by the buyer and covers all revenues whether coming from the buyer or third parties. See for example recital (19), Article 5 of Directive 2014/24/EU and other articles from the rest of Directives about procurement. In the case of framework agreements and dynamic purchasing systems this refers to the maximum estimated value."@en ;
    skos:editorialNote "Used by eForms BT-27, can be used for BT-157"@en,
        "Used by eForms BT-27,eForms BT-157"@en ;
    skos:historyNote "WG Approval 05/12/2019"@en ;
    skos:prefLabel "has Estimated Value"@en .

epo:hasExclusionGroundType a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Exclusion Ground Type"@en .

epo:hasExpectedDeliveryTime a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The expected amount of time between the order and delivery of an item."@en ;
    skos:historyNote "WG Approval 26/07/2022"@en ;
    skos:prefLabel "has Expected Delivery Time"@en .

epo:hasExtension a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Extension"@en .

epo:hasFax a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The fax number used to reach a person or an organisation. (cpov:ContactPoint)"@en ;
    skos:prefLabel "has Fax"@en .

epo:hasFinancialOfferValue a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The value offered by the Tenderer for a Lot. Additional Information: This value is normally the one awarded for a winning Tender Lot. In case of negotiated procedures the original financial value may be reviewed and the offer updated."@en ;
    skos:editorialNote "Used by eForms BT-720"@en ;
    skos:prefLabel "has Financial Offer Value"@en .

epo:hasFixedValue a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:editorialNote "Used by eForms BT-541, eForms BT-5422"@en ;
    skos:prefLabel "has Fixed Value"@en .

epo:hasFixedValueType a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The method to interpret the fixed value as pertaining to a total or unit."@en ;
    skos:prefLabel "has Fixed Value Type"@en .

epo:hasFollowupContract a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Any subsequent service contract will be awarded to the winner or, in the case of a design contest, winners. (epo:DesignContestRegimeTerm)"@en ;
    skos:historyNote "WG Approval 29/08/2019"@en ;
    skos:prefLabel "has Followup Contract"@en .

epo:hasFollowupContractInformation a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Further information about follow-up contracts, prizes and payments (for example non-monetary prizes, payments given for participation). (epo:DesignContestRegimeTerm)"@en ;
    skos:historyNote "WG Approval 03/09/2019"@en ;
    skos:prefLabel "has Followup Contract Information"@en .

epo:hasFormNumber a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The number of the form used to create the Standard Form Notice and not an eForms Notice. (epo:Notice)"@en ;
    skos:historyNote "WG approval 26/03/2024"@en ;
    skos:prefLabel "has Form Number"@en .

epo:hasFormType a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "A categorisation of the steps in which the Notice is used."@en ;
    skos:prefLabel "has Form Type"@en .

epo:hasFormula a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The mathematical equation or any other description used for complicated weighing of criteria (e.g. non-linear weighing, the analytic hierarchy process) when a weighing cannot be expressed per criterion. (epo:ProcurementCriterion)"@en ;
    skos:editorialNote "Used by eForms BT-543"@en ;
    skos:prefLabel "has Formula"@en .

epo:hasFrameworkAgreementMaximumValue a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Framework Agreement Maximum Value"@en .

epo:hasFrameworkAgreementType a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The form of framework agreement used in a procurement procedure. Addition information: A concept to distinguish the different types of framework agreement, which are: 1. Framework agreement without reopening of competition, 2. Framework agreement with reopening of competition, or 3. Framework agreement partly without reopening of competition."@en ;
    skos:prefLabel "has Framework Agreement Type"@en .

epo:hasFundProgramme a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Fund Programme"@en .

epo:hasGrossMonetaryValue a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Gross Monetary Value"@en .

epo:hasGrossVolume a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The amount of space that is required including the packaging."@en ;
    skos:historyNote "WG Approval 18/06/2024"@en ;
    skos:prefLabel "has Gross Volume"@en .

epo:hasGrossWeight a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The total mass of goods including the packaging."@en ;
    skos:historyNote "WG Approval 18/06/2024"@en ;
    skos:prefLabel "has Gross Weight"@en .

epo:hasGroupFrameworkAgreementMaximumValue a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:editorialNote "Used by eForms BT-156"@en ;
    skos:prefLabel "has Group Framework Agreement Maximum Value"@en .

epo:hasGroupLotEvaluationMethod a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Description of how lots and groups of lots are evaluated against one another in the procedure. (epo:ProcedureTerm)"@en ;
    skos:prefLabel "has Group Lot Evaluation Method"@en .

epo:hasGroupType a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Form of collaboration agreement between organisations. Additional Information: This is not a legal type; not to be mistaken with epo:hasLegalFormType which may also be used for Organisation Groups. (epo:OrganisationGroup)"@en ;
    skos:historyNote "WG Approval 09/11/2021"@en ;
    skos:prefLabel "has Group Type"@en .

epo:hasGuaranteeDescription a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Information on the financial commitment required from the economic operator. Additional Information: 1. This information may include the amount and the way of delivering of the guarantee 2. The financial commitment may be retained by the buyer in the case the tenderer withdraws the submitted information (i.e. tender, expression of interest and request for participation, but not request for clarifications) before the award of the contract or does not sign the contract. 3. Usual modalities are bonds, cheques, loans, other. (epo:SubmissionTerm)"@en ;
    skos:historyNote "WG Approval 21/07/20"@en ;
    skos:prefLabel "has Guarantee Description"@en .

epo:hasHazardousClassID a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Specification of the hazardous nature of an item according to a classification schema. Provides detail of the classification and nature of a hazardous item."@en ;
    skos:prefLabel "has Hazardous Class ID"@en .

epo:hasHeight a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The vertical measurement."@en ;
    skos:historyNote "WG Approval 18/06/2024"@en ;
    skos:prefLabel "has Height"@en .

epo:hasHighestReceivedTenderValue a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Amount of the Tender with the highest value. Additional Information The value must correspond to an admissible tender. For example, tenders compliant with the procurement document requirements, not having an abnormally low price or cost, etc."@en ;
    skos:historyNote "WG Approval 12/12/2019"@en ;
    skos:prefLabel "has Highest Received Tender Value"@en .

epo:hasInadmissibleTenders a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Tenders received that cannot be awarded due to non-compliance to procurement document requirements or having an abnormally low price or cost. <u>Additional Information: </u> Non-compliance with a Procurement Document requirements include exclusion grounds, selection criteria and submission deadline, etc. (epo:SubmissionStatisticalInformation)"@en ;
    skos:historyNote "WG Approval 12/12/2019"@en ;
    skos:prefLabel "has Inadmissible Tenders"@en .

epo:hasInternalIdentifier a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:editorialNote "Used by eForms BT-22"@en ;
    skos:prefLabel "has Internal Identifier"@en .

epo:hasInternationalProcurementInstrumentExceptionInformation a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has International Procurement Instrument Exception Information"@en .

epo:hasInternetAddress a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The main web page used by the instance of the concept. (org:Organization) The main web page used by the instance of the concept. (cpov:ContactPoint)"@en ;
    skos:historyNote "WG Approval 01/06/2023"@en ;
    skos:prefLabel "has Internet Address"@en .

epo:hasInvoiceLineObjectIdentifier a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "An identifier for an object on which the invoice line is based, given by the Seller. Additional Information: It may be a subscription number, telephone number, meter point etc., as applicable."@en ;
    skos:historyNote "WG Approval 26/06/2024"@en ;
    skos:prefLabel "has Invoice Line Object Identifier"@en .

epo:hasInvoiceLinePeriod a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Invoice Line Period"@en .

epo:hasInvoicedObjectIdentifier a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "An identifier for an object on which the invoice is based, given by the Seller."@en ;
    skos:prefLabel "has Invoiced Object Identifier"@en .

epo:hasInvoicingPeriod a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Invoicing Period"@en .

epo:hasIrregularityType a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Irregularity Type"@en .

epo:hasItemClassificationIdentifier a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Item Classification Identifier"@en .

epo:hasItemConsumption a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Item Consumption"@en .

epo:hasItemConsumptionSavings a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Item Consumption Savings"@en .

epo:hasItemCountryOfOrigin a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The source country of the product or service. Additional Information: The country of origin can be provided by the buyer as a requirement or by the tenderer information of the item to be provided. The codelist to be used is at-voc:country which is available at http://publications.europa.eu/resource/dataset/country"@en ;
    skos:prefLabel "has Item Country Of Origin"@en .

epo:hasItemStandardID a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The general identifier assigned to the concept based on a standard scheme.​ Additional information: For example the GTIN scheme (Global Trade Item Number)."@en ;
    skos:historyNote "WG Approval 16/05/2023"@en ;
    skos:prefLabel "has Item Standard ID"@en .

epo:hasJuryMember a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "An agent involved in an evaluation board."@en ;
    skos:historyNote "WG Approval 14/09/2021"@en ;
    skos:prefLabel "has Jury Member"@en .

epo:hasJustification a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "An explanation about the reasons for using the concept. (epo:DirectAwardTerm)"@en ;
    skos:historyNote "WG Approval 05/11/2019"@en ;
    skos:prefLabel "has Justification"@en .

epo:hasLabelType a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The label type such environmental, quality, social etc."@en ;
    skos:prefLabel "has Label Type"@en .

epo:hasLanguage a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Language in which the submitted information is to be expressed."@en ;
    skos:prefLabel "has Language"@en .

epo:hasLateSubmissionInformationDescription a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "A narrative text explaining the content of the economic operator information that can be submitted late. Additional Information This does not apply to requests for clarifications. (epo:SubmissionTerm)"@en ;
    skos:prefLabel "has Late Submission Information Description"@en .

epo:hasLateSubmissionPermission a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Whether economic operator-related information can be supplemented even after the submission deadline. Additional Information This is specific to the information on the economic operator and not the actual offer. This does not apply to the requests for clarification."@en ;
    skos:prefLabel "has Late Submission Permission"@en .

epo:hasLaunchFrameworkAgreementMaximumValue a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Launch Framework Agreement Maximum Value"@en .

epo:hasLegalBasis a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The legal basis under which the procurement procedure takes place. Additional Information: For example European Directives or Regulations, national laws etc. The recommended code list is the example for the legal basis at the European level."@en ;
    skos:prefLabel "has Legal Basis"@en .

epo:hasLegalBasisDescription a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Explanatory text about the legal basis. (epo:ProcurementElement)"@en ;
    skos:historyNote "WG Approval 02/05/2024"@en ;
    skos:prefLabel "has Legal Basis Description"@en .

epo:hasLegalFormRequirement a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The legal form to be taken by a Contractor. Additional Information: Generally, this is defined to cover the case where an Organisation Group is involved. Note that the codelist provided at national level should be used. (epo:ContractTerm)"@en ;
    skos:prefLabel "has Legal Form Requirement"@en .

epo:hasLegalFormType a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The classification of an Organisation according to legislation. Additional Information: Generally, this is defined for Tenderers who want to submit as an Organisation Group. Note that the codelist provided at national level should be used. (org:Organization)"@en ;
    skos:prefLabel "has Legal Form Type"@en .

epo:hasLegalIdentifier a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Legal Identifier"@en .

epo:hasLegalName a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The officially registered name of an organisation. (org:Organization)"@en ;
    skos:historyNote "WG Approval 10/01/2023"@en ;
    skos:prefLabel "has Legal Name"@en .

epo:hasLength a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The horizontal measurement. Additional Information: The length is the longer side between the length and the width."@en ;
    skos:historyNote "WG Approval 18/06/2024"@en ;
    skos:prefLabel "has Length"@en .

epo:hasLoadingMeter a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The area of the Consignment in meters divided by the width of the truck, which is considered to be 2.4 meters."@en ;
    skos:historyNote "WG Approval 18/06/2024"@en ;
    skos:prefLabel "has Loading Meter"@en .

epo:hasLotAwardCombination a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The contracting authority reserves the right to award contracts combining lots or groups of lots. Additional Information: This property contains information about the Lots concerned. This property is required by the regulation (EU)-2015-1986 (modeled in the TED Standard Forms). (epo:ProcedureTerm)"@en ;
    skos:historyNote "WG Approval 23/08/2022"@en ;
    skos:prefLabel "has Lot Award Combination"@en .

epo:hasLotReference a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Lot Reference"@en .

epo:hasLowestReceivedTenderValue a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Amount of the Tender with the lowest value. Additional Information The value must correspond to an admissible tender. For example, tenders compliant with the procurement document requirements, not having an abnormally low price or cost, etc."@en ;
    skos:historyNote "WG Approval 12/12/2019"@en ;
    skos:prefLabel "has Lowest Received Tender Value"@en .

epo:hasMainActivity a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The principal sectoral area in which an organisation operates. Additional information: The activities associated with buyers are derived from the top level of the Classification of the functions of the government (COFOG) from the United Nations Statistics Division. The activities associated with buyer are derived from sectors explicitly falling within the sectoral directive (2014/25/EU Art. 8 - Art. 14)."@en ;
    skos:prefLabel "has Main Activity"@en .

epo:hasMainActivityDescription a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Self-explanatory text about the Main Activity . Additional information: This field is used when the Main Activity is not available in the controlled list at-voc:main-activity-type . This is necessary in to cover data provided in the TED Standard Forms. It shall be deprecated in the future. (org:Organization)"@en ;
    skos:historyNote "WG Approval 06/09/2022"@en ;
    skos:prefLabel "has Main Activity Description"@en .

epo:hasMainClassification a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Main Classification"@en .

epo:hasMainFeature a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Main features of the procedure and information about where the full rules for the procedure can be found. Additional Information: This information should be given when the procedure is not one of those mentioned in the procurement directives. This can be the case for example for concessions, for social and other specific services, and in case of voluntary publication of procurement procedures below the EU procurement thresholds. (epo:Procedure)"@en ;
    skos:prefLabel "has Main Feature"@en .

epo:hasMandateIdentifier a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "An unique identifier for referencing the direct debit mandate, assigned by the Payee."@en ;
    skos:historyNote "WG Approval 11/07/2024"@en ;
    skos:prefLabel "has Mandate Identifier"@en .

epo:hasManufacturerID a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The manufacturer's identifier for the item."@en ;
    skos:prefLabel "has Manufacturer ID"@en .

epo:hasManufacturerItemID a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The general identifier assigned to the concept as defined by the Manufacturer. ​"@en ;
    skos:historyNote "WG Approval 16/05/2023"@en ;
    skos:prefLabel "has Manufacturer Item ID"@en .

epo:hasMaskableProperty a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Maskable Property"@en .

epo:hasMaximumFrameworkAgreementAwardedValue a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The maximum value which can be spent through all the framework agreements announced in this notice, including options and renewals of contracts. Additional information: The value provided is a threshold value that implicity means that it cannot be exceeded however it may not be reached during the execution of a contract. The Framework Agreements in a CAN are to be traced back and added to provide this value."@en ;
    skos:editorialNote "Used by eForms BT-118"@en ;
    skos:historyNote "WG Approval 03/12/2019"@en ;
    skos:prefLabel "has Maximum Framework Agreement Awarded Value"@en .

epo:hasMaximumLotSubmissionAllowed a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The total number of lots for which one Tenderer can submit Tenders. Additional information: This field is used to complement the SubmissionTerms (which are at the Lot level) for the Procedure level which is covered by the regulation (EU)-2015-1986 (modeled in the TED Standard Forms). (epo:ProcedureTerm)"@en ;
    skos:historyNote "WG Approval 12/12/2018"@en ;
    skos:prefLabel "has Maximum Lot Submission Allowed"@en .

epo:hasMaximumMeasure a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Maximum Measure"@en .

epo:hasMaximumNumberOfCandidates a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Maximum number of candidates to be invited for the second stage of the procedure. (epo:MultipleStageProcedureTerm)"@en ;
    skos:historyNote "WG Approval 22/08/2019"@en ;
    skos:prefLabel "has Maximum Number Of Candidates"@en .

epo:hasMaximumNumberOfLotsToBeAwarded a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The maximum number of lots for which contract(s) can be awarded to one tenderer. Additional information: This field is used to complement the SubmissionTerms (which are at the Lot level) for the Procedure level which is covered by the regulation (EU)-2015-1986 (modeled in the TED Standard Forms). (epo:ProcedureTerm)"@en ;
    skos:historyNote "WG Approval 22/08/2019"@en ;
    skos:prefLabel "has Maximum Number Of Lots To Be Awarded"@en .

epo:hasMaximumNumberOfRenewals a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The maximum number of times the contract can be renewed. Additional Information By renewing, the buyer reserves the right (i.e. not an obligation) to renew the contract (i.e. extend its duration) without a new procurement procedure. For example, a contract may be valid for one year and the buyer may keep a possibility to renew it (e.g. once, twice) for another three months, if he is content with the services he received. PLEASE REVIEW THIS DEFINITION AGAIN WITH THE WORKING GROUP. It was originally taken from eForms. (epo:ContractTerm)"@en ;
    skos:prefLabel "has Maximum Number Of Renewals"@en .

epo:hasMaximumOrderQuantity a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The maximum number of orderable units that can be ordered according to details provided in the catalogue line, such as price."@en ;
    skos:prefLabel "has Maximum Order Quantity"@en .

epo:hasMaximumParticipantsNumber a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The maximum number of participants in the framework agreement. Additional Information: Maximum number of tenderers who may be awarded a contract within the framework agreement. The number is a positive integer. (epo:FrameworkAgreementTerm)"@en ;
    skos:editorialNote "Used by eForms BT-113"@en ;
    skos:historyNote "WG Approval 05/02/2019"@en ;
    skos:prefLabel "has Maximum Participants Number"@en .

epo:hasMaximumShare a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The maximum proportion of something to be distributed. Additional Information: In the case of subcontracting the share may refer to the proportion of works, services or supplies being subcontracted. (epo:SubcontractTerm)"@en ;
    skos:historyNote "WG Approval 17/09/2019 "@en ;
    skos:prefLabel "has Maximum Share"@en .

epo:hasMaximumTemperature a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The highest tolerated temperature."@en ;
    skos:historyNote "WG Approval 18/06/2024"@en ;
    skos:prefLabel "has Maximum Temperature"@en .

epo:hasMaximumValue a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Maximum Value"@en .

epo:hasMeasure a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Measure"@en .

epo:hasMediumTenderPerLots a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Tenders from medium-sized enterprise. <u>Additional Information:</u> See Commission Recommendation 2003/361/EC. (epo:SubmissionStatisticalInformation)"@en ;
    skos:prefLabel "has Medium Tender Per Lots"@en .

epo:hasMember a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Member"@en .

epo:hasMinimumMeasure a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Minimum Measure"@en .

epo:hasMinimumNumberOfCandidates a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Minimum number of candidates to be invited for the second stage of the procedure. (epo:MultipleStageProcedureTerm)"@en ;
    skos:historyNote "WG Approval 22/08/2019"@en ;
    skos:prefLabel "has Minimum Number Of Candidates"@en .

epo:hasMinimumQuantityGuaranteedForDelivery a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The minimum quantity of an item that is guaranteed by the seller to be delivered."@en ;
    skos:prefLabel "has Minimum Quantity Guaranteed For Delivery"@en .

epo:hasMinimumShare a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The minimum proportion of something to be distributed. Additional Information: In the case of subcontracting the share may refer to the proportion of works, services or supplies being subcontracted. (epo:SubcontractTerm)"@en ;
    skos:historyNote "WG Approval 17/09/2019"@en ;
    skos:prefLabel "has Minimum Share"@en .

epo:hasMinimumSubcontractorsProposedObligation a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The minimum percentage of the contract value that the contractor must subcontract. Additional information: This is used for the competitive procedure described in Title III of Directive 2009/81/EC. (epo:SubcontractTerm)"@en ;
    skos:historyNote "WG Approval 09/11/2021"@en ;
    skos:prefLabel "has Minimum Subcontractors Proposed Obligation"@en .

epo:hasMinimumTemperature a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The lowest tolerated temperature."@en ;
    skos:historyNote "WG Approval 18/06/2024"@en ;
    skos:prefLabel "has Minimum Temperature"@en .

epo:hasMinimumValue a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Minimum Value"@en .

epo:hasModificationJustification a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Explanation of why a contract was modified. The codelist to be used is at-voc:modification-justification which is available at http://publications.europa.eu/resource/dataset/modification-justification"@en ;
    skos:prefLabel "has Modification Justification"@en .

epo:hasNationalProcedureRules a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The resource identifier where the information about the national rules applicable to the procedure can be found. (epo:ProcedureTerm)"@en ;
    skos:historyNote "WG Approval 02/05/2024"@en ;
    skos:prefLabel "has National Procedure Rules"@en .

epo:hasNationality a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Nationality"@en .

epo:hasNetAmount a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Net Amount"@en .

epo:hasNetMonetaryValue a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Net Monetary Value"@en .

epo:hasNetQuantity a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The net quantity of the item that is contained in each consumable unit, excluding any packaging materials."@en ;
    skos:prefLabel "has Net Quantity"@en .

epo:hasNetVolume a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The amount of space that is required without the packaging."@en ;
    skos:historyNote "WG Approval 18/06/2024"@en ;
    skos:prefLabel "has Net Volume"@en .

epo:hasNetWeight a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The total mass of goods without the packaging."@en ;
    skos:historyNote "WG Approval 18/06/2024"@en ;
    skos:prefLabel "has Net Weight"@en .

epo:hasNoNegotiationNecessary a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The buyer reserves the right to award the contract on the basis of the initial tenders without any further negotiations. Additional information: See Article 29(4) of Directive 2014/24/EU. (epo:MultipleStageProcedureTerm)"@en ;
    skos:prefLabel "has No Negotiation Necessary"@en .

epo:hasNonAccessibilityCriterionJustification a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Reason for not applying accessibility criteria. (epo:SocialProcurement)"@en ;
    skos:editorialNote "Used by eForms BT-755"@en ;
    skos:historyNote "WG Approval 05/03/2019"@en ;
    skos:prefLabel "has Non Accessibility Criterion Justification"@en .

epo:hasNonAwardJustification a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "On hold; Enumeration."@en ;
    skos:prefLabel "has Non Award Justification"@en .

epo:hasNonAwardedContractNumber a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The number the contract would have had if it had been awarded. Additional information: This field is provided to support the data provided in the TED Standard Forms, and it should be discontinued in the future. (epo:LotAwardOutcome)"@en ;
    skos:historyNote "WG Approval 06/09/2022"@en ;
    skos:prefLabel "has Non Awarded Contract Number"@en .

epo:hasNonAwardedContractTitle a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The title the contract would have had if it had been awarded. Additional information: This field is provided to support the data provided in the TED Standard Forms, and it should be discontinued in the future. (epo:LotAwardOutcome)"@en ;
    skos:historyNote "WG Approval 06/09/2022"@en ;
    skos:prefLabel "has Non Awarded Contract Title"@en .

epo:hasNonEEAReceivedTenders a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The amount of tenders received from economic operators in non-EEA countries. (epo:SubmissionStatisticalInformation)"@en ;
    skos:historyNote "WG Approval 12/12/2019"@en ;
    skos:prefLabel "has Non EEA Received Tenders"@en .

epo:hasNonEUReceivedTenders a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The amount of tenders received from economic operators in non-EU countries. (epo:SubmissionStatisticalInformation)"@en ;
    skos:prefLabel "has Non EU Received Tenders"@en .

epo:hasNonElectronicSubmissionDescription a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Textual explanation of how non-electronic information is to be presented. (epo:SubmissionTerm)"@en ;
    skos:historyNote "WG Approval 21/07/2020"@en ;
    skos:prefLabel "has Non Electronic Submission Description"@en .

epo:hasNonElectronicSubmissionJustification a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Reason for not accepting electronic information."@en ;
    skos:prefLabel "has Non Electronic Submission Justification"@en .

epo:hasNonPublicationJustification a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The reason why data is not published."@en ;
    skos:prefLabel "has Non Publication Justification"@en .

epo:hasNoticePublicationNumber a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The identifier of the published Notice. Additional information: The format of this identifier is XXXXXXXX-YYYY. (epo:Notice)"@en ;
    skos:historyNote "WG approval 26/03/2024"@en ;
    skos:prefLabel "has Notice Publication Number"@en .

epo:hasNoticeType a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Notice Type"@en .

epo:hasNumberOfReviewRequests a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The number of requests the buyer received to review any of its decisions. (epo:ReviewRequestSummary)"@en ;
    skos:prefLabel "has Number Of Review Requests"@en .

epo:hasNumberOfTenderersInvited a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Number of economic operators invited to tender. Additional Information This may be used for single-stage procedures or to indicate the number of candidates invited to tender in multi-stage procedures. (epo:SubmissionStatisticalInformation)"@en ;
    skos:historyNote "WG Approval 01/12/2020"@en ;
    skos:prefLabel "has Number Of Tenderers Invited"@en .

epo:hasNumberOfTendersConcerned a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Number Of Tenders Concerned"@en .

epo:hasNutsCode a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Nuts Code"@en .

epo:hasOJSIssueNumber a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The issue identifier of the Supplement to the EU Official Journal. Additional information: The format of this identifier is XX-YYYY. (epo:Notice)"@en ;
    skos:historyNote "WG approval 26/03/2024"@en ;
    skos:prefLabel "has OJS Issue Number"@en .

epo:hasOfficialLanguage a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The language(s) in which the instances of the given concepts are officially available. These linguistic versions are equally legally valid."@en ;
    skos:prefLabel "has Official Language"@en .

epo:hasOpeningDateTime a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Date and time for the opening of tenders. (epo:OpeningTerm)"@en ;
    skos:historyNote "WG Approval 12/03/2019"@en ;
    skos:prefLabel "has Opening Date Time"@en .

epo:hasOpeningDescription a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Further information about the opening of tenders. Additional Information For example, who may participate in the opening and whether any authorization is needed. (epo:OpeningTerm)"@en ;
    skos:historyNote "WG Approval 12/03/2019"@en ;
    skos:prefLabel "has Opening Description"@en .

epo:hasOpeningPlace a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The place (e.g. physical address, URL) where the tenders will be publicly opened. (epo:OpeningTerm)"@en ;
    skos:historyNote "WG Approval 06/03/2025"@en ;
    skos:prefLabel "has Opening Place"@en .

epo:hasOpeningURL a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The identifier of the address of the Opening of Tenders. (epo:OpeningTerm)"@en ;
    skos:historyNote "WG Approval 09/11/2021"@en ;
    skos:prefLabel "has Opening URL"@en .

epo:hasOptions a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The buyer reserves the right (not an obligation) for additional purchases from the contractor (while the contract is valid). (epo:ContractTerm)"@en ;
    skos:prefLabel "has Options"@en .

epo:hasOptionsDescription a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The motivation and details about additional purchases that the buyer may undertake while the contract is valid. (epo:ContractTerm)"@en ;
    skos:historyNote "WG Approval 09/04/2019"@en ;
    skos:prefLabel "has Options Description"@en .

epo:hasOrderabableUnitFactorRate a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Orderabable Unit Factor Rate"@en .

epo:hasOtherCountriesReceivedTenders a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The amount of Tenders received from European Economic Area countries other than that of the Buyer. (epo:SubmissionStatisticalInformation)"@en ;
    skos:historyNote "WG Approval 02/05/2024"@en ;
    skos:prefLabel "has Other Countries Received Tenders"@en .

epo:hasOutstandingQuantity a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The Quantity of non-despatched Goods Items."@en ;
    skos:historyNote "WG Approval 05/06/2024"@en ;
    skos:prefLabel "has Outstanding Quantity"@en .

epo:hasOverallCostAwardCriteriaPonderation a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The weighting given to cost. Additional Information: This weighting covers usually all cost criteria against price or quality criteria. (epo:AwardEvaluationTerm)"@en ;
    skos:prefLabel "has Overall Cost Award Criteria Ponderation"@en .

epo:hasOverallPriceAwardCriteriaPonderation a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The weighting given to price. Additional Information: This weighting covers usually all price criteria against cost or quality criteria. (epo:AwardEvaluationTerm)"@en ;
    skos:prefLabel "has Overall Price Award Criteria Ponderation"@en .

epo:hasOverallQualityAwardCriteriaPonderation a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The weighting given to quality. Additional Information: This weighting covers usually all quality criteria against price or cost criteria. (epo:AwardEvaluationTerm)"@en ;
    skos:prefLabel "has Overall Quality Award Criteria Ponderation"@en .

epo:hasOversupplyQuantity a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Oversupply Quantity"@en .

epo:hasParticipationPayment a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Details on payments to participants (epo:DesignContestRegimeTerm)"@en ;
    skos:historyNote "WG Approval 09/11/2021"@en ;
    skos:prefLabel "has Participation Payment"@en .

epo:hasPaymentAccountIdentifier a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "A unique identifier of the financial payment account, at a payment service provider, to which payment should be made."@en ;
    skos:historyNote "WG Approval 11/07/2024"@en ;
    skos:prefLabel "has Payment Account Identifier"@en .

epo:hasPaymentArrangement a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Information about financial clauses that will govern some economic aspects of the execution of the contract. Additional Information: These clauses usually refer to financial and payment provisions. This type of information should be structured instead of a free text in order to reuse it an ideal world. Unfortunately this is an information that in the real life no one is willing to provide pro-actively. WG Pending of discussion with eForms (epo:ContractTerm)"@en ;
    skos:prefLabel "has Payment Arrangement"@en .

epo:hasPaymentIdentifier a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Payment Identifier"@en .

epo:hasPaymentServiceProviderIdentifier a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "An identifier for the payment service provider where a payment account is located."@en ;
    skos:historyNote "WG Approval 11/07/2024"@en ;
    skos:prefLabel "has Payment Service Provider Identifier"@en .

epo:hasPaymentValueDiscrepancyJustification a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Justification for the actual value being different to the value in the initial Contract. (epo:ContractLotCompletionInformation)"@en ;
    skos:historyNote "WG Approval 26/03/2024"@en ;
    skos:prefLabel "has Payment Value Discrepancy Justification"@en .

epo:hasPerformanceConditions a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The particular conditions and additional information related to the execution of the contract. Additional Information: For example, specific information about the place of performance, intermediary deliverables, compensation for damages, intellectual property rights. (epo:ContractTerm)"@en ;
    skos:historyNote "WG approval 15/01/2019"@en ;
    skos:prefLabel "has Performance Conditions"@en .

epo:hasPerformingStaffQualificationInformation a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Explanation as to if and/or when information of the persons to carry out the contract is to be provided. The codelist to be used is at-voc:requirement-stage which is available at http://publications.europa.eu/resource/dataset/requirement-stage"@en ;
    skos:prefLabel "has Performing Staff Qualification Information"@en .

epo:hasPlaceOfPerformanceAdditionalInformation a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Further details on the location of the execution of the contract. (epo:ContractTerm)"@en ;
    skos:historyNote "WG Approval 30/07/2019"@en ;
    skos:prefLabel "has Place Of Performance Additional Information"@en .

epo:hasPlannedDuration a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Planned Duration"@en .

epo:hasPlannedPeriod a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Planned Period"@en .

epo:hasPreferredLanguageForProcurementDocument a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Preferred Language For Procurement Document"@en .

epo:hasPrepaidAmount a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Prepaid Amount"@en .

epo:hasPriceValidity a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Price Validity"@en .

epo:hasPrimaryContactPoint a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Primary Contact Point"@en .

epo:hasPrizeRank a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The position of the prize (e.g. first place, second place) in a design contest list of prizes. (epo:Prize)"@en ;
    skos:historyNote "WG Approval 29/08/2019"@en ;
    skos:prefLabel "has Prize Rank"@en .

epo:hasPrizeValue a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The monetary value of a prize, if any, for the winner (or runners-up) of the design contest."@en ;
    skos:editorialNote "Used by eForms BT-644"@en ;
    skos:historyNote "WG Approval 29/08/2019"@en ;
    skos:prefLabel "has Prize Value"@en .

epo:hasProcedureType a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Identification of the Procedure used."@en ;
    skos:prefLabel "has Procedure Type"@en .

epo:hasProcurementDocumentChangeDate a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The date and time of the change. (epo:ChangeInformation)"@en ;
    skos:editorialNote "Used by eForms BT-719"@en ;
    skos:historyNote "WG Approval 5/11/2019"@en ;
    skos:prefLabel "has Procurement Document Change Date"@en .

epo:hasProcurementHighestReceivedTenderValue a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The highest received tender value for the procurement. Additional Information: This corresponds to section II.1.7.3. according to Regulation (EU) 2015/1986."@en ;
    skos:prefLabel "has Procurement Highest Received Tender Value"@en .

epo:hasProcurementLowestReceivedTenderValue a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The lowest received tender value for the procurement. Additional Information: This corresponds to section II.1.7.2. according to Regulation (EU) 2015/1986."@en ;
    skos:prefLabel "has Procurement Lowest Received Tender Value"@en .

epo:hasProcurementScopeDividedIntoLot a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Defines Lot."@en ;
    skos:historyNote "WG Approval 25/03/2025"@en ;
    skos:prefLabel "has Procurement Scope Divided Into Lot"@en .

epo:hasPublicAccessURL a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Web page where the procurement documents can be downloaded. (epo:AccessTerm)"@en ;
    skos:editorialNote "Used by eForms BT-15"@en ;
    skos:historyNote "WG Approval 09/03/2021"@en ;
    skos:prefLabel "has Public Access URL"@en .

epo:hasPublicInterestExceptionJustification a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Public Interest Exception Justification"@en .

epo:hasPublicationDate a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Date of formal public issuance of the document. (epo:Document)"@en ;
    skos:historyNote "WG approval 20/06/2023"@en ;
    skos:prefLabel "has Publication Date"@en .

epo:hasPurpose a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Relation indicating the Purpose of a concept."@en ;
    skos:prefLabel "has Purpose"@en .

epo:hasQualificationCondition a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Requirements to be fulfilled by tenders in view of their qualification. (epo:QualificationCriteriaSummary)"@en ;
    skos:historyNote "WG Approval 02/05/2024"@en ;
    skos:prefLabel "has Qualification Condition"@en .

epo:hasQualificationCriteriaStatedInESPDRequest a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Qualification Criteria Stated In ESPD Request"@en .

epo:hasQualificationCriteriaStatedInNotice a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Qualification Criteria Stated In Notice"@en .

epo:hasQualificationCriteriaStatedInProcurementDocuments a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Qualification Criteria Stated In Procurement Documents"@en .

epo:hasQualificationSystemDuration a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Qualification System Duration"@en .

epo:hasQualificationSystemRenewalDescription a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Explanation of how a Qualification System is re-established. Additional information: A Qualification System qualifies an economic operator to take part in a tendering process. Usually, in such cases the economic operator passes the Exclusion Grounds and Selection Criteria. (epo:MultipleStageProcedureTerm)"@en ;
    skos:historyNote "WG Approval 26/03/2024"@en ;
    skos:prefLabel "has Qualification System Renewal Description"@en .

epo:hasQualifiedValue a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Qualified value of the property, which is defined in a classification scheme. Additional Information: For example, the (0173-1#02-AAA026#007) drilling diameter of an item has value of 12 inches."@en ;
    skos:historyNote "WG Approval 28/07/2022"@en ;
    skos:prefLabel "has Qualified Value"@en .

epo:hasQuantity a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Quantity"@en .

epo:hasQuantityThreshold a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Quantity Threshold"@en .

epo:hasQuantityValue a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The numeric value of the quantity, including decimals. (epo:Quantity)"@en ;
    skos:prefLabel "has Quantity Value"@en .

epo:hasReceiptDeadline a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The time limit for receiving submissions. Additional Information This is the deadline by which the buyer must receive submissions (e.g. tenders, requests to participate, clarifications, etc.) and is not the time at which the information is submitted by the economic operator. This attribute should be used for standard forms mappings. (epo:SubmissionTerm)"@en ;
    skos:historyNote "WG Approval 21/07/2020"@en ;
    skos:prefLabel "has Receipt Deadline"@en .

epo:hasReceiptExpressionDeadline a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Time limit for receipt of expressions of interest. Pending of review by the WG (epo:SubmissionTerm)"@en ;
    skos:prefLabel "has Receipt Expression Deadline"@en .

epo:hasReceiptParticipationRequestDeadline a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The time limit until which requests to participate can be received. (epo:SubmissionTerm)"@en ;
    skos:historyNote "WG Approval 02/05/2024"@en ;
    skos:prefLabel "has Receipt Participation Request Deadline"@en .

epo:hasReceiptPreliminaryMarketConsultationDeadline a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The time limit until which answers to the Preliminary Market Consultation can be received. (epo:SubmissionTerm)"@en ;
    skos:historyNote "WG Approval 02/05/2024"@en ;
    skos:prefLabel "has Receipt Preliminary Market Consultation Deadline"@en .

epo:hasReceiptTenderDeadline a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The time limit until which the Tenders can be received. (epo:SubmissionTerm)"@en ;
    skos:historyNote "WG Approval 02/05/2024"@en ;
    skos:prefLabel "has Receipt Tender Deadline"@en .

epo:hasReceivedMicroTenders a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The amount of tenders received from a micro enterprise. <u>Additional Information:</u> See Commission Recommendation 2003/361/EC. (epo:SubmissionStatisticalInformation)"@en ;
    skos:prefLabel "has Received Micro Tenders"@en .

epo:hasReceivedParticipationRequests a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The amount of applications to participate from economic operators. (epo:SubmissionStatisticalInformation)"@en ;
    skos:historyNote "WG Approval 12/12/2019"@en ;
    skos:prefLabel "has Received Participation Requests"@en .

epo:hasReceivedQuantity a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:prefLabel "has Received Quantity"@en .

epo:hasReceivedSmallTenders a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Tenders from small enterprise. <u>Additional Information:</u> See Commission Recommendation 2003/361/EC. (epo:SubmissionStatisticalInformation)"@en ;
    skos:prefLabel "has Received Small Tenders"@en .

epo:hasReceivedTenders a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The total amount of tenders received. (epo:SubmissionStatisticalInformation)"@en ;
    skos:historyNote "WG Approval 12/12/2019"@en ;
    skos:prefLabel "has Received Tenders"@en .

epo:hasReceptionDate a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
