    skos:editorialNote "Used by eForms BT-798"@en ;
    skos:prefLabel "has Withdrawal Reason"@en .

epo:hasZeroEmissionVehicles a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
