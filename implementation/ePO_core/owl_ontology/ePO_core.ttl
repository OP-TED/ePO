epo:hasAwardCriterionType a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Category of award criterion."@en ;
    skos:prefLabel "has Award Criterion Type"@en .

epo:hasAwardDateScheduled a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Planned date for the award decision. (epo:ProcessPlanningTerm)"@en ;
    skos:historyNote "WG Approval 09/11/2021"@en ;
    skos:prefLabel "has Award Date Scheduled"@en .

epo:hasAwardDecisionDate a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The official date of the award decision. (epo:AwardDecision)"@en ;
    skos:editorialNote "Used by eForms BT-1451"@en ;
    skos:historyNote "WG Approval 09/01/2020"@en ;
    skos:prefLabel "has Award Decision Date"@en .

epo:hasAwardJustification a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "Description of the reason behind an award or non-award of a given Tender. Additional information: This is generally used when the non award justification code is set to \"Other\" and when the Lot is awarded. It may highlight the justification of the non-award of a Tender with regard to awarded Tenders. (epo:AwardOutcome)"@en ;
    skos:historyNote "WG Approval 25/02/2025"@en ;
    skos:prefLabel "has Award Justification"@en .

epo:hasAwardRank a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:definition "The position of the tender (i.e. whether the tender ended up first, second, third, etc.) in a design contest, some framework agreements with multiple winners (e.g. cascades) or an innovation partnership. (epo:TenderAwardOutcome)"@en ;
    skos:editorialNote "Used by eForms BT-171"@en ;
    skos:prefLabel "has Award Rank"@en .

epo:hasAwardStatus a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
