    skos:historyNote "WG approval 07/11/2023"@en ;
    skos:prefLabel "includes National Criterion"@en .

epo:includesTender a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:core ;
    skos:editorialNote "Used by eForms BT-3202"@en ;
    skos:prefLabel "includes Tender"@en .

epo:indicatesAwardToWinner a owl:ObjectProperty ;
