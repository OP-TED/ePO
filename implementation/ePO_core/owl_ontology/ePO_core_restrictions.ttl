            owl:maxCardinality 1 ;
            owl:onProperty epo:usesEvaluationFormula ] .

epo:GoodsItem rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:hasTraceID ] .

epo:NonDisclosureAgreementTerm rdfs:subClassOf [ a owl:Restriction ;
