        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dcterms:description ] .

epo:ProcurementCriteriaSummary rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
