epo:hasConstraint rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://data.europa.eu/m8g/InformationRequirement> epo:ProcurementCriterion ) ] ;
    rdfs:range <http://data.europa.eu/m8g/Constraint> .

epo:hasContactName rdfs:domain <http://data.europa.eu/m8g/ContactPoint> ;
