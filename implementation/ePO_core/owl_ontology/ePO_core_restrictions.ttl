@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix epo: <http://data.europa.eu/a4g/ontology#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

epo:CreditTransferInformation rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:hasPaymentAccountIdentifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:hasPaymentServiceProviderIdentifier ] .

epo:EvidenceInformation rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:summarisesInformationAboutEvidence ] .

epo:OrganisationInformationSummary rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:providesOrganisationEmployeeQuantity ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:concernsOrganisation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:providesOrganisationFinancialCapability ] .

epo:PaymentInstructionsInformation rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:hasDebitedAccountIdentifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:hasBankingIdentifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:hasMandateIdentifier ] .

epo:Response rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:refersToApplicablePeriod ] .

epo:ShipmentStage rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty adms:identifier ] .

epo:TransportEquipment rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty adms:identifier ] .

epo:TransportEquipmentSeal rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty adms:identifier ] .

epo:announcesAwardDecision rdfs:domain [ a owl:Class ;
            owl:unionOf ( epo:ResultNotice epo:DirectAwardPrenotificationNotice ) ] ;
    rdfs:range epo:AwardDecision .

epo:announcesContract rdfs:domain [ a owl:Class ;
            owl:unionOf ( epo:DirectAwardPrenotificationNotice epo:ResultNotice ) ] ;
    rdfs:range epo:Contract .

epo:announcesLotGroup rdfs:domain [ a owl:Class ;
            owl:unionOf ( epo:PlanningNotice epo:CompetitionNotice epo:DirectAwardPrenotificationNotice ) ] ;
    rdfs:range epo:LotGroup .

epo:announcesLotGroupAwardInformation rdfs:domain [ a owl:Class ;
            owl:unionOf ( epo:DirectAwardPrenotificationNotice epo:ResultNotice ) ] ;
    rdfs:range epo:LotGroupAwardInformation .

epo:announcesPlannedProcurementPart rdfs:domain epo:PlanningNotice ;
    rdfs:range epo:PlannedProcurementPart .

epo:announcesReviewRequest rdfs:domain epo:ResultNotice ;
    rdfs:range epo:ReviewRequest .

epo:associatedWith a owl:AsymmetricProperty ;
    rdfs:domain epo:Document ;
    rdfs:range epo:Document .

epo:bindsBuyer rdfs:domain epo:Contract ;
    rdfs:range epo:Buyer .

epo:bindsContractor rdfs:domain epo:Contract ;
    rdfs:range epo:Contractor .

epo:canProvideEvidence rdfs:domain org:Organization ;
    rdfs:range <http://data.europa.eu/m8g/Evidence> .

epo:canProvideNonDiscriminatoryEvidence rdfs:domain org:Organization ;
    rdfs:range <http://data.europa.eu/m8g/Evidence> .

epo:comprisesAwardOutcome rdfs:domain epo:AwardDecision ;
    rdfs:range epo:AwardOutcome .

epo:comprisesTenderAwardOutcome rdfs:domain epo:AwardOutcome ;
    rdfs:range epo:TenderAwardOutcome .

epo:concernsEnergyEfficiencyItemCategory rdfs:domain epo:EnergyEfficiencyInformation ;
    rdfs:range skos:Concept .

epo:concernsInternationalProcurementInstrumentMeasure rdfs:domain epo:InternationalProcurementInstrumentMeasuresInformation ;
    rdfs:range skos:Concept .

epo:concernsLotAwardOutcome rdfs:domain epo:InternationalProcurementInstrumentMeasuresInformation ;
    rdfs:range epo:LotAwardOutcome .

epo:conformsToLegalBasis rdfs:domain epo:Notice ;
    rdfs:range skos:Concept .

epo:containsCandidate rdfs:domain [ a owl:Class ;
            owl:unionOf ( epo:SelectedCandidateList epo:ExcludedCandidateList ) ] ;
    rdfs:range epo:Candidate .

epo:contextualisedBy rdfs:domain epo:AgentInRole ;
    rdfs:range epo:ProcurementElement .

epo:core-restriction a owl:Ontology ;
    rdfs:label "eProcurement Ontology - core restrictions"@en ;
    dcterms:created "2021-06-01"^^xsd:date ;
    dcterms:description "The eProcurement Ontology core restrictions provides the restrictions and the inference-related specifications on the concepts and properties in the eProcurement Ontology core."@en ;
    dcterms:issued "2025-05-15"^^xsd:date ;
    dcterms:license "© European Union, 2014. Unless otherwise noted, the reuse of the Ontology is authorised under the European Union Public Licence v1.2 (https://eupl.eu/)." ;
    dcterms:publisher "http://publications.europa.eu/resource/authority/corporate-body/PUBL" ;
    dcterms:title "eProcurement Ontology - core restrictions"@en ;
    vann:preferredNamespacePrefix "epo" ;
    vann:preferredNamespaceUri "http://data.europa.eu/a4g/ontology#" ;
    rdfs:comment """This version is automatically generated from ePO_core.xml on 
                2025-05-15""" ;
    rdfs:seeAlso <https://docs.ted.europa.eu/home/index.html>,
        <https://github.com/OP-TED/ePO/releases>,
        <https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology/about>,
        <https://op.europa.eu/en/web/eu-vocabularies/e-procurement> ;
    owl:imports epo:core,
        <http://data.europa.eu/eli/ontology#>,
        <http://data.europa.eu/m8g/>,
        dcterms:,
        skos:,
        <http://www.w3.org/2006/time>,
        <http://www.w3.org/ns/adms>,
        <http://www.w3.org/ns/locn>,
        org:,
        <http://www.w3.org/ns/person> ;
    owl:incompatibleWith "4.2.0" ;
    owl:priorVersion "http://data.europa.eu/a4g/ontology#core-restriction-4.2.0" ;
    owl:versionIRI epo:core-restriction-5.0.0 ;
    owl:versionInfo "5.0.0" .

epo:definesCatalogueProvider rdfs:domain epo:AccessTerm ;
    rdfs:range epo:CatalogueProvider .

epo:definesCatalogueReceiver rdfs:domain epo:AccessTerm ;
    rdfs:range epo:CatalogueReceiver .

epo:definesInformationProvider rdfs:domain epo:ProcedureTerm ;
    rdfs:range epo:AuxiliaryParty .

epo:definesLotGroup rdfs:domain epo:ProcedureTerm ;
    rdfs:range epo:LotGroup .

epo:definesPrize rdfs:domain epo:DesignContestRegimeTerm ;
    rdfs:range epo:Prize .

epo:definesReviewer rdfs:domain epo:ReviewTerm ;
    rdfs:range epo:Reviewer .

epo:definesSpecificPlaceOfPerformance rdfs:domain epo:ContractTerm ;
    rdfs:range dcterms:Location .

epo:delegatesAncillaryActivitiesTo rdfs:domain epo:Buyer ;
    rdfs:range epo:ProcurementServiceProvider .

epo:distributesOffer rdfs:domain epo:OfferIssuer ;
    rdfs:range epo:Offer .

epo:doesNotRequireSelectionCriterionType rdfs:domain epo:ProcurementElement ;
    rdfs:range skos:Concept .

epo:exposesChannel rdfs:domain [ a owl:Class ;
            owl:unionOf ( org:Organization epo:AgentInRole ) ] ;
    rdfs:range <http://data.europa.eu/m8g/Channel> .

epo:foreseesSubcontracting rdfs:domain epo:Tender ;
    rdfs:range epo:SubcontractingEstimate .

epo:foreseesTechnique rdfs:domain epo:PlannedProcurementPart ;
    rdfs:range epo:Technique .

epo:foreseesTerm rdfs:domain epo:ProcurementElement ;
    rdfs:range epo:Term .

epo:fulfillsRequirement rdfs:domain [ a owl:Class ;
            owl:unionOf ( epo:GreenProcurement epo:InnovativeProcurement epo:SocialProcurement ) ] ;
    rdfs:range skos:Concept .

epo:fulfillsStrategicProcurement rdfs:domain [ a owl:Class ;
            owl:unionOf ( epo:ProcurementObject epo:LotAwardOutcome ) ] ;
    rdfs:range epo:StrategicProcurement .

epo:hasAcceleratedProcedureJustification rdfs:domain epo:Procedure ;
    rdfs:range rdf:PlainLiteral .

epo:hasAccessURL rdfs:domain epo:Document ;
    rdfs:range xsd:anyURI .

epo:hasActivityDescription rdfs:domain epo:Buyer ;
    rdfs:range rdf:PlainLiteral .

epo:hasAdditionalClassification rdfs:domain epo:Purpose ;
    rdfs:range skos:Concept .

epo:hasAdditionalContractNature rdfs:domain epo:ContractTerm ;
