            owl:onProperty epo:specifiesProcurementCriterion ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:concernsProcedure ] .

epo:EvaluationReport rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
