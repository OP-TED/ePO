epo:AllowanceChargeInformation rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:isCalculatedOn ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:hasAmount ] .

epo:CatalogueResponse rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:specifiesCatalogueReceiver ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:specifiesCatalogueProvider ] .

epo:ContractAmendment rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:amendsContract ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:updatesContractValue ] .

epo:DespatchLine rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:hasOutstandingQuantity ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:hasDespatchedQuantity ] .

epo:Documentation a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:hasAddressURL ] .

epo:ESPDRequest rdfs:subClassOf [ a owl:Restriction ;
