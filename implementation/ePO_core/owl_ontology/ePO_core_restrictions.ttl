epo:hasAwardStatus rdfs:domain epo:AwardOutcome ;
    rdfs:range skos:Concept .

epo:hasBeneficialOwner rdfs:domain epo:Business ;
    rdfs:range <http://www.w3.org/ns/person#Person> ;
    owl:inverseOf epo:isBeneficialOwnerOf .

epo:hasBroadPlaceOfPerformance rdfs:domain epo:ContractTerm ;
    rdfs:range skos:Concept .

epo:hasBusinessSize rdfs:domain epo:Business ;
    rdfs:range skos:Concept .

epo:hasBuyerCategoryDescription rdfs:domain epo:FrameworkAgreementTerm ;
