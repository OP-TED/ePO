    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">foresees Subcontracting</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasSellerItemID">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:historyNote xml:lang="en">WG Approval 16/05/2023</skos:historyNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">has Seller Item ID</skos:prefLabel>
    <skos:definition xml:lang="en">The general identifier assigned to the concept as defined by the Seller.​</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#System">
    <skos:historyNote xml:lang="en">WG Approval 28/04/2020</skos:historyNote>
    <rdfs:subClassOf rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">System</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Software application used for performing Procurement activities.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#ProcedureTerm">
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Term"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#MaskableObject"/>
    <skos:definition xml:lang="en">Conditions and stipulations defining particularities of the Procedure.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:historyNote xml:lang="en">WG approval 23/11/2018</skos:historyNote>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">Procedure Term</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#providesProcurementDocumentsInUnofficialLanguage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">provides Procurement Documents In Unofficial Language</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#refersToLotGroupAwardInformation">
    <skos:prefLabel xml:lang="en">refers To Lot Group Award Information</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#ContextDescription">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">Context Description</skos:prefLabel>
    <skos:definition xml:lang="en">A description concerning a Procurement Object or a Notice in a specific Situation Context. Additional Information: The description has its own identity (+I) but is dependent (+D) on the concerned Entity. We say that ContextDescription *concerns* an Entity.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasHeight">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The vertical measurement.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 18/06/2024</skos:historyNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">has Height</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#LeadBuyer">
    <skos:prefLabel xml:lang="en">Lead Buyer</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A Role of an Agent who is a Buyer and takes the administrative lead of the Procedure.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:historyNote xml:lang="en">WG Approval 22/11/2022</skos:historyNote>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Buyer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#PlannedProcurementPart">
    <skos:historyNote xml:lang="en">WG Approval 20/06/2019</skos:historyNote>
    <skos:definition xml:lang="en">A subdivision of a Planned Procurement that may later become one or more Lots or a self-standing Procedure. A Lot or a Procedure can also cover one or more parts of the Planned Procurement.</skos:definition>
    <skos:prefLabel xml:lang="en">Planned Procurement Part</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ProcurementElement"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#ProcurementServiceProvider">
    <skos:historyNote xml:lang="en">WG Approval 24/03/2020</skos:historyNote>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">Procurement Service Provider</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AcquiringParty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:source xml:lang="en">Directive 2014/24/EU, Article 2, paragraphs 17 and 15.</dcterms:source>
    <skos:definition xml:lang="en">Role of a public or private body which offers ancillary purchasing activities on the market. Additional information: "Ancillary Purchasing Activities" means activities consisting in the provision of support to purchasing activities, in particular in the following forms: (a) technical infrastructure enabling Contracting Authorities to award Public Contracts or to conclude Framework Agreements for works, supplies or services; (b) advice on the conduct or design of public Procurement Procedures; (c) preparation and management of Procurement Procedures on behalf and for the account of the Contracting Authority concerned; This would be equivalent to the concept of 'ProcuringEntity' in OCDS: 'The Entity managing the Procurement, which may be different from the Buyer who is paying / using the items being procured'.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasFrameworkAgreementType">
    <skos:definition xml:lang="en">The form of framework agreement used in a procurement procedure. Addition information: A concept to distinguish the different types of framework agreement, which are: 1. Framework agreement without reopening of competition, 2. Framework agreement with reopening of competition, or 3. Framework agreement partly without reopening of competition.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">has Framework Agreement Type</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#ReviewProcedureInformationProvider">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A Role of an Agent who is providing more information on the time limits for review Procedures.</skos:definition>
    <skos:prefLabel xml:lang="en">Review Procedure Information Provider</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AcquiringParty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasJuryMember">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">has Jury Member</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">An agent involved in an evaluation board.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 14/09/2021</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#announcesLot">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">announces Lot</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasLotAwardCombination">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:definition xml:lang="en">The contracting authority reserves the right to award contracts combining lots or groups of lots. Additional Information: This property contains information about the Lots concerned. This property is required by the regulation (EU)-2015-1986 (modeled in the TED Standard Forms). (epo:ProcedureTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 23/08/2022</skos:historyNote>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">has Lot Award Combination</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#refersToPrevious">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">refers To Previous</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#SelectionCriteriaSummary">
    <skos:historyNote xml:lang="en">WG approval 19/03/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">Selection Criteria Summary</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#QualificationCriteriaSummary"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Overview of the Selection Criteria.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#InnovativeProcurement">
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#StrategicProcurement"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Approach whereby Buyers seek to procure an innovative work, supply or service. Additional Information: ‘innovation’ means the implementation of a new or significantly improved product, service or process, including but not limited to production, building or construction processes, a new marketing method, or a new organizational method in business practices, workplace Organisation or external relations inter alia with the purpose of helping to solve societal challenges or to support the Europe 2020 strategy for smart, sustainable and inclusive growth; See: Directive 2014/24 Articles: 2, 26 (3), 31, 67 (2.a)</skos:definition>
    <skos:prefLabel xml:lang="en">Innovative Procurement</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#ReviewRequestSummary">
    <skos:definition xml:lang="en">Overview of the requests received by the Buyer to review any of its decisions (e.g. the technical specifications, award decision), as set out in Art. 1(5) of Directive 89/665/EEC and Directive 92/13/EEC, and about the complainants that submitted the requests.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">Review Request Summary</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#StatisticalInformation"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#MaskableObject"/>
    <skos:historyNote xml:lang="en">WG approval 19/03/2024</skos:historyNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasAdditionalContractNature">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Additional type of acquisition taken into consideration in the contract.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">has Additional Contract Nature</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasCurrency">
    <skos:prefLabel xml:lang="en">has Currency</skos:prefLabel>
    <skos:definition xml:lang="en">The identifier of the currency as in the standard code list used.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#isOwnedByAgent">
    <skos:prefLabel xml:lang="en">is Owned By Agent</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#includesTender">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">includes Tender</skos:prefLabel>
    <skos:editorialNote xml:lang="en">Used by eForms BT-3202</skos:editorialNote>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#Documentation">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">Documentation</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasBuyerLegalType">
    <skos:definition xml:lang="en">A category that indicates the right of an Organisation to play the role of a buyer. Additional Information: The category also effects the rules that the buyer has to abide to within the public procurement procedure.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">has Buyer Legal Type</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#definesCatalogueReceiver">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Relation indicating an AccessTerm has a CatalogueReceiver.</skos:definition>
    <skos:prefLabel xml:lang="en">defines Catalogue Receiver</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasFollowupContract">
    <skos:prefLabel xml:lang="en">has Followup Contract</skos:prefLabel>
    <skos:historyNote xml:lang="en">WG Approval 29/08/2019</skos:historyNote>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Any subsequent service contract will be awarded to the winner or, in the case of a design contest, winners. (epo:DesignContestRegimeTerm)</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasPrizeValue">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:editorialNote xml:lang="en">Used by eForms BT-644</skos:editorialNote>
    <skos:historyNote xml:lang="en">WG Approval 29/08/2019</skos:historyNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">The monetary value of a prize, if any, for the winner (or runners-up) of the design contest.</skos:definition>
    <skos:prefLabel xml:lang="en">has Prize Value</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#SelectionEvaluationTerm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">Selection Evaluation Term</skos:prefLabel>
    <skos:definition xml:lang="en">Conditions and stipulations defining particularities of the evaluation of Selection Criteria.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#EvaluationTerm"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasReceiptParticipationRequestDeadline">
    <skos:historyNote xml:lang="en">WG Approval 02/05/2024</skos:historyNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel xml:lang="en">has Receipt Participation Request Deadline</skos:prefLabel>
    <skos:definition xml:lang="en">The time limit until which requests to participate can be received. (epo:SubmissionTerm)</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#resultsFromUsingCandidateList">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">results From Using Candidate List</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasTraceID">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">has Trace ID</skos:prefLabel>
    <skos:definition xml:lang="en">The identifier used for tracking the Goods Item. Additional information: An example is the EPC number used in RFID.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 21/09/2023</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#refersToProject">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">refers To Project</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasOpeningURL">
    <skos:prefLabel xml:lang="en">has Opening URL</skos:prefLabel>
    <skos:definition xml:lang="en">The identifier of the address of the Opening of Tenders. (epo:OpeningTerm)</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:historyNote xml:lang="en">WG Approval 09/11/2021</skos:historyNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasProcurementScopeDividedIntoLot">
    <skos:definition xml:lang="en">Defines Lot.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:historyNote xml:lang="en">WG Approval 25/03/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Procurement Scope Divided Into Lot</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasAwardDateScheduled">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel xml:lang="en">has Award Date Scheduled</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Planned date for the award decision. (epo:ProcessPlanningTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 09/11/2021</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#requestsRemedyType">
    <skos:prefLabel xml:lang="en">requests Remedy Type</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#foreseesSubcontractor">
    <skos:prefLabel xml:lang="en">foresees Subcontractor</skos:prefLabel>
    <skos:definition xml:lang="en">Relation indicating that an Organization plans to have a Subcontractor. Additional information: In eForms, in a Result Notice, the foreseen Subcontractors in a Tender are associated to the Organization that proposes the Subcontractors. The Subcontractor is associated to the Organization, rather than the Tenderer, so that, in the case of multiple Organizations being a Tenderer, it is clear to which Organization the proposed Subcontractor is associated.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:historyNote xml:lang="en">WG Approval 26/11/2024</skos:historyNote>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#concernsNotice">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">concerns Notice</skos:prefLabel>
    <skos:historyNote xml:lang="en">WG Approval 14/05/2024</skos:historyNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Relates to Notice.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasOtherCountriesReceivedTenders">
    <skos:historyNote xml:lang="en">WG Approval 02/05/2024</skos:historyNote>
    <skos:definition xml:lang="en">The amount of Tenders received from European Economic Area countries other than that of the Buyer. (epo:SubmissionStatisticalInformation)</skos:definition>
    <skos:prefLabel xml:lang="en">has Other Countries Received Tenders</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#providesRulingOnRemedy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">States the measures to be taken after a review procedure.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">provides Ruling On Remedy</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasNonAwardedContractNumber">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">has Non Awarded Contract Number</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:historyNote xml:lang="en">WG Approval 06/09/2022</skos:historyNote>
    <skos:definition xml:lang="en">The number the contract would have had if it had been awarded. Additional information: This field is provided to support the data provided in the TED Standard Forms, and it should be discontinued in the future. (epo:LotAwardOutcome)</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasUnverifiedTenders">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:historyNote xml:lang="en">WG Approval 28/07/2020</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Unverified Tenders</skos:prefLabel>
    <skos:definition xml:lang="en">Offers received for which it has not been verified if they are admissible or inadmissible (e.g. because award criteria have been evaluated for all tenders and admissibility is checked only for the winning tender). (epo:SubmissionStatisticalInformation)</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#bindsBuyer">
    <skos:definition xml:lang="en">Provides legal constraint on the Buyer.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">binds Buyer</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasBatchID">
    <skos:historyNote xml:lang="en">WG Approval 16/05/2023</skos:historyNote>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">has Batch ID</skos:prefLabel>
    <skos:definition xml:lang="en">The identifier assigned to a specific batch of the produced Item.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasSubcontractingInvolved">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">has Subcontracting Involved</skos:prefLabel>
    <skos:definition xml:lang="en">List of Subcontractors and the subject matter they cover are required. Additional Information: The tenderer will ned to supply this information in the tender. (epo:SubcontractTerm)</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:historyNote xml:lang="en">WG Approval 28/02/2019</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasSubcontracting">
    <skos:prefLabel xml:lang="en">has Subcontracting</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasEInvoicing">
    <skos:prefLabel xml:lang="en">has E Invoicing</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:historyNote xml:lang="en">WG Approval 12/09/2019</skos:historyNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:definition xml:lang="en">Electronic means will be used for invoicing in the post-award process. Additional Information: This attribute is used for standard form mappings. (epo:ContractTerm)</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#concernsGreenProcurement">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">concerns Green Procurement</skos:prefLabel>
    <skos:definition xml:lang="en">Relates to Green Procurement.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 07/05/2024</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasMainFeature">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:definition xml:lang="en">Main features of the procedure and information about where the full rules for the procedure can be found. Additional Information: This information should be given when the procedure is not one of those mentioned in the procurement directives. This can be the case for example for concessions, for social and other specific services, and in case of voluntary publication of procurement procedures below the EU procurement thresholds. (epo:Procedure)</skos:definition>
    <skos:prefLabel xml:lang="en">has Main Feature</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#isOneLotOnlyAllowed">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Indicates whether tenders may be submitted for only one Lot. Additional information: This field is used to complement the SubmissionTerms (which are at the Lot level) for the Procedure level which is covered by the regulation (EU)-2015-1986 (modeled in the TED Standard Forms). (epo:ProcedureTerm)</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:historyNote xml:lang="en">WG Approval 23/08/2022</skos:historyNote>
    <skos:prefLabel xml:lang="en">is One Lot Only Allowed</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasEntryIntoForceDate">
    <skos:historyNote xml:lang="en">WG Approval 05/11/2019</skos:historyNote>
    <skos:definition xml:lang="en">The date on which the contract enters into force. Additional information: This is generally the date on which the fulfillment of the contract begins. (epo:Contract)</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">has Entry Into Force Date</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasStrategicProcurementDescription">
    <skos:prefLabel xml:lang="en">has Strategic Procurement Description</skos:prefLabel>
    <skos:definition xml:lang="en">Self-explanatory text about a concept. (epo:StrategicProcurement)</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasTotalChargeAmount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">has Total Charge Amount</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#AccessTerm">
    <skos:prefLabel xml:lang="en">Access Term</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Term"/>
    <skos:historyNote xml:lang="en">WG Approval 09/03/2021</skos:historyNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">Conditions and stipulations about where and how to access the Procurement Documents.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasEstimatedContractNoticePublicationDate">
    <skos:editorialNote xml:lang="en">Used by eForms BT-127</skos:editorialNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel xml:lang="en">has Estimated Contract Notice Publication Date</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Foreseen date for publication of Contract Notice. (epo:ProcessPlanningTerm)</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#QualificationCriterion">
    <skos:definition xml:lang="en">Criterion used in the first stage of procurement.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 30/05/2023</skos:historyNote>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ProcurementCriterion"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">Qualification Criterion</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasQualificationCondition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Requirements to be fulfilled by tenders in view of their qualification. (epo:QualificationCriteriaSummary)</skos:definition>
    <skos:prefLabel xml:lang="en">has Qualification Condition</skos:prefLabel>
    <skos:historyNote xml:lang="en">WG Approval 02/05/2024</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasReceivedParticipationRequests">
    <skos:historyNote xml:lang="en">WG Approval 12/12/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Received Participation Requests</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:definition xml:lang="en">The amount of applications to participate from economic operators. (epo:SubmissionStatisticalInformation)</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#ContextualProjection">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">Contextual Projection</skos:prefLabel>
    <skos:definition xml:lang="en">Projection of an Entity and all of its properties that hold in a given Situation Context. Additional Information: The contextual projection does not have its own identity (-I), is dependent (+D) on the described Entity, and is anti-rigid (~R) We say that ContextualProjection *describes* an Entity. Adaptation of ContextSlices pattern encoding a 4D view. http://ontologydesignpatterns.org/wiki/Submissions:Context_Slices</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasESubmissionPermission">
    <skos:prefLabel xml:lang="en">has E Submission Permission</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">The requirements as to what extent electronic submission is allowed.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#ReviewTerm">
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Term"/>
    <skos:historyNote xml:lang="en">WG approval 23/11/2018</skos:historyNote>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Conditions and stipulations defining particularities of the review.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">Review Term</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#definesPaymentExecutor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Relation indicating a ContractTerm has a PaymentExecutor.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">defines Payment Executor</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasDeliveryPeriod">
    <skos:prefLabel xml:lang="en">has Delivery Period</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#refersToPreviousProcedure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:editorialNote xml:lang="en">eForms BT-1252</skos:editorialNote>
    <skos:prefLabel xml:lang="en">refers To Previous Procedure</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Reference to a previous procedure. Additional Information: In the case of Direct Award Terms, this property points to a previous Procedure justifying the use of Direct Award without a prior publication.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasBargainPrice">
    <skos:prefLabel xml:lang="en">has Bargain Price</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:historyNote xml:lang="en">WG Approval 23/05/2023</skos:historyNote>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The value of procured supplies that have used a particularly advantageous opportunity available for a very short time at a value considerably lower than normal market prices.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#EAuctionTechnique">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:historyNote xml:lang="en">WG approval 20/07/2018</skos:historyNote>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Technique"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:editorialNote xml:lang="en">Used by eForms BT-767</skos:editorialNote>
    <skos:prefLabel xml:lang="en">E Auction Technique</skos:prefLabel>
    <skos:definition xml:lang="en">A repetitive Technique in which new Prices, revised downwards, and/or new values concerning certain elements of Tenders are bid on-line.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#signsAwardDecision">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">signs Award Decision</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#isContractingEntity">
    <skos:definition xml:lang="en">Role of entities, which: (a) are contracting authorities or public undertakings and which pursue one of the activities referred to in Articles 8 to 14 of the Directive 2014/25/EU. (b) when they are not contracting authorities or public undertakings, have as one of their activities any of the activities referred to in Articles 8 to 14, or any combination thereof and operate on the basis of special or exclusive rights granted by a competent authority of a Member State. Additional Information: The indicator is needed in order to discriminate between those contracts where the Contracting Entity acts as a Contracting Authority undergoing the limits and the rules of Directive 24 and those where it acts as a Contracting Entity, with certain relaxed constraints. For example, the Contracting Entities have different thresholds for the application of Directive 24 if compared with Contracting Authorities. (epo:Buyer)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 28/04/2020</skos:historyNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">is Contracting Entity</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#ChangeInformation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ContextDescription"/>
    <skos:prefLabel xml:lang="en">Change Information</skos:prefLabel>
    <skos:definition xml:lang="en">Alteration to previously provided details.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#comprisesTenderAwardOutcome">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">comprises Tender Award Outcome</skos:prefLabel>
    <skos:definition xml:lang="en">Incorporates TenderAwardOutcome.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasECataloguePermission">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">has E Catalogue Permission</skos:prefLabel>
    <skos:definition xml:lang="en">The extent to which electronic catalogues may be used in tenders.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasPrizeRank">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:definition xml:lang="en">The position of the prize (e.g. first place, second place) in a design contest list of prizes. (epo:Prize)</skos:definition>
    <skos:prefLabel xml:lang="en">has Prize Rank</skos:prefLabel>
    <skos:historyNote xml:lang="en">WG Approval 29/08/2019</skos:historyNote>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasQuantity">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">has Quantity</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#contextualisedBy">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The place of the AgentInRole in the procurement is expressed by a ProcurementObject.</skos:definition>
    <skos:prefLabel xml:lang="en">contextualised By</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#comprisesAwardOutcome">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">comprises Award Outcome</skos:prefLabel>
    <skos:definition xml:lang="en">Incorporates AwardOutcome.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasBuyerCategoryDescription">
    <skos:editorialNote xml:lang="en">Used by eForms BT-111</skos:editorialNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:definition xml:lang="en">A classification of buyers participating in a framework agreement. Additional Information: Buyers that can use the Framework Agreement not mentioned by name. For example, the classification "all hospitals in the Tuscany region" is used instead of naming each individual buyer. (epo:FrameworkAgreementTerm)</skos:definition>
    <skos:prefLabel xml:lang="en">has Buyer Category Description</skos:prefLabel>
    <skos:historyNote xml:lang="en">WG Approval 06/05/2019</skos:historyNote>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasEEAReceivedTenders">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:historyNote xml:lang="en">WG Approval 12/12/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">has EEA Received Tenders</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The amount of tenders received from economic operators in other EEA countries other than the country of the buyer. (epo:SubmissionStatisticalInformation)</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasDespatchedQuantity">
    <skos:prefLabel xml:lang="en">has Despatched Quantity</skos:prefLabel>
    <skos:historyNote xml:lang="en">WG Approval 18/06/2024</skos:historyNote>
    <skos:definition xml:lang="en">The Quantity that has been sent.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#Estimate">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">Estimate</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">An approximate calculation or a judgement of the value, number, Quantity or extent of something.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ContextDescription"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasInadmissibleTenders">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Tenders received that cannot be awarded due to non-compliance to procurement document requirements or having an abnormally low price or cost. &lt;u&gt;Additional Information: &lt;/u&gt; Non-compliance with a Procurement Document requirements include exclusion grounds, selection criteria and submission deadline, etc. (epo:SubmissionStatisticalInformation)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 12/12/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Inadmissible Tenders</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#refersToReviewRequest">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">refers To Review Request</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasTenderValidityDuration">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">has Tender Validity Duration</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasOversupplyQuantity">
    <skos:prefLabel xml:lang="en">has Oversupply Quantity</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#ReviewDecision">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Information about Review Decisions.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">Review Decision</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#involvesBuyer">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">involves Buyer</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasLegalBasis">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">has Legal Basis</skos:prefLabel>
    <skos:definition xml:lang="en">The legal basis under which the procurement procedure takes place. Additional Information: For example European Directives or Regulations, national laws etc. The recommended code list is the example for the legal basis at the European level.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasOverallQualityAwardCriteriaPonderation">
    <skos:definition xml:lang="en">The weighting given to quality. Additional Information: This weighting covers usually all quality criteria against price or cost criteria. (epo:AwardEvaluationTerm)</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">has Overall Quality Award Criteria Ponderation</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasTotalLineAmount">
    <skos:prefLabel xml:lang="en">has Total Line Amount</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasTotalTaxInclusiveAmount">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">has Total Tax Inclusive Amount</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#isSubmittedForLotGroup">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">is Submitted For Lot Group</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasConstraint">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">External concept defined by &lt;xref scope="external" href="http://data.europa.eu/m8g/hasConstraint"&gt;&lt;foreign otherprops="#0000ff"&gt;&lt;u&gt;http://data.europa.eu/m8g/hasConstraint&lt;/u&gt;&lt;/foreign&gt;&lt;/xref&gt;</skos:definition>
    <skos:prefLabel xml:lang="en">has Constraint</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#Candidate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#OfferingParty"/>
    <skos:prefLabel xml:lang="en">Candidate</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The Role of an Agent that has sought an invitation or has been invited to take part in a restricted Procedure, in a competitive Procedure with negotiation, in a negotiated Procedure without prior publication, in a competitive dialogue or in an innovation partnership.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 30/05/2023</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#definesSubcontractingTerm">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">defines Subcontracting Term</skos:prefLabel>
    <skos:definition xml:lang="en">Relation indicating a ContractTerm has a SubcontractingTerm.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasQuantityThreshold">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">has Quantity Threshold</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#AwardCriteriaSummary">
    <skos:historyNote xml:lang="en">WG approval 19/03/2024</skos:historyNote>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ProcurementCriteriaSummary"/>
    <skos:prefLabel xml:lang="en">Award Criteria Summary</skos:prefLabel>
    <skos:definition xml:lang="en">Overview of the Award Criteria.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasPurpose">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relation indicating the Purpose of a concept.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">has Purpose</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#Certificate">
    <skos:definition xml:lang="en">Proof of conformance of the instance of the concept to a defined set of criteria. Additional Information: Certificates provide assurance of credibility, trust, and transparency in the procurement process.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 16/05/2023</skos:historyNote>
    <skos:prefLabel xml:lang="en">Certificate</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/m8g/Evidence"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#ConcessionEstimate">
    <skos:historyNote xml:lang="en">WG approval 19/03/2024</skos:historyNote>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Estimate"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#MaskableObject"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">Concession Estimate</skos:prefLabel>
    <skos:definition xml:lang="en">Approximation concerning the foreseen Concession Contract.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#ReviewInformation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">Review Information</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasFormula">
    <skos:editorialNote xml:lang="en">Used by eForms BT-543</skos:editorialNote>
    <skos:definition xml:lang="en">The mathematical equation or any other description used for complicated weighing of criteria (e.g. non-linear weighing, the analytic hierarchy process) when a weighing cannot be expressed per criterion. (epo:ProcurementCriterion)</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">has Formula</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasAcceleratedProcedureJustification">
    <skos:definition xml:lang="en">The reasons why the procedure is accelerated. Additional Information: A procedure is accelerated to cover needs of extraordinary circumstances ie earthquake relief. (epo:Procedure)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 09/06/2020</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Accelerated Procedure Justification</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#LotGroupAwardInformation">
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ContextDescription"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">Lot Group Award Information</skos:prefLabel>
    <skos:definition xml:lang="en">Award information related to a given Group of Lots.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasZeroEmissionVehicles">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:historyNote xml:lang="en">WG Approval 28/07/2020</skos:historyNote>
    <skos:definition xml:lang="en">The number of all zero-emission heavy-duty vehicles that have either been purchased, leased, rented, hired-purchased or their use has been contractually committed to for the provision of a purchased service. Additional Information: In the European Union, the legal requirements and scope for the provision of these vehicles or services are covered by Directive 2009/33/EC. (epo:CleanVehicleDirectiveInformation)</skos:definition>
    <skos:prefLabel xml:lang="en">has Zero Emission Vehicles</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasUnitCode">
    <skos:prefLabel xml:lang="en">has Unit Code</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#concernsOriginatorRequest">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">concerns Originator Request</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#Fund">
    <skos:prefLabel xml:lang="en">Fund</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">A financial resource used to support the Procurement. Additional Information: In the context of EU, Funds can be divided into programmes, actions and projects. Examples of EU funds are: the European Structural and Investment Funds, European Social Fund (ESF), the Connecting Europe Facility (CEF) programme, or the ISA2 programme and its actions (e.g. Action 2016.05 European Public Procurement Initiative, which supports the eProcurement Ontology under sub-action 3). Funds may change between the lot and the contract, for example in the case of an emergency crisis, a contract may be financed by a budget that was not foreseen in the call.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 14/05/2019</skos:historyNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasManufacturerItemID">
    <skos:definition xml:lang="en">The general identifier assigned to the concept as defined by the Manufacturer. ​</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:historyNote xml:lang="en">WG Approval 16/05/2023</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Manufacturer Item ID</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#Subcontractor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">Subcontractor</skos:prefLabel>
    <skos:definition xml:lang="en">A Role of an Agent that has an agreement to perform part or all of the obligations of another Agents's Contract. Additional information For some Procedures, the Subcontractor signs as well the Contract between the Buyer and the Contractor. At tendering time, entities relied upon by the Economic Operators can be Subcontractors or not. When modelling ESPD we will analyze whether we need or not a Role named "relied upon".</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 05/08/2021</skos:historyNote>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#OfferingParty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#concernsAwardOutcome">
    <skos:prefLabel xml:lang="en">concerns Award Outcome</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasNetQuantity">
    <skos:definition xml:lang="en">The net quantity of the item that is contained in each consumable unit, excluding any packaging materials.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">has Net Quantity</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasReviewBodyType">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">has Review Body Type</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasReviewProcedure">
    <skos:definition xml:lang="en">The description of the method used to request the verification that the procedure has been carried out correctly. (epo:ReviewTerm)</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:historyNote xml:lang="en">WG Approval 09/11/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Review Procedure</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasLabelType">
    <skos:prefLabel xml:lang="en">has Label Type</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The label type such environmental, quality, social etc.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasCurrencyCodeListAgencyName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:historyNote xml:lang="en">WG Approval 13/04/2021</skos:historyNote>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">has Currency Code List Agency Name</skos:prefLabel>
    <skos:definition xml:lang="en">Name of the agency that maintains the currency code list used. (epo:MonetaryValue)</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasSubcontractorsProposedAboveObligation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The maximum percentage of the contract value that the contractor must subcontract. Additional information: This is used for the competitive procedure described in Title III of Directive 2009/81/EC. (epo:SubcontractTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 09/11/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Subcontractors Proposed Above Obligation</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasAmountValue">
    <skos:prefLabel xml:lang="en">has Amount Value</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The numeric value of the amount, including decimals. (epo:MonetaryValue)</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasThresholdValue">
    <skos:definition xml:lang="en">The cut-off level for a given concept. Additional Information: This value is given as e.g. a minimum score, a maximum number of tenders with the highest score passing (see codelist at-voc:number-threshold). (cccev:Constraint)</skos:definition>
    <skos:prefLabel xml:lang="en">has Threshold Value</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasDPSScope">
    <skos:definition xml:lang="en">Explanation as to whether a dps is used and by whom. The codelist to be used is at-voc:dps-usage which is available at http://publications.europa.eu/resource/dataset/dps-usage</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">has DPS Scope</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasContractConclusionDate">
    <skos:editorialNote xml:lang="en">Used by eForms BT-145</skos:editorialNote>
    <skos:historyNote xml:lang="en">WG Approval 09/01/2020</skos:historyNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel xml:lang="en">has Contract Conclusion Date</skos:prefLabel>
    <skos:definition xml:lang="en">The date the contract was signed by the last signatory party. &lt;u&gt;Additional Information:&lt;/u&gt; In exceptional cases contracts may be concluded without signature and therefore another date may be used. The date of contract conclusion is always later than the end of any standstill period. This concept is not to be confused with the date of completion/end of the contract. (epo:Contract)</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#announcesProcedure">
    <skos:prefLabel xml:lang="en">announces Procedure</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasMinimumMeasure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">has Minimum Measure</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#isSubjectToGrouping">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">is Subject To Grouping</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#isResponsibilityOfBuyer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">The buyer in charge of the procedure.</skos:definition>
    <skos:prefLabel xml:lang="en">is Responsibility Of Buyer</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasDespatchPeriod">
    <skos:prefLabel xml:lang="en">has Despatch Period</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">The time period when the Despatcher picks-up the Goods Items to be delivered.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 16/07/2024</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#ProcurementProcessInformation">
    <skos:definition xml:lang="en">Information about the temporal unfolding or succession of Procurement Objects.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">Procurement Process Information</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ContextDescription"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#ParticipationCondition">
    <skos:prefLabel xml:lang="en">Participation Condition</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ProcurementCriterion"/>
    <skos:definition xml:lang="en">Criterion that describes a Requirement to take part in a procurement.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:historyNote xml:lang="en">WG approval 30/05/2023</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasTaxIdentifier">
    <skos:prefLabel xml:lang="en">has Tax Identifier</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#StrategicProcurement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">Strategic Procurement</skos:prefLabel>
    <skos:editorialNote xml:lang="en">Used by eForms BG-713</skos:editorialNote>
    <skos:definition xml:lang="en">Public Procurement that contributes to achieving pressing policy goals. Additional Information: Specific strategic goals could be, for example, Environmental Protection, innovation, job creation and the development of small and medium enterprises. The subclasses are given by the choices in BT-06 Strategic Procurement. Based on https://legalinstruments.oecd.org/en/instruments/OECD-LEGAL-0411 (see paragraph on "background information".</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:historyNote xml:lang="en">WG Approval 10/03/2020</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasAllegedIrregularityType">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">has Alleged Irregularity Type</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasRoundingAmount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">has Rounding Amount</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#concernsLot">
    <skos:prefLabel xml:lang="en">concerns Lot</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Relates to Lot.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasNoNegotiationNecessary">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel xml:lang="en">has No Negotiation Necessary</skos:prefLabel>
    <skos:definition xml:lang="en">The buyer reserves the right to award the contract on the basis of the initial tenders without any further negotiations. Additional information: See Article 29(4) of Directive 2014/24/EU. (epo:MultipleStageProcedureTerm)</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasThresholdType">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">The method to interpret the threshold value as minimum or a maximum.</skos:definition>
    <skos:prefLabel xml:lang="en">has Threshold Type</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#signedByContractor">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">signed By Contractor</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasHazardousClassID">
    <skos:definition xml:lang="en">Specification of the hazardous nature of an item according to a classification schema. Provides detail of the classification and nature of a hazardous item.</skos:definition>
    <skos:prefLabel xml:lang="en">has Hazardous Class ID</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasMinimumShare">
    <skos:historyNote xml:lang="en">WG Approval 17/09/2019</skos:historyNote>
    <skos:definition xml:lang="en">The minimum proportion of something to be distributed. Additional Information: In the case of subcontracting the share may refer to the proportion of works, services or supplies being subcontracted. (epo:SubcontractTerm)</skos:definition>
    <skos:prefLabel xml:lang="en">has Minimum Share</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasNutsCode">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">has Nuts Code</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasPreferredLanguageForProcurementDocument">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">has Preferred Language For Procurement Document</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasApproximateGroupFrameworkAgreementValue">
    <skos:prefLabel xml:lang="en">has Approximate Group Framework Agreement Value</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasNonEEAReceivedTenders">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:definition xml:lang="en">The amount of tenders received from economic operators in non-EEA countries. (epo:SubmissionStatisticalInformation)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 12/12/2019</skos:historyNote>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">has Non EEA Received Tenders</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#providesDecisionFor">
    <skos:prefLabel xml:lang="en">provides Decision For</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#providesContractTotalPaymentValue">
    <skos:editorialNote xml:lang="en">Used by eForms BT-779</skos:editorialNote>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">provides Contract Total Payment Value</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasSubmissionURL">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:editorialNote xml:lang="en">Used by eForms BT-18, eForms BT-509</skos:editorialNote>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">has Submission URL</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasEstimatedValidityPeriod">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">has Estimated Validity Period</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasPlannedPeriod">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">has Planned Period</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#AdHocChannel">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/m8g/Channel"/>
    <skos:editorialNote xml:lang="en">Used by eForms BT-724</skos:editorialNote>
    <skos:historyNote xml:lang="en">WG Approval 10/01/2023</skos:historyNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">Ad Hoc Channel</skos:prefLabel>
    <skos:definition xml:lang="en">Web page where tools and devices for electronic communication that are not generally available can be downloaded free of charge.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasOptions">
    <skos:prefLabel xml:lang="en">has Options</skos:prefLabel>
    <skos:definition xml:lang="en">The buyer reserves the right (not an obligation) for additional purchases from the contractor (while the contract is valid). (epo:ContractTerm)</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasFrameworkAgreementMaximumValue">
    <skos:prefLabel xml:lang="en">has Framework Agreement Maximum Value</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#answersReviewRequest">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">answers Review Request</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#usesEvaluationFormula">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">uses Evaluation Formula</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasBuyerItemID">
    <skos:definition xml:lang="en">The general identifier assigned to the concept as defined by the Buyer.​</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 16/05/2023</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Buyer Item ID</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#AcquiringCentralPurchasingBody">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">Acquiring Central Purchasing Body</skos:prefLabel>
    <skos:definition xml:lang="en">Role of an Agent procuring activities conducted on a permanent basis in the form of the acquisition of supplies and/or services intended for other Buyers. Additional Information: In Public Procurement the Role of Acquiring Central Purchasing Body is carried out by a Central Purchasing Body for other Contracting Authorities.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 05/08/2021</skos:historyNote>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#CentralPurchasingBody"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasProcedureType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">has Procedure Type</skos:prefLabel>
    <skos:definition xml:lang="en">Identification of the Procedure used.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#isUsingEUFunds">
    <skos:definition xml:lang="en">The procurement foresees funding by the Union. Additional Information: The funding may cover the whole procurement or part of the procurement. For example the European Structural and Investment Funds or grants awarded by the European Union. (epo:ProcurementObject)</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">is Using EU Funds</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasScheme">
    <skos:prefLabel xml:lang="en">has Scheme</skos:prefLabel>
    <skos:definition xml:lang="en">The name of the identification scheme. (adms:Identifier)</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasElectronicTenders">
    <skos:historyNote xml:lang="en">WG Approval 28/07/2020</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Electronic Tenders</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Electronic Tender Lots received. (epo:SubmissionStatisticalInformation)</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#announcesPlannedProcurementPart">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">announces Planned Procurement Part</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#UniqueResponsibleOfTheProcurement">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AcquiringParty"/>
    <skos:prefLabel xml:lang="en">Unique Responsible Of The Procurement</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasCustomerReference">
    <skos:definition xml:lang="en">An identifier assigned by the Buyer used for internal routing purposes.</skos:definition>
    <skos:prefLabel xml:lang="en">has Customer Reference</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasMember">
    <skos:prefLabel xml:lang="en">has Member</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasOutstandingQuantity">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">has Outstanding Quantity</skos:prefLabel>
    <skos:historyNote xml:lang="en">WG Approval 05/06/2024</skos:historyNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">The Quantity of non-despatched Goods Items.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#OfflineAccessProvider">
    <skos:prefLabel xml:lang="en">Offline Access Provider</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AcquiringParty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">A Role of an Agent responsible for providing offline access to the Procurement Documents.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasOverallCostAwardCriteriaPonderation">
    <skos:definition xml:lang="en">The weighting given to cost. Additional Information: This weighting covers usually all cost criteria against price or quality criteria. (epo:AwardEvaluationTerm)</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">has Overall Cost Award Criteria Ponderation</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasMaximumParticipantsNumber">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:historyNote xml:lang="en">WG Approval 05/02/2019</skos:historyNote>
    <skos:editorialNote xml:lang="en">Used by eForms BT-113</skos:editorialNote>
    <skos:prefLabel xml:lang="en">has Maximum Participants Number</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:definition xml:lang="en">The maximum number of participants in the framework agreement. Additional Information: Maximum number of tenderers who may be awarded a contract within the framework agreement. The number is a positive integer. (epo:FrameworkAgreementTerm)</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasVehicleID">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">has Vehicle ID</skos:prefLabel>
    <skos:historyNote xml:lang="en">WG Approval 25/06/2024</skos:historyNote>
    <skos:definition xml:lang="en">The identifier of the Transport Means.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasContactPointInRole">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">has Contact Point In Role</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasURL">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:historyNote xml:lang="en">WG Approval 30/09/2019</skos:historyNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:definition xml:lang="en">The identifier of a resource. Additional Information For example: 1. The URL of the system from where to access the procurement documents; 2. The URL of the system for the submission of tender documents; 3. The URL of the system from where to download a tool to communicate with the Buyer; 4. The URL of the system used by a Technique to allow Economic Operators to exchange information with the Buyer (e.g. eAuction and DPS Systems) 5. The URL of the system used to exchange information between Buyer and EO for questions and clarifications; (cccev:Evidence) The identifier of a resource. Additional Information For example: 1. The URL of the system from where to access the procurement documents; 2. The URL of the system for the submission of tender documents; 3. The URL of the system from where to download a tool to communicate with the Buyer; 4. The URL of the system used by a Technique to allow Economic Operators to exchange information with the Buyer (e.g. eAuction and DPS Systems) 5. The URL of the system used to exchange information between Buyer and EO for questions and clarifications; (epo:Fund)</skos:definition>
    <skos:prefLabel xml:lang="en">has URL</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasUnknownUsageOfSelectionCriterionType">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">has Unknown Usage Of Selection Criterion Type</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasAssociatedDocument">
    <skos:prefLabel xml:lang="en">has Associated Document</skos:prefLabel>
    <skos:historyNote xml:lang="en">WG Approval 06/10/2024</skos:historyNote>
    <skos:definition xml:lang="en">Is related to a Document.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasLegalFormRequirement">
    <skos:definition xml:lang="en">The legal form to be taken by a Contractor. Additional Information: Generally, this is defined to cover the case where an Organisation Group is involved. Note that the codelist provided at national level should be used. (epo:ContractTerm)</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">has Legal Form Requirement</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#concernsInternationalProcurementInstrumentMeasure">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">concerns International Procurement Instrument Measure</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#isSubmittedBy">
    <skos:historyNote xml:lang="en">WG Approval 18/05/2021</skos:historyNote>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">is Submitted By</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Relation indicating the submission of a tender by an economic operator.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasLegalIdentifier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">has Legal Identifier</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasLanguage">
    <skos:prefLabel xml:lang="en">has Language</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Language in which the submitted information is to be expressed.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasUnofficialLanguage">
    <skos:definition xml:lang="en">The language translation(s) in which the instances of the given concepts are available. These linguistic versions are not an official translation, they are provided only for information.</skos:definition>
    <skos:prefLabel xml:lang="en">has Unofficial Language</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#describesProfession">
    <skos:historyNote xml:lang="en">WG Approval 02/05/2024</skos:historyNote>
    <skos:definition xml:lang="en">Explanatory text about the profession. (epo:ProfessionalSuitabilitySummary)</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel xml:lang="en">describes Profession</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasAmount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">has Amount</skos:prefLabel>
    <skos:historyNote xml:lang="en">WG Approval 26/07/2022</skos:historyNote>
    <skos:definition xml:lang="en">The predetermined monetary value charged in addition to the price.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#evaluatesProcurementCriterion">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">evaluates Procurement Criterion</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasPublicInterestExceptionJustification">
    <skos:prefLabel xml:lang="en">has Public Interest Exception Justification</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasSubcontractingObligation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">has Subcontracting Obligation</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The requirement the tender must meet with regard to subcontracting parts of the contract.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#TenderProcessor">
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AcquiringParty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">A Role of an Agent responsible for processing Tenders.</skos:definition>
    <skos:prefLabel xml:lang="en">Tender Processor</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasCurrencyCodeListAgencyID">
    <skos:historyNote xml:lang="en">WG Approval 13/04/2021</skos:historyNote>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Identifier of the agency that maintains the currency code list used. (epo:MonetaryValue)</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel xml:lang="en">has Currency Code List Agency ID</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasModificationJustification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">has Modification Justification</skos:prefLabel>
    <skos:definition xml:lang="en">Explanation of why a contract was modified. The codelist to be used is at-voc:modification-justification which is available at http://publications.europa.eu/resource/dataset/modification-justification</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#Mediator">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:historyNote xml:lang="en">WG approval 20/04/2021</skos:historyNote>
    <skos:definition xml:lang="en">A Role of an Agent that attempts to resolve a dispute between different Agents and come to an agreement.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AcquiringParty"/>
    <skos:prefLabel xml:lang="en">Mediator</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#definesTenderReceiver">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">defines Tender Receiver</skos:prefLabel>
    <skos:definition xml:lang="en">Relation indicating a SubmissionTerm has a TenderReceiver.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasItemConsumptionSavings">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">has Item Consumption Savings</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasMediumTenderPerLots">
    <skos:definition xml:lang="en">Tenders from medium-sized enterprise. &lt;u&gt;Additional Information:&lt;/u&gt; See Commission Recommendation 2003/361/EC. (epo:SubmissionStatisticalInformation)</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">has Medium Tender Per Lots</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasMaximumNumberOfCandidates">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:definition xml:lang="en">Maximum number of candidates to be invited for the second stage of the procedure. (epo:MultipleStageProcedureTerm)</skos:definition>
    <skos:prefLabel xml:lang="en">has Maximum Number Of Candidates</skos:prefLabel>
    <skos:historyNote xml:lang="en">WG Approval 22/08/2019</skos:historyNote>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasElectronicDigest">
    <skos:prefLabel xml:lang="en">has Electronic Digest</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#isAdvancedElectronicSignatureRequired">
    <skos:definition xml:lang="en">Advanced or qualified electronic signature or seal (as defined in Regulation (EU) No 910/2014) is required. The submitted information is required to be signed electronically. Additional Information: Signature can be defined as "data in electronic form which is attached to or logically associated with other data in electronic form and which is used by the signatory to sign. For more details on the meaning and uses of electronic signature you may consult different authoritative sources, a relevant one being for instance the Regulation (EU) 910/2014 on electronic identification and trust services for electronic transactions in the internal market. (epo:SubmissionTerm)</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:historyNote xml:lang="en">WG Approval 21/07/2020</skos:historyNote>
    <skos:prefLabel xml:lang="en">is Advanced Electronic Signature Required</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasBeneficialOwner">
    <skos:historyNote xml:lang="en">WG Approval 14/09/2021</skos:historyNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">A role of any natural person(s) who ultimately owns or controls the organisation or on whose behalf a transaction or activity is being conducted. Additional Information: This role is defined in the directive EU 2015/849 and it's beyond the scope for public eProcurement domain.</skos:definition>
    <skos:prefLabel xml:lang="en">has Beneficial Owner</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasFormNumber">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:definition xml:lang="en">The number of the form used to create the Standard Form Notice and not an eForms Notice. (epo:Notice)</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:historyNote xml:lang="en">WG approval 26/03/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Form Number</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#isSupportedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">is Supported By</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasConfidentialityJustification">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:historyNote xml:lang="en">WG Approval 09/11/2021</skos:historyNote>
    <skos:definition xml:lang="en">A narrative explanation of why data is not published. Additional Information: This element is generally used when the non-publication-justification code chosen is "other". (epo:NonPublishedInformation)</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel xml:lang="en">has Confidentiality Justification</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasQualificationSystemDuration">
    <skos:prefLabel xml:lang="en">has Qualification System Duration</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasMaximumValue">
    <skos:prefLabel xml:lang="en">has Maximum Value</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasInternetAddress">
    <skos:prefLabel xml:lang="en">has Internet Address</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The main web page used by the instance of the concept. (org:Organization) The main web page used by the instance of the concept. (cpov:ContactPoint)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 01/06/2023</skos:historyNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#needsToBeAWinner">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The Contractor must be a Winner.</skos:definition>
    <skos:prefLabel xml:lang="en">needs To Be A Winner</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#playedBy">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">played By</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasLegalBasisDescription">
    <skos:prefLabel xml:lang="en">has Legal Basis Description</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:definition xml:lang="en">Explanatory text about the legal basis. (epo:ProcurementObject)</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:historyNote xml:lang="en">WG Approval 02/05/2024</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasEUReceivedTenders">
    <skos:definition xml:lang="en">The amount of tenders received from economic operators in other EU countries other than the country of the buyer. (epo:SubmissionStatisticalInformation)</skos:definition>
    <skos:prefLabel xml:lang="en">has EU Received Tenders</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasNumberOfTenderersInvited">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:definition xml:lang="en">Number of economic operators invited to tender. Additional Information This may be used for single-stage procedures or to indicate the number of candidates invited to tender in multi-stage procedures. (epo:SubmissionStatisticalInformation)</skos:definition>
    <skos:prefLabel xml:lang="en">has Number Of Tenderers Invited</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:historyNote xml:lang="en">WG Approval 01/12/2020</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasMaximumNumberOfLotsToBeAwarded">
    <skos:definition xml:lang="en">The maximum number of lots for which contract(s) can be awarded to one tenderer. Additional information: This field is used to complement the SubmissionTerms (which are at the Lot level) for the Procedure level which is covered by the regulation (EU)-2015-1986 (modeled in the TED Standard Forms). (epo:ProcedureTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 22/08/2019</skos:historyNote>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">has Maximum Number Of Lots To Be Awarded</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasUnitDescription">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel xml:lang="en">has Unit Description</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">A narrative explanation defining the units of items being counted Additional information: This could be for example individual items or pack or two. (epo:Quantity)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 09/11/2021</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#ProcurementCriteriaSummary">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/m8g/Requirement"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:historyNote xml:lang="en">WG approval 19/03/2024</skos:historyNote>
    <skos:definition xml:lang="en">Overview of the Procurement Criteria.</skos:definition>
    <skos:prefLabel xml:lang="en">Procurement Criteria Summary</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#Notice">
    <skos:definition xml:lang="en">Document published by the Buyer about market opportunities and results.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 23/05/2019</skos:historyNote>
    <skos:prefLabel xml:lang="en">Notice</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#concernsLotGroup">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">concerns Lot Group</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#Prize">
    <skos:historyNote xml:lang="en">WG approval: 15/04/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">Prize</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A reward given in a Contest.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasEstimatedTotalSubcontracts">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:historyNote xml:lang="en">WG Approval 09/11/2021</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Estimated Total Subcontracts</skos:prefLabel>
    <skos:definition xml:lang="en">The estimated amount of work to be subcontracted in the contract resulting from the lot. (epo:SubmissionStatisticalInformation)</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#Project">
    <skos:prefLabel xml:lang="en">Project</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A collaborative enterprise that is carefully planned to achieve a particular aim.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasAwardedValue">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:historyNote xml:lang="en">WG Approval 10/12/2019</skos:historyNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">The value of the procurement provided by the Award Decision. Additional Information: Different cases of awarded values may refer to a lot, the global value of the procedure, or of a combinatorial value of a group of lots. In the case of framework agreements and dynamic purchasing systems this refers to the maximum awarded value.</skos:definition>
    <skos:prefLabel xml:lang="en">has Awarded Value</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasTotalNumberOfComplainants">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:historyNote xml:lang="en">WG Approval 11/04/2019</skos:historyNote>
    <skos:definition xml:lang="en">The number of economic operators that requested the buyer to review any of its decisions (e.g. the technical specifications, award decision), as set out in Art. 1(5) of Directive 89/665/EEC and Directive 92/13/EEC. (epo:ReviewRequestSummary)</skos:definition>
    <skos:prefLabel xml:lang="en">has Total Number Of Complainants</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:editorialNote xml:lang="en">Used by eForms BT-712</skos:editorialNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasConfirmedIrregularityType">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">has Confirmed Irregularity Type</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasReviewRequestFee">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:editorialNote xml:lang="en">Used by eForms BT-795</skos:editorialNote>
    <skos:prefLabel xml:lang="en">has Review Request Fee</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#Contractor">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#OfferingParty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">Contractor</skos:prefLabel>
    <skos:historyNote xml:lang="en">WG approval 08/11/2022</skos:historyNote>
    <skos:definition xml:lang="en">The Role of an Agent that has signed a Contract with a Buyer.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#announcesRole">
    <skos:prefLabel xml:lang="en">announces Role</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#isRecurrent">
    <skos:definition xml:lang="en">The Procurement being notified is likely to be included in another procedure in the foreseeable future. Additional Information: For example, a regularly re-tendered municipal service. This does not include awarding multiple contracts within a single qualification system, framework agreement, or a dynamic purchasing system. (epo:ProcurementObject)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 12/05/2020</skos:historyNote>
    <skos:editorialNote xml:lang="en">Used by eForms BT-94</skos:editorialNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">is Recurrent</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#specifiesPlaceOfDespatch">
    <skos:prefLabel xml:lang="en">specifies Place Of Despatch</skos:prefLabel>
    <skos:historyNote xml:lang="en">WG Approval 25/06/2024</skos:historyNote>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Relation indicating the Location of the Despatch of the Goods Items to be delivered.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#associatedWith">
    <skos:definition xml:lang="en">The document to which a document is associated.</skos:definition>
    <skos:prefLabel xml:lang="en">associated With</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:historyNote xml:lang="en">WG Approval 01/03/2022</skos:historyNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasMaximumNumberOfRenewals">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel xml:lang="en">has Maximum Number Of Renewals</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">The maximum number of times the contract can be renewed. Additional Information By renewing, the buyer reserves the right (i.e. not an obligation) to renew the contract (i.e. extend its duration) without a new procurement procedure. For example, a contract may be valid for one year and the buyer may keep a possibility to renew it (e.g. once, twice) for another three months, if he is content with the services he received. PLEASE REVIEW THIS DEFINITION AGAIN WITH THE WORKING GROUP. It was originally taken from eForms. (epo:ContractTerm)</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#refersToContract">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">refers To Contract</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#ExclusionGroundsSummary">
    <skos:prefLabel xml:lang="en">Exclusion Grounds Summary</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">Overview of the Exclusion Grounds.</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 19/03/2024</skos:historyNote>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#QualificationCriteriaSummary"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasInternalIdentifier">
    <skos:prefLabel xml:lang="en">has Internal Identifier</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:editorialNote xml:lang="en">Used by eForms BT-22</skos:editorialNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#usesCleanVehicleDirective">
    <skos:definition xml:lang="en">The procurement falls within the scope of the European Parliament and Council 2009/33/EC (Clean Vehicles Directive – CVD). (epo:GreenProcurement)</skos:definition>
    <skos:prefLabel xml:lang="en">uses Clean Vehicle Directive</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasTotalTaxExclusiveAmount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">has Total Tax Exclusive Amount</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#isWithdrawn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:editorialNote xml:lang="en">Used by eForms BT-796</skos:editorialNote>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">is Withdrawn</skos:prefLabel>
    <skos:definition xml:lang="en">The review request was withdrawn. (epo:ReviewDecision)</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#describesVerificationMethod">
    <skos:historyNote xml:lang="en">WG Approval 02/05/2024</skos:historyNote>
    <skos:definition xml:lang="en">General explanatory text on the means used to validate the Participation Conditions. (epo:ParticipationConditionsSummary)</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel xml:lang="en">describes Verification Method</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#fulfillsStrategicProcurement">
    <skos:prefLabel xml:lang="en">fulfills Strategic Procurement</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#isJuryDecisionBinding">
    <skos:prefLabel xml:lang="en">is Jury Decision Binding</skos:prefLabel>
    <skos:definition xml:lang="en">Indicates whether the procuring entity is bound to apply the decision of the jury. (epo:DesignContestRegimeTerm)</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasRecurrenceDescription">
    <skos:historyNote xml:lang="en">WG Approval 16/01/2019</skos:historyNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">has Recurrence Description</skos:prefLabel>
    <skos:definition xml:lang="en">Any additional information about the recurrence of the Procurement. Additional Information: For example estimated timing of the Procedure. (epo:ProcurementObject)</skos:definition>
    <skos:editorialNote xml:lang="en">Used by eForms BT-95</skos:editorialNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#specifiesProcurementCriteriaSummary">
    <skos:prefLabel xml:lang="en">specifies Procurement Criteria Summary</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#appliesForeignSubsidiesRegulation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel xml:lang="en">applies Foreign Subsidies Regulation</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#concernsReviewDecision">
