    <skos:prefLabel xml:lang="en">is Security Clearance Required</skos:prefLabel>
    <skos:definition xml:lang="en">Security Clearance is needed. (epo:SecurityClearanceTerm)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 02/05/2024</skos:historyNote>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#updatesContractValue">
    <skos:prefLabel xml:lang="en">updates Contract Value</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasVersion">
    <skos:definition xml:lang="en">A number that identifies a specific state of a document. (epo:Document)</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel xml:lang="en">has Version</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:historyNote xml:lang="en">WG approval 18/11/2021</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#ContractLotCompletionInformation">
    <skos:prefLabel xml:lang="en">Contract Lot Completion Information</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ContextDescription"/>
    <skos:definition xml:lang="en">Information related to a given Lot at the end of the procurement.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasMainClassification">
