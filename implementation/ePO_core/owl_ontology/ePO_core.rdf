  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasOpeningPlace">
    <skos:historyNote xml:lang="en">WG Approval 06/03/2025</skos:historyNote>
    <skos:definition xml:lang="en">The place (e.g. physical address, URL) where the tenders will be publicly opened. (epo:OpeningTerm)</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">has Opening Place</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasReceivedTenders">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:prefLabel xml:lang="en">has Received Tenders</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:historyNote xml:lang="en">WG Approval 12/12/2019</skos:historyNote>
    <skos:definition xml:lang="en">The total amount of tenders received. (epo:SubmissionStatisticalInformation)</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasPerformingStaffQualificationInformation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <skos:definition xml:lang="en">Explanation as to if and/or when information of the persons to carry out the contract is to be provided. The codelist to be used is at-voc:requirement-stage which is available at http://publications.europa.eu/resource/dataset/requirement-stage</skos:definition>
    <skos:prefLabel xml:lang="en">has Performing Staff Qualification Information</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#announcesCompletionOfContract">
