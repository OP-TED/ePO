    sh:nodeKind sh:IRI ;
    sh:path epo:hasHighestReceivedTenderValue ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasHighestReceivedTenderValue> ?that . ?that <http://data.europa.eu/a4g/ontology#hasHighestReceivedTenderValue> ?this .}" ] .

