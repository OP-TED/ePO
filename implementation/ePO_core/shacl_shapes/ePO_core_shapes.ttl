@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix epo: <http://data.europa.eu/a4g/ontology#> .
@prefix epo-shape: <http://data.europa.eu/a4g/data-shape#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

epo-shape:adms-Identifier sh:property epo-shape:adms-Identifier-epo-hasExtension,
        epo-shape:adms-Identifier-epo-hasScheme,
        epo-shape:adms-Identifier-epo-hasSchemeVersion .

epo-shape:cccev-Constraint sh:property epo-shape:cccev-Constraint-epo-hasThresholdType,
        epo-shape:cccev-Constraint-epo-hasThresholdValue .

epo-shape:cccev-Criterion-dct-type a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:class skos:Concept ;
    sh:nodeKind sh:IRI ;
    sh:path dcterms:type .

epo-shape:cccev-Evidence sh:property epo-shape:cccev-Evidence-epo-hasURL,
        epo-shape:cccev-Evidence-epo-hasValidityPeriod .

epo-shape:cccev-Evidence-cccev-confidentialityLevelType a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:class skos:Concept ;
    sh:nodeKind sh:IRI ;
    sh:path <http://data.europa.eu/m8g/confidentialityLevelType> .

epo-shape:cccev-InformationRequirement sh:property epo-shape:cccev-InformationRequirement-epo-concernsLot,
        epo-shape:cccev-InformationRequirement-epo-concernsLotGroup,
        epo-shape:cccev-InformationRequirement-epo-concernsProcedure,
        epo-shape:cccev-InformationRequirement-epo-hasConstraint .

epo-shape:cpov-ContactPoint sh:property epo-shape:cpov-ContactPoint-epo-hasContactName,
        epo-shape:cpov-ContactPoint-epo-hasFax,
        epo-shape:cpov-ContactPoint-epo-hasInternetAddress .

epo-shape:cv-Channel sh:property epo-shape:cv-Channel-epo-hasAddressURL,
        epo-shape:cv-Channel-epo-hasEndpointIdentifier .

epo-shape:dct-Location sh:property epo-shape:dct-Location-epo-hasCountryCode,
        epo-shape:dct-Location-epo-hasNutsCode .

epo-shape:eli-LegalExpression-dct-language a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:class skos:Concept ;
    sh:nodeKind sh:IRI ;
    sh:path dcterms:language .

epo-shape:epo-AccessTermShape a sh:NodeShape ;
    rdfs:label "Access Term" ;
    rdfs:comment "Conditions and stipulations about where and how to access the Procurement Documents." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-AccessTerm-epo-definesCatalogueProvider,
        epo-shape:epo-AccessTerm-epo-definesCatalogueReceiver,
        epo-shape:epo-AccessTerm-epo-definesOfflineAccessProvider,
        epo-shape:epo-AccessTerm-epo-definesProcurementProcedureInformationProvider,
        epo-shape:epo-AccessTerm-epo-hasAdditionalInformationDeadline,
        epo-shape:epo-AccessTerm-epo-hasDocumentRestrictionJustification,
        epo-shape:epo-AccessTerm-epo-hasPublicAccessURL,
        epo-shape:epo-AccessTerm-epo-hasRestrictedAccessURL,
        epo-shape:epo-AccessTerm-epo-involvesProcurementDocument,
        epo-shape:epo-AccessTerm-epo-isProcurementDocumentRestricted,
        epo-shape:epo-AccessTerm-epo-providesProcurementDocumentsInOfficialLanguage,
        epo-shape:epo-AccessTerm-epo-providesProcurementDocumentsInUnofficialLanguage,
        epo-shape:epo-AccessTerm-epo-refersToPlannedPart ;
    sh:targetClass epo:AccessTerm .

epo-shape:epo-AcquiringCentralPurchasingBodyShape a sh:NodeShape ;
    rdfs:label "Acquiring Central Purchasing Body" ;
    rdfs:comment "Role of an Agent procuring activities conducted on a permanent basis in the form of the acquisition of supplies and/or services intended for other Buyers. Additional Information: In Public Procurement the Role of Acquiring Central Purchasing Body is carried out by a Central Purchasing Body for other Contracting Authorities." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:targetClass epo:AcquiringCentralPurchasingBody .

epo-shape:epo-AcquiringPartyShape a sh:NodeShape ;
    rdfs:label "Acquiring Party" ;
    rdfs:comment "The Role of an Agent that acts on the buying side of a Procurement Process." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:targetClass epo:AcquiringParty .

epo-shape:epo-AdHocChannelShape a sh:NodeShape ;
    rdfs:label "Ad Hoc Channel" ;
    rdfs:comment "Web page where tools and devices for electronic communication that are not generally available can be downloaded free of charge." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:targetClass epo:AdHocChannel .

epo-shape:epo-AgentInRoleShape a sh:NodeShape ;
    rdfs:label "Agent In Role" ;
    rdfs:comment "Relative concept that ties an Agent to a part they play in a given Situational Context. Additional information: The classification of roles is based is based on the degree of involvement into the Procurement Process: - Primary (Procurement) Pole is directly involved in the Procurement Process; - Secondary (Procurement sub-) Role is secondary to the Procurement Process - Tertiary (Related) Role is not involved in the Procurement Process." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-AgentInRole-epo-contextualisedBy,
        epo-shape:epo-AgentInRole-epo-exposesChannel,
        epo-shape:epo-AgentInRole-epo-hasContactPointInRole,
        epo-shape:epo-AgentInRole-epo-playedBy ;
    sh:targetClass epo:AgentInRole .

epo-shape:epo-AuxiliaryPartyShape a sh:NodeShape ;
    rdfs:label "Auxiliary Party" ;
    rdfs:comment "Role of an Agent who may be mentioned in the information exchanged during the Procurement Process but who does not play an active part in it." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-AuxiliaryParty-epo-providesDocumentation ;
    sh:targetClass epo:AuxiliaryParty .

epo-shape:epo-AwardCriteriaSummaryShape a sh:NodeShape ;
    rdfs:label "Award Criteria Summary" ;
    rdfs:comment "Overview of the Award Criteria." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:targetClass epo:AwardCriteriaSummary .

epo-shape:epo-AwardCriterionShape a sh:NodeShape ;
    rdfs:label "Award Criterion" ;
    rdfs:comment "Criterion that describes a Requirement that the Tender needs to resolve and on which the Tender is evaluated and ranked." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-AwardCriterion-epo-hasAwardCriteriaStatedInProcurementDocuments,
        epo-shape:epo-AwardCriterion-epo-hasAwardCriterionType,
        epo-shape:epo-AwardCriterion-epo-hasFixedValue,
        epo-shape:epo-AwardCriterion-epo-hasFixedValueType ;
    sh:targetClass epo:AwardCriterion .

epo-shape:epo-AwardDecisionShape a sh:NodeShape ;
    rdfs:label "Award Decision" ;
    rdfs:comment "Resolution of the Buyer as to the result of the Procurement Procedure." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-AwardDecision-epo-comprisesAwardOutcome,
        epo-shape:epo-AwardDecision-epo-hasAwardDecisionDate ;
    sh:targetClass epo:AwardDecision .

epo-shape:epo-AwardEvaluationTermShape a sh:NodeShape ;
    rdfs:label "Award Evaluation Term" ;
    rdfs:comment "Conditions and stipulations defining particularities of the evaluation of Award Criteria." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-AwardEvaluationTerm-epo-hasAwardCriteriaEvaluationFormula,
        epo-shape:epo-AwardEvaluationTerm-epo-hasAwardCriteriaOrderJustification,
        epo-shape:epo-AwardEvaluationTerm-epo-hasOverallCostAwardCriteriaPonderation,
        epo-shape:epo-AwardEvaluationTerm-epo-hasOverallPriceAwardCriteriaPonderation,
        epo-shape:epo-AwardEvaluationTerm-epo-hasOverallQualityAwardCriteriaPonderation ;
    sh:targetClass epo:AwardEvaluationTerm .

epo-shape:epo-AwardOutcomeShape a sh:NodeShape ;
    rdfs:label "Award Outcome" ;
    rdfs:comment "Result concerning the competition that was attributed by the Awarder." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-AwardOutcome-epo-comprisesTenderAwardOutcome,
        epo-shape:epo-AwardOutcome-epo-hasAwardJustification,
        epo-shape:epo-AwardOutcome-epo-hasAwardStatus,
        epo-shape:epo-AwardOutcome-epo-hasAwardedValue,
        epo-shape:epo-AwardOutcome-epo-hasBargainPrice,
        epo-shape:epo-AwardOutcome-epo-hasNonAwardJustification ;
    sh:targetClass epo:AwardOutcome .

epo-shape:epo-AwarderShape a sh:NodeShape ;
    rdfs:label "Awarder" ;
    rdfs:comment "A Role of an Agent that signs the Award Decision. Additional information: BT-08 can be Awarding CBP; BG-03 is the Buyer. But Awarding CPB is not the same as the Buyer; the organisations may differ for these roles. Having the Awarder Role allows us to specify which Organisation is involved in the Award Decision." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:targetClass epo:Awarder .

epo-shape:epo-AwardingCentralPurchasingBodyShape a sh:NodeShape ;
    rdfs:label "Awarding Central Purchasing Body" ;
    rdfs:comment "Role of an Agent procuring activities conducted on a permanent basis in the form of the award of Public Contracts or the conclusion of Framework Agreements for works, supplies or services intended for other Buyers. Additional Information: In Public Procurement the Role of Awarding Central purchasing Body is carried out by a Central Purchasing Body for other Contracting Authorities." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:targetClass epo:AwardingCentralPurchasingBody .

epo-shape:epo-BudgetProviderShape a sh:NodeShape ;
    rdfs:label "Budget Provider" ;
    rdfs:comment "A role of an agent whose Budget is used to pay for the Contract." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:targetClass epo:BudgetProvider .

epo-shape:epo-BusinessShape a sh:NodeShape ;
    rdfs:label "Business" ;
    rdfs:comment "A private law company registered in a national registry." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-Business-epo-hasBeneficialOwner,
        epo-shape:epo-Business-epo-hasBusinessSize,
        epo-shape:epo-Business-epo-isListedCompany ;
    sh:targetClass epo:Business .

epo-shape:epo-BuyerShape a sh:NodeShape ;
    rdfs:label "Buyer" ;
    rdfs:comment "A Role of an Agent that awards a Contract and/or purchases items. Additional information: In Public Procurement the Role of Buyer is carried out by the following types of Organisation: Contracting Authority, Contracting Entity, a defense Contractor, an international Organisation, or an organisation awarding a Contract subsidized by a Contracting Authority. In Pre-Award, the Buyer generally awards the Contract, however future purchasers may be foreseen. In Post-Award the buyer generally refers to the purchaser of items." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-Buyer-epo-delegatesAncillaryActivitiesTo,
        epo-shape:epo-Buyer-epo-hasActivityDescription,
        epo-shape:epo-Buyer-epo-hasBuyerProfile,
        epo-shape:epo-Buyer-epo-isContractingEntity ;
    sh:targetClass epo:Buyer .

epo-shape:epo-CandidateShape a sh:NodeShape ;
    rdfs:label "Candidate" ;
    rdfs:comment "The Role of an Agent that has sought an invitation or has been invited to take part in a restricted Procedure, in a competitive Procedure with negotiation, in a negotiated Procedure without prior publication, in a competitive dialogue or in an innovation partnership." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:targetClass epo:Candidate .

epo-shape:epo-CatalogueProviderShape a sh:NodeShape ;
    rdfs:label "Catalogue Provider" ;
    rdfs:comment "A Role of an Agent compiling and supplying a Catalogue. Additional Information: The Catalogue Provider Role is usually played by the Agent that acts as a Seller, or by another Agent that acts on behalf of the Seller." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:targetClass epo:CatalogueProvider .

epo-shape:epo-CatalogueReceiverShape a sh:NodeShape ;
    rdfs:label "Catalogue Receiver" ;
    rdfs:comment "A Role of an Agent processing a Catalogue. Additional Information: The Catalogue Receiver may not only receive it but also validate it, process it, etc. The Catalogue Receiver role is usually played by the agent that acts as a Buyer, or by another Agent that acts on behalf of the Buyer." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:targetClass epo:CatalogueReceiver .

epo-shape:epo-CentralPurchasingBodyShape a sh:NodeShape ;
    rdfs:label "Central Purchasing Body" ;
    rdfs:comment "Role of an Agent that provides centralised purchasing activities and, possibly, ancillary purchasing activities for other Buyers. Additional Information: In Public Procurement the Role of Central Purchasing Body is carried out by a Contracting Authority for other Contracting Authorities. Contracting Authority procuring activities conducted on a permanent basis, in one of the following forms:[...](b) the award of Public Contracts or the conclusion of Framework Agreements for works, supplies or services intended for Contracting Authorities;" ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:targetClass epo:CentralPurchasingBody .

epo-shape:epo-CertificateShape a sh:NodeShape ;
    rdfs:label "Certificate" ;
    rdfs:comment "Proof of conformance of the instance of the concept to a defined set of criteria. Additional Information: Certificates provide assurance of credibility, trust, and transparency in the procurement process." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-Certificate-epo-attestedByLabel,
        epo-shape:epo-Certificate-epo-hasCertificationNumber,
        epo-shape:epo-Certificate-epo-issuedByCertifier ;
    sh:targetClass epo:Certificate .

epo-shape:epo-CertificationLabelShape a sh:NodeShape ;
    rdfs:label "Certification Label" ;
    rdfs:comment "Concept that stands for a set of norms, expectations, standards and policies. Additional Information: Such standards may relate to social, ethical and quality etc." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-CertificationLabel-epo-hasLabelType,
        epo-shape:epo-CertificationLabel-epo-hasReferenceURI ;
    sh:targetClass epo:CertificationLabel .

epo-shape:epo-CertifierShape a sh:NodeShape ;
    rdfs:label "Certifier" ;
    rdfs:comment "The role of an agent who issues a certificate. Additional Information: The certifier is responsible for verifying and confirming the conformance of the instance of the concept to a defined set of criteria." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:targetClass epo:Certifier .

epo-shape:epo-ChangeInformationShape a sh:NodeShape ;
    rdfs:label "Change Information" ;
    rdfs:comment "Alteration to previously provided details." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-ChangeInformation-epo-concernsNotice,
        epo-shape:epo-ChangeInformation-epo-hasAdditionalInformation,
        epo-shape:epo-ChangeInformation-epo-hasChangeDescription,
        epo-shape:epo-ChangeInformation-epo-hasChangeJustification,
        epo-shape:epo-ChangeInformation-epo-hasChangeReasonDescription,
        epo-shape:epo-ChangeInformation-epo-hasProcurementDocumentChangeDate,
        epo-shape:epo-ChangeInformation-epo-isProcurementDocumentChanged,
        epo-shape:epo-ChangeInformation-epo-refersToPreviousNotice,
        epo-shape:epo-ChangeInformation-epo-relatesToEFormSectionIdentifier ;
    sh:targetClass epo:ChangeInformation .

epo-shape:epo-CleanVehicleDirectiveInformationShape a sh:NodeShape ;
    rdfs:label "Clean Vehicle Directive Information" ;
    rdfs:comment "Information related to clean vehicles legislation. Additional information: In the European Union, the legislation concerned is the European Parliament and Council 2009/33/EC (Clean Vehicles Directive – CVD)." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-CleanVehicleDirectiveInformation-epo-concernsGreenProcurement,
        epo-shape:epo-CleanVehicleDirectiveInformation-epo-hasCleanVehicles,
        epo-shape:epo-CleanVehicleDirectiveInformation-epo-hasTotalVehicles,
        epo-shape:epo-CleanVehicleDirectiveInformation-epo-hasZeroEmissionVehicles,
        epo-shape:epo-CleanVehicleDirectiveInformation-epo-specifiesCleanVehicleDirectiveContractType,
        epo-shape:epo-CleanVehicleDirectiveInformation-epo-specifiesCleanVehicleDirectiveVehicleCategory ;
    sh:targetClass epo:CleanVehicleDirectiveInformation .

epo-shape:epo-ConcessionContractShape a sh:NodeShape ;
    rdfs:label "Concession Contract" ;
    rdfs:comment "A Contract between one or more Buyers and one or more Economic Operators giving the right to the Economic Operators to exploit the rights foreseen in the Contract which may include the receipt of Payments." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-ConcessionContract-epo-resultsFromLotAwardOutcome ;
    sh:targetClass epo:ConcessionContract .

epo-shape:epo-ConcessionEstimateShape a sh:NodeShape ;
    rdfs:label "Concession Estimate" ;
    rdfs:comment "Approximation concerning the foreseen Concession Contract." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-ConcessionEstimate-epo-hasCalculationMethod,
        epo-shape:epo-ConcessionEstimate-epo-hasConcessionEstimatedValue,
        epo-shape:epo-ConcessionEstimate-epo-hasEstimatedBuyerConcessionRevenue,
        epo-shape:epo-ConcessionEstimate-epo-hasEstimatedUserConcessionRevenue ;
    sh:targetClass epo:ConcessionEstimate .

epo-shape:epo-ContextDescriptionShape a sh:NodeShape ;
    rdfs:label "Context Description" ;
    rdfs:comment "A description concerning a Procurement Object or a Notice in a specific Situation Context. Additional Information: The description has its own identity (+I) but is dependent (+D) on the concerned Entity. We say that ContextDescription *concerns* an Entity." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:targetClass epo:ContextDescription .

epo-shape:epo-ContextualProjectionShape a sh:NodeShape ;
    rdfs:label "Contextual Projection" ;
    rdfs:comment "Projection of an Entity and all of its properties that hold in a given Situation Context. Additional Information: The contextual projection does not have its own identity (-I), is dependent (+D) on the described Entity, and is anti-rigid (~R) We say that ContextualProjection *describes* an Entity. Adaptation of ContextSlices pattern encoding a 4D view. http://ontologydesignpatterns.org/wiki/Submissions:Context_Slices" ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:targetClass epo:ContextualProjection .

epo-shape:epo-ContractLotCompletionInformationShape a sh:NodeShape ;
    rdfs:label "Contract Lot Completion Information" ;
    rdfs:comment "Information related to a given Lot at the end of the procurement." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-ContractLotCompletionInformation-epo-concernsLot,
        epo-shape:epo-ContractLotCompletionInformation-epo-concernsLotGroup,
        epo-shape:epo-ContractLotCompletionInformation-epo-hasPaymentValueDiscrepancyJustification,
        epo-shape:epo-ContractLotCompletionInformation-epo-providesContractTotalPaymentValue,
        epo-shape:epo-ContractLotCompletionInformation-epo-providesContractTotalPenaltyValue,
        epo-shape:epo-ContractLotCompletionInformation-epo-refersToContract ;
    sh:targetClass epo:ContractLotCompletionInformation .

epo-shape:epo-ContractShape a sh:NodeShape ;
    rdfs:label "Contract" ;
    rdfs:comment "A voluntary, deliberate, and legally binding agreement between two or more competent parties." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-Contract-epo-bindsBuyer,
        epo-shape:epo-Contract-epo-bindsContractor,
        epo-shape:epo-Contract-epo-hasContractConclusionDate,
        epo-shape:epo-Contract-epo-hasContractValue,
        epo-shape:epo-Contract-epo-hasEntryIntoForceDate,
        epo-shape:epo-Contract-epo-hasLotReference,
        epo-shape:epo-Contract-epo-hasPurpose,
        epo-shape:epo-Contract-epo-includesTender,
        epo-shape:epo-Contract-epo-isFundedBy,
        epo-shape:epo-Contract-epo-isSubjectToTerm,
        epo-shape:epo-Contract-epo-ord-hasTaxInformation,
        epo-shape:epo-Contract-epo-signedByBuyer,
        epo-shape:epo-Contract-epo-signedByContractor,
        epo-shape:epo-Contract-epo-specifiesDeliverable ;
    sh:targetClass epo:Contract .

epo-shape:epo-ContractTermShape a sh:NodeShape ;
    rdfs:label "Contract Term" ;
    rdfs:comment "Conditions and stipulations defining particularities of the Post Award Phase." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-ContractTerm-epo-definesContractDuration,
        epo-shape:epo-ContractTerm-epo-definesContractPeriod,
        epo-shape:epo-ContractTerm-epo-definesEstimatedContractDuration,
        epo-shape:epo-ContractTerm-epo-definesPaymentExecutor,
        epo-shape:epo-ContractTerm-epo-definesSpecificPlaceOfPerformance,
        epo-shape:epo-ContractTerm-epo-definesSubcontractingTerm,
        epo-shape:epo-ContractTerm-epo-hasAdditionalContractNature,
        epo-shape:epo-ContractTerm-epo-hasBroadPlaceOfPerformance,
        epo-shape:epo-ContractTerm-epo-hasContractNatureType,
        epo-shape:epo-ContractTerm-epo-hasEInvoicing,
        epo-shape:epo-ContractTerm-epo-hasEInvoicingPermission,
        epo-shape:epo-ContractTerm-epo-hasEOrdering,
        epo-shape:epo-ContractTerm-epo-hasEPayment,
        epo-shape:epo-ContractTerm-epo-hasLegalFormRequirement,
        epo-shape:epo-ContractTerm-epo-hasMaximumNumberOfRenewals,
        epo-shape:epo-ContractTerm-epo-hasOptions,
        epo-shape:epo-ContractTerm-epo-hasOptionsDescription,
        epo-shape:epo-ContractTerm-epo-hasPaymentArrangement,
        epo-shape:epo-ContractTerm-epo-hasPerformanceConditions,
        epo-shape:epo-ContractTerm-epo-hasPerformingStaffQualificationInformation,
        epo-shape:epo-ContractTerm-epo-hasPlaceOfPerformanceAdditionalInformation,
        epo-shape:epo-ContractTerm-epo-hasRenewalDescription,
        epo-shape:epo-ContractTerm-epo-hasReservedExecution,
        epo-shape:epo-ContractTerm-epo-isRenewalIndicator ;
    sh:targetClass epo:ContractTerm .

epo-shape:epo-ContractorShape a sh:NodeShape ;
    rdfs:label "Contractor" ;
    rdfs:comment "The Role of an Agent that has signed a Contract with a Buyer." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-Contractor-epo-foreseesSubcontractor,
        epo-shape:epo-Contractor-epo-hasSubcontractor,
        epo-shape:epo-Contractor-epo-needsToBeAWinner ;
    sh:targetClass epo:Contractor .

epo-shape:epo-DesignContestRegimeTermShape a sh:NodeShape ;
    rdfs:label "Design Contest Regime Term" ;
    rdfs:comment "Conditions and stipulations defining particularities of a Design Contest." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-DesignContestRegimeTerm-epo-definesPrize,
        epo-shape:epo-DesignContestRegimeTerm-epo-hasDescriptionOfPrizes,
        epo-shape:epo-DesignContestRegimeTerm-epo-hasFollowupContract,
        epo-shape:epo-DesignContestRegimeTerm-epo-hasFollowupContractInformation,
        epo-shape:epo-DesignContestRegimeTerm-epo-hasParticipationPayment,
        epo-shape:epo-DesignContestRegimeTerm-epo-isJuryDecisionBinding ;
    sh:targetClass epo:DesignContestRegimeTerm .

epo-shape:epo-DirectAwardTermShape a sh:NodeShape ;
    rdfs:label "Direct Award Term" ;
    rdfs:comment "Conditions and stipulations defining particularities of the award of a Contract without prior publication. Addtional Information: Direct award may refer to a previous Procedure and/or specific Lot(s). It may also refer to other justified situations whereby there is no previous Procedure. See Directive 2014/24/EU Article 32." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-DirectAwardTerm-epo-hasDirectAwardJustification,
        epo-shape:epo-DirectAwardTerm-epo-hasJustification,
        epo-shape:epo-DirectAwardTerm-epo-refersToPreviousProcedure,
        epo-shape:epo-DirectAwardTerm-epo-refersToPreviousProcedureLot ;
    sh:targetClass epo:DirectAwardTerm .

epo-shape:epo-DirectContractShape a sh:NodeShape ;
    rdfs:label "Direct Contract" ;
    rdfs:comment "A Contract resulting from Lot Award Outcome. Additional information: A Framework Agreement is not a Direct Contract." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-DirectContract-epo-resultsFromLotAwardOutcome ;
    sh:targetClass epo:DirectContract .

epo-shape:epo-DocumentShape a sh:NodeShape ;
    rdfs:label "Document" ;
    rdfs:comment "A set of interrelated Business Information representing the Business facts and associated metadata. The information may be conveyed in any language, medium or form, including textual, numerical, graphic, cartographic, audio-visual forms, etc." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-Document-epo-associatedWith,
        epo-shape:epo-Document-epo-hasAccessURL,
        epo-shape:epo-Document-epo-hasAdditionalInformation,
        epo-shape:epo-Document-epo-hasDispatchDate,
        epo-shape:epo-Document-epo-hasDocumentType,
        epo-shape:epo-Document-epo-hasElectronicDigest,
        epo-shape:epo-Document-epo-hasElectronicSignature,
        epo-shape:epo-Document-epo-hasOfficialLanguage,
        epo-shape:epo-Document-epo-hasPublicationDate,
        epo-shape:epo-Document-epo-hasReceptionDate,
        epo-shape:epo-Document-epo-hasSpecificationInformation,
        epo-shape:epo-Document-epo-hasUUID,
        epo-shape:epo-Document-epo-hasUnofficialLanguage,
        epo-shape:epo-Document-epo-hasVersion,
        epo-shape:epo-Document-epo-refersToPrevious ;
    sh:targetClass epo:Document .

epo-shape:epo-DocumentationShape a sh:NodeShape ;
    rdfs:label "Documentation" ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-Documentation-epo-hasAddressURL ;
    sh:targetClass epo:Documentation .

epo-shape:epo-DynamicPurchaseSystemTechniqueShape a sh:NodeShape ;
    rdfs:label "Dynamic Purchase System Technique" ;
    rdfs:comment "A Technique that allows the selection of Candidates throughout the Procedure via the Qualification Criteria, followed by individual Mini-Competitions for the Award of Purchase Contracts." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-DynamicPurchaseSystemTechnique-epo-hasDPSScope,
        epo-shape:epo-DynamicPurchaseSystemTechnique-epo-hasEstimatedDuration ;
    sh:targetClass epo:DynamicPurchaseSystemTechnique .

epo-shape:epo-EAuctionTechniqueShape a sh:NodeShape ;
    rdfs:label "E Auction Technique" ;
    rdfs:comment "A repetitive Technique in which new Prices, revised downwards, and/or new values concerning certain elements of Tenders are bid on-line." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:targetClass epo:EAuctionTechnique .

epo-shape:epo-EconomicStandingSummaryShape a sh:NodeShape ;
    rdfs:label "Economic Standing Summary" ;
    rdfs:comment "Overview of the financial viability of the economic operator." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:targetClass epo:EconomicStandingSummary .

epo-shape:epo-ElectronicSignatureShape a sh:NodeShape ;
    rdfs:label "Electronic Signature" ;
    rdfs:comment "Data in electronic form which is attached to or logically associated with other data in electronic form and which is used by the signatory to sign. Additional information: The definition comes from REGULATION (EU) No 910/2014." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:targetClass epo:ElectronicSignature .

epo-shape:epo-EmploymentDocumentationShape a sh:NodeShape ;
    rdfs:label "Employment Documentation" ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:targetClass epo:EmploymentDocumentation .

epo-shape:epo-EmploymentInformationProviderShape a sh:NodeShape ;
    rdfs:label "Employment Information Provider" ;
    rdfs:comment "A Role of an Agent responsible for providing information concerning the general regulatory framework for employment protection and working conditions." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:targetClass epo:EmploymentInformationProvider .

epo-shape:epo-EnergyEfficiencyInformationShape a sh:NodeShape ;
    rdfs:label "Energy Efficiency Information" ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-EnergyEfficiencyInformation-epo-concernsEnergyEfficiencyItemCategory,
        epo-shape:epo-EnergyEfficiencyInformation-epo-concernsGreenProcurement,
        epo-shape:epo-EnergyEfficiencyInformation-epo-concernsTotalItems,
        epo-shape:epo-EnergyEfficiencyInformation-epo-hasCalculationBasedOn,
        epo-shape:epo-EnergyEfficiencyInformation-epo-hasEnergyEfficiencyLabel,
        epo-shape:epo-EnergyEfficiencyInformation-epo-hasItemConsumption,
        epo-shape:epo-EnergyEfficiencyInformation-epo-hasItemConsumptionSavings ;
    sh:targetClass epo:EnergyEfficiencyInformation .

epo-shape:epo-EnvironmentalDocumentationShape a sh:NodeShape ;
    rdfs:label "Environmental Documentation" ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:targetClass epo:EnvironmentalDocumentation .

epo-shape:epo-EnvironmentalProtectionInformationProviderShape a sh:NodeShape ;
    rdfs:label "Environmental Protection Information Provider" ;
    rdfs:comment "A Role of an Agent responsible for providing information concerning the general regulatory framework for Environmental Protection." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:targetClass epo:EnvironmentalProtectionInformationProvider .

epo-shape:epo-EstimateShape a sh:NodeShape ;
    rdfs:label "Estimate" ;
    rdfs:comment "An approximate calculation or a judgement of the value, number, Quantity or extent of something." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:targetClass epo:Estimate .

epo-shape:epo-EvaluationTermShape a sh:NodeShape ;
    rdfs:label "Evaluation Term" ;
    rdfs:comment "Conditions and stipulations defining particularities of the Tender evaluation." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:targetClass epo:EvaluationTerm .

epo-shape:epo-ExclusionGroundShape a sh:NodeShape ;
    rdfs:label "Exclusion Ground" ;
    rdfs:comment "Criterion that describes a legal Requirement to be met by the Economic Operator to be a Candidate in the Procurement." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-ExclusionGround-epo-hasExclusionGroundType ;
    sh:targetClass epo:ExclusionGround .

epo-shape:epo-ExclusionGroundsSummaryShape a sh:NodeShape ;
    rdfs:label "Exclusion Grounds Summary" ;
    rdfs:comment "Overview of the Exclusion Grounds." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:targetClass epo:ExclusionGroundsSummary .

epo-shape:epo-ExpressionOfInterestShape a sh:NodeShape ;
    rdfs:label "Expression Of Interest" ;
    rdfs:comment "Document presenting an Economic Operator's Request to be considered for Procedures covering a specific domain." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-ExpressionOfInterest-epo-concernsProcedure,
        epo-shape:epo-ExpressionOfInterest-epo-hasPreferredLanguageForProcurementDocument,
        epo-shape:epo-ExpressionOfInterest-epo-specifiesEconomicOperator ;
    sh:targetClass epo:ExpressionOfInterest .

epo-shape:epo-FrameworkAgreementShape a sh:NodeShape ;
    rdfs:label "Framework Agreement" ;
    rdfs:comment "An agreement between one or more Contracting Authorities and one or more Economic Operators. Additional Information: When a Framework Agreement is concerned, the FA will result from LotAwardOutcome which describes a Lot which specifies the both the Qualification and Award Criteria." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-FrameworkAgreement-epo-resultsFromLotAwardOutcome ;
    sh:targetClass epo:FrameworkAgreement .

epo-shape:epo-FrameworkAgreementTechniqueShape a sh:NodeShape ;
    rdfs:label "Framework Agreement Technique" ;
    rdfs:comment "Technique that establishes the terms governing Contracts to be awarded during a given Period, in particular with regard to Price and, where appropriate, the Quantity envisaged." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:targetClass epo:FrameworkAgreementTechnique .

epo-shape:epo-FrameworkAgreementTermShape a sh:NodeShape ;
    rdfs:label "Framework Agreement Term" ;
    rdfs:comment "Conditions and stipulations defining particularities in a Framework Agreement." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-FrameworkAgreementTerm-epo-hasBuyerCategoryDescription,
        epo-shape:epo-FrameworkAgreementTerm-epo-hasDurationExtensionJustification,
        epo-shape:epo-FrameworkAgreementTerm-epo-hasFrameworkAgreementType,
        epo-shape:epo-FrameworkAgreementTerm-epo-hasMaximumParticipantsNumber ;
    sh:targetClass epo:FrameworkAgreementTerm .

epo-shape:epo-FundShape a sh:NodeShape ;
    rdfs:label "Fund" ;
    rdfs:comment "A financial resource used to support the Procurement. Additional Information: In the context of EU, Funds can be divided into programmes, actions and projects. Examples of EU funds are: the European Structural and Investment Funds, European Social Fund (ESF), the Connecting Europe Facility (CEF) programme, or the ISA2 programme and its actions (e.g. Action 2016.05 European Public Procurement Initiative, which supports the eProcurement Ontology under sub-action 3). Funds may change between the lot and the contract, for example in the case of an emergency crisis, a contract may be financed by a budget that was not foreseen in the call." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-Fund-epo-hasFundProgramme,
        epo-shape:epo-Fund-epo-hasURL ;
    sh:targetClass epo:Fund .

epo-shape:epo-GreenProcurementShape a sh:NodeShape ;
    rdfs:label "Green Procurement" ;
    rdfs:comment "Approach whereby Buyers seek to procure with a reduced Environmental Impact. Additional Information: The approach may apply to the complete life cycle. The reduced Environmental Impact is in comparison to goods, services and works with the same primary function that would otherwise be procured. Tightly related are article 68 - Life-cycle costing and article 67 - most economically advantageous Tender (see GPP handbook) https://ec.europa.eu/environment/gpp/pdf/Buying-Green-Handbook-3rd-Edition.pdf An instance of the class GreenProcurement is represented in eForms with the code \"env-imp\" defined in the codelist Strategic-Procurement.Paragraphs) https://ec.europa.eu/environment/gpp/pdf/Buying-Green-Handbook-3rd-Edition.pdf" ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-GreenProcurement-epo-fulfillsRequirement,
        epo-shape:epo-GreenProcurement-epo-usesCleanVehicleDirective ;
    sh:targetClass epo:GreenProcurement .

epo-shape:epo-InnovativeProcurementShape a sh:NodeShape ;
    rdfs:label "Innovative Procurement" ;
    rdfs:comment "Approach whereby Buyers seek to procure an innovative work, supply or service. Additional Information: ‘innovation’ means the implementation of a new or significantly improved product, service or process, including but not limited to production, building or construction processes, a new marketing method, or a new organizational method in business practices, workplace Organisation or external relations inter alia with the purpose of helping to solve societal challenges or to support the Europe 2020 strategy for smart, sustainable and inclusive growth; See: Directive 2014/24 Articles: 2, 26 (3), 31, 67 (2.a)" ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-InnovativeProcurement-epo-fulfillsRequirement ;
    sh:targetClass epo:InnovativeProcurement .

epo-shape:epo-InternationalProcurementInstrumentMeasuresInformationShape a sh:NodeShape ;
    rdfs:label "International Procurement Instrument Measures Information" ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-InternationalProcurementInstrumentMeasuresInformation-epo-concernsInternationalProcurementInstrumentMeasure,
        epo-shape:epo-InternationalProcurementInstrumentMeasuresInformation-epo-concernsLotAwardOutcome,
        epo-shape:epo-InternationalProcurementInstrumentMeasuresInformation-epo-hasInternationalProcurementInstrumentExceptionInformation,
        epo-shape:epo-InternationalProcurementInstrumentMeasuresInformation-epo-hasNumberOfTendersConcerned,
        epo-shape:epo-InternationalProcurementInstrumentMeasuresInformation-epo-hasPublicInterestExceptionJustification ;
    sh:targetClass epo:InternationalProcurementInstrumentMeasuresInformation .

epo-shape:epo-JuryMemberShape a sh:NodeShape ;
    rdfs:label "Jury Member" ;
    rdfs:comment "Role of an Agent who evaluates a design contest." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-JuryMember-epo-playedBy ;
    sh:targetClass epo:JuryMember .

epo-shape:epo-LeadBuyerShape a sh:NodeShape ;
    rdfs:label "Lead Buyer" ;
    rdfs:comment "A Role of an Agent who is a Buyer and takes the administrative lead of the Procedure." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:targetClass epo:LeadBuyer .

epo-shape:epo-LocalLegalBasisInformationShape a sh:NodeShape ;
    rdfs:label "Local Legal Basis Information" ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-LocalLegalBasisInformation-epo-concernsProcurementElement,
        epo-shape:epo-LocalLegalBasisInformation-epo-hasLegalBasis ;
    sh:targetClass epo:LocalLegalBasisInformation .

epo-shape:epo-LotAwardOutcomeShape a sh:NodeShape ;
    rdfs:label "Lot Award Outcome" ;
    rdfs:comment "Result concerning the Lot that was attributed by the Awarder." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-LotAwardOutcome-epo-concernsLot,
        epo-shape:epo-LotAwardOutcome-epo-fulfillsStrategicProcurement,
        epo-shape:epo-LotAwardOutcome-epo-hasApproximateFrameworkAgreementValue,
        epo-shape:epo-LotAwardOutcome-epo-hasFrameworkAgreementMaximumValue,
        epo-shape:epo-LotAwardOutcome-epo-hasNonAwardedContractNumber,
        epo-shape:epo-LotAwardOutcome-epo-hasNonAwardedContractTitle ;
    sh:targetClass epo:LotAwardOutcome .

epo-shape:epo-LotGroupAwardInformationShape a sh:NodeShape ;
    rdfs:label "Lot Group Award Information" ;
    rdfs:comment "Award information related to a given Group of Lots." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-LotGroupAwardInformation-epo-describesLotGroup,
        epo-shape:epo-LotGroupAwardInformation-epo-hasApproximateGroupFrameworkAgreementValue,
        epo-shape:epo-LotGroupAwardInformation-epo-hasGroupFrameworkAgreementMaximumValue ;
    sh:targetClass epo:LotGroupAwardInformation .

epo-shape:epo-LotGroupShape a sh:NodeShape ;
    rdfs:label "Lot Group" ;
    rdfs:comment "Combination of several Lots to conduct comparative assessment of the Tenders. Additional Information: The comparative assessment may refer to the Selection Criteria, Award and Value that apply to several Lots. Pending of discussion with eForms Member States may provide that, where more than one lot may be awarded to the same tenderer, contracting authorities may award contracts combining several or all lots where they have specified in the contract notice or in the invitation to confirm interest that they reserve the possibility of doing so and indicate the lots or groups of lots that may be combined." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-LotGroup-epo-hasEstimatedValue,
        epo-shape:epo-LotGroup-epo-hasInternalIdentifier,
        epo-shape:epo-LotGroup-epo-hasLaunchFrameworkAgreementMaximumValue,
        epo-shape:epo-LotGroup-epo-isSMESuitable,
        epo-shape:epo-LotGroup-epo-isSubjectToTerm,
        epo-shape:epo-LotGroup-epo-setsGroupingContextForLot,
        epo-shape:epo-LotGroup-epo-specifiesProcurementCriterion ;
    sh:targetClass epo:LotGroup .

epo-shape:epo-LotShape a sh:NodeShape ;
    rdfs:label "Lot" ;
    rdfs:comment "A qualitative, quantitative or strategic subdivision of the goods, services or works to be procured, allowing the award of one or more Contracts." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:targetClass epo:Lot .

epo-shape:epo-MaskableObjectShape a sh:NodeShape ;
    rdfs:label "Maskable Object" ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:targetClass epo:MaskableObject .

epo-shape:epo-MediatorShape a sh:NodeShape ;
    rdfs:label "Mediator" ;
    rdfs:comment "A Role of an Agent that attempts to resolve a dispute between different Agents and come to an agreement." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:targetClass epo:Mediator .

epo-shape:epo-MiniCompetitionAwardOutcomeShape a sh:NodeShape ;
    rdfs:label "Mini Competition Award Outcome" ;
    rdfs:comment "Result concerning the mini-competition that was attributed by the Awarder. Additional Information: The mini-competition is the process where multiple winners or candidates of previous stages of a procedure bid for a specific procurement. It is typically used in framework agreements where the suppliers have already been pre-selected, and the mini competition is used to determine which supplier is best suited for a particular project or contract. It is also used in a Dynamic Purchasing System where the suppliers come from a list of Candidates." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-MiniCompetitionAwardOutcome-epo-resultsFromUsingCandidateList ;
    sh:targetClass epo:MiniCompetitionAwardOutcome .

epo-shape:epo-MonetaryValueShape a sh:NodeShape ;
    rdfs:label "Monetary Value" ;
    rdfs:comment "A number of monetary units specified using a given unit of currency. Additional information: In the pre-award phase of the procurement, all monetary values are considered to exclude VAT based on the Directive 2014/24/EU." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-MonetaryValue-epo-hasAmountValue,
        epo-shape:epo-MonetaryValue-epo-hasCurrency,
        epo-shape:epo-MonetaryValue-epo-hasCurrencyCodeListAgencyID,
        epo-shape:epo-MonetaryValue-epo-hasCurrencyCodeListAgencyName,
        epo-shape:epo-MonetaryValue-epo-hasCurrencyCodeListID ;
    sh:targetClass epo:MonetaryValue .

epo-shape:epo-MultipleStageProcedureTermShape a sh:NodeShape ;
    rdfs:label "Multiple Stage Procedure Term" ;
    rdfs:comment "Conditions and stipulations defining particularities of Procedures carried out in several steps Additional Information: Generally this refers to Procedures where selection is carried out to qualify Tenderers who are then requested to submit the rest of their Tender for evaluation is Restricted Procedure." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-MultipleStageProcedureTerm-epo-hasEstimatedInvitationToExpressInterestDate,
        epo-shape:epo-MultipleStageProcedureTerm-epo-hasEstimatedInvitationToTenderDate,
        epo-shape:epo-MultipleStageProcedureTerm-epo-hasMaximumNumberOfCandidates,
        epo-shape:epo-MultipleStageProcedureTerm-epo-hasMinimumNumberOfCandidates,
        epo-shape:epo-MultipleStageProcedureTerm-epo-hasNoNegotiationNecessary,
        epo-shape:epo-MultipleStageProcedureTerm-epo-hasQualificationSystemDuration,
        epo-shape:epo-MultipleStageProcedureTerm-epo-hasQualificationSystemRenewalDescription,
        epo-shape:epo-MultipleStageProcedureTerm-epo-hasSuccessiveReduction ;
    sh:targetClass epo:MultipleStageProcedureTerm .

epo-shape:epo-NonDisclosureAgreementTermShape a sh:NodeShape ;
    rdfs:label "Non Disclosure Agreement Term" ;
    rdfs:comment "Conditions and stipulations about a non-disclosure agreement. Additional information: A non-disclosure agreement is a Contract between different parties which ensures information is not shared with other parties." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-NonDisclosureAgreementTerm-epo-isNonDisclosureAgreementRequired ;
    sh:targetClass epo:NonDisclosureAgreementTerm .

epo-shape:epo-NonPublishedInformationShape a sh:NodeShape ;
    rdfs:label "Non Published Information" ;
    rdfs:comment "Information about fields not published in this Notice. Additional Information: The non-published information may become available at a later date and may differ from one element to another within a given Document. Examples of fields that may not be immediately published are Winner, Tender and Procedure Lot Result, etc., e.g. for security reasons." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-NonPublishedInformation-epo-concernsMaskedObject,
        epo-shape:epo-NonPublishedInformation-epo-concernsNotice,
        epo-shape:epo-NonPublishedInformation-epo-hasAccessibilityDate,
        epo-shape:epo-NonPublishedInformation-epo-hasConfidentialityJustification,
        epo-shape:epo-NonPublishedInformation-epo-hasMaskableProperty,
        epo-shape:epo-NonPublishedInformation-epo-hasNonPublicationJustification ;
    sh:targetClass epo:NonPublishedInformation .

epo-shape:epo-NoticeAwardInformationShape a sh:NodeShape ;
    rdfs:label "Notice Award Information" ;
    rdfs:comment "Information about an Award Notice." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-NoticeAwardInformation-epo-describesDirectAwardPrenotificationNotice,
        epo-shape:epo-NoticeAwardInformation-epo-describesResultNotice,
        epo-shape:epo-NoticeAwardInformation-epo-hasApproximateFrameworkAgreementValue,
        epo-shape:epo-NoticeAwardInformation-epo-hasMaximumFrameworkAgreementAwardedValue,
        epo-shape:epo-NoticeAwardInformation-epo-hasProcurementHighestReceivedTenderValue,
        epo-shape:epo-NoticeAwardInformation-epo-hasProcurementLowestReceivedTenderValue,
        epo-shape:epo-NoticeAwardInformation-epo-hasTotalAwardedValue ;
    sh:targetClass epo:NoticeAwardInformation .

epo-shape:epo-NoticeShape a sh:NodeShape ;
    rdfs:label "Notice" ;
    rdfs:comment "Document published by the Buyer about market opportunities and results." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-Notice-epo-conformsToLegalBasis,
        epo-shape:epo-Notice-epo-hasESenderDispatchDate,
        epo-shape:epo-Notice-epo-hasFormNumber,
        epo-shape:epo-Notice-epo-hasFormType,
        epo-shape:epo-Notice-epo-hasNoticePublicationNumber,
        epo-shape:epo-Notice-epo-hasNoticeType,
        epo-shape:epo-Notice-epo-hasOJSIssueNumber,
        epo-shape:epo-Notice-epo-isBasedOnImplementingRegulation,
        epo-shape:epo-Notice-epo-refersToLot,
        epo-shape:epo-Notice-epo-refersToNotice,
        epo-shape:epo-Notice-epo-refersToProcedure ;
    sh:targetClass epo:Notice .

epo-shape:epo-OfferIssuerShape a sh:NodeShape ;
    rdfs:label "Offer Issuer" ;
    rdfs:comment "The Role of an Agent that distributes an Offer." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-OfferIssuer-epo-distributesOffer ;
    sh:targetClass epo:OfferIssuer .

epo-shape:epo-OfferShape a sh:NodeShape ;
    rdfs:label "Offer" ;
    rdfs:comment "Document providing the Monetary Value and the details to fulfill the Requirements set out in the Procurement Documents or Request for Offer. Additional information: A quotation is considered to be an Offer in the eProcurement Ontology." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-Offer-epo-providesEvidence ;
    sh:targetClass epo:Offer .

epo-shape:epo-OfferingPartyShape a sh:NodeShape ;
    rdfs:label "Offering Party" ;
    rdfs:comment "The Role of an Agent that acts on the Economic Operator side during a Procurement Process. Additional information: As per the European Procurement Directives the notion of ‘Economic Operators’ should be interpreted in a broad manner so as to include any Persons and/or Entities which offer the execution of works, the supply of products or the provision of services on the market, irrespective of the legal form under which they have chosen to operate. Thus, firms, branches, subsidiaries, partnerships, cooperative societies, limited companies, universities, public or private, and other forms of entities than natural Persons should all fall within the notion of Economic Operator, whether or not they are ‘Legal Persons’ in all circumstances." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:targetClass epo:OfferingParty .

epo-shape:epo-OfflineAccessProviderShape a sh:NodeShape ;
    rdfs:label "Offline Access Provider" ;
    rdfs:comment "A Role of an Agent responsible for providing offline access to the Procurement Documents." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:targetClass epo:OfflineAccessProvider .

epo-shape:epo-OpeningTermShape a sh:NodeShape ;
    rdfs:label "Opening Term" ;
    rdfs:comment "Conditions and stipulations defining particularities of the opening of Tenders. Additional Information: The opening of Tenders is the event when Tenders are made accessible for evaluation, it is generally the same date and time for all Tenders." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-OpeningTerm-epo-hasOpeningDateTime,
        epo-shape:epo-OpeningTerm-epo-hasOpeningDescription,
        epo-shape:epo-OpeningTerm-epo-hasOpeningPlace,
        epo-shape:epo-OpeningTerm-epo-hasOpeningURL ;
    sh:targetClass epo:OpeningTerm .

epo-shape:epo-OrganisationGroupShape a sh:NodeShape ;
    rdfs:label "Organisation Group" ;
    rdfs:comment "Agreed collaboration of several Organisations. Additional Information: This concept has been created to fulfill the need to represent a grouping of Organisations that is not necessarily registered i.e, consortia." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-OrganisationGroup-epo-hasGroupType,
        epo-shape:epo-OrganisationGroup-epo-hasMember,
        epo-shape:epo-OrganisationGroup-epo-leadBy ;
    sh:targetClass epo:OrganisationGroup .

epo-shape:epo-OriginatorRequestShape a sh:NodeShape ;
    rdfs:label "Originator Request" ;
    rdfs:comment "Document in which the Originator describes his needs." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:targetClass epo:OriginatorRequest .

epo-shape:epo-ParticipationConditionShape a sh:NodeShape ;
    rdfs:label "Participation Condition" ;
    rdfs:comment "Criterion that describes a Requirement to take part in a procurement." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-ParticipationCondition-epo-hasReservedProcurement ;
    sh:targetClass epo:ParticipationCondition .

epo-shape:epo-ParticipationConditionsSummaryShape a sh:NodeShape ;
    rdfs:label "Participation Conditions Summary" ;
    rdfs:comment "Overview of the Participation Conditions." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-ParticipationConditionsSummary-epo-describesObjectiveParticipationRules,
        epo-shape:epo-ParticipationConditionsSummary-epo-describesVerificationMethod,
        epo-shape:epo-ParticipationConditionsSummary-epo-hasReservedProcurement ;
    sh:targetClass epo:ParticipationConditionsSummary .

epo-shape:epo-ParticipationRequestProcessorShape a sh:NodeShape ;
    rdfs:label "Participation Request Processor" ;
    rdfs:comment "A Role of an Agent responsible for processing Requests To Participate." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:targetClass epo:ParticipationRequestProcessor .

epo-shape:epo-ParticipationRequestReceiverShape a sh:NodeShape ;
    rdfs:label "Participation Request Receiver" ;
    rdfs:comment "A Role of an Agent responsible for receiving Requests To Participate." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:targetClass epo:ParticipationRequestReceiver .

epo-shape:epo-ParticipationRequestTermShape a sh:NodeShape ;
    rdfs:label "Participation Request Term" ;
    rdfs:comment "Conditions and stipulations defining particularities of requesting participation in a Procedure." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-ParticipationRequestTerm-epo-definesParticipationRequestProcessor,
        epo-shape:epo-ParticipationRequestTerm-epo-definesParticipationRequestReceiver ;
    sh:targetClass epo:ParticipationRequestTerm .

epo-shape:epo-PaymentExecutorShape a sh:NodeShape ;
    rdfs:label "Payment Executor" ;
    rdfs:comment "A Role of an Agent responsible for executing the Payment." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:targetClass epo:PaymentExecutor .

epo-shape:epo-PlannedProcurementPartShape a sh:NodeShape ;
    rdfs:label "Planned Procurement Part" ;
    rdfs:comment "A subdivision of a Planned Procurement that may later become one or more Lots or a self-standing Procedure. A Lot or a Procedure can also cover one or more parts of the Planned Procurement." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-PlannedProcurementPart-epo-foreseesProcurementObject,
        epo-shape:epo-PlannedProcurementPart-epo-foreseesTechnique,
        epo-shape:epo-PlannedProcurementPart-epo-hasPlannedDuration,
        epo-shape:epo-PlannedProcurementPart-epo-hasPlannedPeriod ;
    sh:targetClass epo:PlannedProcurementPart .

epo-shape:epo-PlannedProcurementShape a sh:NodeShape ;
    rdfs:label "Planned Procurement" ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:targetClass epo:PlannedProcurement .

epo-shape:epo-PrizeShape a sh:NodeShape ;
    rdfs:label "Prize" ;
    rdfs:comment "A reward given in a Contest." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-Prize-epo-hasPrizeRank,
        epo-shape:epo-Prize-epo-hasPrizeValue ;
    sh:targetClass epo:Prize .

epo-shape:epo-ProcedureShape a sh:NodeShape ;
    rdfs:label "Procedure" ;
    rdfs:comment "A legally defined set of administrative activities conducted to conclude one or more Contracts. Additional Information The Procedure is categorised in the law according to different rules determining whether the Procedure is Open, Restricted, Negotiated with or without publicity, etc. (see Procedure Type)." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-Procedure-epo-hasAcceleratedProcedureJustification,
        epo-shape:epo-Procedure-epo-hasMainFeature,
        epo-shape:epo-Procedure-epo-hasProcedureType,
        epo-shape:epo-Procedure-epo-hasProcurementScopeDividedIntoLot,
        epo-shape:epo-Procedure-epo-involvesBuyer,
        epo-shape:epo-Procedure-epo-isAccelerated,
        epo-shape:epo-Procedure-epo-isDesignContest,
        epo-shape:epo-Procedure-epo-isExecutedByProcurementServiceProvider,
        epo-shape:epo-Procedure-epo-isJointProcurement,
        epo-shape:epo-Procedure-epo-isResponsibilityOfBuyer,
        epo-shape:epo-Procedure-epo-specifiesProcurementCriteriaSummary ;
    sh:targetClass epo:Procedure .

epo-shape:epo-ProcedureTermShape a sh:NodeShape ;
    rdfs:label "Procedure Term" ;
    rdfs:comment "Conditions and stipulations defining particularities of the Procedure." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-ProcedureTerm-epo-definesBudgetProvider,
        epo-shape:epo-ProcedureTerm-epo-definesInformationProvider,
        epo-shape:epo-ProcedureTerm-epo-definesLotGroup,
        epo-shape:epo-ProcedureTerm-epo-definesMediator,
        epo-shape:epo-ProcedureTerm-epo-hasCrossBorderLaw,
        epo-shape:epo-ProcedureTerm-epo-hasGroupLotEvaluationMethod,
        epo-shape:epo-ProcedureTerm-epo-hasLotAwardCombination,
        epo-shape:epo-ProcedureTerm-epo-hasMaximumLotSubmissionAllowed,
        epo-shape:epo-ProcedureTerm-epo-hasMaximumNumberOfLotsToBeAwarded,
        epo-shape:epo-ProcedureTerm-epo-hasNationalProcedureRules,
        epo-shape:epo-ProcedureTerm-epo-isAwardedByCPB,
        epo-shape:epo-ProcedureTerm-epo-isOneLotOnlyAllowed,
        epo-shape:epo-ProcedureTerm-epo-isSubmissionForAllLotsRequired ;
    sh:targetClass epo:ProcedureTerm .

epo-shape:epo-ProcessPlanningTermShape a sh:NodeShape ;
    rdfs:label "Process Planning Term" ;
    rdfs:comment "Conditions and stipulations defining particularities of the unfolding of the Procurement Process." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-ProcessPlanningTerm-epo-hasAwardDateScheduled,
        epo-shape:epo-ProcessPlanningTerm-epo-hasEstimatedContractNoticePublicationDate,
        epo-shape:epo-ProcessPlanningTerm-epo-hasEstimatedTenderInvitationDate ;
    sh:targetClass epo:ProcessPlanningTerm .

epo-shape:epo-ProcurementCriteriaSummaryShape a sh:NodeShape ;
    rdfs:label "Procurement Criteria Summary" ;
    rdfs:comment "Overview of the Procurement Criteria." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-ProcurementCriteriaSummary-epo-indicatesPerformingStaffInformationRequirement ;
    sh:targetClass epo:ProcurementCriteriaSummary .

epo-shape:epo-ProcurementCriterionShape a sh:NodeShape ;
    rdfs:label "Procurement Criterion" ;
    rdfs:comment "A criterion specific to Procurement. Additional Information: This Procurement Criterion can be only Exclusion Ground, Selection Criterion or Award Criterion. Each of these Criteria can contain subcriteria (Criterion class)." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-ProcurementCriterion-epo-hasAdditionalInformation,
        epo-shape:epo-ProcurementCriterion-epo-hasConstraint,
        epo-shape:epo-ProcurementCriterion-epo-hasFormula,
        epo-shape:epo-ProcurementCriterion-epo-hasWeightValueType ;
    sh:targetClass epo:ProcurementCriterion .

epo-shape:epo-ProcurementDocumentShape a sh:NodeShape ;
    rdfs:label "Procurement Document" ;
    rdfs:comment "Document produced or referred to by the Buyer to describe or determine elements of the Procurement. Additional information: Procurement Documents are to be accessible since the date of publication of the Contract Notice or the prior information Notice when used as a call for competition. Examples of Procurement Documents are Technical Specifications, the Descriptive Document, proposed conditions of Contract, formats for the presentation of Documents by Candidates and Tenderers, information on generally applicable obligations. Other Documents related to the Procedure such as Notices are not considered to be Procurement Documents." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:targetClass epo:ProcurementDocument .

epo-shape:epo-ProcurementElementShape a sh:NodeShape ;
    rdfs:label "Procurement Element" ;
    rdfs:comment "Gathering class for critical/central elements in the Procurement Process. TODO: add definition Additional information: Alias: ProcurementComponent" ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-ProcurementElement-epo-appliesForeignSubsidiesRegulation,
        epo-shape:epo-ProcurementElement-epo-doesNotRequireSelectionCriterionType,
        epo-shape:epo-ProcurementElement-epo-foreseesTerm,
        epo-shape:epo-ProcurementElement-epo-hasAdditionalInformation,
        epo-shape:epo-ProcurementElement-epo-hasEstimatedValue,
        epo-shape:epo-ProcurementElement-epo-hasInternalIdentifier,
        epo-shape:epo-ProcurementElement-epo-hasLegalBasis,
        epo-shape:epo-ProcurementElement-epo-hasLegalBasisDescription,
        epo-shape:epo-ProcurementElement-epo-hasPurpose,
        epo-shape:epo-ProcurementElement-epo-hasUnknownUsageOfSelectionCriterionType,
        epo-shape:epo-ProcurementElement-epo-isCoveredByGPA,
        epo-shape:epo-ProcurementElement-epo-isSMESuitable,
        epo-shape:epo-ProcurementElement-epo-isSubjectToTerm,
        epo-shape:epo-ProcurementElement-epo-specifiesProcurementCriterion,
        epo-shape:epo-ProcurementElement-epo-usesChannel ;
    sh:targetClass epo:ProcurementElement .

epo-shape:epo-ProcurementObjectShape a sh:NodeShape ;
    rdfs:label "Procurement Object" ;
    rdfs:comment "The whole or a division of goods, services or works to be procured. Additional Information: Anything that can specify the procurement content (i.e. goods, services, work) is a Procurement Object. In a sense, such an \"object\" can constitute the \"object of a Contract\". To test whether something is a Procedure Object check if it can have a Purpose and/or CPV classification (<i>The CPV establishes a single classification system for public procurement aimed at standardising the references used by Contracting Authorities and entities to describe the subject of Procurement Contracts.</i>). Note: Procedure, seems to be an exception from this rule. Because it is a conflated term: it carries process properties and \"purpose\" properties." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-ProcurementObject-epo-foreseesConcession,
        epo-shape:epo-ProcurementObject-epo-fulfillsStrategicProcurement,
        epo-shape:epo-ProcurementObject-epo-hasLaunchFrameworkAgreementMaximumValue,
        epo-shape:epo-ProcurementObject-epo-hasRecurrenceDescription,
        epo-shape:epo-ProcurementObject-epo-isFundedBy,
        epo-shape:epo-ProcurementObject-epo-isRecurrent,
        epo-shape:epo-ProcurementObject-epo-isUsingEUFunds,
        epo-shape:epo-ProcurementObject-epo-usesTechnique ;
    sh:targetClass epo:ProcurementObject .

epo-shape:epo-ProcurementProcedureInformationProviderShape a sh:NodeShape ;
    rdfs:label "Procurement Procedure Information Provider" ;
    rdfs:comment "A Role of an Agent responsible for providing additional information about the Procurement Procedure." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:targetClass epo:ProcurementProcedureInformationProvider .

epo-shape:epo-ProcurementProcessInformationShape a sh:NodeShape ;
    rdfs:label "Procurement Process Information" ;
    rdfs:comment "Information about the temporal unfolding or succession of Procurement Objects." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-ProcurementProcessInformation-epo-concernsLot,
        epo-shape:epo-ProcurementProcessInformation-epo-concernsProcedure,
        epo-shape:epo-ProcurementProcessInformation-epo-isCompetitionTerminated,
        epo-shape:epo-ProcurementProcessInformation-epo-isDPSTerminated,
        epo-shape:epo-ProcurementProcessInformation-epo-isToBeRelaunched ;
    sh:targetClass epo:ProcurementProcessInformation .

epo-shape:epo-ProcurementServiceProviderShape a sh:NodeShape ;
    rdfs:label "Procurement Service Provider" ;
    rdfs:comment "Role of a public or private body which offers ancillary purchasing activities on the market. Additional information: \"Ancillary Purchasing Activities\" means activities consisting in the provision of support to purchasing activities, in particular in the following forms: (a) technical infrastructure enabling Contracting Authorities to award Public Contracts or to conclude Framework Agreements for works, supplies or services; (b) advice on the conduct or design of public Procurement Procedures; (c) preparation and management of Procurement Procedures on behalf and for the account of the Contracting Authority concerned; This would be equivalent to the concept of 'ProcuringEntity' in OCDS: 'The Entity managing the Procurement, which may be different from the Buyer who is paying / using the items being procured'." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-ProcurementServiceProvider-epo-actsOnBehalfOf ;
    sh:targetClass epo:ProcurementServiceProvider .

epo-shape:epo-ProfessionalSuitabilitySummaryShape a sh:NodeShape ;
    rdfs:label "Professional Suitability Summary" ;
    rdfs:comment "Overview of the professional ability required for the economic operator to execute the contract." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-ProfessionalSuitabilitySummary-epo-describesProfession,
        epo-shape:epo-ProfessionalSuitabilitySummary-epo-describesProfessionRelevantLaw,
        epo-shape:epo-ProfessionalSuitabilitySummary-epo-hasServiceReservedToParticularProfession ;
    sh:targetClass epo:ProfessionalSuitabilitySummary .

epo-shape:epo-ProjectShape a sh:NodeShape ;
    rdfs:label "Project" ;
    rdfs:comment "A collaborative enterprise that is carefully planned to achieve a particular aim." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:targetClass epo:Project .

epo-shape:epo-PurchaseContractShape a sh:NodeShape ;
    rdfs:label "Purchase Contract" ;
    rdfs:comment "A Contract resulting from using a Dynamic Purchasing System Technique or Framework Agreement Technique." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-PurchaseContract-epo-followsRulesSetBy,
        epo-shape:epo-PurchaseContract-epo-resultsFromMiniCompetitionAwardOutcome ;
    sh:targetClass epo:PurchaseContract .

epo-shape:epo-PurposeShape a sh:NodeShape ;
    rdfs:label "Purpose" ;
    rdfs:comment "The description of the objectives related to a Procurement. Additional information: The description of the objectives includes the Subject Matter and Quantities. The quantification of the objectives related to a procurement. To be re-reviewed by the WG the soonest. (WG to be discussed, this was pointed out on the 09/04/2019 14:38:25 WG Meeting) The old definition read as follows: The description of the objectives related to a procurement." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-Purpose-epo-hasAdditionalClassification,
        epo-shape:epo-Purpose-epo-hasMainClassification,
        epo-shape:epo-Purpose-epo-hasTotalQuantity ;
    sh:targetClass epo:Purpose .

epo-shape:epo-QualificationCriteriaSummaryShape a sh:NodeShape ;
    rdfs:label "Qualification Criteria Summary" ;
    rdfs:comment "Overview of the Qualification Criteria." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-QualificationCriteriaSummary-epo-hasConditionVerificationMethod,
        epo-shape:epo-QualificationCriteriaSummary-epo-hasQualificationCondition ;
    sh:targetClass epo:QualificationCriteriaSummary .

epo-shape:epo-QualificationCriterionShape a sh:NodeShape ;
    rdfs:label "Qualification Criterion" ;
    rdfs:comment "Criterion used in the first stage of procurement." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-QualificationCriterion-epo-hasQualificationCriteriaStatedInESPDRequest,
        epo-shape:epo-QualificationCriterion-epo-hasQualificationCriteriaStatedInNotice,
        epo-shape:epo-QualificationCriterion-epo-hasQualificationCriteriaStatedInProcurementDocuments,
        epo-shape:epo-QualificationCriterion-epo-includesNationalCriterion ;
    sh:targetClass epo:QualificationCriterion .

epo-shape:epo-QuantityShape a sh:NodeShape ;
    rdfs:label "Quantity" ;
    rdfs:comment "A counted number of non-monetary units possibly including fractions." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-Quantity-epo-hasQuantityValue,
        epo-shape:epo-Quantity-epo-hasUnitCode,
        epo-shape:epo-Quantity-epo-hasUnitDescription ;
    sh:targetClass epo:Quantity .

epo-shape:epo-ReliedUponEntityShape a sh:NodeShape ;
    rdfs:label "Relied Upon Entity" ;
    rdfs:comment "Economic Operator (who is not a Subcontractor) on which the Tenderer relies upon, to meet Selection Criteria." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:targetClass epo:ReliedUponEntity .

epo-shape:epo-ReviewDecisionShape a sh:NodeShape ;
    rdfs:label "Review Decision" ;
    rdfs:comment "Information about Review Decisions." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-ReviewDecision-epo-answersReviewRequest,
        epo-shape:epo-ReviewDecision-epo-hasConfirmedIrregularityType,
        epo-shape:epo-ReviewDecision-epo-hasRemedyValue,
        epo-shape:epo-ReviewDecision-epo-hasReviewDecisionType,
        epo-shape:epo-ReviewDecision-epo-hasWithdrawalDate,
        epo-shape:epo-ReviewDecision-epo-hasWithdrawalReason,
        epo-shape:epo-ReviewDecision-epo-isWithdrawn,
        epo-shape:epo-ReviewDecision-epo-providesRulingOnRemedy,
        epo-shape:epo-ReviewDecision-epo-specifiesReviewRequester,
        epo-shape:epo-ReviewDecision-epo-specifiesReviewer ;
    sh:targetClass epo:ReviewDecision .

epo-shape:epo-ReviewInformationShape a sh:NodeShape ;
    rdfs:label "Review Information" ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-ReviewInformation-epo-concernsReviewDecision,
        epo-shape:epo-ReviewInformation-epo-concernsReviewRequest,
        epo-shape:epo-ReviewInformation-epo-hasElementReference,
        epo-shape:epo-ReviewInformation-epo-relatesToEFormSectionIdentifier ;
    sh:targetClass epo:ReviewInformation .

epo-shape:epo-ReviewIrregularitySummaryShape a sh:NodeShape ;
    rdfs:label "Review Irregularity Summary" ;
    rdfs:comment "Overview of the number and type of requests the Buyer received to review any of its decisions (e.g. the Technical Specifications, Award Decision)." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-ReviewIrregularitySummary-epo-hasIrregularityType,
        epo-shape:epo-ReviewIrregularitySummary-epo-hasReviewIrregularityCount ;
    sh:targetClass epo:ReviewIrregularitySummary .

epo-shape:epo-ReviewProcedureInformationProviderShape a sh:NodeShape ;
    rdfs:label "Review Procedure Information Provider" ;
    rdfs:comment "A Role of an Agent who is providing more information on the time limits for review Procedures." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:targetClass epo:ReviewProcedureInformationProvider .

epo-shape:epo-ReviewRequestShape a sh:NodeShape ;
    rdfs:label "Review Request" ;
    rdfs:comment "Information about requests to review procedures." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-ReviewRequest-epo-hasAllegedIrregularityType,
        epo-shape:epo-ReviewRequest-epo-hasReviewRequestFee,
        epo-shape:epo-ReviewRequest-epo-requestsRemedyType,
        epo-shape:epo-ReviewRequest-epo-specifiesReviewRequester ;
    sh:targetClass epo:ReviewRequest .

epo-shape:epo-ReviewRequestSummaryShape a sh:NodeShape ;
    rdfs:label "Review Request Summary" ;
    rdfs:comment "Overview of the requests received by the Buyer to review any of its decisions (e.g. the technical specifications, award decision), as set out in Art. 1(5) of Directive 89/665/EEC and Directive 92/13/EEC, and about the complainants that submitted the requests." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-ReviewRequestSummary-epo-concernsReviewSummaryForLot,
        epo-shape:epo-ReviewRequestSummary-epo-hasNumberOfReviewRequests,
        epo-shape:epo-ReviewRequestSummary-epo-hasReviewIrregularitySummary,
        epo-shape:epo-ReviewRequestSummary-epo-hasTotalNumberOfComplainants ;
    sh:targetClass epo:ReviewRequestSummary .

epo-shape:epo-ReviewRequesterShape a sh:NodeShape ;
    rdfs:label "Review Requester" ;
    rdfs:comment "Role of an Agent who requests the review of a (Procurement) Procedure." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:targetClass epo:ReviewRequester .

epo-shape:epo-ReviewTermShape a sh:NodeShape ;
    rdfs:label "Review Term" ;
    rdfs:comment "Conditions and stipulations defining particularities of the review." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-ReviewTerm-epo-definesReviewProcedureInformationProvider,
        epo-shape:epo-ReviewTerm-epo-definesReviewer,
        epo-shape:epo-ReviewTerm-epo-hasReviewDeadline,
        epo-shape:epo-ReviewTerm-epo-hasReviewDeadlineInformation,
        epo-shape:epo-ReviewTerm-epo-hasReviewProcedure ;
    sh:targetClass epo:ReviewTerm .

epo-shape:epo-ReviewerShape a sh:NodeShape ;
    rdfs:label "Reviewer" ;
    rdfs:comment "Role of an Agent who investigates the overall correctness of a Procurement Procedure, producing a related report. Additional Information: Any Organisation or Person may request a review of a Procurement Procedure." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-Reviewer-epo-hasReviewBodyType ;
    sh:targetClass epo:Reviewer .

epo-shape:epo-SecurityClearanceTermShape a sh:NodeShape ;
    rdfs:label "Security Clearance Term" ;
    rdfs:comment "Conditions and stipulations about the status requested of individuals allowing them access to classified information (state or organisational secrets) or to restricted areas, after completion of a thorough background check." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-SecurityClearanceTerm-epo-hasDeadline,
        epo-shape:epo-SecurityClearanceTerm-epo-isSecurityClearanceRequired ;
    sh:targetClass epo:SecurityClearanceTerm .

epo-shape:epo-SelectedCandidateListShape a sh:NodeShape ;
    rdfs:label "Selected Candidate List" ;
    rdfs:comment "Record of Candidates admitted to take part in award phases of procurements." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-SelectedCandidateList-epo-containsCandidate,
        epo-shape:epo-SelectedCandidateList-epo-hasStartDate ;
    sh:targetClass epo:SelectedCandidateList .

epo-shape:epo-SelectionCriteriaSummaryShape a sh:NodeShape ;
    rdfs:label "Selection Criteria Summary" ;
    rdfs:comment "Overview of the Selection Criteria." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-SelectionCriteriaSummary-epo-describesMinimumLevelOfStandards,
        epo-shape:epo-SelectionCriteriaSummary-epo-hasSelectionCriteriaStatedInProcurementDocuments ;
    sh:targetClass epo:SelectionCriteriaSummary .

epo-shape:epo-SelectionCriterionShape a sh:NodeShape ;
    rdfs:label "Selection Criterion" ;
    rdfs:comment "Criterion that describes a capacity Requirement that the Economic Operator needs to fulfill to participate in the procurement. Additional Information: Selection criteria may relate to: (a) suitability to pursue the professional activity; (b) economic and financial standing; (c) technical and professional ability" ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-SelectionCriterion-epo-hasSelectionCriterionType,
        epo-shape:epo-SelectionCriterion-epo-isUsedForCandidateRestriction ;
    sh:targetClass epo:SelectionCriterion .

epo-shape:epo-SelectionEvaluationTermShape a sh:NodeShape ;
    rdfs:label "Selection Evaluation Term" ;
    rdfs:comment "Conditions and stipulations defining particularities of the evaluation of Selection Criteria." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:targetClass epo:SelectionEvaluationTerm .

epo-shape:epo-SocialProcurementShape a sh:NodeShape ;
    rdfs:label "Social Procurement" ;
    rdfs:comment "Approach whereby Buyers seek to procure by fulfilling social objectives. Additional Information: Socially Responsible Public Procurement (SRPP) - ‘SRPP’ means Procurement Operations that take into account one or more of the following social considerations: employment opportunities, decent work, compliance with social and labour rights, social inclusion (including persons with disabilities), equal opportunities, accessibility design for all, taking account of sustainability criteria, including ethical trade issues and wider voluntary compliance with corporate social responsibility (CSR), while observing the principles enshrined in the Treaty for the European Union (TFEU) and the Procurement Directives. See Article 18 and Annex X Directive 2014/24." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-SocialProcurement-epo-fulfillsRequirement,
        epo-shape:epo-SocialProcurement-epo-hasNonAccessibilityCriterionJustification,
        epo-shape:epo-SocialProcurement-epo-includesAccessibilityCriterion ;
    sh:targetClass epo:SocialProcurement .

epo-shape:epo-SpecificationInformationShape a sh:NodeShape ;
    rdfs:label "Specification Information" ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-SpecificationInformation-epo-hasSourceSpecificationCustomisation,
        epo-shape:epo-SpecificationInformation-epo-hasSourceVersionSpecification,
        epo-shape:epo-SpecificationInformation-epo-isUsedInProfile ;
    sh:targetClass epo:SpecificationInformation .

epo-shape:epo-StatisticalInformationShape a sh:NodeShape ;
    rdfs:label "Statistical Information" ;
    rdfs:comment "Statistical data on the Procedure and the Lot. Additional Information At the present time Procurement Procedures are not fully electronic. At a later date, information on the Tenders received could be inferred by the data in the eProcurement System. Therefore this class is temporal and should cease to exist in fully electronic Procurement. The need for its presence responds also to the alignment with the Regulation (EU) 2019/1780 (eForms). Attention will have to be paid in the future to possible inconsistencies derived from data placed in other classes and data held in the Statistical Information class; e.g. the TenderEvaluation class (see eEvaluation diagram) has the attribute admissibileTender indicator, which in case of being false, may enter in contradiction with the highest or lowest Tender value for that very same inadmissible Tender." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:targetClass epo:StatisticalInformation .

epo-shape:epo-StrategicProcurementShape a sh:NodeShape ;
    rdfs:label "Strategic Procurement" ;
    rdfs:comment "Public Procurement that contributes to achieving pressing policy goals. Additional Information: Specific strategic goals could be, for example, Environmental Protection, innovation, job creation and the development of small and medium enterprises. The subclasses are given by the choices in BT-06 Strategic Procurement. Based on https://legalinstruments.oecd.org/en/instruments/OECD-LEGAL-0411 (see paragraph on \"background information\"." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-StrategicProcurement-epo-hasStrategicProcurementDescription ;
    sh:targetClass epo:StrategicProcurement .

epo-shape:epo-SubcontractTermShape a sh:NodeShape ;
    rdfs:label "Subcontract Term" ;
    rdfs:comment "A concept to describe the main information regarding the share of parts of the Contract to third parties." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-SubcontractTerm-epo-hasMaximumShare,
        epo-shape:epo-SubcontractTerm-epo-hasMinimumShare,
        epo-shape:epo-SubcontractTerm-epo-hasMinimumSubcontractorsProposedObligation,
        epo-shape:epo-SubcontractTerm-epo-hasSubcontractingInvolved,
        epo-shape:epo-SubcontractTerm-epo-hasSubcontractingObligation,
        epo-shape:epo-SubcontractTerm-epo-hasSubcontractorsProposedAboveObligation ;
    sh:targetClass epo:SubcontractTerm .

epo-shape:epo-SubcontractingEstimateShape a sh:NodeShape ;
    rdfs:label "Subcontracting Estimate" ;
    rdfs:comment "Approximation concerning the foreseen Subcontracting." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-SubcontractingEstimate-epo-hasEstimatedPercentage,
        epo-shape:epo-SubcontractingEstimate-epo-hasSubcontractingEstimatedValue,
        epo-shape:epo-SubcontractingEstimate-epo-hasSubjectMatter,
        epo-shape:epo-SubcontractingEstimate-epo-isSubcontractingPercentageKnown,
        epo-shape:epo-SubcontractingEstimate-epo-isSubcontractingValueKnown ;
    sh:targetClass epo:SubcontractingEstimate .

epo-shape:epo-SubcontractorShape a sh:NodeShape ;
    rdfs:label "Subcontractor" ;
    rdfs:comment "A Role of an Agent that has an agreement to perform part or all of the obligations of another Agents's Contract. Additional information For some Procedures, the Subcontractor signs as well the Contract between the Buyer and the Contractor. At tendering time, entities relied upon by the Economic Operators can be Subcontractors or not. When modelling ESPD we will analyze whether we need or not a Role named \"relied upon\"." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:targetClass epo:Subcontractor .

epo-shape:epo-SubmissionStatisticalInformationShape a sh:NodeShape ;
    rdfs:label "Submission Statistical Information" ;
    rdfs:comment "Statistical information about submissions on a given competition, either at Lot level or Mini-Competition level." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-SubmissionStatisticalInformation-epo-hasAbnormallyLowTenders,
        epo-shape:epo-SubmissionStatisticalInformation-epo-hasEEAReceivedTenders,
        epo-shape:epo-SubmissionStatisticalInformation-epo-hasEUReceivedTenders,
        epo-shape:epo-SubmissionStatisticalInformation-epo-hasElectronicTenders,
        epo-shape:epo-SubmissionStatisticalInformation-epo-hasEstimatedTotalSubcontracts,
        epo-shape:epo-SubmissionStatisticalInformation-epo-hasHighestReceivedTenderValue,
        epo-shape:epo-SubmissionStatisticalInformation-epo-hasInadmissibleTenders,
        epo-shape:epo-SubmissionStatisticalInformation-epo-hasLowestReceivedTenderValue,
        epo-shape:epo-SubmissionStatisticalInformation-epo-hasMediumTenderPerLots,
        epo-shape:epo-SubmissionStatisticalInformation-epo-hasNonEEAReceivedTenders,
        epo-shape:epo-SubmissionStatisticalInformation-epo-hasNonEUReceivedTenders,
        epo-shape:epo-SubmissionStatisticalInformation-epo-hasNumberOfTenderersInvited,
        epo-shape:epo-SubmissionStatisticalInformation-epo-hasOtherCountriesReceivedTenders,
        epo-shape:epo-SubmissionStatisticalInformation-epo-hasReceivedMicroTenders,
        epo-shape:epo-SubmissionStatisticalInformation-epo-hasReceivedParticipationRequests,
        epo-shape:epo-SubmissionStatisticalInformation-epo-hasReceivedSmallTenders,
        epo-shape:epo-SubmissionStatisticalInformation-epo-hasReceivedTenders,
        epo-shape:epo-SubmissionStatisticalInformation-epo-hasSMEReceivedTenders,
        epo-shape:epo-SubmissionStatisticalInformation-epo-hasSMEReceivedTendersExcludingSubcontractors,
        epo-shape:epo-SubmissionStatisticalInformation-epo-hasUnverifiedTenders,
        epo-shape:epo-SubmissionStatisticalInformation-epo-summarisesInformationForAwardOutcome ;
    sh:targetClass epo:SubmissionStatisticalInformation .

epo-shape:epo-SubmissionTermShape a sh:NodeShape ;
    rdfs:label "Submission Term" ;
    rdfs:comment "Conditions and stipulations defining particularities of submitting Documents to the Buyer. Additional Information: These Documents can be Tenders, Request To Participate and expressions of interest." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-SubmissionTerm-epo-definesTenderProcessor,
        epo-shape:epo-SubmissionTerm-epo-definesTenderReceiver,
        epo-shape:epo-SubmissionTerm-epo-hasEAuctionURL,
        epo-shape:epo-SubmissionTerm-epo-hasECataloguePermission,
        epo-shape:epo-SubmissionTerm-epo-hasESubmissionPermission,
        epo-shape:epo-SubmissionTerm-epo-hasGuaranteeDescription,
        epo-shape:epo-SubmissionTerm-epo-hasLanguage,
        epo-shape:epo-SubmissionTerm-epo-hasLateSubmissionInformationDescription,
        epo-shape:epo-SubmissionTerm-epo-hasLateSubmissionPermission,
        epo-shape:epo-SubmissionTerm-epo-hasNonElectronicSubmissionDescription,
        epo-shape:epo-SubmissionTerm-epo-hasNonElectronicSubmissionJustification,
        epo-shape:epo-SubmissionTerm-epo-hasReceiptDeadline,
        epo-shape:epo-SubmissionTerm-epo-hasReceiptExpressionDeadline,
        epo-shape:epo-SubmissionTerm-epo-hasReceiptParticipationRequestDeadline,
        epo-shape:epo-SubmissionTerm-epo-hasReceiptPreliminaryMarketConsultationDeadline,
        epo-shape:epo-SubmissionTerm-epo-hasReceiptTenderDeadline,
        epo-shape:epo-SubmissionTerm-epo-hasSubmissionURL,
        epo-shape:epo-SubmissionTerm-epo-hasTenderSubcontractingInformation,
        epo-shape:epo-SubmissionTerm-epo-hasTenderValidityDuration,
        epo-shape:epo-SubmissionTerm-epo-hasTenderValidityPeriod,
        epo-shape:epo-SubmissionTerm-epo-hasVariantPermission,
        epo-shape:epo-SubmissionTerm-epo-isAdvancedElectronicSignatureRequired,
        epo-shape:epo-SubmissionTerm-epo-isGuaranteeRequired,
        epo-shape:epo-SubmissionTerm-epo-isMultipleTenderSubmissionAllowed ;
    sh:targetClass epo:SubmissionTerm .

epo-shape:epo-SystemShape a sh:NodeShape ;
    rdfs:label "System" ;
    rdfs:comment "Software application used for performing Procurement activities." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-System-epo-isOwnedByAgent ;
    sh:targetClass epo:System .

epo-shape:epo-TaxDocumentationShape a sh:NodeShape ;
    rdfs:label "Tax Documentation" ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:targetClass epo:TaxDocumentation .

epo-shape:epo-TaxInformationProviderShape a sh:NodeShape ;
    rdfs:label "Tax Information Provider" ;
    rdfs:comment "A Role of an Agent responsible for providing information concerning the general regulatory framework for taxes." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:targetClass epo:TaxInformationProvider .

epo-shape:epo-TechnicalAbilitySummaryShape a sh:NodeShape ;
    rdfs:label "Technical Ability Summary" ;
    rdfs:comment "Overview of the expertise required for the economic operator to execute the contract." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:targetClass epo:TechnicalAbilitySummary .

epo-shape:epo-TechnicalSpecificationShape a sh:NodeShape ;
    rdfs:label "Technical Specification" ;
    rdfs:comment "A set of documented Requirements applicable to the object of the Procurement. Additional Information: A specification often includes technical standards." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:targetClass epo:TechnicalSpecification .

epo-shape:epo-TechniqueShape a sh:NodeShape ;
    rdfs:label "Technique" ;
    rdfs:comment "Method used for conducting Procurement Procedures. Several Techniques can be combined in one single Procurement Procedure (e.g. eAuction can be carried out in a Framework Agreement or DPS)." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-Technique-epo-hasEstimatedValidityPeriod,
        epo-shape:epo-Technique-epo-hasValidityPeriod ;
    sh:targetClass epo:Technique .

epo-shape:epo-TenderAwardOutcomeShape a sh:NodeShape ;
    rdfs:label "Tender Award Outcome" ;
    rdfs:comment "Result concerning the Tender attributed by the Awarder." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-TenderAwardOutcome-epo-concernsTender,
        epo-shape:epo-TenderAwardOutcome-epo-hasAwardRank,
        epo-shape:epo-TenderAwardOutcome-epo-indicatesAwardToWinner,
        epo-shape:epo-TenderAwardOutcome-epo-specifiesForeignSubsidiesMeasureConclusion ;
    sh:targetClass epo:TenderAwardOutcome .

epo-shape:epo-TenderGroupShape a sh:NodeShape ;
    rdfs:label "Tender Group" ;
    rdfs:comment "Specific Offer in response to a Lot Group. Additional Information: This class is generally used to provide the Monetary Value in response to a Lot Group." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-TenderGroup-epo-comprisesTender,
        epo-shape:epo-TenderGroup-epo-hasTotalValue,
        epo-shape:epo-TenderGroup-epo-isSubmittedForLotGroup ;
    sh:targetClass epo:TenderGroup .

epo-shape:epo-TenderProcessorShape a sh:NodeShape ;
    rdfs:label "Tender Processor" ;
    rdfs:comment "A Role of an Agent responsible for processing Tenders." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:targetClass epo:TenderProcessor .

epo-shape:epo-TenderReceiverShape a sh:NodeShape ;
    rdfs:label "Tender Receiver" ;
    rdfs:comment "A Role of an Agent responsible for receiving Tenders." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:targetClass epo:TenderReceiver .

epo-shape:epo-TenderShape a sh:NodeShape ;
    rdfs:label "Tender" ;
    rdfs:comment "Information submitted by the Economic Operator to specify its Offer regarding a specific Lot, in response to the call for Tender." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-Tender-epo-foreseesConcession,
        epo-shape:epo-Tender-epo-foreseesSubcontracting,
        epo-shape:epo-Tender-epo-hasElectronicSubmission,
        epo-shape:epo-Tender-epo-hasFinancialOfferValue,
        epo-shape:epo-Tender-epo-hasItemCountryOfOrigin,
        epo-shape:epo-Tender-epo-hasSubcontracting,
        epo-shape:epo-Tender-epo-isSubjectToGrouping,
        epo-shape:epo-Tender-epo-isSubmittedBy,
        epo-shape:epo-Tender-epo-isSubmittedForLot,
        epo-shape:epo-Tender-epo-isSupportedBy,
        epo-shape:epo-Tender-epo-isVariant ;
    sh:targetClass epo:Tender .

epo-shape:epo-TendererShape a sh:NodeShape ;
    rdfs:label "Tenderer" ;
    rdfs:comment "A Role of an Agent that has submitted a Tender. Additional Information: A Tenderer is an Economic Operator or group of Economic Operators that has submitted a Tender." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-Tenderer-epo-substantiatesExclusionGround ;
    sh:targetClass epo:Tenderer .

epo-shape:epo-TermShape a sh:NodeShape ;
    rdfs:label "Term" ;
    rdfs:comment "A governing condition or stipulation." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:targetClass epo:Term .

epo-shape:epo-UniqueResponsibleOfTheProcurementShape a sh:NodeShape ;
    rdfs:label "Unique Responsible Of The Procurement" ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-UniqueResponsibleOfTheProcurement-epo-playedBy,
        epo-shape:epo-UniqueResponsibleOfTheProcurement-epo-signsAwardDecision ;
    sh:targetClass epo:UniqueResponsibleOfTheProcurement .

epo-shape:epo-WinnerShape a sh:NodeShape ;
    rdfs:label "Winner" ;
    rdfs:comment "A Role of an Agent to whom a Lot is awarded." ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:property epo-shape:epo-Winner-epo-needsToBeATenderer ;
    sh:targetClass epo:Winner .

