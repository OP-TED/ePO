    sh:path epo:hasUnverifiedTenders .

epo-shape:epo-SubmissionStatisticalInformation-epo-summarisesInformationForAwardOutcome a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:class epo:AwardOutcome ;
    sh:description "Relates to submission for the given competition, either at Lot level or Mini-Competition level." ;
