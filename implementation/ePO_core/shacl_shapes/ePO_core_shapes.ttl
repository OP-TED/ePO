    sh:nodeKind sh:IRI ;
    sh:path epo:hasLowestReceivedTenderValue ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasLowestReceivedTenderValue> ?that . ?that <http://data.europa.eu/a4g/ontology#hasLowestReceivedTenderValue> ?this .}" ] .

