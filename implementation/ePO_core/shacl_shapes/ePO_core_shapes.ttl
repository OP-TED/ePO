    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:datatype xsd:integer ;
    sh:description "The amount of tenders received from micro, small and medium-sized enterprises. <u>Additional Information:</u> See Commission Recommendation 2003/361/EC. The ReceivedSMETenderLots is used when the size of the company is not exactly known." ;
