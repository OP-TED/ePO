    sh:nodeKind sh:IRI ;
    sh:path epo:isOwnedByAgent ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#isOwnedByAgent> ?that . ?that <http://data.europa.eu/a4g/ontology#isOwnedByAgent> ?this .}" ] .

