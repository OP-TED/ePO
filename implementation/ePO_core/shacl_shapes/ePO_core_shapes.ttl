epo-shape:epo-AccessTerm-epo-providesProcurementDocumentsInOfficialLanguage a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:class skos:Concept ;
    sh:name "Provides procurement documents in official language" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:providesProcurementDocumentsInOfficialLanguage .

epo-shape:epo-AccessTerm-epo-providesProcurementDocumentsInUnofficialLanguage a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:class skos:Concept ;
    sh:name "Provides procurement documents in unofficial language" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:providesProcurementDocumentsInUnofficialLanguage .

epo-shape:epo-AccessTerm-epo-refersToPlannedPart a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:class epo:PlannedProcurementPart ;
    sh:name "Refers to planned part" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:refersToPlannedPart ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#refersToPlannedPart> ?that . ?that <http://data.europa.eu/a4g/ontology#refersToPlannedPart> ?this .}" ] .

epo-shape:epo-AgentInRole-epo-contextualisedBy a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:class epo:ProcurementElement ;
    sh:description "The place of the AgentInRole in the procurement is expressed by a ProcurementObject." ;
    sh:name "Contextualised by" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:contextualisedBy ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#contextualisedBy> ?that . ?that <http://data.europa.eu/a4g/ontology#contextualisedBy> ?this .}" ] .

epo-shape:epo-AgentInRole-epo-exposesChannel a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:class <http://data.europa.eu/m8g/Channel> ;
    sh:name "Exposes channel" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:exposesChannel ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#exposesChannel> ?that . ?that <http://data.europa.eu/a4g/ontology#exposesChannel> ?this .}" ] .

epo-shape:epo-AgentInRole-epo-hasContactPointInRole a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:class <http://data.europa.eu/m8g/ContactPoint> ;
    sh:name "Has contact point in role" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasContactPointInRole ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasContactPointInRole> ?that . ?that <http://data.europa.eu/a4g/ontology#hasContactPointInRole> ?this .}" ] .

epo-shape:epo-AgentInRole-epo-playedBy a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:class foaf:Agent ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Played by" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:playedBy ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#playedBy> ?that . ?that <http://data.europa.eu/a4g/ontology#playedBy> ?this .}" ] .

epo-shape:epo-AuxiliaryParty-epo-providesDocumentation a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:class epo:Documentation ;
    sh:name "Provides documentation" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:providesDocumentation ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#providesDocumentation> ?that . ?that <http://data.europa.eu/a4g/ontology#providesDocumentation> ?this .}" ] .

epo-shape:epo-AwardCriterion-epo-hasAwardCriteriaStatedInProcurementDocuments a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:datatype xsd:boolean ;
    sh:description "The Award Criteria are provided in the Procurement Documents." ;
    sh:maxCount 1 ;
    sh:name "Has award criteria stated in procurement documents" ;
    sh:path epo:hasAwardCriteriaStatedInProcurementDocuments .

epo-shape:epo-AwardCriterion-epo-hasAwardCriterionType a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:class skos:Concept ;
    sh:description "Category of award criterion." ;
    sh:maxCount 1 ;
    sh:name "Has award criterion type" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasAwardCriterionType .

epo-shape:epo-AwardCriterion-epo-hasFixedValue a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:datatype xsd:decimal ;
    sh:maxCount 1 ;
    sh:name "Has fixed value" ;
    sh:path epo:hasFixedValue .

epo-shape:epo-AwardCriterion-epo-hasFixedValueType a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:class skos:Concept ;
    sh:description "The method to interpret the fixed value as pertaining to a total or unit." ;
    sh:maxCount 1 ;
    sh:name "Has fixed value type" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasFixedValueType .

epo-shape:epo-AwardDecision-epo-comprisesAwardOutcome a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:class epo:AwardOutcome ;
    sh:description "Incorporates AwardOutcome." ;
    sh:name "Comprises award outcome" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:comprisesAwardOutcome ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#comprisesAwardOutcome> ?that . ?that <http://data.europa.eu/a4g/ontology#comprisesAwardOutcome> ?this .}" ] .

epo-shape:epo-AwardDecision-epo-hasAwardDecisionDate a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:datatype xsd:dateTime ;
    sh:description "The official date of the award decision." ;
    sh:maxCount 1 ;
    sh:name "Has award decision date" ;
    sh:path epo:hasAwardDecisionDate .

epo-shape:epo-AwardEvaluationTerm-epo-hasAwardCriteriaEvaluationFormula a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:description "The mathematical equation or any other description used for complicated weighing of criteria (e.g. non-linear weighing, the analytic hierarchy process) when a weighing cannot be expressed per criterion." ;
    sh:name "Has award criteria evaluation formula" ;
    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
    sh:path epo:hasAwardCriteriaEvaluationFormula .

epo-shape:epo-AwardEvaluationTerm-epo-hasAwardCriteriaOrderJustification a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:description "The justification for only indicating the award criteria's order of importance, not their weighing." ;
    sh:maxCount 1 ;
    sh:name "Has award criteria order justification" ;
    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
    sh:path epo:hasAwardCriteriaOrderJustification .

epo-shape:epo-AwardEvaluationTerm-epo-hasOverallCostAwardCriteriaPonderation a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:datatype xsd:decimal ;
    sh:description "The weighting given to cost. Additional Information: This weighting covers usually all cost criteria against price or quality criteria." ;
    sh:maxCount 1 ;
    sh:name "Has overall cost award criteria ponderation" ;
    sh:path epo:hasOverallCostAwardCriteriaPonderation .

epo-shape:epo-AwardEvaluationTerm-epo-hasOverallPriceAwardCriteriaPonderation a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:datatype xsd:decimal ;
    sh:description "The weighting given to price. Additional Information: This weighting covers usually all price criteria against cost or quality criteria." ;
    sh:maxCount 1 ;
    sh:name "Has overall price award criteria ponderation" ;
    sh:path epo:hasOverallPriceAwardCriteriaPonderation .

epo-shape:epo-AwardEvaluationTerm-epo-hasOverallQualityAwardCriteriaPonderation a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:datatype xsd:decimal ;
    sh:description "The weighting given to quality. Additional Information: This weighting covers usually all quality criteria against price or cost criteria." ;
    sh:maxCount 1 ;
    sh:name "Has overall quality award criteria ponderation" ;
    sh:path epo:hasOverallQualityAwardCriteriaPonderation .

epo-shape:epo-AwardOutcome-epo-comprisesTenderAwardOutcome a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:class epo:TenderAwardOutcome ;
    sh:description "Incorporates TenderAwardOutcome." ;
    sh:name "Comprises tender award outcome" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:comprisesTenderAwardOutcome ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#comprisesTenderAwardOutcome> ?that . ?that <http://data.europa.eu/a4g/ontology#comprisesTenderAwardOutcome> ?this .}" ] .

epo-shape:epo-AwardOutcome-epo-hasAwardJustification a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:description "Description of the reason behind an award or non-award of a given Tender. Additional information: This is generally used when the non award justification code is set to \"Other\" and when the Lot is awarded. It may highlight the justification of the non-award of a Tender with regard to awarded Tenders." ;
    sh:maxCount 1 ;
    sh:name "Has award justification" ;
    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
    sh:path epo:hasAwardJustification .

epo-shape:epo-AwardOutcome-epo-hasAwardStatus a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:class skos:Concept ;
    sh:description "Indicates whether the lot is awarded, not awarded or still open." ;
    sh:maxCount 1 ;
    sh:name "Has award status" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasAwardStatus .

epo-shape:epo-AwardOutcome-epo-hasAwardedValue a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:class epo:MonetaryValue ;
    sh:description "The value of the procurement provided by the Award Decision. Additional Information: Different cases of awarded values may refer to a lot, the global value of the procedure, or of a combinatorial value of a group of lots. In the case of framework agreements and dynamic purchasing systems this refers to the maximum awarded value." ;
    sh:maxCount 1 ;
    sh:name "Has awarded value" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasAwardedValue ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasAwardedValue> ?that . ?that <http://data.europa.eu/a4g/ontology#hasAwardedValue> ?this .}" ] .

epo-shape:epo-AwardOutcome-epo-hasBargainPrice a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:class epo:MonetaryValue ;
    sh:description "The value of procured supplies that have used a particularly advantageous opportunity available for a very short time at a value considerably lower than normal market prices." ;
    sh:maxCount 1 ;
    sh:name "Has bargain price" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasBargainPrice ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasBargainPrice> ?that . ?that <http://data.europa.eu/a4g/ontology#hasBargainPrice> ?this .}" ] .

epo-shape:epo-AwardOutcome-epo-hasNonAwardJustification a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:class skos:Concept ;
    sh:description "On hold; Enumeration." ;
    sh:maxCount 1 ;
    sh:name "Has non award justification" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasNonAwardJustification .

epo-shape:epo-Business-epo-hasBeneficialOwner a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:class <http://www.w3.org/ns/person#Person> ;
    sh:description "A role of any natural person(s) who ultimately owns or controls the organisation or on whose behalf a transaction or activity is being conducted. Additional Information: This role is defined in the directive EU 2015/849 and it's beyond the scope for public eProcurement domain." ;
    sh:name "Has beneficial owner" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasBeneficialOwner ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasBeneficialOwner> ?that . ?that <http://data.europa.eu/a4g/ontology#hasBeneficialOwner> ?this .}" ] .

epo-shape:epo-Business-epo-hasBusinessSize a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:class skos:Concept ;
    sh:description "The category of the business depending on number of employees and turnover. Additional information: See Commission Recommendation of 6 May 2003 concerning the definition of micro, small and medium-sized enterprises." ;
    sh:maxCount 1 ;
    sh:name "Has business size" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasBusinessSize .

epo-shape:epo-Business-epo-isListedCompany a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:datatype xsd:boolean ;
    sh:description "Public companies listed on a stock exchange and subject to disclosure requirements (either by stock exchange rules or through law or enforceable means), which impose requirements to ensure adequate transparency of beneficial ownership. <u>Additional Information:</u> In eForms this indicator is used when the nationality of beneficial owner is not provided because the Economic Operator is registered in a regulated market that is subject to disclosure requirements consistent with Union law or subject to equivalent international standards which ensure adequate transparency of ownership information." ;
    sh:maxCount 1 ;
    sh:name "Is listed company" ;
    sh:path epo:isListedCompany .

epo-shape:epo-Buyer-epo-delegatesAncillaryActivitiesTo a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:class epo:ProcurementServiceProvider ;
    sh:description "Additional Information: Directive 2014/24/EU describes ancillary purchasing activities as activities consisting in the provision of support to purchasing activities, in particular in the following forms: (a) technical infrastructure enabling contracting authorities to award public contracts or to conclude framework agreements for works, supplies or services; (b) advice on the conduct or design of public procurement procedures; (c) preparation and management of procurement procedures on behalf and for the account of the contracting authority concerned." ;
    sh:name "Delegates ancillary activities to" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:delegatesAncillaryActivitiesTo ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#delegatesAncillaryActivitiesTo> ?that . ?that <http://data.europa.eu/a4g/ontology#delegatesAncillaryActivitiesTo> ?this .}" ] .

epo-shape:epo-Buyer-epo-hasActivityDescription a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:description "In the ePO ontology a taxonomy with all activities, based on different classifications (COFOG, UTILITIES, NACE), will be provided. In ePO this field is to be used exclusively to complement the definition attached to the MainActivityCode. However, in eForms there is the code \"other\" to cover undefined activities. For mapping to this eForms feature one could also use this property." ;
    sh:name "Has activity description" ;
    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
    sh:path epo:hasActivityDescription .

epo-shape:epo-Buyer-epo-hasBuyerProfile a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:datatype xsd:anyURI ;
    sh:description "Website address where the buyer publishes information on its procurement procedures and general information." ;
    sh:maxCount 1 ;
    sh:name "Has buyer profile" ;
    sh:path epo:hasBuyerProfile .

epo-shape:epo-Buyer-epo-isContractingEntity a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:datatype xsd:boolean ;
    sh:description "Role of entities, which: (a) are contracting authorities or public undertakings and which pursue one of the activities referred to in Articles 8 to 14 of the Directive 2014/25/EU. (b) when they are not contracting authorities or public undertakings, have as one of their activities any of the activities referred to in Articles 8 to 14, or any combination thereof and operate on the basis of special or exclusive rights granted by a competent authority of a Member State. Additional Information: The indicator is needed in order to discriminate between those contracts where the Contracting Entity acts as a Contracting Authority undergoing the limits and the rules of Directive 24 and those where it acts as a Contracting Entity, with certain relaxed constraints. For example, the Contracting Entities have different thresholds for the application of Directive 24 if compared with Contracting Authorities." ;
    sh:maxCount 1 ;
    sh:name "Is contracting entity" ;
    sh:path epo:isContractingEntity .

epo-shape:epo-Certificate-epo-attestedByLabel a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:class epo:CertificationLabel ;
    sh:description "Relation indicating which label the certificate is about." ;
    sh:maxCount 1 ;
    sh:name "Attested by label" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:attestedByLabel ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#attestedByLabel> ?that . ?that <http://data.europa.eu/a4g/ontology#attestedByLabel> ?this .}" ] .

epo-shape:epo-Certificate-epo-hasCertificationNumber a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:description "The unique identifier of the certificate." ;
    sh:maxCount 1 ;
    sh:name "Has certification number" ;
    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
    sh:path epo:hasCertificationNumber .

epo-shape:epo-Certificate-epo-issuedByCertifier a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:class epo:Certifier ;
    sh:description "Relation indicating the Certifier responsible for providing the ItemCertificate. Additional Information: Certifier is a role played by an organisation." ;
    sh:maxCount 1 ;
    sh:name "Issued by certifier" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:issuedByCertifier ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#issuedByCertifier> ?that . ?that <http://data.europa.eu/a4g/ontology#issuedByCertifier> ?this .}" ] .

epo-shape:epo-CertificationLabel-epo-hasLabelType a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:class skos:Concept ;
    sh:description "The label type such environmental, quality, social etc." ;
    sh:maxCount 1 ;
    sh:name "Has label type" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasLabelType .

epo-shape:epo-CertificationLabel-epo-hasReferenceURI a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:datatype xsd:anyURI ;
    sh:description "A reference to where the label specification (norms, expectations, standards and policies) can be found." ;
    sh:maxCount 1 ;
    sh:name "Has reference URI" ;
    sh:path epo:hasReferenceURI .

epo-shape:epo-ChangeInformation-epo-concernsNotice a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:class epo:Notice ;
    sh:description "Relates to Notice." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Concerns notice" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:concernsNotice ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#concernsNotice> ?that . ?that <http://data.europa.eu/a4g/ontology#concernsNotice> ?this .}" ] .

epo-shape:epo-ChangeInformation-epo-hasAdditionalInformation a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:description "Supplementary data about the instance of the concept." ;
    sh:maxCount 1 ;
    sh:name "Has additional information" ;
    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
    sh:path epo:hasAdditionalInformation .

epo-shape:epo-ChangeInformation-epo-hasChangeDescription a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:description "Explanatory text about the instance of the concept." ;
    sh:name "Has change description" ;
    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
    sh:path epo:hasChangeDescription .

epo-shape:epo-ChangeInformation-epo-hasChangeJustification a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:class skos:Concept ;
    sh:description "Code explaining the change." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Has change justification" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasChangeJustification .

epo-shape:epo-ChangeInformation-epo-hasChangeReasonDescription a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:description "Explanatory text about why the element is altered." ;
    sh:name "Has change reason description" ;
    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
    sh:path epo:hasChangeReasonDescription .

epo-shape:epo-ChangeInformation-epo-hasProcurementDocumentChangeDate a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:datatype xsd:dateTime ;
    sh:description "The date and time of the change." ;
    sh:maxCount 1 ;
    sh:name "Has procurement document change date" ;
    sh:path epo:hasProcurementDocumentChangeDate .

epo-shape:epo-ChangeInformation-epo-isProcurementDocumentChanged a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:datatype xsd:boolean ;
    sh:description "One or more procurement documents have been changed." ;
    sh:maxCount 1 ;
    sh:name "Is procurement document changed" ;
    sh:path epo:isProcurementDocumentChanged .

epo-shape:epo-ChangeInformation-epo-refersToPreviousNotice a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:class epo:Notice ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Refers to previous notice" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:refersToPreviousNotice ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#refersToPreviousNotice> ?that . ?that <http://data.europa.eu/a4g/ontology#refersToPreviousNotice> ?this .}" ] .

epo-shape:epo-ChangeInformation-epo-relatesToEFormSectionIdentifier a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:class adms:Identifier ;
    sh:minCount 1 ;
    sh:name "Relates to E form section identifier" ;
    sh:nodeKind sh:IRI ;
