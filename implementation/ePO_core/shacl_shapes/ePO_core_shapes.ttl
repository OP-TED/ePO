epo-shape:epo-SubmissionTerm-epo-hasGuaranteeDescription a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:description "Information on the financial commitment required from the economic operator. Additional Information: 1. This information may include the amount and the way of delivering of the guarantee 2. The financial commitment may be retained by the buyer in the case the tenderer withdraws the submitted information (i.e. tender, expression of interest and request for participation, but not request for clarifications) before the award of the contract or does not sign the contract. 3. Usual modalities are bonds, cheques, loans, other." ;
    sh:name "Has guarantee description" ;
    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
    sh:path epo:hasGuaranteeDescription .

epo-shape:epo-SubmissionTerm-epo-hasLanguage a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:class skos:Concept ;
    sh:description "Language in which the submitted information is to be expressed." ;
    sh:name "Has language" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasLanguage .

epo-shape:epo-SubmissionTerm-epo-hasLateSubmissionInformationDescription a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:description "A narrative text explaining the content of the economic operator information that can be submitted late. Additional Information This does not apply to requests for clarifications." ;
    sh:name "Has late submission information description" ;
    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
    sh:path epo:hasLateSubmissionInformationDescription .

epo-shape:epo-SubmissionTerm-epo-hasLateSubmissionPermission a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:class skos:Concept ;
    sh:description "Whether economic operator-related information can be supplemented even after the submission deadline. Additional Information This is specific to the information on the economic operator and not the actual offer. This does not apply to the requests for clarification." ;
    sh:maxCount 1 ;
    sh:name "Has late submission permission" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasLateSubmissionPermission .

epo-shape:epo-SubmissionTerm-epo-hasNonElectronicSubmissionDescription a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:description "Textual explanation of how non-electronic information is to be presented." ;
    sh:name "Has non electronic submission description" ;
    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
    sh:path epo:hasNonElectronicSubmissionDescription .

epo-shape:epo-SubmissionTerm-epo-hasNonElectronicSubmissionJustification a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:class skos:Concept ;
    sh:description "Reason for not accepting electronic information." ;
    sh:name "Has non electronic submission justification" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasNonElectronicSubmissionJustification .

epo-shape:epo-SubmissionTerm-epo-hasReceiptDeadline a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:datatype xsd:dateTime ;
    sh:description "The time limit for receiving submissions. Additional Information This is the deadline by which the buyer must receive submissions (e.g. tenders, requests to participate, clarifications, etc.) and is not the time at which the information is submitted by the economic operator. This attribute should be used for standard forms mappings." ;
    sh:maxCount 1 ;
    sh:name "Has receipt deadline" ;
    sh:path epo:hasReceiptDeadline .

epo-shape:epo-SubmissionTerm-epo-hasReceiptExpressionDeadline a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:datatype xsd:dateTime ;
    sh:description "Time limit for receipt of expressions of interest. Pending of review by the WG" ;
    sh:maxCount 1 ;
    sh:name "Has receipt expression deadline" ;
    sh:path epo:hasReceiptExpressionDeadline .

epo-shape:epo-SubmissionTerm-epo-hasReceiptParticipationRequestDeadline a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:datatype xsd:dateTime ;
    sh:description "The time limit until which requests to participate can be received." ;
    sh:maxCount 1 ;
    sh:name "Has receipt participation request deadline" ;
    sh:path epo:hasReceiptParticipationRequestDeadline .

epo-shape:epo-SubmissionTerm-epo-hasReceiptPreliminaryMarketConsultationDeadline a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:datatype xsd:dateTime ;
    sh:description "The time limit until which answers to the Preliminary Market Consultation can be received." ;
    sh:maxCount 1 ;
    sh:name "Has receipt preliminary market consultation deadline" ;
    sh:path epo:hasReceiptPreliminaryMarketConsultationDeadline .

epo-shape:epo-SubmissionTerm-epo-hasReceiptTenderDeadline a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:datatype xsd:dateTime ;
    sh:description "The time limit until which the Tenders can be received." ;
    sh:maxCount 1 ;
    sh:name "Has receipt tender deadline" ;
    sh:path epo:hasReceiptTenderDeadline .

epo-shape:epo-SubmissionTerm-epo-hasSubmissionURL a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:datatype xsd:anyURI ;
    sh:name "Has submission URL" ;
    sh:path epo:hasSubmissionURL .

epo-shape:epo-SubmissionTerm-epo-hasTenderSubcontractingInformation a sh:PropertyShape ;
