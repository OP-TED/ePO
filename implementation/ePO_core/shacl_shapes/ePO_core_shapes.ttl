    sh:path epo:summarisesInformationForAwardOutcome ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#summarisesInformationForAwardOutcome> ?that . ?that <http://data.europa.eu/a4g/ontology#summarisesInformationForAwardOutcome> ?this .}" ] .

