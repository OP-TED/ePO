    sh:maxCount 1 ;
    sh:name "Has inadmissible tenders" ;
    sh:path epo:hasInadmissibleTenders .

epo-shape:epo-SubmissionStatisticalInformation-epo-hasLowestReceivedTenderValue a sh:PropertyShape ;
