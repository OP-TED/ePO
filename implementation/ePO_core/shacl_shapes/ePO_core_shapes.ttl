    sh:maxCount 1 ;
    sh:name "Has maximum share" ;
    sh:path epo:hasMaximumShare .

epo-shape:epo-SubcontractTerm-epo-hasMinimumShare a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
