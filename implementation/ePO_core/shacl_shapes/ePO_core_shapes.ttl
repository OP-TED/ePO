    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#isSubjectToTerm> ?that . ?that <http://data.europa.eu/a4g/ontology#isSubjectToTerm> ?this .}" ] .

