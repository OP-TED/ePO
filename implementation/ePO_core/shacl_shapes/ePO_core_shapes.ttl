    sh:description "Indicates whether the contract is subject to a renewal clause." ;
    sh:maxCount 1 ;
    sh:name "Is renewal indicator" ;
    sh:path epo:isRenewalIndicator .

epo-shape:epo-Contractor-epo-foreseesSubcontractor a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:class epo:Subcontractor ;
    sh:maxCount 1 ;
    sh:name "Foresees subcontractor" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:foreseesSubcontractor ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#foreseesSubcontractor> ?that . ?that <http://data.europa.eu/a4g/ontology#foreseesSubcontractor> ?this .}" ] .

