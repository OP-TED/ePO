    sh:maxCount 1 ;
    sh:name "Has received small tenders" ;
    sh:path epo:hasReceivedSmallTenders .

epo-shape:epo-SubmissionStatisticalInformation-epo-hasReceivedTenders a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:datatype xsd:integer ;
