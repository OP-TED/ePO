epo-shape:epo-ContractTerm-epo-hasMaximumNumberOfRenewals a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:datatype xsd:integer ;
    sh:description "The maximum number of times the contract can be renewed. Additional Information By renewing, the buyer reserves the right (i.e. not an obligation) to renew the contract (i.e. extend its duration) without a new procurement procedure. For example, a contract may be valid for one year and the buyer may keep a possibility to renew it (e.g. once, twice) for another three months, if he is content with the services he received. PLEASE REVIEW THIS DEFINITION AGAIN WITH THE WORKING GROUP. It was originally taken from eForms." ;
    sh:maxCount 1 ;
    sh:name "Has maximum number of renewals" ;
    sh:path epo:hasMaximumNumberOfRenewals .

epo-shape:epo-ContractTerm-epo-hasOptions a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:datatype xsd:boolean ;
    sh:description "The buyer reserves the right (not an obligation) for additional purchases from the contractor (while the contract is valid)." ;
    sh:maxCount 1 ;
    sh:name "Has options" ;
    sh:path epo:hasOptions .

epo-shape:epo-ContractTerm-epo-hasOptionsDescription a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:description "The motivation and details about additional purchases that the buyer may undertake while the contract is valid." ;
    sh:name "Has options description" ;
    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
    sh:path epo:hasOptionsDescription .

epo-shape:epo-ContractTerm-epo-hasPaymentArrangement a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:description "Information about financial clauses that will govern some economic aspects of the execution of the contract. Additional Information: These clauses usually refer to financial and payment provisions. This type of information should be structured instead of a free text in order to reuse it an ideal world. Unfortunately this is an information that in the real life no one is willing to provide pro-actively. WG Pending of discussion with eForms" ;
    sh:name "Has payment arrangement" ;
    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
    sh:path epo:hasPaymentArrangement .

epo-shape:epo-ContractTerm-epo-hasPerformanceConditions a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:description "The particular conditions and additional information related to the execution of the contract. Additional Information: For example, specific information about the place of performance, intermediary deliverables, compensation for damages, intellectual property rights." ;
    sh:name "Has performance conditions" ;
    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
    sh:path epo:hasPerformanceConditions .

epo-shape:epo-ContractTerm-epo-hasPerformingStaffQualificationInformation a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:class skos:Concept ;
    sh:description "Explanation as to if and/or when information of the persons to carry out the contract is to be provided. The codelist to be used is at-voc:requirement-stage which is available at http://publications.europa.eu/resource/dataset/requirement-stage" ;
    sh:name "Has performing staff qualification information" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasPerformingStaffQualificationInformation .

epo-shape:epo-ContractTerm-epo-hasPlaceOfPerformanceAdditionalInformation a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:description "Further details on the location of the execution of the contract." ;
    sh:name "Has place of performance additional information" ;
    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
    sh:path epo:hasPlaceOfPerformanceAdditionalInformation .

epo-shape:epo-ContractTerm-epo-hasRenewalDescription a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:description "Any other information about the renewal(s)." ;
    sh:name "Has renewal description" ;
    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
    sh:path epo:hasRenewalDescription .

epo-shape:epo-ContractTerm-epo-hasReservedExecution a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:class skos:Concept ;
    sh:maxCount 1 ;
    sh:name "Has reserved execution" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasReservedExecution .

epo-shape:epo-ContractTerm-epo-isRenewalIndicator a sh:PropertyShape ;
