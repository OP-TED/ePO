    sh:description "The minimum proportion of something to be distributed. Additional Information: In the case of subcontracting the share may refer to the proportion of works, services or supplies being subcontracted." ;
    sh:maxCount 1 ;
    sh:name "Has minimum share" ;
    sh:path epo:hasMinimumShare .

epo-shape:epo-SubcontractTerm-epo-hasMinimumSubcontractorsProposedObligation a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:core-shape ;
    sh:datatype xsd:decimal ;
