  <rdf:Description rdf:about="http://data.europa.eu/a4g/data-shape#epo-SubcontractorShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <sh:targetClass rdf:resource="http://data.europa.eu/a4g/ontology#Subcontractor"/>
    <rdfs:comment>A Role of an Agent that has an agreement to perform part or all of the obligations of another Agents's Contract. Additional information For some Procedures, the Subcontractor signs as well the Contract between the Buyer and the Contractor. At tendering time, entities relied upon by the Economic Operators can be Subcontractors or not. When modelling ESPD we will analyze whether we need or not a Role named "relied upon".</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
    <rdfs:label>Subcontractor</rdfs:label>
  </rdf:Description>
