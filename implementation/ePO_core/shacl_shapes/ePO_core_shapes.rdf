  <rdf:Description rdf:about="http://data.europa.eu/a4g/data-shape#epo-ContextualProjectionShape">
    <rdfs:label>Contextual Projection</rdfs:label>
    <sh:targetClass rdf:resource="http://data.europa.eu/a4g/ontology#ContextualProjection"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:comment>Projection of an Entity and all of its properties that hold in a given Situation Context. Additional Information: The contextual projection does not have its own identity (-I), is dependent (+D) on the described Entity, and is anti-rigid (~R) We say that ContextualProjection *describes* an Entity. Adaptation of ContextSlices pattern encoding a 4D view. http://ontologydesignpatterns.org/wiki/Submissions:Context_Slices</rdfs:comment>
  </rdf:Description>
