    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
    <rdfs:label>Clean Vehicle Directive Information</rdfs:label>
    <rdfs:comment>Information related to clean vehicles legislation. Additional information: In the European Union, the legislation concerned is the European Parliament and Council 2009/33/EC (Clean Vehicles Directive – CVD).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/data-shape#epo-CleanVehicleDirectiveInformation-epo-hasCleanVehicles">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
    <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
    <sh:description>The number of all clean vehicles that have either been purchased, leased, rented, hired-purchased or their use has been contractually committed to for the provision of a purchased service. Additional Information: In the European Union, the legal requirements and scope for the provision of these vehicles or services are covered by Directive 2009/33/EC.</sh:description>
    <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#hasCleanVehicles"/>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
    <sh:name>Has clean vehicles</sh:name>
    <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
