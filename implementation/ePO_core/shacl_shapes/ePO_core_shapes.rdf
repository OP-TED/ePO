  <rdf:Description rdf:about="http://data.europa.eu/a4g/data-shape#epo-LotAwardOutcome-epo-hasApproximateFrameworkAgreementValue">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
