  <rdf:Description rdf:about="http://data.europa.eu/a4g/data-shape#epo-ProcurementObjectShape">
    <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-ProcurementObject-epo-hasLegalBasis"/>
