  <rdf:Description rdf:about="http://data.europa.eu/a4g/data-shape#epo-NoticeAwardInformation-epo-hasMaximumFrameworkAgreementAwardedValue">
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
    <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#hasMaximumFrameworkAgreementAwardedValue"/>
    <sh:description>The maximum value which can be spent through all the framework agreements announced in this notice, including options and renewals of contracts. Additional information: The value provided is a threshold value that implicity means that it cannot be exceeded however it may not be reached during the execution of a contract. The Framework Agreements in a CAN are to be traced back and added to provide this value.</sh:description>
    <sh:class rdf:resource="http://data.europa.eu/a4g/ontology#MonetaryValue"/>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
