  <rdf:Description rdf:about="http://data.europa.eu/a4g/data-shape#org-Organization-epo-foreseesSubcontractor">
    <sh:name>Foresees subcontractor</sh:name>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
    <sh:sparql rdf:nodeID="n86e40985fb8245d2a081f3a2d1a0b126b710"/>
    <sh:description>Relation indicating that an Organization plans to have a Subcontractor. Additional information: In eForms, in a Result Notice, the foreseen Subcontractors in a Tender are associated to the Organization that proposes the Subcontractors. The Subcontractor is associated to the Organization, rather than the Tenderer, so that, in the case of multiple Organizations being a Tenderer, it is clear to which Organization the proposed Subcontractor is associated.</sh:description>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
    <sh:class rdf:resource="http://data.europa.eu/a4g/ontology#Subcontractor"/>
