    <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-LotGroup-epo-hasLaunchFrameworkAgreementMaximumValue"/>
    <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-LotGroup-epo-hasInternalIdentifier"/>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <sh:targetClass rdf:resource="http://data.europa.eu/a4g/ontology#LotGroup"/>
    <rdfs:label>Lot Group</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/data-shape#epo-AwarderShape">
    <rdfs:label>Awarder</rdfs:label>
    <sh:targetClass rdf:resource="http://data.europa.eu/a4g/ontology#Awarder"/>
    <rdfs:comment>A Role of an Agent that signs the Award Decision. Additional information: BT-08 can be Awarding CBP; BG-03 is the Buyer. But Awarding CPB is not the same as the Buyer; the organisations may differ for these roles. Having the Awarder Role allows us to specify which Organisation is involved in the Award Decision.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
  </rdf:Description>
