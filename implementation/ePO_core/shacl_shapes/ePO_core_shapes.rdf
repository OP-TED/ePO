  <rdf:Description rdf:about="http://data.europa.eu/a4g/data-shape#epo-Buyer-epo-hasActivityDescription">
    <sh:or rdf:nodeID="n3c1a55727dcc4326bf644151a300bf36b58"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#core-shape"/>
    <sh:description>In the ePO ontology a taxonomy with all activities, based on different classifications (COFOG, UTILITIES, NACE), will be provided. In ePO this field is to be used exclusively to complement the definition attached to the MainActivityCode. However, in eForms there is the code "other" to cover undefined activities. For mapping to this eForms feature one could also use this property.</sh:description>
    <sh:name>Has activity description</sh:name>
    <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#hasActivityDescription"/>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
  </rdf:Description>
