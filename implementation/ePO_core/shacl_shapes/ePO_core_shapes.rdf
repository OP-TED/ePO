  <rdf:Description rdf:about="http://data.europa.eu/a4g/data-shape#cccev-Evidence-epo-hasURL">
    <sh:name>Has URL</sh:name>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
    <sh:description>The identifier of a resource. Additional Information For example: 1. The URL of the system from where to access the procurement documents; 2. The URL of the system for the submission of tender documents; 3. The URL of the system from where to download a tool to communicate with the Buyer; 4. The URL of the system used by a Technique to allow Economic Operators to exchange information with the Buyer (e.g. eAuction and DPS Systems) 5. The URL of the system used to exchange information between Buyer and EO for questions and clarifications;</sh:description>
    <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#hasURL"/>
