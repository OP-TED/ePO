  <rdf:Description rdf:about="http://data.europa.eu/a4g/data-shape#epo-ProcurementObjectShape">
    <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-ProcurementObject-epo-foreseesConcession"/>
    <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-ProcurementObject-epo-hasLaunchFrameworkAgreementMaximumValue"/>
    <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-ProcurementObject-epo-usesTechnique"/>
