  <rdf:Description rdf:about="http://data.europa.eu/a4g/data-shape#epo-CleanVehicleDirectiveInformationShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <sh:property rdf:resource="http://data.europa.eu/a4g/data-shape#epo-CleanVehicleDirectiveInformation-epo-hasCleanVehicles"/>
