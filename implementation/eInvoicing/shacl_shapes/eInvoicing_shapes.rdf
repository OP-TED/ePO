  <rdf:Description rdf:about="http://data.europa.eu/a4g/data-shape#epo-inv-Invoice-epo-inv-hasTaxPointDate">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
    <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#hasTaxPointDate"/>
    <sh:name>has Tax Point Date</sh:name>
    <sh:description>The date when the tax becomes accountable for the Seller and for the Buyer. Additional Information: That date can be determined and differs from the date of issue of the invoice, according to the national implementation of the directive.</sh:description>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#inv-shape"/>
    <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
  </rdf:Description>
