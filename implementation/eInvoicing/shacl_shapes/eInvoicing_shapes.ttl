@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix epo: <http://data.europa.eu/a4g/ontology#> .
@prefix epo-shape: <http://data.europa.eu/a4g/data-shape#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

epo-shape:epo-cat-ChargeInformation sh:property epo-shape:epo-cat-ChargeInformation-epo-inv-isSpecificToInvoiceLine .

epo-shape:epo-inv-CreditNoteLineShape a sh:NodeShape ;
    rdfs:label "Credit Note Line" ;
    rdfs:isDefinedBy epo-shape:inv-shape ;
    sh:property epo-shape:epo-inv-CreditNoteLine-epo-inv-isSubmittedForInvoiceLine ;
    sh:targetClass epo:CreditNoteLine .

epo-shape:epo-inv-CreditNoteShape a sh:NodeShape ;
    rdfs:label "Credit Note" ;
    rdfs:isDefinedBy epo-shape:inv-shape ;
    sh:property epo-shape:epo-inv-CreditNote-epo-inv-comprisesCreditNoteLine,
        epo-shape:epo-inv-CreditNote-epo-inv-refersToInvoice ;
    sh:targetClass epo:CreditNote .

epo-shape:epo-inv-CreditTransferInformationShape a sh:NodeShape ;
    rdfs:label "Credit Transfer Information" ;
    rdfs:comment "Information about a direct payment of money from one bank account into another." ;
    rdfs:isDefinedBy epo-shape:inv-shape ;
    sh:property epo-shape:epo-inv-CreditTransferInformation-epo-inv-hasPaymentAccountIdentifier,
        epo-shape:epo-inv-CreditTransferInformation-epo-inv-hasPaymentAccountName,
        epo-shape:epo-inv-CreditTransferInformation-epo-inv-hasPaymentServiceProviderIdentifier ;
    sh:targetClass epo:CreditTransferInformation .

epo-shape:epo-inv-InvoiceLineShape a sh:NodeShape ;
    rdfs:label "Invoice Line" ;
    rdfs:comment "Details concerning a given unit of goods, services or works mentioned in the Invoice." ;
    rdfs:isDefinedBy epo-shape:inv-shape ;
    sh:property epo-shape:epo-inv-InvoiceLine-epo-cat-hasPrice,
        epo-shape:epo-inv-InvoiceLine-epo-cat-hasQuantity,
        epo-shape:epo-inv-InvoiceLine-epo-inv-hasInvoiceLineObjectIdentifier,
        epo-shape:epo-inv-InvoiceLine-epo-inv-hasInvoiceLinePeriod,
        epo-shape:epo-inv-InvoiceLine-epo-inv-hasNetAmount,
        epo-shape:epo-inv-InvoiceLine-epo-inv-refersToOrderLine,
        epo-shape:epo-inv-InvoiceLine-epo-ord-hasTaxInformation ;
    sh:targetClass epo:InvoiceLine .

epo-shape:epo-inv-InvoiceNoteShape a sh:NodeShape ;
    rdfs:label "Invoice Note" ;
    rdfs:comment "Textual note that is relevant to the Invoice as a whole." ;
    rdfs:isDefinedBy epo-shape:inv-shape ;
    sh:property epo-shape:epo-inv-InvoiceNote-epo-inv-hasInvoiceNoteDescription,
        epo-shape:epo-inv-InvoiceNote-epo-inv-hasInvoiceNoteSubject ;
    sh:targetClass epo:InvoiceNote .

epo-shape:epo-inv-InvoiceShape a sh:NodeShape ;
    rdfs:label "Invoice" ;
    rdfs:comment "A commercial Document issued by the Seller to the Buyer to collect payments for the goods or services provided and to state the VAT amount due by the Buyer." ;
    rdfs:isDefinedBy epo-shape:inv-shape ;
    sh:property epo-shape:epo-inv-Invoice-epo-cat-specifiesChargeInformation,
        epo-shape:epo-inv-Invoice-epo-ful-refersToOrder,
        epo-shape:epo-inv-Invoice-epo-hasLotReference,
        epo-shape:epo-inv-Invoice-epo-inv-comprisesInvoiceLine,
        epo-shape:epo-inv-Invoice-epo-inv-hasInvoiceNote,
        epo-shape:epo-inv-Invoice-epo-inv-hasInvoicedObjectIdentifier,
        epo-shape:epo-inv-Invoice-epo-inv-hasInvoicingPeriod,
        epo-shape:epo-inv-Invoice-epo-inv-hasPaymentDueDate,
        epo-shape:epo-inv-Invoice-epo-inv-hasPaymentInstructionsInformation,
        epo-shape:epo-inv-Invoice-epo-inv-hasTaxBreakdownInformation,
        epo-shape:epo-inv-Invoice-epo-inv-hasTaxPointDate,
        epo-shape:epo-inv-Invoice-epo-inv-hasTaxPointDateCode,
        epo-shape:epo-inv-Invoice-epo-inv-hasTotalAccountingCurrencyTaxAmount,
        epo-shape:epo-inv-Invoice-epo-inv-hasTotalTaxAmount,
        epo-shape:epo-inv-Invoice-epo-inv-refersToDespatchAdvice,
        epo-shape:epo-inv-Invoice-epo-inv-refersToReceiptAdvice,
        epo-shape:epo-inv-Invoice-epo-inv-specifiesPayee,
        epo-shape:epo-inv-Invoice-epo-inv-specifiesSellerTaxRepresentative,
        epo-shape:epo-inv-Invoice-epo-ord-hasAccountingCost,
        epo-shape:epo-inv-Invoice-epo-ord-hasAmountDueForPayment,
        epo-shape:epo-inv-Invoice-epo-ord-hasPaymentTerm,
        epo-shape:epo-inv-Invoice-epo-ord-hasPrepaidAmount,
        epo-shape:epo-inv-Invoice-epo-ord-hasRoundingAmount,
        epo-shape:epo-inv-Invoice-epo-ord-hasTaxInformation,
        epo-shape:epo-inv-Invoice-epo-ord-hasTotalAllowanceAmount,
        epo-shape:epo-inv-Invoice-epo-ord-hasTotalChargeAmount,
        epo-shape:epo-inv-Invoice-epo-ord-hasTotalLineAmount,
        epo-shape:epo-inv-Invoice-epo-ord-hasTotalTaxExclusiveAmount,
        epo-shape:epo-inv-Invoice-epo-ord-hasTotalTaxInclusiveAmount,
        epo-shape:epo-inv-Invoice-epo-ord-specifiesAllowanceInformation,
        epo-shape:epo-inv-Invoice-epo-ord-specifiesDeliveryInformation,
        epo-shape:epo-inv-Invoice-epo-refersToContract,
        epo-shape:epo-inv-Invoice-epo-refersToProject,
        epo-shape:epo-inv-Invoice-epo-specifiesBuyer,
        epo-shape:epo-inv-Invoice-epo-specifiesSeller ;
    sh:targetClass epo:Invoice .

epo-shape:epo-inv-PayeeShape a sh:NodeShape ;
    rdfs:label "Payee" ;
    rdfs:comment "A Role of an Agent that receives the payment. Additional Information: The role of Payee may be fulfilled by another party than the Seller, e.g. a factoring service." ;
    rdfs:isDefinedBy epo-shape:inv-shape ;
    sh:targetClass epo:Payee .

epo-shape:epo-inv-PaymentCardInformationShape a sh:NodeShape ;
    rdfs:label "Payment Card Information" ;
    rdfs:comment "Information about card used for payment contemporaneous with invoice issuance." ;
    rdfs:isDefinedBy epo-shape:inv-shape ;
    sh:property epo-shape:epo-inv-PaymentCardInformation-epo-inv-hasPaymentCardHolderName,
        epo-shape:epo-inv-PaymentCardInformation-epo-inv-hasPaymentCardPrimaryAccountNumber ;
    sh:targetClass epo:PaymentCardInformation .

epo-shape:epo-inv-PaymentInstructionsInformationShape a sh:NodeShape ;
    rdfs:label "Payment Instructions Information" ;
    rdfs:comment "Information about the payment." ;
    rdfs:isDefinedBy epo-shape:inv-shape ;
    sh:property epo-shape:epo-inv-PaymentInstructionsInformation-epo-inv-hasBankingIdentifier,
        epo-shape:epo-inv-PaymentInstructionsInformation-epo-inv-hasCreditTransferInformation,
        epo-shape:epo-inv-PaymentInstructionsInformation-epo-inv-hasDebitedAccountIdentifier,
        epo-shape:epo-inv-PaymentInstructionsInformation-epo-inv-hasMandateIdentifier,
        epo-shape:epo-inv-PaymentInstructionsInformation-epo-inv-hasPaymentCardInformation,
        epo-shape:epo-inv-PaymentInstructionsInformation-epo-inv-hasPaymentMeansDescription,
        epo-shape:epo-inv-PaymentInstructionsInformation-epo-inv-hasPaymentMeansType,
        epo-shape:epo-inv-PaymentInstructionsInformation-epo-inv-hasRemittanceInformation ;
    sh:targetClass epo:PaymentInstructionsInformation .

epo-shape:epo-inv-SellerTaxRepresentativeShape a sh:NodeShape ;
    rdfs:label "Seller Tax Representative" ;
    rdfs:comment "A Role of an Agent that can represent an Organization for taxation purposes. Additional Information: The Seller Tax Representative Role is not a Legal Representative." ;
    rdfs:isDefinedBy epo-shape:inv-shape ;
    sh:targetClass epo:SellerTaxRepresentative .

epo-shape:epo-inv-TaxBreakdownInformationShape a sh:NodeShape ;
    rdfs:label "Tax Breakdown Information" ;
    rdfs:comment "Information about tax breakdown by different categories, rates and exemption reasons." ;
    rdfs:isDefinedBy epo-shape:inv-shape ;
    sh:property epo-shape:epo-inv-TaxBreakdownInformation-epo-inv-hasTaxExemptionReason,
        epo-shape:epo-inv-TaxBreakdownInformation-epo-inv-hasTaxExemptionReasonDescription,
        epo-shape:epo-inv-TaxBreakdownInformation-epo-ord-hasTaxInformation ;
    sh:targetClass epo:TaxBreakdownInformation .

epo-shape:epo-ord-AllowanceInformation sh:property epo-shape:epo-ord-AllowanceInformation-epo-inv-isSpecificToInvoiceLine .

epo-shape:epo-cat-ChargeInformation-epo-inv-isSpecificToInvoiceLine a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:inv-shape ;
    sh:class epo:InvoiceLine ;
    sh:name "Is specific to invoice line" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:isSpecificToInvoiceLine ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#isSpecificToInvoiceLine> ?that . ?that <http://data.europa.eu/a4g/ontology#isSpecificToInvoiceLine> ?this .}" ] .

epo-shape:epo-inv-CreditNote-epo-inv-comprisesCreditNoteLine a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:inv-shape ;
    sh:class epo:CreditNoteLine ;
    sh:minCount 1 ;
    sh:name "Comprises credit note line" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:comprisesCreditNoteLine ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#comprisesCreditNoteLine> ?that . ?that <http://data.europa.eu/a4g/ontology#comprisesCreditNoteLine> ?this .}" ] .

epo-shape:epo-inv-CreditNote-epo-inv-refersToInvoice a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:inv-shape ;
    sh:class epo:Invoice ;
    sh:maxCount 1 ;
    sh:name "Refers to invoice" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:refersToInvoice ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#refersToInvoice> ?that . ?that <http://data.europa.eu/a4g/ontology#refersToInvoice> ?this .}" ] .

epo-shape:epo-inv-CreditNoteLine-epo-inv-isSubmittedForInvoiceLine a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:inv-shape ;
    sh:class epo:InvoiceLine ;
    sh:maxCount 1 ;
    sh:name "Is submitted for invoice line" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:isSubmittedForInvoiceLine ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#isSubmittedForInvoiceLine> ?that . ?that <http://data.europa.eu/a4g/ontology#isSubmittedForInvoiceLine> ?this .}" ] .

epo-shape:epo-inv-CreditTransferInformation-epo-inv-hasPaymentAccountIdentifier a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:inv-shape ;
    sh:class adms:Identifier ;
    sh:description "A unique identifier of the financial payment account, at a payment service provider, to which payment should be made." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Has payment account identifier" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasPaymentAccountIdentifier ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasPaymentAccountIdentifier> ?that . ?that <http://data.europa.eu/a4g/ontology#hasPaymentAccountIdentifier> ?this .}" ] .

epo-shape:epo-inv-CreditTransferInformation-epo-inv-hasPaymentAccountName a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:inv-shape ;
    sh:description "The name of the account that can send and receive payments to and from a payment service provider." ;
    sh:maxCount 1 ;
    sh:name "Has payment account name" ;
    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
    sh:path epo:hasPaymentAccountName .

epo-shape:epo-inv-CreditTransferInformation-epo-inv-hasPaymentServiceProviderIdentifier a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:inv-shape ;
    sh:class adms:Identifier ;
    sh:description "An identifier for the payment service provider where a payment account is located." ;
    sh:maxCount 1 ;
    sh:name "Has payment service provider identifier" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasPaymentServiceProviderIdentifier ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasPaymentServiceProviderIdentifier> ?that . ?that <http://data.europa.eu/a4g/ontology#hasPaymentServiceProviderIdentifier> ?this .}" ] .

epo-shape:epo-inv-Invoice-epo-cat-specifiesChargeInformation a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:inv-shape ;
    sh:class epo:ChargeInformation ;
    sh:name "Specifies charge information" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:specifiesChargeInformation ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#specifiesChargeInformation> ?that . ?that <http://data.europa.eu/a4g/ontology#specifiesChargeInformation> ?this .}" ] .

epo-shape:epo-inv-Invoice-epo-ful-refersToOrder a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:inv-shape ;
    sh:class epo:Order ;
    sh:maxCount 1 ;
    sh:name "Refers to order" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:refersToOrder ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#refersToOrder> ?that . ?that <http://data.europa.eu/a4g/ontology#refersToOrder> ?this .}" ] .

epo-shape:epo-inv-Invoice-epo-hasLotReference a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:inv-shape ;
    sh:class epo:Lot ;
    sh:minCount 1 ;
    sh:name "Has lot reference" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasLotReference ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasLotReference> ?that . ?that <http://data.europa.eu/a4g/ontology#hasLotReference> ?this .}" ] .

epo-shape:epo-inv-Invoice-epo-inv-comprisesInvoiceLine a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:inv-shape ;
    sh:class epo:InvoiceLine ;
    sh:minCount 1 ;
    sh:name "Comprises invoice line" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:comprisesInvoiceLine ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#comprisesInvoiceLine> ?that . ?that <http://data.europa.eu/a4g/ontology#comprisesInvoiceLine> ?this .}" ] .

epo-shape:epo-inv-Invoice-epo-inv-hasInvoiceNote a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:inv-shape ;
    sh:class epo:InvoiceNote ;
    sh:description "Contains Invoice Note." ;
    sh:name "Has invoice note" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasInvoiceNote ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasInvoiceNote> ?that . ?that <http://data.europa.eu/a4g/ontology#hasInvoiceNote> ?this .}" ] .

epo-shape:epo-inv-Invoice-epo-inv-hasInvoicedObjectIdentifier a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:inv-shape ;
    sh:class adms:Identifier ;
    sh:description "An identifier for an object on which the invoice is based, given by the Seller." ;
    sh:maxCount 1 ;
    sh:name "Has invoiced object identifier" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasInvoicedObjectIdentifier ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasInvoicedObjectIdentifier> ?that . ?that <http://data.europa.eu/a4g/ontology#hasInvoicedObjectIdentifier> ?this .}" ] .

epo-shape:epo-inv-Invoice-epo-inv-hasInvoicingPeriod a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:inv-shape ;
    sh:class time:Interval ;
    sh:maxCount 1 ;
    sh:name "Has invoicing period" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasInvoicingPeriod ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasInvoicingPeriod> ?that . ?that <http://data.europa.eu/a4g/ontology#hasInvoicingPeriod> ?this .}" ] .

epo-shape:epo-inv-Invoice-epo-inv-hasPaymentDueDate a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:inv-shape ;
    sh:datatype xsd:date ;
    sh:maxCount 1 ;
    sh:name "Has payment due date" ;
    sh:path epo:hasPaymentDueDate .

epo-shape:epo-inv-Invoice-epo-inv-hasPaymentInstructionsInformation a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:inv-shape ;
    sh:class epo:PaymentInstructionsInformation ;
    sh:maxCount 1 ;
    sh:name "Has payment instructions information" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasPaymentInstructionsInformation ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasPaymentInstructionsInformation> ?that . ?that <http://data.europa.eu/a4g/ontology#hasPaymentInstructionsInformation> ?this .}" ] .

epo-shape:epo-inv-Invoice-epo-inv-hasTaxBreakdownInformation a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:inv-shape ;
    sh:class epo:TaxBreakdownInformation ;
    sh:minCount 1 ;
    sh:name "Has tax breakdown information" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasTaxBreakdownInformation ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasTaxBreakdownInformation> ?that . ?that <http://data.europa.eu/a4g/ontology#hasTaxBreakdownInformation> ?this .}" ] .

epo-shape:epo-inv-Invoice-epo-inv-hasTaxPointDate a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:inv-shape ;
    sh:datatype xsd:date ;
    sh:description "The date when the tax becomes accountable for the Seller and for the Buyer. Additional Information: That date can be determined and differs from the date of issue of the invoice, according to the national implementation of the directive." ;
    sh:maxCount 1 ;
    sh:name "Has tax point date" ;
    sh:path epo:hasTaxPointDate .

epo-shape:epo-inv-Invoice-epo-inv-hasTaxPointDateCode a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:inv-shape ;
    sh:class skos:Concept ;
    sh:maxCount 1 ;
    sh:name "Has tax point date code" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasTaxPointDateCode .

epo-shape:epo-inv-Invoice-epo-inv-hasTotalAccountingCurrencyTaxAmount a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:inv-shape ;
    sh:class epo:MonetaryValue ;
    sh:name "Has total accounting currency tax amount" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasTotalAccountingCurrencyTaxAmount ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasTotalAccountingCurrencyTaxAmount> ?that . ?that <http://data.europa.eu/a4g/ontology#hasTotalAccountingCurrencyTaxAmount> ?this .}" ] .

epo-shape:epo-inv-Invoice-epo-inv-hasTotalTaxAmount a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:inv-shape ;
    sh:class epo:MonetaryValue ;
    sh:name "Has total tax amount" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasTotalTaxAmount ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasTotalTaxAmount> ?that . ?that <http://data.europa.eu/a4g/ontology#hasTotalTaxAmount> ?this .}" ] .

epo-shape:epo-inv-Invoice-epo-inv-refersToDespatchAdvice a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:inv-shape ;
    sh:class epo:DespatchAdvice ;
    sh:maxCount 1 ;
    sh:name "Refers to despatch advice" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:refersToDespatchAdvice ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#refersToDespatchAdvice> ?that . ?that <http://data.europa.eu/a4g/ontology#refersToDespatchAdvice> ?this .}" ] .

epo-shape:epo-inv-Invoice-epo-inv-refersToReceiptAdvice a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:inv-shape ;
    sh:class epo:ReceiptAdvice ;
    sh:maxCount 1 ;
    sh:name "Refers to receipt advice" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:refersToReceiptAdvice ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#refersToReceiptAdvice> ?that . ?that <http://data.europa.eu/a4g/ontology#refersToReceiptAdvice> ?this .}" ] .

epo-shape:epo-inv-Invoice-epo-inv-specifiesPayee a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:inv-shape ;
    sh:class epo:Payee ;
    sh:maxCount 1 ;
    sh:name "Specifies payee" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:specifiesPayee ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#specifiesPayee> ?that . ?that <http://data.europa.eu/a4g/ontology#specifiesPayee> ?this .}" ] .

epo-shape:epo-inv-Invoice-epo-inv-specifiesSellerTaxRepresentative a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:inv-shape ;
    sh:class epo:SellerTaxRepresentative ;
    sh:maxCount 1 ;
    sh:name "Specifies seller tax representative" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:specifiesSellerTaxRepresentative ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#specifiesSellerTaxRepresentative> ?that . ?that <http://data.europa.eu/a4g/ontology#specifiesSellerTaxRepresentative> ?this .}" ] .

epo-shape:epo-inv-Invoice-epo-ord-hasAccountingCost a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:inv-shape ;
    sh:maxCount 1 ;
    sh:name "Has accounting cost" ;
    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
    sh:path epo:hasAccountingCost .

epo-shape:epo-inv-Invoice-epo-ord-hasAmountDueForPayment a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:inv-shape ;
    sh:class epo:MonetaryValue ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Has amount due for payment" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasAmountDueForPayment ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasAmountDueForPayment> ?that . ?that <http://data.europa.eu/a4g/ontology#hasAmountDueForPayment> ?this .}" ] .

epo-shape:epo-inv-Invoice-epo-ord-hasPaymentTerm a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:inv-shape ;
    sh:maxCount 1 ;
