@prefix : <http://data.europa.eu/a4g/ontology#> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix inv-shape: <http://data.europa.eu/a4g/data-shape#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

inv-shape:epo-cat-ChargeInformationShape sh:property inv-shape:epo-cat-ChargeInformation-epo-inv-isSpecificToInvoiceLine .

inv-shape:epo-inv-CreditNoteLineShape a sh:NodeShape ;
    rdfs:label "Credit note line" ;
    rdfs:isDefinedBy inv-shape:inv-shape ;
    sh:property inv-shape:epo-inv-CreditNoteLine-epo-inv-isSubmittedForInvoiceLine ;
    sh:targetClass :CreditNoteLine .

inv-shape:epo-inv-CreditNoteShape a sh:NodeShape ;
    rdfs:label "Credit note" ;
    rdfs:isDefinedBy inv-shape:inv-shape ;
    sh:property inv-shape:epo-inv-CreditNote-epo-inv-comprisesCreditNoteLine,
        inv-shape:epo-inv-CreditNote-epo-inv-refersToInvoice ;
    sh:targetClass :CreditNote .

inv-shape:epo-inv-CreditTransferInformationShape a sh:NodeShape ;
    rdfs:label "Credit transfer information" ;
    rdfs:comment "Information about a direct payment of money from one bank account into another." ;
    rdfs:isDefinedBy inv-shape:inv-shape ;
    sh:property inv-shape:epo-inv-CreditTransferInformation-epo-inv-hasPaymentAccountIdentifier,
        inv-shape:epo-inv-CreditTransferInformation-epo-inv-hasPaymentAccountName,
        inv-shape:epo-inv-CreditTransferInformation-epo-inv-hasPaymentServiceProviderIdentifier ;
    sh:targetClass :CreditTransferInformation .

inv-shape:epo-inv-InvoiceLineShape a sh:NodeShape ;
    rdfs:label "Invoice line" ;
    rdfs:comment "Details concerning a given unit of goods, services or works mentioned in the Invoice." ;
    rdfs:isDefinedBy inv-shape:inv-shape ;
    sh:property inv-shape:epo-inv-InvoiceLine-epo-cat-hasPrice,
        inv-shape:epo-inv-InvoiceLine-epo-cat-hasQuantity,
        inv-shape:epo-inv-InvoiceLine-epo-inv-hasInvoiceLineObjectIdentifier,
        inv-shape:epo-inv-InvoiceLine-epo-inv-hasInvoiceLinePeriod,
        inv-shape:epo-inv-InvoiceLine-epo-inv-hasNetAmount,
        inv-shape:epo-inv-InvoiceLine-epo-inv-refersToOrderLine,
        inv-shape:epo-inv-InvoiceLine-epo-ord-hasTaxInformation ;
    sh:targetClass :InvoiceLine .

inv-shape:epo-inv-InvoiceNoteShape a sh:NodeShape ;
    rdfs:label "Invoice note" ;
    rdfs:comment "Textual note that is relevant to the Invoice as a whole." ;
    rdfs:isDefinedBy inv-shape:inv-shape ;
    sh:property inv-shape:epo-inv-InvoiceNote-epo-inv-hasInvoiceNoteDescription,
        inv-shape:epo-inv-InvoiceNote-epo-inv-hasInvoiceNoteSubject ;
    sh:targetClass :InvoiceNote .

inv-shape:epo-inv-InvoiceShape a sh:NodeShape ;
    rdfs:label "Invoice" ;
    rdfs:comment "A commercial Document issued by the Seller to the Buyer to collect payments for the goods or services provided and to state the VAT amount due by the Buyer." ;
    rdfs:isDefinedBy inv-shape:inv-shape ;
    sh:property inv-shape:epo-inv-Invoice-epo-cat-specifiesChargeInformation,
        inv-shape:epo-inv-Invoice-epo-ful-refersToOrder,
        inv-shape:epo-inv-Invoice-epo-hasLotReference,
        inv-shape:epo-inv-Invoice-epo-inv-comprisesInvoiceLine,
        inv-shape:epo-inv-Invoice-epo-inv-hasInvoiceNote,
        inv-shape:epo-inv-Invoice-epo-inv-hasInvoicedObjectIdentifier,
        inv-shape:epo-inv-Invoice-epo-inv-hasInvoicingPeriod,
        inv-shape:epo-inv-Invoice-epo-inv-hasPaymentDueDate,
        inv-shape:epo-inv-Invoice-epo-inv-hasPaymentInstructionsInformation,
        inv-shape:epo-inv-Invoice-epo-inv-hasTaxBreakdownInformation,
        inv-shape:epo-inv-Invoice-epo-inv-hasTaxPointDate,
        inv-shape:epo-inv-Invoice-epo-inv-hasTaxPointDateCode,
        inv-shape:epo-inv-Invoice-epo-inv-hasTotalAccountingCurrencyTaxAmount,
        inv-shape:epo-inv-Invoice-epo-inv-hasTotalTaxAmount,
        inv-shape:epo-inv-Invoice-epo-inv-refersToDespatchAdvice,
        inv-shape:epo-inv-Invoice-epo-inv-refersToReceiptAdvice,
        inv-shape:epo-inv-Invoice-epo-inv-specifiesPayee,
        inv-shape:epo-inv-Invoice-epo-inv-specifiesSellerTaxRepresentative,
        inv-shape:epo-inv-Invoice-epo-ord-hasAccountingCost,
        inv-shape:epo-inv-Invoice-epo-ord-hasAmountDueForPayment,
        inv-shape:epo-inv-Invoice-epo-ord-hasPaymentTerm,
        inv-shape:epo-inv-Invoice-epo-ord-hasPrepaidAmount,
        inv-shape:epo-inv-Invoice-epo-ord-hasRoundingAmount,
        inv-shape:epo-inv-Invoice-epo-ord-hasTaxInformation,
        inv-shape:epo-inv-Invoice-epo-ord-hasTotalAllowanceAmount,
        inv-shape:epo-inv-Invoice-epo-ord-hasTotalChargeAmount,
        inv-shape:epo-inv-Invoice-epo-ord-hasTotalLineAmount,
        inv-shape:epo-inv-Invoice-epo-ord-hasTotalTaxExclusiveAmount,
        inv-shape:epo-inv-Invoice-epo-ord-hasTotalTaxInclusiveAmount,
        inv-shape:epo-inv-Invoice-epo-ord-specifiesAllowanceInformation,
        inv-shape:epo-inv-Invoice-epo-ord-specifiesDeliveryInformation,
        inv-shape:epo-inv-Invoice-epo-refersToContract,
        inv-shape:epo-inv-Invoice-epo-refersToProject,
        inv-shape:epo-inv-Invoice-epo-specifiesBuyer,
        inv-shape:epo-inv-Invoice-epo-specifiesSeller ;
    sh:targetClass :Invoice .

inv-shape:epo-inv-PayeeShape a sh:NodeShape ;
    rdfs:label "Payee" ;
    rdfs:comment "A Role of an Agent that receives the payment. Additional Information: The role of Payee may be fulfilled by another party than the Seller, e.g. a factoring service." ;
    rdfs:isDefinedBy inv-shape:inv-shape ;
    sh:targetClass :Payee .

inv-shape:epo-inv-PaymentCardInformationShape a sh:NodeShape ;
    rdfs:label "Payment card information" ;
    rdfs:comment "Information about card used for payment contemporaneous with invoice issuance." ;
    rdfs:isDefinedBy inv-shape:inv-shape ;
    sh:property inv-shape:epo-inv-PaymentCardInformation-epo-inv-hasPaymentCardHolderName,
        inv-shape:epo-inv-PaymentCardInformation-epo-inv-hasPaymentCardPrimaryAccountNumber ;
    sh:targetClass :PaymentCardInformation .

inv-shape:epo-inv-PaymentInstructionsInformationShape a sh:NodeShape ;
    rdfs:label "Payment instructions information" ;
    rdfs:comment "Information about the payment." ;
    rdfs:isDefinedBy inv-shape:inv-shape ;
    sh:property inv-shape:epo-inv-PaymentInstructionsInformation-epo-inv-hasBankingIdentifier,
        inv-shape:epo-inv-PaymentInstructionsInformation-epo-inv-hasCreditTransferInformation,
        inv-shape:epo-inv-PaymentInstructionsInformation-epo-inv-hasDebitedAccountIdentifier,
        inv-shape:epo-inv-PaymentInstructionsInformation-epo-inv-hasMandateIdentifier,
        inv-shape:epo-inv-PaymentInstructionsInformation-epo-inv-hasPaymentCardInformation,
        inv-shape:epo-inv-PaymentInstructionsInformation-epo-inv-hasPaymentMeansDescription,
        inv-shape:epo-inv-PaymentInstructionsInformation-epo-inv-hasPaymentMeansType,
        inv-shape:epo-inv-PaymentInstructionsInformation-epo-inv-hasRemittanceInformation ;
    sh:targetClass :PaymentInstructionsInformation .

inv-shape:epo-inv-SellerTaxRepresentativeShape a sh:NodeShape ;
    rdfs:label "Seller tax representative" ;
    rdfs:comment "A Role of an Agent that can represent an Organization for taxation purposes. Additional Information: The Seller Tax Representative Role is not a Legal Representative." ;
    rdfs:isDefinedBy inv-shape:inv-shape ;
    sh:targetClass :SellerTaxRepresentative .

inv-shape:epo-inv-TaxBreakdownInformationShape a sh:NodeShape ;
    rdfs:label "Tax breakdown information" ;
    rdfs:comment "Information about tax breakdown by different categories, rates and exemption reasons." ;
    rdfs:isDefinedBy inv-shape:inv-shape ;
    sh:property inv-shape:epo-inv-TaxBreakdownInformation-epo-inv-hasTaxExemptionReason,
        inv-shape:epo-inv-TaxBreakdownInformation-epo-inv-hasTaxExemptionReasonDescription,
        inv-shape:epo-inv-TaxBreakdownInformation-epo-ord-hasTaxInformation ;
    sh:targetClass :TaxBreakdownInformation .

inv-shape:epo-ord-AllowanceInformationShape sh:property inv-shape:epo-ord-AllowanceInformation-epo-inv-isSpecificToInvoiceLine .

inv-shape:epo-cat-ChargeInformation-epo-inv-isSpecificToInvoiceLine a sh:PropertyShape ;
    rdfs:isDefinedBy inv-shape:inv-shape ;
    sh:class :InvoiceLine ;
    sh:name "Is specific to invoice line" ;
    sh:path :isSpecificToInvoiceLine ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#isSpecificToInvoiceLine> ?that . ?that <http://data.europa.eu/a4g/ontology#isSpecificToInvoiceLine> ?this .}" ] .

inv-shape:epo-inv-CreditNote-epo-inv-comprisesCreditNoteLine a sh:PropertyShape ;
    rdfs:isDefinedBy inv-shape:inv-shape ;
    sh:class :CreditNoteLine ;
    sh:minCount 1 ;
    sh:name "Comprises credit note line" ;
    sh:path :comprisesCreditNoteLine ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#comprisesCreditNoteLine> ?that . ?that <http://data.europa.eu/a4g/ontology#comprisesCreditNoteLine> ?this .}" ] .

inv-shape:epo-inv-CreditNote-epo-inv-refersToInvoice a sh:PropertyShape ;
    rdfs:isDefinedBy inv-shape:inv-shape ;
    sh:class :Invoice ;
    sh:maxCount 1 ;
    sh:name "Refers to invoice" ;
    sh:path :refersToInvoice ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#refersToInvoice> ?that . ?that <http://data.europa.eu/a4g/ontology#refersToInvoice> ?this .}" ] .

inv-shape:epo-inv-CreditNoteLine-epo-inv-isSubmittedForInvoiceLine a sh:PropertyShape ;
    rdfs:isDefinedBy inv-shape:inv-shape ;
    sh:class :InvoiceLine ;
    sh:maxCount 1 ;
    sh:name "Is submitted for invoice line" ;
    sh:path :isSubmittedForInvoiceLine ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#isSubmittedForInvoiceLine> ?that . ?that <http://data.europa.eu/a4g/ontology#isSubmittedForInvoiceLine> ?this .}" ] .

inv-shape:epo-inv-CreditTransferInformation-epo-inv-hasPaymentAccountIdentifier a sh:PropertyShape ;
    rdfs:isDefinedBy inv-shape:inv-shape ;
    sh:class adms:Identifier ;
    sh:description "A unique identifier of the financial payment account, at a payment service provider, to which payment should be made." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Has payment account identifier" ;
    sh:path :hasPaymentAccountIdentifier ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasPaymentAccountIdentifier> ?that . ?that <http://data.europa.eu/a4g/ontology#hasPaymentAccountIdentifier> ?this .}" ] .

inv-shape:epo-inv-CreditTransferInformation-epo-inv-hasPaymentAccountName a sh:PropertyShape ;
    rdfs:isDefinedBy inv-shape:inv-shape ;
    sh:description "The name of the account that can send and receive payments to and from a payment service provider." ;
    sh:maxCount 1 ;
    sh:name "Has payment account name" ;
    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
    sh:path :hasPaymentAccountName .

inv-shape:epo-inv-CreditTransferInformation-epo-inv-hasPaymentServiceProviderIdentifier a sh:PropertyShape ;
    rdfs:isDefinedBy inv-shape:inv-shape ;
    sh:class adms:Identifier ;
    sh:description "An identifier for the payment service provider where a payment account is located." ;
    sh:maxCount 1 ;
    sh:name "Has payment service provider identifier" ;
    sh:path :hasPaymentServiceProviderIdentifier ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasPaymentServiceProviderIdentifier> ?that . ?that <http://data.europa.eu/a4g/ontology#hasPaymentServiceProviderIdentifier> ?this .}" ] .

inv-shape:epo-inv-Invoice-epo-cat-specifiesChargeInformation a sh:PropertyShape ;
    rdfs:isDefinedBy inv-shape:inv-shape ;
    sh:class :ChargeInformation ;
    sh:name "Specifies charge information" ;
    sh:path :specifiesChargeInformation ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#specifiesChargeInformation> ?that . ?that <http://data.europa.eu/a4g/ontology#specifiesChargeInformation> ?this .}" ] .

inv-shape:epo-inv-Invoice-epo-ful-refersToOrder a sh:PropertyShape ;
    rdfs:isDefinedBy inv-shape:inv-shape ;
    sh:class :Order ;
    sh:maxCount 1 ;
    sh:name "Refers to order" ;
    sh:path :refersToOrder ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#refersToOrder> ?that . ?that <http://data.europa.eu/a4g/ontology#refersToOrder> ?this .}" ] .

inv-shape:epo-inv-Invoice-epo-hasLotReference a sh:PropertyShape ;
    rdfs:isDefinedBy inv-shape:inv-shape ;
    sh:class :Lot ;
    sh:minCount 1 ;
    sh:name "Has lot reference" ;
    sh:path :hasLotReference ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasLotReference> ?that . ?that <http://data.europa.eu/a4g/ontology#hasLotReference> ?this .}" ] .

inv-shape:epo-inv-Invoice-epo-inv-comprisesInvoiceLine a sh:PropertyShape ;
    rdfs:isDefinedBy inv-shape:inv-shape ;
    sh:class :InvoiceLine ;
    sh:minCount 1 ;
    sh:name "Comprises invoice line" ;
    sh:path :comprisesInvoiceLine ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#comprisesInvoiceLine> ?that . ?that <http://data.europa.eu/a4g/ontology#comprisesInvoiceLine> ?this .}" ] .

inv-shape:epo-inv-Invoice-epo-inv-hasInvoiceNote a sh:PropertyShape ;
    rdfs:isDefinedBy inv-shape:inv-shape ;
    sh:class :InvoiceNote ;
    sh:description "Contains Invoice Note." ;
    sh:name "Has invoice note" ;
    sh:path :hasInvoiceNote ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasInvoiceNote> ?that . ?that <http://data.europa.eu/a4g/ontology#hasInvoiceNote> ?this .}" ] .

inv-shape:epo-inv-Invoice-epo-inv-hasInvoicedObjectIdentifier a sh:PropertyShape ;
    rdfs:isDefinedBy inv-shape:inv-shape ;
    sh:class adms:Identifier ;
    sh:description "An identifier for an object on which the invoice is based, given by the Seller." ;
    sh:maxCount 1 ;
    sh:name "Has invoiced object identifier" ;
    sh:path :hasInvoicedObjectIdentifier ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasInvoicedObjectIdentifier> ?that . ?that <http://data.europa.eu/a4g/ontology#hasInvoicedObjectIdentifier> ?this .}" ] .

inv-shape:epo-inv-Invoice-epo-inv-hasInvoicingPeriod a sh:PropertyShape ;
    rdfs:isDefinedBy inv-shape:inv-shape ;
    sh:class time:Interval ;
    sh:maxCount 1 ;
    sh:name "Has invoicing period" ;
    sh:path :hasInvoicingPeriod ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasInvoicingPeriod> ?that . ?that <http://data.europa.eu/a4g/ontology#hasInvoicingPeriod> ?this .}" ] .

inv-shape:epo-inv-Invoice-epo-inv-hasPaymentDueDate a sh:PropertyShape ;
    rdfs:isDefinedBy inv-shape:inv-shape ;
    sh:datatype xsd:date ;
    sh:maxCount 1 ;
    sh:name "Has payment due date" ;
    sh:path :hasPaymentDueDate .

inv-shape:epo-inv-Invoice-epo-inv-hasPaymentInstructionsInformation a sh:PropertyShape ;
    rdfs:isDefinedBy inv-shape:inv-shape ;
    sh:class :PaymentInstructionsInformation ;
    sh:maxCount 1 ;
    sh:name "Has payment instructions information" ;
    sh:path :hasPaymentInstructionsInformation ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasPaymentInstructionsInformation> ?that . ?that <http://data.europa.eu/a4g/ontology#hasPaymentInstructionsInformation> ?this .}" ] .

inv-shape:epo-inv-Invoice-epo-inv-hasTaxBreakdownInformation a sh:PropertyShape ;
    rdfs:isDefinedBy inv-shape:inv-shape ;
    sh:class :TaxBreakdownInformation ;
    sh:minCount 1 ;
    sh:name "Has tax breakdown information" ;
    sh:path :hasTaxBreakdownInformation ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasTaxBreakdownInformation> ?that . ?that <http://data.europa.eu/a4g/ontology#hasTaxBreakdownInformation> ?this .}" ] .

inv-shape:epo-inv-Invoice-epo-inv-hasTaxPointDate a sh:PropertyShape ;
    rdfs:isDefinedBy inv-shape:inv-shape ;
    sh:datatype xsd:date ;
    sh:description "The date when the tax becomes accountable for the Seller and for the Buyer. Additional Information: That date can be determined and differs from the date of issue of the invoice, according to the national implementation of the directive." ;
    sh:maxCount 1 ;
    sh:name "Has tax point date" ;
    sh:path :hasTaxPointDate .

inv-shape:epo-inv-Invoice-epo-inv-hasTaxPointDateCode a sh:PropertyShape ;
    rdfs:isDefinedBy inv-shape:inv-shape ;
    sh:class skos:Concept ;
    sh:maxCount 1 ;
    sh:name "Has tax point date code" ;
    sh:path :hasTaxPointDateCode .

inv-shape:epo-inv-Invoice-epo-inv-hasTotalAccountingCurrencyTaxAmount a sh:PropertyShape ;
    rdfs:isDefinedBy inv-shape:inv-shape ;
    sh:class :MonetaryValue ;
    sh:name "Has total accounting currency tax amount" ;
    sh:path :hasTotalAccountingCurrencyTaxAmount ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasTotalAccountingCurrencyTaxAmount> ?that . ?that <http://data.europa.eu/a4g/ontology#hasTotalAccountingCurrencyTaxAmount> ?this .}" ] .

inv-shape:epo-inv-Invoice-epo-inv-hasTotalTaxAmount a sh:PropertyShape ;
    rdfs:isDefinedBy inv-shape:inv-shape ;
    sh:class :MonetaryValue ;
    sh:name "Has total tax amount" ;
    sh:path :hasTotalTaxAmount ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasTotalTaxAmount> ?that . ?that <http://data.europa.eu/a4g/ontology#hasTotalTaxAmount> ?this .}" ] .

inv-shape:epo-inv-Invoice-epo-inv-refersToDespatchAdvice a sh:PropertyShape ;
    rdfs:isDefinedBy inv-shape:inv-shape ;
    sh:class :DespatchAdvice ;
    sh:maxCount 1 ;
    sh:name "Refers to despatch advice" ;
    sh:path :refersToDespatchAdvice ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#refersToDespatchAdvice> ?that . ?that <http://data.europa.eu/a4g/ontology#refersToDespatchAdvice> ?this .}" ] .

inv-shape:epo-inv-Invoice-epo-inv-refersToReceiptAdvice a sh:PropertyShape ;
    rdfs:isDefinedBy inv-shape:inv-shape ;
    sh:class :ReceiptAdvice ;
    sh:maxCount 1 ;
    sh:name "Refers to receipt advice" ;
    sh:path :refersToReceiptAdvice ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#refersToReceiptAdvice> ?that . ?that <http://data.europa.eu/a4g/ontology#refersToReceiptAdvice> ?this .}" ] .

inv-shape:epo-inv-Invoice-epo-inv-specifiesPayee a sh:PropertyShape ;
    rdfs:isDefinedBy inv-shape:inv-shape ;
    sh:class :Payee ;
    sh:maxCount 1 ;
    sh:name "Specifies payee" ;
    sh:path :specifiesPayee ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#specifiesPayee> ?that . ?that <http://data.europa.eu/a4g/ontology#specifiesPayee> ?this .}" ] .

inv-shape:epo-inv-Invoice-epo-inv-specifiesSellerTaxRepresentative a sh:PropertyShape ;
    rdfs:isDefinedBy inv-shape:inv-shape ;
    sh:class :SellerTaxRepresentative ;
    sh:maxCount 1 ;
    sh:name "Specifies seller tax representative" ;
    sh:path :specifiesSellerTaxRepresentative ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#specifiesSellerTaxRepresentative> ?that . ?that <http://data.europa.eu/a4g/ontology#specifiesSellerTaxRepresentative> ?this .}" ] .

inv-shape:epo-inv-Invoice-epo-ord-hasAccountingCost a sh:PropertyShape ;
    rdfs:isDefinedBy inv-shape:inv-shape ;
    sh:maxCount 1 ;
    sh:name "Has accounting cost" ;
    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
    sh:path :hasAccountingCost .

inv-shape:epo-inv-Invoice-epo-ord-hasAmountDueForPayment a sh:PropertyShape ;
    rdfs:isDefinedBy inv-shape:inv-shape ;
    sh:class :MonetaryValue ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Has amount due for payment" ;
    sh:path :hasAmountDueForPayment ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasAmountDueForPayment> ?that . ?that <http://data.europa.eu/a4g/ontology#hasAmountDueForPayment> ?this .}" ] .

inv-shape:epo-inv-Invoice-epo-ord-hasPaymentTerm a sh:PropertyShape ;
    rdfs:isDefinedBy inv-shape:inv-shape ;
    sh:maxCount 1 ;
    sh:name "Has payment term" ;
    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
    sh:path :hasPaymentTerm .

inv-shape:epo-inv-Invoice-epo-ord-hasPrepaidAmount a sh:PropertyShape ;
    rdfs:isDefinedBy inv-shape:inv-shape ;
    sh:class :MonetaryValue ;
    sh:name "Has prepaid amount" ;
    sh:path :hasPrepaidAmount ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasPrepaidAmount> ?that . ?that <http://data.europa.eu/a4g/ontology#hasPrepaidAmount> ?this .}" ] .

