    sh:maxCount 1 ;
    sh:name "Has rounding amount" ;
    sh:path :hasRoundingAmount ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasRoundingAmount> ?that . ?that <http://data.europa.eu/a4g/ontology#hasRoundingAmount> ?this .}" ] .

inv-shape:epo-inv-Invoice-epo-ord-hasTaxInformation a sh:PropertyShape ;
    rdfs:isDefinedBy inv-shape:inv-shape ;
    sh:class :TaxInformation ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Has tax information" ;
