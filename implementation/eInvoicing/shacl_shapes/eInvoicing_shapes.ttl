    sh:class :MonetaryValue ;
    sh:name "has Total Allowance Amount" ;
    sh:path :hasTotalAllowanceAmount ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasTotalAllowanceAmount> ?that . ?that <http://data.europa.eu/a4g/ontology#hasTotalAllowanceAmount> ?this .}" ] .

inv-shape:epo-inv-Invoice-epo-ord-hasTotalChargeAmount a sh:PropertyShape ;
    sh:class :MonetaryValue ;
