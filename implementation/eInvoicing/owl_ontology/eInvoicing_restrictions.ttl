@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix epo: <http://data.europa.eu/a4g/ontology#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

epo:hasCreditTransferInformation rdfs:domain epo:PaymentInstructionsInformation ;
    rdfs:range epo:CreditTransferInformation .

epo:hasInvoiceNote rdfs:domain epo:Invoice ;
    rdfs:range epo:InvoiceNote .

epo:hasInvoiceNoteSubject rdfs:domain epo:InvoiceNote ;
    rdfs:range skos:Concept .

epo:hasPaymentInstructionsInformation rdfs:domain epo:Invoice ;
    rdfs:range epo:PaymentInstructionsInformation .

epo:hasPaymentMeansType rdfs:domain epo:PaymentInstructionsInformation ;
    rdfs:range skos:Concept .

epo:hasPrepaidAmount rdfs:domain epo:Invoice ;
    rdfs:range epo:MonetaryValue .

epo:hasTaxExemptionReason rdfs:domain epo:TaxBreakdownInformation ;
    rdfs:range skos:Concept .

epo:hasTaxPointDateCode rdfs:domain epo:Invoice ;
    rdfs:range skos:Concept .

epo:hasTotalAccountingCurrencyTaxAmount rdfs:domain epo:Invoice ;
    rdfs:range epo:MonetaryValue .

epo:hasTotalAllowanceAmount rdfs:domain epo:Invoice ;
    rdfs:range epo:MonetaryValue .

epo:hasTotalChargeAmount rdfs:domain epo:Invoice ;
    rdfs:range epo:MonetaryValue .

epo:hasTotalTaxAmount rdfs:domain epo:Invoice ;
    rdfs:range epo:MonetaryValue .

epo:inv-restriction a owl:Ontology ;
    rdfs:label "eProcurement Ontology Invoicing - core restrictions"@en ;
    dcterms:created "2021-06-01"^^xsd:date ;
    dcterms:description "The eProcurement Ontology Invoicing core restrictions provides the restrictions and the inference-related specifications on the concepts and properties in the eProcurement Ontology Invoicing core."@en ;
    dcterms:issued "2025-10-10"^^xsd:date ;
    dcterms:license "© European Union, 2014. Unless otherwise noted, the reuse of the Ontology is authorised under the European Union Public Licence v1.2 (https://eupl.eu/)." ;
    dcterms:publisher "http://publications.europa.eu/resource/authority/corporate-body/PUBL" ;
    dcterms:title "eProcurement Ontology Invoicing - core restrictions"@en ;
    vann:preferredNamespacePrefix "epo" ;
    vann:preferredNamespaceUri "http://data.europa.eu/a4g/ontology#" ;
    rdfs:comment """This version is automatically generated from eInvoicing.xml on 
                2025-10-10""" ;
    rdfs:seeAlso <https://docs.ted.europa.eu/home/index.html>,
        <https://github.com/OP-TED/ePO/releases>,
        <https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology/about>,
        <https://op.europa.eu/en/web/eu-vocabularies/e-procurement> ;
    owl:imports epo:cat,
        epo:core,
        epo:ful,
        epo:inv,
        epo:ord,
        <http://data.europa.eu/eli/ontology#>,
        <http://data.europa.eu/m8g/>,
        dcterms:,
        skos:,
        <http://www.w3.org/2006/time>,
        <http://www.w3.org/ns/adms>,
        <http://www.w3.org/ns/locn>,
        org:,
        <http://www.w3.org/ns/person> ;
    owl:incompatibleWith "4.2.0" ;
    owl:priorVersion "http://data.europa.eu/a4g/ontology#inv-restriction-5.1.0" ;
    owl:versionIRI epo:inv-restriction-5.2.0 ;
    owl:versionInfo "5.2.0" .

epo:isSpecificToInvoiceLine rdfs:domain [ a owl:Class ;
            owl:unionOf ( epo:ChargeInformation epo:AllowanceInformation ) ] ;
    rdfs:range epo:InvoiceLine .

epo:specifiesAllowanceInformation rdfs:domain epo:Invoice ;
    rdfs:range epo:AllowanceInformation .

epo:specifiesChargeInformation rdfs:domain epo:Invoice ;
    rdfs:range epo:ChargeInformation .

epo:PaymentInformation rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:hasPaymentMeansInformation ] .

epo:RemittanceAdvice rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:specifiesPayee ] .

epo:RemittanceAdviceLine rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:refersToInvoice ] .

epo:comprisesCreditNoteLine rdfs:domain epo:CreditNote ;
    rdfs:range epo:CreditNoteLine .

epo:comprisesInvoiceLine rdfs:domain epo:Invoice ;
    rdfs:range epo:InvoiceLine .

epo:hasAccountingCost rdfs:domain epo:Invoice ;
    rdfs:range rdf:PlainLiteral .

epo:hasAmountDueForPayment a owl:FunctionalProperty ;
    rdfs:domain epo:Invoice ;
    rdfs:range epo:MonetaryValue .

epo:hasBankingIdentifier rdfs:domain epo:PaymentInstructionsInformation ;
    rdfs:range adms:Identifier .

epo:hasDebitedAccountIdentifier rdfs:domain epo:PaymentInstructionsInformation ;
    rdfs:range adms:Identifier .

epo:hasInvoiceLineObjectIdentifier rdfs:domain epo:InvoiceLine ;
    rdfs:range adms:Identifier .

epo:hasInvoiceLinePeriod rdfs:domain epo:InvoiceLine ;
    rdfs:range time:Interval .

epo:hasInvoiceNoteDescription a owl:FunctionalProperty ;
    rdfs:domain epo:InvoiceNote ;
    rdfs:range rdf:PlainLiteral .

epo:hasInvoicedObjectIdentifier rdfs:domain epo:Invoice ;
    rdfs:range adms:Identifier .

epo:hasInvoicingPeriod rdfs:domain epo:Invoice ;
    rdfs:range time:Interval .

epo:hasLotReference rdfs:domain epo:Invoice ;
    rdfs:range epo:Lot .

epo:hasMandateIdentifier rdfs:domain epo:PaymentInstructionsInformation ;
    rdfs:range adms:Identifier .

epo:hasNetAmount a owl:FunctionalProperty ;
    rdfs:domain epo:InvoiceLine ;
    rdfs:range epo:MonetaryValue .

epo:hasPaymentAccountIdentifier a owl:FunctionalProperty ;
    rdfs:domain epo:CreditTransferInformation ;
    rdfs:range adms:Identifier .

epo:hasPaymentAccountName rdfs:domain epo:CreditTransferInformation ;
    rdfs:range rdf:PlainLiteral .

epo:hasPaymentCardHolderName rdfs:domain epo:PaymentCardInformation ;
    rdfs:range rdf:PlainLiteral .

epo:hasPaymentCardInformation rdfs:domain epo:PaymentInstructionsInformation ;
    rdfs:range epo:PaymentCardInformation .

epo:hasPaymentCardPrimaryAccountNumber a owl:FunctionalProperty ;
    rdfs:domain epo:PaymentCardInformation ;
    rdfs:range rdf:PlainLiteral .

epo:hasPaymentDueDate rdfs:domain epo:Invoice ;
    rdfs:range xsd:date .

epo:hasPaymentMeansDescription rdfs:domain epo:PaymentInstructionsInformation ;
    rdfs:range rdf:PlainLiteral .

epo:hasPaymentMeansInformation a owl:FunctionalProperty ;
    rdfs:domain epo:PaymentInformation ;
    rdfs:range epo:PaymentInstructionsInformation .

epo:hasPaymentServiceProviderIdentifier rdfs:domain epo:CreditTransferInformation ;
    rdfs:range adms:Identifier .

epo:hasPaymentTerm rdfs:domain epo:Invoice ;
    rdfs:range rdf:PlainLiteral .

epo:hasPrice rdfs:domain epo:InvoiceLine ;
    rdfs:range epo:Price .

epo:hasQuantity a owl:FunctionalProperty ;
    rdfs:domain epo:InvoiceLine ;
    rdfs:range epo:Quantity .

epo:hasRemittanceInformation rdfs:domain epo:PaymentInstructionsInformation ;
    rdfs:range rdf:PlainLiteral .

epo:hasRoundingAmount rdfs:domain epo:Invoice ;
    rdfs:range epo:MonetaryValue .

epo:hasTaxBreakdownInformation rdfs:domain epo:Invoice ;
    rdfs:range epo:TaxBreakdownInformation .

epo:hasTaxExemptionReasonDescription rdfs:domain epo:TaxBreakdownInformation ;
    rdfs:range rdf:PlainLiteral .

epo:hasTaxPointDate rdfs:domain epo:Invoice ;
    rdfs:range xsd:date .

epo:hasTotalLineAmount rdfs:domain epo:Invoice ;
    rdfs:range epo:MonetaryValue .

epo:hasTotalTaxExclusiveAmount rdfs:domain epo:Invoice ;
    rdfs:range epo:MonetaryValue .

epo:hasTotalTaxInclusiveAmount rdfs:domain epo:Invoice ;
    rdfs:range epo:MonetaryValue .

epo:isSubmittedForInvoiceLine rdfs:domain epo:CreditNoteLine ;
    rdfs:range epo:InvoiceLine .

epo:refersToContract rdfs:domain epo:Invoice ;
    rdfs:range epo:Contract .

epo:refersToDespatchAdvice rdfs:domain epo:Invoice ;
    rdfs:range epo:DespatchAdvice .

epo:refersToOrder rdfs:domain epo:Invoice ;
    rdfs:range epo:Order .

epo:refersToOrderLine rdfs:domain epo:InvoiceLine ;
    rdfs:range epo:OrderLine .

epo:refersToProject rdfs:domain epo:Invoice ;
    rdfs:range epo:Project .

epo:refersToReceiptAdvice rdfs:domain epo:Invoice ;
    rdfs:range epo:ReceiptAdvice .

epo:specifiesBuyer a owl:FunctionalProperty ;
    rdfs:domain epo:Invoice ;
    rdfs:range epo:Buyer .

epo:specifiesDeliveryInformation rdfs:domain epo:Invoice ;
    rdfs:range epo:DeliveryInformation .

epo:specifiesSeller a owl:FunctionalProperty ;
    rdfs:domain epo:Invoice ;
    rdfs:range epo:Seller .

epo:specifiesSellerTaxRepresentative rdfs:domain epo:Invoice ;
    rdfs:range epo:SellerTaxRepresentative .

epo:CreditNote rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty epo:comprisesCreditNoteLine ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:refersToInvoice ] .

epo:CreditNoteLine rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:isSubmittedForInvoiceLine ] .

epo:refersToInvoice rdfs:domain [ a owl:Class ;
            owl:unionOf ( epo:CreditNote epo:RemittanceAdviceLine ) ] ;
    rdfs:range epo:Invoice .

epo:specifiesPayee rdfs:domain [ a owl:Class ;
            owl:unionOf ( epo:Invoice epo:RemittanceAdvice ) ] ;
    rdfs:range epo:Payee .

epo:InvoiceNote rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:hasInvoiceNoteDescription ] .

epo:hasTaxInformation a owl:FunctionalProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( epo:Invoice epo:InvoiceLine epo:TaxBreakdownInformation ) ] ;
    rdfs:range epo:TaxInformation .

epo:PaymentCardInformation rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:hasPaymentCardPrimaryAccountNumber ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:hasPaymentCardHolderName ] .

epo:TaxBreakdownInformation rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:hasTaxExemptionReasonDescription ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:hasTaxInformation ] .

epo:CreditTransferInformation rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:hasPaymentAccountIdentifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:hasPaymentServiceProviderIdentifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:hasPaymentAccountName ] .

epo:InvoiceLine rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:hasQuantity ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:hasTaxInformation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:hasInvoiceLinePeriod ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:refersToOrderLine ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:hasNetAmount ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:hasInvoiceLineObjectIdentifier ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty epo:hasPrice ] .

epo:PaymentInstructionsInformation rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:hasBankingIdentifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:hasMandateIdentifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:hasDebitedAccountIdentifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:hasRemittanceInformation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:hasPaymentMeansDescription ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:hasPaymentCardInformation ] .

epo:Invoice rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:hasPaymentTerm ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:hasAccountingCost ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:hasTaxPointDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:refersToOrder ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:refersToProject ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty epo:hasTotalTaxInclusiveAmount ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:refersToContract ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:specifiesBuyer ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:specifiesSeller ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:specifiesPayee ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:refersToReceiptAdvice ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:hasAmountDueForPayment ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:hasInvoicedObjectIdentifier ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty epo:hasTotalLineAmount ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty epo:hasTaxBreakdownInformation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:hasInvoicingPeriod ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:refersToDespatchAdvice ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:hasPaymentDueDate ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty epo:hasLotReference ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:hasTaxInformation ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty epo:comprisesInvoiceLine ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:specifiesSellerTaxRepresentative ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:hasRoundingAmount ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:specifiesDeliveryInformation ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty epo:hasTotalTaxExclusiveAmount ] .

[] a owl:AllDisjointClasses ;
    owl:members ( epo:CreditTransferInformation epo:PaymentCardInformation epo:PaymentInstructionsInformation ) .

[] a owl:AllDisjointClasses ;
    owl:members ( epo:Payee epo:SellerTaxRepresentative ) .

