>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasTaxExemptionReason">
    <skos:definition xml:lang="en">An explanation on why the amount is exempted from tax or why no tax is being charged according to the legislation, expressed as a code.</skos:definition>
    <skos:prefLabel xml:lang="en">has Tax Exemption Reason</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasInvoiceLinePeriod">
    <skos:prefLabel xml:lang="en">has Invoice Line Period</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#inv">
    <owl:imports rdf:resource="http://www.w3.org/ns/locn"/>
    <owl:imports rdf:resource="http://www.w3.org/ns/adms"/>
    <owl:imports rdf:resource="http://purl.org/dc/terms/"/>
    <owl:imports rdf:resource="http://data.europa.eu/m8g/"/>
    <owl:imports rdf:resource="http://data.europa.eu/eli/ontology#"/>
    <owl:imports rdf:resource="http://www.w3.org/ns/person"/>
    <owl:imports rdf:resource="http://data.europa.eu/a4g/ontology#cat"/>
    <owl:imports rdf:resource="http://data.europa.eu/a4g/ontology#ord"/>
    <owl:imports rdf:resource="http://www.w3.org/2006/time"/>
    <owl:imports rdf:resource="http://www.w3.org/ns/org#"/>
    <owl:imports rdf:resource="http://www.w3.org/2004/02/skos/core#"/>
    <owl:imports rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <owl:imports rdf:resource="http://data.europa.eu/a4g/ontology#ful"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <vann:preferredNamespacePrefix>epo</vann:preferredNamespacePrefix>
    <dcterms:license>© European Union, 2014. Unless otherwise noted, the reuse of the Ontology is authorised under the European Union Public Licence v1.2 (https://eupl.eu/).</dcterms:license>
    <vann:preferredNamespaceUri>http://data.europa.eu/a4g/ontology#</vann:preferredNamespaceUri>
    <rdfs:seeAlso rdf:resource="https://op.europa.eu/en/web/eu-vocabularies/e-procurement"/>
    <rdfs:seeAlso rdf:resource="https://github.com/OP-TED/ePO/releases"/>
    <rdfs:seeAlso rdf:resource="https://docs.ted.europa.eu/home/index.html"/>
    <rdfs:seeAlso rdf:resource="https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology/about"/>
    <dcterms:description xml:lang="en">The eProcurement Ontology Invoicing core describes the concepts and properties representing the European Public Procurement Invoicing domain. The provision of these semantics offers the basis for a common understanding of the domain for all stakeholders ensuring the quality of data exchange and transparency. The ontology restrictions are published in a separate artefact.</dcterms:description>
    <owl:incompatibleWith>4.2.0</owl:incompatibleWith>
    <dcterms:title xml:lang="en">eProcurement Ontology Invoicing - core</dcterms:title>
    <rdfs:label xml:lang="en">eProcurement Ontology Invoicing - core</rdfs:label>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-06-01</dcterms:created>
    <owl:versionInfo>5.1.0</owl:versionInfo>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-06-04</dcterms:issued>
    <dcterms:publisher>http://publications.europa.eu/resource/authority/corporate-body/PUBL</dcterms:publisher>
    <rdfs:comment>This version is automatically generated from eInvoicing.xml on 2025-06-04</rdfs:comment>
    <owl:versionIRI rdf:resource="http://data.europa.eu/a4g/ontology#inv-5.1.0"/>
    <owl:priorVersion>http://data.europa.eu/a4g/ontology#inv-5.0.0</owl:priorVersion>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasTotalTaxAmount">
