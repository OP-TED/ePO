    <skos:prefLabel xml:lang="en">has Total Tax Amount</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasPrepaidAmount">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
