    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#refersToDespatchAdvice">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
    <skos:prefLabel xml:lang="en">refers To Despatch Advice</skos:prefLabel>
