    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#InvoiceNote">
    <skos:definition xml:lang="en">Textual note that is relevant to the Invoice as a whole.</skos:definition>
    <skos:prefLabel xml:lang="en">Invoice Note</skos:prefLabel>
    <skos:historyNote xml:lang="en">WG Approval 11/07/2024</skos:historyNote>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasInvoicingPeriod">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
    <skos:prefLabel xml:lang="en">has Invoicing Period</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#comprisesInvoiceLine">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
    <skos:prefLabel xml:lang="en">comprises Invoice Line</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasTaxInformation">
    <skos:prefLabel xml:lang="en">has Tax Information</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#specifiesAllowanceInformation">
    <skos:prefLabel xml:lang="en">specifies Allowance Information</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#SellerTaxRepresentative">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
    <skos:prefLabel xml:lang="en">Seller Tax Representative</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#OfferingParty"/>
    <skos:definition xml:lang="en">A Role of an Agent that can represent an Organization for taxation purposes. Additional Information: The Seller Tax Representative Role is not a Legal Representative.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 11/07/2024</skos:historyNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#PaymentCardInformation">
    <skos:definition xml:lang="en">Information about card used for payment contemporaneous with invoice issuance.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 11/07/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">Payment Card Information</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#InformationHub"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasPaymentServiceProviderIdentifier">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
    <skos:definition xml:lang="en">An identifier for the payment service provider where a payment account is located.</skos:definition>
    <skos:prefLabel xml:lang="en">has Payment Service Provider Identifier</skos:prefLabel>
    <skos:historyNote xml:lang="en">WG Approval 11/07/2024</skos:historyNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasTotalTaxExclusiveAmount">
    <skos:prefLabel xml:lang="en">has Total Tax Exclusive Amount</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasBankingIdentifier">
    <skos:prefLabel xml:lang="en">has Banking Identifier</skos:prefLabel>
    <skos:definition xml:lang="en">An unique banking reference identifier of the Payee or Seller, assigned by the Payee or Seller bank.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
    <skos:historyNote xml:lang="en">WG Approval 11/07/2024</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasPaymentMeansDescription">
    <skos:historyNote xml:lang="en">WG Approval 11/07/2024</skos:historyNote>
    <skos:definition xml:lang="en">The means for how a payment is expected to be or has been settled, expressed as text. (epo-inv:PaymentInstructionsInformation)</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel xml:lang="en">has Payment Means Description</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#refersToReceiptAdvice">
    <skos:prefLabel xml:lang="en">refers To Receipt Advice</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasPaymentTerm">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel xml:lang="en">has Payment Term</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasInvoiceNote">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Contains Invoice Note.</skos:definition>
    <skos:prefLabel xml:lang="en">has Invoice Note</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
    <skos:historyNote xml:lang="en">WG Approval 11/07/2024</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasLotReference">
    <skos:prefLabel xml:lang="en">has Lot Reference</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#specifiesPayee">
    <skos:prefLabel xml:lang="en">specifies Payee</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasTotalChargeAmount">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
    <skos:prefLabel xml:lang="en">has Total Charge Amount</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#refersToContract">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
    <skos:prefLabel xml:lang="en">refers To Contract</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#refersToOrderLine">
    <skos:prefLabel xml:lang="en">refers To Order Line</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasRemittanceInformation">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
    <skos:historyNote xml:lang="en">WG Approval 11/07/2024</skos:historyNote>
    <skos:definition xml:lang="en">A textual value used to establish a link between the payment and the Invoice, issued by the Seller. (epo-inv:PaymentInstructionsInformation)</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel xml:lang="en">has Remittance Information</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasAccountingCost">
    <skos:prefLabel xml:lang="en">has Accounting Cost</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasQuantity">
    <skos:prefLabel xml:lang="en">has Quantity</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasPaymentCardInformation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
    <skos:prefLabel xml:lang="en">has Payment Card Information</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasPaymentMeansType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
    <skos:definition xml:lang="en">The means for how a payment is expected to be or has been settled, expressed as code.</skos:definition>
    <skos:prefLabel xml:lang="en">has Payment Means Type</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#specifiesSellerTaxRepresentative">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
    <skos:prefLabel xml:lang="en">specifies Seller Tax Representative</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasInvoiceLineObjectIdentifier">
    <skos:prefLabel xml:lang="en">has Invoice Line Object Identifier</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
    <skos:definition xml:lang="en">An identifier for an object on which the invoice line is based, given by the Seller. Additional Information: It may be a subscription number, telephone number, meter point etc., as applicable.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 26/06/2024</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasInvoiceNoteDescription">
    <skos:definition xml:lang="en">A textual note that gives unstructured information that is relevant to the Invoice as a whole. (epo-inv:InvoiceNote)</skos:definition>
    <skos:prefLabel xml:lang="en">has Invoice Note Description</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
    <skos:historyNote xml:lang="en">WG Approval 11/07/2024</skos:historyNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#Payee">
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#OfferingParty"/>
    <skos:historyNote xml:lang="en">WG Approval 11/07/2024</skos:historyNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A Role of an Agent that receives the payment. Additional Information: The role of Payee may be fulfilled by another party than the Seller, e.g. a factoring service.</skos:definition>
    <skos:prefLabel xml:lang="en">Payee</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasTotalLineAmount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
    <skos:prefLabel xml:lang="en">has Total Line Amount</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasPaymentCardPrimaryAccountNumber">
    <skos:definition xml:lang="en">The series of digits embossed on the front of a card used for payment. (epo-inv:PaymentCardInformation)</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
    <skos:prefLabel xml:lang="en">has Payment Card Primary Account Number</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:historyNote xml:lang="en">WG Approval 11/07/2024</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#TaxBreakdownInformation">
    <skos:prefLabel xml:lang="en">Tax Breakdown Information</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
    <skos:definition xml:lang="en">Information about tax breakdown by different categories, rates and exemption reasons.</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 11/07/2024</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#CreditNoteLine">
    <skos:prefLabel xml:lang="en">Credit Note Line</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#InvoiceLine"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#refersToOrder">
    <skos:prefLabel xml:lang="en">refers To Order</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasTotalAccountingCurrencyTaxAmount">
    <skos:prefLabel xml:lang="en">has Total Accounting Currency Tax Amount</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#InvoiceLine">
    <skos:definition xml:lang="en">Details concerning a given unit of goods, services or works mentioned in the Invoice.</skos:definition>
    <skos:prefLabel xml:lang="en">Invoice Line</skos:prefLabel>
    <skos:historyNote xml:lang="en">WG Approval 11/07/2024</skos:historyNote>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Line"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasPaymentCardHolderName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:historyNote xml:lang="en">WG Approval 11/07/2024</skos:historyNote>
    <skos:definition xml:lang="en">The name of the account holder of the card used for payment. Additional Information: An account holder is the entity listed or identified as the holder of a Financial Account by the Financial Institution. (epo-inv:PaymentCardInformation)</skos:definition>
    <skos:prefLabel xml:lang="en">has Payment Card Holder Name</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasTaxExemptionReasonDescription">
    <skos:prefLabel xml:lang="en">has Tax Exemption Reason Description</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:definition xml:lang="en">An explanation on why the amount is exempted from tax or why no tax is being charged according to the legislation, expressed as a text. (epo-inv:TaxBreakdownInformation)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 11/07/2024</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#PaymentInstructionsInformation">
    <skos:historyNote xml:lang="en">WG Approval 11/07/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">Payment Instructions Information</skos:prefLabel>
    <skos:definition xml:lang="en">Information about the payment.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#InformationHub"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasDebitedAccountIdentifier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">has Debited Account Identifier</skos:prefLabel>
    <skos:definition xml:lang="en">An identifier for the account to be debited by the direct debit.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
    <skos:historyNote xml:lang="en">WG Approval 11/07/2024</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasPaymentAccountIdentifier">
    <skos:historyNote xml:lang="en">WG Approval 11/07/2024</skos:historyNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">has Payment Account Identifier</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
    <skos:definition xml:lang="en">A unique identifier of the financial payment account, at a payment service provider, to which payment should be made.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#isSubmittedForInvoiceLine">
    <skos:prefLabel xml:lang="en">is Submitted For Invoice Line</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasMandateIdentifier">
    <skos:definition xml:lang="en">An unique identifier for referencing the direct debit mandate, assigned by the Payee.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
    <skos:historyNote xml:lang="en">WG Approval 11/07/2024</skos:historyNote>
    <skos:prefLabel xml:lang="en">has Mandate Identifier</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasPaymentAccountName">
    <skos:definition xml:lang="en">The name of the account that can send and receive payments to and from a payment service provider. (epo-inv:CreditTransferInformation)</skos:definition>
    <skos:historyNote xml:lang="en">WG Approval 07/11/2024</skos:historyNote>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
    <skos:prefLabel xml:lang="en">has Payment Account Name</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasInvoicedObjectIdentifier">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
    <skos:prefLabel xml:lang="en">has Invoiced Object Identifier</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">An identifier for an object on which the invoice is based, given by the Seller.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#isSpecificToInvoiceLine">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
    <skos:prefLabel xml:lang="en">is Specific To Invoice Line</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#specifiesDeliveryInformation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
    <skos:prefLabel xml:lang="en">specifies Delivery Information</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasTaxPointDate">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
    <skos:historyNote xml:lang="en">WG Approval 11/07/2024</skos:historyNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel xml:lang="en">has Tax Point Date</skos:prefLabel>
    <skos:definition xml:lang="en">The date when the tax becomes accountable for the Seller and for the Buyer. Additional Information: That date can be determined and differs from the date of issue of the invoice, according to the national implementation of the directive. (epo-inv:Invoice)</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#specifiesChargeInformation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
    <skos:prefLabel xml:lang="en">specifies Charge Information</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasTaxBreakdownInformation">
    <skos:prefLabel xml:lang="en">has Tax Breakdown Information</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#specifiesBuyer">
    <skos:prefLabel xml:lang="en">specifies Buyer</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#CreditTransferInformation">
    <skos:prefLabel xml:lang="en">Credit Transfer Information</skos:prefLabel>
    <skos:historyNote xml:lang="en">WG Approval 11/07/2024</skos:historyNote>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#InformationHub"/>
    <skos:definition xml:lang="en">Information about a direct payment of money from one bank account into another.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasPrice">
    <skos:prefLabel xml:lang="en">has Price</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#Invoice">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
    <skos:definition xml:lang="en">A commercial Document issued by the Seller to the Buyer to collect payments for the goods or services provided and to state the VAT amount due by the Buyer.</skos:definition>
    <skos:prefLabel xml:lang="en">Invoice</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:historyNote xml:lang="en">WG Approval 04/07/2024</skos:historyNote>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#PostAwardDocument"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasAmountDueForPayment">
    <skos:prefLabel xml:lang="en">has Amount Due For Payment</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#CreditNote">
    <skos:prefLabel xml:lang="en">Credit Note</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#inv"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Invoice"/>
  </rdf:Description>
