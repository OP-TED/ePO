@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix epo: <http://data.europa.eu/a4g/ontology#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

epo:CreditNote a owl:Class ;
    rdfs:isDefinedBy epo:inv ;
    rdfs:subClassOf epo:Invoice ;
    skos:definition "A Document sent by the Seller to the Buyer to reduce or cancel all or part of the amount previously invoiced."@en ;
    skos:historyNote "WG approval 16/09/2025"@en ;
    skos:prefLabel "Credit Note"@en .

epo:CreditNoteLine a owl:Class ;
    rdfs:isDefinedBy epo:inv ;
    rdfs:subClassOf epo:InvoiceLine ;
    skos:definition "Details concerning a given unit of goods, services or works mentioned in the Credit Note."@en ;
    skos:historyNote "WG approval 16/09/2025"@en ;
    skos:prefLabel "Credit Note Line"@en .

epo:CreditTransferInformation a owl:Class ;
    rdfs:isDefinedBy epo:inv ;
    rdfs:subClassOf epo:InformationHub ;
    skos:definition "Information about a direct payment of money from one bank account into another."@en ;
    skos:historyNote "WG Approval 11/07/2024"@en ;
    skos:prefLabel "Credit Transfer Information"@en .

epo:InvoiceNote a owl:Class ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "Textual note that is relevant to the Invoice as a whole."@en ;
    skos:historyNote "WG Approval 11/07/2024"@en ;
    skos:prefLabel "Invoice Note"@en .

epo:Payee a owl:Class ;
    rdfs:isDefinedBy epo:inv ;
    rdfs:subClassOf epo:OfferingParty ;
    skos:definition "A Role of an Agent that receives the payment. Additional Information: The role of Payee may be fulfilled by another party than the Seller, e.g. a factoring service."@en ;
    skos:historyNote "WG Approval 11/07/2024"@en ;
    skos:prefLabel "Payee"@en .

epo:PaymentCardInformation a owl:Class ;
    rdfs:isDefinedBy epo:inv ;
    rdfs:subClassOf epo:InformationHub ;
    skos:definition "Information about card used for payment contemporaneous with invoice issuance."@en ;
    skos:historyNote "WG Approval 11/07/2024"@en ;
    skos:prefLabel "Payment Card Information"@en .

epo:PaymentInstructionsInformation a owl:Class ;
    rdfs:isDefinedBy epo:inv ;
    rdfs:subClassOf epo:InformationHub ;
    skos:definition "Information about the payment."@en ;
    skos:historyNote "WG Approval 11/07/2024"@en ;
    skos:prefLabel "Payment Instructions Information"@en .

epo:SellerTaxRepresentative a owl:Class ;
    rdfs:isDefinedBy epo:inv ;
    rdfs:subClassOf epo:OfferingParty ;
    skos:definition "A Role of an Agent that can represent an Organization for taxation purposes. Additional Information: The Seller Tax Representative Role is not a Legal Representative."@en ;
    skos:historyNote "WG Approval 11/07/2024"@en ;
    skos:prefLabel "Seller Tax Representative"@en .

epo:TaxBreakdownInformation a owl:Class ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "Information about tax breakdown by different categories, rates and exemption reasons."@en ;
    skos:historyNote "WG Approval 11/07/2024"@en ;
    skos:prefLabel "Tax Breakdown Information"@en .

epo:comprisesCreditNoteLine a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:inv ;
    rdfs:subPropertyOf epo:comprisesInvoiceLine ;
    skos:definition "Incorporates Credit Note Line."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "comprises Credit Note Line"@en .

epo:hasAccountingCost a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:prefLabel "has Accounting Cost"@en .

epo:hasAmountDueForPayment a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "Relation indicating the Monetary Value that has to be paid."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "has Amount Due For Payment"@en .

epo:hasBankingIdentifier a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "An unique banking reference identifier of the Payee or Seller, assigned by the Payee or Seller bank."@en ;
    skos:historyNote "WG Approval 11/07/2024"@en ;
    skos:prefLabel "has Banking Identifier"@en .

epo:hasCreditTransferInformation a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "Relation indicating the Credit Transfer Information."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "has Credit Transfer Information"@en .

epo:hasDebitedAccountIdentifier a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "An identifier for the account to be debited by the direct debit."@en ;
    skos:historyNote "WG Approval 11/07/2024"@en ;
    skos:prefLabel "has Debited Account Identifier"@en .

epo:hasInvoiceLineObjectIdentifier a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "An identifier for an object on which the invoice line is based, given by the Seller. Additional Information: It may be a subscription number, telephone number, meter point etc., as applicable."@en ;
    skos:historyNote "WG Approval 26/06/2024"@en ;
    skos:prefLabel "has Invoice Line Object Identifier"@en .

epo:hasInvoiceLinePeriod a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "Relation indicating the time range of the Invoice Line."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "has Invoice Line Period"@en .

epo:hasInvoiceNote a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "Contains Invoice Note."@en ;
    skos:historyNote "WG Approval 11/07/2024"@en ;
    skos:prefLabel "has Invoice Note"@en .

epo:hasInvoiceNoteDescription a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "A textual note that gives unstructured information that is relevant to the Invoice as a whole. (epo-inv:InvoiceNote)"@en ;
    skos:historyNote "WG Approval 11/07/2024"@en ;
    skos:prefLabel "has Invoice Note Description"@en .

epo:hasInvoiceNoteSubject a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "Relation indicating the Invoice Note Subject Code."@en ;
    skos:prefLabel "has Invoice Note Subject"@en .

epo:hasInvoicedObjectIdentifier a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "An identifier for an object on which the invoice is based, given by the Seller."@en ;
    skos:prefLabel "has Invoiced Object Identifier"@en .

epo:hasInvoicingPeriod a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "Relation indicating the time range for creating, sending, and managing Invoices."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "has Invoicing Period"@en .

epo:hasLotReference a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "Relation indicating the instance of the concept refers to a Lot."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "has Lot Reference"@en .

epo:hasMandateIdentifier a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "An unique identifier for referencing the direct debit mandate, assigned by the Payee."@en ;
    skos:historyNote "WG Approval 11/07/2024"@en ;
    skos:prefLabel "has Mandate Identifier"@en .

epo:hasNetAmount a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "Relation indicating the Monetary Value exclusive of taxes and after substracting price discounts."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "has Net Amount"@en .

epo:hasPaymentAccountIdentifier a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "A unique identifier of the financial payment account, at a payment service provider, to which payment should be made."@en ;
    skos:historyNote "WG Approval 11/07/2024"@en ;
    skos:prefLabel "has Payment Account Identifier"@en .

epo:hasPaymentAccountName a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "The name of the account that can send and receive payments to and from a payment service provider. (epo-inv:CreditTransferInformation)"@en ;
    skos:historyNote "WG Approval 07/11/2024"@en ;
    skos:prefLabel "has Payment Account Name"@en .

epo:hasPaymentCardHolderName a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "The name of the account holder of the card used for payment. Additional Information: An account holder is the entity listed or identified as the holder of a Financial Account by the Financial Institution. (epo-inv:PaymentCardInformation)"@en ;
    skos:historyNote "WG Approval 11/07/2024"@en ;
    skos:prefLabel "has Payment Card Holder Name"@en .

epo:hasPaymentCardInformation a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "Relation indicating the Payment Card Information."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "has Payment Card Information"@en .

epo:hasPaymentCardPrimaryAccountNumber a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "The series of digits embossed on the front of a card used for payment. (epo-inv:PaymentCardInformation)"@en ;
    skos:historyNote "WG Approval 11/07/2024"@en ;
    skos:prefLabel "has Payment Card Primary Account Number"@en .

epo:hasPaymentDueDate a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "Final date until which the Payment can be made. (epo-inv:Invoice)"@en ;
    skos:historyNote "WG approval 25/09/2026"@en ;
    skos:prefLabel "has Payment Due Date"@en .

epo:hasPaymentInstructionsInformation a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "Relation indicating the Payment Instruction Information."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "has Payment Instructions Information"@en .

epo:hasPaymentMeansDescription a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "The means for how a payment is expected to be or has been settled, expressed as text. (epo-inv:PaymentInstructionsInformation)"@en ;
    skos:historyNote "WG Approval 11/07/2024"@en ;
    skos:prefLabel "has Payment Means Description"@en .

epo:hasPaymentMeansInformation a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "Relation indicating the Payment Instruction Information."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "has Payment Means Information"@en .

epo:hasPaymentMeansType a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "The means for how a payment is expected to be or has been settled, expressed as code."@en ;
    skos:prefLabel "has Payment Means Type"@en .

epo:hasPaymentServiceProviderIdentifier a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "An identifier for the payment service provider where a payment account is located."@en ;
    skos:historyNote "WG Approval 11/07/2024"@en ;
    skos:prefLabel "has Payment Service Provider Identifier"@en .

epo:hasPaymentTerm a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "Condition and stipulation of the Payment. (epo-inv:Invoice)"@en ;
    skos:historyNote "WG approval 25/09/2026"@en ;
    skos:prefLabel "has Payment Term"@en .

epo:hasPrepaidAmount a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "Relation indicating the Monetary Value that is paid in advance."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "has Prepaid Amount"@en .

epo:hasPrice a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "Relation indicating that the instance of the concept has a Price."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "has Price"@en .

epo:hasQuantity a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "Relation indicating that the instance of the concept has a Quantity."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "has Quantity"@en .

epo:hasRemittanceInformation a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "A textual value used to establish a link between the payment and the Invoice, issued by the Seller. (epo-inv:PaymentInstructionsInformation)"@en ;
    skos:historyNote "WG Approval 11/07/2024"@en ;
    skos:prefLabel "has Remittance Information"@en .

epo:hasRoundingAmount a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "Relation indicating the adjustment Monetary Value applied to bring calculated total to a convenient value."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "has Rounding Amount"@en .

epo:hasTaxBreakdownInformation a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "Relation indicating the Tax Breakdown Information."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "has Tax Breakdown Information"@en .

epo:hasTaxExemptionReason a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "An explanation on why the amount is exempted from tax or why no tax is being charged according to the legislation, expressed as a code."@en ;
    skos:prefLabel "has Tax Exemption Reason"@en .

epo:hasTaxExemptionReasonDescription a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "An explanation on why the amount is exempted from tax or why no tax is being charged according to the legislation, expressed as a text. (epo-inv:TaxBreakdownInformation)"@en ;
    skos:historyNote "WG Approval 11/07/2024"@en ;
    skos:prefLabel "has Tax Exemption Reason Description"@en .

epo:hasTaxInformation a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "Relation indicating the Tax Information."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "has Tax Information"@en .

epo:hasTaxPointDate a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "The date when the tax becomes accountable for the Seller and for the Buyer. Additional Information: That date can be determined and differs from the date of issue of the invoice, according to the national implementation of the directive. (epo-inv:Invoice)"@en ;
    skos:historyNote "WG Approval 11/07/2024"@en ;
    skos:prefLabel "has Tax Point Date"@en .

epo:hasTaxPointDateCode a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "Relation indicating the a Tax Date."@en ;
    skos:prefLabel "has Tax Point Date Code"@en .

epo:hasTotalAccountingCurrencyTaxAmount a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "Relation indicating the overall Monetary Value of the Tax applied on the currency in which the financial transactions are recorded at the company level."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "has Total Accounting Currency Tax Amount"@en .

epo:hasTotalAllowanceAmount a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "Relation indicating the overall Monetary Value of the Allowance."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "has Total Allowance Amount"@en .

epo:hasTotalChargeAmount a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "Relation indicating the overall Monetary Value of the Charge."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "has Total Charge Amount"@en .

epo:hasTotalLineAmount a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "Relation indicating the overall Monetary Value of the Line."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "has Total Line Amount"@en .

epo:hasTotalTaxAmount a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "Relation indicating the overall Monetary Value of the Tax applied."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "has Total Tax Amount"@en .

epo:hasTotalTaxExclusiveAmount a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "Relation indicating the overall Monetary Value without Tax."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "has Total Tax Exclusive Amount"@en .

epo:hasTotalTaxInclusiveAmount a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "Relation indicating the overall Monetary Value with Tax."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "has Total Tax Inclusive Amount"@en .

epo:isSpecificToInvoiceLine a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "Information that is particular to an Invoice Line."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "is Specific To Invoice Line"@en .

epo:isSubmittedForInvoiceLine a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "Relation indicating that the instance of the concept is sent for a specific Invoice Line."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "is Submitted For Invoice Line"@en .

epo:refersToContract a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "Reference to a Contract."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "refers To Contract"@en .

epo:refersToDespatchAdvice a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "Reference to a Despatch Advice."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "refers To Despatch Advice"@en .

epo:refersToInvoice a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "Reference to an Invoice."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "refers To Invoice"@en .

epo:refersToOrder a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "Reference to an Order."@en ;
    skos:prefLabel "refers To Order"@en .

epo:refersToOrderLine a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "Reference to an Order Line."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "refers To Order Line"@en .

epo:refersToProject a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "Reference to a Project."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "refers To Project"@en .

epo:refersToReceiptAdvice a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "Reference to a Receipt Advice."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "refers To Receipt Advice"@en .

epo:specifiesAllowanceInformation a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "Relation indicating the Allowance Information."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "specifies Allowance Information"@en .

epo:specifiesBuyer a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "Relation indicating that the instance of the concept involves the Buyer."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "specifies Buyer"@en .

epo:specifiesChargeInformation a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "Relation indicating the Charge Information."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "specifies Charge Information"@en .

epo:specifiesDeliveryInformation a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "Relation indicating the Delivery Information."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "specifies Delivery Information"@en .

epo:specifiesPayee a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "Relation indicating that the instance of the concept involves the Payee."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "specifies Payee"@en .

epo:specifiesSeller a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "Relation indicating that the instance of the concept involves the Seller."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "specifies Seller"@en .

epo:specifiesSellerTaxRepresentative a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "Relation indicating that the instance of the concept involves the Seller Tax Representative."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "specifies Seller Tax Representative"@en .

epo:Invoice a owl:Class ;
    rdfs:isDefinedBy epo:inv ;
    rdfs:subClassOf epo:PostAwardDocument ;
    skos:definition "A commercial Document issued by the Seller to the Buyer to collect payments for the goods or services provided and to state the VAT amount due by the Buyer."@en ;
    skos:historyNote "WG Approval 04/07/2024"@en ;
    skos:prefLabel "Invoice"@en .

epo:InvoiceLine a owl:Class ;
    rdfs:isDefinedBy epo:inv ;
    rdfs:subClassOf epo:Line ;
    skos:definition "Details concerning a given unit of goods, services or works mentioned in the Invoice."@en ;
    skos:historyNote "WG Approval 11/07/2024"@en ;
    skos:prefLabel "Invoice Line"@en .

epo:comprisesInvoiceLine a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:inv ;
    skos:definition "Incorporates Invoice Line."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "comprises Invoice Line"@en .

epo:inv a owl:Ontology ;
    rdfs:label "eProcurement Ontology Invoicing - core"@en ;
    dcterms:created "2021-06-01"^^xsd:date ;
    dcterms:description "The eProcurement Ontology Invoicing core describes the concepts and properties representing the European Public Procurement Invoicing domain. The provision of these semantics offers the basis for a common understanding of the domain for all stakeholders ensuring the quality of data exchange and transparency. The ontology restrictions are published in a separate artefact."@en ;
    dcterms:issued "2025-10-10"^^xsd:date ;
    dcterms:license "© European Union, 2014. Unless otherwise noted, the reuse of the Ontology is authorised under the European Union Public Licence v1.2 (https://eupl.eu/)." ;
    dcterms:publisher "http://publications.europa.eu/resource/authority/corporate-body/PUBL" ;
    dcterms:title "eProcurement Ontology Invoicing - core"@en ;
    vann:preferredNamespacePrefix "epo" ;
    vann:preferredNamespaceUri "http://data.europa.eu/a4g/ontology#" ;
    rdfs:comment "This version is automatically generated from eInvoicing.xml on 2025-10-10" ;
    rdfs:seeAlso <https://docs.ted.europa.eu/home/index.html>,
        <https://github.com/OP-TED/ePO/releases>,
        <https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology/about>,
        <https://op.europa.eu/en/web/eu-vocabularies/e-procurement> ;
    owl:imports epo:cat,
        epo:core,
        epo:ful,
        epo:ord,
        <http://data.europa.eu/eli/ontology#>,
        <http://data.europa.eu/m8g/>,
        dcterms:,
        skos:,
        <http://www.w3.org/2006/time>,
        <http://www.w3.org/ns/adms>,
        <http://www.w3.org/ns/locn>,
        org:,
        <http://www.w3.org/ns/person> ;
    owl:incompatibleWith "4.2.0" ;
    owl:priorVersion "http://data.europa.eu/a4g/ontology#inv-5.1.0" ;
    owl:versionIRI epo:inv-5.2.0 ;
    owl:versionInfo "5.2.0" .

