@prefix : <http://data.europa.eu/a4g/ontology#> .
@prefix cccev: <http://data.europa.eu/m8g/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eli: <http://data.europa.eu/eli/ontology#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:EvidenceOutcome a owl:Class ;
    rdfs:isDefinedBy :qua ;
    skos:definition "Result concerning the submitted Evidence."@en ;
    skos:prefLabel "Evidence Outcome"@en .

:EvidenceReceipt a owl:Class ;
    rdfs:isDefinedBy :qua ;
    rdfs:subClassOf :Document ;
    skos:definition "A Document sent by the Buyer to the Economic Operator confirming the receival of an Evidence Submission."@en ;
    skos:prefLabel "Evidence Receipt"@en .

:EvidenceRequest a owl:Class ;
    rdfs:isDefinedBy :qua ;
    rdfs:subClassOf :Document ;
    skos:definition "A Document sent by the Buyer to the Economic Operator asking for the submission of an Evidence."@en ;
    skos:prefLabel "Evidence Request"@en .

:EvidenceSubmission a owl:Class ;
    rdfs:isDefinedBy :qua ;
    rdfs:subClassOf :Document ;
    skos:definition "A Document sent by the Economic Operator to the Buyer which contains an Evidence."@en ;
    skos:prefLabel "Evidence Submission"@en .

:QualificationDecisionInformation a owl:Class ;
    rdfs:isDefinedBy :qua ;
    skos:definition "Information about the aggregated result of the Evidence Outcomes."@en ;
    skos:prefLabel "Qualification Decision Information"@en .

:QualificationReponse a owl:Class ;
    rdfs:isDefinedBy :qua ;
    rdfs:subClassOf :Document ;
    skos:definition "A formal reply from the Buyer to the Economic Operator informing the Economic Operator that it may participate in a procurement."@en ;
    skos:prefLabel "Qualification Reponse"@en .

:comprisesEvidenceOutcome a owl:ObjectProperty ;
    rdfs:isDefinedBy :qua ;
    skos:definition "Incorporates Evidence Outcome."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "comprises Evidence Outcome"@en .

:concernsLot a owl:ObjectProperty ;
    rdfs:isDefinedBy :qua ;
    skos:definition "Relates to Lot."@en ;
    skos:prefLabel "concerns Lot"@en .

:concernsProcedure a owl:ObjectProperty ;
    rdfs:isDefinedBy :qua ;
    skos:definition "Relates to Procedure."@en ;
    skos:prefLabel "concerns Procedure"@en .

:fulfillsRequirement a owl:DatatypeProperty ;
    rdfs:isDefinedBy :qua ;
    skos:definition "Indicates whether the Requirement is satisfied. (epo-qua:EvidenceOutcome)"@en ;
    skos:historyNote "WG approval 09/09/2025"@en ;
    skos:prefLabel "fulfills Requirement"@en .

:hasQualificationDecisionDate a owl:DatatypeProperty ;
    rdfs:isDefinedBy :qua ;
    skos:definition "The official date of the Qualification Decision. (epo-qua:QualificationDecisionInformation)"@en ;
    skos:historyNote "WG approval 09/09/2025"@en ;
    skos:prefLabel "has Qualification Decision Date"@en .

:hasRejectionDescription a owl:DatatypeProperty ;
    rdfs:isDefinedBy :qua ;
    skos:definition "Explanatory text about the rejection reason. (epo-qua:QualificationDecisionInformation)"@en ;
    skos:historyNote "WG approval 09/09/2025"@en ;
    skos:prefLabel "has Rejection Description"@en .

:isQualified a owl:DatatypeProperty ;
    rdfs:isDefinedBy :qua ;
    skos:definition "Indicates whether the economic operator is eligible. (epo-qua:QualificationDecisionInformation)"@en ;
    skos:historyNote "WG approval 09/09/2025"@en ;
    skos:prefLabel "is Qualified"@en .

:providesDecisionFor a owl:ObjectProperty ;
    rdfs:isDefinedBy :qua ;
    skos:definition "Makes available the resolution."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "provides Decision For"@en .

:providesEvidence a owl:ObjectProperty ;
    rdfs:isDefinedBy :qua ;
    skos:definition "Makes available the Evidence."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "provides Evidence"@en .

:refersToEvidenceRequest a owl:ObjectProperty ;
    rdfs:isDefinedBy :qua ;
    skos:definition "Reference to an Evidence Request."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "refers To Evidence Request"@en .

:refersToEvidenceSubmission a owl:ObjectProperty ;
    rdfs:isDefinedBy :qua ;
    skos:definition "Reference to an Evidence Submission."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "refers To Evidence Submission"@en .

:specifiesEconomicOperator a owl:ObjectProperty ;
    rdfs:isDefinedBy :qua ;
    skos:definition "Relation indicating that the instance of the concept involves the Economic Operator."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "specifies Economic Operator"@en .

:specifiesEvidence a owl:ObjectProperty ;
    rdfs:isDefinedBy :qua ;
    skos:definition "Relation indicating the Evidence."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "specifies Evidence"@en .

:summarisesInformationForQualificationResponse a owl:ObjectProperty ;
    rdfs:isDefinedBy :qua ;
    skos:definition "Relation indicating the Qualification Response that the information refers to."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "summarises Information For Qualification Response"@en .

:qua a owl:Ontology ;
    rdfs:label "eProcurement Ontology Qualification - core"@en ;
    dcterms:created "2021-06-01"^^xsd:date ;
    dcterms:description "The eProcurement Ontology Qualification core describes the concepts and properties representing the European Public Procurement Qualification domain. The provision of these semantics offers the basis for a common understanding of the domain for all stakeholders ensuring the quality of data exchange and transparency. The ontology restrictions are published in a separate artefact."@en ;
    dcterms:issued "2025-10-10"^^xsd:date ;
    dcterms:license "© European Union, 2014. Unless otherwise noted, the reuse of the Ontology is authorised under the European Union Public Licence v1.2 (https://eupl.eu/)." ;
    dcterms:publisher "http://publications.europa.eu/resource/authority/corporate-body/PUBL" ;
    dcterms:title "eProcurement Ontology Qualification - core"@en ;
    vann:preferredNamespacePrefix "epo" ;
    vann:preferredNamespaceUri "http://data.europa.eu/a4g/ontology#" ;
    rdfs:comment "This version is automatically generated from eQualification.xml on 2025-10-10" ;
    rdfs:seeAlso <https://docs.ted.europa.eu/home/index.html>,
        <https://github.com/OP-TED/ePO/releases>,
        <https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology/about>,
        <https://op.europa.eu/en/web/eu-vocabularies/e-procurement> ;
    owl:imports :core,
        eli:,
        cccev:,
        dcterms:,
        skos:,
        <http://www.w3.org/2006/time>,
        <http://www.w3.org/ns/adms>,
        <http://www.w3.org/ns/locn>,
        org:,
        <http://www.w3.org/ns/person> ;
    owl:incompatibleWith "4.2.0" ;
    owl:priorVersion "http://data.europa.eu/a4g/ontology#qua-5.1.0" ;
    owl:versionIRI :qua-5.2.0 ;
    owl:versionInfo "5.2.0" .

