@prefix : <http://data.europa.eu/a4g/ontology#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:EvidenceOutcome a owl:Class ;
    rdfs:isDefinedBy :qua ;
    skos:prefLabel "Evidence Outcome"@en .

:EvidenceReceipt a owl:Class ;
    rdfs:isDefinedBy :qua ;
    rdfs:subClassOf :Document ;
    skos:prefLabel "Evidence Receipt"@en .

:EvidenceRequest a owl:Class ;
    rdfs:isDefinedBy :qua ;
    rdfs:subClassOf :Document ;
    skos:prefLabel "Evidence Request"@en .

:EvidenceSubmission a owl:Class ;
    rdfs:isDefinedBy :qua ;
    rdfs:subClassOf :Document ;
    skos:prefLabel "Evidence Submission"@en .

:QualificationDecisionInformation a owl:Class ;
    rdfs:isDefinedBy :qua ;
    skos:prefLabel "Qualification Decision Information"@en .

:QualificationReponse a owl:Class ;
    rdfs:isDefinedBy :qua ;
    rdfs:subClassOf :Document ;
    skos:prefLabel "Qualification Reponse"@en .

:comprisesEvidenceOutcome a owl:ObjectProperty ;
    rdfs:isDefinedBy :qua ;
    skos:prefLabel "comprises Evidence Outcome"@en .

:concernsLot a owl:ObjectProperty ;
    rdfs:isDefinedBy :qua ;
    skos:prefLabel "concerns Lot"@en .

:concernsProcedure a owl:ObjectProperty ;
    rdfs:isDefinedBy :qua ;
    skos:prefLabel "concerns Procedure"@en .

:fulfillsRequirement a owl:DatatypeProperty ;
    rdfs:isDefinedBy :qua ;
    skos:prefLabel "fulfills Requirement"@en .

:hasQualificationDecisionDate a owl:DatatypeProperty ;
    rdfs:isDefinedBy :qua ;
    skos:prefLabel "has Qualification Decision Date"@en .

:hasRejectionDescription a owl:DatatypeProperty ;
    rdfs:isDefinedBy :qua ;
    skos:prefLabel "has Rejection Description"@en .

:isQualified a owl:DatatypeProperty ;
    rdfs:isDefinedBy :qua ;
    skos:prefLabel "is Qualified"@en .

:providesDecisionFor a owl:ObjectProperty ;
    rdfs:isDefinedBy :qua ;
    skos:prefLabel "provides Decision For"@en .

:providesEvidence a owl:ObjectProperty ;
    rdfs:isDefinedBy :qua ;
    skos:prefLabel "provides Evidence"@en .

:refersToEvidenceRequest a owl:ObjectProperty ;
    rdfs:isDefinedBy :qua ;
    skos:prefLabel "refers To Evidence Request"@en .

:refersToEvidenceSubmission a owl:ObjectProperty ;
    rdfs:isDefinedBy :qua ;
    skos:prefLabel "refers To Evidence Submission"@en .

:specifiesEconomicOperator a owl:ObjectProperty ;
    rdfs:isDefinedBy :qua ;
    skos:prefLabel "specifies Economic Operator"@en .

:specifiesEvidence a owl:ObjectProperty ;
    rdfs:isDefinedBy :qua ;
    skos:prefLabel "specifies Evidence"@en .

:summarisesInformationForQualificationResponse a owl:ObjectProperty ;
    rdfs:isDefinedBy :qua ;
    skos:prefLabel "summarises Information For Qualification Response"@en .

:qua a owl:Ontology ;
    rdfs:label """This artefact provides the definitions for the eProcurement Ontology Core.
        This artefact excludes the restrictions.
        The eProcurement Ontology describes objects and concepts, with definitions, attributes and relationships which are present within the European public procurement domain.
        The provision of these concepts provides the basis for a common understanding of the domain for all stakeholders ensuring the quality of data exchange and transparency."""@en ;
    dcterms:created "2025-09-04"^^xsd:date ;
    dcterms:description """This artefact provides the definitions for the eProcurement Ontology Core.
        This artefact excludes the restrictions.
        The eProcurement Ontology describes objects and concepts, with definitions, attributes and relationships which are present within the European public procurement domain.
        The provision of these concepts provides the basis for a common understanding of the domain for all stakeholders ensuring the quality of data exchange and transparency."""@en ;
    dcterms:issued "2025-09-04"^^xsd:date ;
    dcterms:license "CC BY 4.0" ;
    dcterms:publisher "http://publications.europa.eu/resource/authority/corporate-body/PUBL" ;
    dcterms:title "ePO Core core"@en ;
    vann:preferredNamespacePrefix "epo" ;
    vann:preferredNamespaceUri "http://data.europa.eu/a4g/ontology#" ;
    rdfs:comment "This version is automatically generated from eQualification.xml on 2025-10-15" ;
    rdfs:seeAlso <https://docs.ted.europa.eu/EPO/latest/index.html>,
        <https://github.com/eprocurementontology/eprocurementontology>,
        <https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology/about>,
        <https://op.europa.eu/en/web/eu-vocabularies/e-procurement> ;
    owl:imports dcterms:,
        skos:,
        <http://www.w3.org/ns/adms>,
        <https://data.europa.eu/m8g> ;
    owl:incompatibleWith "2.1.0" ;
