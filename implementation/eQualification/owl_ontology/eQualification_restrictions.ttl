@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix epo: <http://data.europa.eu/a4g/ontology#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

epo:comprisesEvidenceOutcome rdfs:domain epo:QualificationDecisionInformation ;
    rdfs:range epo:EvidenceOutcome .

epo:providesEvidence rdfs:domain epo:EvidenceSubmission ;
    rdfs:range <http://data.europa.eu/m8g/Evidence> .

epo:qua-restriction a owl:Ontology ;
    rdfs:label "eProcurement Ontology Qualification - core restrictions"@en ;
    dcterms:created "2021-06-01"^^xsd:date ;
    dcterms:description "The eProcurement Ontology Qualification core restrictions provides the restrictions and the inference-related specifications on the concepts and properties in the eProcurement Ontology Qualification core."@en ;
    dcterms:issued "2025-05-15"^^xsd:date ;
    dcterms:license "© European Union, 2014. Unless otherwise noted, the reuse of the Ontology is authorised under the European Union Public Licence v1.2 (https://eupl.eu/)." ;
    dcterms:publisher "http://publications.europa.eu/resource/authority/corporate-body/PUBL" ;
    dcterms:title "eProcurement Ontology Qualification - core restrictions"@en ;
    vann:preferredNamespacePrefix "epo" ;
    vann:preferredNamespaceUri "http://data.europa.eu/a4g/ontology#" ;
    rdfs:comment """This version is automatically generated from eQualification.xml on 
                2025-05-15""" ;
    rdfs:seeAlso <https://docs.ted.europa.eu/home/index.html>,
        <https://github.com/OP-TED/ePO/releases>,
        <https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology/about>,
        <https://op.europa.eu/en/web/eu-vocabularies/e-procurement> ;
    owl:imports epo:core,
        epo:qua,
        <http://data.europa.eu/eli/ontology#>,
        <http://data.europa.eu/m8g/>,
        dcterms:,
        skos:,
        <http://www.w3.org/2006/time>,
        <http://www.w3.org/ns/adms>,
        <http://www.w3.org/ns/locn>,
        org:,
        <http://www.w3.org/ns/person> ;
    owl:incompatibleWith "4.2.0" ;
    owl:priorVersion "http://data.europa.eu/a4g/ontology#qua-restriction-4.2.0" ;
    owl:versionIRI epo:qua-restriction-5.0.0 ;
    owl:versionInfo "5.0.0" .

epo:fulfillsRequirement rdfs:domain epo:EvidenceOutcome ;
    rdfs:range xsd:boolean .

epo:hasQualificationDecisionDate a owl:FunctionalProperty ;
    rdfs:domain epo:QualificationDecisionInformation ;
    rdfs:range xsd:dateTime .

epo:hasRejectionDescription rdfs:domain epo:QualificationDecisionInformation ;
    rdfs:range rdf:PlainLiteral .

epo:isQualified rdfs:domain epo:QualificationDecisionInformation ;
    rdfs:range xsd:boolean .

epo:providesDecisionFor a owl:FunctionalProperty ;
    rdfs:domain epo:QualificationDecisionInformation ;
    rdfs:range epo:Lot .

epo:refersToEvidenceRequest rdfs:domain epo:EvidenceSubmission ;
    rdfs:range epo:EvidenceRequest .

epo:specifiesEvidence a owl:FunctionalProperty ;
    rdfs:domain epo:EvidenceOutcome ;
    rdfs:range <http://data.europa.eu/m8g/Evidence> .

epo:summarisesInformationForQualificationResponse a owl:FunctionalProperty ;
    rdfs:domain epo:QualificationDecisionInformation ;
    rdfs:range epo:QualificationReponse .

epo:EvidenceReceipt rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:refersToEvidenceSubmission ] .

epo:concernsLot rdfs:domain [ a owl:Class ;
            owl:unionOf ( epo:EvidenceSubmission epo:EvidenceRequest ) ] ;
    rdfs:range epo:Lot .

epo:concernsProcedure a owl:FunctionalProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( epo:EvidenceSubmission epo:EvidenceRequest ) ] ;
    rdfs:range epo:Procedure .

epo:refersToEvidenceSubmission a owl:FunctionalProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( epo:EvidenceReceipt epo:QualificationReponse ) ] ;
    rdfs:range epo:EvidenceSubmission .

epo:specifiesEconomicOperator a owl:FunctionalProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( epo:EvidenceSubmission epo:EvidenceRequest ) ] ;
    rdfs:range epo:OfferingParty .

epo:EvidenceOutcome rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:specifiesEvidence ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:fulfillsRequirement ] .

epo:QualificationReponse rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:refersToEvidenceSubmission ] .

epo:EvidenceRequest rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty epo:concernsLot ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:specifiesEconomicOperator ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:concernsProcedure ] .

epo:QualificationDecisionInformation rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:hasQualificationDecisionDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:hasRejectionDescription ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:summarisesInformationForQualificationResponse ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:isQualified ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:providesDecisionFor ] .

epo:EvidenceSubmission rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:specifiesEconomicOperator ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty epo:concernsLot ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:refersToEvidenceRequest ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:concernsProcedure ] .

[] a owl:AllDisjointClasses ;
    owl:members ( epo:EvidenceReceipt epo:EvidenceSubmission epo:EvidenceRequest epo:QualificationReponse ) .

