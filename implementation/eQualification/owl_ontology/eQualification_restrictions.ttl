@prefix : <http://data.europa.eu/a4g/ontology#> .
@prefix cccev: <http://data.europa.eu/m8g/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eli: <http://data.europa.eu/eli/ontology#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:comprisesEvidenceOutcome rdfs:domain :QualificationDecisionInformation ;
    rdfs:range :EvidenceOutcome .

:providesEvidence rdfs:domain :EvidenceSubmission ;
    rdfs:range cccev:Evidence .

:qua-restriction a owl:Ontology ;
    rdfs:label "eProcurement Ontology Qualification - core restrictions"@en ;
    dcterms:created "2021-06-01"^^xsd:date ;
    dcterms:description "The eProcurement Ontology Qualification core restrictions provides the restrictions and the inference-related specifications on the concepts and properties in the eProcurement Ontology Qualification core."@en ;
    dcterms:issued "2026-10-26"^^xsd:date ;
    dcterms:license "© European Union, 2014. Unless otherwise noted, the reuse of the Ontology is authorised under the European Union Public Licence v1.2 (https://eupl.eu/)." ;
    dcterms:publisher "http://publications.europa.eu/resource/authority/corporate-body/PUBL" ;
    dcterms:title "eProcurement Ontology Qualification - core restrictions"@en ;
    vann:preferredNamespacePrefix "epo" ;
    vann:preferredNamespaceUri "http://data.europa.eu/a4g/ontology#" ;
    rdfs:comment """This version is automatically generated from eQualification.xml on 
                2026-10-26""" ;
    rdfs:seeAlso <https://docs.ted.europa.eu/home/index.html>,
        <https://github.com/OP-TED/ePO/releases>,
        <https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology/about>,
        <https://op.europa.eu/en/web/eu-vocabularies/e-procurement> ;
    owl:imports :core,
        :qua,
        eli:,
        cccev:,
        dcterms:,
        skos:,
        <http://www.w3.org/2006/time>,
        <http://www.w3.org/ns/adms>,
        <http://www.w3.org/ns/locn>,
        org:,
        <http://www.w3.org/ns/person> ;
    owl:incompatibleWith "4.2.0" ;
    owl:priorVersion "http://data.europa.eu/a4g/ontology#qua-restriction-5.2.0" ;
    owl:versionIRI :qua-restriction-5.3.0 ;
    owl:versionInfo "5.3.0" .

:EvidenceReceipt rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :EvidenceSubmission ;
            owl:onProperty :refersToEvidenceSubmission ;
            owl:qualifiedCardinality 1 ] .

:fulfillsRequirement rdfs:domain :EvidenceOutcome ;
    rdfs:range xsd:boolean .

:hasQualificationDecisionDate a owl:FunctionalProperty ;
    rdfs:domain :QualificationDecisionInformation ;
    rdfs:range xsd:dateTime .

:hasRejectionDescription rdfs:domain :QualificationDecisionInformation ;
    rdfs:range rdf:PlainLiteral .

:isQualified rdfs:domain :QualificationDecisionInformation ;
    rdfs:range xsd:boolean .

:providesDecisionFor a owl:FunctionalProperty ;
    rdfs:domain :QualificationDecisionInformation ;
    rdfs:range :Lot .

:refersToEvidenceRequest rdfs:domain :EvidenceSubmission ;
    rdfs:range :EvidenceRequest .

:specifiesEvidence a owl:FunctionalProperty ;
    rdfs:domain :EvidenceOutcome ;
    rdfs:range cccev:Evidence .

:summarisesInformationForQualificationResponse a owl:FunctionalProperty ;
    rdfs:domain :QualificationDecisionInformation ;
    rdfs:range :QualificationReponse .

:concernsLot rdfs:domain [ a owl:Class ;
            owl:unionOf ( :EvidenceRequest :EvidenceSubmission ) ] ;
    rdfs:range :Lot .

:concernsProcedure a owl:FunctionalProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :EvidenceRequest :EvidenceSubmission ) ] ;
    rdfs:range :Procedure .

:refersToEvidenceSubmission a owl:FunctionalProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :EvidenceReceipt :QualificationReponse ) ] ;
    rdfs:range :EvidenceSubmission .

:specifiesEconomicOperator a owl:FunctionalProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :EvidenceRequest :EvidenceSubmission ) ] ;
    rdfs:range :OfferingParty .

:EvidenceOutcome rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass cccev:Evidence ;
            owl:onProperty :specifiesEvidence ;
            owl:qualifiedCardinality 1 ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty :fulfillsRequirement ] .

:QualificationReponse rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :EvidenceSubmission ;
            owl:onProperty :refersToEvidenceSubmission ;
            owl:qualifiedCardinality 1 ] .

:EvidenceRequest rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :OfferingParty ;
            owl:onProperty :specifiesEconomicOperator ;
            owl:qualifiedCardinality 1 ],
        [ a owl:Restriction ;
            owl:onProperty :concernsLot ;
            owl:someValuesFrom :Lot ],
        [ a owl:Restriction ;
            owl:onClass :Procedure ;
            owl:onProperty :concernsProcedure ;
            owl:qualifiedCardinality 1 ] .

:QualificationDecisionInformation rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :QualificationReponse ;
            owl:onProperty :summarisesInformationForQualificationResponse ;
            owl:qualifiedCardinality 1 ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty :isQualified ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty :hasRejectionDescription ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:dateTime ;
            owl:onProperty :hasQualificationDecisionDate ;
            owl:qualifiedCardinality 1 ],
        [ a owl:Restriction ;
            owl:onClass :Lot ;
            owl:onProperty :providesDecisionFor ;
            owl:qualifiedCardinality 1 ] .

:EvidenceSubmission rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :OfferingParty ;
            owl:onProperty :specifiesEconomicOperator ;
            owl:qualifiedCardinality 1 ],
        [ a owl:Restriction ;
            owl:onProperty :concernsLot ;
            owl:someValuesFrom :Lot ],
        [ a owl:Restriction ;
            owl:onClass :Procedure ;
            owl:onProperty :concernsProcedure ;
            owl:qualifiedCardinality 1 ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass :EvidenceRequest ;
            owl:onProperty :refersToEvidenceRequest ] .

