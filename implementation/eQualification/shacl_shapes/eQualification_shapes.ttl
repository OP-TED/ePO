@prefix : <http://data.europa.eu/a4g/ontology#> .
@prefix cccev: <http://data.europa.eu/m8g/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eli: <http://data.europa.eu/eli/ontology#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix qua-shape: <http://data.europa.eu/a4g/data-shape#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

qua-shape:epo-qua-EvidenceOutcomeShape a sh:NodeShape ;
    rdfs:label "Evidence Outcome" ;
    rdfs:comment "Result concerning the submitted Evidence." ;
    rdfs:isDefinedBy qua-shape:qua-shape ;
    sh:property qua-shape:epo-qua-EvidenceOutcome-epo-qua-fulfillsRequirement,
        qua-shape:epo-qua-EvidenceOutcome-epo-specifiesEvidence ;
    sh:targetClass :EvidenceOutcome .

qua-shape:epo-qua-EvidenceReceiptShape a sh:NodeShape ;
    rdfs:label "Evidence Receipt" ;
    rdfs:comment "A Document sent by the Buyer to the Economic Operator confirming the receival of an Evidence Submission." ;
    rdfs:isDefinedBy qua-shape:qua-shape ;
    sh:property qua-shape:epo-qua-EvidenceReceipt-epo-qua-refersToEvidenceSubmission ;
    sh:targetClass :EvidenceReceipt .

qua-shape:epo-qua-EvidenceRequestShape a sh:NodeShape ;
    rdfs:label "Evidence Request" ;
    rdfs:comment "A Document sent by the Buyer to the Economic Operator asking for the submission of an Evidence." ;
    rdfs:isDefinedBy qua-shape:qua-shape ;
    sh:property qua-shape:epo-qua-EvidenceRequest-epo-concernsLot,
        qua-shape:epo-qua-EvidenceRequest-epo-concernsProcedure,
        qua-shape:epo-qua-EvidenceRequest-epo-specifiesEconomicOperator ;
    sh:targetClass :EvidenceRequest .

qua-shape:epo-qua-EvidenceSubmissionShape a sh:NodeShape ;
    rdfs:label "Evidence Submission" ;
    rdfs:comment "A Document sent by the Economic Operator to the Buyer which contains an Evidence." ;
    rdfs:isDefinedBy qua-shape:qua-shape ;
    sh:property qua-shape:epo-qua-EvidenceSubmission-epo-concernsLot,
        qua-shape:epo-qua-EvidenceSubmission-epo-concernsProcedure,
        qua-shape:epo-qua-EvidenceSubmission-epo-providesEvidence,
        qua-shape:epo-qua-EvidenceSubmission-epo-qua-refersToEvidenceRequest,
        qua-shape:epo-qua-EvidenceSubmission-epo-specifiesEconomicOperator ;
    sh:targetClass :EvidenceSubmission .

qua-shape:epo-qua-QualificationDecisionInformationShape a sh:NodeShape ;
    rdfs:label "Qualification Decision Information" ;
    rdfs:comment "Information about the aggregated result of the Evidence Outcomes." ;
    rdfs:isDefinedBy qua-shape:qua-shape ;
    sh:property qua-shape:epo-qua-QualificationDecisionInformation-epo-hasQualificationDecisionDate,
        qua-shape:epo-qua-QualificationDecisionInformation-epo-hasRejectionDescription,
        qua-shape:epo-qua-QualificationDecisionInformation-epo-isQualified,
        qua-shape:epo-qua-QualificationDecisionInformation-epo-qua-comprisesEvidenceOutcome,
        qua-shape:epo-qua-QualificationDecisionInformation-epo-qua-providesDecisionFor,
        qua-shape:epo-qua-QualificationDecisionInformation-epo-qua-summarisesInformationForQualificationResponse ;
    sh:targetClass :QualificationDecisionInformation .

qua-shape:epo-qua-QualificationReponseShape a sh:NodeShape ;
    rdfs:label "Qualification Reponse" ;
    rdfs:comment "A formal reply from the Buyer to the Economic Operator informing the Economic Operator that it may participate in a procurement." ;
    rdfs:isDefinedBy qua-shape:qua-shape ;
    sh:property qua-shape:epo-qua-QualificationReponse-epo-qua-refersToEvidenceSubmission ;
    sh:targetClass :QualificationReponse .

qua-shape:epo-qua-EvidenceOutcome-epo-qua-fulfillsRequirement a sh:PropertyShape ;
    rdfs:isDefinedBy qua-shape:qua-shape ;
    sh:datatype xsd:boolean ;
    sh:description "Indicates whether the Requirement is satisfied." ;
    sh:maxCount 1 ;
    sh:name "Fulfills requirement" ;
    sh:path :fulfillsRequirement .

qua-shape:epo-qua-EvidenceOutcome-epo-specifiesEvidence a sh:PropertyShape ;
    rdfs:isDefinedBy qua-shape:qua-shape ;
    sh:class cccev:Evidence ;
    sh:description "Relation indicating the Evidence." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Specifies evidence" ;
    sh:path :specifiesEvidence ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#specifiesEvidence> ?that . ?that <http://data.europa.eu/a4g/ontology#specifiesEvidence> ?this .}" ] .

qua-shape:epo-qua-EvidenceReceipt-epo-qua-refersToEvidenceSubmission a sh:PropertyShape ;
    rdfs:isDefinedBy qua-shape:qua-shape ;
    sh:class :EvidenceSubmission ;
    sh:description "Reference to an Evidence Submission." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Refers to evidence submission" ;
    sh:path :refersToEvidenceSubmission ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#refersToEvidenceSubmission> ?that . ?that <http://data.europa.eu/a4g/ontology#refersToEvidenceSubmission> ?this .}" ] .

qua-shape:epo-qua-EvidenceRequest-epo-concernsLot a sh:PropertyShape ;
    rdfs:isDefinedBy qua-shape:qua-shape ;
    sh:class :Lot ;
    sh:description "Relates to Lot." ;
    sh:minCount 1 ;
    sh:name "Concerns lot" ;
    sh:path :concernsLot ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#concernsLot> ?that . ?that <http://data.europa.eu/a4g/ontology#concernsLot> ?this .}" ] .

qua-shape:epo-qua-EvidenceRequest-epo-concernsProcedure a sh:PropertyShape ;
    rdfs:isDefinedBy qua-shape:qua-shape ;
    sh:class :Procedure ;
    sh:description "Relates to Procedure." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Concerns procedure" ;
    sh:path :concernsProcedure ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#concernsProcedure> ?that . ?that <http://data.europa.eu/a4g/ontology#concernsProcedure> ?this .}" ] .

qua-shape:epo-qua-EvidenceRequest-epo-specifiesEconomicOperator a sh:PropertyShape ;
    rdfs:isDefinedBy qua-shape:qua-shape ;
    sh:class :OfferingParty ;
    sh:description "Relation indicating that the instance of the concept involves the Economic Operator." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Specifies economic operator" ;
    sh:path :specifiesEconomicOperator ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#specifiesEconomicOperator> ?that . ?that <http://data.europa.eu/a4g/ontology#specifiesEconomicOperator> ?this .}" ] .

qua-shape:epo-qua-EvidenceSubmission-epo-concernsLot a sh:PropertyShape ;
    rdfs:isDefinedBy qua-shape:qua-shape ;
    sh:class :Lot ;
    sh:description "Relates to Lot." ;
    sh:minCount 1 ;
    sh:name "Concerns lot" ;
    sh:path :concernsLot ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#concernsLot> ?that . ?that <http://data.europa.eu/a4g/ontology#concernsLot> ?this .}" ] .

qua-shape:epo-qua-EvidenceSubmission-epo-concernsProcedure a sh:PropertyShape ;
    rdfs:isDefinedBy qua-shape:qua-shape ;
    sh:class :Procedure ;
    sh:description "Relates to Procedure." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Concerns procedure" ;
    sh:path :concernsProcedure ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#concernsProcedure> ?that . ?that <http://data.europa.eu/a4g/ontology#concernsProcedure> ?this .}" ] .

qua-shape:epo-qua-EvidenceSubmission-epo-providesEvidence a sh:PropertyShape ;
    rdfs:isDefinedBy qua-shape:qua-shape ;
    sh:class cccev:Evidence ;
    sh:description "Makes available the Evidence." ;
    sh:name "Provides evidence" ;
    sh:path :providesEvidence ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#providesEvidence> ?that . ?that <http://data.europa.eu/a4g/ontology#providesEvidence> ?this .}" ] .

qua-shape:epo-qua-EvidenceSubmission-epo-qua-refersToEvidenceRequest a sh:PropertyShape ;
    rdfs:isDefinedBy qua-shape:qua-shape ;
    sh:class :EvidenceRequest ;
    sh:description "Reference to an Evidence Request." ;
    sh:maxCount 1 ;
    sh:name "Refers to evidence request" ;
    sh:path :refersToEvidenceRequest ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#refersToEvidenceRequest> ?that . ?that <http://data.europa.eu/a4g/ontology#refersToEvidenceRequest> ?this .}" ] .

qua-shape:epo-qua-EvidenceSubmission-epo-specifiesEconomicOperator a sh:PropertyShape ;
    rdfs:isDefinedBy qua-shape:qua-shape ;
    sh:class :OfferingParty ;
    sh:description "Relation indicating that the instance of the concept involves the Economic Operator." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Specifies economic operator" ;
    sh:path :specifiesEconomicOperator ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#specifiesEconomicOperator> ?that . ?that <http://data.europa.eu/a4g/ontology#specifiesEconomicOperator> ?this .}" ] .

qua-shape:epo-qua-QualificationDecisionInformation-epo-hasQualificationDecisionDate a sh:PropertyShape ;
    rdfs:isDefinedBy qua-shape:qua-shape ;
    sh:datatype xsd:dateTime ;
    sh:description "The official date of the Qualification Decision." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Has qualification decision date" ;
    sh:path :hasQualificationDecisionDate .

qua-shape:epo-qua-QualificationDecisionInformation-epo-hasRejectionDescription a sh:PropertyShape ;
    rdfs:isDefinedBy qua-shape:qua-shape ;
    sh:description "Explanatory text about the rejection reason." ;
    sh:maxCount 1 ;
    sh:name "Has rejection description" ;
    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
    sh:path :hasRejectionDescription .

qua-shape:epo-qua-QualificationDecisionInformation-epo-isQualified a sh:PropertyShape ;
    rdfs:isDefinedBy qua-shape:qua-shape ;
    sh:datatype xsd:boolean ;
    sh:description "Indicates whether the economic operator is eligible." ;
    sh:maxCount 1 ;
    sh:name "Is qualified" ;
    sh:path :isQualified .

qua-shape:epo-qua-QualificationDecisionInformation-epo-qua-comprisesEvidenceOutcome a sh:PropertyShape ;
    rdfs:isDefinedBy qua-shape:qua-shape ;
    sh:class :EvidenceOutcome ;
    sh:description "Incorporates Evidence Outcome." ;
    sh:name "Comprises evidence outcome" ;
    sh:path :comprisesEvidenceOutcome ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#comprisesEvidenceOutcome> ?that . ?that <http://data.europa.eu/a4g/ontology#comprisesEvidenceOutcome> ?this .}" ] .

qua-shape:epo-qua-QualificationDecisionInformation-epo-qua-providesDecisionFor a sh:PropertyShape ;
    rdfs:isDefinedBy qua-shape:qua-shape ;
    sh:class :Lot ;
    sh:description "Makes available the resolution." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Provides decision for" ;
    sh:path :providesDecisionFor ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#providesDecisionFor> ?that . ?that <http://data.europa.eu/a4g/ontology#providesDecisionFor> ?this .}" ] .

qua-shape:epo-qua-QualificationDecisionInformation-epo-qua-summarisesInformationForQualificationResponse a sh:PropertyShape ;
    rdfs:isDefinedBy qua-shape:qua-shape ;
    sh:class :QualificationReponse ;
    sh:description "Relation indicating the Qualification Response that the information refers to." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Summarises information for qualification response" ;
    sh:path :summarisesInformationForQualificationResponse ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#summarisesInformationForQualificationResponse> ?that . ?that <http://data.europa.eu/a4g/ontology#summarisesInformationForQualificationResponse> ?this .}" ] .

qua-shape:epo-qua-QualificationReponse-epo-qua-refersToEvidenceSubmission a sh:PropertyShape ;
    rdfs:isDefinedBy qua-shape:qua-shape ;
    sh:class :EvidenceSubmission ;
    sh:description "Reference to an Evidence Submission." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Refers to evidence submission" ;
    sh:path :refersToEvidenceSubmission ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#refersToEvidenceSubmission> ?that . ?that <http://data.europa.eu/a4g/ontology#refersToEvidenceSubmission> ?this .}" ] .

