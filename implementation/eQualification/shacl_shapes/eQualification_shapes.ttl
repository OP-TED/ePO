    rdfs:label "eProcurement Ontology Qualification - core shapes"@en ;
    dcterms:created "2021-06-01"^^xsd:date ;
    dcterms:description "The eProcurement Ontology Qualification core shapes provides the generic datashape specifications for the eProcurement Ontology Qualification core."@en ;
