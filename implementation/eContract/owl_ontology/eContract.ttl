@prefix : <http://data.europa.eu/a4g/ontology#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:ContractAmendment a owl:Class ;
    rdfs:isDefinedBy :con ;
    rdfs:subClassOf :Contract ;
    skos:definition "A change to an existing Contract that is agreed by the contracting parties."@en ;
    skos:prefLabel "Contract Amendment"@en .

:ContractModificationInformation a owl:Class ;
    rdfs:isDefinedBy :con ;
    rdfs:subClassOf :ContextDescription ;
    skos:prefLabel "Contract Modification Information"@en .

:Deliverable a owl:Class ;
    rdfs:isDefinedBy :con ;
    rdfs:subClassOf :AbstractItem ;
    skos:prefLabel "Deliverable"@en .

:amendsContract a owl:ObjectProperty ;
    rdfs:isDefinedBy :con ;
    skos:prefLabel "amends Contract"@en .

:announcesContractAmendment a owl:ObjectProperty ;
    rdfs:isDefinedBy :con ;
    skos:prefLabel "announces Contract Amendment"@en .

:concernsContractAmendment a owl:ObjectProperty ;
    rdfs:isDefinedBy :con ;
    skos:prefLabel "concerns Contract Amendment"@en .

:hasModificationDescription a owl:DatatypeProperty ;
    rdfs:isDefinedBy :con ;
    skos:definition "An explanatory text about this context. (epo-con:ContractModificationInformation)"@en ;
    skos:editorialNote "Used by eForms BT-202, TEDXML F20 VII.2.1"@en ;
    skos:historyNote "WG Approval 5/11/2019"@en ;
    skos:prefLabel "has Modification Description"@en .

:hasModificationJustification a owl:ObjectProperty ;
    rdfs:isDefinedBy :con ;
    skos:definition "Explanation of why a contract was modified. The codelist to be used is at-voc:modification-justification which is available at http://publications.europa.eu/resource/dataset/modification-justification"@en ;
    skos:prefLabel "has Modification Justification"@en .

:hasModificationReasonDescription a owl:DatatypeProperty ;
    rdfs:isDefinedBy :con ;
    skos:definition "An explanation about the reasons for using the concept. (epo-con:ContractModificationInformation)"@en ;
    skos:editorialNote "Used by eForms BT-201, TEDXML F20 VII.2.2.2, TEDXML F20 VII.2.2.4"@en ;
    skos:historyNote "WG Approval 05/11/2019"@en ;
    skos:prefLabel "has Modification Reason Description"@en .

:hasQuantity a owl:ObjectProperty ;
    rdfs:isDefinedBy :con ;
    skos:prefLabel "has Quantity"@en .

:hasTotalValue a owl:ObjectProperty ;
    rdfs:isDefinedBy :con ;
    skos:prefLabel "has Total Value"@en .

:relatesToEFormSectionIdentifier a owl:ObjectProperty ;
    rdfs:isDefinedBy :con ;
    skos:prefLabel "relates To E Form Section Identifier"@en .

:specifiesDeliverable a owl:ObjectProperty ;
    rdfs:isDefinedBy :con ;
    skos:prefLabel "specifies Deliverable"@en .

:updatesContractValue a owl:ObjectProperty ;
    rdfs:isDefinedBy :con ;
    skos:prefLabel "updates Contract Value"@en .

:con a owl:Ontology ;
    rdfs:label """This artefact provides the definitions for the eProcurement Ontology Core.
        This artefact excludes the restrictions.
        The eProcurement Ontology describes objects and concepts, with definitions, attributes and relationships which are present within the European public procurement domain.
        The provision of these concepts provides the basis for a common understanding of the domain for all stakeholders ensuring the quality of data exchange and transparency."""@en ;
    dcterms:created "2025-09-04"^^xsd:date ;
    dcterms:description """This artefact provides the definitions for the eProcurement Ontology Core.
        This artefact excludes the restrictions.
        The eProcurement Ontology describes objects and concepts, with definitions, attributes and relationships which are present within the European public procurement domain.
        The provision of these concepts provides the basis for a common understanding of the domain for all stakeholders ensuring the quality of data exchange and transparency."""@en ;
    dcterms:issued "2025-09-04"^^xsd:date ;
    dcterms:license "CC BY 4.0" ;
    dcterms:publisher "http://publications.europa.eu/resource/authority/corporate-body/PUBL" ;
    dcterms:title "ePO Core core"@en ;
    vann:preferredNamespacePrefix "epo" ;
    vann:preferredNamespaceUri "http://data.europa.eu/a4g/ontology#" ;
    rdfs:comment "This version is automatically generated from eContract.xml on 2025-10-15" ;
    rdfs:seeAlso <https://docs.ted.europa.eu/EPO/latest/index.html>,
        <https://github.com/eprocurementontology/eprocurementontology>,
        <https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology/about>,
        <https://op.europa.eu/en/web/eu-vocabularies/e-procurement> ;
    owl:imports dcterms:,
        skos:,
        <http://www.w3.org/ns/adms>,
        <https://data.europa.eu/m8g> ;
    owl:incompatibleWith "2.1.0" ;
    owl:priorVersion "http://data.europa.eu/a4g/ontology#con-3.0.1" ;
    owl:versionIRI :con-3.1.0 ;
    owl:versionInfo "3.1.0" .

