@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix epo: <http://data.europa.eu/a4g/ontology#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

epo:ContractAmendment a owl:Class ;
    rdfs:isDefinedBy epo:con ;
    rdfs:subClassOf epo:Contract ;
    skos:definition "A change to an existing Contract that is agreed by the contracting parties."@en ;
    skos:prefLabel "Contract Amendment"@en .

epo:ContractModificationInformation a owl:Class ;
    rdfs:isDefinedBy epo:con ;
    rdfs:subClassOf epo:ContextDescription ;
    skos:prefLabel "Contract Modification Information"@en .

epo:Deliverable a owl:Class ;
    rdfs:isDefinedBy epo:con ;
    rdfs:subClassOf epo:AbstractItem ;
    skos:prefLabel "Deliverable"@en .

epo:amendsContract a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:con ;
    skos:prefLabel "amends Contract"@en .

epo:announcesContractAmendment a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:con ;
    skos:prefLabel "announces Contract Amendment"@en .

epo:concernsContractAmendment a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:con ;
    skos:prefLabel "concerns Contract Amendment"@en .

epo:hasModificationDescription a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:con ;
    skos:definition "An explanatory text about this context. (epo-con:ContractModificationInformation)"@en ;
    skos:editorialNote "Used by eForms BT-202, TEDXML F20 VII.2.1"@en ;
    skos:historyNote "WG Approval 5/11/2019"@en ;
    skos:prefLabel "has Modification Description"@en .

epo:hasModificationJustification a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:con ;
    skos:definition "Explanation of why a contract was modified. The codelist to be used is at-voc:modification-justification which is available at http://publications.europa.eu/resource/dataset/modification-justification"@en ;
    skos:prefLabel "has Modification Justification"@en .

epo:hasModificationReasonDescription a owl:DatatypeProperty ;
    rdfs:isDefinedBy epo:con ;
    skos:definition "An explanation about the reasons for using the concept. (epo-con:ContractModificationInformation)"@en ;
    skos:editorialNote "Used by eForms BT-201, TEDXML F20 VII.2.2.2, TEDXML F20 VII.2.2.4"@en ;
    skos:historyNote "WG Approval 05/11/2019"@en ;
    skos:prefLabel "has Modification Reason Description"@en .

epo:hasQuantity a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:con ;
    skos:prefLabel "has Quantity"@en .

epo:hasTotalValue a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:con ;
    skos:prefLabel "has Total Value"@en .

epo:relatesToEFormSectionIdentifier a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:con ;
    skos:prefLabel "relates To E Form Section Identifier"@en .

epo:specifiesDeliverable a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:con ;
    skos:prefLabel "specifies Deliverable"@en .

epo:updatesContractValue a owl:ObjectProperty ;
    rdfs:isDefinedBy epo:con ;
    skos:prefLabel "updates Contract Value"@en .

epo:con a owl:Ontology ;
    rdfs:label "eProcurement Ontology Contract - core"@en ;
    dcterms:created "2021-06-01"^^xsd:date ;
    dcterms:description "The eProcurement Ontology Contract core describes the concepts and properties representing the European Public Procurement Contract domain. The provision of these semantics offers the basis for a common understanding of the domain for all stakeholders ensuring the quality of data exchange and transparency. The ontology restrictions are published in a separate artefact."@en ;
    dcterms:issued "2025-05-15"^^xsd:date ;
    dcterms:license "© European Union, 2014. Unless otherwise noted, the reuse of the Ontology is authorised under the European Union Public Licence v1.2 (https://eupl.eu/)." ;
    dcterms:publisher "http://publications.europa.eu/resource/authority/corporate-body/PUBL" ;
    dcterms:title "eProcurement Ontology Contract - core"@en ;
    vann:preferredNamespacePrefix "epo" ;
    vann:preferredNamespaceUri "http://data.europa.eu/a4g/ontology#" ;
    rdfs:comment "This version is automatically generated from eContract.xml on 2025-05-15" ;
    rdfs:seeAlso <https://docs.ted.europa.eu/home/index.html>,
        <https://github.com/OP-TED/ePO/releases>,
        <https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology/about>,
        <https://op.europa.eu/en/web/eu-vocabularies/e-procurement> ;
    owl:imports epo:cat,
        epo:core,
        epo:not,
        <http://data.europa.eu/eli/ontology#>,
        <http://data.europa.eu/m8g/>,
        dcterms:,
        skos:,
        <http://www.w3.org/2006/time>,
        <http://www.w3.org/ns/adms>,
        <http://www.w3.org/ns/locn>,
        org:,
        <http://www.w3.org/ns/person> ;
    owl:incompatibleWith "4.2.0" ;
    owl:priorVersion "http://data.europa.eu/a4g/ontology#con-4.2.0" ;
    owl:versionIRI epo:con-5.0.0 ;
    owl:versionInfo "5.0.0" .

