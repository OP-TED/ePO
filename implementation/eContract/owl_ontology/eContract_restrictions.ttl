@prefix : <http://data.europa.eu/a4g/ontology#> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:con-restriction a owl:Ontology ;
    rdfs:label """This artefact provides the restrictions and inference-related specifications for the eProcurement Ontology Core.
        This artefact excludes the definitions of concepts.
        The eProcurement Ontology describes objects and concepts, with definitions, attributes and relationships which are present within the European public procurement domain.
        The provision of these concepts provides the basis for a common understanding of the domain for all stakeholders ensuring the quality of data exchange and transparency."""@en ;
    dcterms:created "2025-09-04"^^xsd:date ;
    dcterms:description """This artefact provides the restrictions and inference-related specifications for the eProcurement Ontology Core.
        This artefact excludes the definitions of concepts.
        The eProcurement Ontology describes objects and concepts, with definitions, attributes and relationships which are present within the European public procurement domain.
        The provision of these concepts provides the basis for a common understanding of the domain for all stakeholders ensuring the quality of data exchange and transparency."""@en ;
    dcterms:issued "2025-09-04"^^xsd:date ;
    dcterms:license "CC BY 4.0" ;
    dcterms:publisher "http://publications.europa.eu/resource/authority/corporate-body/PUBL" ;
    dcterms:title "ePO Core restrictions"@en ;
    vann:preferredNamespacePrefix "epo" ;
    vann:preferredNamespaceUri "http://data.europa.eu/a4g/ontology#" ;
    rdfs:comment """This version is automatically generated from eContract.xml on 
                2025-10-15""" ;
    rdfs:seeAlso <https://docs.ted.europa.eu/EPO/latest/index.html>,
        <https://github.com/eprocurementontology/eprocurementontology>,
        <https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology/about>,
        <https://op.europa.eu/en/web/eu-vocabularies/e-procurement> ;
    owl:imports :con,
        dcterms:,
        skos:,
        <http://www.w3.org/ns/adms>,
        <https://data.europa.eu/m8g> ;
    owl:incompatibleWith "2.1.0" ;
    owl:priorVersion "http://data.europa.eu/a4g/ontology#con-restriction-3.0.1" ;
    owl:versionIRI :con-restriction-3.1.0 ;
    owl:versionInfo "3.1.0" .

:hasModificationJustification a owl:FunctionalProperty ;
    rdfs:domain :ContractModificationInformation ;
    rdfs:range skos:Concept .

:relatesToEFormSectionIdentifier rdfs:domain :ContractModificationInformation ;
    rdfs:range adms:Identifier .

:specifiesDeliverable rdfs:domain :Contract ;
    rdfs:range :Deliverable .

:ContractModificationNotice rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :ContractAmendment ;
            owl:onProperty :announcesContractAmendment ;
            owl:qualifiedCardinality 1 ] .

:amendsContract a owl:FunctionalProperty ;
    rdfs:domain :ContractAmendment ;
    rdfs:range :Contract .

:announcesContractAmendment a owl:FunctionalProperty ;
    rdfs:domain :ContractModificationNotice ;
    rdfs:range :ContractAmendment .

:concernsContractAmendment a owl:FunctionalProperty ;
    rdfs:domain :ContractModificationInformation ;
    rdfs:range :ContractAmendment .

:hasModificationDescription rdfs:domain :ContractModificationInformation ;
    rdfs:range rdf:PlainLiteral .

:hasModificationReasonDescription rdfs:domain :ContractModificationInformation ;
    rdfs:range rdf:PlainLiteral .

:hasQuantity rdfs:domain :Deliverable ;
    rdfs:range :Quantity .

:hasTotalValue rdfs:domain :Deliverable ;
    rdfs:range :MonetaryValue .

:updatesContractValue rdfs:domain :ContractAmendment ;
    rdfs:range :MonetaryValue .

:Deliverable rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :hasTotalValue ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass :Quantity ;
            owl:onProperty :hasQuantity ] .

:ContractModificationInformation rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :ContractAmendment ;
            owl:onProperty :concernsContractAmendment ;
            owl:qualifiedCardinality 1 ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty :hasModificationReasonDescription ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onDataRange rdf:PlainLiteral ;
            owl:onProperty :hasModificationDescription ] .

:ContractAmendment rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass :MonetaryValue ;
            owl:onProperty :updatesContractValue ],
        [ a owl:Restriction ;
            owl:onClass :Contract ;
            owl:onProperty :amendsContract ;
            owl:qualifiedCardinality 1 ] .

