@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix epo: <http://data.europa.eu/a4g/ontology#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

epo:con-restriction a owl:Ontology ;
    rdfs:label "eProcurement Ontology Contract - core restrictions"@en ;
    dcterms:created "2021-06-01"^^xsd:date ;
    dcterms:description "The eProcurement Ontology Contract core restrictions provides the restrictions and the inference-related specifications on the concepts and properties in the eProcurement Ontology Contract core."@en ;
    dcterms:issued "2025-05-15"^^xsd:date ;
    dcterms:license "© European Union, 2014. Unless otherwise noted, the reuse of the Ontology is authorised under the European Union Public Licence v1.2 (https://eupl.eu/)." ;
    dcterms:publisher "http://publications.europa.eu/resource/authority/corporate-body/PUBL" ;
    dcterms:title "eProcurement Ontology Contract - core restrictions"@en ;
    vann:preferredNamespacePrefix "epo" ;
    vann:preferredNamespaceUri "http://data.europa.eu/a4g/ontology#" ;
    rdfs:comment """This version is automatically generated from eContract.xml on 
                2025-05-15""" ;
    rdfs:seeAlso <https://docs.ted.europa.eu/home/index.html>,
        <https://github.com/OP-TED/ePO/releases>,
        <https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology/about>,
        <https://op.europa.eu/en/web/eu-vocabularies/e-procurement> ;
    owl:imports epo:cat,
        epo:con,
        epo:core,
        epo:not,
        <http://data.europa.eu/eli/ontology#>,
        <http://data.europa.eu/m8g/>,
        dcterms:,
        skos:,
        <http://www.w3.org/2006/time>,
        <http://www.w3.org/ns/adms>,
        <http://www.w3.org/ns/locn>,
        org:,
        <http://www.w3.org/ns/person> ;
    owl:incompatibleWith "4.2.0" ;
    owl:priorVersion "http://data.europa.eu/a4g/ontology#con-restriction-4.2.0" ;
    owl:versionIRI epo:con-restriction-5.0.0 ;
    owl:versionInfo "5.0.0" .

epo:hasModificationJustification rdfs:domain epo:ContractModificationInformation ;
    rdfs:range skos:Concept .

epo:relatesToEFormSectionIdentifier rdfs:domain epo:ContractModificationInformation ;
    rdfs:range adms:Identifier .

epo:specifiesDeliverable rdfs:domain epo:Contract ;
    rdfs:range epo:Deliverable .

epo:ContractModificationNotice rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:announcesContractAmendment ] .

epo:amendsContract a owl:FunctionalProperty ;
    rdfs:domain epo:ContractAmendment ;
    rdfs:range epo:Contract .

epo:announcesContractAmendment a owl:FunctionalProperty ;
    rdfs:domain epo:ContractModificationNotice ;
    rdfs:range epo:ContractAmendment .

epo:concernsContractAmendment a owl:FunctionalProperty ;
    rdfs:domain epo:ContractModificationInformation ;
    rdfs:range epo:ContractAmendment .

epo:hasModificationDescription rdfs:domain epo:ContractModificationInformation ;
    rdfs:range rdf:PlainLiteral .

epo:hasModificationReasonDescription rdfs:domain epo:ContractModificationInformation ;
    rdfs:range rdf:PlainLiteral .

epo:hasQuantity rdfs:domain epo:Deliverable ;
    rdfs:range epo:Quantity .

epo:hasTotalValue rdfs:domain epo:Deliverable ;
    rdfs:range epo:MonetaryValue .

epo:updatesContractValue rdfs:domain epo:ContractAmendment ;
    rdfs:range epo:MonetaryValue .

epo:Deliverable rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:hasTotalValue ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:hasQuantity ] .

epo:ContractAmendment rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:updatesContractValue ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:amendsContract ] .

epo:ContractModificationInformation rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:hasModificationDescription ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:concernsContractAmendment ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:hasModificationReasonDescription ] .

