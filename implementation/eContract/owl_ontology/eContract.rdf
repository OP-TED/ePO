    <owl:imports rdf:resource="http://data.europa.eu/eli/ontology#"/>
    <dcterms:title xml:lang="en">eProcurement Ontology Contract - core</dcterms:title>
    <rdfs:label xml:lang="en">eProcurement Ontology Contract - core</rdfs:label>
    <dcterms:description xml:lang="en">The eProcurement Ontology Contract core describes the concepts and properties representing the European Public Procurement Contract domain. The provision of these semantics offers the basis for a common understanding of the domain for all stakeholders ensuring the quality of data exchange and transparency. The ontology restrictions are published in a separate artefact.</dcterms:description>
    <dcterms:publisher>http://publications.europa.eu/resource/authority/corporate-body/PUBL</dcterms:publisher>
    <rdfs:comment>This version is automatically generated from eContract.xml on 2025-10-10</rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://github.com/OP-TED/ePO/releases"/>
    <rdfs:seeAlso rdf:resource="https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology/about"/>
    <rdfs:seeAlso rdf:resource="https://op.europa.eu/en/web/eu-vocabularies/e-procurement"/>
    <rdfs:seeAlso rdf:resource="https://docs.ted.europa.eu/home/index.html"/>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-10-10</dcterms:issued>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-06-01</dcterms:created>
    <owl:versionInfo>5.2.0</owl:versionInfo>
    <owl:incompatibleWith>4.2.0</owl:incompatibleWith>
    <owl:versionIRI rdf:resource="http://data.europa.eu/a4g/ontology#con-5.2.0"/>
    <owl:priorVersion>http://data.europa.eu/a4g/ontology#con-5.1.0</owl:priorVersion>
    <vann:preferredNamespaceUri>http://data.europa.eu/a4g/ontology#</vann:preferredNamespaceUri>
    <vann:preferredNamespacePrefix>epo</vann:preferredNamespacePrefix>
    <dcterms:license>© European Union, 2014. Unless otherwise noted, the reuse of the Ontology is authorised under the European Union Public Licence v1.2 (https://eupl.eu/).</dcterms:license>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#ContractAmendment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">Contract Amendment</skos:prefLabel>
    <skos:definition xml:lang="en">A change to an existing Contract that is agreed by the contracting parties.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#con"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Contract"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#announcesContractAmendment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">announces Contract Amendment</skos:prefLabel>
    <skos:definition xml:lang="en">Relation indicating the formal communication of a Contract Amendment.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#con"/>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#specifiesDeliverable">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">specifies Deliverable</skos:prefLabel>
    <skos:definition xml:lang="en">Relation indicating the Deliverable.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#con"/>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#amendsContract">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">amends Contract</skos:prefLabel>
    <skos:definition xml:lang="en">Modifies or changes the terms of an existing Contract.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#con"/>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#updatesContractValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">updates Contract Value</skos:prefLabel>
    <skos:definition xml:lang="en">Changes the Contract Monetary Value.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#con"/>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#concernsContractAmendment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">concerns Contract Amendment</skos:prefLabel>
    <skos:definition xml:lang="en">Relates to Contract Amendment.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#con"/>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasModificationJustification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">has Modification Justification</skos:prefLabel>
    <skos:definition xml:lang="en">Explanation of why a contract was modified. The codelist to be used is at-voc:modification-justification which is available at http://publications.europa.eu/resource/dataset/modification-justification</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#con"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#relatesToEFormSectionIdentifier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">relates To E Form Section Identifier</skos:prefLabel>
    <skos:definition xml:lang="en">Is about a specific eForms section.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#con"/>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#ContractModificationInformation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">Contract Modification Information</skos:prefLabel>
    <skos:definition xml:lang="en">Information about a Contract Amendment.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#con"/>
    <skos:historyNote xml:lang="en">WG approval 11/09/2025</skos:historyNote>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#ContextDescription"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasTotalValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">has Total Value</skos:prefLabel>
    <skos:definition xml:lang="en">Relation indicating the overall Monetary Value.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#con"/>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#Deliverable">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">Deliverable</skos:prefLabel>
    <skos:definition xml:lang="en">Item that the supplier is obligated to provide under a contract.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#con"/>
    <skos:historyNote xml:lang="en">WG approval 11/09/2025</skos:historyNote>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#AbstractItem"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasQuantity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">has Quantity</skos:prefLabel>
    <skos:definition xml:lang="en">Relation indicating that the instance of the concept has a Quantity.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#con"/>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasModificationDescription">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel xml:lang="en">has Modification Description</skos:prefLabel>
    <skos:definition xml:lang="en">An explanatory text about this context. (epo-con:ContractModificationInformation)</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#con"/>
    <skos:historyNote xml:lang="en">WG Approval 5/11/2019</skos:historyNote>
    <skos:editorialNote xml:lang="en">Used by eForms BT-202, TEDXML F20 VII.2.1</skos:editorialNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasModificationReasonDescription">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel xml:lang="en">has Modification Reason Description</skos:prefLabel>
    <skos:definition xml:lang="en">An explanation about the reasons for using the concept. (epo-con:ContractModificationInformation)</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#con"/>
    <skos:historyNote xml:lang="en">WG Approval 05/11/2019</skos:historyNote>
    <skos:editorialNote xml:lang="en">Used by eForms BT-201, TEDXML F20 VII.2.2.2, TEDXML F20 VII.2.2.4</skos:editorialNote>
  </rdf:Description>
</rdf:RDF>
