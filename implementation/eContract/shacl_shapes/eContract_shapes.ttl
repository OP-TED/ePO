@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix epo: <http://data.europa.eu/a4g/ontology#> .
@prefix epo-shape: <http://data.europa.eu/a4g/data-shape#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

epo-shape:epo-Contract sh:property epo-shape:epo-Contract-epo-specifiesDeliverable .

epo-shape:epo-con-ContractAmendmentShape a sh:NodeShape ;
    rdfs:label "Contract Amendment" ;
    rdfs:comment "A change to an existing Contract that is agreed by the contracting parties." ;
    rdfs:isDefinedBy epo-shape:con-shape ;
    sh:property epo-shape:epo-con-ContractAmendment-epo-amendsContract,
        epo-shape:epo-con-ContractAmendment-epo-updatesContractValue ;
    sh:targetClass epo:ContractAmendment .

epo-shape:epo-con-ContractModificationInformationShape a sh:NodeShape ;
    rdfs:label "Contract Modification Information" ;
    rdfs:isDefinedBy epo-shape:con-shape ;
    sh:property epo-shape:epo-con-ContractModificationInformation-epo-concernsContractAmendment,
        epo-shape:epo-con-ContractModificationInformation-epo-hasModificationDescription,
        epo-shape:epo-con-ContractModificationInformation-epo-hasModificationJustification,
        epo-shape:epo-con-ContractModificationInformation-epo-hasModificationReasonDescription,
        epo-shape:epo-con-ContractModificationInformation-epo-relatesToEFormSectionIdentifier ;
    sh:targetClass epo:ContractModificationInformation .

epo-shape:epo-con-DeliverableShape a sh:NodeShape ;
    rdfs:label "Deliverable" ;
    rdfs:isDefinedBy epo-shape:con-shape ;
    sh:property epo-shape:epo-con-Deliverable-epo-cat-hasQuantity,
        epo-shape:epo-con-Deliverable-epo-hasTotalValue ;
    sh:targetClass epo:Deliverable .

epo-shape:epo-not-ContractModificationNotice sh:property epo-shape:epo-not-ContractModificationNotice-epo-announcesContractAmendment .

epo-shape:epo-Contract-epo-specifiesDeliverable a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:con-shape ;
    sh:class epo:Deliverable ;
    sh:name "Specifies deliverable" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:specifiesDeliverable ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#specifiesDeliverable> ?that . ?that <http://data.europa.eu/a4g/ontology#specifiesDeliverable> ?this .}" ] .

epo-shape:epo-con-ContractAmendment-epo-amendsContract a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:con-shape ;
    sh:class epo:Contract ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Amends contract" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:amendsContract ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#amendsContract> ?that . ?that <http://data.europa.eu/a4g/ontology#amendsContract> ?this .}" ] .

epo-shape:epo-con-ContractAmendment-epo-updatesContractValue a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:con-shape ;
    sh:class epo:MonetaryValue ;
    sh:maxCount 1 ;
    sh:name "Updates contract value" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:updatesContractValue ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#updatesContractValue> ?that . ?that <http://data.europa.eu/a4g/ontology#updatesContractValue> ?this .}" ] .

epo-shape:epo-con-ContractModificationInformation-epo-concernsContractAmendment a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:con-shape ;
    sh:class epo:ContractAmendment ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Concerns contract amendment" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:concernsContractAmendment ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#concernsContractAmendment> ?that . ?that <http://data.europa.eu/a4g/ontology#concernsContractAmendment> ?this .}" ] .

epo-shape:epo-con-ContractModificationInformation-epo-hasModificationDescription a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:con-shape ;
    sh:description "An explanatory text about this context." ;
    sh:maxCount 1 ;
    sh:name "Has modification description" ;
    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
    sh:path epo:hasModificationDescription .

epo-shape:epo-con-ContractModificationInformation-epo-hasModificationJustification a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:con-shape ;
    sh:description "Explanation of why a contract was modified. The codelist to be used is at-voc:modification-justification which is available at http://publications.europa.eu/resource/dataset/modification-justification" ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Has modification justification" ;
    sh:path epo:hasModificationJustification .

epo-shape:epo-con-ContractModificationInformation-epo-hasModificationReasonDescription a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:con-shape ;
    sh:description "An explanation about the reasons for using the concept." ;
    sh:maxCount 1 ;
    sh:name "Has modification reason description" ;
    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
    sh:path epo:hasModificationReasonDescription .

epo-shape:epo-con-ContractModificationInformation-epo-relatesToEFormSectionIdentifier a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:con-shape ;
    sh:class adms:Identifier ;
    sh:name "Relates to E form section identifier" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:relatesToEFormSectionIdentifier ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#relatesToEFormSectionIdentifier> ?that . ?that <http://data.europa.eu/a4g/ontology#relatesToEFormSectionIdentifier> ?this .}" ] .

epo-shape:epo-con-Deliverable-epo-cat-hasQuantity a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:con-shape ;
    sh:class epo:Quantity ;
    sh:maxCount 1 ;
    sh:name "Has quantity" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasQuantity ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasQuantity> ?that . ?that <http://data.europa.eu/a4g/ontology#hasQuantity> ?this .}" ] .

epo-shape:epo-con-Deliverable-epo-hasTotalValue a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:con-shape ;
    sh:class epo:MonetaryValue ;
    sh:maxCount 1 ;
    sh:name "Has total value" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:hasTotalValue ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasTotalValue> ?that . ?that <http://data.europa.eu/a4g/ontology#hasTotalValue> ?this .}" ] .

epo-shape:epo-not-ContractModificationNotice-epo-announcesContractAmendment a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:con-shape ;
    sh:class epo:ContractAmendment ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Announces contract amendment" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:announcesContractAmendment ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#announcesContractAmendment> ?that . ?that <http://data.europa.eu/a4g/ontology#announcesContractAmendment> ?this .}" ] .

epo-shape:con-shape a owl:Ontology ;
    rdfs:label "eProcurement Ontology Contract - core shapes"@en ;
    dcterms:created "2021-06-01"^^xsd:date ;
    dcterms:description "The eProcurement Ontology Contract core shapes provides the generic datashape specifications for the eProcurement Ontology Contract core."@en ;
    dcterms:issued "2025-06-04"^^xsd:date ;
    dcterms:license "© European Union, 2014. Unless otherwise noted, the reuse of the Ontology is authorised under the European Union Public Licence v1.2 (https://eupl.eu/)." ;
    dcterms:publisher "http://publications.europa.eu/resource/authority/corporate-body/PUBL" ;
    dcterms:title "eProcurement Ontology Contract - core shapes"@en ;
    vann:preferredNamespacePrefix "epo" ;
    vann:preferredNamespaceUri "http://data.europa.eu/a4g/ontology#" ;
    rdfs:comment "This version is automatically generated from eContract.xml on 2025-06-04" ;
    rdfs:seeAlso <https://docs.ted.europa.eu/home/index.html>,
        <https://github.com/OP-TED/ePO/releases>,
        <https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology/about>,
        <https://op.europa.eu/en/web/eu-vocabularies/e-procurement> ;
    owl:imports epo-shape:acc-shape,
        epo-shape:awa-shape,
        epo-shape:cat-shape,
        epo-shape:core-shape,
        epo-shape:eva-shape,
        epo-shape:ful-shape,
        epo-shape:inv-shape,
        epo-shape:not-shape,
        epo-shape:ord-shape,
        epo-shape:pay-shape,
        epo-shape:qua-shape,
        epo-shape:req-shape,
        epo-shape:sub-shape ;
    owl:incompatibleWith "4.2.0" ;
    owl:priorVersion "http://data.europa.eu/a4g/data-shape#con-shape-5.0.0" ;
    owl:versionIRI epo-shape:con-shape-5.1.0 ;
    owl:versionInfo "5.1.0" .

