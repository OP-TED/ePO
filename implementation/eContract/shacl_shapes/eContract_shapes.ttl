@prefix : <http://data.europa.eu/a4g/ontology#> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix con-shape: <http://data.europa.eu/a4g/data-shape#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

con-shape:epo-ContractShape sh:property con-shape:epo-Contract-epo-specifiesDeliverable .

con-shape:epo-con-ContractAmendmentShape a sh:NodeShape ;
    rdfs:label "Contract amendment" ;
    rdfs:comment "A change to an existing Contract that is agreed by the contracting parties." ;
    rdfs:isDefinedBy con-shape:con-shape ;
    sh:property con-shape:epo-con-ContractAmendment-epo-amendsContract,
        con-shape:epo-con-ContractAmendment-epo-updatesContractValue ;
    sh:targetClass :ContractAmendment .

con-shape:epo-con-ContractModificationInformationShape a sh:NodeShape ;
    rdfs:label "Contract modification information" ;
    rdfs:isDefinedBy con-shape:con-shape ;
    sh:property con-shape:epo-con-ContractModificationInformation-epo-concernsContractAmendment,
        con-shape:epo-con-ContractModificationInformation-epo-hasModificationDescription,
        con-shape:epo-con-ContractModificationInformation-epo-hasModificationJustification,
        con-shape:epo-con-ContractModificationInformation-epo-hasModificationReasonDescription,
        con-shape:epo-con-ContractModificationInformation-epo-relatesToEFormSectionIdentifier ;
    sh:targetClass :ContractModificationInformation .

con-shape:epo-con-DeliverableShape a sh:NodeShape ;
    rdfs:label "Deliverable" ;
    rdfs:isDefinedBy con-shape:con-shape ;
    sh:property con-shape:epo-con-Deliverable-epo-cat-hasQuantity,
        con-shape:epo-con-Deliverable-epo-hasTotalValue ;
    sh:targetClass :Deliverable .

con-shape:epo-not-ContractModificationNoticeShape sh:property con-shape:epo-not-ContractModificationNotice-epo-announcesContractAmendment .

con-shape:epo-Contract-epo-specifiesDeliverable a sh:PropertyShape ;
    rdfs:isDefinedBy con-shape:con-shape ;
    sh:class :Deliverable ;
    sh:name "Specifies deliverable" ;
    sh:path :specifiesDeliverable ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#specifiesDeliverable> ?that . ?that <http://data.europa.eu/a4g/ontology#specifiesDeliverable> ?this .}" ] .

con-shape:epo-con-ContractAmendment-epo-amendsContract a sh:PropertyShape ;
    rdfs:isDefinedBy con-shape:con-shape ;
    sh:class :Contract ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Amends contract" ;
    sh:path :amendsContract ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#amendsContract> ?that . ?that <http://data.europa.eu/a4g/ontology#amendsContract> ?this .}" ] .

con-shape:epo-con-ContractAmendment-epo-updatesContractValue a sh:PropertyShape ;
    rdfs:isDefinedBy con-shape:con-shape ;
    sh:class :MonetaryValue ;
    sh:maxCount 1 ;
    sh:name "Updates contract value" ;
    sh:path :updatesContractValue ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#updatesContractValue> ?that . ?that <http://data.europa.eu/a4g/ontology#updatesContractValue> ?this .}" ] .

con-shape:epo-con-ContractModificationInformation-epo-concernsContractAmendment a sh:PropertyShape ;
    rdfs:isDefinedBy con-shape:con-shape ;
    sh:class :ContractAmendment ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Concerns contract amendment" ;
    sh:path :concernsContractAmendment ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#concernsContractAmendment> ?that . ?that <http://data.europa.eu/a4g/ontology#concernsContractAmendment> ?this .}" ] .

con-shape:epo-con-ContractModificationInformation-epo-hasModificationDescription a sh:PropertyShape ;
    rdfs:isDefinedBy con-shape:con-shape ;
    sh:description "An explanatory text about this context." ;
    sh:maxCount 1 ;
    sh:name "Has modification description" ;
    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
    sh:path :hasModificationDescription .

con-shape:epo-con-ContractModificationInformation-epo-hasModificationJustification a sh:PropertyShape ;
    rdfs:isDefinedBy con-shape:con-shape ;
    sh:description "Explanation of why a contract was modified. The codelist to be used is at-voc:modification-justification which is available at http://publications.europa.eu/resource/dataset/modification-justification" ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Has modification justification" ;
    sh:path :hasModificationJustification .

con-shape:epo-con-ContractModificationInformation-epo-hasModificationReasonDescription a sh:PropertyShape ;
    rdfs:isDefinedBy con-shape:con-shape ;
    sh:description "An explanation about the reasons for using the concept." ;
    sh:maxCount 1 ;
    sh:name "Has modification reason description" ;
    sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
    sh:path :hasModificationReasonDescription .

con-shape:epo-con-ContractModificationInformation-epo-relatesToEFormSectionIdentifier a sh:PropertyShape ;
    rdfs:isDefinedBy con-shape:con-shape ;
    sh:class adms:Identifier ;
    sh:name "Relates to E form section identifier" ;
    sh:path :relatesToEFormSectionIdentifier ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#relatesToEFormSectionIdentifier> ?that . ?that <http://data.europa.eu/a4g/ontology#relatesToEFormSectionIdentifier> ?this .}" ] .

con-shape:epo-con-Deliverable-epo-cat-hasQuantity a sh:PropertyShape ;
    rdfs:isDefinedBy con-shape:con-shape ;
    sh:class :Quantity ;
    sh:maxCount 1 ;
    sh:name "Has quantity" ;
    sh:path :hasQuantity ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasQuantity> ?that . ?that <http://data.europa.eu/a4g/ontology#hasQuantity> ?this .}" ] .

con-shape:epo-con-Deliverable-epo-hasTotalValue a sh:PropertyShape ;
    rdfs:isDefinedBy con-shape:con-shape ;
    sh:class :MonetaryValue ;
    sh:maxCount 1 ;
    sh:name "Has total value" ;
    sh:path :hasTotalValue ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasTotalValue> ?that . ?that <http://data.europa.eu/a4g/ontology#hasTotalValue> ?this .}" ] .

con-shape:epo-not-ContractModificationNotice-epo-announcesContractAmendment a sh:PropertyShape ;
    rdfs:isDefinedBy con-shape:con-shape ;
    sh:class :ContractAmendment ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Announces contract amendment" ;
    sh:path :announcesContractAmendment ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#announcesContractAmendment> ?that . ?that <http://data.europa.eu/a4g/ontology#announcesContractAmendment> ?this .}" ] .

con-shape:con-shape a owl:Ontology ;
    rdfs:label """This artefact provides the generic datashape specifications for the eProcurement Ontology Core.
        The eProcurement Ontology describes objects and concepts, with definitions, attributes and relationships which are present within the European public procurement domain.
        The provision of these concepts provides the basis for a common understanding of the domain for all stakeholders ensuring the quality of data exchange and transparency."""@en ;
    dcterms:created "2025-09-04"^^xsd:date ;
    dcterms:description """This artefact provides the generic datashape specifications for the eProcurement Ontology Core.
        The eProcurement Ontology describes objects and concepts, with definitions, attributes and relationships which are present within the European public procurement domain.
        The provision of these concepts provides the basis for a common understanding of the domain for all stakeholders ensuring the quality of data exchange and transparency."""@en ;
    dcterms:issued "2025-09-04"^^xsd:date ;
    dcterms:license "CC BY 4.0" ;
    dcterms:publisher "http://publications.europa.eu/resource/authority/corporate-body/PUBL" ;
    dcterms:title "ePO Core shapes"@en ;
    vann:preferredNamespacePrefix "epo" ;
    vann:preferredNamespaceUri "http://data.europa.eu/a4g/ontology#" ;
    rdfs:comment "This version is automatically generated from eContract.xml on 2025-10-15" ;
    rdfs:seeAlso <https://docs.ted.europa.eu/EPO/latest/index.html>,
        <https://github.com/eprocurementontology/eprocurementontology>,
        <https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology/about>,
        <https://op.europa.eu/en/web/eu-vocabularies/e-procurement> ;
    owl:imports :con,
        :con-restriction,
        dcterms:,
        skos:,
        <http://www.w3.org/ns/adms>,
        <https://data.europa.eu/m8g> ;
    owl:incompatibleWith "2.1.0" ;
    owl:priorVersion "http://data.europa.eu/a4g/data-shape#con-shape-3.0.1" ;
    owl:versionIRI con-shape:con-shape-3.1.0 ;
    owl:versionInfo "3.1.0" .

