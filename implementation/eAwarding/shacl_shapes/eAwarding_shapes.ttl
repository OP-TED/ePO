@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix epo: <http://data.europa.eu/a4g/ontology#> .
@prefix epo-shape: <http://data.europa.eu/a4g/data-shape#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

epo-shape:epo-awa-AwardDecisionNotificationShape a sh:NodeShape ;
    rdfs:label "Award Decision Notification" ;
    rdfs:comment "A formal communication sent by the Buyer to inform Tenderers of the Award Decision." ;
    rdfs:isDefinedBy epo-shape:awa-shape ;
    sh:property epo-shape:epo-awa-AwardDecisionNotification-epo-awa-hasStandstillPeriodEndDate,
        epo-shape:epo-awa-AwardDecisionNotification-epo-concernsAwardOutcome,
        epo-shape:epo-awa-AwardDecisionNotification-epo-concernsProcedure,
        epo-shape:epo-awa-AwardDecisionNotification-epo-specifiesTenderer ;
    sh:targetClass epo:AwardDecisionNotification .

epo-shape:epo-awa-AwardDecisionNotification-epo-awa-hasStandstillPeriodEndDate a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:awa-shape ;
    sh:datatype xsd:date ;
    sh:description "The end date for the mandatory minimum time frame between the communication of a contract award decision and the formal conclusion of the contract, during which unsuccessful Tenderers have the opportunity to challenge the award before it becomes legally binding." ;
    sh:maxCount 1 ;
    sh:name "Has standstill period end date" ;
    sh:path epo:hasStandstillPeriodEndDate .

epo-shape:epo-awa-AwardDecisionNotification-epo-concernsAwardOutcome a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:awa-shape ;
    sh:class epo:AwardOutcome ;
    sh:description "Relates to Award Outcome." ;
    sh:minCount 1 ;
    sh:name "Concerns award outcome" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:concernsAwardOutcome ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#concernsAwardOutcome> ?that . ?that <http://data.europa.eu/a4g/ontology#concernsAwardOutcome> ?this .}" ] .

epo-shape:epo-awa-AwardDecisionNotification-epo-concernsProcedure a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:awa-shape ;
    sh:class epo:Procedure ;
    sh:description "Relates to Procedure." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Concerns procedure" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:concernsProcedure ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#concernsProcedure> ?that . ?that <http://data.europa.eu/a4g/ontology#concernsProcedure> ?this .}" ] .

epo-shape:epo-awa-AwardDecisionNotification-epo-specifiesTenderer a sh:PropertyShape ;
    rdfs:isDefinedBy epo-shape:awa-shape ;
    sh:class epo:Tenderer ;
    sh:description "Relation indicating that the instance of the concept involves the Tenderer." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Specifies tenderer" ;
    sh:nodeKind sh:IRI ;
    sh:path epo:specifiesTenderer ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#specifiesTenderer> ?that . ?that <http://data.europa.eu/a4g/ontology#specifiesTenderer> ?this .}" ] .

epo-shape:awa-shape a owl:Ontology ;
    rdfs:label "eProcurement Ontology Awarding - core shapes"@en ;
    dcterms:created "2021-06-01"^^xsd:date ;
    dcterms:description "The eProcurement Ontology Awarding core shapes provides the generic datashape specifications for the eProcurement Ontology Awarding core."@en ;
    dcterms:issued "2025-10-10"^^xsd:date ;
    dcterms:license "© European Union, 2014. Unless otherwise noted, the reuse of the Ontology is authorised under the European Union Public Licence v1.2 (https://eupl.eu/)." ;
    dcterms:publisher "http://publications.europa.eu/resource/authority/corporate-body/PUBL" ;
    dcterms:title "eProcurement Ontology Awarding - core shapes"@en ;
    vann:preferredNamespacePrefix "epo" ;
    vann:preferredNamespaceUri "http://data.europa.eu/a4g/ontology#" ;
    rdfs:comment "This version is automatically generated from eAwarding.xml on 2025-10-10" ;
    rdfs:seeAlso <https://docs.ted.europa.eu/home/index.html>,
        <https://github.com/OP-TED/ePO/releases>,
        <https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology/about>,
        <https://op.europa.eu/en/web/eu-vocabularies/e-procurement> ;
    owl:imports epo-shape:acc-shape,
        epo-shape:cat-shape,
        epo-shape:con-shape,
        epo-shape:core-shape,
        epo-shape:eva-shape,
        epo-shape:ful-shape,
        epo-shape:inv-shape,
        epo-shape:not-shape,
        epo-shape:ord-shape,
        epo-shape:pay-shape,
        epo-shape:qua-shape,
        epo-shape:req-shape,
        epo-shape:sub-shape ;
    owl:incompatibleWith "4.2.0" ;
    owl:priorVersion "http://data.europa.eu/a4g/data-shape#awa-shape-5.1.0" ;
    owl:versionIRI epo-shape:awa-shape-5.2.0 ;
    owl:versionInfo "5.2.0" .

