@prefix : <http://data.europa.eu/a4g/ontology#> .
@prefix awa-shape: <http://data.europa.eu/a4g/data-shape#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

awa-shape:epo-awa-AwardDecisionNotificationShape a sh:NodeShape ;
    rdfs:label "Award decision notification" ;
    rdfs:isDefinedBy awa-shape:awa-shape ;
    sh:property awa-shape:epo-awa-AwardDecisionNotification-epo-awa-hasStandstillPeriodEndDate,
        awa-shape:epo-awa-AwardDecisionNotification-epo-concernsAwardOutcome,
        awa-shape:epo-awa-AwardDecisionNotification-epo-concernsProcedure,
        awa-shape:epo-awa-AwardDecisionNotification-epo-specifiesTenderer ;
    sh:targetClass :AwardDecisionNotification .

awa-shape:epo-awa-AwardDecisionNotification-epo-awa-hasStandstillPeriodEndDate a sh:PropertyShape ;
    rdfs:isDefinedBy awa-shape:awa-shape ;
    sh:datatype xsd:date ;
    sh:maxCount 1 ;
    sh:name "Has standstill period end date" ;
    sh:path :hasStandstillPeriodEndDate .

awa-shape:epo-awa-AwardDecisionNotification-epo-concernsAwardOutcome a sh:PropertyShape ;
    rdfs:isDefinedBy awa-shape:awa-shape ;
    sh:class :AwardOutcome ;
    sh:minCount 1 ;
    sh:name "Concerns award outcome" ;
    sh:path :concernsAwardOutcome ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#concernsAwardOutcome> ?that . ?that <http://data.europa.eu/a4g/ontology#concernsAwardOutcome> ?this .}" ] .

awa-shape:epo-awa-AwardDecisionNotification-epo-concernsProcedure a sh:PropertyShape ;
    rdfs:isDefinedBy awa-shape:awa-shape ;
    sh:class :Procedure ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Concerns procedure" ;
    sh:path :concernsProcedure ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#concernsProcedure> ?that . ?that <http://data.europa.eu/a4g/ontology#concernsProcedure> ?this .}" ] .

awa-shape:epo-awa-AwardDecisionNotification-epo-specifiesTenderer a sh:PropertyShape ;
    rdfs:isDefinedBy awa-shape:awa-shape ;
    sh:class :Tenderer ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Specifies tenderer" ;
    sh:path :specifiesTenderer ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#specifiesTenderer> ?that . ?that <http://data.europa.eu/a4g/ontology#specifiesTenderer> ?this .}" ] .

awa-shape:awa-shape a owl:Ontology ;
    rdfs:label """This artefact provides the generic datashape specifications for the eProcurement Ontology Core.
        The eProcurement Ontology describes objects and concepts, with definitions, attributes and relationships which are present within the European public procurement domain.
        The provision of these concepts provides the basis for a common understanding of the domain for all stakeholders ensuring the quality of data exchange and transparency."""@en ;
    dcterms:created "2025-09-04"^^xsd:date ;
    dcterms:description """This artefact provides the generic datashape specifications for the eProcurement Ontology Core.
        The eProcurement Ontology describes objects and concepts, with definitions, attributes and relationships which are present within the European public procurement domain.
        The provision of these concepts provides the basis for a common understanding of the domain for all stakeholders ensuring the quality of data exchange and transparency."""@en ;
    dcterms:issued "2025-09-04"^^xsd:date ;
    dcterms:license "CC BY 4.0" ;
    dcterms:publisher "http://publications.europa.eu/resource/authority/corporate-body/PUBL" ;
    dcterms:title "ePO Core shapes"@en ;
    vann:preferredNamespacePrefix "epo" ;
    vann:preferredNamespaceUri "http://data.europa.eu/a4g/ontology#" ;
    rdfs:comment "This version is automatically generated from eAwarding.xml on 2025-09-25" ;
    rdfs:seeAlso <https://docs.ted.europa.eu/EPO/latest/index.html>,
        <https://github.com/eprocurementontology/eprocurementontology>,
        <https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology/about>,
        <https://op.europa.eu/en/web/eu-vocabularies/e-procurement> ;
    owl:imports :awa,
        :awa-restriction,
        dcterms:,
        skos:,
        <http://www.w3.org/ns/adms>,
        <https://data.europa.eu/m8g> ;
    owl:incompatibleWith "2.1.0" ;
    owl:priorVersion "http://data.europa.eu/a4g/data-shape#awa-shape-3.0.1" ;
    owl:versionIRI awa-shape:awa-shape-3.1.0 ;
    owl:versionInfo "3.1.0" .

