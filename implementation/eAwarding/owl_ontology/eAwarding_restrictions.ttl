@prefix : <http://data.europa.eu/a4g/ontology#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:awa-restriction a owl:Ontology ;
    rdfs:label "eProcurement Ontology Awarding - core restrictions"@en ;
    dcterms:created "2025-05-06"^^xsd:date ;
    dcterms:description "The eProcurement Ontology Awarding core restrictions provides the restrictions and the inference-related specifications on the concepts and properties in the eProcurement Ontology Awarding core."@en ;
    dcterms:issued "2025-05-06"^^xsd:date ;
    dcterms:license "© European Union, 2014. Unless otherwise noted, the reuse of the Ontology is authorised under the European Union Public Licence v1.2 (https://eupl.eu/)." ;
    dcterms:publisher "http://publications.europa.eu/resource/authority/corporate-body/PUBL" ;
    dcterms:title "eProcurement Ontology Awarding - core restrictions"@en ;
    vann:preferredNamespacePrefix "epo" ;
    vann:preferredNamespaceUri "http://data.europa.eu/a4g/ontology#" ;
    rdfs:comment """This version is automatically generated from eAwarding.xml on 
                2025-05-06""" ;
    rdfs:seeAlso <https://docs.ted.europa.eu/home/index.html>,
        <https://github.com/OP-TED/ePO/releases>,
        <https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology/about>,
        <https://op.europa.eu/en/web/eu-vocabularies/e-procurement> ;
    owl:imports :awa,
        <http://data.europa.eu/nuts>,
        dcterms:,
        skos:,
        <http://www.w3.org/ns/adms>,
        foaf:,
        <https://data.europa.eu/m8g> ;
    owl:incompatibleWith "4.2.0" ;
    owl:priorVersion "http://data.europa.eu/a4g/ontology#awa-restriction-4.2.0" ;
    owl:versionIRI :awa-restriction-5.0.0 ;
    owl:versionInfo "5.0.0" .

:concernsAwardOutcome rdfs:domain :AwardDecisionNotification ;
    rdfs:range :AwardOutcome .

:concernsProcedure a owl:FunctionalProperty ;
    rdfs:domain :AwardDecisionNotification ;
    rdfs:range :Procedure .

:hasStandstillPeriodEndDate rdfs:domain :AwardDecisionNotification ;
    rdfs:range xsd:date .

:specifiesTenderer a owl:FunctionalProperty ;
    rdfs:domain :AwardDecisionNotification ;
    rdfs:range :Tenderer .

:AwardDecisionNotification rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty :concernsAwardOutcome ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :concernsProcedure ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :specifiesTenderer ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasStandstillPeriodEndDate ] .

