@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix epo: <http://data.europa.eu/a4g/ontology#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

epo:awa-restriction a owl:Ontology ;
    rdfs:label "eProcurement Ontology Awarding - core restrictions"@en ;
    dcterms:created "2021-06-01"^^xsd:date ;
    dcterms:description "The eProcurement Ontology Awarding core restrictions provides the restrictions and the inference-related specifications on the concepts and properties in the eProcurement Ontology Awarding core."@en ;
    dcterms:issued "2025-05-15"^^xsd:date ;
    dcterms:license "© European Union, 2014. Unless otherwise noted, the reuse of the Ontology is authorised under the European Union Public Licence v1.2 (https://eupl.eu/)." ;
    dcterms:publisher "http://publications.europa.eu/resource/authority/corporate-body/PUBL" ;
    dcterms:title "eProcurement Ontology Awarding - core restrictions"@en ;
    vann:preferredNamespacePrefix "epo" ;
    vann:preferredNamespaceUri "http://data.europa.eu/a4g/ontology#" ;
    rdfs:comment """This version is automatically generated from eAwarding.xml on 
                2025-05-15""" ;
    rdfs:seeAlso <https://docs.ted.europa.eu/home/index.html>,
        <https://github.com/OP-TED/ePO/releases>,
        <https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology/about>,
        <https://op.europa.eu/en/web/eu-vocabularies/e-procurement> ;
    owl:imports epo:awa,
        epo:core,
        <http://data.europa.eu/eli/ontology#>,
        <http://data.europa.eu/m8g/>,
        dcterms:,
        skos:,
        <http://www.w3.org/2006/time>,
        <http://www.w3.org/ns/adms>,
        <http://www.w3.org/ns/locn>,
        org:,
        <http://www.w3.org/ns/person> ;
    owl:incompatibleWith "4.2.0" ;
    owl:priorVersion "http://data.europa.eu/a4g/ontology#awa-restriction-4.2.0" ;
    owl:versionIRI epo:awa-restriction-5.0.0 ;
    owl:versionInfo "5.0.0" .

epo:concernsAwardOutcome rdfs:domain epo:AwardDecisionNotification ;
    rdfs:range epo:AwardOutcome .

epo:concernsProcedure a owl:FunctionalProperty ;
    rdfs:domain epo:AwardDecisionNotification ;
    rdfs:range epo:Procedure .

epo:hasStandstillPeriodEndDate rdfs:domain epo:AwardDecisionNotification ;
    rdfs:range xsd:date .

epo:specifiesTenderer a owl:FunctionalProperty ;
    rdfs:domain epo:AwardDecisionNotification ;
    rdfs:range epo:Tenderer .

epo:AwardDecisionNotification rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:concernsProcedure ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty epo:concernsAwardOutcome ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:hasStandstillPeriodEndDate ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:specifiesTenderer ] .

