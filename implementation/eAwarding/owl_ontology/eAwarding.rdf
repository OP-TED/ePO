  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#AwardDecisionNotification">
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/a4g/ontology#Document"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:historyNote xml:lang="en">WG approval 11/09/2025</skos:historyNote>
    <skos:prefLabel xml:lang="en">Award Decision Notification</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#awa"/>
    <skos:definition xml:lang="en">A formal communication sent by the Buyer to inform Tenderers of the Award Decision.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#awa">
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-06-01</dcterms:created>
    <dcterms:description xml:lang="en">The eProcurement Ontology Awarding core describes the concepts and properties representing the European Public Procurement Awarding domain. The provision of these semantics offers the basis for a common understanding of the domain for all stakeholders ensuring the quality of data exchange and transparency. The ontology restrictions are published in a separate artefact.</dcterms:description>
    <dcterms:license>© European Union, 2014. Unless otherwise noted, the reuse of the Ontology is authorised under the European Union Public Licence v1.2 (https://eupl.eu/).</dcterms:license>
    <owl:imports rdf:resource="http://www.w3.org/ns/org#"/>
    <owl:imports rdf:resource="http://data.europa.eu/a4g/ontology#core"/>
    <owl:imports rdf:resource="http://data.europa.eu/m8g/"/>
    <owl:imports rdf:resource="http://www.w3.org/2006/time"/>
    <owl:imports rdf:resource="http://www.w3.org/ns/person"/>
    <owl:imports rdf:resource="http://www.w3.org/ns/adms"/>
    <owl:imports rdf:resource="http://purl.org/dc/terms/"/>
    <owl:imports rdf:resource="http://www.w3.org/2004/02/skos/core#"/>
    <owl:imports rdf:resource="http://www.w3.org/ns/locn"/>
    <owl:imports rdf:resource="http://data.europa.eu/eli/ontology#"/>
    <rdfs:seeAlso rdf:resource="https://github.com/OP-TED/ePO/releases"/>
    <rdfs:seeAlso rdf:resource="https://docs.ted.europa.eu/home/index.html"/>
    <rdfs:seeAlso rdf:resource="https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology/about"/>
    <rdfs:seeAlso rdf:resource="https://op.europa.eu/en/web/eu-vocabularies/e-procurement"/>
    <owl:incompatibleWith>4.2.0</owl:incompatibleWith>
    <owl:versionIRI rdf:resource="http://data.europa.eu/a4g/ontology#awa-5.2.0"/>
    <dcterms:publisher>http://publications.europa.eu/resource/authority/corporate-body/PUBL</dcterms:publisher>
    <rdfs:comment>This version is automatically generated from eAwarding.xml on 2025-10-10</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-10-10</dcterms:issued>
    <vann:preferredNamespacePrefix>epo</vann:preferredNamespacePrefix>
    <rdfs:label xml:lang="en">eProcurement Ontology Awarding - core</rdfs:label>
    <dcterms:title xml:lang="en">eProcurement Ontology Awarding - core</dcterms:title>
    <owl:versionInfo>5.2.0</owl:versionInfo>
    <vann:preferredNamespaceUri>http://data.europa.eu/a4g/ontology#</vann:preferredNamespaceUri>
    <owl:priorVersion>http://data.europa.eu/a4g/ontology#awa-5.1.0</owl:priorVersion>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#specifiesTenderer">
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:definition xml:lang="en">Relation indicating that the instance of the concept involves the Tenderer.</skos:definition>
    <skos:prefLabel xml:lang="en">specifies Tenderer</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#awa"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#concernsAwardOutcome">
    <skos:prefLabel xml:lang="en">concerns Award Outcome</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#awa"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
    <skos:definition xml:lang="en">Relates to Award Outcome.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#hasStandstillPeriodEndDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:prefLabel xml:lang="en">has Standstill Period End Date</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#awa"/>
    <skos:definition xml:lang="en">The end date for the mandatory minimum time frame between the communication of a contract award decision and the formal conclusion of the contract, during which unsuccessful Tenderers have the opportunity to challenge the award before it becomes legally binding. (epo-awa:AwardDecisionNotification)</skos:definition>
    <skos:historyNote xml:lang="en">WG approval 25/09/2025</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/a4g/ontology#concernsProcedure">
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/ontology#awa"/>
    <skos:definition xml:lang="en">Relates to Procedure.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">concerns Procedure</skos:prefLabel>
  </rdf:Description>
</rdf:RDF>
