req-shape:epo-ord-DeliveryInformationShape sh:property req-shape:epo-ord-DeliveryInformation-epo-ord-isSpecificToRequestForOfferLine .

req-shape:epo-req-RequestForOfferLineShape a sh:NodeShape ;
    rdfs:label "Request For Offer Line" ;
    rdfs:comment "Details concerning a given unit of goods, services or works mentioned in the Request For Offer." ;
    rdfs:isDefinedBy req-shape:req-shape ;
    sh:property req-shape:epo-req-RequestForOfferLine-epo-req-isOptional ;
    sh:targetClass :RequestForOfferLine .

req-shape:epo-req-RequestForOfferShape a sh:NodeShape ;
    rdfs:label "Request For Offer" ;
    rdfs:comment "A Document sent by the Buyer to the Economic Operator, requesting the submission of a commercial proposal to supply goods, services, or works under specified conditions." ;
    rdfs:isDefinedBy req-shape:req-shape ;
    sh:property req-shape:epo-req-RequestForOffer-epo-cat-refersToCatalogue,
        req-shape:epo-req-RequestForOffer-epo-ful-specifiesOriginator,
        req-shape:epo-req-RequestForOffer-epo-hasDestinationCountryCode,
        req-shape:epo-req-RequestForOffer-epo-ord-specifiesDeliveryInformation,
        req-shape:epo-req-RequestForOffer-epo-refersToContract,
        req-shape:epo-req-RequestForOffer-epo-req-comprisesRequestForOfferLine,
        req-shape:epo-req-RequestForOffer-epo-req-hasSubmissionDueDate,
        req-shape:epo-req-RequestForOffer-epo-req-specifiesOfferCurrency,
        req-shape:epo-req-RequestForOffer-epo-req-specifiesOfferValidityPeriod,
        req-shape:epo-req-RequestForOffer-epo-specifiesBuyer,
        req-shape:epo-req-RequestForOffer-epo-specifiesContractor ;
    sh:targetClass :RequestForOffer .

req-shape:epo-ord-DeliveryInformation-epo-ord-isSpecificToRequestForOfferLine a sh:PropertyShape ;
    rdfs:isDefinedBy req-shape:req-shape ;
    sh:class :RequestForOfferLine ;
    sh:description "Information that is particular to a Request For Offer Line." ;
    sh:name "Is specific to request for offer line" ;
    sh:path :isSpecificToRequestForOfferLine ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#isSpecificToRequestForOfferLine> ?that . ?that <http://data.europa.eu/a4g/ontology#isSpecificToRequestForOfferLine> ?this .}" ] .

req-shape:epo-req-RequestForOffer-epo-cat-refersToCatalogue a sh:PropertyShape ;
    rdfs:isDefinedBy req-shape:req-shape ;
    sh:class :Catalogue ;
    sh:maxCount 1 ;
    sh:name "Refers to catalogue" ;
    sh:path :refersToCatalogue ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#refersToCatalogue> ?that . ?that <http://data.europa.eu/a4g/ontology#refersToCatalogue> ?this .}" ] .

req-shape:epo-req-RequestForOffer-epo-ful-specifiesOriginator a sh:PropertyShape ;
    rdfs:isDefinedBy req-shape:req-shape ;
    sh:class :Originator ;
    sh:description "Relation indicating that the instance of the concept involves the Originator." ;
    sh:maxCount 1 ;
    sh:name "Specifies originator" ;
    sh:path :specifiesOriginator ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#specifiesOriginator> ?that . ?that <http://data.europa.eu/a4g/ontology#specifiesOriginator> ?this .}" ] .

req-shape:epo-req-RequestForOffer-epo-hasDestinationCountryCode a sh:PropertyShape ;
    rdfs:isDefinedBy req-shape:req-shape ;
    sh:description "Relation indicating the Country code of the destination." ;
    sh:maxCount 1 ;
    sh:name "Has destination country code" ;
    sh:path :hasDestinationCountryCode .

req-shape:epo-req-RequestForOffer-epo-ord-specifiesDeliveryInformation a sh:PropertyShape ;
    rdfs:isDefinedBy req-shape:req-shape ;
    sh:class :DeliveryInformation ;
    sh:description "Relation indicating the Delivery Information." ;
    sh:name "Specifies delivery information" ;
    sh:path :specifiesDeliveryInformation ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#specifiesDeliveryInformation> ?that . ?that <http://data.europa.eu/a4g/ontology#specifiesDeliveryInformation> ?this .}" ] .

req-shape:epo-req-RequestForOffer-epo-refersToContract a sh:PropertyShape ;
    rdfs:isDefinedBy req-shape:req-shape ;
    sh:class :Contract ;
    sh:description "Reference to a Contract." ;
    sh:name "Refers to contract" ;
    sh:path :refersToContract ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#refersToContract> ?that . ?that <http://data.europa.eu/a4g/ontology#refersToContract> ?this .}" ] .

req-shape:epo-req-RequestForOffer-epo-req-comprisesRequestForOfferLine a sh:PropertyShape ;
    rdfs:isDefinedBy req-shape:req-shape ;
    sh:class :RequestForOfferLine ;
    sh:description "Incorporates Request For Offer Line." ;
    sh:minCount 1 ;
    sh:name "Comprises request for offer line" ;
    sh:path :comprisesRequestForOfferLine ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#comprisesRequestForOfferLine> ?that . ?that <http://data.europa.eu/a4g/ontology#comprisesRequestForOfferLine> ?this .}" ] .

req-shape:epo-req-RequestForOffer-epo-req-hasSubmissionDueDate a sh:PropertyShape ;
    rdfs:isDefinedBy req-shape:req-shape ;
    sh:datatype xsd:dateTime ;
    sh:description "Final date until the Submission is allowed." ;
    sh:maxCount 1 ;
    sh:name "Has submission due date" ;
    sh:path :hasSubmissionDueDate .

req-shape:epo-req-RequestForOffer-epo-req-specifiesOfferCurrency a sh:PropertyShape ;
    rdfs:isDefinedBy req-shape:req-shape ;
    sh:description "Relation indicating the Currency for the Offer." ;
    sh:maxCount 1 ;
    sh:name "Specifies offer currency" ;
    sh:path :specifiesOfferCurrency .

req-shape:epo-req-RequestForOffer-epo-req-specifiesOfferValidityPeriod a sh:PropertyShape ;
    rdfs:isDefinedBy req-shape:req-shape ;
    sh:class time:Interval ;
    sh:description "Relation indicating the time range in which an Offer is valid." ;
    sh:maxCount 1 ;
    sh:name "Specifies offer validity period" ;
    sh:path :specifiesOfferValidityPeriod ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#specifiesOfferValidityPeriod> ?that . ?that <http://data.europa.eu/a4g/ontology#specifiesOfferValidityPeriod> ?this .}" ] .

req-shape:epo-req-RequestForOffer-epo-specifiesBuyer a sh:PropertyShape ;
    rdfs:isDefinedBy req-shape:req-shape ;
    sh:class :Buyer ;
    sh:description "Relation indicating that the instance of the concept involves the Buyer." ;
    sh:maxCount 1 ;
    sh:name "Specifies buyer" ;
    sh:path :specifiesBuyer ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#specifiesBuyer> ?that . ?that <http://data.europa.eu/a4g/ontology#specifiesBuyer> ?this .}" ] .

req-shape:epo-req-RequestForOffer-epo-specifiesContractor a sh:PropertyShape ;
    rdfs:isDefinedBy req-shape:req-shape ;
    sh:class :Contractor ;
    sh:description "Relation indicating that the instance of the concept involves the Contractor." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "Specifies contractor" ;
    sh:path :specifiesContractor ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#specifiesContractor> ?that . ?that <http://data.europa.eu/a4g/ontology#specifiesContractor> ?this .}" ] .

req-shape:epo-req-RequestForOfferLine-epo-req-isOptional a sh:PropertyShape ;
    rdfs:isDefinedBy req-shape:req-shape ;
    sh:datatype xsd:boolean ;
    sh:description "Indicates whether the instance of the concept is not required." ;
    sh:maxCount 1 ;
    sh:name "Is optional" ;
    sh:path :isOptional .

