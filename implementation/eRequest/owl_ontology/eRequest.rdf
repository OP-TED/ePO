    <owl:versionInfo>5.0.0</owl:versionInfo>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-05-15</dcterms:issued>
    <dcterms:title xml:lang="en">eProcurement Ontology Request - core</dcterms:title>
    <owl:versionIRI rdf:resource="http://data.europa.eu/a4g/ontology#req-5.0.0"/>
    <rdfs:label xml:lang="en">eProcurement Ontology Request - core</rdfs:label>
    <owl:priorVersion>http://data.europa.eu/a4g/ontology#req-4.2.0</owl:priorVersion>
    <dcterms:description xml:lang="en">The eProcurement Ontology Request core describes the concepts and properties representing the European Public Procurement Request domain. The provision of these semantics offers the basis for a common understanding of the domain for all stakeholders ensuring the quality of data exchange and transparency. The ontology restrictions are published in a separate artefact.</dcterms:description>
  </rdf:Description>
