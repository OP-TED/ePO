@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix epo: <http://data.europa.eu/a4g/ontology#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

epo:hasDestinationCountryCode rdfs:domain epo:RequestForOffer ;
    rdfs:range skos:Concept .

epo:isSpecificToRequestForOfferLine rdfs:domain epo:DeliveryInformation ;
    rdfs:range epo:RequestForOfferLine .

epo:refersToContract rdfs:domain epo:RequestForOffer ;
    rdfs:range epo:Contract .

epo:req-restriction a owl:Ontology ;
    rdfs:label "eProcurement Ontology Request - core restrictions"@en ;
    dcterms:created "2021-06-01"^^xsd:date ;
    dcterms:description "The eProcurement Ontology Request core restrictions provides the restrictions and the inference-related specifications on the concepts and properties in the eProcurement Ontology Request core."@en ;
    dcterms:issued "2025-06-04"^^xsd:date ;
    dcterms:license "© European Union, 2014. Unless otherwise noted, the reuse of the Ontology is authorised under the European Union Public Licence v1.2 (https://eupl.eu/)." ;
    dcterms:publisher "http://publications.europa.eu/resource/authority/corporate-body/PUBL" ;
    dcterms:title "eProcurement Ontology Request - core restrictions"@en ;
    vann:preferredNamespacePrefix "epo" ;
    vann:preferredNamespaceUri "http://data.europa.eu/a4g/ontology#" ;
    rdfs:comment """This version is automatically generated from eRequest.xml on 
                2025-06-04""" ;
    rdfs:seeAlso <https://docs.ted.europa.eu/home/index.html>,
        <https://github.com/OP-TED/ePO/releases>,
        <https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology/about>,
        <https://op.europa.eu/en/web/eu-vocabularies/e-procurement> ;
    owl:imports epo:cat,
        epo:core,
        epo:ful,
        epo:ord,
        epo:req,
        <http://data.europa.eu/eli/ontology#>,
        <http://data.europa.eu/m8g/>,
        dcterms:,
        skos:,
        <http://www.w3.org/2006/time>,
        <http://www.w3.org/ns/adms>,
        <http://www.w3.org/ns/locn>,
        org:,
        <http://www.w3.org/ns/person> ;
    owl:incompatibleWith "4.2.0" ;
    owl:priorVersion "http://data.europa.eu/a4g/ontology#req-restriction-5.0.0" ;
    owl:versionIRI epo:req-restriction-5.1.0 ;
    owl:versionInfo "5.1.0" .

epo:specifiesDeliveryInformation rdfs:domain epo:RequestForOffer ;
    rdfs:range epo:DeliveryInformation .

epo:specifiesOfferCurrency rdfs:domain epo:RequestForOffer ;
    rdfs:range <http://publications.europa.eu/resource/authority/currency> .

epo:comprisesRequestForOfferLine rdfs:domain epo:RequestForOffer ;
    rdfs:range epo:RequestForOfferLine .

epo:hasSubmissionDueDate rdfs:domain epo:RequestForOffer ;
    rdfs:range xsd:dateTime .

epo:isOptional rdfs:domain epo:RequestForOfferLine ;
    rdfs:range xsd:boolean .

epo:refersToCatalogue rdfs:domain epo:RequestForOffer ;
    rdfs:range epo:Catalogue .

epo:specifiesBuyer rdfs:domain epo:RequestForOffer ;
    rdfs:range epo:Buyer .

epo:specifiesContractor a owl:FunctionalProperty ;
    rdfs:domain epo:RequestForOffer ;
    rdfs:range epo:Contractor .

epo:specifiesOfferValidityPeriod rdfs:domain epo:RequestForOffer ;
    rdfs:range time:Interval .

epo:specifiesOriginator rdfs:domain epo:RequestForOffer ;
    rdfs:range epo:Originator .

epo:RequestForOfferLine rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:isOptional ] .

epo:RequestForOffer rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:specifiesOfferValidityPeriod ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:hasSubmissionDueDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:specifiesOriginator ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:specifiesBuyer ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty epo:specifiesContractor ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty epo:comprisesRequestForOfferLine ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty epo:refersToCatalogue ] .

