@prefix : <http://data.europa.eu/a4g/ontology#> .
@prefix at-voc: <http://publications.europa.eu/resource/authority/> .
@prefix cccev: <http://data.europa.eu/m8g/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eli: <http://data.europa.eu/eli/ontology#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:hasDestinationCountryCode rdfs:domain :RequestForOffer ;
    rdfs:range skos:Concept .

:isSpecificToRequestForOfferLine rdfs:domain :DeliveryInformation ;
    rdfs:range :RequestForOfferLine .

:refersToContract rdfs:domain :RequestForOffer ;
    rdfs:range :Contract .

:req-restriction a owl:Ontology ;
    rdfs:label "eProcurement Ontology Request - core restrictions"@en ;
    dcterms:created "2021-06-01"^^xsd:date ;
    dcterms:description "The eProcurement Ontology Request core restrictions provides the restrictions and the inference-related specifications on the concepts and properties in the eProcurement Ontology Request core."@en ;
    dcterms:issued "2025-06-04"^^xsd:date ;
    dcterms:license "© European Union, 2014. Unless otherwise noted, the reuse of the Ontology is authorised under the European Union Public Licence v1.2 (https://eupl.eu/)." ;
    dcterms:publisher "http://publications.europa.eu/resource/authority/corporate-body/PUBL" ;
    dcterms:title "eProcurement Ontology Request - core restrictions"@en ;
    vann:preferredNamespacePrefix "epo" ;
    vann:preferredNamespaceUri "http://data.europa.eu/a4g/ontology#" ;
    rdfs:comment """This version is automatically generated from eRequest.xml on 
                2025-06-04""" ;
    rdfs:seeAlso <https://docs.ted.europa.eu/home/index.html>,
        <https://github.com/OP-TED/ePO/releases>,
        <https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology/about>,
        <https://op.europa.eu/en/web/eu-vocabularies/e-procurement> ;
    owl:imports :cat,
        :core,
        :ful,
        :ord,
        :req,
        eli:,
        cccev:,
        dcterms:,
        skos:,
        <http://www.w3.org/2006/time>,
        <http://www.w3.org/ns/adms>,
        <http://www.w3.org/ns/locn>,
        org:,
        <http://www.w3.org/ns/person> ;
    owl:incompatibleWith "4.2.0" ;
    owl:priorVersion "http://data.europa.eu/a4g/ontology#req-restriction-5.0.0" ;
    owl:versionIRI :req-restriction-5.1.0 ;
    owl:versionInfo "5.1.0" .

:specifiesDeliveryInformation rdfs:domain :RequestForOffer ;
    rdfs:range :DeliveryInformation .

:specifiesOfferCurrency rdfs:domain :RequestForOffer ;
    rdfs:range at-voc:currency .

:comprisesRequestForOfferLine rdfs:domain :RequestForOffer ;
    rdfs:range :RequestForOfferLine .

:hasSubmissionDueDate rdfs:domain :RequestForOffer ;
    rdfs:range xsd:dateTime .

:isOptional rdfs:domain :RequestForOfferLine ;
    rdfs:range xsd:boolean .

:refersToCatalogue rdfs:domain :RequestForOffer ;
    rdfs:range :Catalogue .

:specifiesBuyer rdfs:domain :RequestForOffer ;
    rdfs:range :Buyer .

:specifiesContractor a owl:FunctionalProperty ;
    rdfs:domain :RequestForOffer ;
    rdfs:range :Contractor .

:specifiesOfferValidityPeriod rdfs:domain :RequestForOffer ;
    rdfs:range time:Interval .

:specifiesOriginator rdfs:domain :RequestForOffer ;
    rdfs:range :Originator .

:RequestForOfferLine rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :isOptional ] .

:RequestForOffer rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :specifiesOfferValidityPeriod ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :hasSubmissionDueDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :specifiesOriginator ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :specifiesBuyer ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :specifiesContractor ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty :comprisesRequestForOfferLine ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty :refersToCatalogue ] .

