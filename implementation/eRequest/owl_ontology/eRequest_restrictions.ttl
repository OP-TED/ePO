@prefix : <http://data.europa.eu/a4g/ontology#> .
@prefix at-voc: <http://publications.europa.eu/resource/authority/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:hasDestinationCountryCode rdfs:domain :RequestForOffer ;
    rdfs:range skos:Concept .

:isSpecificToRequestForOfferLine rdfs:domain :DeliveryInformation ;
    rdfs:range :RequestForOfferLine .

:refersToContract rdfs:domain :RequestForOffer ;
    rdfs:range :Contract .

:req-restriction a owl:Ontology ;
    rdfs:label """This artefact provides the restrictions and inference-related specifications for the eProcurement Ontology Core.
        This artefact excludes the definitions of concepts.
        The eProcurement Ontology describes objects and concepts, with definitions, attributes and relationships which are present within the European public procurement domain.
        The provision of these concepts provides the basis for a common understanding of the domain for all stakeholders ensuring the quality of data exchange and transparency."""@en ;
    dcterms:created "2025-09-04"^^xsd:date ;
    dcterms:description """This artefact provides the restrictions and inference-related specifications for the eProcurement Ontology Core.
        This artefact excludes the definitions of concepts.
        The eProcurement Ontology describes objects and concepts, with definitions, attributes and relationships which are present within the European public procurement domain.
        The provision of these concepts provides the basis for a common understanding of the domain for all stakeholders ensuring the quality of data exchange and transparency."""@en ;
    dcterms:issued "2025-09-04"^^xsd:date ;
    dcterms:license "CC BY 4.0" ;
    dcterms:publisher "http://publications.europa.eu/resource/authority/corporate-body/PUBL" ;
    dcterms:title "ePO Core restrictions"@en ;
    vann:preferredNamespacePrefix "epo" ;
    vann:preferredNamespaceUri "http://data.europa.eu/a4g/ontology#" ;
    rdfs:comment """This version is automatically generated from eRequest.xml on 
                2025-10-15""" ;
    rdfs:seeAlso <https://docs.ted.europa.eu/EPO/latest/index.html>,
        <https://github.com/eprocurementontology/eprocurementontology>,
        <https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology/about>,
        <https://op.europa.eu/en/web/eu-vocabularies/e-procurement> ;
    owl:imports :req,
        dcterms:,
        skos:,
        <http://www.w3.org/ns/adms>,
        <https://data.europa.eu/m8g> ;
    owl:incompatibleWith "2.1.0" ;
    owl:priorVersion "http://data.europa.eu/a4g/ontology#req-restriction-3.0.1" ;
    owl:versionIRI :req-restriction-3.1.0 ;
    owl:versionInfo "3.1.0" .

:specifiesDeliveryInformation rdfs:domain :RequestForOffer ;
    rdfs:range :DeliveryInformation .

:specifiesOfferCurrency rdfs:domain :RequestForOffer ;
    rdfs:range at-voc:currency .

:comprisesRequestForOfferLine rdfs:domain :RequestForOffer ;
    rdfs:range :RequestForOfferLine .

:hasSubmissionDueDate rdfs:domain :RequestForOffer ;
    rdfs:range xsd:dateTime .

:isOptional rdfs:domain :RequestForOfferLine ;
    rdfs:range xsd:boolean .

:refersToCatalogue rdfs:domain :RequestForOffer ;
    rdfs:range :Catalogue .

:specifiesBuyer rdfs:domain :RequestForOffer ;
    rdfs:range :Buyer .

:specifiesContractor a owl:FunctionalProperty ;
    rdfs:domain :RequestForOffer ;
    rdfs:range :Contractor .

:specifiesOfferValidityPeriod rdfs:domain :RequestForOffer ;
    rdfs:range time:Interval .

:specifiesOriginator rdfs:domain :RequestForOffer ;
    rdfs:range :Originator .

:RequestForOfferLine rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty :isOptional ] .

:RequestForOffer rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass :Buyer ;
            owl:onProperty :specifiesBuyer ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass time:Interval ;
            owl:onProperty :specifiesOfferValidityPeriod ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass :Originator ;
            owl:onProperty :specifiesOriginator ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onDataRange xsd:dateTime ;
            owl:onProperty :hasSubmissionDueDate ],
        [ a owl:Restriction ;
            owl:onClass :Contractor ;
            owl:onProperty :specifiesContractor ;
            owl:qualifiedCardinality 1 ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onClass :Catalogue ;
            owl:onProperty :refersToCatalogue ],
        [ a owl:Restriction ;
            owl:onProperty :comprisesRequestForOfferLine ;
            owl:someValuesFrom :RequestForOfferLine ] .

