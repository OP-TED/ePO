@prefix : <http://data.europa.eu/a4g/ontology#> .
@prefix cccev: <http://data.europa.eu/m8g/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eli: <http://data.europa.eu/eli/ontology#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:RequestForOffer a owl:Class ;
    rdfs:isDefinedBy :req ;
    rdfs:subClassOf :Document ;
    skos:prefLabel "Request For Offer"@en .

:RequestForOfferLine a owl:Class ;
    rdfs:isDefinedBy :req ;
    rdfs:subClassOf :Line ;
    skos:prefLabel "Request For Offer Line"@en .

:comprisesRequestForOfferLine a owl:ObjectProperty ;
    rdfs:isDefinedBy :req ;
    skos:prefLabel "comprises Request For Offer Line"@en .

:hasDestinationCountryCode a owl:ObjectProperty ;
    rdfs:isDefinedBy :req ;
    skos:prefLabel "has Destination Country Code"@en .

:hasSubmissionDueDate a owl:DatatypeProperty ;
    rdfs:isDefinedBy :req ;
    skos:prefLabel "has Submission Due Date"@en .

:isOptional a owl:DatatypeProperty ;
    rdfs:isDefinedBy :req ;
    skos:prefLabel "is Optional"@en .

:isSpecificToRequestForOfferLine a owl:ObjectProperty ;
    rdfs:isDefinedBy :req ;
    skos:prefLabel "is Specific To Request For Offer Line"@en .

:refersToCatalogue a owl:ObjectProperty ;
    rdfs:isDefinedBy :req ;
    skos:prefLabel "refers To Catalogue"@en .

:refersToContract a owl:ObjectProperty ;
    rdfs:isDefinedBy :req ;
    skos:prefLabel "refers To Contract"@en .

:specifiesBuyer a owl:ObjectProperty ;
    rdfs:isDefinedBy :req ;
    skos:prefLabel "specifies Buyer"@en .

:specifiesContractor a owl:ObjectProperty ;
    rdfs:isDefinedBy :req ;
    skos:prefLabel "specifies Contractor"@en .

:specifiesDeliveryInformation a owl:ObjectProperty ;
    rdfs:isDefinedBy :req ;
    skos:prefLabel "specifies Delivery Information"@en .

:specifiesOfferCurrency a owl:ObjectProperty ;
    rdfs:isDefinedBy :req ;
    skos:prefLabel "specifies Offer Currency"@en .

:specifiesOfferValidityPeriod a owl:ObjectProperty ;
    rdfs:isDefinedBy :req ;
    skos:prefLabel "specifies Offer Validity Period"@en .

:specifiesOriginator a owl:ObjectProperty ;
    rdfs:isDefinedBy :req ;
    skos:definition "Relation indicating that the instance of the concept involves the Originator."@en ;
    skos:historyNote "WG Approval 25/06/2024"@en ;
    skos:prefLabel "specifies Originator"@en .

:req a owl:Ontology ;
    rdfs:label "eProcurement Ontology Request - core"@en ;
    dcterms:created "2021-06-01"^^xsd:date ;
    dcterms:description "The eProcurement Ontology Request core describes the concepts and properties representing the European Public Procurement Request domain. The provision of these semantics offers the basis for a common understanding of the domain for all stakeholders ensuring the quality of data exchange and transparency. The ontology restrictions are published in a separate artefact."@en ;
    dcterms:issued "2025-06-04"^^xsd:date ;
    dcterms:license "© European Union, 2014. Unless otherwise noted, the reuse of the Ontology is authorised under the European Union Public Licence v1.2 (https://eupl.eu/)." ;
    dcterms:publisher "http://publications.europa.eu/resource/authority/corporate-body/PUBL" ;
    dcterms:title "eProcurement Ontology Request - core"@en ;
    vann:preferredNamespacePrefix "epo" ;
    vann:preferredNamespaceUri "http://data.europa.eu/a4g/ontology#" ;
    rdfs:comment "This version is automatically generated from eRequest.xml on 2025-06-04" ;
    rdfs:seeAlso <https://docs.ted.europa.eu/home/index.html>,
        <https://github.com/OP-TED/ePO/releases>,
        <https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology/about>,
        <https://op.europa.eu/en/web/eu-vocabularies/e-procurement> ;
    owl:imports :cat,
        :core,
        :ful,
        :ord,
        eli:,
        cccev:,
        dcterms:,
        skos:,
        <http://www.w3.org/2006/time>,
        <http://www.w3.org/ns/adms>,
        <http://www.w3.org/ns/locn>,
        org:,
        <http://www.w3.org/ns/person> ;
    owl:incompatibleWith "4.2.0" ;
    owl:priorVersion "http://data.europa.eu/a4g/ontology#req-5.0.0" ;
    owl:versionIRI :req-5.1.0 ;
    owl:versionInfo "5.1.0" .

